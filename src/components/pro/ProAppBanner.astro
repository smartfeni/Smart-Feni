---
// path: src/components/pro/ProAppBanner.astro
// ============================================================
// সাময়িক ব্যানার: মেইন সাইটের দোকান/হিরো/ক্লাব/ক্লিনিক পেজে "Smart Feni Pro অ্যাপ নামান"
// শুধু মেইন অ্যাপ/ব্রাউজারে (Pro অ্যাপে দেখায় না)। ✕ চাপলে ৩ দিন লুকানো (localStorage, try/catch)।
// prop role = rider | shop | club | clinic  -> লিংক /pro-app?role=...
// Pro পুরো চালু হলে (SF বললে) এই কম্পোনেন্ট ও ব্যবহার মুছে ফেলা হবে।
// ============================================================
const { role = '' } = Astro.props;
---

<div class="pab" id="proAppBanner" data-role={role} style="display:none;">
  <i class="fas fa-mobile-screen-button pab-ic"></i>
  <div class="pab-tx">
    <b>Smart Feni Pro অ্যাপ নামান</b>
    <span>নতুন অর্ডারে জোরে রিংটোন, কাজ আরও সহজ</span>
  </div>
  <a class="pab-go" id="pabGo" href="/pro-app">নামান</a>
  <button type="button" class="pab-x" id="pabX" aria-label="বন্ধ করুন">✕</button>
</div>

<style is:global>
  .pab { display: flex; align-items: center; gap: 10px; max-width: 720px; margin: 10px auto; padding: 10px 12px; background: #FFF6F1; border: 1.5px solid #FFD9C7; border-radius: 16px; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; }
  .pab-ic { color: #FF6B35; font-size: 22px; flex: none; }
  .pab-tx { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: 13px; line-height: 1.4; color: #5B6B86; }
  .pab-tx b { font-size: 14.5px; color: #1B2A4A; }
  .pab-go { flex: none; min-height: 40px; padding: 0 14px; border-radius: 12px; background: #FF6B35; color: #fff; font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; text-decoration: none; }
  .pab-x { flex: none; width: 36px; height: 36px; border: 0; background: none; color: #5B6B86; font-size: 16px; cursor: pointer; }
  html[data-pro-app] .pab { display: none !important; }
</style>

<script>
  (function () {
    const el = document.getElementById('proAppBanner');
    if (!el) return;
    const KEY = 'sf_pro_banner_hide_until';
    try {
      if (document.documentElement.hasAttribute('data-pro-app') || localStorage.getItem('sf_pro_app') === '1') return;
      const until = Number(localStorage.getItem(KEY) || 0);
      if (until && Date.now() < until) return;
    } catch (_) { /* স্টোরেজ না থাকলেও ব্যানার দেখাবে */ }
    const role = el.getAttribute('data-role') || '';
    const go = document.getElementById('pabGo');
    if (go && role) go.setAttribute('href', '/pro-app?role=' + encodeURIComponent(role));
    el.style.display = 'flex';
    document.getElementById('pabX')?.addEventListener('click', () => {
      el.style.display = 'none';
      try { localStorage.setItem(KEY, String(Date.now() + 3 * 24 * 3600 * 1000)); } catch (_) { /* উপেক্ষা */ }
    });
  })();
</script>
