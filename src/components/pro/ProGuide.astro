---
// path: src/components/pro/ProGuide.astro
// ============================================================
// Pro নির্দেশনা — রোল ট্যাবসহ (লেখা src/lib/proGuides.js-এ)
// ব্যবহার: /pro-app (পাবলিক, ডাউনলোড পেজের নিচে) ও /pro/guide (অ্যাপের ভেতরে)
// একাধিক রোল থাকলে প্রতি রোলের আলাদা ট্যাব; ?role=shop,club দিলে সেই ট্যাব খোলা থাকে।
// ============================================================
---

<section class="pg-wrap" id="sfGuideSec">
  <h2 class="pg-title"><i class="fas fa-book-open"></i> নির্দেশনা</h2>
  <div id="sfGuide" class="pg-root" aria-live="polite"><p class="pg-load">লোড হচ্ছে…</p></div>
</section>

<style is:global>
  .pg-wrap { background: #fff; border-radius: 20px; padding: 16px; margin-bottom: 14px; box-shadow: 0 2px 10px rgba(27, 42, 74, 0.06); font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; }
  .pg-title { margin: 0 0 12px; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .pg-title i { color: #FF6B35; }
  .pg-load { margin: 0; color: #5B6B86; font-size: 14px; }
  .pg-tabs { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
  .pg-tabs::-webkit-scrollbar { display: none; }
  .pg-tab { flex: none; min-height: 44px; padding: 0 14px; border-radius: 14px; border: 1.5px solid #D5DCE8; background: #fff; color: #1B2A4A; font-family: inherit; font-size: 14.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .pg-tab i { color: #FF6B35; }
  .pg-tab.active { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
  .pg-body { margin-top: 12px; }
  .pg-h { margin: 16px 0 6px; font-size: 16px; font-weight: 700; }
  .pg-h:first-child { margin-top: 4px; }
  .pg-p { margin: 4px 0 8px; font-size: 15px; line-height: 1.6; background: #F8FAFC; border-radius: 14px; padding: 10px 12px; }
  .pg-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.6; }
</style>

<script>
  import { resolveGuideRoles, renderGuide } from '../../lib/proGuides.js';

  async function init() {
    const root = document.getElementById('sfGuide');
    if (!root) return;
    try {
      const { roles, active } = await resolveGuideRoles();
      renderGuide(root, { roles, active });
    } catch (_) {
      root.textContent = 'নির্দেশনা লোড করা যায়নি, পেজ রিফ্রেশ করুন।';
    }
  }
  init();
</script>
