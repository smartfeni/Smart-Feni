---
// ============================================================
// কম্পোনেন্ট: Pro শেল — শুধু Smart Feni Pro অ্যাপে (com.smartfeni.pro) দেখায়
// কাজ:
//   ১) মেইন অ্যাপের হেডার (.navbar), নিচের নেভ (.bottom-nav) ও ফ্লোটিং অ্যাক্টিভিটি বার (.sf-act) লুকায়
//   ২) Pro-র নিজস্ব নিচের নেভ: হোম (/pro) | নোটিফিকেশন | মেনু
//      মেনু শিটে: রোল ও দোকান বদল, আমার প্রোফাইল, লগআউট (দুবার ট্যাপ)
// কখন: <html data-pro-app="1"> থাকলে। BaseLayout-এর head স্ক্রিপ্ট localStorage ফ্ল্যাগ থেকে বসায়;
//      ফ্ল্যাগ বসায় src/lib/proApp.js শুধু নেটিভ Pro অ্যাপে। ওয়েব ও মেইন অ্যাপে কিছুই দেখায় না/বদলায় না।
// নোটিফিকেশন বেল আলাদা Pro ইনবক্স (/pro/notifications) খোলে; ব্যাজে শুধু Pro নোটিফিকেশনের অপঠিত সংখ্যা (src/lib/proInbox.js)।
// ইউজারের লেখা সব textContent। ক্লাস নাম psh- দিয়ে শুরু।
// ============================================================
---

<nav class="psh-nav" id="pshNav" aria-label="Pro নেভিগেশন">
  <a href="/pro" class="psh-item" id="pshHome"><i class="fas fa-house"></i><span>হোম</span></a>
  <button type="button" class="psh-item" id="pshBell" aria-label="নোটিফিকেশন">
    <span class="psh-icon"><i class="fas fa-bell"></i><span class="psh-badge" id="pshBadge" style="display:none;">0</span></span>
    <span>নোটিফিকেশন</span>
  </button>
  <button type="button" class="psh-item" id="pshMenuBtn" aria-label="মেনু"><i class="fas fa-bars"></i><span>মেনু</span></button>
</nav>

<div class="psh-ov" id="pshOv">
  <div class="psh-sheet" role="dialog" aria-label="মেনু">
    <div class="psh-grip"></div>
    <h2 class="psh-sh">মেনু</h2>
    <div class="psh-list" id="pshList"></div>
    <button type="button" class="psh-close" id="pshClose">বন্ধ করুন</button>
  </div>
</div>

<style is:global>
  .psh-nav { display: none; }

  /* Pro অ্যাপে মেইনের চেহারা লুকানো */
  html[data-pro-app] .navbar,
  html[data-pro-app] .bottom-nav,
  html[data-pro-app] .sf-act,
  html[data-pro-app] .sf-act-sheet { display: none !important; }

  html[data-pro-app] .psh-nav {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 998;
    display: flex; justify-content: space-around; align-items: stretch;
    background: #fff; border-top: 1px solid #EEF3F9; box-shadow: 0 -4px 20px rgba(15, 23, 42, .06);
    padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
    font-family: 'Hind Siliguri', system-ui, sans-serif;
  }
  .psh-item {
    flex: 1; max-width: 160px; min-height: 52px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; background: none; border: 0; color: #5B6B86; font-size: 12px; font-weight: 600; text-decoration: none;
    cursor: pointer; font-family: inherit; -webkit-tap-highlight-color: transparent;
  }
  .psh-item i { font-size: 20px; }
  .psh-item.active { color: #FF6B35; }
  .psh-icon { position: relative; display: inline-flex; }
  .psh-badge {
    position: absolute; top: -6px; right: -12px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px;
    background: #FF6B35; color: #1B2A4A; font-size: 11px; font-weight: 700; align-items: center; justify-content: center;
  }

  .psh-ov { position: fixed; inset: 0; z-index: 1060; background: rgba(27, 42, 74, .5); display: none; align-items: flex-end; justify-content: center; }
  .psh-ov.active { display: flex; }
  .psh-sheet {
    width: 100%; max-width: 520px; max-height: 92vh; overflow-y: auto; background: #fff; border-radius: 28px 28px 0 0;
    padding: 10px 20px calc(24px + env(safe-area-inset-bottom, 0px)); box-shadow: 0 -6px 24px rgba(27, 42, 74, .12);
    font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A;
  }
  .psh-grip { width: 44px; height: 5px; border-radius: 3px; background: #D5DCE8; margin: 2px auto 10px; }
  .psh-sh { margin: 0 0 10px; font-size: 20px; font-weight: 700; }
  .psh-list { display: flex; flex-direction: column; gap: 8px; }
  .psh-grp { font-size: 12.5px; font-weight: 600; color: #5B6B86; margin: 8px 2px 0; }
  .psh-opt {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; border: 1.5px solid #D5DCE8; border-radius: 16px;
    background: #fff; padding: 8px 12px; text-align: left; color: #1B2A4A; text-decoration: none; cursor: pointer; font-family: inherit;
  }
  .psh-opt.cur { border-color: #FF6B35; background: #FFF6F1; }
  .psh-opt.danger { color: #B3261E; border-color: #F3C4C0; }
  .psh-oic { width: 40px; height: 40px; border-radius: 12px; background: #FFF6F1; color: #FF6B35; display: flex; align-items: center; justify-content: center; flex: none; }
  .psh-opt.danger .psh-oic { background: #FDECEA; color: #B3261E; }
  .psh-otx { flex: 1; min-width: 0; }
  .psh-otx b { display: block; font-size: 15.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .psh-otx span { font-size: 12.5px; color: #5B6B86; }
  .psh-ock { color: #14A44D; }
  .psh-close {
    width: 100%; height: 46px; margin-top: 14px; border: 1.5px solid #D5DCE8; border-radius: 14px; background: #fff;
    color: #1B2A4A; font-weight: 600; font-size: 15px; cursor: pointer; font-family: inherit;
  }
</style>

<script>
  import { isProApp } from '../../lib/proApp.js';
  import { getMyProRoles, ROLE_META, rememberRole } from '../../lib/proRoles.js';
  import { proLogout } from '../../lib/proLogin.js';
  import { supabase } from '../../lib/supabase.js';
  import { countProUnread, markRead, subscribeProInbox, isProAlertNotif } from '../../lib/proInbox.js';
  import { playProAlert } from '../../lib/proAlert.js';
  import { checkProUpdate } from '../../lib/proUpdate.js';

  // Pro চেনা (ফ্ল্যাগ বসানো/মোছা এখানেই হয়; BottomNav-ও ডাকে, ফল cache করা)
  isProApp();

  const $ = (id) => document.getElementById(id);

  function h(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    return e;
  }

  // বর্তমান পেজ Pro এলাকায় হলে হোম হাইলাইট
  const here = window.location.pathname;
  if (here === '/pro/notifications') $('pshBell')?.classList.add('active');
  else if (here === '/pro' || here.indexOf('/pro/') === 0) $('pshHome')?.classList.add('active');

  // নোটিফিকেশন: আলাদা Pro ইনবক্স (/pro/notifications); ব্যাজে শুধু Pro নোটিফিকেশনের অপঠিত সংখ্যা
  $('pshBell')?.addEventListener('click', () => {
    if (window.location.pathname !== '/pro/notifications') window.location.href = '/pro/notifications';
  });

  function setBadge(count) {
    const badge = $('pshBadge');
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count > 9 ? '৯+' : String(count);
      badge.style.display = 'flex';
    } else {
      badge.style.display = 'none';
    }
  }

  let inboxUnsub = null;

  async function refreshBadge() {
    try { setBadge(await countProUnread()); } catch (_) { /* উপেক্ষা */ }
  }

  async function startInbox() {
    try {
      if (inboxUnsub) { inboxUnsub(); inboxUnsub = null; }
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { setBadge(0); return; }

      // পুশে ট্যাপ করে এসেছে (?pn=<id>): পড়া মার্ক করে URL পরিষ্কার
      const qs = new URLSearchParams(window.location.search);
      const pn = qs.get('pn');
      if (pn) {
        qs.delete('pn');
        const rest = qs.toString();
        window.history.replaceState({}, '', window.location.pathname + (rest ? '?' + rest : ''));
        await markRead(pn);
      }

      await refreshBadge();
      // নতুন Pro নোটিফিকেশন: ব্যাজ আপডেট; জরুরি হলে (নতুন অর্ডার/রিকোয়েস্ট, দাম একসেপ্ট) রিংটোন + ব্যানার
      inboxUnsub = subscribeProInbox(session.user.id, (row) => {
        refreshBadge();
        try { if (isProAlertNotif(row)) playProAlert(row); } catch (_) { /* উপেক্ষা */ }
      });
    } catch (_) { /* উপেক্ষা */ }
  }

  window.addEventListener('smartfeni:pro-notif-changed', refreshBadge);
  window.addEventListener('smartfeni:auth-changed', startInbox);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshBadge(); });
  // শুধু Pro অ্যাপে (ওয়েব/মেইন অ্যাপে এই কোয়েরি চলে না)
  isProApp().then((pro) => { if (pro || document.documentElement.hasAttribute('data-pro-app')) startInbox(); });
  // অ্যাপ আপডেট চেক: খোলার ৫ সেকেন্ড পর (src/lib/proUpdate.js; app_releases-এ নতুন রিলিজ থাকলে ডায়ালগ)
  isProApp().then((pro) => { if (pro) setTimeout(() => { checkProUpdate(); }, 5000); });
  window.addEventListener('smartfeni:logged-out', () => {
    const badge = $('pshBadge');
    if (badge) badge.style.display = 'none';
  });

  // ---------- মেনু ----------
  function opt(tag, icon, title, sub, cur) {
    const el = h(tag, 'psh-opt' + (cur ? ' cur' : ''));
    if (tag === 'button') el.type = 'button';
    const ic = h('span', 'psh-oic');
    ic.appendChild(h('i', 'fas ' + icon));
    const tx = h('span', 'psh-otx');
    tx.appendChild(h('b', '', title));
    if (sub) tx.appendChild(h('span', '', sub));
    el.appendChild(ic);
    el.appendChild(tx);
    if (cur) el.appendChild(h('i', 'fas fa-check psh-ock'));
    return el;
  }

  function closeMenu() { $('pshOv')?.classList.remove('active'); }

  let logoutTimer = null;

  async function openMenu() {
    const list = $('pshList');
    if (!list) return;
    list.textContent = '';
    $('pshOv').classList.add('active');

    let res;
    try { res = await getMyProRoles(); } catch (_) { res = { loggedIn: true, roles: [] }; }

    if (!res.loggedIn) {
      const a = opt('a', 'fa-right-to-bracket', 'লগইন করুন', '', false);
      a.href = '/pro/login';
      list.appendChild(a);
      const g0 = opt('a', 'fa-book-open', 'নির্দেশনা', 'কাজ ও অ্যাপ ব্যবহারের নিয়ম', false);
      g0.href = '/pro/guide';
      list.appendChild(g0);
      return;
    }

    const path = window.location.pathname;
    (res.roles || []).forEach((r) => {
      const m = ROLE_META[r.role];
      if (!m) return;
      if (r.role === 'instant_shop' && r.shops && r.shops.length) {
        list.appendChild(h('div', 'psh-grp', 'ইনস্ট্যান্ট শপ'));
        const wanted = new URLSearchParams(window.location.search).get('shop');
        r.shops.forEach((s) => {
          const cur = path.indexOf('/pro/shop') === 0 && (wanted ? wanted === s.id : r.shops[0].id === s.id);
          const a = opt('a', 'fa-utensils', s.name, cur ? 'এখন এখানে আছেন' : 'এই দোকানে যান', cur);
          a.href = '/pro/shop?shop=' + encodeURIComponent(s.id);
          a.addEventListener('click', () => rememberRole('instant_shop'));
          list.appendChild(a);
        });
      } else {
        const cur = path.indexOf(m.href) === 0;
        const a = opt('a', m.icon, m.label, m.sub, cur);
        a.href = m.href;
        a.addEventListener('click', () => rememberRole(r.role));
        list.appendChild(a);
      }
    });

    list.appendChild(h('div', 'psh-grp', 'অ্যাকাউন্ট'));
    const gd = opt('a', 'fa-book-open', 'নির্দেশনা', 'কাজ ও অ্যাপ ব্যবহারের নিয়ম', false);
    gd.href = '/pro/guide';
    list.appendChild(gd);

    const prof = opt('a', 'fa-user', 'আমার প্রোফাইল', '', false);
    prof.href = '/profile/edit';
    list.appendChild(prof);

    const lo = opt('button', 'fa-arrow-right-from-bracket', 'লগআউট', '', false);
    lo.classList.add('danger');
    const loTitle = lo.querySelector('b');
    let armed = false;
    lo.addEventListener('click', () => {
      if (!armed) {
        armed = true;
        if (loTitle) loTitle.textContent = 'নিশ্চিত করুন?';
        clearTimeout(logoutTimer);
        logoutTimer = setTimeout(() => { armed = false; if (loTitle) loTitle.textContent = 'লগআউট'; }, 4000);
        return;
      }
      proLogout();
    });
    list.appendChild(lo);
  }

  $('pshMenuBtn')?.addEventListener('click', openMenu);
  $('pshClose')?.addEventListener('click', closeMenu);
  $('pshOv')?.addEventListener('click', (e) => { if (e.target === $('pshOv')) closeMenu(); });
</script>
