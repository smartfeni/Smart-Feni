---
// path: src/components/market/MarketLocationSheet.astro
// ============================================================
// কুইক ডেলিভারি — ঠিকানা সেটআপ, পুরো পেজ।
//   পেছনে সবসময় আসল ফেনীর ম্যাপ (জেলা/উপজেলা/ইউনিয়ন সীমানা)। পুরনো LocationPicker পেজ এখানে ব্যবহার হয় না।
//   ধাপ ১: দুই বাটন — "বর্তমান লোকেশন" ও "লিখিত ঠিকানা"
//   ধাপ ২: বর্তমান লোকেশন চাপলে GPS → ম্যাপ নিজে থেকে কাস্টমারের ইউনিয়নে ফোকাস করে, পিন বসে (ট্যাপ/টেনে সরানো যায়)
//   ধাপ ৩: লিখিত ঠিকানা (উপজেলা, ইউনিয়ন, এলাকা, বাসা); চাইলে ম্যাপে পিন (ধাপ ৪)
// ফলাফল marketCart.setDrop() দিয়ে সংরক্ষিত। ব্যবহার: window.SFMarketLocation.open(onDone?)
// ঠিকানা সেট না থাকলে বন্ধ করার বাটন নেই।
---

<div class="mls-root" id="mlsRoot" hidden role="dialog" aria-modal="true" aria-labelledby="mlsTitle">
  <div class="mls-map" id="mlsMap"></div>

  <header class="mls-top">
    <button type="button" class="mls-round" id="mlsBack" aria-label="পেছনে যান" hidden><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
    <button type="button" class="mls-round" id="mlsClose" aria-label="বন্ধ করুন" hidden><i class="fas fa-xmark" aria-hidden="true"></i></button>
    <div class="mls-brand" id="mlsBrand">
      <span class="mls-logo" aria-hidden="true"><i class="fas fa-location-dot"></i></span>
      <span class="mls-brand-t"><b>স্মার্ট ফেনী</b><small>কুইক ডেলিভারি</small></span>
    </div>
  </header>

  <div class="mls-sheet" id="mlsSheet">
    <div class="mls-grab" aria-hidden="true"></div>

    <!-- ধাপ ১ -->
    <section class="mls-step" id="mlsS1">
      <h2 class="mls-title" id="mlsTitle">কোথায় পৌঁছে দেব?</h2>
      <p class="mls-cur" id="mlsCur" hidden></p>
      <div class="mls-btns">
        <button type="button" class="mls-btn dark" id="mlsBtnMap">
          <span class="mls-btn-ic"><i class="fas fa-location-crosshairs" aria-hidden="true"></i></span>
          <span class="mls-btn-tx"><b>বর্তমান লোকেশন</b><small>ম্যাপে অটো সিলেক্ট</small></span>
        </button>
        <button type="button" class="mls-btn" id="mlsBtnText">
          <span class="mls-btn-ic"><i class="fas fa-pen" aria-hidden="true"></i></span>
          <span class="mls-btn-tx"><b>লিখিত ঠিকানা</b><small>প্রবাস/অন্যের জন্য</small></span>
        </button>
      </div>
    </section>

    <!-- ধাপ ২ -->
    <section class="mls-step" id="mlsS2" hidden>
      <div class="mls-okrow">
        <div class="mls-ok" id="mlsOk"><i class="fas fa-circle-check" aria-hidden="true"></i> <span id="mlsOkT">লোকেশন খোঁজা হচ্ছে...</span></div>
        <button type="button" class="mls-relocate" id="mlsRelocate" aria-label="আমার লোকেশন আবার খুঁজুন"><i class="fas fa-location-crosshairs" aria-hidden="true"></i> আবার খুঁজুন</button>
      </div>
      <div class="mls-tiles">
        <div class="mls-tile"><small>উপজেলা</small><b id="mlsUp">—</b></div>
        <div class="mls-tile"><small>ইউনিয়ন</small><b id="mlsUn">—</b></div>
      </div>
      <p class="mls-addr" id="mlsAddr" hidden></p>
      <label class="mls-f"><span>ঐচ্ছিক নির্দেশনা</span><input type="text" id="mlsIns" maxlength="200" placeholder="বাজার বা এলাকার নাম লিখুন" /></label>
      <p class="mls-note dim">ঠিক জায়গায় না হলে ম্যাপে ট্যাপ করুন বা পিন টেনে সরান।</p>
      <p class="mls-err" id="mlsErr2" hidden></p>
      <button type="button" class="mls-save" id="mlsSave2">এই লোকেশন নিশ্চিত করুন</button>
    </section>

    <!-- ধাপ ৩ -->
    <section class="mls-step" id="mlsS3" hidden>
      <h2 class="mls-title">ঠিকানা লিখে দিন</h2>
      <div class="mls-two">
        <label class="mls-f"><span>উপজেলা</span>
          <select id="mlsWUp">
            <option>ফেনী সদর</option><option>ছাগলনাইয়া</option><option>দাগনভূঞা</option><option>পরশুরাম</option><option>ফুলগাজী</option><option>সোনাগাজী</option>
          </select>
        </label>
        <label class="mls-f"><span>ইউনিয়ন / পৌরসভা</span><select id="mlsWUn"></select></label>
      </div>
      <label class="mls-f"><span>বাজার বা এলাকার নাম</span><input type="text" id="mlsWArea" maxlength="80" placeholder="যেমন: বাজার, পাড়া, মহল্লা" /></label>
      <label class="mls-f"><span>বাসা, রাস্তা ও ল্যান্ডমার্ক</span><textarea id="mlsWHouse" maxlength="200" placeholder="বাসা নম্বর, রাস্তার নাম, কাছের পরিচিত জায়গা"></textarea></label>
      <button type="button" class="mls-link" id="mlsWPin"><i class="fas fa-map-pin" aria-hidden="true"></i> ম্যাপে পিন দিন (ঐচ্ছিক, চার্জ সঠিক হিসাবে সাহায্য করে)</button>
      <p class="mls-note" id="mlsWPinOk" hidden></p>
      <p class="mls-err" id="mlsErr3" hidden></p>
      <button type="button" class="mls-save" id="mlsSave3">এই ঠিকানা নিশ্চিত করুন</button>
    </section>

    <!-- ধাপ ৪: লিখিত ঠিকানার জন্য ম্যাপে পিন -->
    <section class="mls-step" id="mlsS4" hidden>
      <h2 class="mls-title">ম্যাপে পিন বসান</h2>
      <p class="mls-note dim" id="mlsPinHint">ম্যাপে আপনার জায়গায় ট্যাপ করুন।</p>
      <button type="button" class="mls-save" id="mlsSave4" disabled>এই পিন নিশ্চিত করুন</button>
      <button type="button" class="mls-link" id="mlsCancel4">বাতিল</button>
    </section>
  </div>

</div>

<style is:global>
  .mls-root { position: fixed; inset: 0; z-index: 9000; isolation: isolate; background: #FFE9DA; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; overflow: hidden; }
  .mls-root[hidden] { display: none; }
  .mls-map { position: absolute; inset: 0; width: 100%; height: 100%; background: #FFE9DA; z-index: 0; }
  .mls-pinicon { background: none; border: 0; }
  .mls-pinicon .pd { position: relative; width: 44px; height: 44px; margin: -22px 0 0 -22px; }
  .mls-pinicon .pr { position: absolute; left: -30px; top: -30px; width: 104px; height: 104px; border-radius: 50%; border: 2px solid #FF6B35; background: rgba(255,107,53,.12); opacity: .6; }
  .mls-pinicon .pc { position: absolute; inset: 0; border-radius: 50%; background: #FF6B35; border: 4px solid #fff; box-sizing: border-box; box-shadow: 0 6px 16px rgba(27,42,74,.35); display: flex; align-items: center; justify-content: center; }
  .mls-pinicon .pc i { width: 10px; height: 10px; border-radius: 50%; background: #fff; display: block; }
  .mls-note.dim { color: #4A5568; font-weight: 500; margin-top: 8px; }
  .mls-top { position: absolute; left: 0; right: 0; top: 0; padding: 20px 18px 0; display: flex; align-items: center; gap: 12px; z-index: 1000; pointer-events: none; }
  .mls-top > * { pointer-events: auto; }
  .mls-brand { background: rgba(255,255,255,.94); padding: 6px 14px 6px 8px; border-radius: 16px; box-shadow: 0 2px 8px rgba(27,42,74,.14); }
  .mls-round { width: 44px; height: 44px; border: 0; border-radius: 22px; background: #fff; color: #1B2A4A; font-size: 17px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.14); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .mls-round[hidden] { display: none; }
  .mls-brand { display: flex; align-items: center; gap: 10px; }
  .mls-logo { width: 38px; height: 38px; border-radius: 12px; background: #1B2A4A; color: #FF6B35; display: flex; align-items: center; justify-content: center; font-size: 17px; }
  .mls-brand-t { display: flex; flex-direction: column; line-height: 1.15; }
  .mls-brand-t b { font-size: 18px; font-weight: 700; }
  .mls-brand-t small { font-size: 11px; font-weight: 500; color: #4A5568; }
  .mls-sheet { position: absolute; left: 0; right: 0; bottom: 0; max-width: 560px; margin: 0 auto; max-height: 60vh; overflow-y: auto; background: #fff; border-radius: 28px 28px 0 0; box-shadow: 0 -8px 32px rgba(27, 42, 74, 0.14); padding: 12px 20px calc(22px + env(safe-area-inset-bottom)); z-index: 1000; }
  .mls-grab { width: 40px; height: 4px; border-radius: 2px; background: #E6D8CC; margin: 0 auto 14px; }
  .mls-step[hidden] { display: none; }
  .mls-title { margin: 0 0 12px; font-size: 22px; font-weight: 700; }
  .mls-cur { margin: -4px 0 12px; font-size: 13px; color: #4A5568; }
  .mls-btns { display: flex; gap: 10px; }
  .mls-btn { flex: 1; min-width: 0; height: 58px; display: flex; align-items: center; gap: 8px; padding: 0 10px; border-radius: 16px; background: #fff; color: #1B2A4A; border: 1.5px solid #1B2A4A; text-align: left; font-family: inherit; cursor: pointer; }
  .mls-btn.dark { background: #1B2A4A; color: #fff; }
  .mls-btn-ic { font-size: 18px; flex: none; width: 22px; text-align: center; }
  .mls-btn-tx { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .mls-btn-tx b { font-size: 14.5px; font-weight: 700; white-space: nowrap; }
  .mls-btn-tx small { font-size: 11px; font-weight: 500; color: #4A5568; white-space: nowrap; }
  .mls-btn.dark small { color: #E6EAF2; }
  .mls-okrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .mls-relocate { flex: none; display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #FFD3BF; background: #FFF4EE; color: #E0531F; font: inherit; font-size: 13px; font-weight: 700; padding: 7px 12px; border-radius: 999px; cursor: pointer; }
  .mls-relocate:disabled { opacity: .55; cursor: default; }
  .mls-relocate:focus-visible { outline: 3px solid #FF6B35; outline-offset: 2px; }
  .mls-ok { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: #1F7A4D; }
  .mls-ok.wait { color: #5B6B86; }
  .mls-tiles { display: flex; gap: 10px; margin: 12px 0; }
  .mls-tile { flex: 1; background: #FFF4EC; border-radius: 14px; padding: 10px 14px; }
  .mls-tile small { display: block; font-size: 11.5px; font-weight: 600; color: #4A5568; }
  .mls-tile b { font-size: 16px; font-weight: 700; }
  .mls-addr { margin: 0 0 10px; font-size: 13px; line-height: 1.5; color: #4A5568; }
  .mls-two { display: flex; gap: 10px; }
  .mls-f { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; margin-top: 10px; }
  .mls-f span { font-size: 12px; font-weight: 600; color: #4A5568; }
  .mls-f select, .mls-f input, .mls-f textarea { box-sizing: border-box; width: 100%; height: 48px; border: 1.5px solid #E6D8CC; border-radius: 14px; padding: 0 14px; font: 500 15px 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFFBF8; }
  .mls-f textarea { height: 72px; padding: 10px 14px; resize: none; }
  .mls-f select:focus, .mls-f input:focus, .mls-f textarea:focus, .mls-btn:focus-visible, .mls-save:focus-visible, .mls-round:focus-visible, .mls-link:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
  .mls-link { display: block; width: 100%; margin-top: 10px; padding: 10px 0; border: 0; background: none; color: #1B2A4A; font: 700 13.5px 'Hind Siliguri', system-ui, sans-serif; text-align: left; cursor: pointer; text-decoration: underline; }
  .mls-note { margin: 0; font-size: 12.5px; color: #1F7A4D; font-weight: 600; }
  .mls-err { margin: 8px 0 0; color: #B42318; font-size: 13px; font-weight: 600; }
  .mls-save { width: 100%; margin-top: 14px; height: 56px; border: 0; border-radius: 16px; background: #FF6B35; color: #1B2A4A; font-family: inherit; font-size: 16px; font-weight: 700; cursor: pointer; }
  .mls-save:disabled { opacity: 0.55; cursor: not-allowed; }
</style>

<script>
  import { setDrop, getDrop } from '../../lib/marketCart.js';
  import { getCurrentPosition } from '../../lib/native-bridge.js';
  import { loadLeaflet as sfLoadLeaflet, mapRetryBox, removeMapRetryBox } from '../../lib/leafletLoader.js';
  import {
    UPAZILAS, BORDER_COLORS, getUnionUpazilaId, loadFeniGeo, findAreaAt, getFeniBounds,
    getUpazilaBorders, getDistrictBorder, getLabelPoints, getUnionBn, getUnionsOfUpazilaName,
  } from '../../data/feniAreas.js';

  const $ = (id) => document.getElementById(id);
  const root = $('mlsRoot');
  let onDone = null;
  let pickMode = false; // true = শুধু জায়গা বাছাই (পিকআপ), ড্রপ ঠিকানা বদলায় না
  let step = 1;
  let picked = null;       // { lat, lng, address, upazila, union, source }
  let L = null, geo = null, map = null, marker = null;
  const unLayers = {};
  let chipLayer = null, labels = null, selUn = null, token = 0;

  function setText(id, t) { const e = $(id); if (e) e.textContent = t; }
  function showErr(id, msg) { const e = $(id); if (!e) return; e.textContent = msg || ''; e.hidden = !msg; }
  function hasAddress() { try { return !!getDrop(); } catch (e) { return false; } }
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
  // লিখিত ঠিকানা: উপজেলা বাছলে তার ইউনিয়ন/পৌরসভা ড্রপডাউনে আসে
  function fillUnions(selected) {
    const sel = $('mlsWUn');
    sel.textContent = '';
    const first = document.createElement('option');
    first.value = ''; first.textContent = 'বেছে নিন';
    sel.appendChild(first);
    getUnionsOfUpazilaName($('mlsWUp').value).forEach((n) => {
      const o = document.createElement('option');
      o.value = n; o.textContent = n;
      sel.appendChild(o);
    });
    if (selected) {
      const hit = Array.from(sel.options).find((o) => o.value === selected || o.value.replace(/\s*(ইউনিয়ন|পৌরসভা)$/, '') === String(selected).replace(/\s*(ইউনিয়ন|পৌরসভা)$/, ''));
      if (hit) sel.value = hit.value;
    }
  }
  $('mlsWUp').addEventListener('change', () => fillUnions(''));
  fillUnions('');

  function upColor(id) { const u = UPAZILAS.find((x) => x.id === id); return u ? u.color : '#64748b'; }

  // শেয়ার্ড লোডার (src/lib/leafletLoader.js): নিজেদের সাইট থেকে, ফেইল হলে রিট্রাই
  function loadLeaflet() {
    return sfLoadLeaflet();
  }

  function chip(text, color, size, alpha, active) {
    const bg = active ? color : 'rgba(255,255,255,' + alpha + ')';
    return L.divIcon({
      className: '', iconSize: [0, 0],
      html: '<div style="position:absolute;left:0;top:0;transform:translate(-50%,-50%);white-space:nowrap;pointer-events:none;font-weight:700;font-size:' + size + 'px;line-height:1.2;color:' + (active ? '#fff' : '#1B2A4A') + ';background:' + bg + ';padding:1px 6px;border-radius:9px;border:1px solid ' + color + ';">' + esc(text) + '</div>',
    });
  }

  function unStyle(name, mode) {
    const color = upColor(getUnionUpazilaId(name));
    if (mode === 'sel') return { stroke: true, color: '#155E75', weight: 3.5, opacity: 1, fill: true, fillColor: color, fillOpacity: 0.2 };
    if (mode === 'dim') return { stroke: true, color: BORDER_COLORS.union, weight: 1, opacity: 0.4, dashArray: '4 4', fill: true, fillColor: color, fillOpacity: 0.03 };
    return { stroke: true, color: BORDER_COLORS.union, weight: 1.4, opacity: 0.9, fill: true, fillColor: color, fillOpacity: 0.12 };
  }

  function refreshChips() {
    if (!map || !labels || !chipLayer) return;
    chipLayer.clearLayers();
    if (map.getZoom() < 12) {
      UPAZILAS.forEach((u) => {
        const pt = labels.upazilas[u.id];
        if (pt) chipLayer.addLayer(L.marker(pt, { icon: chip(u.name, u.color, 12, 0.85, false), interactive: false, keyboard: false }));
      });
    } else {
      Object.keys(unLayers).forEach((n) => {
        const pt = labels.unions[n];
        if (pt) chipLayer.addLayer(L.marker(pt, { icon: chip(getUnionBn(n), upColor(getUnionUpazilaId(n)), 10, 0.8, n === selUn), interactive: false, keyboard: false }));
      });
    }
  }

  function selectUnion(name) {
    selUn = name || null;
    Object.keys(unLayers).forEach((n) => unLayers[n].setStyle(unStyle(n, !name ? 'normal' : n === name ? 'sel' : 'dim')));
    if (name && unLayers[name]) unLayers[name].bringToFront();
    refreshChips();
  }

  function bottomPad() {
    const sh = $('mlsSheet');
    return sh ? Math.min(sh.offsetHeight, Math.round(window.innerHeight * 0.6)) : 0;
  }

  function fitAll() {
    if (!map) return;
    if (geo) map.fitBounds(getFeniBounds(geo, 0.02), { animate: false, paddingBottomRight: [0, bottomPad()] });
    else map.setView([23.0159, 91.3976], 10);
  }

  async function initMap() {
    if (map) return;
    const res = await Promise.all([loadLeaflet(), loadFeniGeo().catch(() => null)]);
    L = window.L;
    geo = res[1];
    map = L.map($('mlsMap'), { zoomControl: false }).setView([23.0159, 91.3976], 10);
    L.control.zoom({ position: 'topright' }).addTo(map);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(map);
    if (geo) {
      map.createPane('mlsAreas').style.zIndex = 421;
      map.createPane('mlsLines').style.zIndex = 440;
      map.getPane('mlsLines').style.pointerEvents = 'none';
      (geo.features || []).forEach((f) => {
        const name = f.properties && f.properties.shapeName;
        if (!name || !getUnionUpazilaId(name)) return;
        unLayers[name] = L.geoJSON(f, { pane: 'mlsAreas', style: () => unStyle(name, 'normal') }).addTo(map);
      });
      const ub = getUpazilaBorders(geo);
      UPAZILAS.forEach((u) => {
        if (ub[u.id]) L.polyline(ub[u.id], { pane: 'mlsLines', color: u.color, weight: 2.5, opacity: 0.9, interactive: false }).addTo(map);
      });
      const border = getDistrictBorder(geo);
      L.polyline(border, { pane: 'mlsLines', color: '#fff', weight: 10, opacity: 0.95, interactive: false }).addTo(map);
      L.polyline(border, { pane: 'mlsLines', color: '#FF6B35', weight: 4.5, opacity: 1, interactive: false }).addTo(map);
      labels = getLabelPoints(geo);
      chipLayer = L.layerGroup().addTo(map);
      // আগে কড়া maxBounds-এর কারণে ম্যাপ টানলে মাঝে ফিরে আসত — এখন অনেক ঢিলা সীমা
      map.setMaxBounds(getFeniBounds(geo, 0.6));
      map.setMinZoom(9);
      map.on('zoomend', refreshChips);
      refreshChips();
    }
    map.on('click', (e) => { if (step === 2 || step === 4) place(e.latlng.lat, e.latlng.lng, false); });
  }

  function pinIcon() {
    return L.divIcon({ className: 'mls-pinicon', iconSize: [0, 0], html: '<div class="pd"><span class="pr"></span><span class="pc"><i></i></span></div>' });
  }

  async function reverse(lat, lng) {
    try {
      const r = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&accept-language=bn&zoom=17&lat=' + lat + '&lon=' + lng);
      const d = await r.json();
      return d.display_name || '';
    } catch (e) { return ''; }
  }

  function unionLabel(un) { return un ? un + (/পৌরসভা/.test(un) ? '' : ' ইউনিয়ন') : ''; }

  async function place(lat, lng, focus) {
    if (!map) return;
    const area = geo ? findAreaAt(lat, lng, geo) : null;
    if (geo && !area) {
      const m = 'এই জায়গাটা ফেনীর বাইরে। ম্যাপে ফেনীর ভেতরে ট্যাপ করুন।';
      showErr('mlsErr2', m); setText('mlsPinHint', m);
      setText('mlsOkT', 'ফেনীর ভেতরে জায়গা বাছুন'); $('mlsOk').classList.add('wait');
      return;
    }
    const my = ++token;
    if (!marker) {
      marker = L.marker([lat, lng], { icon: pinIcon(), draggable: true, zIndexOffset: 1000 }).addTo(map);
      marker.on('dragend', () => { const p = marker.getLatLng(); place(p.lat, p.lng, false); });
    } else marker.setLatLng([lat, lng]);
    if (area) {
      selectUnion(area.union);
      if (focus && unLayers[area.union]) {
        map.fitBounds(unLayers[area.union].getBounds(), { paddingTopLeft: [24, 80], paddingBottomRight: [24, bottomPad() + 12], maxZoom: 16 });
      } else {
        map.panTo([lat, lng]);
      }
    }
    picked = { lat: lat, lng: lng, address: '', upazila: area ? area.upazilaName : '', union: area ? area.unionBn : '', source: 'map' };
    setText('mlsOkT', 'আপনার লোকেশন পাওয়া গেছে'); $('mlsOk').classList.remove('wait');
    showErr('mlsErr2', '');
    setText('mlsUp', picked.upazila || '—'); setText('mlsUn', picked.union || '—');
    $('mlsSave2').disabled = false; $('mlsSave4').disabled = false;
    setText('mlsPinHint', (picked.upazila ? picked.upazila + ' · ' : '') + (picked.union || '') + ' — পিন ঠিক থাকলে নিশ্চিত করুন।');
    const addr = await reverse(lat, lng);
    if (my !== token) return;
    picked.address = addr || [unionLabel(picked.union), picked.upazila].filter(Boolean).join(', ');
    const a = $('mlsAddr'); a.textContent = picked.address; a.hidden = !picked.address;
  }

  function go(n) {
    step = n;
    [1, 2, 3, 4].forEach((i) => { $('mlsS' + i).hidden = n !== i; });
    $('mlsBack').hidden = n === 1;
    $('mlsClose').hidden = !(n === 1 && (hasAddress() || pickMode));
    $('mlsBrand').hidden = n !== 1;
    showErr('mlsErr2', ''); showErr('mlsErr3', '');
    if (map) setTimeout(() => map.invalidateSize(), 50);
  }

  function clearPin() {
    if (marker && map) { map.removeLayer(marker); marker = null; }
    token++;
    selectUnion(null);
  }
  function backToOne() { clearPin(); picked = null; go(1); setTimeout(fitAll, 80); }

  function close() { root.hidden = true; document.body.style.overflow = ''; }

  async function open(cb, opts) {
    onDone = typeof cb === 'function' ? cb : null;
    pickMode = !!(opts && opts.pick);
    setText('mlsTitle', pickMode ? ((opts && opts.title) || 'কোথা থেকে আনবো?') : 'কোথায় পৌঁছে দেব?');
    picked = null;
    root.hidden = false;
    document.body.style.overflow = 'hidden';
    const d = pickMode ? null : getDrop();
    const cur = $('mlsCur');
    if (d && d.address) { cur.textContent = 'বর্তমান ঠিকানা: ' + d.address; cur.hidden = false; } else cur.hidden = true;
    go(1);
    try {
      await initMap();
      removeMapRetryBox($('mlsMap'));
    } catch (e) {
      // আগে চুপচাপ ফাঁকা ম্যাপ থাকত; এখন আবার চেষ্টার বাটন
      mapRetryBox($('mlsMap'), () => { initMap().then(() => { clearPin(); map.invalidateSize(); fitAll(); }).catch(() => mapRetryBox($('mlsMap'), () => location.reload())); });
      return;
    }
    clearPin();
    map.invalidateSize();
    fitAll();
    $('mlsBtnMap').focus();
  }

  function finish(detail) {
    const addr = (detail.address || '').trim();
    if (!addr) return false;
    const lat = parseFloat(detail.lat), lng = parseFloat(detail.lng);
    if (pickMode) {
      close();
      if (onDone) {
        const f = onDone; onDone = null;
        f({ address: addr, lat: isFinite(lat) ? lat : null, lng: isFinite(lng) ? lng : null, upazila: detail.upazila || '', union: detail.union || '', instructions: detail.instructions || '' });
      }
      return true;
    }
    setDrop({
      address: addr,
      lat: isFinite(lat) ? lat : null,
      lng: isFinite(lng) ? lng : null,
      upazila: detail.upazila || '',
      union: detail.union || '',
      instructions: detail.instructions || '',
      source: detail.source || 'text',
    });
    if (detail.upazila) { try { localStorage.setItem('smartfeni_upazila', detail.upazila); window.dispatchEvent(new Event('smartfeni:upazila-changed')); } catch (e) {} }
    close();
    if (onDone) { const f = onDone; onDone = null; f(); }
    return true;
  }

  // ধাপ ১ → ২: বর্তমান লোকেশন → GPS → ম্যাপ নিজে কাস্টমারের ইউনিয়নে ফোকাস করে
  $('mlsBtnMap').addEventListener('click', () => {
    picked = null; clearPin();
    setText('mlsOkT', 'লোকেশন খোঁজা হচ্ছে...'); $('mlsOk').classList.add('wait');
    setText('mlsUp', '—'); setText('mlsUn', '—');
    $('mlsAddr').hidden = true; $('mlsSave2').disabled = true;
    go(2);
    locateMe();
  });
  function locateMe() {
    const b = $('mlsRelocate');
    b.disabled = true;
    setText('mlsOkT', 'লোকেশন খোঁজা হচ্ছে...'); $('mlsOk').classList.add('wait');
    showErr('mlsErr2', '');
    getCurrentPosition(
      (pos) => { b.disabled = false; place(pos.coords.latitude, pos.coords.longitude, true); },
      () => {
        b.disabled = false;
        setText('mlsOkT', picked ? 'আগের পিন রাখা আছে' : 'লোকেশন পাওয়া যায়নি');
        if (picked) $('mlsOk').classList.remove('wait');
        showErr('mlsErr2', 'GPS চালু করে "আবার খুঁজুন" চাপুন, অথবা ম্যাপে নিজের জায়গায় ট্যাপ করুন।');
      }
    );
  }
  $('mlsRelocate').addEventListener('click', locateMe);
  $('mlsSave2').addEventListener('click', () => {
    if (!picked) { showErr('mlsErr2', 'আগে ম্যাপে লোকেশন বেছে নিন।'); return; }
    finish({ ...picked, instructions: $('mlsIns').value.trim() });
  });

  // ধাপ ১ → ৩: লিখিত ঠিকানা
  $('mlsBtnText').addEventListener('click', () => { picked = null; $('mlsWPinOk').hidden = true; go(3); $('mlsWUp').focus(); });
  $('mlsWPin').addEventListener('click', () => {
    picked = null; clearPin();
    $('mlsSave4').disabled = true;
    setText('mlsPinHint', 'ম্যাপে আপনার জায়গায় ট্যাপ করুন।');
    go(4);
    setTimeout(fitAll, 80);
  });
  $('mlsCancel4').addEventListener('click', () => { clearPin(); picked = null; go(3); });
  $('mlsSave4').addEventListener('click', () => {
    if (!picked) return;
    const ok = $('mlsWPinOk');
    ok.textContent = 'পিন বসানো হয়েছে' + (picked.upazila ? ' · ' + picked.upazila : '') + (picked.union ? ' · ' + picked.union : '');
    ok.hidden = false;
    const sel = $('mlsWUp');
    Array.from(sel.options).forEach((o) => { if (o.value === picked.upazila) sel.value = o.value; });
    fillUnions(picked.union || '');
    go(3);
  });
  $('mlsSave3').addEventListener('click', () => {
    const up = $('mlsWUp').value.trim(), un = $('mlsWUn').value.trim();
    const area = $('mlsWArea').value.trim(), house = $('mlsWHouse').value.trim();
    if (!un) { showErr('mlsErr3', 'ইউনিয়ন / পৌরসভা বেছে নিন।'); return; }
    if (!area && !house) { showErr('mlsErr3', 'বাজার/এলাকার নাম অথবা বাসা ও রাস্তার ঠিকানা লিখুন।'); return; }
    const parts = [house, area, un + (/(ইউনিয়ন|পৌরসভা)$/.test(un) ? '' : ' ইউনিয়ন'), up].filter(Boolean);
    finish({
      address: parts.join(', '),
      lat: picked ? picked.lat : null,
      lng: picked ? picked.lng : null,
      upazila: up, union: un, instructions: '',
      source: picked ? 'map' : 'text',
    });
  });

  $('mlsBack').addEventListener('click', () => { if (step === 4) $('mlsCancel4').click(); else backToOne(); });
  $('mlsClose').addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden && step === 1 && (hasAddress() || pickMode)) close(); });

  window.SFMarketLocation = { open, close };
</script>
