---
// path: src/components/market/MarketLocationSheet.astro
// ============================================================
// কুইক ডেলিভারি — ঠিকানা সেটআপ, পুরো পেজ।
//   পেছনে সবসময় আসল ফেনীর ম্যাপ (জেলা/উপজেলা/ইউনিয়ন সীমানা)। পুরনো LocationPicker পেজ এখানে ব্যবহার হয় না।
//   ধাপ ১: দুই বাটন — "বর্তমান লোকেশন" ও "লিখিত ঠিকানা"
//   ধাপ ২: বর্তমান লোকেশন চাপলে GPS → ম্যাপ নিজে থেকে কাস্টমারের জায়গায় যায়।
//   পিন (ধাপ ২ ও ৪): ফুড ডেলিভারি অ্যাপের মতো ম্যাপের দৃশ্যমান অংশের মাঝে স্থির — ম্যাপ টেনে/জুম করে
//   ছাড়লে পিনের নিচের জায়গা সিলেক্ট; জুমে সাইজ বদলায় না; উপরে জায়গার নামের বাবল; উপরে "জায়গা খুঁজুন"।
//   নাম ও সার্চ: src/lib/placeLookup.js
//   ধাপ ৩: লিখিত ঠিকানা (উপজেলা, ইউনিয়ন, এলাকা, বাসা); চাইলে ম্যাপে পিন (ধাপ ৪)
// ফলাফল marketCart.setDrop() দিয়ে সংরক্ষিত। ব্যবহার: window.SFMarketLocation.open(onDone?)
// ঠিকানা সেট না থাকলে বন্ধ করার বাটন নেই।
---

<div class="mls-root" id="mlsRoot" hidden role="dialog" aria-modal="true" aria-labelledby="mlsTitle">
  <div class="mls-map" id="mlsMap"></div>

  <div class="mls-cpin" id="mlsPin" hidden aria-hidden="true">
    <div class="mls-cpin-bubble" id="mlsPinBubble" data-state="hint"><span class="mls-cpin-t1" id="mlsPinT1"></span><span class="mls-cpin-t2" id="mlsPinT2" hidden></span></div>
    <svg class="mls-cpin-svg" width="30" height="46" viewBox="0 0 30 46"><rect x="13.8" y="24" width="2.4" height="21.5" rx="1.2" fill="#1B2A4A"/><circle cx="15" cy="14" r="13" fill="#1B2A4A"/><circle cx="15" cy="14" r="5.6" fill="#fff"/><circle cx="15" cy="14" r="2.3" fill="#FF6B35"/></svg>
    <i class="mls-cpin-ground"></i>
  </div>

  <header class="mls-top">
    <button type="button" class="mls-round" id="mlsBack" aria-label="পেছনে যান" hidden><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
    <button type="button" class="mls-round" id="mlsClose" aria-label="বন্ধ করুন" hidden><i class="fas fa-xmark" aria-hidden="true"></i></button>
    <div class="mls-brand" id="mlsBrand">
      <span class="mls-logo" aria-hidden="true"><i class="fas fa-location-dot"></i></span>
      <span class="mls-brand-t"><b>স্মার্ট ফেনী</b><small>কুইক ডেলিভারি</small></span>
    </div>
    <button type="button" class="mls-searchpill" id="mlsSearchBtn" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5B6B86" stroke-width="2.3" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <span>জায়গা খুঁজুন</span>
    </button>
  </header>

  <div class="mls-srch" id="mlsSearch" hidden role="dialog" aria-modal="true" aria-label="জায়গা খুঁজুন">
    <div class="mls-srch-bar">
      <button type="button" class="mls-round" id="mlsSearchClose" aria-label="বন্ধ করুন"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
      <label class="mls-srch-field">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5B6B86" stroke-width="2.3" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input type="search" id="mlsSearchInput" placeholder="এলাকা, বাজার, দোকান বা স্কুল" aria-label="জায়গা খুঁজুন" autocomplete="off" enterkeyhint="search" />
      </label>
    </div>
    <p class="mls-srch-note" id="mlsSearchNote">জায়গার নাম লিখুন, যেমন মহিপাল বা ট্রাংক রোড</p>
    <div class="mls-srch-list" id="mlsSearchList" data-no-i18n></div>
  </div>

  <div class="mls-sheet" id="mlsSheet">
    <div class="mls-grab" aria-hidden="true"></div>

    <!-- ধাপ ১ -->
    <section class="mls-step" id="mlsS1">
      <h2 class="mls-title" id="mlsTitle">কোথায় পৌঁছে দেব?</h2>
      <p class="mls-cur" id="mlsCur" hidden></p>
      <button type="button" class="mls-keep" id="mlsKeep" hidden><i class="fas fa-circle-check" aria-hidden="true"></i> <span>এই ঠিকানাই ঠিক আছে</span></button>
      <div class="mls-btns">
        <button type="button" class="mls-btn dark" id="mlsBtnMap">
          <span class="mls-btn-ic"><i class="fas fa-location-crosshairs" aria-hidden="true"></i></span>
          <span class="mls-btn-tx"><b>বর্তমান লোকেশন</b><small>ম্যাপে অটো সিলেক্ট</small></span>
        </button>
        <button type="button" class="mls-btn" id="mlsBtnText">
          <span class="mls-btn-ic"><i class="fas fa-pen" aria-hidden="true"></i></span>
          <span class="mls-btn-tx"><b>লিখিত ঠিকানা</b><small>প্রবাস/অন্যের জন্য</small></span>
        </button>
      </div>
      <div class="mls-saved" id="mlsSaved" hidden>
        <p class="mls-saved-h">সংরক্ষিত ঠিকানা</p>
        <div id="mlsSavedList"></div>
      </div>
    </section>

    <!-- ধাপ ২ -->
    <section class="mls-step" id="mlsS2" hidden>
      <div class="mls-okrow">
        <div class="mls-ok" id="mlsOk"><i class="fas fa-circle-check" aria-hidden="true"></i> <span id="mlsOkT">লোকেশন খোঁজা হচ্ছে...</span></div>
        <button type="button" class="mls-relocate" id="mlsRelocate" aria-label="আমার লোকেশন আবার খুঁজুন"><i class="fas fa-location-crosshairs" aria-hidden="true"></i> আবার খুঁজুন</button>
      </div>
      <div class="mls-tiles">
        <div class="mls-tile"><small>উপজেলা</small><b id="mlsUp">—</b></div>
        <div class="mls-tile"><small>ইউনিয়ন</small><b id="mlsUn">—</b></div>
      </div>
      <p class="mls-addr" id="mlsAddr" hidden></p>
      <label class="mls-f"><span>ঐচ্ছিক নির্দেশনা</span><input type="text" id="mlsIns" maxlength="200" placeholder="বাজার বা এলাকার নাম লিখুন" /></label>
      <p class="mls-note dim">ঠিক জায়গায় না হলে ম্যাপ টেনে পিন ঠিক জায়গায় আনুন, অথবা উপরে খুঁজুন।</p>
      <p class="mls-err" id="mlsErr2" hidden></p>
      <button type="button" class="mls-save" id="mlsSave2">এই লোকেশন নিশ্চিত করুন</button>
    </section>

    <!-- ধাপ ৩ -->
    <section class="mls-step" id="mlsS3" hidden>
      <h2 class="mls-title">ঠিকানা লিখে দিন</h2>
      <div class="mls-two">
        <label class="mls-f"><span>উপজেলা</span>
          <select id="mlsWUp">
            <option>ফেনী সদর</option><option>ছাগলনাইয়া</option><option>দাগনভূঞা</option><option>পরশুরাম</option><option>ফুলগাজী</option><option>সোনাগাজী</option>
          </select>
        </label>
        <label class="mls-f"><span>ইউনিয়ন / পৌরসভা</span><select id="mlsWUn"></select></label>
      </div>
      <label class="mls-f"><span>বাজার বা এলাকার নাম</span><input type="text" id="mlsWArea" maxlength="80" placeholder="যেমন: বাজার, পাড়া, মহল্লা" /></label>
      <label class="mls-f"><span>বাসা, রাস্তা ও ল্যান্ডমার্ক</span><textarea id="mlsWHouse" maxlength="200" placeholder="বাসা নম্বর, রাস্তার নাম, কাছের পরিচিত জায়গা"></textarea></label>
      <button type="button" class="mls-link" id="mlsWPin"><i class="fas fa-map-pin" aria-hidden="true"></i> ম্যাপে পিন দিন (ঐচ্ছিক, চার্জ সঠিক হিসাবে সাহায্য করে)</button>
      <p class="mls-note" id="mlsWPinOk" hidden></p>
      <p class="mls-err" id="mlsErr3" hidden></p>
      <button type="button" class="mls-save" id="mlsSave3">এই ঠিকানা নিশ্চিত করুন</button>
    </section>

    <!-- ধাপ ৪: লিখিত ঠিকানার জন্য ম্যাপে পিন -->
    <section class="mls-step" id="mlsS4" hidden>
      <h2 class="mls-title">ম্যাপে পিন বসান</h2>
      <p class="mls-note dim" id="mlsPinHint">ম্যাপ টেনে পিন আপনার জায়গায় আনুন, অথবা উপরে খুঁজুন।</p>
      <button type="button" class="mls-save" id="mlsSave4" disabled>এই পিন নিশ্চিত করুন</button>
      <button type="button" class="mls-link" id="mlsCancel4">বাতিল</button>
    </section>
  </div>

</div>

<style is:global>
  .mls-root { position: fixed; inset: 0; z-index: 9000; isolation: isolate; background: #FFE9DA; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; overflow: hidden; }
  .mls-root[hidden] { display: none; }
  .mls-map { position: absolute; inset: 0; width: 100%; height: 100%; background: #FFE9DA; z-index: 0; }
  /* মাঝের স্থির পিন — top JS থেকে (--mls-pin-y = ম্যাপের দৃশ্যমান অংশের মাঝ) */
  .mls-cpin { position: absolute; left: 50%; top: var(--mls-pin-y, 40%); width: 0; height: 0; z-index: 900; pointer-events: none; }
  .mls-cpin[hidden] { display: none; }
  .mls-cpin-svg { position: absolute; left: -15px; bottom: 0; display: block; filter: drop-shadow(0 3px 4px rgba(27, 42, 74, 0.3)); transition: transform 0.18s cubic-bezier(.2, .8, .3, 1.2); }
  .mls-cpin-ground { position: absolute; left: -6px; top: -3px; width: 12px; height: 6px; border-radius: 50%; background: radial-gradient(closest-side, rgba(27, 42, 74, 0.45), rgba(27, 42, 74, 0)); transition: transform 0.18s, opacity 0.18s; }
  .mls-moving .mls-cpin-svg { transform: translateY(-12px); }
  .mls-moving .mls-cpin-ground { transform: scale(1.6); opacity: 0.55; }
  .mls-cpin-bubble { position: absolute; left: 0; bottom: 56px; transform: translateX(-50%); max-width: min(280px, 80vw); background: var(--sf-glass-strong-bg); -webkit-backdrop-filter: var(--sf-glass-blur); backdrop-filter: var(--sf-glass-blur); border: 1px solid var(--sf-glass-edge); box-shadow: var(--sf-glass-shadow); border-radius: 14px; padding: 7px 14px 6px; text-align: center; line-height: 1.25; transition: opacity 0.15s, transform 0.15s; }
  .mls-cpin-bubble::after { content: ''; position: absolute; left: 50%; bottom: -5px; width: 10px; height: 10px; margin-left: -5px; background: inherit; transform: rotate(45deg); border-radius: 2px; }
  .mls-cpin-bubble[hidden] { display: none; }
  .mls-cpin-t1 { display: block; font-size: 14px; font-weight: 700; color: #1B2A4A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mls-cpin-t2 { display: block; font-size: 12px; font-weight: 500; color: #5B6B86; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mls-cpin-t2[hidden] { display: none; }
  .mls-cpin-bubble[data-state="hint"] .mls-cpin-t1, .mls-cpin-bubble[data-state="loading"] .mls-cpin-t1 { font-size: 12.5px; font-weight: 600; color: #5B6B86; }
  .mls-cpin-bubble[data-state="warn"] { background: #FFF4EC; }
  .mls-cpin-bubble[data-state="warn"] .mls-cpin-t1 { font-size: 12.5px; color: #C2410C; }
  .mls-moving .mls-cpin-bubble { opacity: 0; transform: translateX(-50%) translateY(4px); }
  .mls-searchpill { flex: 1; min-width: 0; height: 44px; display: flex; align-items: center; gap: 9px; padding: 0 16px; border-radius: 22px; background: var(--sf-glass-bg); -webkit-backdrop-filter: var(--sf-glass-blur); backdrop-filter: var(--sf-glass-blur); border: 1px solid var(--sf-glass-edge); box-shadow: var(--sf-glass-shadow); color: #3F5170; font: 600 14.5px 'Hind Siliguri', system-ui, sans-serif; text-align: left; cursor: pointer; }
  .mls-searchpill[hidden] { display: none; }
  .mls-searchpill svg { flex: none; }
  .mls-searchpill:focus-visible, .mls-srch-item:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
  .mls-srch { position: absolute; inset: 0; z-index: 2000; background: #F8FAFC; display: flex; flex-direction: column; }
  .mls-srch[hidden] { display: none; }
  .mls-srch-bar { display: flex; align-items: center; gap: 10px; padding: calc(14px + env(safe-area-inset-top)) 16px 12px; background: #fff; box-shadow: 0 2px 10px rgba(27, 42, 74, 0.06); }
  .mls-srch-field { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; height: 48px; padding: 0 14px; border: 1.5px solid #E6D8CC; border-radius: 14px; background: #FFFBF8; }
  .mls-srch-field input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: 500 16px 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; }
  .mls-srch-note { margin: 16px 22px 4px; font-size: 14px; color: #5B6B86; text-align: center; line-height: 1.5; }
  .mls-srch-note[hidden] { display: none; }
  .mls-srch-list { flex: 1; overflow-y: auto; padding: 8px 16px calc(16px + env(safe-area-inset-bottom)); max-width: 560px; width: 100%; margin: 0 auto; box-sizing: border-box; }
  .mls-srch-item { width: 100%; display: flex; align-items: center; gap: 12px; min-height: 58px; padding: 10px 12px; margin-bottom: 8px; border: 0; border-radius: 16px; background: #fff; box-shadow: 0 1px 6px rgba(27, 42, 74, 0.06); text-align: left; color: #1B2A4A; font-family: inherit; cursor: pointer; }
  .mls-srch-item svg { flex: none; }
  .mls-srch-txt { min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .mls-srch-txt b { font-size: 15px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mls-srch-txt small { font-size: 12.5px; color: #5B6B86; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .mls-cpin-svg, .mls-cpin-ground, .mls-cpin-bubble { transition: none; } }
  .mls-note.dim { color: #4A5568; font-weight: 500; margin-top: 8px; }
  .mls-top { position: absolute; left: 0; right: 0; top: 0; padding: 20px 18px 0; display: flex; align-items: center; gap: 12px; z-index: 1000; pointer-events: none; }
  .mls-top > * { pointer-events: auto; }
  .mls-brand { background: var(--sf-glass-bg); -webkit-backdrop-filter: var(--sf-glass-blur); backdrop-filter: var(--sf-glass-blur); border: 1px solid var(--sf-glass-edge); box-shadow: var(--sf-glass-shadow); padding: 6px 14px 6px 8px; border-radius: 16px; }
  .mls-round { width: 44px; height: 44px; border-radius: 22px; background: var(--sf-glass-bg); -webkit-backdrop-filter: var(--sf-glass-blur); backdrop-filter: var(--sf-glass-blur); border: 1px solid var(--sf-glass-edge); box-shadow: var(--sf-glass-shadow); color: #1B2A4A; font-size: 17px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .mls-round[hidden] { display: none; }
  .mls-brand { display: flex; align-items: center; gap: 10px; }
  .mls-brand[hidden] { display: none; }
  .mls-logo { width: 38px; height: 38px; border-radius: 12px; background: #1B2A4A; color: #FF6B35; display: flex; align-items: center; justify-content: center; font-size: 17px; }
  .mls-brand-t { display: flex; flex-direction: column; line-height: 1.15; }
  .mls-brand-t b { font-size: 18px; font-weight: 700; }
  .mls-brand-t small { font-size: 11px; font-weight: 500; color: #4A5568; }
  .mls-sheet { position: absolute; left: 0; right: 0; bottom: 0; max-width: 560px; margin: 0 auto; max-height: 60vh; overflow-y: auto; background: var(--sf-glass-strong-bg); -webkit-backdrop-filter: var(--sf-glass-blur); backdrop-filter: var(--sf-glass-blur); border: 1px solid var(--sf-glass-edge); border-bottom: 0; border-radius: 28px 28px 0 0; box-shadow: 0 -8px 32px rgba(27, 42, 74, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.8); padding: 12px 20px calc(22px + env(safe-area-inset-bottom)); z-index: 1000; }
  .mls-grab { width: 40px; height: 4px; border-radius: 2px; background: #E6D8CC; margin: 0 auto 14px; }
  .mls-keep { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; margin: 0 0 12px; border: 0; border-radius: 16px; background: #1F7A4D; color: #fff; font: 700 16px 'Hind Siliguri', system-ui, sans-serif; cursor: pointer; }
  .mls-keep[hidden] { display: none; }
  .mls-keep:focus-visible, .mls-sv-go:focus-visible, .mls-sv-x:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
  .mls-saved { margin-top: 16px; }
  .mls-saved[hidden] { display: none; }
  .mls-saved-h { margin: 0 0 8px; font-size: 13px; font-weight: 700; color: #4A5568; }
  .mls-sv { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
  .mls-sv-go { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-height: 52px; padding: 8px 14px; border: 1.5px solid #E6D8CC; border-radius: 14px; background: #FFFBF8; color: #1B2A4A; font-family: inherit; text-align: left; cursor: pointer; }
  .mls-sv-go b { max-width: 100%; font-size: 14.5px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mls-sv-go small { max-width: 100%; font-size: 12px; color: #4A5568; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mls-sv-go.cur { border-color: #1F7A4D; background: #F0FAF4; }
  .mls-sv-x { flex: none; width: 44px; height: 44px; border: 0; border-radius: 22px; background: #F1F4F8; color: #4A5568; font-size: 15px; cursor: pointer; }
  .mls-step[hidden] { display: none; }
  .mls-title { margin: 0 0 12px; font-size: 22px; font-weight: 700; }
  .mls-cur { margin: -4px 0 12px; font-size: 13px; color: #4A5568; }
  .mls-btns { display: flex; gap: 10px; }
  .mls-btn { flex: 1; min-width: 0; height: 58px; display: flex; align-items: center; gap: 8px; padding: 0 10px; border-radius: 16px; background: #fff; color: #1B2A4A; border: 1.5px solid #1B2A4A; text-align: left; font-family: inherit; cursor: pointer; }
  .mls-btn.dark { background: #1B2A4A; color: #fff; }
  .mls-btn-ic { font-size: 18px; flex: none; width: 22px; text-align: center; }
  .mls-btn-tx { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .mls-btn-tx b { font-size: 14.5px; font-weight: 700; white-space: nowrap; }
  .mls-btn-tx small { font-size: 11px; font-weight: 500; color: #4A5568; white-space: nowrap; }
  .mls-btn.dark small { color: #E6EAF2; }
  .mls-okrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .mls-relocate { flex: none; display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #FFD3BF; background: #FFF4EE; color: #E0531F; font: inherit; font-size: 13px; font-weight: 700; padding: 7px 12px; border-radius: 999px; cursor: pointer; }
  .mls-relocate:disabled { opacity: .55; cursor: default; }
  .mls-relocate:focus-visible { outline: 3px solid #FF6B35; outline-offset: 2px; }
  .mls-ok { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: #1F7A4D; }
  .mls-ok.wait { color: #5B6B86; }
  .mls-tiles { display: flex; gap: 10px; margin: 12px 0; }
  .mls-tile { flex: 1; background: #FFF4EC; border-radius: 14px; padding: 10px 14px; }
  .mls-tile small { display: block; font-size: 11.5px; font-weight: 600; color: #4A5568; }
  .mls-tile b { font-size: 16px; font-weight: 700; }
  .mls-addr { margin: 0 0 10px; font-size: 13px; line-height: 1.5; color: #4A5568; }
  .mls-two { display: flex; gap: 10px; }
  .mls-f { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; margin-top: 10px; }
  .mls-f span { font-size: 12px; font-weight: 600; color: #4A5568; }
  .mls-f select, .mls-f input, .mls-f textarea { box-sizing: border-box; width: 100%; height: 48px; border: 1.5px solid #E6D8CC; border-radius: 14px; padding: 0 14px; font: 500 15px 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFFBF8; }
  .mls-f textarea { height: 72px; padding: 10px 14px; resize: none; }
  .mls-f select:focus, .mls-f input:focus, .mls-f textarea:focus, .mls-btn:focus-visible, .mls-save:focus-visible, .mls-round:focus-visible, .mls-link:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
  .mls-link { display: block; width: 100%; margin-top: 10px; padding: 10px 0; border: 0; background: none; color: #1B2A4A; font: 700 13.5px 'Hind Siliguri', system-ui, sans-serif; text-align: left; cursor: pointer; text-decoration: underline; }
  .mls-note { margin: 0; font-size: 12.5px; color: #1F7A4D; font-weight: 600; }
  .mls-err { margin: 8px 0 0; color: #B42318; font-size: 13px; font-weight: 600; }
  .mls-save { width: 100%; margin-top: 14px; height: 56px; border: 0; border-radius: 16px; background: #FF6B35; color: #1B2A4A; font-family: inherit; font-size: 16px; font-weight: 700; cursor: pointer; }
  .mls-save:disabled { opacity: 0.55; cursor: not-allowed; }
</style>

<script>
  import { setDrop, getDrop, getSavedPlaces, removeSavedPlace, confirmDropToday } from '../../lib/marketCart.js';
  import { getCurrentPosition } from '../../lib/native-bridge.js';
  import { loadLeaflet as sfLoadLeaflet, mapRetryBox, removeMapRetryBox } from '../../lib/leafletLoader.js';
  import { addBaseMap } from '../../lib/baseMap.js';
  import { lookupPlaceName, searchPlaces } from '../../lib/placeLookup.js';
  import {
    UPAZILAS, BORDER_COLORS, getUnionUpazilaId, loadFeniGeo, findAreaAt, getFeniBounds,
    getUpazilaBorders, getDistrictBorder, getLabelPoints, getUnionBn, getUnionsOfUpazilaName,
  } from '../../data/feniAreas.js';
  import { addFeniOverlay } from '../../lib/feniOverlay.js';

  const $ = (id) => document.getElementById(id);
  const root = $('mlsRoot');
  let onDone = null;
  let daily = false;   // true = প্রতিদিনের "আজ কোথায় পৌঁছে দেব?" নিশ্চিতকরণ
  let pickMode = false; // true = শুধু জায়গা বাছাই (পিকআপ), ড্রপ ঠিকানা বদলায় না
  let step = 1;
  let picked = null;       // { lat, lng, address, upazila, union, source }
  let L = null, geo = null, map = null;
  let userMove = false; // ইউজার নিজে ম্যাপ টানছে/জুম করছে (প্রোগ্রাম্যাটিক মুভে সিলেক্ট নয়)
  const PIN_MIN_ZOOM = 14;
  const unLayers = {};
  let ov = null, selUn = null, token = 0;

  function setText(id, t) { const e = $(id); if (e) e.textContent = t; }
  function showErr(id, msg) { const e = $(id); if (!e) return; e.textContent = msg || ''; e.hidden = !msg; }
  function hasAddress() { try { return !!getDrop(); } catch (e) { return false; } }
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
  // লিখিত ঠিকানা: উপজেলা বাছলে তার ইউনিয়ন/পৌরসভা ড্রপডাউনে আসে
  function fillUnions(selected) {
    const sel = $('mlsWUn');
    sel.textContent = '';
    const first = document.createElement('option');
    first.value = ''; first.textContent = 'বেছে নিন';
    sel.appendChild(first);
    getUnionsOfUpazilaName($('mlsWUp').value).forEach((n) => {
      const o = document.createElement('option');
      o.value = n; o.textContent = n;
      sel.appendChild(o);
    });
    if (selected) {
      const hit = Array.from(sel.options).find((o) => o.value === selected || o.value.replace(/\s*(ইউনিয়ন|পৌরসভা)$/, '') === String(selected).replace(/\s*(ইউনিয়ন|পৌরসভা)$/, ''));
      if (hit) sel.value = hit.value;
    }
  }
  $('mlsWUp').addEventListener('change', () => fillUnions(''));
  fillUnions('');

  function upColor(id) { const u = UPAZILAS.find((x) => x.id === id); return u ? u.color : '#64748b'; }

  // শেয়ার্ড লোডার (src/lib/leafletLoader.js): নিজেদের সাইট থেকে, ফেইল হলে রিট্রাই
  function loadLeaflet() {
    return sfLoadLeaflet();
  }

  // ইউনিয়ন হাইলাইট — শেয়ার্ড ওভারলের স্টাইলে (src/lib/feniOverlay.js)
  function selectUnion(name) {
    selUn = name || null;
    if (ov) ov.highlight(selUn);
  }

  function bottomPad() {
    const sh = $('mlsSheet');
    return sh ? Math.min(sh.offsetHeight, Math.round(window.innerHeight * 0.6)) : 0;
  }

  function fitAll() {
    if (!map) return;
    if (geo) map.fitBounds(getFeniBounds(geo, 0.02), { animate: false, paddingBottomRight: [0, bottomPad()] });
    else map.setView([23.0159, 91.3976], 10);
  }

  async function initMap() {
    if (map) return;
    const res = await Promise.all([loadLeaflet(), loadFeniGeo().catch(() => null)]);
    L = window.L;
    geo = res[1];
    map = L.map($('mlsMap'), { zoomControl: false }).setView([23.0159, 91.3976], 10); // জুম: পিঞ্চ/স্ক্রল (উপরে সার্চ)
    addBaseMap(L, map); // স্মার্ট ফেনী ভেক্টর + বাংলা HTML লেবেল, ব্যর্থ হলে OSM
    if (geo) {
      // শেয়ার্ড ফেনী ম্যাপ: উপজেলা/ইউনিয়ন বর্ডার + নাম + ফ্রি প্যান (সব ম্যাপে একই চেহারা)
      ov = await addFeniOverlay(L, map, { geo });
      if (selUn) ov.highlight(selUn);
    }
    wirePin();
  }

  // ====================== মাঝের স্থির পিন ======================
  function pinActive() { return step === 2 || step === 4; }

  // পিনের ডগা = ম্যাপের দৃশ্যমান অংশের (হেডার ও শিটের মাঝের জায়গা) মাঝ
  function pinY() {
    const h = $('mlsMap').clientHeight || window.innerHeight;
    const top = 70;
    const bottom = h - bottomPad();
    return Math.round(Math.max(top + 120, Math.min(top + (bottom - top) / 2 + 20, bottom - 24)));
  }
  function syncPinY() { root.style.setProperty('--mls-pin-y', pinY() + 'px'); }

  function pinLatLng() {
    return map.containerPointToLatLng([map.getSize().x / 2, pinY()]);
  }

  // প্রোগ্রাম্যাটিক: lat/lng ঠিক পিনের নিচে আনা
  function moveTo(lat, lng, zoom) {
    if (!map) return;
    userMove = false;
    const z = zoom || Math.max(map.getZoom(), 16);
    const pt = map.project([lat, lng], z).add([0, map.getSize().y / 2 - pinY()]);
    map.setView(map.unproject(pt, z), z);
  }

  function setBubble(text, state, sub) {
    const b = $('mlsPinBubble');
    b.dataset.state = state || 'ok';
    setText('mlsPinT1', text || '');
    const t2 = $('mlsPinT2');
    t2.textContent = sub || '';
    t2.hidden = !sub;
    b.hidden = !text;
  }
  function hintBubble() { setBubble('ম্যাপ টেনে পিন আপনার জায়গায় আনুন', 'hint'); }

  function selectAtPin() {
    if (!pinActive()) return;
    if (map.getZoom() < PIN_MIN_ZOOM) { setBubble('আরেকটু জুম করে পিন ঠিক জায়গায় আনুন', 'hint'); return; }
    const p = pinLatLng();
    place(p.lat, p.lng, { fromPin: true });
  }

  function wirePin() {
    const el = $('mlsMap');
    const mark = () => { userMove = true; };
    el.addEventListener('pointerdown', mark, { passive: true });
    el.addEventListener('wheel', mark, { passive: true });
    map.on('movestart', () => { if (userMove && pinActive()) root.classList.add('mls-moving'); });
    map.on('moveend', () => {
      root.classList.remove('mls-moving');
      if (!userMove) return;
      userMove = false;
      selectAtPin();
    });
    // ট্যাপ করা জায়গা পিনের নিচে চলে আসে (দূর থেকে হলে জুমও), তারপর সিলেক্ট
    map.on('click', (e) => {
      if (!pinActive()) return;
      const c = map.latLngToContainerPoint(e.latlng);
      const dy = c.y - pinY(), dx = c.x - map.getSize().x / 2;
      if (Math.abs(dx) < 6 && Math.abs(dy) < 6) { selectAtPin(); return; }
      if (map.getZoom() < PIN_MIN_ZOOM) { moveTo(e.latlng.lat, e.latlng.lng, 16); userMove = true; return; }
      userMove = true;
      map.panBy([dx, dy]);
    });
    new ResizeObserver(() => syncPinY()).observe($('mlsSheet'));
    window.addEventListener('resize', syncPinY);
    syncPinY();
  }

  function unionLabel(un) { return un ? un + (/পৌরসভা/.test(un) ? '' : ' ইউনিয়ন') : ''; }

  // opts: { focus: GPS/সার্চ থেকে — ম্যাপ ওখানে নেওয়া, fromPin: ইউজার ম্যাপ টেনে ছাড়লো, name: জানা নাম }
  async function place(lat, lng, opts = {}) {
    if (!map) return;
    const area = geo ? findAreaAt(lat, lng, geo) : null;
    if (geo && !area) {
      const m = 'এই জায়গাটা ফেনীর বাইরে। ফেনীর ভেতরে পিন আনুন।';
      showErr('mlsErr2', m); setText('mlsPinHint', m);
      setText('mlsOkT', 'ফেনীর ভেতরে জায়গা বাছুন'); $('mlsOk').classList.add('wait');
      setBubble('ফেনী জেলার বাইরে — ফেনীর ভেতরে পিন আনুন', 'warn');
      // বাইরের লোকেশনে জুম নয়: ফেনীর পুরো ম্যাপে ফেরত
      fitAll();
      picked = null;
      $('mlsSave2').disabled = true; $('mlsSave4').disabled = true;
      return;
    }
    const my = ++token;
    if (area) selectUnion(area.union);
    if (opts.focus) moveTo(lat, lng, 17);
    picked = { lat: lat, lng: lng, address: '', upazila: area ? area.upazilaName : '', union: area ? area.unionBn : '', source: 'map' };
    setText('mlsOkT', opts.fromPin || opts.name ? 'পিনের জায়গা নেওয়া হয়েছে' : 'আপনার লোকেশন পাওয়া গেছে'); $('mlsOk').classList.remove('wait');
    showErr('mlsErr2', '');
    setText('mlsUp', picked.upazila || '—'); setText('mlsUn', picked.union || '—');
    $('mlsSave2').disabled = false; $('mlsSave4').disabled = false;
    setText('mlsPinHint', (picked.upazila ? picked.upazila + ' · ' : '') + (picked.union || '') + ' — পিন ঠিক থাকলে নিশ্চিত করুন।');
    const sub = [unionLabel(picked.union), picked.upazila].filter(Boolean).join(', ');
    const fallback = sub;
    picked.address = fallback;
    if (opts.name) {
      showName(opts.name, sub);
      return;
    }
    setBubble('জায়গার নাম খোঁজা হচ্ছে…', 'loading');
    const name = await lookupPlaceName(lat, lng);
    if (my !== token) return;
    showName(name, sub);
  }

  function showName(name, sub) {
    if (!picked) return;
    if (name) setBubble(name, 'ok', sub);
    else setBubble(sub || 'এই জায়গা', 'ok', '');
    picked.address = [name, sub].filter(Boolean).join(', ');
    const a = $('mlsAddr'); a.textContent = picked.address; a.hidden = !picked.address;
  }

  function go(n) {
    step = n;
    [1, 2, 3, 4].forEach((i) => { $('mlsS' + i).hidden = n !== i; });
    $('mlsBack').hidden = n === 1;
    $('mlsClose').hidden = !(n === 1 && (hasAddress() || pickMode));
    $('mlsBrand').hidden = n !== 1;
    $('mlsSearchBtn').hidden = !(n === 2 || n === 4);
    $('mlsPin').hidden = !(n === 2 || n === 4);
    if (n === 2 || n === 4) setTimeout(syncPinY, 30);
    showErr('mlsErr2', ''); showErr('mlsErr3', '');
    if (map) setTimeout(() => map.invalidateSize(), 50);
  }

  function clearPin() {
    token++;
    selectUnion(null);
    hintBubble();
    const a = $('mlsAddr'); if (a) a.hidden = true;
  }
  function backToOne() { clearPin(); picked = null; go(1); setTimeout(fitAll, 80); }

  function close() { root.hidden = true; document.body.style.overflow = ''; }

  async function open(cb, opts) {
    onDone = typeof cb === 'function' ? cb : null;
    pickMode = !!(opts && opts.pick);
    daily = !!(opts && opts.daily) && !pickMode;
    setText('mlsTitle', pickMode ? ((opts && opts.title) || 'কোথা থেকে আনবো?') : daily ? 'আজ কোথায় পৌঁছে দেব?' : 'কোথায় পৌঁছে দেব?');
    picked = null;
    root.hidden = false;
    document.body.style.overflow = 'hidden';
    const d = pickMode ? null : getDrop();
    const cur = $('mlsCur');
    if (d && d.address) { cur.textContent = 'বর্তমান ঠিকানা: ' + d.address; cur.hidden = false; } else cur.hidden = true;
    renderSaved(d);
    $('mlsKeep').hidden = !(daily && d);
    go(1);
    try {
      await initMap();
      removeMapRetryBox($('mlsMap'));
    } catch (e) {
      // আগে চুপচাপ ফাঁকা ম্যাপ থাকত; এখন আবার চেষ্টার বাটন
      mapRetryBox($('mlsMap'), () => { initMap().then(() => { clearPin(); map.invalidateSize(); fitAll(); }).catch(() => mapRetryBox($('mlsMap'), () => location.reload())); });
      return;
    }
    clearPin();
    map.invalidateSize();
    fitAll();
    $('mlsBtnMap').focus();
  }

  // সংরক্ষিত ঠিকানার তালিকা (ট্যাপে সেটাই সেট হয়; ✕ চাপলে তালিকা থেকে মুছে যায়)
  function renderSaved(cur) {
    const box = $('mlsSaved'), list = $('mlsSavedList');
    list.textContent = '';
    const items = pickMode ? [] : getSavedPlaces();
    box.hidden = !items.length;
    items.forEach((p, i) => {
      const row = document.createElement('div');
      row.className = 'mls-sv';
      const isCur = !!(cur && cur.address === p.address && cur.lat === p.lat && cur.lng === p.lng);
      const go = document.createElement('button');
      go.type = 'button';
      go.className = 'mls-sv-go' + (isCur ? ' cur' : '');
      const b = document.createElement('b');
      b.textContent = (isCur ? '✓ ' : '') + p.address;
      go.appendChild(b);
      const sub = [p.instructions, p.union, p.upazila].filter(Boolean).join(' · ');
      if (sub) { const sm = document.createElement('small'); sm.textContent = sub; go.appendChild(sm); }
      go.addEventListener('click', () => { finish({ ...p }); });
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'mls-sv-x';
      x.textContent = '✕';
      x.setAttribute('aria-label', 'এই ঠিকানা তালিকা থেকে মুছুন');
      x.addEventListener('click', () => { removeSavedPlace(i); renderSaved(cur); });
      row.appendChild(go);
      row.appendChild(x);
      list.appendChild(row);
    });
  }

  function finish(detail) {
    const addr = (detail.address || '').trim();
    if (!addr) return false;
    const lat = parseFloat(detail.lat), lng = parseFloat(detail.lng);
    if (pickMode) {
      close();
      if (onDone) {
        const f = onDone; onDone = null;
        f({ address: addr, lat: isFinite(lat) ? lat : null, lng: isFinite(lng) ? lng : null, upazila: detail.upazila || '', union: detail.union || '', instructions: detail.instructions || '' });
      }
      return true;
    }
    setDrop({
      address: addr,
      lat: isFinite(lat) ? lat : null,
      lng: isFinite(lng) ? lng : null,
      upazila: detail.upazila || '',
      union: detail.union || '',
      instructions: detail.instructions || '',
      source: detail.source || 'text',
    });
    if (detail.upazila) { try { localStorage.setItem('smartfeni_upazila', detail.upazila); window.dispatchEvent(new Event('smartfeni:upazila-changed')); } catch (e) {} }
    close();
    if (onDone) { const f = onDone; onDone = null; f(); }
    return true;
  }

  // ধাপ ১ → ২: বর্তমান লোকেশন → GPS → ম্যাপ নিজে কাস্টমারের ইউনিয়নে ফোকাস করে
  $('mlsBtnMap').addEventListener('click', () => {
    picked = null; clearPin();
    setText('mlsOkT', 'লোকেশন খোঁজা হচ্ছে...'); $('mlsOk').classList.add('wait');
    setText('mlsUp', '—'); setText('mlsUn', '—');
    $('mlsAddr').hidden = true; $('mlsSave2').disabled = true;
    go(2);
    locateMe();
  });
  function locateMe() {
    const b = $('mlsRelocate');
    b.disabled = true;
    setText('mlsOkT', 'লোকেশন খোঁজা হচ্ছে...'); $('mlsOk').classList.add('wait');
    showErr('mlsErr2', '');
    getCurrentPosition(
      (pos) => { b.disabled = false; place(pos.coords.latitude, pos.coords.longitude, { focus: true }); },
      () => {
        b.disabled = false;
        setText('mlsOkT', picked ? 'আগের পিন রাখা আছে' : 'লোকেশন পাওয়া যায়নি');
        if (picked) $('mlsOk').classList.remove('wait');
        showErr('mlsErr2', 'GPS চালু করে "আবার খুঁজুন" চাপুন, অথবা ম্যাপ টেনে পিন নিজের জায়গায় আনুন।');
      }
    );
  }
  $('mlsRelocate').addEventListener('click', locateMe);
  $('mlsKeep').addEventListener('click', () => {
    confirmDropToday();
    close();
    if (onDone) { const f = onDone; onDone = null; f(); }
  });
  $('mlsSave2').addEventListener('click', () => {
    if (!picked) { showErr('mlsErr2', 'আগে ম্যাপে লোকেশন বেছে নিন।'); return; }
    finish({ ...picked, instructions: $('mlsIns').value.trim() });
  });

  // ধাপ ১ → ৩: লিখিত ঠিকানা
  $('mlsBtnText').addEventListener('click', () => { picked = null; $('mlsWPinOk').hidden = true; go(3); $('mlsWUp').focus(); });
  $('mlsWPin').addEventListener('click', () => {
    picked = null; clearPin();
    $('mlsSave4').disabled = true;
    setText('mlsPinHint', 'ম্যাপ টেনে পিন আপনার জায়গায় আনুন, অথবা উপরে খুঁজুন।');
    go(4);
    setTimeout(fitAll, 80);
  });
  $('mlsCancel4').addEventListener('click', () => { clearPin(); picked = null; go(3); });
  $('mlsSave4').addEventListener('click', () => {
    if (!picked) return;
    const ok = $('mlsWPinOk');
    ok.textContent = 'পিন বসানো হয়েছে' + (picked.upazila ? ' · ' + picked.upazila : '') + (picked.union ? ' · ' + picked.union : '');
    ok.hidden = false;
    const sel = $('mlsWUp');
    Array.from(sel.options).forEach((o) => { if (o.value === picked.upazila) sel.value = o.value; });
    fillUnions(picked.union || '');
    go(3);
  });
  $('mlsSave3').addEventListener('click', () => {
    const up = $('mlsWUp').value.trim(), un = $('mlsWUn').value.trim();
    const area = $('mlsWArea').value.trim(), house = $('mlsWHouse').value.trim();
    if (!un) { showErr('mlsErr3', 'ইউনিয়ন / পৌরসভা বেছে নিন।'); return; }
    if (!area && !house) { showErr('mlsErr3', 'বাজার/এলাকার নাম অথবা বাসা ও রাস্তার ঠিকানা লিখুন।'); return; }
    const parts = [house, area, un + (/(ইউনিয়ন|পৌরসভা)$/.test(un) ? '' : ' ইউনিয়ন'), up].filter(Boolean);
    finish({
      address: parts.join(', '),
      lat: picked ? picked.lat : null,
      lng: picked ? picked.lng : null,
      upazila: up, union: un, instructions: '',
      source: picked ? 'map' : 'text',
    });
  });

  $('mlsBack').addEventListener('click', () => { if (step === 4) $('mlsCancel4').click(); else backToOne(); });
  $('mlsClose').addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || root.hidden) return;
    if (!$('mlsSearch').hidden) { $('mlsSearch').hidden = true; return; }
    if (step === 1 && (hasAddress() || pickMode)) close();
  });

  // ====================== জায়গা খোঁজা ======================
  const srch = $('mlsSearch'), srchInput = $('mlsSearchInput'), srchList = $('mlsSearchList'), srchNote = $('mlsSearchNote');
  const SRCH_HINT = 'জায়গার নাম লিখুন, যেমন মহিপাল বা ট্রাংক রোড';
  let srchSeq = 0, srchTimer = null;
  function openSearch() {
    srchInput.value = ''; srchList.textContent = '';
    srchNote.textContent = SRCH_HINT; srchNote.hidden = false;
    srch.hidden = false;
    setTimeout(() => srchInput.focus(), 60);
  }
  function closeSearch() { srch.hidden = true; srchInput.blur(); }
  async function runSearch(q) {
    const seq = ++srchSeq;
    srchNote.textContent = 'খোঁজা হচ্ছে…'; srchNote.hidden = false;
    const list = await searchPlaces(q, (r) => !geo || !!findAreaAt(r.lat, r.lng, geo));
    if (seq !== srchSeq) return;
    srchList.textContent = '';
    if (!list.length) { srchNote.textContent = 'কিছু পাওয়া যায়নি। অন্য নাম লিখে দেখুন, অথবা ম্যাপ টেনে পিন বসান।'; return; }
    srchNote.hidden = true;
    list.forEach((r) => {
      const area = geo ? findAreaAt(r.lat, r.lng, geo) : null;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'mls-srch-item';
      btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>';
      const t = document.createElement('span'); t.className = 'mls-srch-txt';
      const b = document.createElement('b'); b.textContent = r.name; t.appendChild(b);
      const subText = area ? [area.unionBn, area.upazilaName].filter(Boolean).join(', ') : r.sub;
      if (subText) { const sm = document.createElement('small'); sm.textContent = subText; t.appendChild(sm); }
      btn.appendChild(t);
      btn.addEventListener('click', () => { closeSearch(); place(r.lat, r.lng, { focus: true, name: r.name }); });
      srchList.appendChild(btn);
    });
  }
  srchInput.addEventListener('input', () => {
    clearTimeout(srchTimer);
    const q = srchInput.value.trim();
    if (q.length < 2) { srchSeq++; srchList.textContent = ''; srchNote.textContent = SRCH_HINT; srchNote.hidden = false; return; }
    srchTimer = setTimeout(() => runSearch(q), 350);
  });
  srchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); clearTimeout(srchTimer); const q = srchInput.value.trim(); if (q.length >= 2) runSearch(q); }
  });
  $('mlsSearchBtn').addEventListener('click', openSearch);
  $('mlsSearchClose').addEventListener('click', closeSearch);

  window.SFMarketLocation = { open, close };
</script>
