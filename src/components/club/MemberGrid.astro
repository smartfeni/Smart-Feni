---
// src/components/club/MemberGrid.astro
const { committee = [], regularMembers = [] } = Astro.props;

const sortedCommittee = [...committee].sort((a, b) => a.position_order - b.position_order);
const allEntries = [...sortedCommittee, ...regularMembers];

const preview = allEntries.slice(0, 3);

const president = sortedCommittee[0];
const secondThird = sortedCommittee.slice(1, 3);
const restCommittee = sortedCommittee.slice(3);
const restAll = [...restCommittee, ...regularMembers];

function formatDob(dob) {
  if (!dob) return null;
  const d = new Date(dob);
  return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

{allEntries.length > 0 && (
  <div class="section-card">
    <div class="section-head">
      <h3><i class="fas fa-user-group"></i> সদস্য তালিকা <span class="count-badge">{allEntries.length}</span></h3>
      {allEntries.length > 3 && (
        <button class="see-more-btn" id="memberSeeMoreBtn">সব দেখুন <i class="fas fa-arrow-right"></i></button>
      )}
    </div>

    <div class="member-grid">
      {preview.map((m) => (
        <div class="member-item">
          {m.photo ? (
            <img src={m.photo} alt={m.name} class="member-photo" />
          ) : (
            <div class="member-photo-placeholder"><i class="fas fa-user"></i></div>
          )}
          <p class="member-name">{m.name}</p>
          {m.is_committee ? (
            m.position && <p class="member-position">{m.position}</p>
          ) : (
            m.dob && <p class="member-dob">{formatDob(m.dob)}</p>
          )}
        </div>
      ))}
    </div>
  </div>
)}

{allEntries.length > 3 && (
  <div class="member-modal" id="memberModal">
    <div class="member-modal-backdrop" id="memberModalBackdrop"></div>
    <div class="member-modal-body">
      <button class="member-modal-close" id="memberModalClose"><i class="fas fa-xmark"></i></button>
      <h3><i class="fas fa-user-group"></i> সব সদস্য <span class="count-badge">{allEntries.length}</span></h3>

      <!-- ===== পোডিয়াম: সভাপতি সবচেয়ে বড়, উপরে, মুকুট ব্যাজ সহ ===== -->
      {president && (
        <div class="podium-president">
          <div class="podium-photo-lg-wrap">
            {president.photo ? (
              <img src={president.photo} alt={president.name} class="podium-photo-lg" />
            ) : (
              <div class="podium-photo-lg-placeholder"><i class="fas fa-user"></i></div>
            )}
            <span class="president-crown"><i class="fas fa-crown"></i></span>
          </div>
          <p class="podium-name-lg">{president.name}</p>
          {president.position && <p class="podium-position-lg">{president.position}</p>}
        </div>
      )}

      <!-- ===== ২য়-৩য় সারি: মাঝারি সাইজ, পাশাপাশি ===== -->
      {secondThird.length > 0 && (
        <div class="podium-row">
          {secondThird.map((m) => (
            <div class="podium-item-md">
              {m.photo ? (
                <img src={m.photo} alt={m.name} class="podium-photo-md" />
              ) : (
                <div class="podium-photo-md-placeholder"><i class="fas fa-user"></i></div>
              )}
              <p class="podium-name-md">{m.name}</p>
              {m.position && <p class="podium-position-md">{m.position}</p>}
            </div>
          ))}
        </div>
      )}

      <!-- ===== বাকি সবাই (কমিটি + সাধারণ সদস্য): গ্রিড কার্ড ===== -->
      {restAll.length > 0 && (
        <div class="podium-rest-grid">
          {restAll.map((m) => (
            <div class="podium-rest-card">
              {m.photo ? (
                <img src={m.photo} alt={m.name} class="podium-rest-photo" />
              ) : (
                <div class="podium-rest-photo-placeholder"><i class="fas fa-user"></i></div>
              )}
              <p class="podium-rest-name">{m.name}</p>
              {m.is_committee ? (
                m.position && <p class="podium-rest-position">{m.position}</p>
              ) : (
                <span class="regular-badge">সদস্য</span>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
)}

<style>
  .section-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 20px;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    gap: 8px;
  }

  .section-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .section-card h3 i {
    color: #FF6B35;
  }

  .count-badge {
    background: #FFF0EA;
    color: #FF6B35;
    font-size: 0.72rem;
    padding: 2px 10px;
    border-radius: 40px;
    flex-shrink: 0;
  }

  .see-more-btn {
    background: #FFF0EA;
    color: #FF6B35;
    border: none;
    padding: 7px 14px;
    border-radius: 40px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .member-photo {
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 16px;
    object-fit: cover;
    background: #F4F7FC;
  }

  .member-photo-placeholder {
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 16px;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
  }

  .member-name {
    font-size: 0.8rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-top: 8px;
    text-align: center;
  }

  .member-dob {
    font-size: 0.7rem;
    color: #8FA0BC;
    text-align: center;
  }

  .member-position {
    font-size: 0.7rem;
    color: #FF6B35;
    font-weight: 700;
    text-align: center;
  }

  /* ===== মোডাল ===== */
  .member-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    align-items: flex-end;
    justify-content: center;
  }

  .member-modal.open {
    display: flex;
  }

  .member-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }

  .member-modal-body {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 560px;
    max-height: 86vh;
    overflow-y: auto;
    border-radius: 24px 24px 0 0;
    padding: 26px 20px calc(90px + env(safe-area-inset-bottom, 0px));
  }

  .member-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    z-index: 2;
  }

  .member-modal-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .member-modal-body h3 i {
    color: #FF6B35;
  }

  /* ===== পোডিয়াম — সভাপতি ===== */
  .podium-president {
    text-align: center;
    margin-bottom: 22px;
  }

  .podium-photo-lg-wrap {
    position: relative;
    width: 148px;
    margin: 0 auto;
  }

  .podium-photo-lg {
    width: 148px;
    height: 190px;
    border-radius: 18px;
    object-fit: cover;
    border: 3px solid #FFF0EA;
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.2);
    display: block;
  }

  .podium-photo-lg-placeholder {
    width: 148px;
    height: 190px;
    border-radius: 18px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    border: 3px solid #FFF0EA;
  }

  /* মুকুট ব্যাজ — ফ্রেমের ডান-উপর কোণায়, হালকা বাঁকা */
  .president-crown {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #FFD166, #FF6B35);
    border: 2.5px solid #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(18deg);
    box-shadow: 0 3px 8px rgba(255, 107, 53, 0.35);
  }

  .president-crown i {
    color: #fff;
    font-size: 0.9rem;
    transform: rotate(-18deg);
  }

  .podium-name-lg {
    font-size: 1.02rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-top: 10px;
  }

  .podium-position-lg {
    font-size: 0.82rem;
    color: #FF6B35;
    font-weight: 700;
    margin-top: 2px;
  }

  /* ===== পোডিয়াম — ২য়/৩য় ===== */
  .podium-row {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin-bottom: 26px;
  }

  .podium-item-md {
    text-align: center;
  }

  .podium-photo-md {
    width: 104px;
    height: 134px;
    border-radius: 14px;
    object-fit: cover;
    border: 2.5px solid #F4F7FC;
  }

  .podium-photo-md-placeholder {
    width: 104px;
    height: 134px;
    border-radius: 14px;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    margin: 0 auto;
  }

  .podium-name-md {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-top: 8px;
  }

  .podium-position-md {
    font-size: 0.74rem;
    color: #FF6B35;
    font-weight: 600;
  }

  /* ===== বাকি সদস্য — গ্রিড কার্ড ===== */
  .podium-rest-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px 10px;
    border-top: 1px solid #F0F3F8;
    padding-top: 20px;
  }

  .podium-rest-card {
    text-align: center;
  }

  .podium-rest-photo {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 12px;
    object-fit: cover;
    background: #F4F7FC;
  }

  .podium-rest-photo-placeholder {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 12px;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }

  .podium-rest-name {
    font-size: 0.74rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-top: 6px;
    line-height: 1.25;
  }

  .podium-rest-position {
    font-size: 0.64rem;
    color: #FF6B35;
    font-weight: 600;
    margin-top: 1px;
    line-height: 1.2;
  }

  /* সাধারণ সদস্যদের জন্য বাঁকা "সদস্য" ব্যাজ */
  .regular-badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 700;
    color: #5A6E85;
    background: #F4F7FC;
    padding: 2px 9px;
    border-radius: 20px;
    margin-top: 4px;
    transform: rotate(-4deg);
  }

  @media (max-width: 400px) {
    .member-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .podium-rest-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px 8px;
    }
  }
</style>

<script>
  const btn = document.getElementById('memberSeeMoreBtn');
  const modal = document.getElementById('memberModal');
  const backdrop = document.getElementById('memberModalBackdrop');
  const closeBtn = document.getElementById('memberModalClose');

  btn?.addEventListener('click', () => modal?.classList.add('open'));
  backdrop?.addEventListener('click', () => modal?.classList.remove('open'));
  closeBtn?.addEventListener('click', () => modal?.classList.remove('open'));
</script>