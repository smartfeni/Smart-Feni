---
// ============================================================
// কম্পোনেন্ট: DoctorsTab (clinic-dashboard) — ক্লিনিকের ডাক্তার ম্যানেজমেন্ট
//
// প্যারেন্ট (my-clinic.astro) 'smartfeni:clinic-ready' ইভেন্টে
//   { clinic, isReceiver, isAdmin, userId } পাঠায় (ক্লিনিক বদলালেও আবার)।
//
// প্রতিনিধি (বা অ্যাডমিন) এখান থেকে:
//   • নিজের ক্লিনিকে কোন কোন ডাক্তার বসেন, সময়সূচি ও সিরিয়ালের নম্বর দেখা
//   • "ডাক্তার যোগ করুন" — আগে নাম/BMDC লিখে সার্চ (ডুপ্লিকেট এড়াতে):
//       - আগে থেকে থাকা ডাক্তার বাছলে → শুধু এই ক্লিনিকের চেম্বার ফর্ম
//       - না থাকলে → নতুন ডাক্তারের পুরো ফর্ম + চেম্বার ফর্ম
//   • চেম্বার/সময় এডিট, চেম্বার সরানো (ডাক্তারের প্রোফাইল থেকে যায়)
//   • ডাক্তারের নিজের তথ্য এডিট — শুধু যে প্রতিনিধি যোগ করেছেন (বা অ্যাডমিন)
//
// ব্যাকএন্ড: সব লেখা SECURITY DEFINER RPC দিয়ে (সরাসরি টেবিলে লেখা হয় না):
//   rep_search_doctors, rep_add_doctor, rep_save_chamber,
//   rep_update_doctor, rep_remove_chamber  (সব কাজ clinic_activity_log-এ লগ হয়)
// ছবি: doctor-photos বাকেটে (প্রতিনিধির insert পলিসি আছে), আপলোডের আগে কম্প্রেস
// প্রতিনিধির যোগ করা ডাক্তার সাথে সাথে পাবলিশড; অ্যাডমিন পরে যাচাই করেন
// ============================================================
---

<div class="dt-wrap">

  <div class="dt-note">
    <i class="fas fa-circle-info"></i>
    <span>আপনার যোগ করা তথ্য সাথে সাথে পাবলিক পেজে দেখা যায়। ডাক্তার আগে থেকে সাইটে থাকলে নতুন করে না বানিয়ে নাম বা BMDC লিখে খুঁজে বেছে নিন।</span>
  </div>

  <div class="dt-head">
    <h3>ক্লিনিকের ডাক্তার <span id="dtCount" class="dt-count"></span></h3>
    <button type="button" class="dt-btn primary" id="dtAddBtn"><i class="fas fa-plus"></i> ডাক্তার যোগ করুন</button>
  </div>

  <div id="dtList" class="dt-list"></div>

  <div class="dt-empty" id="dtEmpty" style="display:none;">
    <i class="fas fa-user-doctor"></i>
    <p>এই ক্লিনিকে এখনো কোনো ডাক্তার যোগ হয়নি।<br />উপরের বাটন চেপে প্রথম ডাক্তার যোগ করুন।</p>
  </div>

  <div id="dtLoading" class="dt-empty"><div class="dt-spinner"></div><p>লোড হচ্ছে...</p></div>

  <!-- ===== মোডাল (সার্চ / চেম্বার ফর্ম / ডাক্তার ফর্ম) ===== -->
  <div class="dt-overlay" id="dtOverlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="dtModalTitle">
    <div class="dt-sheet">
      <div class="dt-sheet-head">
        <h4 id="dtModalTitle">ডাক্তার যোগ করুন</h4>
        <button type="button" class="dt-close" id="dtClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
      </div>
      <div class="dt-sheet-body" id="dtModalBody"></div>
    </div>
  </div>

</div>

<style is:global>
  .dt-wrap { display: flex; flex-direction: column; gap: 14px; }
  .dt-note { display: flex; gap: 8px; align-items: flex-start; background: #EAF2FF; color: #1D4FA8; border-radius: 14px; padding: 11px 14px; font-size: 0.78rem; line-height: 1.6; font-weight: 600; }
  .dt-note i { margin-top: 3px; }

  .dt-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .dt-head h3 { font-size: 1.02rem; font-weight: 700; color: #1B2A4A; }
  .dt-count { color: #FF6B35; font-weight: 800; }

  .dt-btn { border: none; padding: 12px 16px; border-radius: 14px; font-weight: 700; font-size: 0.88rem; cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; justify-content: center; gap: 7px; }
  .dt-btn.primary { background: #FF6B35; color: #fff; }
  .dt-btn.soft { background: #F1F4F9; color: #44506B; }
  .dt-btn.blue { background: #EAF2FF; color: #1D4FA8; }
  .dt-btn.red { background: #FFF0EA; color: #D14343; }
  .dt-btn.red.confirming { background: #D14343; color: #fff; }
  .dt-btn.wide { width: 100%; }
  .dt-btn.small { padding: 9px 13px; font-size: 0.8rem; border-radius: 12px; }
  .dt-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .dt-list { display: flex; flex-direction: column; gap: 12px; }
  .dt-card { background: #fff; border-radius: 18px; padding: 16px; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06); }
  .dt-card-top { display: flex; gap: 12px; align-items: center; }
  .dt-photo { width: 56px; height: 56px; border-radius: 16px; background: #EAF6F9; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; overflow: hidden; flex-shrink: 0; }
  .dt-photo img { width: 100%; height: 100%; object-fit: cover; }
  .dt-info { min-width: 0; flex: 1; }
  .dt-name { font-size: 0.98rem; font-weight: 700; color: #1B2A4A; line-height: 1.4; }
  .dt-sub { font-size: 0.8rem; color: #5A6E85; margin-top: 2px; line-height: 1.5; }
  .dt-meta { font-size: 0.74rem; color: #8FA0BC; margin-top: 2px; }
  .dt-chip { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; background: #FFF4D6; color: #9A6412; margin-top: 4px; }

  .dt-slots { margin-top: 12px; background: #F8FAFC; border-radius: 14px; padding: 10px 13px; font-size: 0.82rem; color: #44506B; line-height: 1.75; }
  .dt-slots b { color: #1B2A4A; }
  .dt-slots .dt-noslot { color: #8FA0BC; }
  .dt-chfoot { margin-top: 8px; font-size: 0.8rem; color: #5A6E85; display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .dt-chfoot i { color: #FF6B35; margin-right: 4px; }
  .dt-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .dt-actions .dt-btn { flex: 1; min-width: 130px; }
  .dt-removehint { margin-top: 8px; font-size: 0.76rem; color: #B42318; font-weight: 600; line-height: 1.55; }

  .dt-empty { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 46px 10px; color: #B0BCCB; text-align: center; }
  .dt-empty i { font-size: 2.2rem; }
  .dt-empty p { font-size: 0.9rem; color: #8FA0BC; line-height: 1.65; }
  .dt-spinner { width: 30px; height: 30px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: dtSpin 0.8s linear infinite; }
  @keyframes dtSpin { to { transform: rotate(360deg); } }

  /* মোডাল */
  .dt-overlay { position: fixed; inset: 0; z-index: 10060; background: rgba(15, 23, 42, 0.55); display: flex; align-items: flex-end; justify-content: center; }
  .dt-sheet { background: #fff; width: min(580px, 100%); max-height: 94vh; max-height: 94dvh; border-radius: 22px 22px 0 0; display: flex; flex-direction: column; box-shadow: 0 -10px 40px rgba(15, 23, 42, 0.25); }
  @media (min-width: 640px) { .dt-overlay { align-items: center; } .dt-sheet { border-radius: 22px; } }
  .dt-sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px 12px; border-bottom: 1px solid #EEF2F7; }
  .dt-sheet-head h4 { font-size: 1.02rem; font-weight: 700; color: #1B2A4A; }
  .dt-close { width: 36px; height: 36px; border-radius: 50%; border: none; background: #F1F4F9; color: #5A6E85; cursor: pointer; font-size: 1rem; }
  .dt-sheet-body { padding: 16px 18px 26px; overflow-y: auto; -webkit-overflow-scrolling: touch; }

  .dt-field { margin-bottom: 14px; }
  .dt-field label, .dt-label { display: block; font-size: 0.8rem; font-weight: 700; color: #1B2A4A; margin-bottom: 6px; }
  .dt-label .dt-opt { color: #8FA0BC; font-weight: 600; }
  .dt-input, .dt-select, .dt-textarea { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1.5px solid #E5EAF0; background: #FBFCFE; font-size: 16px; font-family: inherit; color: #1B2A4A; }
  .dt-textarea { min-height: 84px; resize: vertical; line-height: 1.6; }
  .dt-input:focus, .dt-select:focus, .dt-textarea:focus { outline: none; border-color: #FF6B35; background: #fff; }
  .dt-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .dt-help { font-size: 0.74rem; color: #8FA0BC; margin-top: 5px; line-height: 1.55; }
  .dt-section { font-size: 0.86rem; font-weight: 800; color: #0891B2; margin: 20px 0 12px; padding-top: 14px; border-top: 1px dashed #E5EAF0; }
  .dt-check { display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: #44506B; font-weight: 600; margin-top: 8px; cursor: pointer; }
  .dt-check input { width: 18px; height: 18px; accent-color: #FF6B35; }

  .dt-specs { display: flex; flex-wrap: wrap; gap: 7px; }
  .dt-spec { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 20px; border: 1.5px solid #E5EAF0; background: #fff; font-size: 0.8rem; font-weight: 700; color: #5A6E85; cursor: pointer; }
  .dt-spec input { display: none; }
  .dt-spec.on { background: #FF6B35; border-color: #FF6B35; color: #fff; }

  .dt-photo-pick { display: flex; align-items: center; gap: 12px; }
  .dt-photo-pick .dt-photo { width: 72px; height: 72px; }
  .dt-photo-pick input[type=file] { display: none; }

  .dt-slot-row { display: grid; grid-template-columns: 1.3fr 1fr 1fr auto; gap: 6px; align-items: center; margin-bottom: 8px; }
  .dt-slot-row .dt-select, .dt-slot-row .dt-input { padding: 10px 8px; border-radius: 12px; font-size: 15px; }
  .dt-slot-del { width: 36px; height: 40px; border: none; border-radius: 12px; background: #FFF0EA; color: #D14343; cursor: pointer; }

  .dt-result { display: flex; gap: 11px; align-items: center; width: 100%; text-align: left; background: #fff; border: 1.5px solid #E5EAF0; border-radius: 16px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer; font-family: inherit; }
  .dt-result:hover { border-color: #FF6B35; }
  .dt-result.off { opacity: 0.6; cursor: not-allowed; }
  .dt-result .dt-photo { width: 44px; height: 44px; border-radius: 12px; font-size: 1.2rem; }
  .dt-result-here { color: #1B7A3C; background: #EAFBF0; }

  .dt-picked { display: flex; gap: 12px; align-items: center; background: #F8FAFC; border-radius: 16px; padding: 12px; margin-bottom: 14px; }
  .dt-msg { margin-top: 12px; font-size: 0.84rem; font-weight: 700; color: #D14343; line-height: 1.6; }
  .dt-msg.ok { color: #1B7A3C; }
  .dt-savebar { margin-top: 18px; display: flex; gap: 10px; }
  .dt-savebar .dt-btn { flex: 1; }

  .dt-toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); background: #1B2A4A; color: #fff; padding: 12px 20px; border-radius: 14px; font-size: 0.86rem; font-weight: 700; z-index: 10080; max-width: 90vw; text-align: center; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.3); }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImage } from '../../lib/imageCompress.js';

  const BN = '০১২৩৪৫৬৭৮৯';
  const toBn = (n) => String(n).replace(/\d/g, (d) => BN[d]);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const $ = (id) => document.getElementById(id);

  const WEEKDAYS = { 0: 'রবিবার', 1: 'সোমবার', 2: 'মঙ্গলবার', 3: 'বুধবার', 4: 'বৃহস্পতিবার', 5: 'শুক্রবার', 6: 'শনিবার' };
  const WEEKDAY_ORDER = [6, 0, 1, 2, 3, 4, 5]; // শনি থেকে শুরু (বাংলাদেশের সপ্তাহ)
  const UPAZILAS = [
    ['feni-sadar', 'ফেনী সদর'], ['chhagalnaiya', 'ছাগলনাইয়া'], ['daganbhuiyan', 'দাগনভূঞা'],
    ['parshuram', 'পরশুরাম'], ['fulgazi', 'ফুলগাজী'], ['sonagazi', 'সোনাগাজী'],
  ];
  const MAX_SLOTS = 28;

  const ERRORS = [
    ['duplicate_bmdc', 'এই BMDC নম্বরে আগে থেকেই একজন ডাক্তার আছেন। ডাক্তার যোগ করার ধাপে নাম বা BMDC লিখে খুঁজে তাঁকে বেছে নিন।'],
    ['daily_limit', 'গত ২৪ ঘণ্টায় ১৫ জন নতুন ডাক্তার যোগ করার সীমা শেষ। পরে আবার চেষ্টা করুন। আগে থেকে থাকা ডাক্তারের চেম্বার যোগ করতে সমস্যা নেই।'],
    ['not_creator', 'এই ডাক্তারের তথ্য শুধু যে প্রতিনিধি যোগ করেছেন তিনিই বদলাতে পারবেন।'],
    ['doctor_unavailable', 'এই ডাক্তার এখনো পাবলিশড নন। অ্যাডমিন যাচাই করার পর চেম্বার যোগ করা যাবে।'],
    ['not_allowed', 'এই কাজ করার অনুমতি আপনার নেই।'],
    ['bmdc_required', 'BMDC নম্বর দিন, অথবা "BMDC নম্বর নেই" টিক দিন।'],
    ['specialty_required', 'অন্তত একটা স্পেশালিটি বাছুন।'],
    ['name_required', 'ডাক্তারের নাম দিন।'],
    ['invalid_photo', 'ছবি ঠিকমতো আপলোড হয়নি, আবার দিন।'],
    ['invalid_number', 'ফি বা অভিজ্ঞতার সংখ্যা ঋণাত্মক হতে পারবে না।'],
    ['too_many_slots', 'সর্বোচ্চ ২৮টা সময় দেওয়া যাবে।'],
    ['invalid_slot', 'সময় ঠিক নেই। প্রতিটার শেষ সময় শুরুর পরে হতে হবে।'],
    ['clinic_not_found', 'ক্লিনিক খুঁজে পাওয়া যায়নি।'],
  ];
  const errMsg = (error) => {
    const m = String(error?.message || error || '');
    const hit = ERRORS.find(([k]) => m.includes(k));
    return hit ? hit[1] : 'সেভ করা যায়নি, একটু পরে আবার চেষ্টা করুন।';
  };

  let ctx = null;          // { clinic, isReceiver, isAdmin, userId }
  let specialties = [];    // [{ slug, name_bn }]
  let specMap = {};
  let items = [];          // ক্লিনিকের চেম্বার + ডাক্তার
  let loadSeq = 0;
  let modal = null;        // { mode, doctor, chamber, photoUrl, busy }
  let searchTimer = null;
  let searchSeq = 0;
  let removeTimer = null;

  // ---------- ছোট হেল্পার ----------
  function toast(text) {
    const t = document.createElement('div');
    t.className = 'dt-toast';
    t.textContent = text;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 2800);
  }

  function hhmm(t) { return String(t || '').slice(0, 5); }

  function fmtTime(t) {
    const [h, m] = hhmm(t).split(':').map(Number);
    if (Number.isNaN(h)) return '';
    const h12 = h % 12 === 0 ? 12 : h % 12;
    return `${toBn(h12)}:${toBn(String(m).padStart(2, '0'))} ${h < 12 ? 'AM' : 'PM'}`;
  }

  const specNames = (arr) => (arr || []).map((s) => specMap[s] || s).join(', ');
  const upazilaLabel = (slug) => (UPAZILAS.find((u) => u[0] === slug) || [])[1] || '';

  function photoHtml(url) {
    return url ? `<img src="${esc(url)}" alt="" loading="lazy" />` : '<i class="fas fa-user-doctor"></i>';
  }

  // ---------- ডাটা লোড ----------
  async function loadSpecialties() {
    if (specialties.length) return;
    const { data } = await supabase.from('specialties').select('slug, name_bn').eq('is_active', true).order('sort_order');
    specialties = data || [];
    specMap = {};
    specialties.forEach((s) => { specMap[s.slug] = s.name_bn; });
  }

  async function loadList() {
    if (!ctx) return;
    const seq = ++loadSeq;
    $('dtLoading').style.display = 'flex';
    $('dtEmpty').style.display = 'none';
    $('dtList').innerHTML = '';

    await loadSpecialties();

    const { data, error } = await supabase
      .from('doctor_chambers')
      .select('id, doctor_id, place_name, address, upazila, serial_phone, serial_whatsapp, fee, note, updated_at, doctors!inner(id, name_bn, name_en, photo_url, specialties, degrees, bmdc_no, no_bmdc, bio, experience_years, default_fee, upazila, created_by, status), chamber_slots(weekday, start_time, end_time)')
      .eq('clinic_id', ctx.clinic.id);

    if (seq !== loadSeq) return;
    $('dtLoading').style.display = 'none';

    if (error) {
      $('dtList').innerHTML = `<div class="dt-msg">ডাক্তারের তালিকা লোড করা যায়নি। পেজ রিফ্রেশ করে আবার চেষ্টা করুন।</div>`;
      return;
    }

    items = (data || []).sort((a, b) => String(a.doctors.name_bn).localeCompare(String(b.doctors.name_bn), 'bn'));
    renderList();
  }

  function renderList() {
    const list = $('dtList');
    $('dtCount').textContent = items.length ? `(${toBn(items.length)})` : '';
    $('dtEmpty').style.display = items.length ? 'none' : 'flex';

    list.innerHTML = items.map((c) => {
      const d = c.doctors;
      const slots = c.chamber_slots || [];
      const days = WEEKDAY_ORDER.map((wd) => {
        const ds = slots.filter((s) => s.weekday === wd).sort((a, b) => hhmm(a.start_time).localeCompare(hhmm(b.start_time)));
        return ds.length ? `<div><b>${WEEKDAYS[wd]}:</b> ${ds.map((s) => `${fmtTime(s.start_time)} – ${fmtTime(s.end_time)}`).join(', ')}</div>` : '';
      }).join('');
      const canEditDoctor = ctx.isAdmin || d.created_by === ctx.userId;
      const sub = [specNames(d.specialties), d.degrees].filter(Boolean).join(' · ');

      return `
