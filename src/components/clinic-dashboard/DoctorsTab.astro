  function collectChamber() {
    const phone = $('dtPhone').value.trim();
    if (!phone) return { error: 'সিরিয়ালের ফোন নম্বর দিন।' };

    const slots = [];
    for (const row of document.querySelectorAll('#dtSlots .dt-slot-row')) {
      const weekday = Number(row.querySelector('.dt-sl-day').value);
      const start = row.querySelector('.dt-sl-start').value;
      const end = row.querySelector('.dt-sl-end').value;
      if (!start || !end) return { error: 'প্রতিটা সময়ের শুরু ও শেষ দিন, নয়তো সেই লাইন মুছে দিন।' };
      if (end <= start) return { error: `${WEEKDAYS[weekday]}-এর শেষ সময় শুরুর পরে হতে হবে।` };
      slots.push({ weekday, start, end });
    }
    if (slots.length > MAX_SLOTS) return { error: 'সর্বোচ্চ ২৮টা সময় দেওয়া যাবে।' };

    const feeRaw = $('dtFee').value.trim();
    const fee = feeRaw === '' ? null : Number(feeRaw);
    if (fee !== null && (!Number.isFinite(fee) || fee < 0)) return { error: 'ফি ঠিকমতো লিখুন।' };

    return {
      chamber: {
        serial_phone: phone,
        serial_whatsapp: $('dtWa').value.trim() || null,
        fee,
        address: $('dtAddr').value.trim() || null,
        upazila: $('dtUpazila').value || null,
        note: $('dtNote').value.trim() || null,
        slots,
      },
    };
  }

