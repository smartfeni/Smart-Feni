        <button type="button" class="dt-btn primary" data-act="${editing ? 'save-doctor' : 'save-new'}" id="dtSaveBtn">${editing ? 'সেভ করুন' : 'ডাক্তার যোগ করুন'}</button>
      </div>`;
    openModal();
  }

  // ---------- ছবি আপলোড ----------
  async function handlePhoto(file) {
    const help = $('dtPhotoHelp');
    if (!file) return;
    help.textContent = 'ছবি আপলোড হচ্ছে...';
    try {
      const out = await compressImage(file, { maxDimension: 900, quality: 0.82, skipIfSmallerThan: 250 * 1024 });
      const extMap = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' };
      const ext = extMap[out.type];
      if (!ext) throw new Error('শুধু JPG, PNG বা WebP ছবি দিন।');
      if (out.size > 3 * 1024 * 1024) throw new Error('ছবি অনেক বড়। ছোট ছবি দিন।');

      const path = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
      const { error } = await supabase.storage.from('doctor-photos').upload(path, out, { contentType: out.type, upsert: false });
      if (error) throw new Error('ছবি আপলোড হয়নি, আবার চেষ্টা করুন।');

      const url = supabase.storage.from('doctor-photos').getPublicUrl(path).data.publicUrl;
      if (modal) modal.photoUrl = url;
      $('dtPhotoPreview').innerHTML = photoHtml(url);
      help.textContent = 'ছবি যোগ হয়েছে ✓';
    } catch (e) {
      help.textContent = e?.message || 'ছবি আপলোড হয়নি।';
    }
  }

  // ---------- সেভ অ্যাকশন ----------
  function setMsg(text) {
    const m = $('dtMsg');
    if (!m) return;
    m.textContent = text || '';
    m.style.display = text ? 'block' : 'none';
  }

  function setBusy(on, label) {
    const b = $('dtSaveBtn');
    if (!b) return;
    modal && (modal.busy = on);
    b.disabled = on;
    if (on) { b.dataset.old = b.textContent; b.textContent = 'সেভ হচ্ছে...'; }
    else if (b.dataset.old) b.textContent = label || b.dataset.old;
  }

  async function afterSave(text) {
    closeModal();
    toast(text);
    await loadList();
  }

  async function saveChamber() {
    if (modal?.busy) return;
    setMsg('');
    const c = collectChamber();
    if (c.error) { setMsg(c.error); return; }
    setBusy(true);
    const { error } = await supabase.rpc('rep_save_chamber', { p_clinic: ctx.clinic.id, p_doctor: modal.doctor.id, p_chamber: c.chamber });
    if (error) { setBusy(false); setMsg(errMsg(error)); return; }
    await afterSave('চেম্বারের তথ্য সেভ হয়েছে');
  }

  async function saveNewDoctor() {
    if (modal?.busy) return;
    setMsg('');
    const d = collectDoctor();
    if (d.error) { setMsg(d.error); return; }
    const c = collectChamber();
    if (c.error) { setMsg(c.error); return; }
    setBusy(true);
    const { error } = await supabase.rpc('rep_add_doctor', { p_clinic: ctx.clinic.id, p_doc: d.doc, p_chamber: c.chamber });
    if (error) { setBusy(false); setMsg(errMsg(error)); return; }
    await afterSave('ডাক্তার যোগ হয়েছে');
  }

  async function saveDoctor() {
    if (modal?.busy) return;
    setMsg('');
    const d = collectDoctor();
    if (d.error) { setMsg(d.error); return; }
    setBusy(true);
    const { error } = await supabase.rpc('rep_update_doctor', { p_clinic: ctx.clinic.id, p_doctor: modal.doctor.id, p_doc: d.doc });
    if (error) { setBusy(false); setMsg(errMsg(error)); return; }
    await afterSave('ডাক্তারের তথ্য সেভ হয়েছে');
  }

  async function removeChamber(btn, doctorId) {
    if (btn.dataset.confirming !== '1') {
      btn.dataset.confirming = '1';
      btn.classList.add('confirming');
      btn.innerHTML = '<i class="fas fa-triangle-exclamation"></i> নিশ্চিত? আবার চাপুন';
      const card = btn.closest('.dt-card');
      if (card && !card.querySelector('.dt-removehint')) {
        const hint = document.createElement('div');
        hint.className = 'dt-removehint';
        hint.textContent = 'এটা শুধু আপনার ক্লিনিকের তালিকা থেকে সরাবে। ডাক্তারের প্রোফাইল ও অন্য চেম্বার থাকবে।';
        card.appendChild(hint);
      }
      clearTimeout(removeTimer);
      removeTimer = setTimeout(() => renderList(), 5000);
      return;
    }
    clearTimeout(removeTimer);
    btn.disabled = true;
    const { error } = await supabase.rpc('rep_remove_chamber', { p_clinic: ctx.clinic.id, p_doctor: doctorId });
    if (error) { toast(errMsg(error)); renderList(); return; }
    toast('ক্লিনিকের তালিকা থেকে সরানো হয়েছে');
    await loadList();
  }

  // ---------- ইভেন্ট ----------
  $('dtAddBtn').addEventListener('click', showSearch);
  $('dtClose').addEventListener('click', closeModal);
  $('dtOverlay').addEventListener('click', (e) => { if (e.target === $('dtOverlay')) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal) closeModal(); });

  // কার্ডের বাটন
  $('dtList').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const card = btn.closest('.dt-card');
    const item = items.find((c) => c.id === card?.dataset.chamber);
    if (!item) return;
    if (btn.dataset.act === 'edit-chamber') showChamberForm(item.doctors, item);
    else if (btn.dataset.act === 'edit-doctor') showDoctorForm(item.doctors);
    else if (btn.dataset.act === 'remove') removeChamber(btn, item.doctor_id);
  });

  // মোডালের ভেতরের ক্লিক (ডেলিগেশন)
  $('dtModalBody').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const act = btn.dataset.act;

    if (act === 'cancel') closeModal();
    else if (act === 'new-doctor') {
      const q = ($('dtSearch')?.value || '').trim();
      // BMDC-র মতো (ইংরেজি/সংখ্যা) হলে নাম হিসেবে প্রিফিল করি না
      showDoctorForm(null, /^[A-Za-z0-9\-\s]+$/.test(q) ? '' : q);
    } else if (act === 'pick') {
      let rows = [];
      try { rows = JSON.parse($('dtResults').dataset.rows || '[]'); } catch (_) { /* উপেক্ষা */ }
      const r = rows.find((x) => x.id === btn.dataset.id);
      if (!r) return;
      const existing = items.find((c) => c.doctor_id === r.id);
      showChamberForm(r, existing || null);
    } else if (act === 'add-slot') {
      const box = $('dtSlots');
      if (box.querySelectorAll('.dt-slot-row').length >= MAX_SLOTS) { setMsg('সর্বোচ্চ ২৮টা সময় দেওয়া যাবে।'); return; }
      box.insertAdjacentHTML('beforeend', slotRowHtml(null));
    } else if (act === 'del-slot') btn.closest('.dt-slot-row')?.remove();
    else if (act === 'save-chamber') saveChamber();
    else if (act === 'save-new') saveNewDoctor();
    else if (act === 'save-doctor') saveDoctor();
  });

  $('dtModalBody').addEventListener('input', (e) => {
    if (e.target.id === 'dtSearch') {
      clearTimeout(searchTimer);
      const v = e.target.value;
      searchTimer = setTimeout(() => runSearch(v), 320);
    }
  });

  $('dtModalBody').addEventListener('change', (e) => {
    const t = e.target;
    if (t.id === 'dtPhotoFile') handlePhoto(t.files?.[0]);
    else if (t.id === 'dtNoBmdc') {
      const inp = $('dtBmdc');
      inp.disabled = t.checked;
      if (t.checked) inp.value = '';
    } else if (t.classList?.contains('dt-spec-in')) {
      t.closest('.dt-spec')?.classList.toggle('on', t.checked);
    }
  });

  // প্যারেন্ট থেকে ক্লিনিক এলে (বা বদলালে) লোড
  window.addEventListener('smartfeni:clinic-ready', (e) => {
    const prevId = ctx?.clinic?.id;
    ctx = e.detail;
    if (prevId && prevId !== ctx.clinic.id) closeModal();
    if (prevId === ctx.clinic.id && items.length) return; // একই ক্লিনিক, ডেটা আছে
    loadList();
  });
</script>