  async function runSearch(q) {
    const box = $('dtResults');
    if (!box) return;
    const text = q.trim();
    if (text.length < 2) { box.innerHTML = ''; return; }
    const seq = ++searchSeq;
    box.innerHTML = '<div class="dt-empty" style="padding:18px;"><div class="dt-spinner"></div></div>';

    const { data, error } = await supabase.rpc('rep_search_doctors', { p_clinic: ctx.clinic.id, p_query: text, p_limit: 8 });
    if (seq !== searchSeq || !$('dtResults')) return;

    if (error) { box.innerHTML = `<div class="dt-msg">${esc(errMsg(error))}</div>`; return; }
    const rows = data || [];
    if (!rows.length) {
      box.innerHTML = '<div class="dt-help" style="margin:4px 0 14px;">এই নামে কেউ পাওয়া যায়নি। নিচের বাটন চেপে নতুন ডাক্তার যোগ করুন।</div>';
      return;
    }
    box.innerHTML = rows.map((r) => {
      const pending = r.status !== 'published';
      return `
        <button type="button" class="dt-result ${pending ? 'off' : ''}" data-act="pick" data-id="${esc(r.id)}" ${pending ? 'disabled' : ''}>
          <div class="dt-photo">${photoHtml(r.photo_url)}</div>
          <div class="dt-info">
            <div class="dt-name">${esc(r.name_bn)}</div>
            <div class="dt-sub">${esc(specNames(r.specialties))}</div>
            <div class="dt-meta">${r.bmdc_no ? 'BMDC: ' + esc(r.bmdc_no) : 'BMDC নম্বর নেই'}${r.upazila ? ' · ' + esc(upazilaLabel(r.upazila)) : ''}</div>
            ${r.has_chamber_here ? '<span class="dt-chip dt-result-here"><i class="fas fa-check"></i> এই ক্লিনিকে আছেন</span>' : ''}
            ${pending ? '<span class="dt-chip"><i class="fas fa-hourglass-half"></i> অ্যাডমিন রিভিউয়ের অপেক্ষায়</span>' : ''}
          </div>
        </button>`;
    }).join('');
    box.dataset.rows = JSON.stringify(rows);
  }

  // --- চেম্বার ফর্ম ---
  function slotRowHtml(s) {
    const opts = WEEKDAY_ORDER.map((wd) => `<option value="${wd}" ${s && Number(s.weekday) === wd ? 'selected' : ''}>${WEEKDAYS[wd]}</option>`).join('');
    return `
      <div class="dt-slot-row">
        <select class="dt-select dt-sl-day" aria-label="বার">${opts}</select>
        <input type="time" class="dt-input dt-sl-start" value="${s ? esc(hhmm(s.start_time || s.start)) : ''}" aria-label="শুরু" />
        <input type="time" class="dt-input dt-sl-end" value="${s ? esc(hhmm(s.end_time || s.end)) : ''}" aria-label="শেষ" />
        <button type="button" class="dt-slot-del" data-act="del-slot" aria-label="সময় মুছুন"><i class="fas fa-xmark"></i></button>
      </div>`;
  }

