  function collectDoctor() {
    const nameBn = $('dtNameBn').value.trim();
    if (!nameBn) return { error: 'ডাক্তারের নাম দিন।' };
    const specs = [...document.querySelectorAll('#dtSpecs .dt-spec-in:checked')].map((i) => i.value);
    if (!specs.length) return { error: 'অন্তত একটা স্পেশালিটি বাছুন।' };
    const noBmdc = $('dtNoBmdc').checked;
    const bmdc = $('dtBmdc').value.trim();
    if (!bmdc && !noBmdc) return { error: 'BMDC নম্বর দিন, অথবা "BMDC নম্বর নেই" টিক দিন।' };

    const num = (id) => { const v = $(id).value.trim(); return v === '' ? null : Number(v); };
    const exp = num('dtExp');
    const fee = num('dtDefFee');
    if ((exp !== null && (!Number.isFinite(exp) || exp < 0)) || (fee !== null && (!Number.isFinite(fee) || fee < 0))) {
      return { error: 'অভিজ্ঞতা বা ফি ঠিকমতো লিখুন।' };
    }

    return {
      doc: {
        name_bn: nameBn,
        name_en: $('dtNameEn').value.trim() || null,
        photo_url: modal?.photoUrl || null,
        specialties: specs,
        degrees: $('dtDegrees').value.trim() || null,
        bmdc_no: bmdc || null,
        no_bmdc: noBmdc && !bmdc,
        bio: $('dtBio').value.trim() || null,
        experience_years: exp,
        default_fee: fee,
        upazila: $('dtDocUpazila').value || null,
      },
    };
  }

