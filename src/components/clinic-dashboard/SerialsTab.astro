<!-- path: src/components/clinic-dashboard/SerialsTab.astro -->
---
// ============================================================
// কম্পোনেন্ট: SerialsTab (clinic-dashboard) — সিরিয়াল রিকোয়েস্ট
//
// প্যারেন্ট (my-clinic.astro) 'smartfeni:clinic-ready' ইভেন্টে ক্লিনিক ও
// ভূমিকা (isReceiver / isAdmin) পাঠায়। এই ট্যাব শুধু যে প্রতিনিধি
// "সিরিয়াল পাবেন" চিহ্নিত (বা অ্যাডমিন) তার জন্য।
//
// ধাপ: অপেক্ষায় → [প্রসেসিং শুরু] → প্রসেসিং চলছে → [কনফার্ম + সিরিয়াল নম্বর]
//      → কনফার্মড (ক্লোজ)। বিকল্প: ফোন ধরেনি / বাতিল (রোগীকে নোটিফিকেশন যায়)
//
// ডাটা: serial_requests (RLS: শুধু গ্রহণকারী প্রতিনিধি/রোগী/অ্যাডমিন পড়তে পারে)
// অ্যাকশন: RPC — serial_start_processing / serial_confirm / serial_close
// প্রতি ৩০ সেকেন্ডে অটো-রিফ্রেশ (ট্যাব দৃশ্যমান থাকলে)
//
// গোপনীয়তা: ফোন বাটন <a href="tel:"> নয়, JS দিয়ে ডায়াল — যাতে গ্লোবাল
// কল-ক্লিক অ্যানালিটিক্সে রোগীর কল গোনা না হয়।
// ============================================================
---

<div class="sc-wrap">

  <div class="sc-hours">
    <i class="fas fa-clock"></i>
    রিমাইন্ডার ও অ্যাডমিন সতর্কতা সকাল ৯টা থেকে রাত ৯টা পর্যন্ত। প্রসেসিং শুরু করলে রোগী নোটিফিকেশন পান, তাই কল করার আগেই চাপুন।
  </div>

  <div class="sc-empty" id="scNotReceiver" style="display:none;">
    <i class="fas fa-bell-slash"></i>
    <p id="scNotReceiverText">এই ক্লিনিকের সিরিয়াল রিকোয়েস্ট অন্য একজন প্রতিনিধি দেখছেন।</p>
  </div>

  <div id="scMain" style="display:none;">
    <div class="sc-subtabs" id="scSubtabs">
      <button type="button" class="sc-subtab active" data-sub="open">চলমান <span id="scOpenCount"></span></button>
      <button type="button" class="sc-subtab" data-sub="done">সম্পন্ন</button>
    </div>

    <div id="scList" class="sc-list"></div>

    <div class="sc-empty" id="scEmpty" style="display:none;">
      <i class="fas fa-inbox"></i>
      <p id="scEmptyText">কোনো অনুরোধ নেই</p>
    </div>

    <div id="scLoading" class="sc-empty"><div class="sc-spinner"></div><p>লোড হচ্ছে...</p></div>
  </div>

</div>

<style is:global>
  .sc-wrap { display: flex; flex-direction: column; gap: 14px; }
  .sc-hours { display: flex; gap: 8px; align-items: flex-start; background: #EAF2FF; color: #1D4FA8; border-radius: 14px; padding: 11px 14px; font-size: 0.78rem; line-height: 1.55; font-weight: 600; }
  .sc-hours i { margin-top: 3px; }

  .sc-subtabs { display: flex; gap: 8px; margin-bottom: 4px; }
  .sc-subtab { flex: 1; border: 1.5px solid #E5EAF0; background: #fff; color: #5A6E85; border-radius: 14px; padding: 11px; font-weight: 700; font-size: 0.88rem; cursor: pointer; font-family: inherit; }
  .sc-subtab.active { background: #FF6B35; border-color: #FF6B35; color: #fff; }

  .sc-list { display: flex; flex-direction: column; gap: 12px; }
  .sc-card { background: #fff; border-radius: 18px; padding: 16px; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06); border: 1.5px solid transparent; }
  .sc-card.late { border-color: #F4A39B; }
  .sc-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; flex-wrap: wrap; }
  .sc-doctor { font-size: 0.98rem; font-weight: 700; color: #1B2A4A; line-height: 1.4; }
  .sc-day { font-size: 0.82rem; color: #FF6B35; font-weight: 700; margin-top: 2px; }
  .sc-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
  .sc-chip.pending { background: #FFF4D6; color: #9A6412; }
  .sc-chip.processing { background: #EAF2FF; color: #1D4FA8; }
  .sc-chip.confirmed { background: #EAFBF0; color: #1B7A3C; }
  .sc-chip.off { background: #F1F4F9; color: #5A6E85; }
  .sc-ago { font-size: 0.74rem; color: #8FA0BC; margin-top: 4px; }
  .sc-late-note { margin-top: 8px; background: #FEF1F0; color: #B42318; border-radius: 10px; padding: 7px 10px; font-size: 0.78rem; font-weight: 700; }

  .sc-patient { margin-top: 12px; background: #F8FAFC; border-radius: 14px; padding: 12px 14px; }
  .sc-pname { font-size: 0.92rem; font-weight: 700; color: #1B2A4A; }
  .sc-problem { font-size: 0.86rem; color: #44506B; margin-top: 6px; line-height: 1.6; white-space: pre-line; }
  .sc-call { margin-top: 10px; display: inline-flex; align-items: center; gap: 8px; background: #EAFBF0; color: #1B7A3C; border: none; padding: 10px 16px; border-radius: 12px; font-weight: 700; font-size: 0.88rem; cursor: pointer; font-family: inherit; }
  .sc-urgent { margin-top: 10px; background: #FEF1F0; border: 1.5px solid #F4A39B; color: #7A1F17; border-radius: 12px; padding: 9px 12px; font-size: 0.8rem; font-weight: 700; line-height: 1.55; }

  .sc-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .sc-btn { border: none; padding: 12px 16px; border-radius: 14px; font-weight: 700; font-size: 0.88rem; cursor: pointer; font-family: inherit; }
  .sc-btn.primary { background: #FF6B35; color: #fff; flex: 1; min-width: 160px; }
  .sc-btn.green { background: #1FA45A; color: #fff; flex: 1; min-width: 140px; }
  .sc-btn.soft { background: #F1F4F9; color: #5A6E85; }
  .sc-btn.red { background: #FFF0EA; color: #D14343; }
  .sc-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .sc-confirm-box { margin-top: 14px; border-top: 1px dashed #E5EAF0; padding-top: 12px; }
  .sc-confirm-box label { display: block; font-size: 0.78rem; font-weight: 700; color: #1B2A4A; margin: 8px 0 4px; }
  .sc-confirm-box input { width: 100%; padding: 11px 13px; border-radius: 12px; border: 1.5px solid #E5EAF0; background: #FBFCFE; font-size: 0.92rem; font-family: inherit; color: #1B2A4A; }
  .sc-confirm-box input:focus { outline: none; border-color: #FF6B35; background: #fff; }
  .sc-result { margin-top: 10px; font-size: 0.84rem; color: #1B7A3C; font-weight: 700; }
  .sc-repnote { margin-top: 6px; font-size: 0.8rem; color: #8FA0BC; }

  .sc-empty { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 46px 10px; color: #B0BCCB; text-align: center; }
  .sc-empty i { font-size: 2.2rem; }
  .sc-empty p { font-size: 0.9rem; color: #8FA0BC; line-height: 1.6; }
  .sc-spinner { width: 30px; height: 30px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: scSpin 0.8s linear infinite; }
  @keyframes scSpin { to { transform: rotate(360deg); } }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const WEEKDAYS = ['রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার', 'শনিবার'];
  const MONTHS = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];
  const BN = '০১২৩৪৫৬৭৮৯';
  const toBn = (n) => String(n).replace(/\d/g, (d) => BN[d]);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const $ = (id) => document.getElementById(id);

  // রোগী জরুরি লক্ষণ লিখে থাকলে প্রতিনিধিকে সতর্ক করা (AI চ্যাটের তালিকার ছোট সংস্করণ)
  const URGENT = [
    /বুক(ে|ের)?\s*(খুব\s*|প্রচণ্ড\s*)?(ব্যথা|ব্যাথা|চাপ|যন্ত্রণা)/, /হার্ট\s*(অ্যাটাক|এটাক)/,
    /শ্বাস(\s*নিতে)?\s*(কষ্ট|পারছ|বন্ধ)|শ্বাসকষ্ট|দম\s*(বন্ধ|আটকে)/, /অজ্ঞান|বেহুঁশ|জ্ঞান\s*(নেই|হারা)/,
    /(প্রচণ্ড|প্রচুর|অনেক)\s*রক্ত|রক্তক্ষরণ|রক্ত\s*বমি/, /বিষ\s*(খেয়ে|পান)|বিষক্রিয়া/, /সাপ(ে|ের)?\s*(কামড়|কেটে)/,
    /খিঁ?চুনি|তড়কা/, /স্ট্রোক|মুখ\s*(বেঁকে|বাঁকা)|কথা\s*জড়িয়ে/, /প্রসব\s*(ব্যথা|বেদনা)|পানি\s*ভে?ঙে/,
    /chest\s*pain|can'?t\s*breathe|unconscious|seizure|stroke|poison|snake\s*bite/i,
  ];
  const isUrgentText = (t) => {
    const s = String(t || '').normalize('NFC').toLowerCase();
    return URGENT.some((re) => re.test(s));
  };

  let ctx = null;          // { clinic, isReceiver, isAdmin, userId }
  let rows = [];
  let sub = 'open';
  let timer = null;
  let loadSeq = 0;
  let busyIds = new Set();

  function dayLabel(dateStr) {
    const [y, m, d] = String(dateStr).split('-').map(Number);
    const wd = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
    return `${WEEKDAYS[wd]}, ${toBn(d)} ${MONTHS[m - 1]}`;
  }

  function ago(iso) {
    const mins = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
    if (mins < 1) return 'এইমাত্র';
    if (mins < 60) return `${toBn(mins)} মিনিট আগে`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${toBn(hrs)} ঘণ্টা আগে`;
    return `${toBn(Math.floor(hrs / 24))} দিন আগে`;
  }

  const hoursSince = (iso) => (Date.now() - new Date(iso).getTime()) / 3600000;

  function statusChip(r) {
    switch (r.status) {
      case 'pending': return '<span class="sc-chip pending">অপেক্ষায়</span>';
      case 'processing': return '<span class="sc-chip processing"><i class="fas fa-spinner"></i> প্রসেসিং চলছে</span>';
      case 'confirmed': return `<span class="sc-chip confirmed"><i class="fas fa-circle-check"></i> কনফার্মড · সিরিয়াল ${esc(r.serial_no || '')}</span>`;
      case 'unreachable': return '<span class="sc-chip off">ফোন ধরেনি</span>';
      case 'cancelled': return '<span class="sc-chip off">বাতিল</span>';
      case 'expired': return '<span class="sc-chip off">মেয়াদ শেষ</span>';
      default: return '';
    }
  }

  // ---------------- লোড ----------------
  async function load(silent = false) {
    if (!ctx) return;
    const seq = ++loadSeq;
    if (!silent) { $('scLoading').style.display = 'flex'; $('scList').innerHTML = ''; $('scEmpty').style.display = 'none'; }

    const since = new Date(Date.now() - 30 * 86400000).toISOString();
    const { data, error } = await supabase
      .from('serial_requests')
      .select('id, doctor_name, requested_date, status, patient_name, patient_phone, problem, serial_no, rep_note, created_at, processing_at, closed_at, handled_by')
      .eq('clinic_id', ctx.clinic.id)
      .gte('created_at', since)
      .order('created_at', { ascending: false })
      .limit(300);

    if (seq !== loadSeq) return;   // ক্লিনিক বদলে গেছে বা নতুন লোড শুরু
    $('scLoading').style.display = 'none';

    if (error) {
      $('scList').innerHTML = `<p style="color:#D14343;text-align:center;padding:20px 0;">লোড করা যায়নি: ${esc(error.message)}</p>`;
      return;
    }
    rows = data || [];
    updateCounts();
    render();
  }

  function updateCounts() {
    const pending = rows.filter((r) => r.status === 'pending').length;
    const processing = rows.filter((r) => r.status === 'processing').length;
    const open = pending + processing;
    $('scOpenCount').textContent = open ? `(${toBn(open)})` : '';
    window.dispatchEvent(new CustomEvent('smartfeni:serial-count', { detail: { pending, processing } }));
  }

  // ---------------- রেন্ডার ----------------
  function render() {
    // ইনপুটে লেখা থাকলে অটো-রিফ্রেশে মুছে না ফেলা
    const typing = document.activeElement && $('scList').contains(document.activeElement) && document.activeElement.tagName === 'INPUT';
    if (typing) return;

    const list = $('scList');
    list.innerHTML = '';
    const open = rows.filter((r) => r.status === 'pending' || r.status === 'processing');
    const done = rows.filter((r) => r.status !== 'pending' && r.status !== 'processing');
    // অপেক্ষায় থাকা আগে, তারপর প্রসেসিং; পুরনো আগে (দেরি হওয়াগুলো উপরে)
    open.sort((a, b) => (a.status === b.status ? new Date(a.created_at) - new Date(b.created_at) : a.status === 'pending' ? -1 : 1));
    const show = sub === 'open' ? open : done;

    if (show.length === 0) {
      $('scEmptyText').textContent = sub === 'open' ? 'এখন কোনো চলমান সিরিয়াল রিকোয়েস্ট নেই' : 'গত ৩০ দিনে কোনো সম্পন্ন অনুরোধ নেই';
      $('scEmpty').style.display = 'flex';
      return;
    }
    $('scEmpty').style.display = 'none';
    show.forEach((r) => list.appendChild(renderCard(r)));
  }

  function renderCard(r) {
    const card = document.createElement('div');
    const waitingHrs = r.status === 'pending' ? hoursSince(r.created_at) : r.status === 'processing' && r.processing_at ? hoursSince(r.processing_at) : 0;
    const late = waitingHrs >= 12;
    card.className = 'sc-card' + (late ? ' late' : '');

    const hasPersonal = !!(r.patient_name || r.patient_phone);
    const urgent = isUrgentText(r.problem);

    card.innerHTML = `
      <div class="sc-top">
        <div>
          <div class="sc-doctor">${esc(r.doctor_name)}</div>
          <div class="sc-day"><i class="fas fa-calendar-day"></i> ${dayLabel(r.requested_date)}</div>
          <div class="sc-ago">অনুরোধ এসেছে ${ago(r.created_at)}</div>
        </div>
        ${statusChip(r)}
      </div>
      ${late ? `<div class="sc-late-note"><i class="fas fa-triangle-exclamation"></i> ${r.status === 'pending' ? '১২ ঘণ্টার বেশি হয়ে গেছে, এখনো প্রসেসিং শুরু হয়নি' : '১২ ঘণ্টার বেশি প্রসেসিং চলছে, কনফার্ম হয়নি'}</div>` : ''}
      ${hasPersonal ? `
        <div class="sc-patient">
          <div class="sc-pname"><i class="fas fa-user" style="color:#FF6B35;"></i> ${esc(r.patient_name)}</div>
          ${r.problem ? `<div class="sc-problem">${esc(r.problem)}</div>` : ''}
          ${urgent ? '<div class="sc-urgent">⚠️ রোগী জরুরি লক্ষণের কথা লিখেছেন। আগে কল করে অবস্থা জানুন; জরুরি মনে হলে ৯৯৯-এ কল করতে বা এখনই হাসপাতালে যেতে বলুন।</div>' : ''}
          ${r.status === 'pending' || r.status === 'processing' ? `<button type="button" class="sc-call" data-act="call"><i class="fas fa-phone"></i> ${esc(r.patient_phone)}</button>` : `<div class="sc-ago" style="margin-top:8px;">${esc(r.patient_phone)}</div>`}
        </div>` : '<p class="sc-repnote">৩০ দিন পার হওয়ায় রোগীর তথ্য মুছে গেছে</p>'}
      ${r.rep_note ? `<div class="sc-repnote">নোট: ${esc(r.rep_note)}</div>` : ''}
      <div class="sc-body"></div>`;

    const body = card.querySelector('.sc-body');

    if (r.status === 'pending') {
      body.innerHTML = `
        <div class="sc-actions">
          <button type="button" class="sc-btn primary" data-act="start"><i class="fas fa-play"></i> প্রসেসিং শুরু করুন</button>
          <button type="button" class="sc-btn red" data-act="cancel">বাতিল</button>
        </div>`;
    } else if (r.status === 'processing') {
      body.innerHTML = `
        <div class="sc-confirm-box">
          <label>সিরিয়াল নম্বর (সিরিয়াল নেওয়ার পর)</label>
          <input type="text" class="sc-serial-no" maxlength="20" placeholder="যেমন: ১২" inputmode="text" />
          <label>রোগীর জন্য নোট (ঐচ্ছিক)</label>
          <input type="text" class="sc-note-input" maxlength="200" placeholder="যেমন: সকাল ১০টার মধ্যে আসুন" />
          <div class="sc-actions">
            <button type="button" class="sc-btn green" data-act="confirm"><i class="fas fa-check"></i> কনফার্ম করুন</button>
          </div>
          <div class="sc-actions" style="margin-top:8px;">
            <button type="button" class="sc-btn soft" data-act="unreachable">ফোন ধরেনি</button>
            <button type="button" class="sc-btn red" data-act="cancel">বাতিল</button>
          </div>
        </div>`;
    }

    card.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act]');
      if (btn) handleAction(btn.dataset.act, r, card, btn);
    });
    return card;
  }

  // ---------------- অ্যাকশন ----------------
  const ERRORS = {
    not_allowed: 'আপনার এই অনুরোধ বদলানোর অনুমতি নেই',
    invalid_status: 'অনুরোধের অবস্থা এর মধ্যে বদলে গেছে — তালিকা রিফ্রেশ হচ্ছে',
    not_handler: 'এই অনুরোধ অন্য কেউ প্রসেস করছে',
    serial_no_required: 'সিরিয়াল নম্বর লিখুন',
    not_found: 'অনুরোধটি পাওয়া যায়নি',
  };

  async function handleAction(act, r, card, btn) {
    if (act === 'call') {
      window.location.href = 'tel:' + String(r.patient_phone).replace(/[^\d+]/g, '');
      return;
    }
    if (busyIds.has(r.id)) return;

    let call = null;
    if (act === 'start') {
      call = supabase.rpc('serial_start_processing', { p_id: r.id });
    } else if (act === 'confirm') {
      const no = card.querySelector('.sc-serial-no').value.trim();
      const note = card.querySelector('.sc-note-input').value.trim();
      if (!no) { window.showToast('সিরিয়াল নম্বর লিখুন', 'error'); card.querySelector('.sc-serial-no').focus(); return; }
      call = supabase.rpc('serial_confirm', { p_id: r.id, p_serial_no: no, p_note: note || null });
    } else if (act === 'unreachable') {
      if (!confirm('রোগী ফোন ধরেননি — অনুরোধটি বন্ধ করবেন? রোগী নোটিফিকেশন পাবেন।')) return;
      call = supabase.rpc('serial_close', { p_id: r.id, p_status: 'unreachable', p_note: null });
    } else if (act === 'cancel') {
      const reason = window.prompt('রোগীকে কী কারণ জানাতে চান? (ঐচ্ছিক, যেমন: ওই দিনের সিরিয়াল শেষ)\n\nবাতিল করলে রোগী নোটিফিকেশন পাবেন।', '');
      if (reason === null) return;
      call = supabase.rpc('serial_close', { p_id: r.id, p_status: 'cancelled', p_note: reason.trim() || null });
    }
    if (!call) return;

    busyIds.add(r.id);
    btn.disabled = true;
    const { error } = await call;
    busyIds.delete(r.id);

    if (error) {
      const key = Object.keys(ERRORS).find((k) => (error.message || '').includes(k));
      window.showToast(key ? ERRORS[key] : 'ব্যর্থ: ' + error.message, 'error');
      btn.disabled = false;
      load(true);
      return;
    }

    const msgs = {
      start: 'প্রসেসিং শুরু হয়েছে — রোগী জানতে পেরেছেন ✓',
      confirm: 'সিরিয়াল কনফার্ম হয়েছে, অনুরোধ বন্ধ ✓',
      unreachable: 'অনুরোধ বন্ধ করা হয়েছে',
      cancel: 'অনুরোধ বাতিল করা হয়েছে',
    };
    window.showToast(msgs[act], 'success');
    load(true);
  }

  // ---------------- লাইফসাইকেল ----------------
  function startPolling() {
    clearInterval(timer);
    timer = setInterval(() => {
      if (document.visibilityState === 'visible' && ctx && $('scMain').offsetParent !== null) load(true);
    }, 30000);
  }

  function setup(detail) {
    ctx = detail;
    loadSeq++;
    rows = [];
    sub = 'open';
    document.querySelectorAll('.sc-subtab').forEach((b) => b.classList.toggle('active', b.dataset.sub === 'open'));
    $('scList').innerHTML = '';
    $('scOpenCount').textContent = '';

    const allowed = detail.isReceiver || detail.isAdmin;
    $('scNotReceiver').style.display = allowed ? 'none' : 'flex';
    $('scMain').style.display = allowed ? 'block' : 'none';
    if (!allowed) {
      clearInterval(timer);
      return;
    }
    load();
    startPolling();
  }

  window.addEventListener('smartfeni:clinic-ready', (e) => setup(e.detail));

  $('scSubtabs').addEventListener('click', (e) => {
    const b = e.target.closest('.sc-subtab');
    if (!b) return;
    sub = b.dataset.sub;
    document.querySelectorAll('.sc-subtab').forEach((x) => x.classList.toggle('active', x === b));
    render();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && ctx && (ctx.isReceiver || ctx.isAdmin)) load(true);
  });
</script>