---
// src/components/ChatWidget.astro
// Smart Feni AI চ্যাট উইজেট ("Smart Assistant")
// আপডেট: রেফারেন্স ডিজাইন থেকে ইন্সপায়ার্ড — সবুজ থিম (শুধু চ্যাটবটে, বাকি সাইট
//         কমলা/নেভি ব্র্যান্ড কালারেই থাকছে), অনলাইন ইন্ডিকেটর, single-row
//         horizontal-scroll quick reply suggestions, নতুন গ্রিটিং টেক্সট, লোগো অ্যাভাটার।
// নোট: Astro scoped CSS dynamically তৈরি এলিমেন্টে কাজ করে না — তাই সব dynamic
//       এলিমেন্ট (message bubble, link card, feedback icon, quick-reply বাটন,
//       typing indicator) এখনো inline style দিয়ে কন্ট্রোল করা হয় (established pattern)।
// আপডেট (এআই চ্যাট ধাপ ১): লিংক কার্ডের label এখন textContent দিয়ে বসে (মডেল-আউটপুট
// innerHTML-এ যেত — HTML ঢোকানোর ঝুঁকি ছিল); ইনপুটে maxlength=500 (সার্ভারের সীমার সাথে মেলানো)।
// আপডেট (নতুন — bottom nav bar যোগ হওয়ার পর): চ্যাট বাবল/প্যানেলের
// bottom পজিশনিং বাড়ানো হলো, নাহলে এখন BottomNav.astro (fixed,
// ~৭০px উঁচু) এর সাথে ওভারল্যাপ করছিল। env(safe-area-inset-bottom)
// যোগ করা হলো iPhone হোম-ইন্ডিকেটর এরিয়ার জন্যও ঠিক থাকতে।
---

<div id="sf-chat-root">
  <button id="sf-chat-toggle" aria-label="সাহায্য চ্যাট খুলুন">
    <svg id="sf-icon-chat" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <svg id="sf-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <div id="sf-chat-panel">
    <header id="sf-chat-header">
      <div id="sf-chat-header-left">
        <span id="sf-chat-avatar-wrap">
          <span id="sf-chat-avatar"><img src="/logo.png" alt="Smart Feni" /></span>
          <span id="sf-chat-avatar-dot"></span>
        </span>
        <div id="sf-chat-header-text">
          <span id="sf-chat-title">Smart Assistant</span>
          <span id="sf-chat-subtitle">ফেনীর সব সেবা, এক জায়গায়</span>
        </div>
      </div>
      <div id="sf-chat-header-actions">
        <button id="sf-chat-reset" type="button" aria-label="নতুন চ্যাট শুরু করুন" title="নতুন চ্যাট">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
          </svg>
        </button>
        <button id="sf-chat-panel-close" type="button" aria-label="বন্ধ করুন">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </header>

    <div id="sf-chat-messages"></div>

    <div id="sf-chat-quick-wrap">
      <div id="sf-chat-quick"></div>
    </div>

    <form id="sf-chat-form">
      <input
        id="sf-chat-input"
        type="text"
        placeholder="প্রশ্ন লিখুন..."
        autocomplete="off"
        maxlength="500"
      />
      <button type="submit" aria-label="পাঠান">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  #sf-chat-root {
    position: fixed;
    bottom: calc(88px + env(safe-area-inset-bottom));
    right: 20px;
    z-index: 9999;
    font-family: 'Inter', system-ui, -apple-system, "Noto Sans Bengali", sans-serif;
  }

  #sf-chat-toggle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #1F9254;
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(31, 146, 84, 0.32);
  }
  #sf-chat-toggle:active { transform: scale(0.95); }

  #sf-chat-panel {
    position: fixed;
    bottom: calc(152px + env(safe-area-inset-bottom));
    right: 20px;
    width: min(360px, calc(100vw - 32px));
    height: min(540px, calc(100vh - 130px));
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    border: 1px solid #eee;
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  #sf-chat-panel.sf-open { display: flex; }

  #sf-chat-header {
    background: #1F9254;
    color: #fff;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  #sf-chat-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  #sf-chat-avatar-wrap {
    position: relative;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }
  #sf-chat-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 5px;
  }
  #sf-chat-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #sf-chat-avatar-dot {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #4ADE80;
    border: 2px solid #1F9254;
  }
  #sf-chat-header-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }
  #sf-chat-title {
    font-weight: 700;
    font-size: 14.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #sf-chat-subtitle {
    font-size: 11px;
    opacity: 0.85;
  }
  #sf-chat-header-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }
  #sf-chat-reset,
  #sf-chat-panel-close {
    background: transparent;
    border: none;
    color: #fff;
    opacity: 0.85;
    cursor: pointer;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    flex-shrink: 0;
  }
  #sf-chat-reset:hover,
  #sf-chat-panel-close:hover { opacity: 1; background: rgba(255,255,255,0.14); }

  #sf-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #F6FAF7;
  }

  #sf-chat-quick-wrap {
    border-top: 1px solid #eee;
    background: #fff;
    padding: 10px 0;
  }
  #sf-chat-quick {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 0 12px;
    scrollbar-width: none;
  }
  #sf-chat-quick::-webkit-scrollbar { display: none; }

  #sf-chat-form {
    display: flex;
    gap: 8px;
    padding: 10px;
    border-top: 1px solid #eee;
    background: #fff;
  }
  #sf-chat-input {
    flex: 1;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 14px;
    outline: none;
  }
  #sf-chat-input:focus { border-color: #1F9254; }
  #sf-chat-input:disabled { background: #f5f5f5; }
  #sf-chat-form button[type="submit"] {
    width: 38px;
    flex-shrink: 0;
    background: #1F9254;
    color: #fff;
    border: none;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  #sf-chat-form button[type="submit"]:disabled { opacity: 0.5; cursor: not-allowed; }

  @media (max-width: 400px) {
    #sf-chat-panel { right: 16px; bottom: calc(148px + env(safe-area-inset-bottom)); }
    #sf-chat-root { right: 16px; bottom: calc(84px + env(safe-area-inset-bottom)); }
  }
</style>

<script>
  // চ্যাটের মূল কোড (src/lib/chatWidget.ts) lazy: প্রথম ট্যাপে লোড হয়।
  // আঙুল ছোঁয়া মাত্র (pointerdown) ডাউনলোড শুরু, আর ফোন ফাঁকা হলে আগেভাগে প্রিলোড।
  const toggle = document.getElementById("sf-chat-toggle");
  let loading: Promise<{ open: () => void }> | null = null;
  let ready = false; // মূল কোড চালু হলে ট্যাপ সে নিজেই সামলায়
  const load = () => (loading ||= import("../lib/chatWidget").then((m) => {
    const api = m.initChatWidget();
    ready = true;
    return api;
  }));

  if (toggle) {
    toggle.addEventListener("pointerdown", () => { load(); }, { once: true, passive: true });
    toggle.addEventListener("click", async () => {
      if (ready) return;
      try {
        const api = await load();
        api.open();
      } catch (err) {
        loading = null;
        (window as any).showToast?.("চ্যাট লোড করা যায়নি, আবার চেষ্টা করুন");
      }
    });

    const idle = (window as any).requestIdleCallback || ((fn: () => void) => setTimeout(fn, 1));
    window.addEventListener("load", () => setTimeout(() => idle(() => { load().catch(() => { loading = null; }); }), 6000), { once: true });
  }
</script>

<style is:global>
  @keyframes sfBlink {
    0%, 80%, 100% { opacity: 0.3; }
    40% { opacity: 1; }
  }
</style>