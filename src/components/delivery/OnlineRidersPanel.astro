---
// ============================================================
// কম্পোনেন্ট: অনলাইন রাইডার right-side slide প্যানেল
// courier.astro এর পেজে আগে থেকেই থাকা #listingsData (rider listings)
// থেকেই ডেটা নেয় — আলাদা fetch লাগে না।
// ক্লিক করলে এক্সিস্টিং .rider-card এ synthetic click ট্রিগার করে,
// যেটা আগে থেকে initListingDetailModal দিয়ে বাইন্ড করা আছে —
// ফলে এক্সিস্টিং ListingDetailModal-ই খুলে যায়, নতুন কিছু বানাতে হয়নি।
// ============================================================
---

<div class="online-panel-overlay" id="onlineRidersOverlay">
  <aside class="online-panel">
    <div class="online-panel-header">
      <h3><i class="fas fa-circle online-dot"></i> অনলাইন রাইডার</h3>
      <button class="online-panel-close" id="closeOnlineRidersBtn" type="button" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="online-panel-list" id="onlineRidersList"></div>

    <div class="online-panel-empty" id="onlineRidersEmpty" style="display:none;">
      <i class="fas fa-motorcycle"></i>
      <p>এই মুহূর্তে কোনো রাইডার অনলাইনে নেই</p>
    </div>
  </aside>
</div>

<style>
  .online-panel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    z-index: 1000;
    justify-content: flex-end;
  }

  .online-panel-overlay.active {
    display: flex;
  }

  .online-panel {
    background: #fff;
    width: 100%;
    max-width: 340px;
    height: 100%;
    padding: 20px 16px;
    overflow-y: auto;
    animation: slideInRight 0.25s ease;
  }

  @keyframes slideInRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .online-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #EEF3F9;
  }

  .online-panel-header h3 {
    font-size: 0.98rem;
    font-weight: 800;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .online-dot {
    color: #22C55E;
    font-size: 0.55rem;
  }

  .online-panel-close {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #F8FAFC;
    border: none;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .online-panel-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .online-rider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background: #F8FAFC;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .online-rider-row:hover {
    background: #FFF0EA;
  }

  .online-rider-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .online-rider-avatar-fallback {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .online-rider-info {
    flex: 1;
    min-width: 0;
  }

  .online-rider-name {
    font-size: 0.84rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .online-rider-loc {
    font-size: 0.72rem;
    color: #9AA8BC;
  }

  .online-panel-empty {
    text-align: center;
    padding: 40px 10px;
    color: #B0BCCB;
  }

  .online-panel-empty i {
    font-size: 1.6rem;
    margin-bottom: 10px;
    display: block;
  }

  .online-panel-empty p {
    font-size: 0.85rem;
  }
</style>

<script>
  const overlay = document.getElementById('onlineRidersOverlay');
  const listEl = document.getElementById('onlineRidersList');
  const emptyEl = document.getElementById('onlineRidersEmpty');

  function renderRiders() {
    const dataEl = document.getElementById('listingsData');
    const riders = dataEl ? JSON.parse(dataEl.textContent) : [];

    listEl.innerHTML = '';

    if (riders.length === 0) {
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    riders.forEach((rider) => {
      const row = document.createElement('div');
      row.className = 'online-rider-row';

      const avatarHtml = rider.images && rider.images.length > 0
        ? `<img src="${rider.images[0]}" alt="${rider.title || ''}" class="online-rider-avatar" />`
        : `<span class="online-rider-avatar-fallback"><i class="fas fa-motorcycle"></i></span>`;

      row.innerHTML = `
        ${avatarHtml}
        <div class="online-rider-info">
          <p class="online-rider-name">${rider.title || 'রাইডার'}</p>
          <p class="online-rider-loc"><i class="fas fa-location-dot"></i> ${rider.upazila || ''}</p>
        </div>
      `;

      row.addEventListener('click', () => {
        // এক্সিস্টিং rider-card এ synthetic click — ListingDetailModal
        // ইতিমধ্যে সেই কার্ডে বাইন্ড করা আছে (initListingDetailModal দিয়ে)
        const matchingCard = document.querySelector(`.rider-card[data-target-id="${rider.id}"]`);
        if (matchingCard) {
          overlay.classList.remove('active');
          matchingCard.click();
        }
      });

      listEl.appendChild(row);
    });
  }

  window.openOnlineRidersPanel = () => {
    renderRiders();
    overlay.classList.add('active');
  };

  document.getElementById('closeOnlineRidersBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('active');
  });
</script>