---
// ============================================================
// কম্পোনেন্ট: অনলাইন রাইডার right-side slide প্যানেল
// courier.astro/ride.astro পেজে আগে থেকেই থাকা #listingsData
// (rider listings) থেকেই ডেটা নেয় — আলাদা fetch লাগে না।
//
// প্রতিটা রো: avatar + নাম + রেটিং (এক লাইনে) + কল বাটন (ডানে) —
// সরল, কোনো ডিটেইল মডাল খোলে না (আগে .rider-card এ synthetic
// click পাঠানোর একটা ভুল/অকার্যকর লজিক ছিল, সরানো হয়েছে)।
//
// গুরুত্বপূর্ণ: এই কম্পোনেন্টের সব রো JS দিয়ে innerHTML হিসেবে
// dynamically তৈরি হয় — তাই CSS অবশ্যই <style is:global> এ
// থাকতে হবে, নাহলে Astro-র scoped CSS dynamically-injected
// কনটেন্টে প্রয়োগ হয় না (এই বাগেই আগে avatar/লেআউট ভেঙে
// বিশাল-আকারে unstyled দেখাচ্ছিল)।
// ============================================================
---

<div class="online-panel-overlay" id="onlineRidersOverlay">
  <aside class="online-panel">
    <div class="online-panel-header">
      <h3><i class="fas fa-circle online-dot"></i> অনলাইন রাইডার</h3>
      <button class="online-panel-close" id="closeOnlineRidersBtn" type="button" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="online-panel-list" id="onlineRidersList"></div>

    <div class="online-panel-empty" id="onlineRidersEmpty" style="display:none;">
      <i class="fas fa-motorcycle"></i>
      <p>এই মুহূর্তে কোনো রাইডার অনলাইনে নেই</p>
    </div>
  </aside>
</div>

<style is:global>
  .online-panel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    z-index: 1000;
    justify-content: flex-end;
  }

  .online-panel-overlay.active {
    display: flex;
  }

  .online-panel {
    background: #fff;
    width: 100%;
    max-width: 340px;
    height: 100%;
    padding: 20px 16px;
    overflow-y: auto;
    animation: slideInRight 0.25s ease;
  }

  @keyframes slideInRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .online-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #EEF3F9;
  }

  .online-panel-header h3 {
    font-size: 0.98rem;
    font-weight: 800;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .online-dot {
    color: #22C55E;
    font-size: 0.55rem;
  }

  .online-panel-close {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #F8FAFC;
    border: none;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .online-panel-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .online-rider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background: #F8FAFC;
  }

  .online-rider-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .online-rider-avatar-fallback {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .online-rider-info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .online-rider-name {
    font-size: 0.84rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .online-rider-rating {
    font-size: 0.78rem;
    color: #B8703F;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .online-rider-rating i {
    color: #FFB020;
    font-size: 0.7rem;
  }

  .online-rider-call-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #E8F6EC;
    color: #1B7A3C;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .online-panel-empty {
    text-align: center;
    padding: 40px 10px;
    color: #B0BCCB;
  }

  .online-panel-empty i {
    font-size: 1.6rem;
    margin-bottom: 10px;
    display: block;
  }

  .online-panel-empty p {
    font-size: 0.85rem;
  }
</style>

<script>
  const overlay = document.getElementById('onlineRidersOverlay');
  const listEl = document.getElementById('onlineRidersList');
  const emptyEl = document.getElementById('onlineRidersEmpty');

  function renderRiders() {
    const dataEl = document.getElementById('listingsData');
    const riders = dataEl ? JSON.parse(dataEl.textContent) : [];

    listEl.innerHTML = '';

    if (riders.length === 0) {
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    riders.forEach((rider) => {
      const row = document.createElement('div');
      row.className = 'online-rider-row';

      const avatarHtml = rider.images && rider.images.length > 0
        ? `<img src="${rider.images[0]}" alt="${rider.title || ''}" class="online-rider-avatar" />`
        : `<span class="online-rider-avatar-fallback"><i class="fas fa-motorcycle"></i></span>`;

      const ratingHtml = rider.rating
        ? `<span class="online-rider-rating"><i class="fas fa-star"></i> ${Number(rider.rating).toFixed(1)}</span>`
        : '';

      row.innerHTML = `
        ${avatarHtml}
        <div class="online-rider-info">
          <p class="online-rider-name">${rider.title || 'রাইডার'}</p>
          ${ratingHtml}
        </div>
        ${rider.phone ? `<a href="tel:${rider.phone}" class="online-rider-call-btn" data-call-btn><i class="fas fa-phone"></i></a>` : ''}
      `;

      listEl.appendChild(row);
    });
  }

  window.openOnlineRidersPanel = () => {
    renderRiders();
    overlay.classList.add('active');
  };

  document.getElementById('closeOnlineRidersBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('active');
  });
</script>