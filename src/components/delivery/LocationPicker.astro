---
// ============================================================
// কম্পোনেন্ট: LocationPicker (রিইউজেবল, Smart Hero / Ride Hero)
// লেআউট: ঠিকানা টেক্সট বক্স + পাশে "ম্যাপে সিলেক্ট করুন" বাটন।
// বাটনে ক্লিক করলে ফুলস্ক্রিন ম্যাপ ওভারলে খোলে (Leaflet+OSM+Nominatim,
// সার্চ + ড্র্যাগেবল পিন + বর্তমান লোকেশন)। "সেভ করুন" চাপলে
// ঠিকানা+lat/lng টেক্সট বক্সে বসে যায় এবং ওভারলে বন্ধ হয়ে
// আগের ফর্ম পেজে ফিরে আসে।
// + সবসময় আলাদা "অতিরিক্ত নির্দেশনা" ফিল্ড
//
// একই পেজে pickup ও drop দুইটার জন্য দুইবার বসানো যাবে —
// প্রতিটা instance-এর id আলাদা হতে হবে।
//
// ব্যবহার:
//   <LocationPicker id="pickup" label="পিকআপ লোকেশন" allowAutoLocate={true} />
//   <LocationPicker id="drop" label="ড্রপ-অফ লোকেশন" allowAutoLocate={false} />
//
// পেরেন্ট ফর্ম থেকে ভ্যালু পড়া (সাবমিটের সময়, আগের মতোই অপরিবর্তিত):
//   document.querySelector('[data-lp-id="pickup"] .lp-out-address').value
//   ... .lp-out-lat / .lp-out-lng / .lp-out-instructions
//
// z-index নোট: .lp-map-এ isolation:isolate ব্যবহার করা হয়েছে যাতে
// Leaflet-এর ভেতরের প্যানগুলোর (tile/marker/popup pane, z-index 200-700)
// z-index কখনোই বাইরের সার্চ-রেজাল্ট ড্রপডাউনের (.lp-search-results,
// z-index 51) উপরে চলে আসতে না পারে। isolate একটা নতুন, সম্পূর্ণ
// আলাদা stacking context বানিয়ে দেয় — ভেতরে Leaflet যত বড় z-index
// ব্যবহার করুক না কেন, সেটা .lp-map এর বাইরে কখনো "escape" করবে না।
//
// ============================================================
// (আগের) enableSuggestions prop — true হলে এই instance-এ:
// ১. টাইপ করার সময় /api/location-suggestions-search থেকে নাম-ভিত্তিক
//    সাজেশন ড্রপডাউন দেখায় (থাম্বনেইল + নাম + উপজেলা), ক্লিক করলে
//    টেক্সটে নাম বসে আর lat/lng ব্যাকএন্ডে এমবেডেড থাকে।
// ২. ম্যাপ থেকে পিন করে "সেভ করুন" চাপার সময় একটা ঐচ্ছিক "নাম" ফিল্ড
//    দেখায় — নাম দিলে সেটা /api/save-location-suggestion-এ সেভ হয়ে
//    ভবিষ্যতের জন্য সাজেশন-ডাটাবেসে যোগ হয় (খালি রাখলে কিছুই সেভ হয় না)।
// ডিফল্ট false — drop/Ride Hero-তে কোনো পরিবর্তন হয় না।
//
// ============================================================
// নতুন আপডেট — ফেনীর বাউন্ডারি ওভারলে + সেভড ঠিকানা
// ============================================================
// ১. ম্যাপ: বর্তমান OSM টাইল হুবহু থাকে (স্কুল/বাজার/দোকানের নাম সব ঠিক)।
//    ওপরে শুধু ওভারলে — ফেনী জেলার পুরো সীমানা বোল্ড (সাদা হ্যালো + কমলা),
//    উপজেলা/ইউনিয়নের পাতলা বাউন্ডারি আর নাম (জুম কম হলে উপজেলার নাম,
//    জুম বেশি হলে ইউনিয়নের নাম)। ওভারলে ট্যাপ আটকায় না। ম্যাপ ফেনীর
//    সীমানার বাইরে প্যান করা যায় না।
// ২. পিন বসালে নিচে দেখায়: "ফুলগাজী উপজেলা · মুন্সিরহাট ইউনিয়ন"।
// ৩. ফেনীর বাইরে পিন/GPS হলে লাল সতর্কবার্তা, পিন বসে না, সেভ হয় না।
//    (geojson লোড না হলে চেক বন্ধ থাকে — অর্ডার কখনো আটকায় না।)
// ৪. ⭐ "আমার ঠিকানা হিসেবে রাখুন" (শুধু লগইন করা ইউজার): নাম দিয়ে
//    (বাসা/অফিস/অন্য) সেভ — Supabase saved_locations (src/lib/savedLocations.js)।
// ৫. ঠিকানা বক্সে ট্যাপ করলে সবার আগে নিজের সেভ করা ঠিকানার সাজেশন দেখায়
//    (টাইপ করলে নাম/ঠিকানা মিলিয়ে ফিল্টার)। বাছলে ঠিকানা + lat/lng বসে
//    যায়। প্রতিটার পাশে মুছে ফেলার বাটন (দুইবার ট্যাপ করে কনফার্ম)।
// ৬. পেরেন্ট ফর্মের জন্য নতুন ইভেন্ট (আগের কিছু বদলায়নি):
//      wrap-এ 'lp:location-changed' (bubbles) —
//      detail: { id, source: 'map'|'saved'|'suggestion'|'text', cleared,
//                lat, lng, address, upazila (বাংলা নাম), upazilaId, union }
//    + wrap.dataset.lpUpazila / lpUnion এবং hidden .lp-out-upazila / .lp-out-union
//    পিকআপ পিন থেকে ফর্মের উপজেলা ড্রপডাউন অটো-সিলেক্টের কাজ এই ইভেন্ট দিয়ে হবে।
// ৭. enableSavedLocations prop (ডিফল্ট true) — false দিলে সেভড-ঠিকানা ফিচার বন্ধ।
//
// ডেটা/হেল্পার: src/data/feniAreas.js, src/lib/savedLocations.js,
// geojson: public/data/feni_unions.geojson
// Android ব্যাক বাটন: ওভারলের ক্লাস "lp-overlay"+".active" আর ক্লোজ বাটনের
// aria-label "বন্ধ করুন" আগের মতোই — native-bridge.js-এর closeTopOverlay ধরে।
// ============================================================

interface Props {
  id: string;
  label: string;
  allowAutoLocate?: boolean;
  placeholder?: string;
  required?: boolean;
  enableSuggestions?: boolean;
  enableSavedLocations?: boolean;
}

const {
  id,
  label,
  allowAutoLocate = false,
  placeholder = 'যেমন: নবী হোটেল, ফেনী সদর',
  required = true,
  enableSuggestions = false,
  enableSavedLocations = true,
} = Astro.props;
---

<div
  class="lp-wrap"
  data-lp-id={id}
  data-auto-locate={allowAutoLocate ? '1' : '0'}
  data-enable-suggestions={enableSuggestions ? '1' : '0'}
  data-enable-saved={enableSavedLocations ? '1' : '0'}
>
  <label class="lp-label">{label}{required && <span class="required-mark">*</span>}</label>

  <div class="lp-address-row">
    <input
      type="text"
      id={`lp-${id}-address`}
      class="lp-address-input"
      placeholder={placeholder}
      required={required}
      autocomplete="off"
    />
    <button type="button" class="lp-map-select-btn">
      <i class="fas fa-map-location-dot"></i>
      <span>ম্যাপে সিলেক্ট করুন</span>
    </button>
  </div>

  {enableSavedLocations && <div class="lp-saved-results"></div>}

  {enableSuggestions && <div class="lp-suggest-results"></div>}

  {required && (
    <div class="field-error-msg" data-error-for={`lp-${id}-address`}>
      <i class="fas fa-circle-exclamation"></i><span>ঠিকানা দিন বা ম্যাপ থেকে সিলেক্ট করুন</span>
    </div>
  )}

  <div class="lp-instructions-wrap">
    <label>অতিরিক্ত নির্দেশনা <span>(ঐচ্ছিক)</span></label>
    <input type="text" class="lp-instructions-input" placeholder="যেমন: ৩ তলায় বাম পাশের ফ্ল্যাট" />
  </div>

  <input type="hidden" class="lp-out-mode" value="text" />
  <input type="hidden" class="lp-out-address" value="" />
  <input type="hidden" class="lp-out-lat" value="" />
  <input type="hidden" class="lp-out-lng" value="" />
  <input type="hidden" class="lp-out-upazila" value="" />
  <input type="hidden" class="lp-out-union" value="" />
  <input type="hidden" class="lp-out-instructions" value="" />

  <div class="lp-overlay">
    <div class="lp-overlay-header">
      <span class="lp-overlay-title">{label} সিলেক্ট করুন</span>
      <button type="button" class="lp-overlay-close" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="lp-overlay-body">
      <div class="lp-search-wrap">
        <i class="fas fa-magnifying-glass lp-search-icon"></i>
        <input type="text" class="lp-search-input" placeholder="জায়গা খুঁজুন (যেমন: মহিপাল)" autocomplete="off" />
        <div class="lp-search-results"></div>
      </div>

      {allowAutoLocate && (
        <button type="button" class="lp-locate-btn">
          <i class="fas fa-location-crosshairs"></i> বর্তমান লোকেশন ব্যবহার করুন
        </button>
      )}

      <div class="lp-map"></div>
    </div>

    <div class="lp-overlay-footer">
      <p class="lp-area-warn" hidden>
        <i class="fas fa-triangle-exclamation"></i>
        <span class="lp-area-warn-text"></span>
      </p>
      <p class="lp-area-badge" hidden>
        <i class="fas fa-location-dot"></i>
        <span class="lp-area-badge-text"></span>
      </p>

      <p class="lp-address-preview">
        <i class="fas fa-map-pin"></i>
        <span class="lp-address-text">ম্যাপে পিন বসান বা সার্চ করুন</span>
      </p>

      {enableSuggestions && (
        <div class="lp-suggest-name-row">
          <input
            type="text"
            class="lp-suggest-name-input"
            placeholder="এই জায়গার নাম দিন (ঐচ্ছিক) — যেমন: নবী হোটেল"
            maxlength="60"
          />
        </div>
      )}

      {enableSavedLocations && (
        <div class="lp-saved-tools">
          <button type="button" class="lp-star-btn" hidden>
            <i class="fas fa-star"></i> আমার ঠিকানা হিসেবে রাখুন
          </button>

          <div class="lp-save-place" hidden>
            <div class="lp-save-place-chips">
              <button type="button" class="lp-chip" data-name="বাসা"><i class="fas fa-house"></i> বাসা</button>
              <button type="button" class="lp-chip" data-name="অফিস"><i class="fas fa-building"></i> অফিস</button>
              <button type="button" class="lp-chip lp-chip-other"><i class="fas fa-pen"></i> অন্য</button>
            </div>
            <input
              type="text"
              class="lp-save-place-input"
              placeholder="নাম দিন (যেমন: বাসা, অফিস)"
              maxlength="30"
              autocomplete="off"
            />
            <div class="lp-save-place-actions">
              <button type="button" class="lp-save-place-ok">সেভ</button>
              <button type="button" class="lp-save-place-cancel">বাতিল</button>
            </div>
          </div>

          <p class="lp-saved-msg" hidden></p>
        </div>
      )}

      <button type="button" class="lp-save-btn">
        <i class="fas fa-check"></i> সেভ করুন
      </button>
    </div>
  </div>
</div>

<script>
  import { getCurrentPosition } from '../../lib/native-bridge.js';
  import { supabase } from '../../lib/supabase.js';
  import {
    UPAZILAS,
    getUnionUpazilaId,
    loadFeniGeo,
    findAreaAt,
    getFeniBounds,
    getUpazilaBorders,
    getDistrictBorder,
    getLabelPoints,
    getUnionBn,
  } from '../../data/feniAreas.js';
  import {
    listSavedLocations,
    saveLocation,
    deleteSavedLocation,
    filterSavedLocations,
    iconForName,
  } from '../../lib/savedLocations.js';

  const FENI_CENTER = [23.0159, 91.3976];
  let leafletLoadPromise: Promise<void> | null = null;

  // ফেনীর geojson — একবার লোড, সব instance শেয়ার করে। লোড না হলে null
  // থাকে এবং ওভারলে/ফেনী-চেক বন্ধ থাকে (অর্ডার আটকায় না)
  let geo: any = null;

  function loadLeaflet(): Promise<void> {
    if ((window as any).L) return Promise.resolve();
    if (leafletLoadPromise) return leafletLoadPromise;

    leafletLoadPromise = new Promise<void>((resolve, reject) => {
      // হেডারের LocationSelector আগেই CSS/JS বসিয়ে থাকলে রিইউজ
      if (!document.querySelector('link[href*="leaflet.min.css"]')) {
        const cssLink = document.createElement('link');
        cssLink.rel = 'stylesheet';
        cssLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
        document.head.appendChild(cssLink);
      }

      const existing = document.querySelector('script[src*="leaflet.min.js"]');
      if (existing) {
        existing.addEventListener('load', () => resolve());
        existing.addEventListener('error', () => reject(new Error('Leaflet লোড ব্যর্থ')));
        return;
      }

      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Leaflet লোড ব্যর্থ'));
      document.head.appendChild(script);
    }).catch((err) => {
      leafletLoadPromise = null;
      throw err;
    });

    return leafletLoadPromise;
  }

  function esc(s: any): string {
    return String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]
    );
  }

  async function reverseGeocode(lat: number, lng: number): Promise<string> {
    try {
      const res = await fetch(
        `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=17&addressdetails=0`
      );
      const data = await res.json();
      return data.display_name || `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    } catch {
      return `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    }
  }

  async function searchPlaces(query: string) {
    try {
      const res = await fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
          query
        )}&countrycodes=bd&limit=5&addressdetails=0`
      );
      return await res.json();
    } catch {
      return [];
    }
  }

  // নিজেদের লোকেশন-সাজেশন API থেকে অটোকমপ্লিট ফলাফল আনা
  async function fetchLocationSuggestions(query: string) {
    try {
      const res = await fetch(`/api/location-suggestions-search?q=${encodeURIComponent(query)}`);
      if (!res.ok) return [];
      const data = await res.json();
      return data.results || [];
    } catch {
      return [];
    }
  }

  // কাস্টমার ম্যাপ-পিনের সাথে নাম দিলে fire-and-forget সেভ করা
  function saveLocationSuggestion(name: string, lat: number, lng: number) {
    fetch('/api/save-location-suggestion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, lat, lng }),
    }).catch(() => {
      /* ব্যর্থ হলেও মূল ফ্লো আটকাবে না — নীরবে ইগনোর */
    });
  }

  // "ফুলগাজী উপজেলা · মুন্সিরহাট ইউনিয়ন"
  function areaText(area: any): string {
    if (!area) return '';
    const up = area.upazilaName ? `${area.upazilaName} উপজেলা` : '';
    let un = area.unionBn || '';
    if (un && !/পৌরসভা/.test(un)) un += ' ইউনিয়ন';
    return [up, un].filter(Boolean).join(' · ');
  }

  // ম্যাপ ওভারলের নামের ছোট চিপ — inline style (Leaflet divIcon-এ scoped CSS লাগে না)
  function chipHtml(text: string, color: string, size: number, bgAlpha: number) {
    return (
      '<div style="position:absolute;left:0;top:0;transform:translate(-50%,-50%);' +
      'white-space:nowrap;pointer-events:none;font-weight:700;' +
      `font-size:${size}px;line-height:1.2;color:#1B2A4A;` +
      `background:rgba(255,255,255,${bgAlpha});padding:1px 6px;border-radius:9px;` +
      `border:1px solid ${color};">` +
      esc(text) +
      '</div>'
    );
  }

  function initPicker(wrap: HTMLElement) {
    const L = (window as any).L;

    const addressInput = wrap.querySelector('.lp-address-input') as HTMLInputElement;
    const mapSelectBtn = wrap.querySelector('.lp-map-select-btn') as HTMLButtonElement;
    const instructionsInput = wrap.querySelector('.lp-instructions-input') as HTMLInputElement;

    const overlay = wrap.querySelector('.lp-overlay') as HTMLElement;
    const overlayCloseBtn = wrap.querySelector('.lp-overlay-close') as HTMLButtonElement;
    const saveBtn = wrap.querySelector('.lp-save-btn') as HTMLButtonElement;
    const mapEl = wrap.querySelector('.lp-map') as HTMLElement;
    const searchInput = wrap.querySelector('.lp-search-input') as HTMLInputElement;
    const searchResults = wrap.querySelector('.lp-search-results') as HTMLElement;
    const locateBtn = wrap.querySelector('.lp-locate-btn') as HTMLButtonElement | null;
    const addressPreview = wrap.querySelector('.lp-address-text') as HTMLElement;

    const areaBadge = wrap.querySelector('.lp-area-badge') as HTMLElement;
    const areaBadgeText = wrap.querySelector('.lp-area-badge-text') as HTMLElement;
    const areaWarn = wrap.querySelector('.lp-area-warn') as HTMLElement;
    const areaWarnText = wrap.querySelector('.lp-area-warn-text') as HTMLElement;

    const outMode = wrap.querySelector('.lp-out-mode') as HTMLInputElement;
    const outAddress = wrap.querySelector('.lp-out-address') as HTMLInputElement;
    const outLat = wrap.querySelector('.lp-out-lat') as HTMLInputElement;
    const outLng = wrap.querySelector('.lp-out-lng') as HTMLInputElement;
    const outUpazila = wrap.querySelector('.lp-out-upazila') as HTMLInputElement;
    const outUnion = wrap.querySelector('.lp-out-union') as HTMLInputElement;
    const outInstructions = wrap.querySelector('.lp-out-instructions') as HTMLInputElement;

    const allowAutoLocate = wrap.dataset.autoLocate === '1';
    const enableSuggestions = wrap.dataset.enableSuggestions === '1';
    const enableSaved = wrap.dataset.enableSaved === '1';
    const lpId = wrap.dataset.lpId || '';

    // সাজেশন ড্রপডাউন + ম্যাপ-কনফার্ম নাম ফিল্ড (শুধু enableSuggestions=1 হলে DOM-এ থাকে)
    const suggestResults = wrap.querySelector('.lp-suggest-results') as HTMLElement | null;
    const suggestNameInput = wrap.querySelector('.lp-suggest-name-input') as HTMLInputElement | null;

    // সেভড ঠিকানা (শুধু enableSavedLocations=1 হলে DOM-এ থাকে)
    const savedResults = wrap.querySelector('.lp-saved-results') as HTMLElement | null;
    const starBtn = wrap.querySelector('.lp-star-btn') as HTMLButtonElement | null;
    const savePlacePanel = wrap.querySelector('.lp-save-place') as HTMLElement | null;
    const savePlaceInput = wrap.querySelector('.lp-save-place-input') as HTMLInputElement | null;
    const savePlaceOk = wrap.querySelector('.lp-save-place-ok') as HTMLButtonElement | null;
    const savePlaceCancel = wrap.querySelector('.lp-save-place-cancel') as HTMLButtonElement | null;
    const savedMsg = wrap.querySelector('.lp-saved-msg') as HTMLElement | null;

    let map: any = null;
    let marker: any = null;
    let pendingLat: number | null = null;
    let pendingLng: number | null = null;
    let pendingAddress = '';
    let pendingArea: any = null;
    let markerToken = 0;
    let overlayDrawn = false;
    let upLabels: any = null;
    let unLabels: any = null;

    // ============ পেরেন্ট ফর্মের জন্য ইভেন্ট ============
    function emitLocation(source: string, lat: number | null, lng: number | null, address: string, area: any) {
      const upazila = area ? area.upazilaName || '' : '';
      const union = area ? area.unionBn || '' : '';
      wrap.dataset.lpUpazila = upazila;
      wrap.dataset.lpUnion = union;
      outUpazila.value = upazila;
      outUnion.value = union;
      wrap.dispatchEvent(
        new CustomEvent('lp:location-changed', {
          bubbles: true,
          detail: {
            id: lpId,
            source,
            cleared: source === 'text',
            lat,
            lng,
            address,
            upazila,
            upazilaId: area ? area.upazilaId || '' : '',
            union,
          },
        })
      );
    }

    // ============ ম্যাপ ও ফেনী ওভারলে ============
    function drawFeniOverlay() {
      if (!geo || overlayDrawn) return;
      overlayDrawn = true;

      const panes: Array<[string, number]> = [
        ['lpUnions', 420],
        ['lpUpazilaLines', 425],
        ['lpDistrictHalo', 440],
        ['lpDistrictLine', 450],
        ['lpLabels', 460],
      ];
      panes.forEach(([name, z]) => {
        map.createPane(name);
        map.getPane(name).style.zIndex = String(z);
      });
      // ওভারলে ট্যাপ/ড্র্যাগ আটকাবে না — ক্লিক সরাসরি নিচের ম্যাপে যাবে
      panes.forEach(([name]) => {
        map.getPane(name).style.pointerEvents = 'none';
      });

      // ইউনিয়নের পাতলা বাউন্ডারি (ভেতরে কোনো রঙ নেই — নিচের ম্যাপ হুবহু দেখা যায়)
      L.geoJSON(geo, {
        pane: 'lpUnions',
        interactive: false,
        style: () => ({ color: '#64748b', weight: 1, opacity: 0.6, fill: false }),
      }).addTo(map);

      // উপজেলার বাউন্ডারি — ইউনিয়নের চেয়ে একটু গাঢ়
      const upBorders = getUpazilaBorders(geo);
      UPAZILAS.forEach((u: any) => {
        L.polyline(upBorders[u.id], {
          pane: 'lpUpazilaLines', color: u.color, weight: 2.5, opacity: 0.9, interactive: false,
        }).addTo(map);
      });

      // ফেনী জেলার পুরো সীমানা — বোল্ড (সাদা হ্যালো + কমলা)
      const border = getDistrictBorder(geo);
      L.polyline(border, {
        pane: 'lpDistrictHalo', color: '#ffffff', weight: 10, opacity: 0.95,
        lineCap: 'round', lineJoin: 'round', interactive: false,
      }).addTo(map);
      L.polyline(border, {
        pane: 'lpDistrictLine', color: '#FF6B35', weight: 4.5, opacity: 1,
        lineCap: 'round', lineJoin: 'round', interactive: false,
      }).addTo(map);

      // নাম: জুম কম হলে উপজেলা, বেশি হলে ইউনিয়ন
      const labels = getLabelPoints(geo);
      upLabels = L.layerGroup();
      unLabels = L.layerGroup();

      UPAZILAS.forEach((u: any) => {
        const pt = labels.upazilas[u.id];
        if (!pt) return;
        upLabels.addLayer(
          L.marker(pt, {
            pane: 'lpLabels', interactive: false, keyboard: false,
            icon: L.divIcon({ className: '', html: chipHtml(u.name, u.color, 12, 0.85), iconSize: [0, 0], iconAnchor: [0, 0] }),
          })
        );
      });

      Object.keys(labels.unions).forEach((name) => {
        const upId = getUnionUpazilaId(name);
        const up: any = UPAZILAS.find((x: any) => x.id === upId);
        unLabels.addLayer(
          L.marker(labels.unions[name], {
            pane: 'lpLabels', interactive: false, keyboard: false,
            icon: L.divIcon({
              className: '',
              html: chipHtml(getUnionBn(name), up ? up.color : '#64748b', 10, 0.78),
              iconSize: [0, 0],
              iconAnchor: [0, 0],
            }),
          })
        );
      });

      map.on('zoomend', refreshLabels);
      refreshLabels();

      // ফেনীর সীমানায় আটকানো
      map.options.maxBoundsViscosity = 1.0;
      map.setMaxBounds(getFeniBounds(geo, 0.05));
      map.setMinZoom(10);
    }

    function refreshLabels() {
      if (!map || !upLabels || !unLabels) return;
      const showUnions = map.getZoom() >= 12;
      if (showUnions) {
        if (map.hasLayer(upLabels)) map.removeLayer(upLabels);
        if (!map.hasLayer(unLabels)) map.addLayer(unLabels);
      } else {
        if (map.hasLayer(unLabels)) map.removeLayer(unLabels);
        if (!map.hasLayer(upLabels)) map.addLayer(upLabels);
      }
    }

    function ensureMap() {
      if (map) return;
      map = L.map(mapEl, { zoomControl: true }).setView(FENI_CENTER, 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19,
      }).addTo(map);

      drawFeniOverlay();

      map.on('click', (e: any) => {
        handleNewPosition(e.latlng.lat, e.latlng.lng, false);
      });
    }

    // ============ ব্যাজ / সতর্কবার্তা ============
    function showArea(area: any) {
      areaWarn.hidden = true;
      if (area) {
        areaBadgeText.textContent = areaText(area);
        areaBadge.hidden = false;
      } else {
        areaBadge.hidden = true;
      }
    }

    function showOutside(message: string) {
      areaBadge.hidden = true;
      areaWarnText.textContent = message;
      areaWarn.hidden = false;
    }

    // knownAddress দেওয়া থাকলে (সেভড ঠিকানা) reverse-geocode ছাড়াই সেটাই ব্যবহার হয়
    async function setMarker(lat: number, lng: number, panTo = true, knownAddress = '') {
      const token = ++markerToken;

      // ফেনীর বাইরে হলে পিন বসবে না
      const area = geo ? findAreaAt(lat, lng, geo) : null;
      if (geo && !area) {
        if (marker) {
          map.removeLayer(marker);
          marker = null;
        }
        pendingLat = null;
        pendingLng = null;
        pendingAddress = '';
        pendingArea = null;
        showOutside('এই লোকেশন ফেনী জেলার বাইরে — ফেনীর ভেতরে পিন বসান');
        addressPreview.textContent = 'ম্যাপে পিন বসান বা সার্চ করুন';
        updateStarVisibility();
        return;
      }

      if (marker) {
        marker.setLatLng([lat, lng]);
      } else {
        marker = L.marker([lat, lng], { draggable: true }).addTo(map);
        marker.on('dragend', () => {
          const pos = marker.getLatLng();
          handleNewPosition(pos.lat, pos.lng, false);
        });
      }
      if (panTo) map.setView([lat, lng], 16);

      pendingLat = lat;
      pendingLng = lng;
      pendingArea = area;
      showArea(area);
      updateStarVisibility();

      if (knownAddress) {
        pendingAddress = knownAddress;
        addressPreview.textContent = knownAddress;
        return;
      }

      addressPreview.textContent = 'ঠিকানা খোঁজা হচ্ছে...';
      const address = await reverseGeocode(lat, lng);
      if (token !== markerToken) return; // এর মধ্যে নতুন পিন বসেছে
      pendingAddress = address;
      addressPreview.textContent = address;
    }

    function handleNewPosition(lat: number, lng: number, panTo = true, knownAddress = '') {
      setMarker(lat, lng, panTo, knownAddress);
    }

    // ============ ফুলস্ক্রিন ওভারলে খোলা/বন্ধ ============
    function openOverlay() {
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      ensureMap();
      setTimeout(() => {
        map.invalidateSize();
        if (marker) {
          const pos = marker.getLatLng();
          map.setView(pos, 16);
        }
      }, 50);

      // সেভড ঠিকানা বাছা থাকলে ম্যাপে সেই পিন দেখানো (ঠিকানার লেখা অপরিবর্তিত)
      if (!marker && outMode.value === 'saved' && outLat.value && outLng.value) {
        handleNewPosition(parseFloat(outLat.value), parseFloat(outLng.value), true, outAddress.value);
      } else if (allowAutoLocate && !marker) {
        tryAutoLocate();
      }

      refreshLoginState();
    }

    function closeOverlay() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
      setSearchResultsVisible(false);
      searchInput.value = '';
      closeSavePlacePanel();
    }

    mapSelectBtn.addEventListener('click', openOverlay);
    overlayCloseBtn.addEventListener('click', closeOverlay);

    saveBtn.addEventListener('click', () => {
      if (pendingLat === null || pendingLng === null) {
        addressPreview.textContent = 'দয়া করে ম্যাপে একটা পিন বসান বা সার্চ করে সিলেক্ট করুন';
        return;
      }
      outLat.value = String(pendingLat);
      outLng.value = String(pendingLng);
      outAddress.value = pendingAddress;
      outMode.value = 'map';
      addressInput.value = pendingAddress;
      addressInput.classList.remove('field-invalid');
      wrap.querySelector(`[data-error-for="${addressInput.id}"]`)?.classList.remove('show');

      // ঐচ্ছিক নাম দেওয়া থাকলে সাজেশন-ডাটাবেসে ফায়ার-অ্যান্ড-ফরগেট সেভ
      if (enableSuggestions && suggestNameInput) {
        const suggestName = suggestNameInput.value.trim();
        if (suggestName) {
          saveLocationSuggestion(suggestName, pendingLat, pendingLng);
        }
        suggestNameInput.value = '';
      }

      emitLocation('map', pendingLat, pendingLng, pendingAddress, pendingArea);
      closeOverlay();
    });

    // ============ ঠিকানা সরাসরি টাইপ করা ============
    addressInput.addEventListener('input', () => {
      outAddress.value = addressInput.value.trim();
      outMode.value = 'text';
      outLat.value = '';
      outLng.value = '';
      emitLocation('text', null, null, outAddress.value, null);
    });

    instructionsInput.addEventListener('input', () => {
      outInstructions.value = instructionsInput.value.trim();
    });

    // ============ লোকেশন-সাজেশন অটোকমপ্লিট (শুধু enableSuggestions=1) ============
    if (enableSuggestions && suggestResults) {
      function setSuggestResultsVisible(visible: boolean) {
        suggestResults!.classList.toggle('active', visible);
      }

      function renderSuggestItem(item: any) {
        const thumb = item.image_url
          ? `<img src="${item.image_url}" class="lp-suggest-thumb" alt="" loading="lazy" />`
          : `<div class="lp-suggest-thumb lp-suggest-thumb-fallback"><i class="fas fa-location-dot"></i></div>`;
        const sub = item.upazila ? `<span class="lp-suggest-sub">${item.upazila}</span>` : '';
        return `
          <div class="lp-suggest-item" data-lat="${item.lat}" data-lng="${item.lng}" data-name="${(item.name || '').replace(/"/g, '&quot;')}">
            ${thumb}
            <div class="lp-suggest-text">
              <span class="lp-suggest-name">${item.name}</span>
              ${sub}
            </div>
          </div>
        `;
      }

      let suggestTimer: ReturnType<typeof setTimeout>;
      addressInput.addEventListener('input', () => {
        clearTimeout(suggestTimer);
        const q = addressInput.value.trim();
        if (q.length < 2) {
          suggestResults!.innerHTML = '';
          setSuggestResultsVisible(false);
          return;
        }
        suggestTimer = setTimeout(async () => {
          const results = await fetchLocationSuggestions(q);
          if (!results.length) {
            setSuggestResultsVisible(false);
            return;
          }
          suggestResults!.innerHTML = results.map(renderSuggestItem).join('');
          setSuggestResultsVisible(true);

          suggestResults!.querySelectorAll('.lp-suggest-item').forEach((el) => {
            el.addEventListener('click', () => {
              const target = el as HTMLElement;
              const name = target.dataset.name || '';
              const lat = parseFloat(target.dataset.lat || '');
              const lng = parseFloat(target.dataset.lng || '');

              addressInput.value = name;
              outAddress.value = name;
              outLat.value = Number.isFinite(lat) ? String(lat) : '';
              outLng.value = Number.isFinite(lng) ? String(lng) : '';
              outMode.value = 'suggestion';
              addressInput.classList.remove('field-invalid');
              wrap.querySelector(`[data-error-for="${addressInput.id}"]`)?.classList.remove('show');

              setSuggestResultsVisible(false);

              const area = geo && Number.isFinite(lat) && Number.isFinite(lng) ? findAreaAt(lat, lng, geo) : null;
              emitLocation('suggestion', Number.isFinite(lat) ? lat : null, Number.isFinite(lng) ? lng : null, name, area);
            });
          });
        }, 350);
      });

      addressInput.addEventListener('focus', () => {
        if (suggestResults!.innerHTML) setSuggestResultsVisible(true);
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) setSuggestResultsVisible(false);
      });
    }

    // ============ সার্চ (ম্যাপ ওভারলের ভেতরের Nominatim সার্চ) ============
    function setSearchResultsVisible(visible: boolean) {
      searchResults.classList.toggle('active', visible);
    }

    let searchTimer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      const q = searchInput.value.trim();
      if (q.length < 3) {
        searchResults.innerHTML = '';
        setSearchResultsVisible(false);
        return;
      }
      searchTimer = setTimeout(async () => {
        const results = await searchPlaces(q + ', Feni, Bangladesh');
        if (!results.length) {
          searchResults.innerHTML = '<div class="lp-search-empty">কিছু পাওয়া যায়নি</div>';
          setSearchResultsVisible(true);
          return;
        }
        searchResults.innerHTML = results
          .map(
            (r: any, i: number) =>
              `<div class="lp-search-item" data-idx="${i}"><i class="fas fa-location-dot"></i> ${r.display_name}</div>`
          )
          .join('');
        setSearchResultsVisible(true);

        searchResults.querySelectorAll('.lp-search-item').forEach((el) => {
          el.addEventListener('click', () => {
            const idx = Number((el as HTMLElement).dataset.idx);
            const r = results[idx];
            handleNewPosition(parseFloat(r.lat), parseFloat(r.lon), true);
            setSearchResultsVisible(false);
            searchInput.value = '';
          });
        });
      }, 400);
    });

    overlay.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.lp-search-wrap')) {
        setSearchResultsVisible(false);
      }
    });

    // ============ অটো-লোকেট (শুধু allowAutoLocate=true) ============
    function resetLocateBtn() {
      if (!locateBtn) return;
      locateBtn.disabled = false;
      locateBtn.innerHTML = '<i class="fas fa-location-crosshairs"></i> বর্তমান লোকেশন ব্যবহার করুন';
    }

    function tryAutoLocate() {
      if (!locateBtn) return;
      locateBtn.disabled = true;
      locateBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> লোকেশন খোঁজা হচ্ছে...';
      getCurrentPosition(
        (pos) => {
          const la = pos.coords.latitude;
          const ln = pos.coords.longitude;
          // ফেনীর বাইরে (যেমন প্রবাস) হলে পিন বসবে না, ম্যাপ ফেনীতেই থাকবে
          if (geo && !findAreaAt(la, ln, geo)) {
            showOutside('আপনি এখন ফেনীর বাইরে আছেন — ম্যাপে ফেনীর ভেতরে পিন বসান');
            resetLocateBtn();
            return;
          }
          handleNewPosition(la, ln, true);
          resetLocateBtn();
        },
        () => {
          resetLocateBtn();
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    }

    if (allowAutoLocate && locateBtn) {
      locateBtn.addEventListener('click', tryAutoLocate);
    }

    // ============================================================
    // সেভড ঠিকানা (শুধু enableSavedLocations=1)
    // ============================================================
    let loggedIn = false;
    let savedList: any[] = [];
    let savedLoaded = false;
    let msgTimer: ReturnType<typeof setTimeout>;
    let deleteArmedId: string | null = null;
    let deleteArmTimer: ReturnType<typeof setTimeout>;

    async function refreshLoginState() {
      if (!enableSaved) return;
      const { data: { session } } = await supabase.auth.getSession();
      loggedIn = !!session;
      updateStarVisibility();
    }

    function updateStarVisibility() {
      if (!starBtn) return;
      const show = loggedIn && pendingLat !== null && pendingLng !== null;
      starBtn.hidden = !show;
      if (!show) closeSavePlacePanel();
    }

    function showSavedMsg(text: string, isError = false) {
      if (!savedMsg) return;
      clearTimeout(msgTimer);
      savedMsg.textContent = text;
      savedMsg.classList.toggle('error', isError);
      savedMsg.hidden = false;
      msgTimer = setTimeout(() => {
        savedMsg.hidden = true;
      }, 4000);
    }

    function openSavePlacePanel() {
      if (!savePlacePanel || !savePlaceInput || !starBtn) return;
      savePlacePanel.hidden = false;
      starBtn.hidden = true;
      savePlaceInput.value = '';
      savePlaceInput.focus();
    }

    function closeSavePlacePanel() {
      if (!savePlacePanel) return;
      savePlacePanel.hidden = true;
      if (starBtn && loggedIn && pendingLat !== null) starBtn.hidden = false;
    }

    if (enableSaved && starBtn && savePlacePanel && savePlaceInput && savePlaceOk && savePlaceCancel) {
      starBtn.addEventListener('click', openSavePlacePanel);
      savePlaceCancel.addEventListener('click', closeSavePlacePanel);

      savePlacePanel.querySelectorAll('.lp-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const name = (chip as HTMLElement).dataset.name;
          savePlaceInput!.value = name || '';
          savePlaceInput!.focus();
        });
      });

      savePlaceOk.addEventListener('click', async () => {
        if (pendingLat === null || pendingLng === null) return;
        savePlaceOk.disabled = true;
        const original = savePlaceOk.textContent;
        savePlaceOk.textContent = 'সেভ হচ্ছে…';

        const result: any = await saveLocation({
          name: savePlaceInput!.value,
          address: pendingAddress,
          lat: pendingLat,
          lng: pendingLng,
          upazila: pendingArea ? pendingArea.upazilaName : null,
          union: pendingArea ? pendingArea.unionBn : null,
        });

        savePlaceOk.disabled = false;
        savePlaceOk.textContent = original;

        if (result.error) {
          showSavedMsg(result.error, true);
          return;
        }

        savedLoaded = false; // পরের বার ড্রপডাউন খুললে নতুন লিস্ট আসবে
        closeSavePlacePanel();
        showSavedMsg(
          result.updated
            ? `✓ "${result.data.name}" আপডেট হয়েছে`
            : `✓ "${result.data.name}" আপনার ঠিকানায় সেভ হয়েছে`
        );
      });
    }

    // ----- ঠিকানা বক্সে সেভড ঠিকানার সাজেশন -----
    function setSavedVisible(visible: boolean) {
      if (savedResults) savedResults.classList.toggle('active', visible);
    }

    async function ensureSavedLoaded() {
      if (savedLoaded) return;
      await refreshLoginState();
      if (!loggedIn) {
        savedList = [];
        savedLoaded = true;
        return;
      }
      const { data } = await listSavedLocations();
      savedList = data || [];
      savedLoaded = true;
    }

    function renderSaved() {
      if (!savedResults) return;
      const items = filterSavedLocations(savedList, addressInput.value);
      if (!items.length) {
        savedResults.innerHTML = '';
        setSavedVisible(false);
        return;
      }
      const rows = items
        .map((it: any) => {
          const armed = deleteArmedId === it.id;
          const sub = [it.upazila, it.union_name].filter(Boolean).join(' · ');
          return `
            <div class="lp-saved-item" data-id="${esc(it.id)}">
              <div class="lp-saved-ico"><i class="fas ${iconForName(it.name)}"></i></div>
              <div class="lp-saved-text">
                <span class="lp-saved-name">${esc(it.name)}</span>
                <span class="lp-saved-addr">${esc(it.address)}</span>
                ${sub ? `<span class="lp-saved-sub">${esc(sub)}</span>` : ''}
              </div>
              <button type="button" class="lp-saved-del${armed ? ' armed' : ''}" data-del="${esc(it.id)}" aria-label="ঠিকানা মুছুন">
                ${armed ? 'মুছবেন?' : '<i class="fas fa-trash-can"></i>'}
              </button>
            </div>`;
        })
        .join('');
      savedResults.innerHTML = `<div class="lp-saved-head"><i class="fas fa-star"></i> আপনার সেভ করা ঠিকানা</div>${rows}`;
      setSavedVisible(true);
    }

    function applySaved(item: any) {
      const lat = Number(item.lat);
      const lng = Number(item.lng);
      addressInput.value = item.address;
      outAddress.value = item.address;
      outLat.value = String(lat);
      outLng.value = String(lng);
      outMode.value = 'saved';
      addressInput.classList.remove('field-invalid');
      wrap.querySelector(`[data-error-for="${addressInput.id}"]`)?.classList.remove('show');
      setSavedVisible(false);
      // ম্যাপ থেকে ধরা উপজেলা/ইউনিয়ন; geojson না থাকলে সেভ করা নামই ব্যবহার
      let area: any = geo ? findAreaAt(lat, lng, geo) : null;
      if (!area && item.upazila) {
        const up: any = UPAZILAS.find((u: any) => u.name === item.upazila);
        area = { upazilaName: item.upazila, upazilaId: up ? up.id : '', unionBn: item.union_name || '' };
      }
      emitLocation('saved', lat, lng, item.address, area);
    }

    if (enableSaved && savedResults) {
      const openSaved = async () => {
        await ensureSavedLoaded();
        renderSaved();
      };
      addressInput.addEventListener('focus', openSaved);
      addressInput.addEventListener('click', openSaved);
      addressInput.addEventListener('input', async () => {
        await ensureSavedLoaded();
        renderSaved();
      });

      savedResults.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;

        // মুছে ফেলা — প্রথম ট্যাপে "মুছবেন?", দ্বিতীয় ট্যাপে আসলে মোছা
        const delBtn = target.closest('.lp-saved-del') as HTMLElement | null;
        if (delBtn) {
          e.stopPropagation();
          const delId = delBtn.dataset.del || '';
          if (deleteArmedId !== delId) {
            deleteArmedId = delId;
            clearTimeout(deleteArmTimer);
            deleteArmTimer = setTimeout(() => {
              deleteArmedId = null;
              renderSaved();
            }, 3000);
            renderSaved();
            return;
          }
          clearTimeout(deleteArmTimer);
          deleteArmedId = null;
          const { error } = await deleteSavedLocation(delId);
          if (error) {
            showSavedMsg(error, true);
          } else {
            savedList = savedList.filter((x: any) => x.id !== delId);
          }
          renderSaved();
          return;
        }

        const row = target.closest('.lp-saved-item') as HTMLElement | null;
        if (row) {
          const item = savedList.find((x: any) => x.id === row.dataset.id);
          if (item) applySaved(item);
        }
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) setSavedVisible(false);
      });
    }

    refreshLoginState();
  }

  async function initAllPickers() {
    const wraps = document.querySelectorAll<HTMLElement>('.lp-wrap');
    if (!wraps.length) return;

    // Leaflet আর ফেনীর geojson একসাথে লোড। geojson ব্যর্থ হলেও পিকার চলবে (ওভারলে ছাড়া)
    const [, g] = await Promise.all([
      loadLeaflet(),
      loadFeniGeo().catch((err: any) => {
        console.error('[LocationPicker] ফেনীর geojson লোড ব্যর্থ — ওভারলে/ফেনী-চেক বন্ধ:', err);
        return null;
      }),
    ]);
    geo = g;

    wraps.forEach((wrap) => {
      if (wrap.dataset.lpInitialized === '1') return;
      wrap.dataset.lpInitialized = '1';
      initPicker(wrap);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllPickers);
  } else {
    initAllPickers();
  }
</script>

