---
// ============================================================
// কম্পোনেন্ট: LocationPicker (রিইউজেবল, Smart Hero / Ride Hero)
// লেআউট: ঠিকানা টেক্সট বক্স + পাশে "ম্যাপে সিলেক্ট করুন" বাটন।
// বাটনে ক্লিক করলে ফুলস্ক্রিন ম্যাপ ওভারলে খোলে (Leaflet+OSM+Nominatim,
// সার্চ + ড্র্যাগেবল পিন + বর্তমান লোকেশন)। "সেভ করুন" চাপলে
// ঠিকানা+lat/lng টেক্সট বক্সে বসে যায় এবং ওভারলে বন্ধ হয়ে
// আগের ফর্ম পেজে ফিরে আসে।
// + সবসময় আলাদা "অতিরিক্ত নির্দেশনা" ফিল্ড
//
// একই পেজে pickup ও drop দুইটার জন্য দুইবার বসানো যাবে —
// প্রতিটা instance-এর id আলাদা হতে হবে।
//
// ব্যবহার:
//   <LocationPicker id="pickup" label="পিকআপ লোকেশন" allowAutoLocate={true} />
//   <LocationPicker id="drop" label="ড্রপ-অফ লোকেশন" allowAutoLocate={false} />
//
// পেরেন্ট ফর্ম থেকে ভ্যালু পড়া (সাবমিটের সময়, আগের মতোই অপরিবর্তিত):
//   document.querySelector('[data-lp-id="pickup"] .lp-out-address').value
//   ... .lp-out-lat / .lp-out-lng / .lp-out-instructions
//
// z-index নোট: .lp-map-এ isolation:isolate ব্যবহার করা হয়েছে যাতে
// Leaflet-এর ভেতরের প্যানগুলোর (tile/marker/popup pane, z-index 200-700)
// z-index কখনোই বাইরের সার্চ-রেজাল্ট ড্রপডাউনের (.lp-search-results,
// z-index 51) উপরে চলে আসতে না পারে। isolate একটা নতুন, সম্পূর্ণ
// আলাদা stacking context বানিয়ে দেয় — ভেতরে Leaflet যত বড় z-index
// ব্যবহার করুক না কেন, সেটা .lp-map এর বাইরে কখনো "escape" করবে না।
//
// ============================================================
// নতুন (ঐচ্ছিক): enableSuggestions prop — true হলে এই instance-এ:
// ১. টাইপ করার সময় /api/location-suggestions-search থেকে নাম-ভিত্তিক
//    সাজেশন ড্রপডাউন দেখায় (থাম্বনেইল + নাম + উপজেলা), ক্লিক করলে
//    টেক্সটে নাম বসে আর lat/lng ব্যাকএন্ডে এমবেডেড থাকে।
// ২. ম্যাপ থেকে পিন করে "সেভ করুন" চাপার সময় একটা ঐচ্ছিক "নাম" ফিল্ড
//    দেখায় — নাম দিলে সেটা /api/save-location-suggestion-এ সেভ হয়ে
//    ভবিষ্যতের জন্য সাজেশন-ডাটাবেসে যোগ হয় (খালি রাখলে কিছুই সেভ হয় না)।
// ডিফল্ট false — drop/Ride Hero-তে কোনো পরিবর্তন হয় না।
// ============================================================

interface Props {
  id: string;
  label: string;
  allowAutoLocate?: boolean;
  placeholder?: string;
  required?: boolean;
  enableSuggestions?: boolean;
}

const {
  id,
  label,
  allowAutoLocate = false,
  placeholder = 'যেমন: নবী হোটেল, ফেনী সদর',
  required = true,
  enableSuggestions = false,
} = Astro.props;
---

<div
  class="lp-wrap"
  data-lp-id={id}
  data-auto-locate={allowAutoLocate ? '1' : '0'}
  data-enable-suggestions={enableSuggestions ? '1' : '0'}
>
  <label class="lp-label">{label}{required && <span class="required-mark">*</span>}</label>

  <div class="lp-address-row">
    <input
      type="text"
      id={`lp-${id}-address`}
      class="lp-address-input"
      placeholder={placeholder}
      required={required}
      autocomplete="off"
    />
    <button type="button" class="lp-map-select-btn">
      <i class="fas fa-map-location-dot"></i>
      <span>ম্যাপে সিলেক্ট করুন</span>
    </button>
  </div>

  {enableSuggestions && <div class="lp-suggest-results"></div>}

  {required && (
    <div class="field-error-msg" data-error-for={`lp-${id}-address`}>
      <i class="fas fa-circle-exclamation"></i><span>ঠিকানা দিন বা ম্যাপ থেকে সিলেক্ট করুন</span>
    </div>
  )}

  <div class="lp-instructions-wrap">
    <label>অতিরিক্ত নির্দেশনা <span>(ঐচ্ছিক)</span></label>
    <input type="text" class="lp-instructions-input" placeholder="যেমন: ৩ তলায় বাম পাশের ফ্ল্যাট" />
  </div>

  <input type="hidden" class="lp-out-mode" value="text" />
  <input type="hidden" class="lp-out-address" value="" />
  <input type="hidden" class="lp-out-lat" value="" />
  <input type="hidden" class="lp-out-lng" value="" />
  <input type="hidden" class="lp-out-instructions" value="" />

  <div class="lp-overlay">
    <div class="lp-overlay-header">
      <span class="lp-overlay-title">{label} সিলেক্ট করুন</span>
      <button type="button" class="lp-overlay-close" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="lp-overlay-body">
      <div class="lp-search-wrap">
        <i class="fas fa-magnifying-glass lp-search-icon"></i>
        <input type="text" class="lp-search-input" placeholder="জায়গা খুঁজুন (যেমন: মহিপাল)" autocomplete="off" />
        <div class="lp-search-results"></div>
      </div>

      {allowAutoLocate && (
        <button type="button" class="lp-locate-btn">
          <i class="fas fa-location-crosshairs"></i> বর্তমান লোকেশন ব্যবহার করুন
        </button>
      )}

      <div class="lp-map"></div>
    </div>

    <div class="lp-overlay-footer">
      <p class="lp-address-preview">
        <i class="fas fa-map-pin"></i>
        <span class="lp-address-text">ম্যাপে পিন বসান বা সার্চ করুন</span>
      </p>
      {enableSuggestions && (
        <div class="lp-suggest-name-row">
          <input
            type="text"
            class="lp-suggest-name-input"
            placeholder="এই জায়গার নাম দিন (ঐচ্ছিক) — যেমন: নবী হোটেল"
            maxlength="60"
          />
        </div>
      )}
      <button type="button" class="lp-save-btn">
        <i class="fas fa-check"></i> সেভ করুন
      </button>
    </div>
  </div>
</div>

<script>
  const FENI_CENTER = [23.0159, 91.3976];
  let leafletLoadPromise: Promise<void> | null = null;

  function loadLeaflet(): Promise<void> {
    if ((window as any).L) return Promise.resolve();
    if (leafletLoadPromise) return leafletLoadPromise;

    leafletLoadPromise = new Promise((resolve, reject) => {
      const cssLink = document.createElement('link');
      cssLink.rel = 'stylesheet';
      cssLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
      document.head.appendChild(cssLink);

      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Leaflet লোড ব্যর্থ'));
      document.head.appendChild(script);
    });

    return leafletLoadPromise;
  }

  async function reverseGeocode(lat: number, lng: number): Promise<string> {
    try {
      const res = await fetch(
        `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=17&addressdetails=0`
      );
      const data = await res.json();
      return data.display_name || `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    } catch {
      return `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    }
  }

  async function searchPlaces(query: string) {
    try {
      const res = await fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
          query
        )}&countrycodes=bd&limit=5&addressdetails=0`
      );
      return await res.json();
    } catch {
      return [];
    }
  }

  // নতুন: নিজেদের লোকেশন-সাজেশন API থেকে অটোকমপ্লিট ফলাফল আনা
  async function fetchLocationSuggestions(query: string) {
    try {
      const res = await fetch(`/api/location-suggestions-search?q=${encodeURIComponent(query)}`);
      if (!res.ok) return [];
      const data = await res.json();
      return data.results || [];
    } catch {
      return [];
    }
  }

  // নতুন: কাস্টমার ম্যাপ-পিনের সাথে নাম দিলে fire-and-forget সেভ করা
  function saveLocationSuggestion(name: string, lat: number, lng: number) {
    fetch('/api/save-location-suggestion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, lat, lng }),
    }).catch(() => {
      /* ব্যর্থ হলেও মূল ফ্লো আটকাবে না — নীরবে ইগনোর */
    });
  }

  function initPicker(wrap: HTMLElement) {
    const L = (window as any).L;

    const addressInput = wrap.querySelector('.lp-address-input') as HTMLInputElement;
    const mapSelectBtn = wrap.querySelector('.lp-map-select-btn') as HTMLButtonElement;
    const instructionsInput = wrap.querySelector('.lp-instructions-input') as HTMLInputElement;

    const overlay = wrap.querySelector('.lp-overlay') as HTMLElement;
    const overlayCloseBtn = wrap.querySelector('.lp-overlay-close') as HTMLButtonElement;
    const saveBtn = wrap.querySelector('.lp-save-btn') as HTMLButtonElement;
    const mapEl = wrap.querySelector('.lp-map') as HTMLElement;
    const searchInput = wrap.querySelector('.lp-search-input') as HTMLInputElement;
    const searchResults = wrap.querySelector('.lp-search-results') as HTMLElement;
    const locateBtn = wrap.querySelector('.lp-locate-btn') as HTMLButtonElement | null;
    const addressPreview = wrap.querySelector('.lp-address-text') as HTMLElement;

    const outMode = wrap.querySelector('.lp-out-mode') as HTMLInputElement;
    const outAddress = wrap.querySelector('.lp-out-address') as HTMLInputElement;
    const outLat = wrap.querySelector('.lp-out-lat') as HTMLInputElement;
    const outLng = wrap.querySelector('.lp-out-lng') as HTMLInputElement;
    const outInstructions = wrap.querySelector('.lp-out-instructions') as HTMLInputElement;

    const allowAutoLocate = wrap.dataset.autoLocate === '1';
    const enableSuggestions = wrap.dataset.enableSuggestions === '1';

    // নতুন: সাজেশন ড্রপডাউন + ম্যাপ-কনফার্ম নাম ফিল্ড (শুধু enableSuggestions=1 হলে DOM-এ থাকে)
    const suggestResults = wrap.querySelector('.lp-suggest-results') as HTMLElement | null;
    const suggestNameInput = wrap.querySelector('.lp-suggest-name-input') as HTMLInputElement | null;

    let map: any = null;
    let marker: any = null;
    let pendingLat: number | null = null;
    let pendingLng: number | null = null;
    let pendingAddress = '';

    function ensureMap() {
      if (map) return;
      map = L.map(mapEl, { zoomControl: true }).setView(FENI_CENTER, 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19,
      }).addTo(map);

      map.on('click', (e: any) => {
        handleNewPosition(e.latlng.lat, e.latlng.lng, false);
      });
    }

    async function setMarker(lat: number, lng: number, panTo = true) {
      if (marker) {
        marker.setLatLng([lat, lng]);
      } else {
        marker = L.marker([lat, lng], { draggable: true }).addTo(map);
        marker.on('dragend', () => {
          const pos = marker.getLatLng();
          handleNewPosition(pos.lat, pos.lng, false);
        });
      }
      if (panTo) map.setView([lat, lng], 16);

      pendingLat = lat;
      pendingLng = lng;
      addressPreview.textContent = 'ঠিকানা খোঁজা হচ্ছে...';

      const address = await reverseGeocode(lat, lng);
      pendingAddress = address;
      addressPreview.textContent = address;
    }

    function handleNewPosition(lat: number, lng: number, panTo = true) {
      setMarker(lat, lng, panTo);
    }

    // ============ ফুলস্ক্রিন ওভারলে খোলা/বন্ধ ============
    function openOverlay() {
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      ensureMap();
      setTimeout(() => {
        map.invalidateSize();
        if (marker) {
          const pos = marker.getLatLng();
          map.setView(pos, 16);
        }
      }, 50);

      if (allowAutoLocate && !marker) {
        tryAutoLocate();
      }
    }

    function closeOverlay() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
      setSearchResultsVisible(false);
      searchInput.value = '';
    }

    mapSelectBtn.addEventListener('click', openOverlay);
    overlayCloseBtn.addEventListener('click', closeOverlay);

    saveBtn.addEventListener('click', () => {
      if (pendingLat === null || pendingLng === null) {
        addressPreview.textContent = 'দয়া করে ম্যাপে একটা পিন বসান বা সার্চ করে সিলেক্ট করুন';
        return;
      }
      outLat.value = String(pendingLat);
      outLng.value = String(pendingLng);
      outAddress.value = pendingAddress;
      outMode.value = 'map';
      addressInput.value = pendingAddress;
      addressInput.classList.remove('field-invalid');
      wrap.querySelector(`[data-error-for="${addressInput.id}"]`)?.classList.remove('show');

      // নতুন: ঐচ্ছিক নাম দেওয়া থাকলে সাজেশন-ডাটাবেসে ফায়ার-অ্যান্ড-ফরগেট সেভ
      if (enableSuggestions && suggestNameInput) {
        const suggestName = suggestNameInput.value.trim();
        if (suggestName) {
          saveLocationSuggestion(suggestName, pendingLat, pendingLng);
        }
        suggestNameInput.value = '';
      }

      closeOverlay();
    });

    // ============ ঠিকানা সরাসরি টাইপ করা ============
    addressInput.addEventListener('input', () => {
      outAddress.value = addressInput.value.trim();
      outMode.value = 'text';
      outLat.value = '';
      outLng.value = '';
    });

    instructionsInput.addEventListener('input', () => {
      outInstructions.value = instructionsInput.value.trim();
    });

    // ============ নতুন: লোকেশন-সাজেশন অটোকমপ্লিট (শুধু enableSuggestions=1) ============
    if (enableSuggestions && suggestResults) {
      function setSuggestResultsVisible(visible: boolean) {
        suggestResults!.classList.toggle('active', visible);
      }

      function renderSuggestItem(item: any) {
        const thumb = item.image_url
          ? `<img src="${item.image_url}" class="lp-suggest-thumb" alt="" loading="lazy" />`
          : `<div class="lp-suggest-thumb lp-suggest-thumb-fallback"><i class="fas fa-location-dot"></i></div>`;
        const sub = item.upazila ? `<span class="lp-suggest-sub">${item.upazila}</span>` : '';
        return `
          <div class="lp-suggest-item" data-lat="${item.lat}" data-lng="${item.lng}" data-name="${(item.name || '').replace(/"/g, '&quot;')}">
            ${thumb}
            <div class="lp-suggest-text">
              <span class="lp-suggest-name">${item.name}</span>
              ${sub}
            </div>
          </div>
        `;
      }

      let suggestTimer: ReturnType<typeof setTimeout>;
      addressInput.addEventListener('input', () => {
        clearTimeout(suggestTimer);
        const q = addressInput.value.trim();
        if (q.length < 2) {
          suggestResults!.innerHTML = '';
          setSuggestResultsVisible(false);
          return;
        }
        suggestTimer = setTimeout(async () => {
          const results = await fetchLocationSuggestions(q);
          if (!results.length) {
            setSuggestResultsVisible(false);
            return;
          }
          suggestResults!.innerHTML = results.map(renderSuggestItem).join('');
          setSuggestResultsVisible(true);

          suggestResults!.querySelectorAll('.lp-suggest-item').forEach((el) => {
            el.addEventListener('click', () => {
              const target = el as HTMLElement;
              const name = target.dataset.name || '';
              const lat = parseFloat(target.dataset.lat || '');
              const lng = parseFloat(target.dataset.lng || '');

              addressInput.value = name;
              outAddress.value = name;
              outLat.value = Number.isFinite(lat) ? String(lat) : '';
              outLng.value = Number.isFinite(lng) ? String(lng) : '';
              outMode.value = 'suggestion';
              addressInput.classList.remove('field-invalid');
              wrap.querySelector(`[data-error-for="${addressInput.id}"]`)?.classList.remove('show');

              setSuggestResultsVisible(false);
            });
          });
        }, 350);
      });

      addressInput.addEventListener('focus', () => {
        if (suggestResults!.innerHTML) setSuggestResultsVisible(true);
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) setSuggestResultsVisible(false);
      });
    }

    // ============ সার্চ (ম্যাপ ওভারলের ভেতরের Nominatim সার্চ) ============
    function setSearchResultsVisible(visible: boolean) {
      searchResults.classList.toggle('active', visible);
    }

    let searchTimer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      const q = searchInput.value.trim();
      if (q.length < 3) {
        searchResults.innerHTML = '';
        setSearchResultsVisible(false);
        return;
      }
      searchTimer = setTimeout(async () => {
        const results = await searchPlaces(q + ', Feni, Bangladesh');
        if (!results.length) {
          searchResults.innerHTML = '<div class="lp-search-empty">কিছু পাওয়া যায়নি</div>';
          setSearchResultsVisible(true);
          return;
        }
        searchResults.innerHTML = results
          .map(
            (r: any, i: number) =>
              `<div class="lp-search-item" data-idx="${i}"><i class="fas fa-location-dot"></i> ${r.display_name}</div>`
          )
          .join('');
        setSearchResultsVisible(true);

        searchResults.querySelectorAll('.lp-search-item').forEach((el) => {
          el.addEventListener('click', () => {
            const idx = Number((el as HTMLElement).dataset.idx);
            const r = results[idx];
            handleNewPosition(parseFloat(r.lat), parseFloat(r.lon), true);
            setSearchResultsVisible(false);
            searchInput.value = '';
          });
        });
      }, 400);
    });

    overlay.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.lp-search-wrap')) {
        setSearchResultsVisible(false);
      }
    });

    // ============ অটো-লোকেট (শুধু allowAutoLocate=true) ============
    function tryAutoLocate() {
      if (!locateBtn || !navigator.geolocation) return;
      locateBtn.disabled = true;
      locateBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> লোকেশন খোঁজা হচ্ছে...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          handleNewPosition(pos.coords.latitude, pos.coords.longitude, true);
          locateBtn.disabled = false;
          locateBtn.innerHTML = '<i class="fas fa-location-crosshairs"></i> বর্তমান লোকেশন ব্যবহার করুন';
        },
        () => {
          locateBtn.disabled = false;
          locateBtn.innerHTML = '<i class="fas fa-location-crosshairs"></i> বর্তমান লোকেশন ব্যবহার করুন';
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    }

    if (allowAutoLocate && locateBtn) {
      locateBtn.addEventListener('click', tryAutoLocate);
    }
  }

  async function initAllPickers() {
    const wraps = document.querySelectorAll<HTMLElement>('.lp-wrap');
    if (!wraps.length) return;
    await loadLeaflet();
    wraps.forEach((wrap) => {
      if (wrap.dataset.lpInitialized === '1') return;
      wrap.dataset.lpInitialized = '1';
      initPicker(wrap);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllPickers);
  } else {
    initAllPickers();
  }
</script>

<style>
  .lp-wrap {
    margin-bottom: 18px;
