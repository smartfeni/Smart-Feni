<!-- path: src/components/delivery/NoRiderNotice.astro -->
---
// ============================================================
// কম্পোনেন্ট: "কোনো রাইডার সক্রিয় নেই" নোটিশ
//
// ব্যবহার: DeliveryHeroCard ও RideHeroCard-এর ফর্মের ঠিক উপরে বসে।
// ডিফল্টে লুকানো (hidden) — src/lib/riderAvailability.js রাইডারদের
// অনলাইন স্ট্যাটাস দেখে এটা দেখায়/লুকায় এবং টেক্সট বদলায়।
//
// Props:
//   id       — ইউনিক প্রিফিক্স (যেমন "dh" / "rh")
//   category — 'delivery' | 'ride' (WhatsApp-এর প্রি-ফিল মেসেজের জন্য)
//
// জরুরি যোগাযোগ: WhatsApp +8801816355833
// ============================================================

const { id = 'dh', category = 'delivery' } = Astro.props;

const WHATSAPP_NUMBER = '8801816355833';
const categoryLabel = category === 'ride' ? 'রাইড' : 'ডেলিভারি';
const defaultText = `আসসালামু আলাইকুম, স্মার্ট ফেনীতে জরুরি ${categoryLabel} সার্ভিস দরকার।`;
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(defaultText)}`;
---

<div
  id={`${id}Notice`}
  class="nrn"
  data-notice
  data-wa-number={WHATSAPP_NUMBER}
  data-wa-label={categoryLabel}
  role="status"
  aria-live="polite"
  hidden
>
  <div class="nrn-head">
    <div class="nrn-icon" aria-hidden="true">
      <i class="fas fa-motorcycle"></i>
      <span class="nrn-slash"></span>
    </div>
    <div class="nrn-copy">
      <h3 class="nrn-title" data-notice-title>দুঃখিত, এই মুহূর্তে কোনো রাইডার সক্রিয় নেই</h3>
      <p class="nrn-text" data-notice-text>
        অনুগ্রহ করে কিছুক্ষণ পর চেষ্টা করুন। জরুরি প্রয়োজনে যোগাযোগ করুন।
      </p>
    </div>
  </div>

  <a
    class="nrn-wa"
    data-notice-wa
    href={waHref}
    target="_blank"
    rel="noopener"
  >
    <i class="fab fa-whatsapp"></i>
    <span class="nrn-wa-text">
      <strong>WhatsApp</strong>
      <small>+8801816355833</small>
    </span>
  </a>
</div>

<style>
  .nrn {
    background: #FFFFFF;
    border-radius: 20px;
    padding: 18px 16px 16px;
    margin-bottom: 18px;
    box-shadow: 0 10px 28px rgba(27, 42, 74, 0.18);
    animation: nrn-in 0.3s ease;
  }

  .nrn[hidden] {
    display: none;
  }

  @keyframes nrn-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .nrn-head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .nrn-icon {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  /* আইকনের উপর কাটা দাগ — "অফলাইন" বোঝাতে */
  .nrn-slash {
    position: absolute;
    width: 30px;
    height: 3px;
    background: #1B2A4A;
    border-radius: 3px;
    transform: rotate(-42deg);
    box-shadow: 0 0 0 2px #FFF0EA;
  }

  .nrn-copy {
    min-width: 0;
  }

  .nrn-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #1B2A4A;
    line-height: 1.4;
    margin-bottom: 4px;
  }

  .nrn-text {
    font-size: 0.8rem;
    color: #5A6E85;
    line-height: 1.55;
  }

  .nrn-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #22C55E;
    color: #FFFFFF;
    text-decoration: none;
    padding: 12px 16px;
    border-radius: 14px;
    box-shadow: 0 8px 20px rgba(34, 197, 94, 0.3);
    transition: transform 0.15s ease;
  }

  .nrn-wa:active {
    transform: scale(0.98);
  }

  .nrn-wa > i {
    font-size: 1.6rem;
  }

  .nrn-wa-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
  }

  .nrn-wa-text strong {
    font-size: 0.9rem;
    font-weight: 800;
  }

  .nrn-wa-text small {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.92;
  }

  @media (prefers-reduced-motion: reduce) {
    .nrn {
      animation: none;
    }
  }
</style>