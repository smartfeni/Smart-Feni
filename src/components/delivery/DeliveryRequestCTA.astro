---
// ============================================================
// কম্পোনেন্ট: হোম ডেলিভারি CTA (courier পেজের হেডারের নিচে বসবে)
// মেইন ফোকাস: "হোম ডেলিভারি" বাটন — ক্লিক করলে DeliveryRequestModal
// খোলে (বারগেইন রিকোয়েস্ট ফর্ম, সব রাইডারকে নোটিফাই করবে)
// পাশে ছোট সেকেন্ডারি বাটন: অনলাইন রাইডার লিস্ট (slide panel)
// CTA নিজে ছোট/মার্কেটিং-পাঞ্চ লেভেলের — বিস্তারিত মডালের ভেতরে
// ============================================================
---

<section class="delivery-cta-section">
  <div class="container">
    <div class="delivery-cta-box">
      <div class="delivery-cta-text">
        <span class="delivery-cta-badge"><i class="fas fa-bolt"></i> নতুন</span>
        <h2>হোম ডেলিভারি</h2>
        <p>দাম বলুন, সব ডেলিভারি হিরো জানবে — সবচেয়ে ভালো অফার বেছে নিন</p>
      </div>
      <div class="delivery-cta-actions">
        <button class="btn-request-delivery" id="openDeliveryRequestBtn" type="button">
          <i class="fas fa-motorcycle"></i> রিকোয়েস্ট করুন
        </button>
        <button class="btn-view-online" id="openOnlineRidersBtn" type="button">
          <i class="fas fa-circle online-dot"></i> অনলাইন রাইডার
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .delivery-cta-section {
    padding: 0 0 24px;
    background: #fff;
  }

  .delivery-cta-box {
    background: linear-gradient(135deg, #FF6B35, #FF8A5C);
    border-radius: 22px;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 12px 28px rgba(255, 107, 53, 0.25);
  }

  .delivery-cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 8px;
  }

  .delivery-cta-text h2 {
    color: #fff;
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .delivery-cta-text p {
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.82rem;
    max-width: 320px;
  }

  .delivery-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-request-delivery {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #fff;
    color: #FF6B35;
    border: none;
    padding: 12px 22px;
    border-radius: 40px;
    font-weight: 800;
    font-size: 0.88rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .btn-request-delivery:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .btn-view-online {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 8px 16px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.74rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .btn-view-online:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  .online-dot {
    color: #4ADE80;
    font-size: 0.5rem;
  }

  @media (max-width: 640px) {
    .delivery-cta-box {
      flex-direction: column;
      text-align: center;
    }

    .delivery-cta-text p {
      max-width: none;
    }

    .delivery-cta-actions {
      flex-direction: row;
      width: 100%;
    }

    .btn-request-delivery,
    .btn-view-online {
      flex: 1;
    }
  }
</style>

<script>
  document.getElementById('openDeliveryRequestBtn')?.addEventListener('click', () => {
    window.openDeliveryRequestModal?.();
  });

  document.getElementById('openOnlineRidersBtn')?.addEventListener('click', () => {
    window.openOnlineRidersPanel?.();
  });
</script>