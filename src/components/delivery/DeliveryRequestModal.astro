---
// ============================================================
// কম্পোনেন্ট: হোম ডেলিভারি রিকোয়েস্ট মডাল
// courier পেজে বসবে। লগইন না থাকলে আগে AuthModal খুলবে।
// সাবমিট হলে create-request API কল করে, সফল হলে সাকসেস স্টেট
// দেখিয়ে my-orders এ রিডাইরেক্ট করবে (যেখানে বারগেইনিং হবে)।
// marketing কপি এখানে বিস্তারিত থাকবে (CTA নিজে ছোট রাখা হয়েছে)।
// ============================================================

const upazilaList = [
  'ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী',
];
---

<div class="delivery-modal-overlay" id="deliveryRequestOverlay">
  <div class="delivery-modal">
    <button class="modal-close-btn" id="closeDeliveryRequestBtn" type="button" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <div class="delivery-modal-header">
      <span class="delivery-modal-icon"><i class="fas fa-motorcycle"></i></span>
      <h2>হোম ডেলিভারি রিকোয়েস্ট</h2>
      <p>আপনার লোকেশন ও দাম লিখুন — ফেনীর সব ডেলিভারি হিরো সাথে সাথে জানবে, যে সবচেয়ে ভালো অফার দেয় তাকেই বেছে নিন। কোনো এক্সট্রা চার্জ নেই, সরাসরি রাইডারের সাথে ডিল হবে।</p>
    </div>

    <form id="deliveryRequestForm" class="delivery-modal-form">
      <div class="form-group">
        <label>উপজেলা</label>
        <select id="drUpazila" required>
          <option value="" disabled selected>সিলেক্ট করুন</option>
          {upazilaList.map((u) => <option value={u}>{u}</option>)}
        </select>
      </div>

      <div class="form-group">
        <label>এলাকার বিবরণ</label>
        <input type="text" id="drAreaDetail" placeholder="যেমন: শহীদ মিনার রোড, বাসা নং ১২" required />
      </div>

      <div class="form-group">
        <label>কী ডেলিভারি করতে হবে</label>
        <textarea id="drDescription" placeholder="যেমন: একটা প্যাকেট ফার্মেসি থেকে নিয়ে আসতে হবে" required></textarea>
      </div>

      <div class="form-group">
        <label>বাহনের ধরন</label>
        <div class="vehicle-pills">
          <button type="button" class="vehicle-pill active" data-vehicle="any">যেকোনো</button>
          <button type="button" class="vehicle-pill" data-vehicle="bike">বাইক</button>
          <button type="button" class="vehicle-pill" data-vehicle="cycle">সাইকেল</button>
        </div>
        <input type="hidden" id="drVehicleType" value="any" />
      </div>

      <div class="form-group">
        <label>আপনার দাম (৳)</label>
        <input type="number" id="drPrice" placeholder="যেমন: ১৫০" min="1" required />
      </div>

      <p class="form-error" id="drError" style="display:none;"></p>

      <button type="submit" class="btn-submit-request" id="drSubmitBtn">
        <i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান
      </button>
    </form>

    <div class="delivery-success-state" id="drSuccessState" style="display:none;">
      <div class="success-icon-badge"><i class="fas fa-check"></i></div>
      <h3>রিকোয়েস্ট পাঠানো হয়েছে!</h3>
      <p>সব ডেলিভারি হিরোকে নোটিফাই করা হয়েছে। অফার আসলে "আমার অর্ডার" পেজে দেখতে পারবেন।</p>
      <a href="/my-orders" class="btn-go-orders">আমার অর্ডার দেখুন</a>
    </div>
  </div>
</div>

<style>
  .delivery-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 1000;
    align-items: flex-end;
    justify-content: center;
  }

  .delivery-modal-overlay.active {
    display: flex;
  }

  .delivery-modal {
    background: #fff;
    border-radius: 24px 24px 0 0;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px 20px 30px;
    position: relative;
    animation: slideUp 0.25s ease;
  }

  @media (min-width: 640px) {
    .delivery-modal-overlay {
      align-items: center;
    }
    .delivery-modal {
      border-radius: 24px;
    }
  }

  @keyframes slideUp {
    from { transform: translateY(40px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F8FAFC;
    border: none;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .delivery-modal-header {
    text-align: center;
    margin-bottom: 20px;
    padding-right: 20px;
  }

  .delivery-modal-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin: 0 auto 10px;
  }

  .delivery-modal-header h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1B2A4A;
    margin-bottom: 6px;
  }

  .delivery-modal-header p {
    font-size: 0.8rem;
    color: #5A6E85;
    line-height: 1.5;
  }

  .form-group {
    margin-bottom: 14px;
  }

  .form-group label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 6px;
  }

  .form-group select,
  .form-group input,
  .form-group textarea {
    width: 100%;
    border: 1px solid #E5EAF0;
    border-radius: 12px;
    padding: 11px 14px;
    font-size: 0.86rem;
    font-family: inherit;
    outline: none;
    color: #1B2A4A;
    background: #fff;
  }

  .form-group select:focus,
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #FF6B35;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 60px;
  }

  .vehicle-pills {
    display: flex;
    gap: 8px;
  }

  .vehicle-pill {
    flex: 1;
    border: 1px solid #E5EAF0;
    background: #fff;
    color: #5A6E85;
    padding: 9px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .vehicle-pill.active {
    background: #FFF0EA;
    border-color: #FF6B35;
    color: #FF6B35;
  }

  .form-error {
    color: #D14343;
    font-size: 0.8rem;
    margin-bottom: 10px;
    text-align: center;
  }

  .btn-submit-request {
    width: 100%;
    background: #FF6B35;
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 40px;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
  }

  .btn-submit-request:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .delivery-success-state {
    text-align: center;
    padding: 20px 10px;
  }

  .success-icon-badge {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #EAFBF0;
    color: #1B7A3C;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin: 0 auto 14px;
  }

  .delivery-success-state h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1B2A4A;
    margin-bottom: 8px;
  }

  .delivery-success-state p {
    font-size: 0.82rem;
    color: #5A6E85;
    margin-bottom: 18px;
    line-height: 1.5;
  }

  .btn-go-orders {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.86rem;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { createDeliveryRequest } from '../../lib/deliveryClient.js';

  const overlay = document.getElementById('deliveryRequestOverlay');
  const form = document.getElementById('deliveryRequestForm');
  const successState = document.getElementById('drSuccessState');
  const errorEl = document.getElementById('drError');
  const submitBtn = document.getElementById('drSubmitBtn');
  const vehicleInput = document.getElementById('drVehicleType');
  const vehiclePills = document.querySelectorAll('.vehicle-pill');

  function resetModal() {
    form.style.display = 'flex';
    form.reset();
    successState.style.display = 'none';
    errorEl.style.display = 'none';
    vehiclePills.forEach((p) => p.classList.remove('active'));
    vehiclePills[0]?.classList.add('active');
    vehicleInput.value = 'any';
  }

  window.openDeliveryRequestModal = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      return;
    }
    resetModal();
    overlay.classList.add('active');
  };

  document.getElementById('closeDeliveryRequestBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('active');
  });

  vehiclePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      vehiclePills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      vehicleInput.value = pill.dataset.vehicle;
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> পাঠানো হচ্ছে...';

    const upazila = document.getElementById('drUpazila').value;
    const areaDetail = document.getElementById('drAreaDetail').value.trim();
    const description = document.getElementById('drDescription').value.trim();
    const vehicleType = vehicleInput.value;
    const initialPrice = document.getElementById('drPrice').value;

    const { error } = await createDeliveryRequest({ upazila, areaDetail, description, vehicleType, initialPrice });

    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';

    if (error) {
      errorEl.textContent = error;
      errorEl.style.display = 'block';
      return;
    }

    form.style.display = 'none';
    successState.style.display = 'block';
  });
</script>