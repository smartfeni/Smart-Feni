---
// ============================================================
// কম্পোনেন্ট: "ডেলিভারি হিরো হতে চাই" আবেদন মডাল
// courier.astু ও প্রোফাইল পেজ — দুই জায়গাতেই বসবে (window.openRiderRegisterModal)
// ছবি ও আইডি কার্ডের ছবি সরাসরি এই মডাল থেকে Supabase Storage এর
// "rider-verification" bucket এ আপলোড হয় (path: {user_id}/photo-xxx.jpg,
// {user_id}/id-card-xxx.jpg — RLS ফোল্ডার-নেম চেক অনুযায়ী), তারপর
// rider-register API কল করে URL গুলো সেভ করা হয়।
// ============================================================
---

<div class="rider-modal-overlay" id="riderRegisterOverlay">
  <div class="rider-modal">
    <button class="modal-close-btn" id="closeRiderRegisterBtn" type="button" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <div class="rider-modal-header">
      <span class="rider-modal-icon"><i class="fas fa-motorcycle"></i></span>
      <h2>ডেলিভারি হিরো হতে চাই</h2>
      <p>ফ্রিল্যান্স রাইডার হিসেবে যুক্ত হয়ে নিজের সময়মতো ডেলিভারি করে আয় করুন। আবেদনের পর এডমিন যাচাই করে ২৪-৪৮ ঘণ্টার মধ্যে অনুমোদন দিবে।</p>
    </div>

    <form id="riderRegisterForm" class="rider-modal-form">
      <div class="form-group">
        <label>বাহনের ধরন</label>
        <div class="vehicle-pills">
          <button type="button" class="vehicle-pill active" data-vehicle="bike">বাইক</button>
          <button type="button" class="vehicle-pill" data-vehicle="cycle">সাইকেল</button>
        </div>
        <input type="hidden" id="rrVehicleType" value="bike" />
      </div>

      <div class="form-group">
        <label>নিজের ছবি</label>
        <div class="upload-box" id="photoUploadBox">
          <input type="file" accept="image/*" id="rrPhotoInput" />
          <div class="upload-placeholder" id="photoPlaceholder">
            <i class="fas fa-camera"></i>
            <span>ছবি আপলোড করুন</span>
          </div>
          <img id="photoPreview" style="display:none;" />
        </div>
      </div>

      <div class="form-group">
        <label>আইডি কার্ডের ছবি (NID)</label>
        <div class="upload-box" id="idCardUploadBox">
          <input type="file" accept="image/*" id="rrIdCardInput" />
          <div class="upload-placeholder" id="idCardPlaceholder">
            <i class="fas fa-id-card"></i>
            <span>আইডি কার্ডের ছবি আপলোড করুন</span>
          </div>
          <img id="idCardPreview" style="display:none;" />
        </div>
      </div>

      <p class="form-error" id="rrError" style="display:none;"></p>

      <button type="submit" class="btn-submit-rider" id="rrSubmitBtn">
        <i class="fas fa-paper-plane"></i> আবেদন জমা দিন
      </button>
    </form>

    <div class="rider-success-state" id="rrSuccessState" style="display:none;">
      <div class="success-icon-badge"><i class="fas fa-check"></i></div>
      <h3>আবেদন জমা হয়েছে!</h3>
      <p>এডমিন যাচাই করার পর তোমাকে জানানো হবে। অনুমোদন পেলেই ওপেন রিকোয়েস্টে অংশ নিতে পারবে।</p>
      <button type="button" class="btn-close-success" id="rrCloseSuccessBtn">ঠিক আছে</button>
    </div>

    <div class="rider-already-state" id="rrAlreadyState" style="display:none;">
      <div class="already-icon-badge"><i class="fas fa-info"></i></div>
      <p id="rrAlreadyMessage"></p>
      <button type="button" class="btn-close-success" id="rrCloseAlreadyBtn">ঠিক আছে</button>
    </div>
  </div>
</div>

<style>
  .rider-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 1000;
    align-items: flex-end;
    justify-content: center;
  }

  .rider-modal-overlay.active {
    display: flex;
  }

  .rider-modal {
    background: #fff;
    border-radius: 24px 24px 0 0;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px 20px 30px;
    position: relative;
    animation: slideUp 0.25s ease;
  }

  @media (min-width: 640px) {
    .rider-modal-overlay {
      align-items: center;
    }
    .rider-modal {
      border-radius: 24px;
    }
  }

  @keyframes slideUp {
    from { transform: translateY(40px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F8FAFC;
    border: none;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rider-modal-header {
    text-align: center;
    margin-bottom: 20px;
    padding-right: 20px;
  }

  .rider-modal-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin: 0 auto 10px;
  }

  .rider-modal-header h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1B2A4A;
    margin-bottom: 6px;
  }

  .rider-modal-header p {
    font-size: 0.8rem;
    color: #5A6E85;
    line-height: 1.5;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 8px;
  }

  .vehicle-pills {
    display: flex;
    gap: 8px;
  }

  .vehicle-pill {
    flex: 1;
    border: 1px solid #E5EAF0;
    background: #fff;
    color: #5A6E85;
    padding: 9px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .vehicle-pill.active {
    background: #FFF0EA;
    border-color: #FF6B35;
    color: #FF6B35;
  }

  .upload-box {
    position: relative;
    border: 1.5px dashed #E5EAF0;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #F8FAFC;
  }

  .upload-box input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .upload-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: #9AA8BC;
  }

  .upload-placeholder i {
    font-size: 1.4rem;
  }

  .upload-placeholder span {
    font-size: 0.78rem;
    font-weight: 600;
  }

  .upload-box img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .form-error {
    color: #D14343;
    font-size: 0.8rem;
    margin-bottom: 10px;
    text-align: center;
  }

  .btn-submit-rider {
    width: 100%;
    background: #FF6B35;
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 40px;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
  }

  .btn-submit-rider:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .rider-success-state,
  .rider-already-state {
    text-align: center;
    padding: 20px 10px;
  }

  .success-icon-badge,
  .already-icon-badge {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin: 0 auto 14px;
  }

  .success-icon-badge {
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .already-icon-badge {
    background: #EAF2FF;
    color: #2563EB;
  }

  .rider-success-state h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1B2A4A;
    margin-bottom: 8px;
  }

  .rider-success-state p,
  .rider-already-state p {
    font-size: 0.82rem;
    color: #5A6E85;
    margin-bottom: 18px;
    line-height: 1.5;
  }

  .btn-close-success {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    border: none;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.86rem;
    cursor: pointer;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { registerRider } from '../../lib/deliveryClient.js';

  const overlay = document.getElementById('riderRegisterOverlay');
  const form = document.getElementById('riderRegisterForm');
  const successState = document.getElementById('rrSuccessState');
  const alreadyState = document.getElementById('rrAlreadyState');
  const alreadyMessage = document.getElementById('rrAlreadyMessage');
  const errorEl = document.getElementById('rrError');
  const submitBtn = document.getElementById('rrSubmitBtn');
  const vehicleInput = document.getElementById('rrVehicleType');
  const vehiclePills = document.querySelectorAll('.vehicle-pill');

  const photoInput = document.getElementById('rrPhotoInput');
  const photoPreview = document.getElementById('photoPreview');
  const photoPlaceholder = document.getElementById('photoPlaceholder');
  const idCardInput = document.getElementById('rrIdCardInput');
  const idCardPreview = document.getElementById('idCardPreview');
  const idCardPlaceholder = document.getElementById('idCardPlaceholder');

  let photoFile = null;
  let idCardFile = null;

  function resetModal() {
    form.style.display = 'flex';
    form.reset();
    successState.style.display = 'none';
    alreadyState.style.display = 'none';
    errorEl.style.display = 'none';
    vehiclePills.forEach((p) => p.classList.remove('active'));
    vehiclePills[0]?.classList.add('active');
    vehicleInput.value = 'bike';
    photoFile = null;
    idCardFile = null;
    photoPreview.style.display = 'none';
    photoPlaceholder.style.display = 'flex';
    idCardPreview.style.display = 'none';
    idCardPlaceholder.style.display = 'flex';
  }

  window.openRiderRegisterModal = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      return;
    }
    resetModal();
    overlay.classList.add('active');
  };

  document.getElementById('closeRiderRegisterBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('active');
  });

  document.getElementById('rrCloseSuccessBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  document.getElementById('rrCloseAlreadyBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  vehiclePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      vehiclePills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      vehicleInput.value = pill.dataset.vehicle;
    });
  });

  photoInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    photoFile = file;
    photoPreview.src = URL.createObjectURL(file);
    photoPreview.style.display = 'block';
    photoPlaceholder.style.display = 'none';
  });

  idCardInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    idCardFile = file;
    idCardPreview.src = URL.createObjectURL(file);
    idCardPreview.style.display = 'block';
    idCardPlaceholder.style.display = 'none';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';

    if (!photoFile || !idCardFile) {
      errorEl.textContent = 'নিজের ছবি ও আইডি কার্ডের ছবি দুটোই আপলোড করতে হবে';
      errorEl.style.display = 'block';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> আপলোড হচ্ছে...';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> আবেদন জমা দিন';
      return;
    }

    const userId = session.user.id;

    try {
      const photoPath = `${userId}/photo-${Date.now()}-${photoFile.name}`;
      const { error: photoUploadError } = await supabase.storage
        .from('rider-verification')
        .upload(photoPath, photoFile);

      if (photoUploadError) throw new Error('ছবি আপলোড ব্যর্থ: ' + photoUploadError.message);

      const idCardPath = `${userId}/id-card-${Date.now()}-${idCardFile.name}`;
      const { error: idCardUploadError } = await supabase.storage
        .from('rider-verification')
        .upload(idCardPath, idCardFile);

      if (idCardUploadError) throw new Error('আইডি কার্ড আপলোড ব্যর্থ: ' + idCardUploadError.message);

      const { data: photoUrlData } = supabase.storage.from('rider-verification').getPublicUrl(photoPath);
      const { data: idCardUrlData } = supabase.storage.from('rider-verification').getPublicUrl(idCardPath);

      const { data, error } = await registerRider({
        vehicleType: vehicleInput.value,
        photoUrl: photoUrlData.publicUrl,
        idCardPhotoUrl: idCardUrlData.publicUrl,
      });

      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> আবেদন জমা দিন';

      if (error) {
        // আগে থেকে আবেদন করা থাকলে ভিন্ন স্টেট দেখানো
        if (error.includes('ইতিমধ্যে') || error.includes('পর্যালোচনাধীন') || error.includes('বাতিল')) {
          form.style.display = 'none';
          alreadyMessage.textContent = error;
          alreadyState.style.display = 'block';
          return;
        }
        errorEl.textContent = error;
        errorEl.style.display = 'block';
        return;
      }

      form.style.display = 'none';
      successState.style.display = 'block';
    } catch (err) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> আবেদন জমা দিন';
      errorEl.textContent = err.message;
      errorEl.style.display = 'block';
    }
  });
</script>