---
// ============================================================
// কম্পোনেন্ট: রাইড হিরো কার্ড — CTA + ফর্ম একসাথে মার্জড
// DeliveryHeroCard.astro-র প্যাটার্ন অনুসরণ করে বানানো, কিন্তু
// আলাদা রঙ (নেভি গ্র্যাডিয়েন্ট) দিয়ে ডেলিভারি হিরো থেকে ভিজ্যুয়ালি
// আলাদা রাখা হয়েছে — Ride Hero স্বতন্ত্র ক্যাটাগরি, "Smart Hero"
// নামের কোনো শেয়ার্ড ব্র্যান্ডিং নাই।
// লগইন না থাকলে ফর্ম দেখানোর আগে AuthModal খুলবে।
// ============================================================

const upazilaList = [
  'ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী',
];

import LocationPicker from './LocationPicker.astro';
---

<section class="rh-section">
  <div class="container">
    <div class="rh-card">
      <span class="rh-badge"><i class="fas fa-bolt"></i> নতুন</span>
      <h2 class="rh-title">রাইড হিরো</h2>
      <p class="rh-subtitle">দাম বলুন, ভেরিফাইড রাইড হিরোরা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

      <form id="rhForm" class="rh-form">
        <div class="rh-field">
          <label>উপজেলা</label>
          <select id="rhUpazila" required>
            <option value="" disabled selected>সিলেক্ট করুন</option>
            {upazilaList.map((u) => <option value={u}>{u}</option>)}
          </select>
        </div>

        <div class="rh-location-card">
          <LocationPicker id="pickup" label="পিকআপ লোকেশন (আপনি কোথায় আছেন)" allowAutoLocate={true} placeholder="যেমন: ফেনী সদর বাসস্ট্যান্ড" />
        </div>
        <div class="rh-location-card">
          <LocationPicker id="drop" label="কোথায় যেতে চান (গন্তব্য)" allowAutoLocate={false} placeholder="যেমন: ফেনী কলেজ রোড" />
        </div>

        <div class="rh-field">
          <label>সিট সংখ্যা</label>
          <input type="number" id="rhSeatCount" placeholder="যেমন: ১" min="1" max="4" value="1" required />
        </div>

        <div class="rh-field">
          <label>অতিরিক্ত মন্তব্য <span>(ঐচ্ছিক)</span></label>
          <textarea id="rhDescription" placeholder="বিশেষ কিছু জানানোর থাকলে লিখুন"></textarea>
        </div>

        <div class="rh-field">
          <label>বাহনের ধরন</label>
          <div class="rh-vehicle-row">
            <button type="button" class="rh-vehicle-btn active" data-vehicle="any">যেকোনো</button>
            <button type="button" class="rh-vehicle-btn" data-vehicle="bike">বাইক</button>
            <button type="button" class="rh-vehicle-btn" data-vehicle="cng">সিএনজি</button>
          </div>
          <input type="hidden" id="rhVehicleType" value="any" />
        </div>

        <div class="rh-field">
          <label>আপনার প্রস্তাবিত মূল্য (৳)</label>
          <input type="number" id="rhPrice" placeholder="যেমন: ১০০" min="1" required />
        </div>

        <p class="rh-error" id="rhError" style="display:none;"></p>

        <button type="submit" class="rh-submit-btn" id="rhSubmitBtn">
          <i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান
        </button>
      </form>

      <div class="rh-success" id="rhSuccess" style="display:none;">
        <div class="rh-success-icon"><i class="fas fa-check"></i></div>
        <h3>রিকোয়েস্ট পাঠানো হয়েছে!</h3>
        <p>সব রাইড হিরোকে নোটিফাই করা হয়েছে। অফার আসলে "আমার অর্ডার" এ দেখতে পারবেন।</p>
        <a href="/my-orders" class="rh-orders-link">আমার অর্ডার দেখুন</a>
      </div>
    </div>
  </div>
</section>

<style>
  .rh-section {
    padding: 24px 0;
    background: #fff;
  }

  .rh-card {
    background: linear-gradient(160deg, #1B2A4A, #2E4470);
    border-radius: 24px;
    padding: 28px 22px 32px;
    box-shadow: 0 16px 32px rgba(27, 42, 74, 0.28);
    max-width: 480px;
    margin: 0 auto;
  }

  .rh-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .rh-title {
    color: #fff;
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .rh-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.84rem;
    line-height: 1.5;
    margin-bottom: 22px;
  }

  .rh-form {
    display: flex;
    flex-direction: column;
  }

  .rh-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
  }

  .rh-field label {
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .rh-field label span {
    font-weight: 400;
    color: rgba(255, 255, 255, 0.65);
  }

  .rh-field select,
  .rh-field input,
  .rh-field textarea {
    width: 100%;
    border: none;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.86rem;
    font-family: inherit;
    outline: none;
    color: #1B2A4A;
    background: #fff;
    box-sizing: border-box;
  }

  .rh-field textarea {
    resize: vertical;
    min-height: 48px;
  }

  .rh-location-card {
    background: rgba(255, 255, 255, 0.94);
    border-radius: 16px;
    padding: 14px 14px 4px;
    margin-bottom: 14px;
  }

  .rh-location-card :global(.lp-wrap) {
    margin-bottom: 0;
  }

  .rh-vehicle-row {
    display: flex;
    gap: 8px;
  }

  .rh-vehicle-btn {
    flex: 1;
    border: none;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    padding: 10px 6px;
    border-radius: 12px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .rh-vehicle-btn.active {
    background: #fff;
    color: #1B2A4A;
  }

  .rh-error {
    background: rgba(255, 255, 255, 0.92);
    color: #D14343;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 10px;
    margin-bottom: 12px;
    text-align: center;
  }

  .rh-submit-btn {
    width: 100%;
    background: #fff;
    color: #1B2A4A;
    border: none;
    padding: 14px;
    border-radius: 40px;
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
  }

  .rh-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .rh-success {
    text-align: center;
    padding: 10px 4px;
  }

  .rh-success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: #1B7A3C;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin: 0 auto 14px;
  }

  .rh-success h3 {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .rh-success p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.82rem;
    line-height: 1.5;
    margin-bottom: 18px;
  }

  .rh-orders-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #1B2A4A;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.86rem;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { createServiceRequest } from '../../lib/deliveryClient.js';

  const form = document.getElementById('rhForm');
  const successEl = document.getElementById('rhSuccess');
  const errorEl = document.getElementById('rhError');
  const submitBtn = document.getElementById('rhSubmitBtn');
  const vehicleInput = document.getElementById('rhVehicleType');
  const vehicleButtons = document.querySelectorAll('.rh-vehicle-btn');

  vehicleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      vehicleButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      vehicleInput.value = btn.dataset.vehicle;
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> পাঠানো হচ্ছে...';

    const upazila = document.getElementById('rhUpazila').value;
    const seatCount = document.getElementById('rhSeatCount').value;
    const descriptionRaw = document.getElementById('rhDescription').value.trim();
    const description = descriptionRaw || 'রাইড রিকোয়েস্ট';
    const vehicleType = vehicleInput.value;
    const askingPrice = document.getElementById('rhPrice').value;

    const pickupWrap = document.querySelector('[data-lp-id="pickup"]');
    const dropWrap = document.querySelector('[data-lp-id="drop"]');

    const pickupAddress = pickupWrap.querySelector('.lp-out-address').value;
    const pickupLat = pickupWrap.querySelector('.lp-out-lat').value;
    const pickupLng = pickupWrap.querySelector('.lp-out-lng').value;
    const pickupInstructions = pickupWrap.querySelector('.lp-out-instructions').value;

    const dropAddress = dropWrap.querySelector('.lp-out-address').value;
    const dropLat = dropWrap.querySelector('.lp-out-lat').value;
    const dropLng = dropWrap.querySelector('.lp-out-lng').value;
    const dropInstructions = dropWrap.querySelector('.lp-out-instructions').value;

    if (!pickupAddress || !dropAddress) {
      errorEl.textContent = 'পিকআপ ও গন্তব্য দুটোই দিতে হবে';
      errorEl.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';
      return;
    }

    const { error } = await createServiceRequest({
      category: 'ride',
      upazila,
      pickupAddress,
      pickupLat: pickupLat || null,
      pickupLng: pickupLng || null,
      pickupInstructions,
      dropAddress,
      dropLat: dropLat || null,
      dropLng: dropLng || null,
      dropInstructions,
      description,
      vehicleType,
      seatCount,
      askingPrice,
    });

    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';

    if (error) {
      errorEl.textContent = error;
      errorEl.style.display = 'block';
      return;
    }

    form.style.display = 'none';
    successEl.style.display = 'block';
  });
</script>