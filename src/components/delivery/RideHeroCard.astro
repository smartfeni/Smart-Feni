---
// ============================================================
// কম্পোনেন্ট: রাইড হিরো কার্ড — CTA + ফর্ম একসাথে মার্জড
// DeliveryHeroCard.astro-র প্যাটার্ন অনুসরণ করে বানানো, কিন্তু
// আলাদা রঙ (নেভি গ্র্যাডিয়েন্ট) দিয়ে ডেলিভারি হিরো থেকে ভিজ্যুয়ালি
// আলাদা রাখা হয়েছে — Ride Hero স্বতন্ত্র ক্যাটাগরি, "Smart Hero"
// নামের কোনো শেয়ার্ড ব্র্যান্ডিং নাই।
// লগইন না থাকলে ফর্ম দেখানোর আগে AuthModal খুলবে।
//
// আপডেট (রাইডার অ্যাভেইলেবিলিটি): উপজেলা অনুযায়ী অনলাইন রাইডার না
// থাকলে ফর্মের উপরে NoRiderNotice (WhatsApp সহ) দেখায় এবং সাবমিট বন্ধ
// রাখে। পুরো ফেনীতে কেউ অনলাইনে না থাকলে ফর্মটাই লুকিয়ে যায়।
//
// আপডেট (নতুন UI): সাদা কার্ড, রুট (পিকআপ → ড্রপ) ডটেড লাইনে, দামে বড় +/−
// স্টেপার ও +৫/+১০/+২০ বাটন, বাহনের চিপ। সব স্টাইল src/styles/hero-ui.css এ।
// ফর্মের আইডি/ক্লাস যা JS ও riderAvailability ব্যবহার করে সেগুলো আগের মতোই।
// ============================================================

const upazilaList = [
  'ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী',
];

import LocationPicker from './LocationPicker.astro';
import NoRiderNotice from './NoRiderNotice.astro';
import '../../styles/hero-ui.css';
---

<section class="hu-form-section">
  <div class="container">
    <div class="hu-formcard">
      <div class="hu-formhead">
        <span class="hu-formicon"><i class="fas fa-motorcycle"></i></span>
        <h2 class="hu-title">রাইড হিরো</h2>
      </div>
      <p class="hu-sub">দাম বলুন, ভেরিফাইড রাইড হিরোরা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

      <NoRiderNotice id="rh" category="ride" />

      <form id="rhForm" class="hu-form" novalidate>
        <div class="hu-field">
          <label>উপজেলা<span class="required-mark">*</span></label>
          <select id="rhUpazila" required>
            <option value="" disabled selected>সিলেক্ট করুন</option>
            {upazilaList.map((u) => <option value={u}>{u}</option>)}
          </select>
          <div class="field-error-msg" data-error-for="rhUpazila">
            <i class="fas fa-circle-exclamation"></i><span>উপজেলা সিলেক্ট করুন</span>
          </div>
        </div>

        <div class="hu-route">
          <div class="hu-route-card">
            <LocationPicker id="pickup" label="পিকআপ লোকেশন (আপনি কোথায় আছেন)" allowAutoLocate={true} placeholder="যেমন: ফেনী সদর বাসস্ট্যান্ড" />
          </div>
          <div class="hu-route-card drop">
            <LocationPicker id="drop" label="কোথায় যেতে চান (গন্তব্য)" allowAutoLocate={false} placeholder="যেমন: ফেনী কলেজ রোড" />
          </div>
        </div>

        <div class="hu-field">
          <label>সিট সংখ্যা<span class="required-mark">*</span></label>
          <div class="hu-stepper">
            <button type="button" data-seat-step="-1" aria-label="সিট কমান">−</button>
            <input type="number" id="rhSeatCount" placeholder="১" min="1" max="4" value="1" required />
            <button type="button" data-seat-step="1" aria-label="সিট বাড়ান">+</button>
          </div>
          <div class="field-error-msg" data-error-for="rhSeatCount">
            <i class="fas fa-circle-exclamation"></i><span>সিট সংখ্যা দিন</span>
          </div>
        </div>

        <div class="hu-field">
          <label>অতিরিক্ত মন্তব্য <span>(ঐচ্ছিক)</span></label>
          <textarea id="rhDescription" placeholder="বিশেষ কিছু জানানোর থাকলে লিখুন"></textarea>
        </div>

        <div class="hu-field">
          <label>বাহনের ধরন</label>
          <div class="hu-chips">
            <button type="button" class="hu-chip rh-vehicle-btn active" data-vehicle="any">যেকোনো</button>
            <button type="button" class="hu-chip rh-vehicle-btn" data-vehicle="bike">বাইক</button>
            <button type="button" class="hu-chip rh-vehicle-btn" data-vehicle="cng">সিএনজি</button>
          </div>
          <input type="hidden" id="rhVehicleType" value="any" />
        </div>

        <div class="hu-field">
          <label>আপনার প্রস্তাবিত মূল্য<span class="required-mark">*</span></label>
          <div class="hu-stepper">
            <button type="button" data-price-step="-10" aria-label="১০ টাকা কমান">−</button>
            <span class="hu-cur">৳</span>
            <input type="number" id="rhPrice" placeholder="যেমন: ১০০" min="1" required />
            <button type="button" data-price-step="10" aria-label="১০ টাকা বাড়ান">+</button>
          </div>
          <div class="hu-quick">
            <button type="button" data-price-step="5">+৫</button>
            <button type="button" data-price-step="10">+১০</button>
            <button type="button" data-price-step="20">+২০</button>
          </div>
          <div class="field-error-msg" data-error-for="rhPrice">
            <i class="fas fa-circle-exclamation"></i><span>প্রস্তাবিত মূল্য দিন</span>
          </div>
        </div>

        <p class="hu-error" id="rhError" style="display:none;"></p>

        <button type="submit" class="hu-submit" id="rhSubmitBtn">
          <i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান
        </button>
      </form>

      <div class="hu-success" id="rhSuccess" style="display:none;">
        <div class="hu-success-icon"><i class="fas fa-check"></i></div>
        <h3>রিকোয়েস্ট পাঠানো হয়েছে!</h3>
        <p>সব রাইড হিরোকে নোটিফাই করা হয়েছে। অফার আসলে "আমার অর্ডার" এ দেখতে পারবেন।</p>
        <a href="/my-orders" class="hu-orders-link">আমার অর্ডার দেখুন</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { createServiceRequest } from '../../lib/deliveryClient.js';
  import { initRiderAvailability } from '../../lib/riderAvailability.js';

  const form = document.getElementById('rhForm');
  const successEl = document.getElementById('rhSuccess');
  const errorEl = document.getElementById('rhError');
  const submitBtn = document.getElementById('rhSubmitBtn');
  const vehicleInput = document.getElementById('rhVehicleType');
  const vehicleButtons = document.querySelectorAll('.rh-vehicle-btn');

  vehicleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      vehicleButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      vehicleInput.value = btn.dataset.vehicle;
    });
  });

  // উপজেলা অনুযায়ী অনলাইন রাইডার চেক — রাইডার না থাকলে নোটিশ দেখায়
  // ও সাবমিট বন্ধ রাখে (সার্ভারেও একই চেক আছে: create-request API)
  const availability = initRiderAvailability({
    category: 'ride',
    root: document.getElementById('rhNotice'),
    form,
    upazilaSelect: document.getElementById('rhUpazila'),
    vehicleInput,
    vehicleButtons,
    submitBtn,
  });

  function releaseSubmit() {
    delete submitBtn.dataset.busy;
    submitBtn.disabled = false;
    availability.apply();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      return;
    }

    if (!window.SFValidateForm(form)) {
      return;
    }

    submitBtn.dataset.busy = '1';
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> পাঠানো হচ্ছে...';

    const upazila = document.getElementById('rhUpazila').value;
    const seatCount = document.getElementById('rhSeatCount').value;
    const descriptionRaw = document.getElementById('rhDescription').value.trim();
    const description = descriptionRaw || 'রাইড রিকোয়েস্ট';
    const vehicleType = vehicleInput.value;
    const askingPrice = document.getElementById('rhPrice').value;

    const pickupWrap = document.querySelector('[data-lp-id="pickup"]');
    const dropWrap = document.querySelector('[data-lp-id="drop"]');

    const pickupAddress = pickupWrap.querySelector('.lp-out-address').value;
    const pickupLat = pickupWrap.querySelector('.lp-out-lat').value;
    const pickupLng = pickupWrap.querySelector('.lp-out-lng').value;
    const pickupInstructions = pickupWrap.querySelector('.lp-out-instructions').value;

    const dropAddress = dropWrap.querySelector('.lp-out-address').value;
    const dropLat = dropWrap.querySelector('.lp-out-lat').value;
    const dropLng = dropWrap.querySelector('.lp-out-lng').value;
    const dropInstructions = dropWrap.querySelector('.lp-out-instructions').value;

    if (!pickupAddress || !dropAddress) {
      errorEl.textContent = 'পিকআপ ও গন্তব্য দুটোই দিতে হবে';
      errorEl.style.display = 'block';
      releaseSubmit();
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';
      return;
    }

    const { error, code } = await createServiceRequest({
      category: 'ride',
      upazila,
      pickupAddress,
      pickupLat: pickupLat || null,
      pickupLng: pickupLng || null,
      pickupInstructions,
      dropAddress,
      dropLat: dropLat || null,
      dropLng: dropLng || null,
      dropInstructions,
      description,
      vehicleType,
      seatCount,
      askingPrice,
    });

    releaseSubmit();
    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';

    if (error) {
      errorEl.textContent = error;
      errorEl.style.display = 'block';
      if (code === 'NO_RIDER_ONLINE') availability.refresh();
      return;
    }

    form.dataset.done = '1';
    form.style.display = 'none';
    successEl.style.display = 'block';
  });

  // ============ স্টেপার বাটন (দাম/সিট) ============
  // +/− ও +৫/+১০/+২০ বাটনে ইনপুটের মান বদলায়; ভ্যালিডেশন আগের মতোই ইনপুটের মান দেখে
  const priceInput = document.getElementById('rhPrice');
  document.querySelectorAll('[data-price-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = Number(priceInput.value) || 0;
      const next = Math.max(1, current + Number(btn.dataset.priceStep));
      priceInput.value = String(next);
      priceInput.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });

  const seatInput = document.getElementById('rhSeatCount');
  document.querySelectorAll('[data-seat-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = Number(seatInput.value) || 1;
      const next = Math.min(4, Math.max(1, current + Number(btn.dataset.seatStep)));
      seatInput.value = String(next);
      seatInput.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });
</script>