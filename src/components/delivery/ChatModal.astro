---
// ============================================================
// কম্পোনেন্ট: ইন-অ্যাপ চ্যাট মোডাল (রিইউজেবল)
// ব্যবহার হবে: my-orders.astro (কাস্টমার সাইড), delivery-hero.astro ও
// ride-hero.astro (হিরো সাইড) — WhatsApp বাটনের বিকল্প হিসেবে।
//
// DisputeReasonModal.astro-র প্যাটার্ন অনুসরণ করে বানানো (bottom-sheet
// মোডাল, window.openXModal() গ্লোবাল ফাংশন দিয়ে খোলা)।
//
// ব্যবহারবিধি (কলিং পেজ থেকে):
//   <ChatModal />  ← পেজের যেকোনো জায়গায় একবার বসালেই হবে
//   window.openChatModal({ requestId: req.id, otherPartyName: 'করিম' });
//
// এডমিন রিভিউ মোডে (readOnly: true) কে কাস্টমার আর কে রাইডার বোঝানোর জন্য
// এই ঐচ্ছিক প্যারামিটারগুলোও দেওয়া যাবে:
//   customerId, customerName, riderId, riderName
// দিলে প্রতিটা মেসেজে নাম + "কাস্টমার"/"রাইডার" ট্যাগ ও আলাদা রঙ দেখাবে
// (কাস্টমার বাঁয়ে, রাইডার ডানে)। না দিলে আগের মতোই চলবে।
//
// চ্যাটে ছবিতে ট্যাপ করলে অ্যাপের ভেতরেই ফুলস্ক্রিন ভিউয়ার খোলে
// (ব্রাউজার খোলে না) — ভিউয়ারে ছবিতে ট্যাপ করলে জুম, বাইরে/✕ ট্যাপ করলে বন্ধ।
//
// মেসেজে গুগল ম্যাপ লিংক থাকলে নিচে "নেভিগেট করুন" বাটন আসে
// (src/lib/mapLinks.js), রাইডার ট্যাপ করলেই গুগল ম্যাপ খোলে।
//
// মেসেজ পাঠানো/পড়া সরাসরি chatClient.js দিয়ে (RLS-সুরক্ষিত), কোনো
// API endpoint লাগে না। নতুন মেসেজ এলে DB ট্রিগার অটো নোটিফিকেশন
// পাঠিয়ে দেয়, তাই এখানে আলাদা করে কিছু করা লাগছে না।
// ============================================================
---

<div class="cm-overlay" id="cmOverlay">
  <div class="cm-modal">
    <div class="cm-header">
      <div class="cm-header-info">
        <div class="cm-header-avatar"><i class="fas fa-user"></i></div>
        <div>
          <p class="cm-header-name" id="cmOtherName">চ্যাট</p>
          <p class="cm-header-sub" id="cmHeaderSub">সরাসরি মেসেজ</p>
        </div>
      </div>
      <button class="cm-close" id="cmClose" type="button" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="cm-legend" id="cmLegend" style="display:none;"></div>

    <div class="cm-messages" id="cmMessages">
      <p class="cm-loading" id="cmLoading">লোড হচ্ছে...</p>
    </div>

    <div class="cm-input-row" id="cmInputRow">
      <input type="file" id="cmCameraInput" accept="image/*" capture="environment" hidden />
      <input type="file" id="cmGalleryInput" accept="image/*" hidden />
      <button class="cm-icon-btn" id="cmCameraBtn" type="button" aria-label="ক্যামেরা">
        <i class="fas fa-camera"></i>
      </button>
      <button class="cm-icon-btn" id="cmGalleryBtn" type="button" aria-label="গ্যালারি">
        <i class="fas fa-image"></i>
      </button>
      <input type="text" id="cmInput" placeholder="মেসেজ লিখুন..." maxlength="500" />
      <button class="cm-send-btn" id="cmSendBtn" type="button" aria-label="পাঠান">
        <i class="fas fa-paper-plane"></i>
      </button>
    </div>
  </div>
</div>

<!-- ফুলস্ক্রিন ছবি ভিউয়ার (অ্যাপের ভেতরেই, ব্রাউজার ছাড়া) -->
<div class="cm-lb" id="cmLightbox" aria-hidden="true">
  <button class="cm-lb-close" id="cmLbClose" type="button" aria-label="বন্ধ করুন">
    <i class="fas fa-xmark"></i>
  </button>
  <div class="cm-lb-body" id="cmLbBody">
    <img id="cmLbImg" alt="ছবি" />
  </div>
  <p class="cm-lb-hint">জুম করতে ছবিতে ট্যাপ করুন</p>
</div>

<script>
  import { getChatMessages, sendChatMessage, markMessagesRead, subscribeToChatMessages, uploadChatImage } from '../../lib/chatClient.js';
  import { compressImage } from '../../lib/imageCompress.js';
  import { supabase } from '../../lib/supabase.js';
  import { isNativeApp, capturePhoto } from '../../lib/native-bridge.js';
  import { findMapLink, createNavButton } from '../../lib/mapLinks.js';

  const overlay = document.getElementById('cmOverlay');
  const closeBtn = document.getElementById('cmClose');
  const messagesEl = document.getElementById('cmMessages');
  const loadingEl = document.getElementById('cmLoading');
  const otherNameEl = document.getElementById('cmOtherName');
  const headerSubEl = document.getElementById('cmHeaderSub');
  const legendEl = document.getElementById('cmLegend');
  const inputEl = document.getElementById('cmInput');
  const sendBtn = document.getElementById('cmSendBtn');
  const cameraBtn = document.getElementById('cmCameraBtn');
  const galleryBtn = document.getElementById('cmGalleryBtn');
  const cameraInput = document.getElementById('cmCameraInput');
  const galleryInput = document.getElementById('cmGalleryInput');
  const inputRowEl = document.getElementById('cmInputRow');

  const lightboxEl = document.getElementById('cmLightbox');
  const lbImgEl = document.getElementById('cmLbImg');
  const lbBodyEl = document.getElementById('cmLbBody');
  const lbCloseEl = document.getElementById('cmLbClose');

  let activeRequestId = null;
  let currentUserId = null;
  let activeChannel = null;
  // এডমিন রিভিউ মোডের রোল তথ্য (না থাকলে null)
  let roleInfo = null;

  function formatTime(iso) {
    return new Date(iso).toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' });
  }

  // ---------- ছবি ভিউয়ার ----------
  function openLightbox(url) {
    if (!url) return;
    lbImgEl.classList.remove('zoomed');
    lbImgEl.src = url;
    lbBodyEl.scrollTop = 0;
    lbBodyEl.scrollLeft = 0;
    lightboxEl.classList.add('active');
    lightboxEl.setAttribute('aria-hidden', 'false');
  }

  function closeLightbox() {
    lightboxEl.classList.remove('active');
    lightboxEl.setAttribute('aria-hidden', 'true');
    lbImgEl.classList.remove('zoomed');
    lbImgEl.removeAttribute('src');
  }

  lbCloseEl?.addEventListener('click', closeLightbox);
  lightboxEl?.addEventListener('click', (e) => {
    // ছবির বাইরে (কালো জায়গায়) ট্যাপ করলে বন্ধ
    if (e.target === lightboxEl || e.target === lbBodyEl) closeLightbox();
  });
  lbImgEl?.addEventListener('click', () => {
    lbImgEl.classList.toggle('zoomed');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightboxEl?.classList.contains('active')) closeLightbox();
  });

  // ---------- মেসেজ রেন্ডার ----------
  // readOnly + roleInfo থাকলে sender_id দেখে 'customer' / 'rider' / null
  function getRole(msg) {
    if (!roleInfo) return null;
    if (roleInfo.customerId && msg.sender_id === roleInfo.customerId) return 'customer';
    if (roleInfo.riderId && msg.sender_id === roleInfo.riderId) return 'rider';
    return null;
  }

  function renderMessage(msg) {
    const role = getRole(msg);
    const bubble = document.createElement('div');

    if (roleInfo) {
      // এডমিন রিভিউ: কাস্টমার বাঁয়ে (সাদা), রাইডার ডানে (কমলা)
      bubble.className = `cm-msg ${role === 'rider' ? 'cm-msg-mine cm-role-rider' : 'cm-msg-theirs cm-role-customer'}`;
      const roleEl = document.createElement('span');
      roleEl.className = 'cm-msg-role';
      if (role === 'rider') {
        roleEl.textContent = `রাইডার${roleInfo.riderName ? ' · ' + roleInfo.riderName : ''}`;
      } else if (role === 'customer') {
        roleEl.textContent = `কাস্টমার${roleInfo.customerName ? ' · ' + roleInfo.customerName : ''}`;
      } else {
        roleEl.textContent = 'অজানা';
      }
      bubble.appendChild(roleEl);
    } else {
      const isMine = msg.sender_id === currentUserId;
      bubble.className = `cm-msg ${isMine ? 'cm-msg-mine' : 'cm-msg-theirs'}`;
    }

    if (msg.image_url) {
      const img = document.createElement('img');
      img.className = 'cm-msg-image';
      img.src = msg.image_url;
      img.alt = 'ছবি';
      img.addEventListener('click', () => openLightbox(msg.image_url));
      bubble.appendChild(img);
    }

    if (msg.message) {
      const textEl = document.createElement('p');
      textEl.className = 'cm-msg-text';
      textEl.textContent = msg.message;
      bubble.appendChild(textEl);

      // গুগল ম্যাপ লিংক থাকলে নেভিগেট বাটন
      const mapLink = findMapLink(msg.message);
      if (mapLink) {
        bubble.appendChild(createNavButton(mapLink));
      }
    }

    const timeEl = document.createElement('span');
    timeEl.className = 'cm-msg-time';
    timeEl.textContent = formatTime(msg.created_at);
    bubble.appendChild(timeEl);

    return bubble;
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function appendMessage(msg) {
    // খালি-অবস্থা টেক্সট থাকলে সরিয়ে দেওয়া
    messagesEl.querySelector('.cm-empty')?.remove();
    messagesEl.appendChild(renderMessage(msg));
    scrollToBottom();
  }

  function cleanupChannel() {
    if (activeChannel) {
      supabase.removeChannel(activeChannel);
      activeChannel = null;
    }
  }

  function closeModal() {
    closeLightbox();
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    cleanupChannel();
    activeRequestId = null;
    roleInfo = null;
  }

  function renderLegend() {
    if (!roleInfo) {
      legendEl.style.display = 'none';
      legendEl.innerHTML = '';
      return;
    }
    legendEl.innerHTML = '';
    const customerChip = document.createElement('span');
    customerChip.className = 'cm-legend-chip cm-legend-customer';
    customerChip.textContent = `কাস্টমার: ${roleInfo.customerName || '—'}`;
    const riderChip = document.createElement('span');
    riderChip.className = 'cm-legend-chip cm-legend-rider';
    riderChip.textContent = `রাইডার: ${roleInfo.riderName || '—'}`;
    legendEl.appendChild(customerChip);
    legendEl.appendChild(riderChip);
    legendEl.style.display = 'flex';
  }

  window.openChatModal = async function ({
    requestId,
    otherPartyName,
    readOnly = false,
    customerId = null,
    customerName = '',
    riderId = null,
    riderName = '',
  }) {
    if (!requestId) return;

    activeRequestId = requestId;
    otherNameEl.textContent = otherPartyName || 'চ্যাট';
    inputRowEl.style.display = readOnly ? 'none' : 'flex';
    headerSubEl.textContent = readOnly ? 'এডমিন রিভিউ (শুধু দেখা)' : 'সরাসরি মেসেজ';

    // রোল লেবেল শুধু readOnly মোডে এবং অন্তত একজনের id থাকলে
    roleInfo = readOnly && (customerId || riderId)
      ? { customerId, customerName, riderId, riderName }
      : null;
    renderLegend();

    messagesEl.innerHTML = '';
    loadingEl.style.display = 'block';
    messagesEl.appendChild(loadingEl);
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';

    const { data: { user } } = await supabase.auth.getUser();
    currentUserId = user?.id || null;

    const { data: messages, error } = await getChatMessages(requestId);
    loadingEl.style.display = 'none';
    messagesEl.innerHTML = '';

    if (error) {
      messagesEl.innerHTML = `<p class="cm-empty">মেসেজ লোড করা যায়নি</p>`;
    } else if (messages.length === 0) {
      messagesEl.innerHTML = `<p class="cm-empty">এখনো কোনো মেসেজ নেই${readOnly ? '' : ', প্রথম মেসেজ পাঠান!'}</p>`;
    } else {
      messages.forEach((msg) => messagesEl.appendChild(renderMessage(msg)));
      scrollToBottom();
    }

    // readOnly (এডমিন রিভিউ) মোডে মার্ক-রিড বা রিয়েলটাইম সাবস্ক্রিপশন
    // দরকার নাই — এডমিন শুধু ডিসপিউটের সময় একবার হিস্ট্রি দেখবে
    cleanupChannel();
    if (!readOnly) {
      markMessagesRead(requestId);
      activeChannel = subscribeToChatMessages(requestId, (newMsg) => {
        appendMessage(newMsg);
        if (newMsg.sender_id !== currentUserId) {
          markMessagesRead(requestId);
        }
      });
    }

    inputEl.value = '';
    if (!readOnly) inputEl.focus();
  };

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  closeBtn?.addEventListener('click', closeModal);

  async function handleSend() {
    const text = inputEl.value.trim();
    if (!text || !activeRequestId) return;

    inputEl.value = '';
    sendBtn.disabled = true;

    const { error } = await sendChatMessage(activeRequestId, text);

    sendBtn.disabled = false;
    if (error) {
      window.showToast?.(error, 'error');
      inputEl.value = text;
    }
    // সফল হলে appendMessage করার দরকার নাই — Realtime সাবস্ক্রিপশন
    // নিজে থেকেই এই মেসেজটা ফেরত পেয়ে দেখিয়ে দিবে (নিজেরটাও)
  }

  sendBtn?.addEventListener('click', handleSend);
  inputEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSend();
  });

  cameraBtn?.addEventListener('click', async () => {
    if (isNativeApp()) {
      try {
        const file = await capturePhoto('camera');
        await processImageFile(file);
      } catch (err) {
        // ইউজার ক্যামেরা বন্ধ করলে বা permission না দিলে নীরবে ইগনোর
      }
      return;
    }
    cameraInput.click();
  });

  galleryBtn?.addEventListener('click', async () => {
    if (isNativeApp()) {
      try {
        const file = await capturePhoto('gallery');
        await processImageFile(file);
      } catch (err) {
        // ইউজার গ্যালারি থেকে বাছাই বাতিল করলে নীরবে ইগনোর
      }
      return;
    }
    galleryInput.click();
  });

  async function processImageFile(file) {
    if (!file || !activeRequestId) return;

    cameraBtn.disabled = true;
    galleryBtn.disabled = true;

    const compressed = await compressImage(file, { maxDimension: 1600, quality: 0.8 });
    const { url, error: uploadError } = await uploadChatImage(activeRequestId, compressed);

    if (uploadError || !url) {
      window.showToast?.('ছবি আপলোড ব্যর্থ: ' + (uploadError || 'অজানা কারণ'), 'error');
      cameraBtn.disabled = false;
      galleryBtn.disabled = false;
      return;
    }

    const { error: sendError } = await sendChatMessage(activeRequestId, '', url);
    cameraBtn.disabled = false;
    galleryBtn.disabled = false;

    if (sendError) {
      window.showToast?.(sendError, 'error');
    }
    // সফল হলে Realtime সাবস্ক্রিপশন নিজে থেকেই মেসেজ দেখিয়ে দিবে
  }

  async function handleImageSelect(e) {
    const file = e.target.files?.[0];
    e.target.value = ''; // একই ছবি আবার সিলেক্ট করলেও change ইভেন্ট যেন ফায়ার হয়
    await processImageFile(file);
  }

  cameraInput?.addEventListener('change', handleImageSelect);
  galleryInput?.addEventListener('change', handleImageSelect);
</script>

<style is:global>
  .cm-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 1000;
    align-items: flex-end;
    justify-content: center;
  }

  .cm-overlay.active {
    display: flex;
  }

  .cm-modal {
    background: #fff;
    width: 100%;
    max-width: 460px;
    height: 78vh;
    border-radius: 24px 24px 0 0;
    display: flex;
    flex-direction: column;
    animation: cm-slide-up 0.25s ease;
    overflow: hidden;
  }

  @media (min-width: 560px) {
    .cm-overlay {
      align-items: center;
    }
    .cm-modal {
      border-radius: 24px;
      height: 70vh;
    }
  }

  @keyframes cm-slide-up {
    from { transform: translateY(24px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .cm-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1.5px solid #F0F2F6;
    flex-shrink: 0;
  }

  .cm-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .cm-header-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .cm-header-name {
    font-size: 0.92rem;
    font-weight: 800;
    color: #1B2A4A;
  }

  .cm-header-sub {
    font-size: 0.72rem;
    color: #8A97A8;
  }

  .cm-close {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #F4F7FC;
    color: #5A6E85;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  /* এডমিন রিভিউ: কে কাস্টমার, কে রাইডার — হেডারের নিচের লেজেন্ড */
  .cm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 8px 14px;
    background: #fff;
    border-bottom: 1.5px solid #F0F2F6;
    flex-shrink: 0;
  }

  .cm-legend-chip {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .cm-legend-customer {
    background: #E8EEF8;
    color: #1B2A4A;
  }

  .cm-legend-rider {
    background: #FFF0EA;
    color: #D9541F;
  }

  .cm-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #F8FAFC;
  }

  .cm-loading,
  .cm-empty {
    text-align: center;
    font-size: 0.82rem;
    color: #8A97A8;
    margin-top: 20px;
  }

  .cm-msg {
    max-width: 78%;
    padding: 9px 13px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cm-msg-mine {
    align-self: flex-end;
    background: #FF6B35;
    border-bottom-right-radius: 4px;
  }

  .cm-msg-mine .cm-msg-text {
    color: #fff;
  }

  .cm-msg-mine .cm-msg-time {
    color: rgba(255, 255, 255, 0.75);
    align-self: flex-end;
  }

  .cm-msg-theirs {
    align-self: flex-start;
    background: #fff;
    border: 1.5px solid #E5EAF0;
    border-bottom-left-radius: 4px;
  }

  .cm-msg-theirs .cm-msg-text {
    color: #1B2A4A;
  }

  .cm-msg-theirs .cm-msg-time {
    color: #A9B4C2;
