---
// ============================================================
// কম্পোনেন্ট: রাইডার প্রোফাইল মডাল (হালকা, ListingDetailModal এর
// মতো ভারী না) — courier.astro এর গ্রিড কার্ডে ক্লিক করলে খোলে
// নাম, vehicle type, rating, সম্পন্ন ডেলিভারি সংখ্যা, কল বাটন দেখায়
// ============================================================
---

<div class="rider-profile-overlay" id="riderProfileOverlay">
  <div class="rider-profile-modal">
    <button class="modal-close-btn" id="closeRiderProfileBtn" type="button" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <div class="rider-profile-avatar" id="rpAvatar">
      <i class="fas fa-motorcycle"></i>
    </div>

    <h3 class="rider-profile-name" id="rpName"></h3>
    <p class="rider-profile-vehicle" id="rpVehicle"></p>

    <div class="rider-profile-stats">
      <div class="rp-stat">
        <span class="rp-stat-value" id="rpCompleted">0</span>
        <span class="rp-stat-label">সম্পন্ন</span>
      </div>
      <div class="rp-stat">
        <span class="rp-stat-value" id="rpRating">—</span>
        <span class="rp-stat-label">রেটিং</span>
      </div>
    </div>

    <a href="#" id="rpCallBtn" class="btn-call-rider">
      <i class="fas fa-phone"></i> কল করুন
    </a>

    <p class="rider-profile-note">
      <i class="fas fa-circle-info"></i> নির্দিষ্ট ডেলিভারির জন্য "হোম ডেলিভারি" থেকে রিকোয়েস্ট করলে এই রাইডার অফার দিতে পারবেন
    </p>
  </div>
</div>

<style>
  .rider-profile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .rider-profile-overlay.active {
    display: flex;
  }

  .rider-profile-modal {
    background: #fff;
    border-radius: 24px;
    width: 100%;
    max-width: 340px;
    padding: 28px 24px 24px;
    position: relative;
    text-align: center;
    animation: popIn 0.2s ease;
  }

  @keyframes popIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .modal-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #F8FAFC;
    border: none;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rider-profile-avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.9rem;
    margin: 0 auto 14px;
    overflow: hidden;
  }

  .rider-profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rider-profile-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .rider-profile-vehicle {
    font-size: 0.82rem;
    color: #8FA0BC;
    margin-bottom: 18px;
  }

  .rider-profile-stats {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-bottom: 20px;
    padding: 14px 0;
    border-top: 1px dashed #E5EAF0;
    border-bottom: 1px dashed #E5EAF0;
  }

  .rp-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rp-stat-value {
    font-size: 1.2rem;
    font-weight: 800;
    color: #1B2A4A;
  }

  .rp-stat-label {
    font-size: 0.7rem;
    color: #9AA8BC;
    font-weight: 600;
  }

  .btn-call-rider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    text-decoration: none;
    padding: 13px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.88rem;
    box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
    margin-bottom: 14px;
  }

  .rider-profile-note {
    font-size: 0.72rem;
    color: #9AA8BC;
    line-height: 1.5;
  }

  .rider-profile-note i {
    color: #FF6B35;
  }
</style>

<script>
  const overlay = document.getElementById('riderProfileOverlay');

  function openRiderProfile(rider) {
    document.getElementById('rpName').textContent = rider.full_name || 'রাইডার';
    document.getElementById('rpVehicle').textContent = rider.vehicle_type === 'bike' ? 'বাইক' : 'সাইকেল';
    document.getElementById('rpCompleted').textContent = rider.total_completed || 0;
    document.getElementById('rpRating').textContent = rider.avg_rating ? `${rider.avg_rating} ★` : '—';

    const avatarEl = document.getElementById('rpAvatar');
    if (rider.photo_url) {
      avatarEl.innerHTML = `<img src="${rider.photo_url}" alt="${rider.full_name || ''}" />`;
    } else {
      avatarEl.innerHTML = `<i class="fas fa-motorcycle"></i>`;
    }

    const callBtn = document.getElementById('rpCallBtn');
    if (rider.phone) {
      callBtn.href = `tel:${rider.phone}`;
      callBtn.style.display = 'flex';
    } else {
      callBtn.style.display = 'none';
    }

    overlay.classList.add('active');
  }

  window.openRiderProfileModal = openRiderProfile;

  document.getElementById('closeRiderProfileBtn')?.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('active');
  });
</script>