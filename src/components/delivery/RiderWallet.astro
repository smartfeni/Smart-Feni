---
// path: src/components/delivery/RiderWallet.astro
// ============================================================
// রাইডারের ওয়ালেট পেজের শেয়ার্ড অংশ (/delivery-hero/wallet ও /pro/hero/wallet দুই জায়গায় একই)।
// লজিক: src/lib/riderWallet.js (mountWalletPage)। লগইন না থাকলে: মেইনে লগইন মডাল, Pro-তে Pro লগইন।
// স্টাইল is:global (JS দিয়ে বানানো HTML-এ scoped CSS বসে না)।
// ============================================================
interface Props { pro?: boolean }
const { pro = false } = Astro.props;
---

<div class="rw-page" data-pro={pro ? '1' : '0'}>
  <div class="rw-top">
    <a class="rw-back" id="rwBack" href={pro ? '/pro/hero/delivery' : '/delivery-hero'} aria-label="কুইক ডেলিভারিতে ফিরুন">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </a>
    <h1>আমার ওয়ালেট</h1>
  </div>
  <div id="rwRoot" aria-live="polite"></div>
</div>

<style is:global>
  .rw-page { background: #F4F6FA; min-height: 80vh; padding: 12px 14px 110px; max-width: 560px; margin: 0 auto; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; box-sizing: border-box; }
  .rw-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .rw-top h1 { margin: 0; font-size: 20px; font-weight: 700; }
  .rw-back { width: 42px; height: 42px; border-radius: 14px; background: #fff; border: 1.5px solid #E5EAF0; display: flex; align-items: center; justify-content: center; color: #1B2A4A; flex: none; }
  .rw-back svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  #rwRoot { display: flex; flex-direction: column; gap: 12px; }
  .rw-hero { border-radius: 24px; padding: 20px 18px; color: #fff; background: linear-gradient(140deg, #1B2A4A 0%, #2C4270 100%); display: flex; flex-direction: column; gap: 4px; box-shadow: 0 12px 28px rgba(27, 42, 74, .22); }
  .rw-hero.neg { background: linear-gradient(140deg, #8E1B12 0%, #C2410C 100%); box-shadow: 0 12px 28px rgba(194, 65, 12, .25); }
  .rw-hero.pos { background: linear-gradient(140deg, #0E5A34 0%, #17803F 100%); box-shadow: 0 12px 28px rgba(23, 128, 63, .22); }
  .rw-hero small { font-size: 14px; font-weight: 700; opacity: .9; }
  .rw-hero b { font-size: 36px; font-weight: 800; line-height: 1.15; letter-spacing: .3px; }
  .rw-hero p { margin: 6px 0 0; font-size: 13.5px; opacity: .92; line-height: 1.5; }
  .rw-acts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .rw-act { min-height: 78px; border-radius: 18px; border: 1.5px solid #E5EAF0; background: #fff; color: #1B2A4A; font: inherit; font-weight: 700; font-size: 13.5px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; cursor: pointer; padding: 8px 4px; }
  .rw-act i { font-size: 18px; color: #E2531F; }
  .rw-act:disabled { opacity: .45; cursor: default; }
  .rw-bk { display: flex; align-items: center; gap: 10px; background: #fff; border: 1.5px solid #F3D9E6; border-radius: 16px; padding: 12px 14px; }
  .rw-bk.missing { background: #FFF1F7; border-color: #E2136E; }
  .rw-bk img { width: 34px; height: 34px; object-fit: contain; flex: none; }
  .rw-bk-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
  .rw-bk-t small { font-size: 12px; font-weight: 700; color: #5A6B85; }
  .rw-bk-t b { font-size: 16.5px; letter-spacing: .4px; }
  .rw-bk-btn { min-height: 40px; padding: 0 14px; border: 1.5px solid #E2136E; border-radius: 12px; background: #fff; color: #E2136E; font: inherit; font-weight: 800; cursor: pointer; white-space: nowrap; }
  .rw-bk.missing .rw-bk-btn { background: #E2136E; color: #fff; }
  .rw-h { margin: 8px 2px 0; font-size: 15px; font-weight: 700; }
  .rw-pend { background: #FFF8EC; border: 1.5px solid #FFD9A8; border-radius: 14px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; font-weight: 700; font-size: 14px; color: #7A3E00; }
  .rw-pend small { font-size: 12px; font-weight: 600; opacity: .85; }
  .rw-list { background: #fff; border: 1.5px solid #E5EAF0; border-radius: 18px; padding: 2px 14px; }
  .rw-row { display: flex; align-items: center; gap: 10px; padding: 11px 0; }
  .rw-row + .rw-row { border-top: 1px solid #EEF1F5; }
  .rw-row[hidden] { display: none; }
  .rw-row-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
  .rw-row-t small { font-size: 12px; font-weight: 500; color: #5A6B85; }
  .rw-row b { font-size: 15px; font-weight: 800; white-space: nowrap; }
  .rw-row b.neg { color: #B42318; }
  .rw-row b.pos { color: #14804A; }
  .rw-row b.zero { color: #98A2B3; }
  .rw-row.rej .rw-row-t span { color: #5A6B85; }
  .rw-more { align-self: center; background: none; border: 0; font: inherit; font-weight: 700; color: #1B2A4A; padding: 8px; cursor: pointer; }
  .rw-empty { margin: 0; padding: 16px 0; text-align: center; color: #5A6B85; font-size: 14px; }
  .rw-note { margin: 0; font-size: 12.5px; color: #5A6B85; line-height: 1.55; }
  .rw-sheet { position: fixed; inset: 0; z-index: 9000; background: rgba(15, 22, 38, .5); display: flex; align-items: flex-end; justify-content: center; }
  .rw-box { width: 100%; max-width: 560px; max-height: 92vh; overflow-y: auto; background: #fff; border-radius: 24px 24px 0 0; padding: 18px 18px calc(18px + env(safe-area-inset-bottom)); box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; }
  .rw-box-h { display: flex; align-items: center; justify-content: space-between; }
  .rw-box-h h2 { margin: 0; font-size: 19px; font-weight: 700; }
  .rw-x { width: 40px; height: 40px; border-radius: 50%; border: 0; background: #F1F3F7; font-size: 16px; cursor: pointer; color: #1B2A4A; }
  .rw-box-b { display: flex; flex-direction: column; gap: 12px; }
  .rw-p { margin: 0; font-size: 13.5px; color: #4A5568; line-height: 1.55; }
  .rw-field { display: flex; flex-direction: column; gap: 5px; }
  .rw-field[hidden] { display: none; }
  .rw-field label { font-size: 14px; font-weight: 700; }
  .rw-field small { font-size: 12px; color: #5A6B85; }
  .rw-in { width: 100%; height: 50px; box-sizing: border-box; border: 1.5px solid #E2E7EF; border-radius: 14px; padding: 0 14px; font: inherit; font-size: 17px; color: #1B2A4A; background: #fff; }
  .rw-in:focus { outline: 2px solid #1B2A4A; outline-offset: -1px; }
  .rw-seg { display: flex; gap: 6px; }
  .rw-seg button { flex: 1; height: 44px; border-radius: 12px; border: 1.5px solid #E2E7EF; background: #fff; font: inherit; font-weight: 700; color: #1B2A4A; cursor: pointer; }
  .rw-seg button[aria-checked="true"] { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
  .rw-office { background: #F7F8FB; border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .rw-office p { margin: 0; font-size: 13.5px; line-height: 1.5; color: #4A5568; }
  .rw-office-row { display: flex; align-items: center; gap: 10px; }
  .rw-office-row span { font-weight: 700; font-size: 13.5px; color: #5A6B85; min-width: 40px; }
  .rw-office-row b { flex: 1; font-size: 18px; letter-spacing: .4px; }
  .rw-copy { min-height: 36px; padding: 0 12px; border-radius: 10px; border: 1.5px solid #E2E7EF; background: #fff; font: inherit; font-weight: 700; cursor: pointer; color: #1B2A4A; }
  .rw-err { margin: 0; padding: 9px 12px; border-radius: 12px; background: #FDECEA; color: #B42318; font-weight: 700; font-size: 14px; }
  .rw-err[hidden] { display: none; }
  .rw-submit { height: 52px; border: 0; border-radius: 14px; background: #FF6B35; color: #1B2A4A; font: inherit; font-size: 16px; font-weight: 800; cursor: pointer; }
  .rw-submit:disabled { opacity: .6; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { mountWalletPage } from '../../lib/riderWallet.js';
  import { proLoginUrl } from '../../lib/proRoles.js';

  const page = document.querySelector('.rw-page');
  const root = document.getElementById('rwRoot');
  const pro = page && page.getAttribute('data-pro') === '1';

  async function start() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      if (pro) { window.location.replace(proLoginUrl(window.location.pathname + window.location.search)); return; }
      root.textContent = 'ওয়ালেট দেখতে লগইন করুন।';
      if (window.openAuthModal) window.openAuthModal();
      return;
    }
    mountWalletPage(supabase, root);
  }
  start();
</script>
