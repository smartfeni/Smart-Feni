---
// ============================================================
// কম্পোনেন্ট: হোম ডেলিভারি কার্ড — CTA + ফর্ম একসাথে মার্জড,
// আলাদা মডাল পপআপ না করে সরাসরি কার্ডের ভেতরে ইনলাইন ফর্ম
// (আগের DeliveryRequestCTA + DeliveryRequestModal এর জায়গায়)
// লগইন না থাকলে ফর্ম দেখানোর আগে AuthModal খুলবে।
// ============================================================

const upazilaList = [
  'ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী',
];
---

<section class="dh-section">
  <div class="container">
    <div class="dh-card">
      <span class="dh-badge"><i class="fas fa-bolt"></i> নতুন</span>
      <h2 class="dh-title">হোম ডেলিভারি</h2>
      <p class="dh-subtitle">দাম বলুন, ভেরিফাইড ডেলিভারি হিরোরা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

      <form id="dhForm" class="dh-form">
        <div class="dh-field">
          <label>উপজেলা</label>
          <select id="dhUpazila" required>
            <option value="" disabled selected>সিলেক্ট করুন</option>
            {upazilaList.map((u) => <option value={u}>{u}</option>)}
          </select>
        </div>

        <div class="dh-field">
          <label>এলাকার বিবরণ</label>
          <input type="text" id="dhAreaDetail" placeholder="যেমন: শহীদ মিনার রোড, বাসা ১২" required />
        </div>

        <div class="dh-field">
          <label>কী ডেলিভারি করতে হবে</label>
          <textarea id="dhDescription" placeholder="সংক্ষেপে লিখুন" required></textarea>
        </div>

        <div class="dh-field">
          <label>বাহনের ধরন</label>
          <div class="dh-vehicle-row">
            <button type="button" class="dh-vehicle-btn active" data-vehicle="any">যেকোনো</button>
            <button type="button" class="dh-vehicle-btn" data-vehicle="bike">বাইক</button>
            <button type="button" class="dh-vehicle-btn" data-vehicle="cycle">সাইকেল</button>
          </div>
          <input type="hidden" id="dhVehicleType" value="any" />
        </div>

        <div class="dh-field">
          <label>আপনার দাম (৳)</label>
          <input type="number" id="dhPrice" placeholder="যেমন: ১৫০" min="1" required />
        </div>

        <p class="dh-error" id="dhError" style="display:none;"></p>

        <button type="submit" class="dh-submit-btn" id="dhSubmitBtn">
          <i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান
        </button>
      </form>

      <div class="dh-success" id="dhSuccess" style="display:none;">
        <div class="dh-success-icon"><i class="fas fa-check"></i></div>
        <h3>রিকোয়েস্ট পাঠানো হয়েছে!</h3>
        <p>সব ডেলিভারি হিরোকে নোটিফাই করা হয়েছে। অফার আসলে "আমার অর্ডার" এ দেখতে পারবেন।</p>
        <a href="/my-orders" class="dh-orders-link">আমার অর্ডার দেখুন</a>
      </div>
    </div>
  </div>
</section>

<style>
  .dh-section {
    padding: 24px 0;
    background: #fff;
  }

  .dh-card {
    background: linear-gradient(160deg, #FF6B35, #FF8A5C);
    border-radius: 24px;
    padding: 28px 22px 32px;
    box-shadow: 0 16px 32px rgba(255, 107, 53, 0.22);
    max-width: 480px;
    margin: 0 auto;
  }

  .dh-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .dh-title {
    color: #fff;
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .dh-subtitle {
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.84rem;
    line-height: 1.5;
    margin-bottom: 22px;
  }

  .dh-form {
    display: flex;
    flex-direction: column;
  }

  .dh-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
  }

  .dh-field label {
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .dh-field select,
  .dh-field input,
  .dh-field textarea {
    width: 100%;
    border: none;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.86rem;
    font-family: inherit;
    outline: none;
    color: #1B2A4A;
    background: #fff;
    box-sizing: border-box;
  }

  .dh-field textarea {
    resize: vertical;
    min-height: 56px;
  }

  .dh-vehicle-row {
    display: flex;
    gap: 8px;
  }

  .dh-vehicle-btn {
    flex: 1;
    border: none;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 10px 6px;
    border-radius: 12px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .dh-vehicle-btn.active {
    background: #fff;
    color: #FF6B35;
  }

  .dh-error {
    background: rgba(255, 255, 255, 0.9);
    color: #D14343;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 10px;
    margin-bottom: 12px;
    text-align: center;
  }

  .dh-submit-btn {
    width: 100%;
    background: #fff;
    color: #FF6B35;
    border: none;
    padding: 14px;
    border-radius: 40px;
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
  }

  .dh-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .dh-success {
    text-align: center;
    padding: 10px 4px;
  }

  .dh-success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: #1B7A3C;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin: 0 auto 14px;
  }

  .dh-success h3 {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .dh-success p {
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.82rem;
    line-height: 1.5;
    margin-bottom: 18px;
  }

  .dh-orders-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #FF6B35;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.86rem;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { createDeliveryRequest } from '../../lib/deliveryClient.js';

  const form = document.getElementById('dhForm');
  const successEl = document.getElementById('dhSuccess');
  const errorEl = document.getElementById('dhError');
  const submitBtn = document.getElementById('dhSubmitBtn');
  const vehicleInput = document.getElementById('dhVehicleType');
  const vehicleButtons = document.querySelectorAll('.dh-vehicle-btn');

  vehicleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      vehicleButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      vehicleInput.value = btn.dataset.vehicle;
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> পাঠানো হচ্ছে...';

    const upazila = document.getElementById('dhUpazila').value;
    const areaDetail = document.getElementById('dhAreaDetail').value.trim();
    const description = document.getElementById('dhDescription').value.trim();
    const vehicleType = vehicleInput.value;
    const initialPrice = document.getElementById('dhPrice').value;

    const { error } = await createDeliveryRequest({ upazila, areaDetail, description, vehicleType, initialPrice });

    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';

    if (error) {
      errorEl.textContent = error;
      errorEl.style.display = 'block';
      return;
    }

    form.style.display = 'none';
    successEl.style.display = 'block';
  });
</script>