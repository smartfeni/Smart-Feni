---
// ============================================================
// কম্পোনেন্ট: হোম ডেলিভারি কার্ড — ডেলিভারি UI v2
//
// আগে এখানে পুরো ইনলাইন ফর্ম ছিল। এখন কার্ড শুধু শিরোনাম + NoRiderNotice + একটা
// "অর্ডার শুরু করুন" বাটন। বাটনে ট্যাপ করলে ফুলস্ক্রিন ৩-ধাপ ফ্লো
// (DeliveryOrderFlow.astro: ড্রপ → পিকআপ ও দোকান/মেনু → রিভিউ) খোলে।
//
// আগের ব্যবস্থা যা বহাল:
//   • লগইন না থাকলে ফ্লো খোলার আগে AuthModal
//   • অনলাইন রাইডার না থাকলে NoRiderNotice (WhatsApp সহ); পুরো ফেনীতে কেউ না থাকলে
//     বা সেবা বন্ধ থাকলে #dhForm (বাটনের র‍্যাপার) লুকিয়ে যায় — riderAvailability.js
//     (init করে DeliveryOrderFlow, কারণ উপজেলা/বাহন/সাবমিট বাটন এখন ওখানে)
//   • আইডি #dhNotice (NoRiderNotice id="dh") ও #dhForm অপরিবর্তিত
// ============================================================

import NoRiderNotice from './NoRiderNotice.astro';
import DeliveryOrderFlow from './DeliveryOrderFlow.astro';
import GuideSheet from './GuideSheet.astro';
import '../../styles/hero-ui.css';

// ⓘ গাইড: ডেলিভারি অর্ডার কীভাবে হয় (সংক্ষেপে; প্রতি ধাপের নিজস্ব গাইড ফ্লোর ভেতরে আছে)
const homeGuide = [
  {
    caption: '"অর্ডার শুরু করুন" চাপুন',
    blocks: [{ kind: 'spacer' }, { kind: 'cta', text: 'অর্ডার শুরু করুন →', tap: true }],
  },
  {
    caption: 'ড্রপ, পিকআপ ও কী লাগবে দিন',
    blocks: [
      { kind: 'stepper', active: 1, labels: ['ড্রপ', 'পিকআপ', 'কনফার্ম'] },
      { kind: 'button', text: 'রেস্টুরেন্ট / দোকান থেকে বেছে নিন', primary: true, tap: true },
    ],
  },
  {
    caption: 'ডেলিভারি হিরোদের অফার থেকে সেরাটা বেছে নিন',
    blocks: [{ kind: 'card', title: 'অফার', lines: ['ডেলিভারি হিরো · ৳৮০'] }, { kind: 'button', text: 'কনফার্ম করুন', tap: true }],
  },
];
---

<section class="hu-form-section">
  <div class="container">
    <div class="hu-formcard">
      <div class="hu-formhead">
        <span class="hu-formicon"><i class="fas fa-box"></i></span>
        <h2 class="hu-title">হোম ডেলিভারি</h2>
        <span class="dh-guide-slot"><GuideSheet id="customer-delivery-home" title="ডেলিভারি অর্ডার" subtitle="কীভাবে অর্ডার করবেন" showButton buttonTone="light" videoTopic="delivery-hero" steps={homeGuide} /></span>
      </div>
      <p class="hu-sub">দাম বলুন, ভেরিফাইড ডেলিভারি হিরোরা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

      <NoRiderNotice id="dh" category="delivery" />

      <div id="dhForm" class="dh-cta-wrap">
        <button type="button" id="dhStartBtn" class="hu-submit">অর্ডার শুরু করুন →</button>
      </div>
    </div>
  </div>
</section>

<DeliveryOrderFlow />

<script>
  import { supabase } from '../../lib/supabase.js';

  document.getElementById('dhStartBtn')?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      (window as any).openAuthModal?.('login');
      return;
    }
    (window as any).SFDeliveryFlow?.open();
  });
</script>

<style>
  .dh-cta-wrap {
    margin-top: 14px;
  }
  .dh-guide-slot {
    margin-left: auto;
    flex: none;
  }
</style>
