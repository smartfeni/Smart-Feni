<!-- path: src/components/delivery/DeliveryHeroCard.astro -->
---
// ============================================================
// কম্পোনেন্ট: হোম ডেলিভারি কার্ড — CTA + ফর্ম একসাথে মার্জড,
// আলাদা মডাল পপআপ না করে সরাসরি কার্ডের ভেতরে ইনলাইন ফর্ম
// (আগের DeliveryRequestCTA + DeliveryRequestModal এর জায়গায়)
// লগইন না থাকলে ফর্ম দেখানোর আগে AuthModal খুলবে।
//
// আপডেট (রাইডার অ্যাভেইলেবিলিটি): উপজেলা অনুযায়ী অনলাইন রাইডার না
// থাকলে ফর্মের উপরে NoRiderNotice (WhatsApp সহ) দেখায় এবং সাবমিট বন্ধ
// রাখে। পুরো ফেনীতে কেউ অনলাইনে না থাকলে ফর্মটাই লুকিয়ে যায়।
//
// আপডেট (নতুন UI): সাদা কার্ড, রুট (পিকআপ → ড্রপ) ডটেড লাইনে, দামে বড় +/−
// স্টেপার ও +৫/+১০/+২০ বাটন, বাহনের চিপ। সব স্টাইল src/styles/hero-ui.css এ।
// ফর্মের আইডি/ক্লাস যা JS ও riderAvailability ব্যবহার করে সেগুলো আগের মতোই।
// ============================================================

const upazilaList = [
  'ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী',
];

import LocationPicker from './LocationPicker.astro';
import NoRiderNotice from './NoRiderNotice.astro';
import '../../styles/hero-ui.css';
---

<section class="hu-form-section">
  <div class="container">
    <div class="hu-formcard">
      <div class="hu-formhead">
        <span class="hu-formicon"><i class="fas fa-box"></i></span>
        <h2 class="hu-title">হোম ডেলিভারি</h2>
      </div>
      <p class="hu-sub">দাম বলুন, ভেরিফাইড ডেলিভারি হিরোরা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

      <NoRiderNotice id="dh" category="delivery" />

      <form id="dhForm" class="hu-form" novalidate>
        <div class="hu-field">
          <label>উপজেলা<span class="required-mark">*</span></label>
          <select id="dhUpazila" required>
            <option value="" disabled selected>সিলেক্ট করুন</option>
            {upazilaList.map((u) => <option value={u}>{u}</option>)}
          </select>
          <div class="field-error-msg" data-error-for="dhUpazila">
            <i class="fas fa-circle-exclamation"></i><span>উপজেলা সিলেক্ট করুন</span>
          </div>
        </div>

        <div class="hu-route">
          <div class="hu-route-card">
            <LocationPicker id="pickup" label="কোথা থেকে আনতে হবে (পিকআপ)" allowAutoLocate={false} placeholder="যেমন: নবী হোটেল, ফেনী সদর" enableSuggestions={true} />
          </div>
          <div class="hu-route-card drop">
            <LocationPicker id="drop" label="ডেলিভারি ঠিকানা" allowAutoLocate={true} placeholder="যেমন: শহীদ মিনার রোড, বাসা ১২" />
          </div>
        </div>

        <div class="hu-field">
          <label>কী ডেলিভারি করতে হবে<span class="required-mark">*</span></label>
          <textarea id="dhDescription" placeholder="সংক্ষেপে লিখুন" required></textarea>
          <div class="field-error-msg" data-error-for="dhDescription">
            <i class="fas fa-circle-exclamation"></i><span>কী ডেলিভারি করতে হবে লিখুন</span>
          </div>
        </div>

        <div class="hu-field">
          <label>বাহনের ধরন</label>
          <div class="hu-chips">
            <button type="button" class="hu-chip dh-vehicle-btn active" data-vehicle="any">যেকোনো</button>
            <button type="button" class="hu-chip dh-vehicle-btn" data-vehicle="bike">বাইক</button>
            <button type="button" class="hu-chip dh-vehicle-btn" data-vehicle="cycle">সাইকেল</button>
            <button type="button" class="hu-chip dh-vehicle-btn" data-vehicle="cng">সিএনজি</button>
          </div>
          <input type="hidden" id="dhVehicleType" value="any" />
        </div>

        <div class="hu-field">
          <label>আপনার প্রস্তাবিত মূল্য<span class="required-mark">*</span></label>
          <div class="hu-stepper">
            <button type="button" data-price-step="-10" aria-label="১০ টাকা কমান">−</button>
            <span class="hu-cur">৳</span>
            <input type="number" id="dhPrice" placeholder="যেমন: ১৫০" min="1" required />
            <button type="button" data-price-step="10" aria-label="১০ টাকা বাড়ান">+</button>
          </div>
          <div class="hu-quick">
            <button type="button" data-price-step="5">+৫</button>
            <button type="button" data-price-step="10">+১০</button>
            <button type="button" data-price-step="20">+২০</button>
          </div>
          <div class="field-error-msg" data-error-for="dhPrice">
            <i class="fas fa-circle-exclamation"></i><span>প্রস্তাবিত মূল্য দিন</span>
          </div>
        </div>

        <p class="hu-error" id="dhError" style="display:none;"></p>

        <button type="submit" class="hu-submit" id="dhSubmitBtn">
          <i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান
        </button>
      </form>

      <div class="hu-success" id="dhSuccess" style="display:none;">
        <div class="hu-success-icon"><i class="fas fa-check"></i></div>
        <h3>রিকোয়েস্ট পাঠানো হয়েছে!</h3>
        <p>সব ডেলিভারি হিরোকে নোটিফাই করা হয়েছে। অফার আসলে "আমার অর্ডার" এ দেখতে পারবেন।</p>
        <a href="/my-orders" class="hu-orders-link">আমার অর্ডার দেখুন</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { createServiceRequest } from '../../lib/deliveryClient.js';
  import { initRiderAvailability } from '../../lib/riderAvailability.js';

  const form = document.getElementById('dhForm');
  const successEl = document.getElementById('dhSuccess');
  const errorEl = document.getElementById('dhError');
  const submitBtn = document.getElementById('dhSubmitBtn');
  const vehicleInput = document.getElementById('dhVehicleType');
  const vehicleButtons = document.querySelectorAll('.dh-vehicle-btn');

  vehicleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      vehicleButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      vehicleInput.value = btn.dataset.vehicle;
    });
  });

  // উপজেলা অনুযায়ী অনলাইন রাইডার চেক — রাইডার না থাকলে নোটিশ দেখায়
  // ও সাবমিট বন্ধ রাখে (সার্ভারেও একই চেক আছে: create-request API)
  const availability = initRiderAvailability({
    category: 'delivery',
    root: document.getElementById('dhNotice'),
    form,
    upazilaSelect: document.getElementById('dhUpazila'),
    vehicleInput,
    vehicleButtons,
    submitBtn,
  });

  function releaseSubmit() {
    delete submitBtn.dataset.busy;
    submitBtn.disabled = false;
    availability.apply();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.openAuthModal?.('login');
      return;
    }

    if (!window.SFValidateForm(form)) {
      return;
    }

    submitBtn.dataset.busy = '1';
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> পাঠানো হচ্ছে...';

    const upazila = document.getElementById('dhUpazila').value;
    const description = document.getElementById('dhDescription').value.trim();
    const vehicleType = vehicleInput.value;
    const askingPrice = document.getElementById('dhPrice').value;

    const pickupWrap = document.querySelector('[data-lp-id="pickup"]');
    const dropWrap = document.querySelector('[data-lp-id="drop"]');

    const pickupAddress = pickupWrap.querySelector('.lp-out-address').value;
    const pickupLat = pickupWrap.querySelector('.lp-out-lat').value;
    const pickupLng = pickupWrap.querySelector('.lp-out-lng').value;
    const pickupInstructions = pickupWrap.querySelector('.lp-out-instructions').value;

    const dropAddress = dropWrap.querySelector('.lp-out-address').value;
    const dropLat = dropWrap.querySelector('.lp-out-lat').value;
    const dropLng = dropWrap.querySelector('.lp-out-lng').value;
    const dropInstructions = dropWrap.querySelector('.lp-out-instructions').value;

    if (!pickupAddress || !dropAddress) {
      errorEl.textContent = 'পিকআপ ও ডেলিভারি ঠিকানা দুটোই দিতে হবে';
      errorEl.style.display = 'block';
      releaseSubmit();
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';
      return;
    }

    const { error, code } = await createServiceRequest({
      category: 'delivery',
      upazila,
      pickupAddress,
      pickupLat: pickupLat || null,
      pickupLng: pickupLng || null,
      pickupInstructions,
      dropAddress,
      dropLat: dropLat || null,
      dropLng: dropLng || null,
      dropInstructions,
      description,
      vehicleType,
      askingPrice,
    });

    releaseSubmit();
    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';

    if (error) {
      errorEl.textContent = error;
      errorEl.style.display = 'block';
      if (code === 'NO_RIDER_ONLINE') availability.refresh();
      return;
    }

    form.dataset.done = '1';
    form.style.display = 'none';
    successEl.style.display = 'block';
  });

  // ============ স্টেপার বাটন (দাম/সিট) ============
  // +/− ও +৫/+১০/+২০ বাটনে ইনপুটের মান বদলায়; ভ্যালিডেশন আগের মতোই ইনপুটের মান দেখে
  const priceInput = document.getElementById('dhPrice');
  document.querySelectorAll('[data-price-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = Number(priceInput.value) || 0;
      const next = Math.max(1, current + Number(btn.dataset.priceStep));
      priceInput.value = String(next);
      priceInput.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });
</script>