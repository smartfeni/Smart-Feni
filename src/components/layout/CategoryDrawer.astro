<!-- path: src/components/layout/CategoryDrawer.astro -->
---
// ============================================================
// কম্পোনেন্ট: ক্যাটাগরি স্লাইড-ইন ড্রয়ার
// bottom nav এর "ক্যাটাগরি" আইকন থেকে ট্রিগার হয় (কাস্টম ইভেন্ট
// 'smartfeni:open-category-drawer' — window এ dispatch হয়, এই
// কম্পোনেন্ট সেটা শোনে। BaseLayout এ গ্লোবালি একবার মাউন্ট থাকে)।
// ডান দিক থেকে স্লাইড-ইন — Header হ্যামবার্গার/প্রোফাইল ড্রয়ারের
// সাথে কনসিস্টেন্ট (দুই পাশ থেকে না খুলে সবসময় ডান থেকে)।
// services.js থেকে hidden:true বাদে সব ক্যাটাগরি দেখায়। 'clubs'
// আইটেম আলাদাভাবে /clubs এ যায় (এটা /services/ এর আন্ডারে না,
// আলাদা টপ-লেভেল রুট)।
//
// আপডেট (এই সেশন — 2-column গ্রিড): আগে .cd-list একটা vertical
// লিস্ট ছিল (আইকন-বামে, নাম-মাঝে, চেভরন-ডানে)। এখন 2-column CSS
// গ্রিড — প্রতিটা আইটেম vertical কার্ড (আইকন উপরে, নাম নিচে,
// সেন্টার-অ্যালাইনড), চেভরন বাদ দেওয়া হয়েছে (গ্রিড কার্ডে দরকার নাই)।
// ============================================================

import { categories } from '../../data/services.js';

const visibleCategories = categories.filter((c) => !c.hidden);
---

<div class="cd-overlay" id="categoryDrawerOverlay">
  <aside class="cd-panel" id="categoryDrawerPanel">
    <div class="cd-header">
      <h2><i class="fas fa-grip"></i> সব ক্যাটাগরি</h2>
      <button class="cd-close" id="categoryDrawerClose" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="cd-list">
      {visibleCategories.map((cat) => (
        <a
          href={cat.id === 'clubs' ? '/clubs' : `/services/${cat.slug}`}
          class="cd-item"
        >
          <span class="cd-icon"><i class={`fas ${cat.icon}`}></i></span>
          <span class="cd-name">{cat.name}</span>
        </a>
      ))}
    </div>
  </aside>
</div>

<style>
  .cd-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 2200;
  }

  .cd-overlay.open {
    display: block;
  }

  .cd-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 84vw);
    background: #fff;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }

  .cd-overlay.open .cd-panel {
    transform: translateX(0);
  }

  .cd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px;
    border-bottom: 1px solid #EEF3F9;
  }

  .cd-header h2 {
    font-size: 1.05rem;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cd-header h2 i {
    color: #FF6B35;
    font-size: 0.95rem;
  }

  .cd-close {
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cd-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  /* নোট: 2-column গ্রিড — আগে vertical লিস্ট ছিল */
  .cd-list {
    flex: 1;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 12px 10px calc(24px + env(safe-area-inset-bottom));
  }

  .cd-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 8px;
    border-radius: 16px;
    background: #F8FAFC;
    text-decoration: none;
    color: #1B2A4A;
    text-align: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .cd-item:hover,
  .cd-item:active {
    background: #FFF0EA;
    transform: translateY(-1px);
  }

  .cd-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .cd-item:hover .cd-icon,
  .cd-item:active .cd-icon {
    background: #fff;
  }

  .cd-name {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>

<script>
  const overlay = document.getElementById('categoryDrawerOverlay');
  const closeBtn = document.getElementById('categoryDrawerClose');

  function openDrawer() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  window.addEventListener('smartfeni:open-category-drawer', openDrawer);

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDrawer();
  });
</script>
