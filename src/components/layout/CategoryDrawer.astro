---
// ============================================================
// কম্পোনেন্ট: ক্যাটাগরি স্লাইড-ইন ড্রয়ার
// bottom nav এর "ক্যাটাগরি" আইকন থেকে ট্রিগার হয় (কাস্টম ইভেন্ট
// 'smartfeni:open-category-drawer' — window এ dispatch হয়, এই
// কম্পোনেন্ট সেটা শোনে। BaseLayout এ গ্লোবালি একবার মাউন্ট থাকে)।
// ডান দিক থেকে স্লাইড-ইন — Header হ্যামবার্গার/প্রোফাইল ড্রয়ারের
// সাথে কনসিস্টেন্ট (দুই পাশ থেকে না খুলে সবসময় ডান থেকে)।
// services.js থেকে hidden:true বাদে সব ক্যাটাগরি দেখায়। 'clubs'
// আইটেম আলাদাভাবে /clubs এ যায় (এটা /services/ এর আন্ডারে না,
// আলাদা টপ-লেভেল রুট)।
//
// আপডেট (এই সেশন — 2-column গ্রিড): আগে .cd-list একটা vertical
// লিস্ট ছিল (আইকন-বামে, নাম-মাঝে, চেভরন-ডানে)। এখন 2-column CSS
// গ্রিড — প্রতিটা আইটেম vertical কার্ড (আইকন উপরে, নাম নিচে,
// সেন্টার-অ্যালাইনড), চেভরন বাদ দেওয়া হয়েছে (গ্রিড কার্ডে দরকার নাই)।
//
// আপডেট (রিডিজাইন): ৩-কলাম গ্রিডে রঙিন গোল আইকন (রং: data/categoryColors.js),
// উপরে সার্চ বক্স (নাম দিয়ে ফিল্টার)। ড্রয়ার খোলা/বন্ধ লজিক আগের মতোই।
// ============================================================

import { categories } from '../../data/services.js';
import { categoryColor } from '../../data/categoryColors.js';

const visibleCategories = categories.filter((c) => !c.hidden);
---

<div class="cd-overlay" id="categoryDrawerOverlay">
  <aside class="cd-panel" id="categoryDrawerPanel">
    <div class="cd-header">
      <h2><i class="fas fa-grip"></i> সব ক্যাটাগরি</h2>
      <button class="cd-close" id="categoryDrawerClose" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="cd-search">
      <i class="fas fa-magnifying-glass"></i>
      <input type="search" id="categoryDrawerSearch" placeholder="ক্যাটাগরি খুঁজুন" autocomplete="off" />
    </div>

    <div class="cd-list">
      {visibleCategories.map((cat) => (
        <a
          href={cat.id === 'clubs' ? '/clubs' : `/services/${cat.slug}`}
          class="cd-item"
          data-name={cat.name}
          style={`--c:${categoryColor(cat.slug)}`}
        >
          <span class="cd-icon"><i class={`fas ${cat.icon}`}></i></span>
          <span class="cd-name">{cat.name}</span>
        </a>
      ))}
      <p class="cd-empty" id="categoryDrawerEmpty" style="display:none;">কোনো ক্যাটাগরি পাওয়া যায়নি</p>
    </div>
  </aside>
</div>

<style>
  .cd-overlay { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); z-index: 2200; }
  .cd-overlay.open { display: block; }

  .cd-panel {
    position: fixed; top: 0; right: 0; bottom: 0;
    width: min(380px, 92vw);
    background: #F8FAFC;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.18);
    display: flex; flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }
  .cd-overlay.open .cd-panel { transform: translateX(0); }

  .cd-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 18px 10px; }
  .cd-header h2 { font-size: 1.1rem; font-weight: 800; color: #1B2A4A; display: flex; align-items: center; gap: 8px; margin: 0; }
  .cd-header h2 i { color: #FF6B35; font-size: 0.95rem; }
  .cd-close { background: #fff; border: 1px solid #E5EAF0; width: 34px; height: 34px; border-radius: 50%; color: #5A6E85; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cd-close:active { background: #FF6B35; color: #fff; }

  .cd-search { margin: 4px 16px 10px; display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #E5EAF0; border-radius: 14px; padding: 0 12px; color: #8FA0BC; }
  .cd-search:focus-within { border-color: #FF6B35; }
  .cd-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 0.9rem; color: #1B2A4A; padding: 12px 0; }

  .cd-list { flex: 1; overflow-y: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; align-content: start; padding: 4px 14px calc(24px + env(safe-area-inset-bottom)); }

  .cd-item {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 14px 6px 12px;
    background: #fff; border: 1px solid #E5EAF0; border-radius: 18px;
    text-decoration: none; color: #1B2A4A; text-align: center;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .cd-item:active { transform: scale(0.96); box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1); }

  .cd-icon {
    width: 50px; height: 50px; border-radius: 50%;
    background: #FFF0EA; /* ফলব্যাক */
    background: color-mix(in srgb, var(--c) 14%, #fff);
    color: var(--c);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
  }

  .cd-name { font-size: 0.74rem; font-weight: 700; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cd-empty { grid-column: 1 / -1; text-align: center; color: #8FA0BC; font-size: 0.86rem; padding: 30px 0; margin: 0; }
</style>

<script>
  const overlay = document.getElementById('categoryDrawerOverlay');
  const closeBtn = document.getElementById('categoryDrawerClose');

  const searchInput = document.getElementById('categoryDrawerSearch');
  const emptyEl = document.getElementById('categoryDrawerEmpty');

  function filterCategories() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll('.cd-item').forEach((item) => {
      const match = !q || (item.dataset.name || '').toLowerCase().includes(q);
      item.style.display = match ? '' : 'none';
      if (match) shown += 1;
    });
    if (emptyEl) emptyEl.style.display = shown === 0 ? 'block' : 'none';
  }

  searchInput?.addEventListener('input', filterCategories);

  function openDrawer() {
    if (searchInput) searchInput.value = '';
    filterCategories();
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  window.addEventListener('smartfeni:open-category-drawer', openDrawer);

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDrawer();
  });
</script>
