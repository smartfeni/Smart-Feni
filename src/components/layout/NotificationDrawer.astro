---
// ============================================================
// কম্পোনেন্ট: নোটিফিকেশন স্লাইড-ইন ড্রয়ার
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (Blood Request ফিচার): category='blood_request' নোটিফিকেশনে
// ইনলাইন "স্কিপ" / "আমি রক্তদানে আগ্রহী" বাটন, লাইভ status চেক।
//
// আপডেট (Phase 2 — ছবি): ছবি থাম্বনেইল + ফুলস্ক্রিন লাইটবক্স।
//
// আপডেট (আগের সেশন — HungerStation-স্টাইল ডিটেইল ভিউ):
// - আগে লিস্ট আইটেমে ক্লিক করলে ইনলাইন টেক্সট ক্লাম্প/এক্সপান্ড হতো,
//   এখন একটা পূর্ণাঙ্গ ফুল-স্ক্রিন ডিটেইল ভিউ খোলে
// - push notification ক্লিক করলে sw.js এখন ?notif={id} সহ URL এ
//   পাঠায় — পেজ লোড হলে এই প্যারামিটার পড়ে সরাসরি সেই নোটিফিকেশনের
//   ডিটেইল অটো-ওপেন হয়
//
// আপডেট (এই সেশন — গ্লাস-স্টাইল ফুল-ভিউ মডেল পপ-আপ):
// - আলাদা "শুধু ছবি" লাইটবক্স বাদ দেওয়া হয়েছে — ছবি+টেক্সট একসাথে
//   যে ভিউ আছে সেটাই যথেষ্ট
// - ড্রয়ার প্যানেলের ভেতরের ইনলাইন ফুল-স্ক্রিন ডিটেইল ভিউ সরিয়ে
//   একটা সত্যিকারের viewport-লেভেল মডেল পপ-আপ বানানো হয়েছে
//   (প্রায়-ফুলস্ক্রিন, চারপাশে মার্জিন, ফুটারের glass-chip স্টাইলের
//   মতো গ্লাস ইফেক্ট, ভেতরের বডি স্ক্রলযোগ্য)। ড্রয়ারে এখন শুধু
//   লিস্ট থাকে — লিস্ট আইটেমে ক্লিক করলে এই মডেল খোলে।
// - নতুন: Supabase Realtime সাবস্ক্রিপশন — লগইন করা ইউজার সাইটে
//   থাকা অবস্থায় নতুন নোটিফিকেশন (ব্লাড রিকোয়েস্টসহ, কারণ সেটাও
//   একই user_notifications টেবিলেই insert হয়) এলে সাথে সাথে এই
//   একই মডেল অটো-ওপেন হয়
// - Push notification ট্যাপ (?notif=id) এখন ড্রয়ার না খুলেই সরাসরি
//   এই মডেল ওপেন করে
//
// আপডেট (এই সেশন):
// - ব্লাড রিকোয়েস্ট স্কিপ/আগ্রহী বাটন এখন ড্রয়ারের লিস্ট আইটেমেও
//   দেখাবে (আগে শুধু ফুল-ভিউ মডেলে ছিল) — লিস্ট আইটেম <button> থেকে
//   <div role="button"> এ পরিবর্তন করা হয়েছে যাতে ভেতরে নেস্টেড বাটন
//   (স্কিপ/আগ্রহী) বসানো যায় (HTML এ button এর ভেতর button বসানো
//   ইনভ্যালিড, ব্রাউজার DOM ভেঙে ফেলত)
// - স্কিপ করলে এখন নতুন blood_request_skips টেবিলে সেভ হয় (আগে
//   কোথাও সেভ হতো না, ড্রয়ার আবার খুললে বাটন ফিরে আসতো) — এখন
//   "আপনি স্কিপ করেছেন" স্ট্যাটাস স্থায়ীভাবে দেখাবে
// - রিকোয়েস্ট অন্য কেউ ম্যানেজ করে ফেললে (fulfilled/expired/
//   cancelled) — এটা আগে থেকেই fresh লোড করত, এখন লিস্টেও দেখাবে
// - "সম্পর্কিত লিস্টিং দেখুন" জেনেরিক বাটনের বদলে এখন link_label
//   থাকলে (অ্যাডমিন প্যানেল থেকে সেট করা নির্দিষ্ট শপ/ক্লাব/লিস্টিং
//   এর নাম) সেই নামটাই বাটনে দেখাবে, action_url এ নিয়ে যাবে
// - .notif-item-image / .log-item স্টাইলের ছবি লোড হওয়ার সময়
//   লেআউট জাম্প (CLS) কমাতে ফিক্সড height + হালকা প্লেসহোল্ডার
//   ব্যাকগ্রাউন্ড যোগ হলো (স্লো নেটওয়ার্কে alignment ভাঙা ঠিক করতে)
// ============================================================
---

<div class="nd-overlay" id="notificationDrawerOverlay">
  <aside class="nd-panel" id="notificationDrawerPanel">
    <div class="nd-header">
      <h2><i class="fas fa-bell"></i> নোটিফিকেশন</h2>
      <div class="nd-header-actions">
        <button id="notifMarkAllBtn" type="button">সব পড়া হয়েছে</button>
        <button class="nd-close" id="notificationDrawerClose" aria-label="বন্ধ করুন">
          <i class="fas fa-xmark"></i>
        </button>
      </div>
    </div>

    <div class="nd-list" id="notifList"></div>

    <p class="nd-empty" id="notifEmpty" style="display:none;">
      <i class="fas fa-bell-slash"></i>
      কোনো নোটিফিকেশন নেই
    </p>
  </aside>
</div>

<!-- ===== গ্লাস-স্টাইল ফুল-ভিউ মডেল পপ-আপ (নতুন) ===== -->
<div class="nd-modal-overlay" id="notifModalOverlay">
  <div class="nd-modal-card" id="notifModalCard">
    <button type="button" class="nd-modal-close" id="notifModalClose" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>
    <div class="nd-modal-body" id="notifModalBody"></div>
  </div>
</div>

<style>
  .nd-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 2200;
  }

  .nd-overlay.open {
    display: block;
  }

  .nd-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 88vw);
    background: #fff;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
    overflow: hidden;
  }

  .nd-overlay.open .nd-panel {
    transform: translateX(0);
  }

  .nd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 18px 16px 20px;
    border-bottom: 1px solid #EEF3F9;
    gap: 8px;
    flex-shrink: 0;
  }

  .nd-header h2 {
    font-size: 1.05rem;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .nd-header h2 i {
    color: #FF6B35;
    font-size: 0.95rem;
  }

  .nd-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .nd-header-actions button#notifMarkAllBtn {
    background: none;
    border: none;
    color: #FF6B35;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .nd-header-actions button#notifMarkAllBtn:hover {
    background: #FFF0EA;
  }

  .nd-close {
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nd-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .nd-list {
    flex: 1;
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .nd-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: #B0BCCB;
    font-size: 0.85rem;
    padding: 60px 24px;
    margin: 0;
  }

  .nd-empty i {
    font-size: 1.8rem;
    color: #D7E0EC;
  }

  /* ============================================================
     গ্লাস-স্টাইল ফুল-ভিউ মডেল পপ-আপ (নতুন)
     — প্রায়-ফুলস্ক্রিন, চারপাশে মার্জিন, ফুটারের .glass-chip এর
     মতো গ্লাস ইফেক্ট, বডি অংশ স্ক্রলযোগ্য
  ============================================================ */
  .nd-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    z-index: 2500;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .nd-modal-overlay.open {
    display: flex;
  }

  .nd-modal-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 26px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    overflow: hidden;
    animation: ndModalPop 0.22s ease;
  }

  @keyframes ndModalPop {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .nd-modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    color: #1B2A4A;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(27, 42, 74, 0.15);
    flex-shrink: 0;
  }

  .nd-modal-close:hover {
    background: #FF6B35;
    border-color: #FF6B35;
    color: #fff;
  }

  .nd-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 52px 22px 26px;
  }

  @media (max-width: 480px) {
    .nd-modal-overlay {
      padding: 14px;
    }

    .nd-modal-card {
      max-height: calc(100vh - 28px);
      max-height: calc(100dvh - 28px);
      border-radius: 22px;
    }

    .nd-modal-body {
      padding: 48px 18px 22px;
    }
  }
</style>

<!-- ============================================================
  is:global — .notif-item, .nd-modal-* এলিমেন্টগুলোর ভেতরের কনটেন্ট
  JS দিয়ে ডাইনামিকালি বানানো হয় বলে Astro এর স্কোপড CSS এদের উপর
  বসে না।
============================================================ -->
<style is:global>
  .notif-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #F4F7FC;
    padding: 14px 20px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease;
  }

  /* নোট: এখন .notif-item একটা <div role="button"> (আগে <button> ছিল,
     ভেতরে স্কিপ/আগ্রহী বাটন বসানোর জন্য div করা হয়েছে) — ফোকাস রিং
     রাখা হলো কীবোর্ড ব্যবহারকারীদের জন্য */
  .notif-item:focus-visible {
    outline: 2px solid #FF6B35;
    outline-offset: -2px;
  }

  .notif-item:last-child {
    border-bottom: none;
  }

  .notif-item:hover {
    background: #F8FAFC;
  }

  .notif-item.unread {
    background: #FFF8F5;
  }

  .notif-item.unread:hover {
    background: #FFF0EA;
  }

  .notif-item-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    position: relative;
  }

  .notif-item.unread .notif-item-icon {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .notif-item.unread .notif-item-icon::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #FF6B35;
    border: 2px solid #fff;
  }

  .notif-item-body {
    flex: 1;
    min-width: 0;
  }

  .notif-item-msg {
    font-size: 0.84rem;
    color: #1B2A4A;
    line-height: 1.5;
    white-space: pre-line;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .notif-item.unread .notif-item-msg {
    font-weight: 600;
  }

  .notif-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
  }

  .notif-item-time {
    font-size: 0.72rem;
    color: #8FA0BC;
  }

  .notif-item-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #FF6B35;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .notif-item-link:hover {
    text-decoration: underline;
  }

  .notif-blood-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  .notif-blood-btn {
    flex: 1;
    border: none;
    border-radius: 30px;
    padding: 8px 10px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  .notif-blood-btn.skip {
    background: #F4F7FC;
    color: #5A6E85;
  }

  .notif-blood-btn.interested {
    background: #D14343;
    color: #fff;
  }

  .notif-blood-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .notif-blood-status {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    background: #E7F8EE;
    color: #1E9E5A;
  }

  /* স্কিপ করা হয়েছে — সবুজ "সফল" রঙের বদলে নিউট্রাল ধূসর */
  .notif-blood-status.skipped {
    background: #F1F4F8;
    color: #5A6E85;
  }

  /* নোট: max-height এর বদলে ফিক্সড height + হালকা প্লেসহোল্ডার
     ব্যাকগ্রাউন্ড — ছবি লোড হওয়ার আগেই জায়গা রিজার্ভ থাকে, স্লো
     নেটওয়ার্কে ছবি লোড হওয়ার সময় লিস্ট আইটেম আর জাম্প/এলোমেলো
     হবে না */
  .notif-item-image {
    display: block;
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 8px;
    background: #F1F4F8;
  }

  /* ===== মডেল পপ-আপের ভেতরের কনটেন্ট ===== */
  .nd-detail-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .nd-detail-chip {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 20px;
    background: #F1F4F8;
    color: #5A6E85;
  }

  .nd-detail-chip.chip-blood_request,
  .nd-detail-chip.chip-blood_response {
    background: #FDEAEA;
    color: #D14343;
  }

  .nd-detail-chip.chip-promo {
    background: #FDF0D5;
    color: #B36B00;
  }

  .nd-detail-chip.chip-delivery_hero,
  .nd-detail-chip.chip-rider_offer,
  .nd-detail-chip.chip-shop_order {
    background: #E8F2FF;
    color: #1D6FE0;
  }

  .nd-detail-date {
    font-size: 0.78rem;
    color: #9AA8BC;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .nd-detail-image {
    display: block;
    width: 100%;
    min-height: 120px;
    border-radius: 14px;
    margin-bottom: 18px;
    background: #F1F4F8;
  }

  .nd-detail-text {
    font-size: 0.95rem;
    color: #1B2A4A;
    line-height: 1.8;
    white-space: pre-line;
    margin-bottom: 18px;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const overlay = document.getElementById('notificationDrawerOverlay');
  const closeBtn = document.getElementById('notificationDrawerClose');
  const notifList = document.getElementById('notifList');
  const notifEmpty = document.getElementById('notifEmpty');
  const notifMarkAllBtn = document.getElementById('notifMarkAllBtn');

  const modalOverlay = document.getElementById('notifModalOverlay');
  const modalBody = document.getElementById('notifModalBody');
  const modalCloseBtn = document.getElementById('notifModalClose');

  let currentUserId = null;
  let latestNotifications = [];
  let bloodStatusMap = new Map();
  let respondedSet = new Set();
  let skippedSet = new Set();
  let notifChannel = null;

  const categoryChipLabels = {
    listing_status: 'লিস্টিং স্ট্যাটাস',
    delivery_hero: 'ডেলিভারি হিরো',
    blood_request: 'ব্লাড রিকোয়েস্ট',
    blood_response: 'ব্লাড রেসপন্স',
    rider_offer: 'রাইডার অফার',
    shop_order: 'অর্ডার',
    promo: 'অফার-প্রমো',
    message: 'মেসেজ',
    system: 'সিস্টেম',
  };

  function toBnDigits(num) {
    const bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    return num.toString().replace(/[0-9]/g, (d) => bn[d]);
  }

  function relativeTimeBn(dateString) {
    const then = new Date(dateString);
    const diffSec = Math.floor((Date.now() - then.getTime()) / 1000);
    const diffMin = Math.floor(diffSec / 60);
    const diffHour = Math.floor(diffMin / 60);
    const diffDay = Math.floor(diffHour / 24);

    if (diffSec < 60) return 'এইমাত্র';
    if (diffMin < 60) return `${toBnDigits(diffMin)} মিনিট আগে`;
    if (diffHour < 24) return `${toBnDigits(diffHour)} ঘণ্টা আগে`;
    if (diffDay < 30) return `${toBnDigits(diffDay)} দিন আগে`;
    return `${toBnDigits(Math.floor(diffDay / 30))} মাস আগে`;
  }

  function absoluteDateBn(dateString) {
    const d = new Date(dateString);
    return d.toLocaleDateString('bn-BD', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  function bloodStatusLabel(status) {
    if (status === 'fulfilled') return '✅ এই রিকোয়েস্টটি ম্যানেজ হয়ে গেছে';
    if (status === 'expired') return '⏱️ এই রিকোয়েস্টের মেয়াদ শেষ হয়ে গেছে';
    if (status === 'cancelled') return '❌ এই রিকোয়েস্টটি বাতিল করা হয়েছে';
    return null;
  }

  // ============================================================
  // মার্ক রিড (হেল্পার, সব জায়গায় রিইউজ)
  // ============================================================
  async function markRead(n) {
    if (n.is_read) return;
    n.is_read = true;
    await supabase.from('user_notifications').update({ is_read: true }).eq('id', n.id);
    updateBadgeCount();
  }

  // ============================================================
  // গ্লাস-স্টাইল ফুল-ভিউ মডেল পপ-আপ
  // ============================================================
  function renderBloodActionHtml(n) {
    const isBloodRequest = n.category === 'blood_request' && n.related_entity_id;
    if (!isBloodRequest) return '';

    const status = bloodStatusMap.get(n.related_entity_id) || 'active';
    const managedLabel = bloodStatusLabel(status);
    const alreadyResponded = respondedSet.has(n.related_entity_id);
    const alreadySkipped = skippedSet.has(n.related_entity_id);

    // অগ্রাধিকার: রিকোয়েস্ট ম্যানেজ হয়ে গেলে সেটাই সবার আগে দেখাবে
    // (নিজে রেসপন্স/স্কিপ করেছেন কিনা তার আগেই) — কারণ ততক্ষণে
    // অন্য কেউ ইতিমধ্যে ম্যানেজ করে ফেলেছে
    if (managedLabel) {
      return `<span class="notif-blood-status">${managedLabel}</span>`;
    }
    if (alreadyResponded) {
      return `<span class="notif-blood-status">✅ আপনি আগ্রহ জানিয়েছেন</span>`;
    }
    if (alreadySkipped) {
      return `<span class="notif-blood-status skipped">🚫 আপনি এই রিকোয়েস্টটি স্কিপ করেছেন</span>`;
    }

    return `
      <span class="notif-blood-actions">
        <button type="button" class="notif-blood-btn skip" data-blood-skip data-request-id="${n.related_entity_id}">স্কিপ</button>
        <button type="button" class="notif-blood-btn interested" data-blood-interested data-request-id="${n.related_entity_id}">আমি রক্তদানে আগ্রহী</button>
      </span>
    `;
  }

  function wireBloodActionButtons(container, n) {
    const actionsRow = container.querySelector('.notif-blood-actions');

    const skipBtn = container.querySelector('[data-blood-skip]');
    skipBtn?.addEventListener('click', async (e) => {
      // পুরো লিস্ট আইটেম ট্যাপ করলে ফুল-ভিউ মডেল খোলে — এই বাটনের
      // ক্লিক যেন সেই প্যারেন্ট হ্যান্ডলারে বাবল করে মডেল না খুলে ফেলে
      e.stopPropagation();
      const requestId = skipBtn.getAttribute('data-request-id');
      const interestedSibling = container.querySelector('[data-blood-interested]');
      skipBtn.disabled = true;
      if (interestedSibling) interestedSibling.disabled = true;

      // blood_request_skips এ সেভ (duplicate হলে চুপচাপ ignore)
      await supabase.from('blood_request_skips').upsert(
        { blood_request_id: requestId, user_id: currentUserId },
        { onConflict: 'blood_request_id,user_id', ignoreDuplicates: true }
      );
      skippedSet.add(requestId);

      const span = document.createElement('span');
      span.className = 'notif-blood-status skipped';
      span.textContent = '🚫 আপনি এই রিকোয়েস্টটি স্কিপ করেছেন';
      actionsRow?.replaceWith(span);
      await markRead(n);
    });

    const interestedBtn = container.querySelector('[data-blood-interested]');
    interestedBtn?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const requestId = interestedBtn.getAttribute('data-request-id');
      interestedBtn.disabled = true;
      skipBtn.disabled = true;
      interestedBtn.textContent = 'পাঠানো হচ্ছে...';

      const { data, error } = await supabase.rpc('respond_to_blood_request', {
        p_blood_request_id: requestId,
        p_donor_user_id: currentUserId,
      });

      if (error || !data?.success) {
        const alreadyManaged = data?.error === 'already_managed';
        const label = alreadyManaged
          ? bloodStatusLabel(data.status) || 'এই রিকোয়েস্টটি ইতিমধ্যে ম্যানেজ হয়ে গেছে'
          : 'কিছু ভুল হয়েছে, আবার চেষ্টা করুন';
        const span = document.createElement('span');
        span.className = 'notif-blood-status';
        span.textContent = label;
        actionsRow?.replaceWith(span);
        return;
      }

      respondedSet.add(requestId);
      const span = document.createElement('span');
      span.className = 'notif-blood-status';
      span.textContent = '✅ আপনার আগ্রহ জানানো হয়েছে, রিকোয়েস্টার শীঘ্রই যোগাযোগ করবেন';
      actionsRow?.replaceWith(span);
      await markRead(n);
    });
  }

  function openNotifModal(n) {
    modalBody.innerHTML = `
      <div class="nd-detail-chips">
        <span class="nd-detail-chip chip-${n.category}">${categoryChipLabels[n.category] || 'নোটিফিকেশন'}</span>
      </div>
      <p class="nd-detail-date">${absoluteDateBn(n.created_at)}</p>
      ${n.image_url ? `<img src="${n.image_url}" alt="" class="nd-detail-image" />` : ''}
      <p class="nd-detail-text">${escapeHtml(n.message)}</p>
      ${
        n.action_url
          ? `<button type="button" class="notif-item-link" data-open-link>${escapeHtml(n.link_label || 'বিস্তারিত দেখুন')} →</button>`
          : n.listing_id
          ? '<button type="button" class="notif-item-link" data-open-listing>সম্পর্কিত লিস্টিং দেখুন →</button>'
          : ''
      }
      <div data-blood-slot>${renderBloodActionHtml(n)}</div>
    `;

    // link_label/action_url অ্যাডমিন থেকে সেট করা থাকলে (নতুন —
    // নির্দিষ্ট শপ/ক্লাব/লিস্টিং প্রমো লিংক) সেটাই প্রায়োরিটি পাবে,
    // নাহলে পুরনো listing_id ফলব্যাক
    const linkBtn = modalBody.querySelector('[data-open-link]');
    linkBtn?.addEventListener('click', () => {
      window.location.href = n.action_url;
    });

    const listingBtn = modalBody.querySelector('[data-open-listing]');
    listingBtn?.addEventListener('click', () => {
      window.location.href = `/listing/${n.listing_id}`;
    });

    wireBloodActionButtons(modalBody, n);

    modalOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';

    markRead(n);
  }

  function closeNotifModal() {
    modalOverlay.classList.remove('open');
    // ড্রয়ার খোলা না থাকলেই শুধু body scroll ফিরিয়ে দেওয়া
    if (!overlay.classList.contains('open')) {
      document.body.style.overflow = '';
    }
    modalBody.innerHTML = '';
  }

  modalCloseBtn?.addEventListener('click', closeNotifModal);
  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeNotifModal();
  });

  // ============================================================
  // লিস্ট ভিউ রেন্ডার
  // ============================================================
  function renderNotifications(items) {
    notifList.innerHTML = '';

    if (!items || items.length === 0) {
      notifEmpty.style.display = 'flex';
      return;
    }
    notifEmpty.style.display = 'none';

    items.forEach((n) => {
      // নোট: আগে এটা <button> ছিল, এখন <div role="button"> —
      // ব্লাড রিকোয়েস্টের স্কিপ/আগ্রহী বাটন ভেতরে বসানোর জন্য
      // (HTML এ button এর ভেতর button বসানো যায় না, ব্রাউজার
      // ইনভ্যালিড নেস্টিং সামলাতে গিয়ে DOM ভেঙে লেআউট নষ্ট করে দিত)
      const el = document.createElement('div');
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.className = `notif-item ${n.is_read ? '' : 'unread'}`;
      el.innerHTML = `
        <span class="notif-item-icon"><i class="fas fa-bell"></i></span>
        <span class="notif-item-body">
          ${n.image_url ? `<img src="${n.image_url}" alt="" class="notif-item-image" />` : ''}
          <span class="notif-item-msg">${escapeHtml(n.message)}</span>
          <div data-blood-slot>${renderBloodActionHtml(n)}</div>
          <span class="notif-item-footer">
            <span class="notif-item-time">${relativeTimeBn(n.created_at)}</span>
          </span>
        </span>
      `;

      wireBloodActionButtons(el, n);

      // পুরো আইটেম (ছবিসহ) ট্যাপ/এন্টার-কী করলে ফুল-ভিউ মডেল পপ-আপ
      // খুলবে — স্কিপ/আগ্রহী বাটনের ক্লিক stopPropagation করা থাকায়
      // এতে কনফ্লিক্ট হয় না
      el.addEventListener('click', () => openNotifModal(n));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openNotifModal(n);
        }
      });

      notifList.appendChild(el);
    });
  }

  function updateBadgeCount() {
    const unreadCount = latestNotifications.filter((n) => !n.is_read).length;
    window.dispatchEvent(
      new CustomEvent('smartfeni:notification-count', { detail: { count: unreadCount } })
    );
  }

  // ============================================================
  // Realtime সাবস্ক্রিপশন — নতুন নোটিফিকেশন (ব্লাড রিকোয়েস্টসহ)
  // এলে সাথে সাথে ফুল-ভিউ মডেল অটো-ওপেন
  // ============================================================
  function subscribeRealtime() {
    if (notifChannel) {
      supabase.removeChannel(notifChannel);
      notifChannel = null;
    }
    if (!currentUserId) return;

    notifChannel = supabase
      .channel(`user_notifications_${currentUserId}`)
      .on(
        'postgres_changes',
        {
          event: 'INSERT',
          schema: 'public',
          table: 'user_notifications',
          filter: `user_id=eq.${currentUserId}`,
        },
        (payload) => {
          const newNotif = payload.new;
          latestNotifications = [newNotif, ...latestNotifications];
          renderNotifications(latestNotifications);
          updateBadgeCount();
          openNotifModal(newNotif);
        }
      )
      .subscribe();
  }

  function unsubscribeRealtime() {
    if (notifChannel) {
      supabase.removeChannel(notifChannel);
      notifChannel = null;
    }
  }

  // ============================================================
  // লোড + deep-link হ্যান্ডলিং (?notif=xxx)
  // ============================================================
  async function loadNotifications() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      currentUserId = null;
      latestNotifications = [];
      renderNotifications([]);
      updateBadgeCount();
      unsubscribeRealtime();
      return;
    }

    currentUserId = session.user.id;

    const { data, error } = await supabase
      .from('user_notifications')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(20);

    if (error) return;

    latestNotifications = data || [];

    const bloodRequestIds = latestNotifications
      .filter((n) => n.category === 'blood_request' && n.related_entity_id)
      .map((n) => n.related_entity_id);

    bloodStatusMap = new Map();
    respondedSet = new Set();
    skippedSet = new Set();

    if (bloodRequestIds.length > 0) {
      const { data: statusRows } = await supabase
        .from('blood_requests')
        .select('id, status')
        .in('id', bloodRequestIds);

      (statusRows || []).forEach((r) => bloodStatusMap.set(r.id, r.status));

      const { data: responseRows } = await supabase
        .from('blood_request_responses')
        .select('blood_request_id')
        .eq('donor_user_id', currentUserId)
        .in('blood_request_id', bloodRequestIds);

      (responseRows || []).forEach((r) => respondedSet.add(r.blood_request_id));

      const { data: skipRows } = await supabase
        .from('blood_request_skips')
        .select('blood_request_id')
        .eq('user_id', currentUserId)
        .in('blood_request_id', bloodRequestIds);

      (skipRows || []).forEach((r) => skippedSet.add(r.blood_request_id));
    }

    renderNotifications(latestNotifications);
    updateBadgeCount();
    subscribeRealtime();
  }

  // পেজ লোড হওয়ার সময় (বা push নোটিফিকেশনে ক্লিক করে আসলে) URL এ
  // ?notif=xxx থাকলে সরাসরি সেই নোটিফিকেশনের ফুল-ভিউ মডেল অটো-ওপেন
  // করা (ড্রয়ার না খুলেই)
  //
  // আপডেট (এই সেশন — দেরি ফিক্স): আগে এটা loadNotifications() পুরো
  // শেষ হওয়ার (২০টা নোটিফিকেশন + ব্লাড স্ট্যাটাস/রেসপন্স — একাধিক
  // সিকোয়েন্সিয়াল কোয়েরি) অপেক্ষা করে তারপর চলত, যার কারণে push
  // ট্যাপ করে ঢুকলে পপ-আপ আসতে ২-৫ সেকেন্ড দেরি হতো। এখন init() এ
  // এটা loadNotifications() এর আগে, সবার আগে চালানো হয় (নিচে init()
  // দেখুন) — সরাসরি নির্দিষ্ট আইডি দিয়ে একবারে ফেচ করে, আর ব্লাড
  // রিকোয়েস্ট হলে তার স্ট্যাটাস/রেসপন্স/স্কিপ — এই ৩টা কোয়েরি
  // সমান্তরালে (Promise.all) চালায় — ফলে পুরো ২০টা নোটিফিকেশনের
  // লিস্ট + প্রতিটার ব্লাড স্ট্যাটাস লোড হওয়ার জন্য আর অপেক্ষা করতে
  // হয় না।
  async function checkDeepLinkNotification() {
    const params = new URLSearchParams(window.location.search);
    const notifId = params.get('notif');
    if (!notifId) return false;

    // URL পরিষ্কার করা (পরে রিফ্রেশ করলে যেন আবার অটো-ওপেন না হয়)
    params.delete('notif');
    const newUrl = window.location.pathname + (params.toString() ? `?${params}` : '');
    window.history.replaceState({}, '', newUrl);

    const { data: target } = await supabase
      .from('user_notifications')
      .select('*')
      .eq('id', notifId)
      .maybeSingle();

    if (!target) return false;

    if (target.category === 'blood_request' && target.related_entity_id) {
      const reqId = target.related_entity_id;
      const [{ data: statusRow }, { data: responseRows }, { data: skipRows }] = await Promise.all([
        supabase.from('blood_requests').select('id, status').eq('id', reqId).maybeSingle(),
        supabase.from('blood_request_responses').select('blood_request_id').eq('donor_user_id', currentUserId).eq('blood_request_id', reqId),
        supabase.from('blood_request_skips').select('blood_request_id').eq('user_id', currentUserId).eq('blood_request_id', reqId),
      ]);
      if (statusRow) bloodStatusMap.set(statusRow.id, statusRow.status);
      if (responseRows?.length) respondedSet.add(reqId);
      if (skipRows?.length) skippedSet.add(reqId);
    }

    openNotifModal(target);
    return true;
  }

  // নতুন — অ্যাপ/সাইট সরাসরি ওপেন করলে (push ট্যাপ ছাড়াই — push অফ
  // থাকলে, মিস হলে, বা push ইগনোর করে সরাসরি অ্যাপে ঢুকলেও) কোনো
  // unread নোটিফিকেশন থাকলে সেটা অটো পপ-আপ দেখাবে। একই অ্যাপ
  // সেশনে (ট্যাব/অ্যাপ বন্ধ না হওয়া পর্যন্ত) একবারই দেখাবে — সাইটের
  // ভেতরে পেজ-টু-পেজ ক্লিক করার সময় বারবার দেখাবে না। এর মধ্যে নতুন
  // নোটিফিকেশন এলে সেটা আলাদাভাবে Realtime সাবস্ক্রিপশন (উপরে) দিয়ে
  // সাথে সাথে দেখানো হয়, এই ফাংশনের সাথে সম্পর্ক নেই।
  function checkAutoPopupOnEntry() {
    if (sessionStorage.getItem('sf_notif_autopopup_shown')) return;

    const unread = latestNotifications.find((n) => !n.is_read);
    if (!unread) return;

    sessionStorage.setItem('sf_notif_autopopup_shown', '1');
    openNotifModal(unread);
  }

  function openDrawer() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay?.classList.remove('open');
    if (!modalOverlay.classList.contains('open')) {
      document.body.style.overflow = '';
    }
  }

  window.addEventListener('smartfeni:open-notification-drawer', () => {
    openDrawer();
    loadNotifications();
  });

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDrawer();
  });

  notifMarkAllBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    await supabase.from('user_notifications').update({ is_read: true }).eq('user_id', user.id).eq('is_read', false);
    loadNotifications();
  });

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    currentUserId = session.user.id;

    // push ডীপ-লিংক থাকলে সেটা সবার আগে, আলাদাভাবে, দ্রুত চেক করা
    // হয় (নিজের প্রয়োজনীয় ২-৩টা ছোট কোয়েরি ছাড়া আর কিছুর জন্য
    // অপেক্ষা করে না) — তারপর পুরো ২০টা নোটিফিকেশনের লিস্ট +
    // ব্লাড স্ট্যাটাস ম্যাপ ব্যাকগ্রাউন্ডে লোড হয় (ড্রয়ার লিস্টের জন্য)
    const deepLinkHandled = await checkDeepLinkNotification();
    await loadNotifications();

    if (!deepLinkHandled) {
      checkAutoPopupOnEntry();
    }
  }

  init();

  window.addEventListener('smartfeni:auth-changed', () => {
    loadNotifications();
  });

  window.addEventListener('smartfeni:logged-out', () => {
    latestNotifications = [];
    updateBadgeCount();
    unsubscribeRealtime();
  });
</script>
