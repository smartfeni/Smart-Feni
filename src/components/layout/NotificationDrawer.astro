---
// ============================================================
// কম্পোনেন্ট: নোটিফিকেশন স্লাইড-ইন ড্রয়ার
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (Blood Request ফিচার): category='blood_request' নোটিফিকেশনে
// ইনলাইন "স্কিপ" / "আমি রক্তদানে আগ্রহী" বাটন, লাইভ status চেক।
//
// আপডেট (Phase 2 — ছবি): ছবি থাম্বনেইল + ফুলস্ক্রিন লাইটবক্স।
//
// আপডেট (এই সেশন — HungerStation-স্টাইল ডিটেইল ভিউ):
// - আগে লিস্ট আইটেমে ক্লিক করলে ইনলাইন টেক্সট ক্লাম্প/এক্সপান্ড হতো,
//   এখন একটা পূর্ণাঙ্গ ফুল-স্ক্রিন ডিটেইল ভিউ খোলে (ক্যাটাগরি চিপ,
//   তারিখ, বড় ছবি, সম্পূর্ণ টেক্সট) — যেভাবে HungerStation এর
//   Inbox কাজ করে
// - ছবি ট্যাপ ও টেক্সট/আইটেম ট্যাপ এখন সম্পূর্ণ আলাদা এরিয়া —
//   ছবি ট্যাপে শুধু লাইটবক্স খোলে (stopPropagation), বাকি এরিয়া
//   ট্যাপে ডিটেইল ভিউ খোলে, কনফ্লিক্ট নাই
// - push notification ক্লিক করলে sw.js এখন ?notif={id} সহ URL এ
//   পাঠায় — পেজ লোড হলে এই প্যারামিটার পড়ে সরাসরি সেই নোটিফিকেশনের
//   ডিটেইল ভিউ অটো-ওপেন হয় (bell আইকনে আলাদা করে ক্লিক করা লাগে না)
// ============================================================
---

<div class="nd-overlay" id="notificationDrawerOverlay">
  <aside class="nd-panel" id="notificationDrawerPanel">
    <!-- ===== লিস্ট ভিউ ===== -->
    <div class="nd-view" id="notifListView">
      <div class="nd-header">
        <h2><i class="fas fa-bell"></i> নোটিফিকেশন</h2>
        <div class="nd-header-actions">
          <button id="notifMarkAllBtn" type="button">সব পড়া হয়েছে</button>
          <button class="nd-close" id="notificationDrawerClose" aria-label="বন্ধ করুন">
            <i class="fas fa-xmark"></i>
          </button>
        </div>
      </div>

      <div class="nd-list" id="notifList"></div>

      <p class="nd-empty" id="notifEmpty" style="display:none;">
        <i class="fas fa-bell-slash"></i>
        কোনো নোটিফিকেশন নেই
      </p>
    </div>

    <!-- ===== ফুল-স্ক্রিন ডিটেইল ভিউ (নতুন — HungerStation স্টাইল) ===== -->
    <div class="nd-view nd-detail-view" id="notifDetailView" style="display:none;">
      <div class="nd-detail-header">
        <button class="nd-back" id="notifDetailBackBtn" type="button" aria-label="ফিরে যান">
          <i class="fas fa-arrow-left"></i>
        </button>
        <h2>নোটিফিকেশন</h2>
      </div>
      <div class="nd-detail-body" id="notifDetailBody"></div>
    </div>
  </aside>
</div>

<!-- ছবি ফুলস্ক্রিন লাইটবক্স -->
<div class="nd-lightbox" id="imgLightbox">
  <button type="button" class="nd-lightbox-close" id="imgLightboxClose" aria-label="বন্ধ করুন">
    <i class="fas fa-xmark"></i>
  </button>
  <img id="imgLightboxImg" src="" alt="" />
</div>

<style>
  .nd-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 2200;
  }

  .nd-overlay.open {
    display: block;
  }

  .nd-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 88vw);
    background: #fff;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
    overflow: hidden;
  }

  .nd-overlay.open .nd-panel {
    transform: translateX(0);
  }

  .nd-view {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .nd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 18px 16px 20px;
    border-bottom: 1px solid #EEF3F9;
    gap: 8px;
  }

  .nd-header h2 {
    font-size: 1.05rem;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .nd-header h2 i {
    color: #FF6B35;
    font-size: 0.95rem;
  }

  .nd-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .nd-header-actions button#notifMarkAllBtn {
    background: none;
    border: none;
    color: #FF6B35;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .nd-header-actions button#notifMarkAllBtn:hover {
    background: #FFF0EA;
  }

  .nd-close {
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nd-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .nd-list {
    flex: 1;
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .nd-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: #B0BCCB;
    font-size: 0.85rem;
    padding: 60px 24px;
    margin: 0;
  }

  .nd-empty i {
    font-size: 1.8rem;
    color: #D7E0EC;
  }

  /* ===== ফুল-স্ক্রিন ডিটেইল ভিউ (নতুন) ===== */
  .nd-detail-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border-bottom: 1px solid #EEF3F9;
  }

  .nd-detail-header h2 {
    font-size: 1.05rem;
    color: #1B2A4A;
    font-weight: 700;
  }

  .nd-back {
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #1B2A4A;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nd-back:hover {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .nd-detail-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    padding-bottom: calc(20px + env(safe-area-inset-bottom));
  }

  /* ===== ছবি ফুলস্ক্রিন লাইটবক্স ===== */
  .nd-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 2400;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .nd-lightbox.open {
    display: flex;
  }

  .nd-lightbox img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 8px;
    object-fit: contain;
  }

  .nd-lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    color: #fff;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<!-- ============================================================
  is:global — .notif-item, .nd-detail-* এলিমেন্টগুলো JS দিয়ে
  ডাইনামিকালি বানানো হয় বলে Astro এর স্কোপড CSS এদের উপর বসে না।
============================================================ -->
<style is:global>
  .notif-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #F4F7FC;
    padding: 14px 20px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease;
  }

  .notif-item:last-child {
    border-bottom: none;
  }

  .notif-item:hover {
    background: #F8FAFC;
  }

  .notif-item.unread {
    background: #FFF8F5;
  }

  .notif-item.unread:hover {
    background: #FFF0EA;
  }

  .notif-item-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    position: relative;
  }

  .notif-item.unread .notif-item-icon {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .notif-item.unread .notif-item-icon::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #FF6B35;
    border: 2px solid #fff;
  }

  .notif-item-body {
    flex: 1;
    min-width: 0;
  }

  .notif-item-msg {
    font-size: 0.84rem;
    color: #1B2A4A;
    line-height: 1.5;
    white-space: pre-line;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .notif-item.unread .notif-item-msg {
    font-weight: 600;
  }

  .notif-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
  }

  .notif-item-time {
    font-size: 0.72rem;
    color: #8FA0BC;
  }

  .notif-item-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #FF6B35;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .notif-item-link:hover {
    text-decoration: underline;
  }

  .notif-blood-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  .notif-blood-btn {
    flex: 1;
    border: none;
    border-radius: 30px;
    padding: 8px 10px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  .notif-blood-btn.skip {
    background: #F4F7FC;
    color: #5A6E85;
  }

  .notif-blood-btn.interested {
    background: #D14343;
    color: #fff;
  }

  .notif-blood-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .notif-blood-status {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    background: #E7F8EE;
    color: #1E9E5A;
  }

  .notif-item-image {
    width: 100%;
    max-height: 140px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 8px;
    cursor: zoom-in;
  }

  /* ===== ডিটেইল ভিউয়ের ভেতরের কনটেন্ট (নতুন — HungerStation স্টাইল) ===== */
  .nd-detail-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .nd-detail-chip {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 20px;
    background: #F1F4F8;
    color: #5A6E85;
  }

  .nd-detail-chip.chip-blood_request,
  .nd-detail-chip.chip-blood_response {
    background: #FDEAEA;
    color: #D14343;
  }

  .nd-detail-chip.chip-promo {
    background: #FDF0D5;
    color: #B36B00;
  }

  .nd-detail-chip.chip-delivery_hero,
  .nd-detail-chip.chip-rider_offer,
  .nd-detail-chip.chip-shop_order {
    background: #E8F2FF;
    color: #1D6FE0;
  }

  .nd-detail-date {
    font-size: 0.78rem;
    color: #9AA8BC;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .nd-detail-image {
    width: 100%;
    border-radius: 14px;
    margin-bottom: 18px;
    cursor: zoom-in;
  }

  .nd-detail-text {
    font-size: 0.95rem;
    color: #1B2A4A;
    line-height: 1.8;
    white-space: pre-line;
    margin-bottom: 18px;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const overlay = document.getElementById('notificationDrawerOverlay');
  const closeBtn = document.getElementById('notificationDrawerClose');
  const notifList = document.getElementById('notifList');
  const notifEmpty = document.getElementById('notifEmpty');
  const notifMarkAllBtn = document.getElementById('notifMarkAllBtn');

  const listView = document.getElementById('notifListView');
  const detailView = document.getElementById('notifDetailView');
  const detailBody = document.getElementById('notifDetailBody');
  const detailBackBtn = document.getElementById('notifDetailBackBtn');

  const imgLightbox = document.getElementById('imgLightbox');
  const imgLightboxImg = document.getElementById('imgLightboxImg');
  const imgLightboxClose = document.getElementById('imgLightboxClose');

  let currentUserId = null;
  let latestNotifications = [];
  let bloodStatusMap = new Map();
  let respondedSet = new Set();

  const categoryChipLabels = {
    listing_status: 'লিস্টিং স্ট্যাটাস',
    delivery_hero: 'ডেলিভারি হিরো',
    blood_request: 'ব্লাড রিকোয়েস্ট',
    blood_response: 'ব্লাড রেসপন্স',
    rider_offer: 'রাইডার অফার',
    shop_order: 'অর্ডার',
    promo: 'অফার-প্রমো',
    message: 'মেসেজ',
    system: 'সিস্টেম',
  };

  function toBnDigits(num) {
    const bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    return num.toString().replace(/[0-9]/g, (d) => bn[d]);
  }

  function relativeTimeBn(dateString) {
    const then = new Date(dateString);
    const diffSec = Math.floor((Date.now() - then.getTime()) / 1000);
    const diffMin = Math.floor(diffSec / 60);
    const diffHour = Math.floor(diffMin / 60);
    const diffDay = Math.floor(diffHour / 24);

    if (diffSec < 60) return 'এইমাত্র';
    if (diffMin < 60) return `${toBnDigits(diffMin)} মিনিট আগে`;
    if (diffHour < 24) return `${toBnDigits(diffHour)} ঘণ্টা আগে`;
    if (diffDay < 30) return `${toBnDigits(diffDay)} দিন আগে`;
    return `${toBnDigits(Math.floor(diffDay / 30))} মাস আগে`;
  }

  function absoluteDateBn(dateString) {
    const d = new Date(dateString);
    return d.toLocaleDateString('bn-BD', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  function bloodStatusLabel(status) {
    if (status === 'fulfilled') return '✅ এই রিকোয়েস্টটি ম্যানেজ হয়ে গেছে';
    if (status === 'expired') return '⏱️ এই রিকোয়েস্টের মেয়াদ শেষ হয়ে গেছে';
    if (status === 'cancelled') return '❌ এই রিকোয়েস্টটি বাতিল করা হয়েছে';
    return null;
  }

  // ============================================================
  // লাইটবক্স
  // ============================================================
  function openLightbox(src) {
    imgLightboxImg.src = src;
    imgLightbox.classList.add('open');
  }

  function closeLightbox() {
    imgLightbox.classList.remove('open');
    imgLightboxImg.src = '';
  }

  imgLightboxClose?.addEventListener('click', closeLightbox);
  imgLightbox?.addEventListener('click', (e) => {
    if (e.target === imgLightbox) closeLightbox();
  });

  // ============================================================
  // মার্ক রিড (হেল্পার, সব জায়গায় রিইউজ)
  // ============================================================
  async function markRead(n) {
    if (n.is_read) return;
    n.is_read = true;
    await supabase.from('user_notifications').update({ is_read: true }).eq('id', n.id);
    updateBadgeCount();
  }

  // ============================================================
  // ফুল-স্ক্রিন ডিটেইল ভিউ (নতুন — HungerStation স্টাইল)
  // ============================================================
  function renderBloodActionHtml(n) {
    const isBloodRequest = n.category === 'blood_request' && n.related_entity_id;
    if (!isBloodRequest) return '';

    const status = bloodStatusMap.get(n.related_entity_id) || 'active';
    const alreadyResponded = respondedSet.has(n.related_entity_id);
    const doneLabel = bloodStatusLabel(status) || (alreadyResponded ? '✅ আপনি আগ্রহ জানিয়েছেন' : null);

    if (doneLabel) {
      return `<span class="notif-blood-status">${doneLabel}</span>`;
    }

    return `
      <span class="notif-blood-actions">
        <button type="button" class="notif-blood-btn skip" data-blood-skip>স্কিপ</button>
        <button type="button" class="notif-blood-btn interested" data-blood-interested data-request-id="${n.related_entity_id}">আমি রক্তদানে আগ্রহী</button>
      </span>
    `;
  }

  function wireBloodActionButtons(container, n) {
    const actionsRow = container.querySelector('.notif-blood-actions');

    const skipBtn = container.querySelector('[data-blood-skip]');
    skipBtn?.addEventListener('click', async () => {
      actionsRow?.remove();
      await markRead(n);
    });

    const interestedBtn = container.querySelector('[data-blood-interested]');
    interestedBtn?.addEventListener('click', async () => {
      const requestId = interestedBtn.getAttribute('data-request-id');
      interestedBtn.disabled = true;
      skipBtn.disabled = true;
      interestedBtn.textContent = 'পাঠানো হচ্ছে...';

      const { data, error } = await supabase.rpc('respond_to_blood_request', {
        p_blood_request_id: requestId,
        p_donor_user_id: currentUserId,
      });

      if (error || !data?.success) {
        const alreadyManaged = data?.error === 'already_managed';
        const label = alreadyManaged
          ? bloodStatusLabel(data.status) || 'এই রিকোয়েস্টটি ইতিমধ্যে ম্যানেজ হয়ে গেছে'
          : 'কিছু ভুল হয়েছে, আবার চেষ্টা করুন';
        const span = document.createElement('span');
        span.className = 'notif-blood-status';
        span.textContent = label;
        actionsRow?.replaceWith(span);
        return;
      }

      respondedSet.add(requestId);
      const span = document.createElement('span');
      span.className = 'notif-blood-status';
      span.textContent = '✅ আপনার আগ্রহ জানানো হয়েছে, রিকোয়েস্টার শীঘ্রই যোগাযোগ করবেন';
      actionsRow?.replaceWith(span);
      await markRead(n);
    });
  }

  function openDetailView(n) {
    detailBody.innerHTML = `
      <div class="nd-detail-chips">
        <span class="nd-detail-chip chip-${n.category}">${categoryChipLabels[n.category] || 'নোটিফিকেশন'}</span>
      </div>
      <p class="nd-detail-date">${absoluteDateBn(n.created_at)}</p>
      ${n.image_url ? `<img src="${n.image_url}" alt="" class="nd-detail-image" data-detail-image />` : ''}
      <p class="nd-detail-text">${escapeHtml(n.message)}</p>
      ${n.listing_id ? '<button type="button" class="notif-item-link" data-open-listing>সম্পর্কিত লিস্টিং দেখুন →</button>' : ''}
      <div data-blood-slot>${renderBloodActionHtml(n)}</div>
    `;

    const detailImage = detailBody.querySelector('[data-detail-image]');
    detailImage?.addEventListener('click', () => openLightbox(n.image_url));

    const linkBtn = detailBody.querySelector('[data-open-listing]');
    linkBtn?.addEventListener('click', () => {
      window.location.href = `/listing/${n.listing_id}`;
    });

    wireBloodActionButtons(detailBody, n);

    listView.style.display = 'none';
    detailView.style.display = 'flex';

    markRead(n);
  }

  function closeDetailView() {
    detailView.style.display = 'none';
    listView.style.display = 'flex';
  }

  detailBackBtn?.addEventListener('click', closeDetailView);

  // ============================================================
  // লিস্ট ভিউ রেন্ডার
  // ============================================================
  function renderNotifications(items) {
    notifList.innerHTML = '';

    if (!items || items.length === 0) {
      notifEmpty.style.display = 'flex';
      return;
    }
    notifEmpty.style.display = 'none';

    items.forEach((n) => {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = `notif-item ${n.is_read ? '' : 'unread'}`;
      el.innerHTML = `
        <span class="notif-item-icon"><i class="fas fa-bell"></i></span>
        <span class="notif-item-body">
          ${n.image_url ? `<img src="${n.image_url}" alt="" class="notif-item-image" data-view-image />` : ''}
          <span class="notif-item-msg">${escapeHtml(n.message)}</span>
          <span class="notif-item-footer">
            <span class="notif-item-time">${relativeTimeBn(n.created_at)}</span>
          </span>
        </span>
      `;

      // ছবি ট্যাপ — শুধু লাইটবক্স খুলবে, ডিটেইল ভিউ খুলবে না
      const imageEl = el.querySelector('[data-view-image]');
      imageEl?.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(n.image_url);
      });

      // বাকি পুরো আইটেম ট্যাপ — ফুল-স্ক্রিন ডিটেইল ভিউ খুলবে
      el.addEventListener('click', () => openDetailView(n));

      notifList.appendChild(el);
    });
  }

  function updateBadgeCount() {
    const unreadCount = latestNotifications.filter((n) => !n.is_read).length;
    window.dispatchEvent(
      new CustomEvent('smartfeni:notification-count', { detail: { count: unreadCount } })
    );
  }

  // ============================================================
  // লোড + deep-link হ্যান্ডলিং (?notif=xxx)
  // ============================================================
  async function loadNotifications() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      currentUserId = null;
      latestNotifications = [];
      renderNotifications([]);
      updateBadgeCount();
      return;
    }

    currentUserId = session.user.id;

    const { data, error } = await supabase
      .from('user_notifications')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(20);

    if (error) return;

    latestNotifications = data || [];

    const bloodRequestIds = latestNotifications
      .filter((n) => n.category === 'blood_request' && n.related_entity_id)
      .map((n) => n.related_entity_id);

    bloodStatusMap = new Map();
    respondedSet = new Set();

    if (bloodRequestIds.length > 0) {
      const { data: statusRows } = await supabase
        .from('blood_requests')
        .select('id, status')
        .in('id', bloodRequestIds);

      (statusRows || []).forEach((r) => bloodStatusMap.set(r.id, r.status));

      const { data: responseRows } = await supabase
        .from('blood_request_responses')
        .select('blood_request_id')
        .eq('donor_user_id', currentUserId)
        .in('blood_request_id', bloodRequestIds);

      (responseRows || []).forEach((r) => respondedSet.add(r.blood_request_id));
    }

    renderNotifications(latestNotifications);
    updateBadgeCount();
  }

  // পেজ লোড হওয়ার সময় (বা push নোটিফিকেশনে ক্লিক করে আসলে) URL এ
  // ?notif=xxx থাকলে সরাসরি সেই নোটিফিকেশনের ডিটেইল ভিউ অটো-ওপেন করা
  async function checkDeepLinkNotification() {
    const params = new URLSearchParams(window.location.search);
    const notifId = params.get('notif');
    if (!notifId) return;

    // URL পরিষ্কার করা (পরে রিফ্রেশ করলে যেন আবার অটো-ওপেন না হয়)
    params.delete('notif');
    const newUrl = window.location.pathname + (params.toString() ? `?${params}` : '');
    window.history.replaceState({}, '', newUrl);

    let target = latestNotifications.find((n) => n.id === notifId);

    if (!target) {
      // সাম্প্রতিক ২০টার মধ্যে না থাকলে (পুরনো নোটিফিকেশন) সরাসরি ফেচ
      const { data } = await supabase
        .from('user_notifications')
        .select('*')
        .eq('id', notifId)
        .maybeSingle();
      target = data;
    }

    if (!target) return;

    openDrawer();
    openDetailView(target);
  }

  function openDrawer() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
    closeDetailView();
  }

  window.addEventListener('smartfeni:open-notification-drawer', () => {
    openDrawer();
    loadNotifications();
  });

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDrawer();
  });

  notifMarkAllBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    await supabase.from('user_notifications').update({ is_read: true }).eq('user_id', user.id).eq('is_read', false);
    loadNotifications();
  });

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    await loadNotifications();
    await checkDeepLinkNotification();
  }

  init();

  window.addEventListener('smartfeni:auth-changed', () => {
    loadNotifications();
  });

  window.addEventListener('smartfeni:logged-out', () => {
    latestNotifications = [];
    updateBadgeCount();
  });
</script>
