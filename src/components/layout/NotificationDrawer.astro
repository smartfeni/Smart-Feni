<!-- path: src/components/layout/NotificationDrawer.astro -->
---
// ============================================================
// কম্পোনেন্ট: নোটিফিকেশন স্লাইড-ইন ড্রয়ার
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (Blood Request ফিচার): category='blood_request' নোটিফিকেশনে
// এখন ইনলাইন "স্কিপ" / "আমি রক্তদানে আগ্রহী" বাটন দেখাবে। রিকোয়েস্টের
// লাইভ status (blood_requests টেবিল থেকে ব্যাচে ফেচ করা) চেক করে —
// active না থাকলে বাটনের বদলে "ইতিমধ্যে ম্যানেজ হয়ে গেছে" লেখা দেখাবে।
// "আগ্রহী" চাপলে respond_to_blood_request() RPC কল হয়।
// ============================================================
---

<div class="nd-overlay" id="notificationDrawerOverlay">
  <aside class="nd-panel" id="notificationDrawerPanel">
    <div class="nd-header">
      <h2><i class="fas fa-bell"></i> নোটিফিকেশন</h2>
      <div class="nd-header-actions">
        <button id="notifMarkAllBtn" type="button">সব পড়া হয়েছে</button>
        <button class="nd-close" id="notificationDrawerClose" aria-label="বন্ধ করুন">
          <i class="fas fa-xmark"></i>
        </button>
      </div>
    </div>

    <div class="nd-list" id="notifList"></div>

    <p class="nd-empty" id="notifEmpty" style="display:none;">
      <i class="fas fa-bell-slash"></i>
      কোনো নোটিফিকেশন নেই
    </p>
  </aside>
</div>

<!-- ছবি ফুলস্ক্রিন লাইটবক্স (নতুন — Phase 2) -->
<div class="nd-lightbox" id="imgLightbox">
  <button type="button" class="nd-lightbox-close" id="imgLightboxClose" aria-label="বন্ধ করুন">
    <i class="fas fa-xmark"></i>
  </button>
  <img id="imgLightboxImg" src="" alt="" />
</div>

<style>
  .nd-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 2200;
  }

  .nd-overlay.open {
    display: block;
  }

  .nd-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 88vw);
    background: #fff;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }

  .nd-overlay.open .nd-panel {
    transform: translateX(0);
  }

  .nd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 18px 16px 20px;
    border-bottom: 1px solid #EEF3F9;
    gap: 8px;
  }

  .nd-header h2 {
    font-size: 1.05rem;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .nd-header h2 i {
    color: #FF6B35;
    font-size: 0.95rem;
  }

  .nd-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .nd-header-actions button#notifMarkAllBtn {
    background: none;
    border: none;
    color: #FF6B35;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .nd-header-actions button#notifMarkAllBtn:hover {
    background: #FFF0EA;
  }

  .nd-close {
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nd-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .nd-list {
    flex: 1;
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .nd-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: #B0BCCB;
    font-size: 0.85rem;
    padding: 60px 24px;
    margin: 0;
  }

  .nd-empty i {
    font-size: 1.8rem;
    color: #D7E0EC;
  }

  /* ===== ছবি ফুলস্ক্রিন লাইটবক্স (নতুন) ===== */
  .nd-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 2400;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .nd-lightbox.open {
    display: flex;
  }

  .nd-lightbox img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 8px;
    object-fit: contain;
  }

  .nd-lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    color: #fff;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<!-- ============================================================
  is:global — .notif-item এলিমেন্টগুলো JS দিয়ে ডাইনামিকালি বানানো
  হয় বলে Astro এর স্কোপড CSS এদের উপর বসে না (Header.astro থেকে
  অপরিবর্তিত রাখা হয়েছে)।
============================================================ -->
<style is:global>
  .notif-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #F4F7FC;
    padding: 14px 20px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease;
  }

  .notif-item:last-child {
    border-bottom: none;
  }

  .notif-item:hover {
    background: #F8FAFC;
  }

  .notif-item.unread {
    background: #FFF8F5;
  }

  .notif-item.unread:hover {
    background: #FFF0EA;
  }

  .notif-item-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    position: relative;
  }

  .notif-item.unread .notif-item-icon {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .notif-item.unread .notif-item-icon::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #FF6B35;
    border: 2px solid #fff;
  }

  .notif-item-body {
    flex: 1;
    min-width: 0;
  }

  .notif-item-msg {
    font-size: 0.84rem;
    color: #1B2A4A;
    line-height: 1.5;
    white-space: pre-line;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .notif-item-msg.expanded {
    -webkit-line-clamp: unset;
    display: block;
  }

  .notif-item.unread .notif-item-msg {
    font-weight: 600;
  }

  .notif-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
  }

  .notif-item-time {
    font-size: 0.72rem;
    color: #8FA0BC;
  }

  .notif-item-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #FF6B35;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .notif-item-link:hover {
    text-decoration: underline;
  }

  /* ===== Blood Request ইনলাইন বাটন (নতুন) ===== */
  .notif-blood-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  .notif-blood-btn {
    flex: 1;
    border: none;
    border-radius: 30px;
    padding: 8px 10px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  .notif-blood-btn.skip {
    background: #F4F7FC;
    color: #5A6E85;
  }

  .notif-blood-btn.interested {
    background: #D14343;
    color: #fff;
  }

  .notif-blood-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .notif-blood-status {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    background: #E7F8EE;
    color: #1E9E5A;
  }

  /* ===== নোটিফিকেশনের ছবি থাম্বনেইল (নতুন — Phase 2) ===== */
  .notif-item-image {
    width: 100%;
    max-height: 140px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 8px;
    cursor: zoom-in;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const overlay = document.getElementById('notificationDrawerOverlay');
  const closeBtn = document.getElementById('notificationDrawerClose');
  const notifList = document.getElementById('notifList');
  const notifEmpty = document.getElementById('notifEmpty');
  const notifMarkAllBtn = document.getElementById('notifMarkAllBtn');

  // ===== ছবি লাইটবক্স (নতুন) =====
  const imgLightbox = document.getElementById('imgLightbox');
  const imgLightboxImg = document.getElementById('imgLightboxImg');
  const imgLightboxClose = document.getElementById('imgLightboxClose');

  function openLightbox(src) {
    imgLightboxImg.src = src;
    imgLightbox.classList.add('open');
  }

  function closeLightbox() {
    imgLightbox.classList.remove('open');
    imgLightboxImg.src = '';
  }

  imgLightboxClose?.addEventListener('click', closeLightbox);
  imgLightbox?.addEventListener('click', (e) => {
    if (e.target === imgLightbox) closeLightbox();
  });

  let currentUserId = null;

  function toBnDigits(num) {
    const bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    return num.toString().replace(/[0-9]/g, (d) => bn[d]);
  }

  function relativeTimeBn(dateString) {
    const then = new Date(dateString);
    const diffSec = Math.floor((Date.now() - then.getTime()) / 1000);
    const diffMin = Math.floor(diffSec / 60);
    const diffHour = Math.floor(diffMin / 60);
    const diffDay = Math.floor(diffHour / 24);

    if (diffSec < 60) return 'এইমাত্র';
    if (diffMin < 60) return `${toBnDigits(diffMin)} মিনিট আগে`;
    if (diffHour < 24) return `${toBnDigits(diffHour)} ঘণ্টা আগে`;
    if (diffDay < 30) return `${toBnDigits(diffDay)} দিন আগে`;
    return `${toBnDigits(Math.floor(diffDay / 30))} মাস আগে`;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  let latestNotifications = [];

  // ============================================================
  // Blood Request status লেবেল (Bengali)
  // ============================================================
  function bloodStatusLabel(status) {
    if (status === 'fulfilled') return '✅ এই রিকোয়েস্টটি ম্যানেজ হয়ে গেছে';
    if (status === 'expired') return '⏱️ এই রিকোয়েস্টের মেয়াদ শেষ হয়ে গেছে';
    if (status === 'cancelled') return '❌ এই রিকোয়েস্টটি বাতিল করা হয়েছে';
    return null;
  }

  async function renderNotifications(items, bloodStatusMap, respondedSet) {
    notifList.innerHTML = '';

    if (!items || items.length === 0) {
      notifEmpty.style.display = 'flex';
      return;
    }
    notifEmpty.style.display = 'none';

    items.forEach((n) => {
      const isBloodRequest = n.category === 'blood_request' && n.related_entity_id;
      const bloodStatus = isBloodRequest ? (bloodStatusMap.get(n.related_entity_id) || 'active') : null;
      const alreadyResponded = isBloodRequest && respondedSet.has(n.related_entity_id);
      const bloodDoneLabel = isBloodRequest
        ? (bloodStatusLabel(bloodStatus) || (alreadyResponded ? '✅ আপনি আগ্রহ জানিয়েছেন' : null))
        : null;

      const el = document.createElement('button');
      el.type = 'button';
      el.className = `notif-item ${n.is_read ? '' : 'unread'}`;
      el.innerHTML = `
        <span class="notif-item-icon"><i class="fas fa-bell"></i></span>
        <span class="notif-item-body">
          ${n.image_url ? `<img src="${n.image_url}" alt="" class="notif-item-image" data-view-image />` : ''}
          <span class="notif-item-msg">${escapeHtml(n.message)}</span>
          <span class="notif-item-footer">
            <span class="notif-item-time">${relativeTimeBn(n.created_at)}</span>
            ${n.listing_id ? '<button type="button" class="notif-item-link" data-open-listing>সম্পর্কিত লিস্টিং দেখুন →</button>' : ''}
          </span>
          ${
            isBloodRequest
              ? bloodDoneLabel
                ? `<span class="notif-blood-status">${bloodDoneLabel}</span>`
                : `<span class="notif-blood-actions">
                    <button type="button" class="notif-blood-btn skip" data-blood-skip>স্কিপ</button>
                    <button type="button" class="notif-blood-btn interested" data-blood-interested data-request-id="${n.related_entity_id}">আমি রক্তদানে আগ্রহী</button>
                  </span>`
              : ''
          }
        </span>
      `;

      // মূল আইটেমে ক্লিক করলে — টেক্সট এক্সপ্যান্ড/কোলাপ্স + read মার্ক
      el.addEventListener('click', async () => {
        const msgEl = el.querySelector('.notif-item-msg');
        msgEl.classList.toggle('expanded');

        if (!n.is_read) {
          n.is_read = true;
          el.classList.remove('unread');
          await supabase.from('user_notifications').update({ is_read: true }).eq('id', n.id);
          updateBadgeCount();
        }
      });

      // "সম্পর্কিত লিস্টিং দেখুন"
      const linkBtn = el.querySelector('[data-open-listing]');
      linkBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        window.location.href = `/listing/${n.listing_id}`;
      });

      // ছবি থাম্বনেইলে ক্লিক করলে ফুলস্ক্রিন লাইটবক্স খোলা (নতুন — Phase 2)
      const imageEl = el.querySelector('[data-view-image]');
      imageEl?.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(n.image_url);
      });

      // "স্কিপ" — শুধু read মার্ক করে বাটন সরিয়ে দেওয়া, কোনো DB action নাই
      const skipBtn = el.querySelector('[data-blood-skip]');
      skipBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        const actionsRow = el.querySelector('.notif-blood-actions');
        actionsRow?.remove();
        if (!n.is_read) {
          n.is_read = true;
          el.classList.remove('unread');
          await supabase.from('user_notifications').update({ is_read: true }).eq('id', n.id);
          updateBadgeCount();
        }
      });

      // "আমি রক্তদানে আগ্রহী" — respond_to_blood_request() RPC কল
      const interestedBtn = el.querySelector('[data-blood-interested]');
      interestedBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        const btn = e.currentTarget;
        const requestId = btn.getAttribute('data-request-id');
        const actionsRow = el.querySelector('.notif-blood-actions');

        btn.disabled = true;
        el.querySelector('[data-blood-skip]').disabled = true;
        btn.textContent = 'পাঠানো হচ্ছে...';

        const { data, error } = await supabase.rpc('respond_to_blood_request', {
          p_blood_request_id: requestId,
          p_donor_user_id: currentUserId,
        });

        if (error || !data?.success) {
          const alreadyManaged = data?.error === 'already_managed';
          const label = alreadyManaged
            ? bloodStatusLabel(data.status) || 'এই রিকোয়েস্টটি ইতিমধ্যে ম্যানেজ হয়ে গেছে'
            : 'কিছু ভুল হয়েছে, আবার চেষ্টা করুন';
          const span = document.createElement('span');
          span.className = alreadyManaged ? 'notif-blood-status' : 'notif-blood-status';
          span.textContent = label;
          actionsRow?.replaceWith(span);
          return;
        }

        const span = document.createElement('span');
        span.className = 'notif-blood-status';
        span.textContent = '✅ আপনার আগ্রহ জানানো হয়েছে, রিকোয়েস্টার শীঘ্রই যোগাযোগ করবেন';
        actionsRow?.replaceWith(span);

        if (!n.is_read) {
          n.is_read = true;
          el.classList.remove('unread');
          await supabase.from('user_notifications').update({ is_read: true }).eq('id', n.id);
          updateBadgeCount();
        }
      });

      notifList.appendChild(el);
    });
  }

  function updateBadgeCount() {
    const unreadCount = latestNotifications.filter((n) => !n.is_read).length;
    window.dispatchEvent(
      new CustomEvent('smartfeni:notification-count', { detail: { count: unreadCount } })
    );
  }

  async function loadNotifications() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      currentUserId = null;
      latestNotifications = [];
      renderNotifications([], new Map(), new Set());
      updateBadgeCount();
      return;
    }

    currentUserId = session.user.id;

    const { data, error } = await supabase
      .from('user_notifications')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(20);

    if (error) return;

    latestNotifications = data || [];

    // Blood request category এর সব related_entity_id ব্যাচে ফেচ করা —
    // প্রতিটার জন্য আলাদা কোয়েরি না করে একবারেই status ম্যাপ বানানো
    const bloodRequestIds = latestNotifications
      .filter((n) => n.category === 'blood_request' && n.related_entity_id)
      .map((n) => n.related_entity_id);

    const bloodStatusMap = new Map();
    const respondedSet = new Set();
    if (bloodRequestIds.length > 0) {
      const { data: statusRows } = await supabase
        .from('blood_requests')
        .select('id, status')
        .in('id', bloodRequestIds);

      (statusRows || []).forEach((r) => bloodStatusMap.set(r.id, r.status));

      // এই ডোনার (currentUserId) নিজে যেসব রিকোয়েস্টে আগেই "আগ্রহী" চেপেছে
      // সেগুলোর তালিকা — যাতে বাটন আবার না দেখায়
      const { data: responseRows } = await supabase
        .from('blood_request_responses')
        .select('blood_request_id')
        .eq('donor_user_id', currentUserId)
        .in('blood_request_id', bloodRequestIds);

      (responseRows || []).forEach((r) => respondedSet.add(r.blood_request_id));
    }

    renderNotifications(latestNotifications, bloodStatusMap, respondedSet);
    updateBadgeCount();
  }

  function openDrawer() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
    loadNotifications();
  }

  function closeDrawer() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  window.addEventListener('smartfeni:open-notification-drawer', openDrawer);

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDrawer();
  });

  notifMarkAllBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    await supabase.from('user_notifications').update({ is_read: true }).eq('user_id', user.id).eq('is_read', false);
    loadNotifications();
  });

  async function initialBadgeCheck() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    loadNotifications();
  }

  initialBadgeCheck();

  window.addEventListener('smartfeni:auth-changed', () => {
    loadNotifications();
  });

  window.addEventListener('smartfeni:logged-out', () => {
    latestNotifications = [];
    updateBadgeCount();
  });
</script>
