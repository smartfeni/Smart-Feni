---
// ============================================================
// কম্পোনেন্ট: PostFlowDrawer — bottom nav "➕পোস্ট" থেকে ট্রিগার
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন):
// - "গাড়ি ভাড়া" যোগ হলো "সার্ভিস দিন" ট্যাবে (আগে ভুলে বাদ ছিল)
// - "ব্লাড ডোনার" সম্পূর্ণ সরানো হলো — এখন থেকে শুধু অ্যাডমিন/ক্লাব
//   বাল্ক এন্ট্রি করবে, পাবলিক সেলফ-রেজিস্ট্রেশন বাদ
// - "ডেলিভারি হিরো" এখন RiderRegisterModal ট্রিগার করে
//   (?openRiderRegister=1), আগের ?openListing=1 আর কাজ করত না
//   যেহেতু courier.astro এখন AddListingModal ব্যবহার করে না
//
// আপডেট (রিডিজাইন): সেগমেন্ট কন্ট্রোল (স্লাইডিং পিল), ২-কলাম কার্ডে রঙিন আইকন + নাম +
// এক লাইনের বর্ণনা। রং data/categoryColors.js থেকে। লিংক/ট্যাব লজিক আগের মতোই।
// ============================================================

import { categoryColor } from '../../data/categoryColors.js';

const listingCategories = [
  { id: 'housing', name: 'বাসা ভাড়া', icon: 'fa-house', slug: 'housing', desc: 'বাসা ভাড়া দিন' },
  { id: 'job', name: 'চাকরির খবর', icon: 'fa-briefcase', slug: 'job', desc: 'চাকরির খবর দিন' },
  { id: 'recycle', name: 'রিসাইকেল মার্কেট', icon: 'fa-rotate-left', slug: 'recycle', desc: 'পুরনো জিনিস বিক্রি করুন' },
  { id: 'tuition', name: 'টিউশন', icon: 'fa-chalkboard-user', slug: 'tuition', desc: 'টিউটর বা ছাত্র খুঁজুন' },
  { id: 'sports', name: 'খেলাধুলা ও ইভেন্টস', icon: 'fa-football', slug: 'sports', desc: 'খেলাধুলার ইভেন্ট জানান' },
  { id: 'lost-found', name: 'লস্ট এন্ড ফাউন্ড', icon: 'fa-magnifying-glass', slug: 'lost-found', desc: 'হারানো/পাওয়া জিনিস' },
  { id: 'event', name: 'ইভেন্ট ম্যানেজমেন্ট', icon: 'fa-calendar-check', slug: 'event', desc: 'অনুষ্ঠান আয়োজনের সার্ভিস' },
];

const serviceCategories = [
  { id: 'repair', name: 'রিপেয়ার সার্ভিস', icon: 'fa-screwdriver-wrench', slug: 'repair', desc: 'মিস্ত্রি/টেকনিশিয়ান হিসেবে যোগ দিন' },
  { id: 'car-rental', name: 'গাড়ি ভাড়া', icon: 'fa-car', slug: 'car-rental', desc: 'আপনার গাড়ি ভাড়া দিন' },
  { id: 'courier', name: 'ডেলিভারি হিরো', icon: 'fa-truck-fast', target: '/services/courier?openRiderRegister=1', desc: 'ডেলিভারি হিরো হোন' },
  { id: 'online-shop', name: 'শপ ওনার', icon: 'fa-store', target: '/become-a-shop-owner', desc: 'আপনার অনলাইন শপ খুলুন' },
  { id: 'health', name: 'স্বাস্থ্য পরামর্শক', icon: 'fa-user-doctor', soon: true, desc: 'শীঘ্রই আসছে' },
  { id: 'legal', name: 'আইনি পরামর্শক', icon: 'fa-scale-balanced', soon: true, desc: 'শীঘ্রই আসছে' },
  { id: 'home-food', name: 'হোম মেস ফুড ওনার', icon: 'fa-utensils', soon: true, desc: 'শীঘ্রই আসছে' },
  { id: 'club', name: 'ক্লাব ওনার', icon: 'fa-people-group', soon: true, desc: 'শীঘ্রই আসছে' },
];
---

<div class="pf-overlay" id="postFlowOverlay">
  <div class="pf-sheet" id="postFlowSheet">
    <div class="pf-handle"></div>

    <div class="pf-header">
      <h2>কী পোস্ট করতে চান?</h2>
      <button class="pf-close" id="postFlowClose" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="pf-tabs" id="pfTabs">
      <span class="pf-tab-pill"></span>
      <button class="pf-tab active" data-tab="listing" type="button">লিস্টিং দিন</button>
      <button class="pf-tab" data-tab="service" type="button">সার্ভিস দিন</button>
    </div>

    <div class="pf-panel active" id="pfPanelListing">
      <div class="pf-grid">
        {listingCategories.map((cat) => (
          <a
            href={cat.target || `/services/${cat.slug}?openListing=1`}
            class="pf-item"
            style={`--c:${categoryColor(cat.id)}`}
          >
            <span class="pf-item-icon"><i class={`fas ${cat.icon}`}></i></span>
            <span class="pf-item-text">
              <span class="pf-item-name">{cat.name}</span>
              <span class="pf-item-desc">{cat.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="pf-panel" id="pfPanelService">
      <div class="pf-grid">
        {serviceCategories.map((cat) => (
          cat.soon ? (
            <div class="pf-item pf-item-disabled" style={`--c:${categoryColor(cat.id)}`}>
              <span class="pf-item-icon"><i class={`fas ${cat.icon}`}></i></span>
              <span class="pf-item-text">
                <span class="pf-item-name">{cat.name}</span>
                <span class="pf-item-desc">{cat.desc}</span>
              </span>
              <span class="pf-soon-badge">শীঘ্রই</span>
            </div>
          ) : (
          <a
            href={cat.target || `/services/${cat.slug}?openListing=1`}
            class="pf-item"
            style={`--c:${categoryColor(cat.id)}`}
          >
            <span class="pf-item-icon"><i class={`fas ${cat.icon}`}></i></span>
            <span class="pf-item-text">
              <span class="pf-item-name">{cat.name}</span>
              <span class="pf-item-desc">{cat.desc}</span>
            </span>
          </a>
          )
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .pf-overlay { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); z-index: 2300; }
  .pf-overlay.open { display: block; }

  .pf-sheet {
    position: fixed; left: 0; right: 0; bottom: 0; max-height: 82vh;
    background: #fff; border-radius: 26px 26px 0 0;
    box-shadow: 0 -10px 40px rgba(15, 23, 42, 0.2);
    display: flex; flex-direction: column;
    transform: translateY(100%); transition: transform 0.3s ease;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .pf-overlay.open .pf-sheet { transform: translateY(0); }

  .pf-handle { width: 40px; height: 4px; border-radius: 4px; background: #E5EAF0; margin: 12px auto 2px; }
  .pf-header { display: flex; align-items: center; justify-content: space-between; padding: 10px 20px 8px; }
  .pf-header h2 { font-size: 1.1rem; font-weight: 800; color: #1B2A4A; margin: 0; }
  .pf-close { background: #F4F7FC; border: none; width: 34px; height: 34px; border-radius: 50%; color: #5A6E85; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .pf-close:active { background: #FF6B35; color: #fff; }

  /* সেগমেন্ট কন্ট্রোল — স্লাইডিং পিল */
  .pf-tabs { position: relative; display: flex; margin: 6px 20px 14px; padding: 4px; background: #F1F4F9; border-radius: 16px; }
  .pf-tab-pill { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.14); transition: transform 0.24s ease; }
  .pf-tabs.is-service .pf-tab-pill { transform: translateX(100%); }
  .pf-tab { position: relative; z-index: 1; flex: 1; background: transparent; border: none; color: #64748B; font-weight: 800; font-size: 0.88rem; padding: 11px; border-radius: 12px; cursor: pointer; transition: color 0.2s ease; }
  .pf-tab.active { color: #1B2A4A; }

  .pf-panel { display: none; overflow-y: auto; padding: 0 16px 20px; }
  .pf-panel.active { display: block; }
  .pf-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }

  .pf-item {
    position: relative; display: flex; align-items: center; gap: 10px;
    text-decoration: none; color: #1B2A4A;
    background: #fff; border: 1px solid #E5EAF0; border-radius: 18px;
    padding: 12px 10px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  a.pf-item:active { transform: scale(0.97); box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1); }

  .pf-item-icon {
    width: 42px; height: 42px; flex: 0 0 42px; border-radius: 13px;
    background: #FFF0EA; /* ফলব্যাক */
    background: color-mix(in srgb, var(--c) 14%, #fff);
    color: var(--c);
    display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
  }
  .pf-item-text { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .pf-item-name { font-size: 0.82rem; font-weight: 800; line-height: 1.25; }
  .pf-item-desc { font-size: 0.68rem; color: #64748B; line-height: 1.35; }

  .pf-item-disabled { opacity: 0.55; cursor: default; }
  .pf-item-disabled .pf-item-icon { background: #F1F4F9; color: #A0AFC0; }
  .pf-soon-badge { position: absolute; top: 6px; right: 8px; font-size: 0.58rem; font-weight: 800; color: #8FA0BC; background: #EEF3F9; padding: 2px 7px; border-radius: 20px; }
</style>

<script>
  const overlay = document.getElementById('postFlowOverlay');
  const closeBtn = document.getElementById('postFlowClose');
  const tabs = document.querySelectorAll('.pf-tab');
  const panels = document.querySelectorAll('.pf-panel');

  function openDrawer() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  window.addEventListener('smartfeni:open-post-flow', openDrawer);

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDrawer();
  });

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('pfTabs')?.classList.toggle('is-service', target === 'service');
      panels.forEach((panel) => {
        panel.classList.toggle('active', panel.id === `pfPanel${target === 'listing' ? 'Listing' : 'Service'}`);
      });
    });
  });
</script>