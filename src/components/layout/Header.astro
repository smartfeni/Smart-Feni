---
// ============================================================
// কম্পোনেন্ট: হেডার (ন্যাভবার) — মিনিমাল
// ব্র্যান্ড: স্মার্ট ফেনী
// লেআউট: লোকেশন (বাম) — লোগো+ট্যাগলাইন (মাঝে) — প্রোফাইল (ডান)
// আপডেট: উপজেলা-ভিত্তিক হেডার ব্যাকগ্রাউন্ড ইমেজ (site_images টেবিল
// থেকে, smartfeni:upazila-changed ইভেন্ট শুনে লাইভ বদলায়)
// আপডেট: লোগো site_images ('logo' key) থেকে ডাইনামিক লোড, না পেলে
// ফলব্যাক /logo.png
// আপডেট: প্রোফাইল আইকনে ক্লিক করলে লগইন থাকলে সরাসরি /profile/edit
// এ যাবে, না থাকলে AuthModal খুলবে
//
// আপডেট (নতুন — বটম ন্যাভ যোগ হওয়ার পর): নোটিফিকেশন বেল এই হেডার
// থেকে সরিয়ে ফেলা হলো — এখন bottom nav এর "মেসেজ" আইকন থেকে
// NotificationDrawer.astro খুলবে, একই user_notifications লজিক
// সেখানে move করা হয়েছে। Header এ ডুপ্লিকেট নোটিফিকেশন UI রাখা
// হচ্ছে না।
//
// আপডেট (নতুন): scroll-hide behavior যোগ করা হলো — নিচের দিকে
// স্ক্রল করলে হেডার উপরে স্লাইড করে লুকিয়ে যায় (translateY),
// উপরের দিকে স্ক্রল করলে আবার ফিরে আসে। Bottom nav সবসময় ফিক্সড
// থাকে বলে মূল নেভিগেশন সবসময় অ্যাক্সেসযোগ্য থাকে।
// আপডেট (নতুন): গ্লোবাল কার্ট আইকন যোগ হলো (প্রোফাইল বাটনের পাশে) —
// আগে কার্ট আইকন শুধু শপ প্রোফাইল/প্রোডাক্ট পেজে ফ্লোটিং বাটন হিসেবে
// থাকত, অন্য কোনো ক্যাটাগরিতে (housing/job/repair ইত্যাদি) দেখা
// যেত না বলে সাইটওয়াইড অ্যাক্সেস ছিল না। এখন হেডারে বসানো হলো যাতে
// যেকোনো পেজ থেকে কার্টে যাওয়া যায়। কিন্তু কার্ট খালি থাকলে আইকনটাই
// হাইড থাকে (housing/job এর মতো শপিং-অপ্রাসঙ্গিক ক্যাটাগরিতে খালি
// কার্ট আইকন বেমানান লাগবে বলে) — কার্টে কিছু যোগ হলেই দেখা যাবে।
// product/[id].astro ও ShopProfile.astro থেকে ডিসপ্যাচ করা
// 'smartfeni:cart-updated' কাস্টম ইভেন্ট শুনে লাইভ আপডেট হয়, তাই
// অ্যাড-টু-কার্টের সাথে সাথে হেডারেও কাউন্ট বদলে যায় (পেজ রিলোড
// ছাড়াই)।
//
// আপডেট (প্রোফাইল ফ্ল্যাশ ফিক্স): স্ট্যাটিক সাইট হওয়ায় প্রতিটা পেজ
// লোডে এই স্ক্রিপ্ট নতুন করে রান হয়, তাই সেশন/প্রোফাইল ফেচ শেষ না
// হওয়া পর্যন্ত ডিফল্ট "প্রোফাইল" টেক্সট + জেনেরিক আইকন দেখাত (মনে
// হতো লগইন নেই, ১-২ সেকেন্ড পর নাম/ছবি ভেসে উঠত)। এখন দুইটা লেয়ার
// ফিক্স আছে:
//  ১. Cache-first: প্রথম সফল ফেচের পর নাম/অ্যাভাটার localStorage
//     ('sf_profile_cache_v1') এ ক্যাশ হয়। পরের যেকোনো পেজ লোডে
//     নেটওয়ার্ক কল শেষ হওয়ার আগেই ক্যাশ থেকে সাথে সাথে দেখানো হয়,
//     পরে ফ্রেশ ডেটা এসে সাইলেন্টলি ওভাররাইট/কারেক্ট করে দেয়।
//  ২. Skeleton শিমার: একদম প্রথমবার (কোনো ক্যাশ নেই) — বিভ্রান্তিকর
//     "প্রোফাইল"/জেনেরিক আইকনের বদলে পালসিং শিমার দেখাবে, যাতে
//     স্পষ্ট বোঝা যায় লোড হচ্ছে, লগইন নেই এমন মনে না হয়।
// লগ-আউট হলে ক্যাশ ক্লিয়ার হয়ে যায় (showLoggedOutState এ)।
// ============================================================

import LocationSelector from '../ui/LocationSelector.astro';
import AuthModal from '../ui/AuthModal.astro';
---

<nav class="navbar" id="siteNavbar">
  <div class="navbar-bg-overlay"></div>
  <div class="container navbar-inner">
    <div class="navbar-left">
      <LocationSelector />
    </div>

    <a href="/" class="logo-center">
      <img src="/logo.png" alt="স্মার্ট ফেনী লোগো" class="logo-img" id="siteLogoImg" />
      <span class="logo-tagline">Global Standards. Local Service.</span>
    </a>

    <div class="navbar-right">
      <a href="/cart" class="header-cart-btn" id="headerCartBtn" aria-label="কার্ট" style="display:none;">
        <i class="fas fa-cart-shopping"></i>
        <span class="header-cart-badge" id="headerCartBadge">0</span>
      </a>

      <button class="profile-btn" id="profileBtn" aria-label="প্রোফাইল">
        <span class="profile-avatar" id="profileAvatar">
          <img id="profileAvatarImg" src="" alt="প্রোফাইল ছবি" />
          <i class="fas fa-circle-user" id="profileDefaultIcon"></i>
        </span>
        <span class="profile-label" id="profileLabel">প্রোফাইল</span>
      </button>
    </div>
  </div>
</nav>

<AuthModal />

<style>
  .navbar {
    padding: 10px 0;
    background: rgba(255, 255, 255, 0.98);
    background-size: cover;
    background-position: center;
    position: sticky;
    top: 0;
    z-index: 999;
    border-bottom: 1px solid rgba(27, 42, 74, 0.06);
    transition: background-image 0.3s ease, transform 0.3s ease;
  }

  .navbar.nav-hidden {
    transform: translateY(-100%);
  }

  .navbar-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.9);
    pointer-events: none;
    z-index: 0;
  }

  .navbar.has-bg-image {
    background-color: transparent;
  }

  .navbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  .navbar-left {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    min-width: 0;
  }

  .navbar-right {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .logo-center {
    --logo-h: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    line-height: 1.15;
    padding: 2px 8px;
  }

  .logo-img {
    height: var(--logo-h);
    width: auto;
    display: block;
    margin-bottom: 3px;
  }

  .logo-tagline {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 0.7rem;
    font-weight: 600;
    font-style: italic;
    color: #1B2A4A;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }

  /* ===== গ্লোবাল কার্ট আইকন ===== */
  .header-cart-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #F4F7FC;
    color: #1B2A4A;
    font-size: 1.05rem;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .header-cart-btn:hover {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .header-cart-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    background: #FF6B35;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    min-width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    border: 2px solid #fff;
  }

  @media (max-width: 480px) {
    .header-cart-btn {
      width: 34px;
      height: 34px;
      font-size: 0.92rem;
    }
  }

  /* ===== প্রোফাইল আইকন (গোলাকার) ===== */
  .profile-btn {
    display: flex;
    align-items: center;
    gap: 9px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 10px 4px 4px;
    border-radius: 40px;
    transition: background 0.2s ease;
  }

  .profile-btn:hover {
    background: #F4F7FC;
  }

  .profile-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FFF0EA;
    border: 2px solid #FFE3D4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }

  .profile-btn:hover .profile-avatar {
    border-color: #FF6B35;
  }

  .profile-avatar #profileDefaultIcon {
    color: #FF6B35;
    font-size: 1.5rem;
    line-height: 1;
  }

  .profile-avatar img {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-avatar.has-photo #profileDefaultIcon {
    display: none;
  }

  .profile-avatar.has-photo img {
    display: block;
  }

  .profile-label {
    color: #1B2A4A;
    font-weight: 600;
    font-size: 0.88rem;
  }

  /* ===== স্কেলিটন শিমার — cache না থাকলে প্রথমবার লোডের সময় ===== */
  @keyframes hdrShimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
  }

  .profile-avatar.hdr-skeleton {
    background: linear-gradient(90deg, #EEF1F6 25%, #E2E6ED 37%, #EEF1F6 63%);
    background-size: 400% 100%;
    animation: hdrShimmer 1.4s ease infinite;
    border-color: #E2E6ED;
  }

  .profile-avatar.hdr-skeleton #profileDefaultIcon,
  .profile-avatar.hdr-skeleton img {
    visibility: hidden;
  }

  .profile-label.hdr-skeleton {
    display: inline-block;
    width: 44px;
    height: 11px;
    border-radius: 6px;
    color: transparent;
    background: linear-gradient(90deg, #EEF1F6 25%, #E2E6ED 37%, #EEF1F6 63%);
    background-size: 400% 100%;
    animation: hdrShimmer 1.4s ease infinite;
  }

  @media (max-width: 768px) {
    .logo-center {
      --logo-h: 60px;
    }

    .logo-tagline {
      font-size: 0.6rem;
    }

    .profile-btn {
      flex-direction: column;
      gap: 2px;
      padding: 4px 6px;
    }

    .profile-label {
      font-size: 0.62rem;
      font-weight: 600;
    }

    .profile-avatar {
      width: 34px;
      height: 34px;
    }

    .profile-avatar #profileDefaultIcon {
      font-size: 1.3rem;
    }
  }

  @media (max-width: 480px) {
    .logo-center {
      --logo-h: 50px;
    }

    .logo-tagline {
      font-size: 0.52rem;
    }

    .profile-avatar {
      width: 30px;
      height: 30px;
    }

    .profile-avatar #profileDefaultIcon {
      font-size: 1.15rem;
    }

    .profile-label {
      font-size: 0.56rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const profileBtn = document.getElementById('profileBtn');
  const avatarWrap = document.getElementById('profileAvatar');
  const avatarImg = document.getElementById('profileAvatarImg');
  const label = document.getElementById('profileLabel');
  const headerCartBtn = document.getElementById('headerCartBtn');
  const headerCartBadge = document.getElementById('headerCartBadge');

  let isLoggedIn = false;
  let currentUserId = null;

  const PROFILE_CACHE_KEY = 'sf_profile_cache_v1';

  function readProfileCache() {
    try {
      const raw = localStorage.getItem(PROFILE_CACHE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function writeProfileCache(userId, name, avatarUrl) {
    try {
      localStorage.setItem(PROFILE_CACHE_KEY, JSON.stringify({ userId, name, avatarUrl }));
    } catch {
      // localStorage ব্লকড/ডিসেবল থাকলে চুপচাপ ইগনোর — ক্যাশ ছাড়াই কাজ চলবে
    }
  }

  function clearProfileCache() {
    try {
      localStorage.removeItem(PROFILE_CACHE_KEY);
    } catch {
      // ইগনোর
    }
  }

  function setSkeleton(on) {
    avatarWrap?.classList.toggle('hdr-skeleton', on);
    label?.classList.toggle('hdr-skeleton', on);
  }

  // ===== গ্লোবাল কার্ট আইকন =====
  function updateCartUI(total) {
    if (!headerCartBtn) return;
    if (total > 0) {
      headerCartBadge.textContent = total > 99 ? '৯৯+' : total;
      headerCartBtn.style.display = 'flex';
    } else {
      headerCartBtn.style.display = 'none';
    }
  }

  async function refreshHeaderCartFromDb() {
    if (!currentUserId) {
      updateCartUI(0);
      return;
    }
    const { data } = await supabase.from('cart_items').select('quantity').eq('user_id', currentUserId);
    const total = (data || []).reduce((sum, row) => sum + row.quantity, 0);
    updateCartUI(total);
  }

  // product/[id].astro ও ShopProfile.astro থেকে অ্যাড-টু-কার্টের পর
  // ডিসপ্যাচ করা ইভেন্ট শুনে সাথে সাথে ব্যাজ আপডেট (পেজ রিলোড ছাড়াই)
  window.addEventListener('smartfeni:cart-updated', (e) => {
    updateCartUI(e.detail?.total ?? 0);
  });

  function showLoggedInState(name, avatarUrl) {
    isLoggedIn = true;
    setSkeleton(false);
    if (avatarUrl) {
      avatarImg.src = avatarUrl;
      avatarWrap?.classList.add('has-photo');
    } else {
      avatarImg.src = '';
      avatarWrap?.classList.remove('has-photo');
    }
    if (label) {
      label.textContent = name || 'প্রোফাইল';
    }
  }

  function showLoggedOutState() {
    isLoggedIn = false;
    currentUserId = null;
    setSkeleton(false);
    avatarImg.src = '';
    avatarWrap?.classList.remove('has-photo');
    if (label) {
      label.textContent = 'প্রোফাইল';
    }
    updateCartUI(0);
    clearProfileCache();
  }

  // ===== ধাপ ১ (cache-first): নেটওয়ার্ক ফেচ শেষ হওয়ার আগেই cache
  // থাকলে সাথে সাথে দেখানো হয় (ব্লাংক/ডিফল্ট "প্রোফাইল" ফ্ল্যাশ হয় না)।
  // ধাপ ২ (skeleton): একদম প্রথমবার — cache-ই নেই — পালসিং শিমার
  // দেখাবে, যাতে "লগইন নেই" মনে না হয়ে "লোড হচ্ছে" স্পষ্ট বোঝা যায়।
  const cached = readProfileCache();
  if (cached) {
    showLoggedInState(cached.name, cached.avatarUrl);
  } else {
    setSkeleton(true);
  }

  // পেজ লোড হলে আগে থেকে সেশন আছে কিনা চেক করা (রিফ্রেশেও লগইন থাকবে)
  async function restoreSession() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      showLoggedOutState();
      return;
    }

    currentUserId = session.user.id;

    // cache অন্য ইউজারের হলে (শেয়ারড ডিভাইসে অ্যাকাউন্ট বদল) — ভুল
    // নাম দেখিয়ে না রেখে স্কেলিটনে ফিরিয়ে ফ্রেশ ডেটার জন্য অপেক্ষা
    if (cached && cached.userId !== currentUserId) {
      clearProfileCache();
      setSkeleton(true);
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name, avatar_url')
      .eq('id', session.user.id)
      .single();

    showLoggedInState(profile?.full_name, profile?.avatar_url);
    writeProfileCache(currentUserId, profile?.full_name || null, profile?.avatar_url || null);
    refreshHeaderCartFromDb();
  }

  restoreSession();

  // প্রোফাইল বাটন — লগইন করা না থাকলে AuthModal খুলবে, থাকলে সরাসরি
  // প্রোফাইল পেজে নিয়ে যাবে
  profileBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isLoggedIn) {
      window.location.href = '/profile/edit';
    } else {
      window.openAuthModal?.('login');
    }
  });

  window.addEventListener('smartfeni:auth-changed', async (e) => {
    const { name, avatarUrl } = e.detail || {};
    showLoggedInState(name, avatarUrl);

    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;
    if (currentUserId) {
      writeProfileCache(currentUserId, name || null, avatarUrl || null);
    }
    refreshHeaderCartFromDb();
  });

  window.addEventListener('smartfeni:logged-out', () => {
    showLoggedOutState();
  });

  // ============================================================
  // উপজেলা-ভিত্তিক হেডার ব্যাকগ্রাউন্ড ইমেজ
  // ============================================================
  const navbar = document.getElementById('siteNavbar');
  const BUCKET = 'listing-images';
  const STORAGE_KEY = 'smartfeni_upazila';

  function publicUrl(path, updatedAt) {
    const { data } = supabase.storage.from(BUCKET).getPublicUrl(path);
    const bust = updatedAt ? new Date(updatedAt).getTime() : Date.now();
    return `${data.publicUrl}?v=${bust}`;
  }

  async function loadHeaderBg(upazilaSlug) {
    if (!navbar) return;

    let record = null;

    if (upazilaSlug) {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', `header_${upazilaSlug}`)
        .maybeSingle();
      record = data;
    }

    if (!record) {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', 'header_default')
        .maybeSingle();
      record = data;
    }

    if (record?.storage_path) {
      navbar.style.backgroundImage = `url('${publicUrl(record.storage_path, record.updated_at)}')`;
      navbar.classList.add('has-bg-image');
    } else {
      navbar.style.backgroundImage = '';
      navbar.classList.remove('has-bg-image');
    }
  }

  const savedUpazila = localStorage.getItem(STORAGE_KEY);
  loadHeaderBg(savedUpazila);

  window.addEventListener('smartfeni:upazila-changed', (e) => {
    loadHeaderBg(e.detail?.upazila);
  });

  // ============================================================
  // ডাইনামিক লোগো
  // ============================================================
  const logoImg = document.getElementById('siteLogoImg');

  async function loadDynamicLogo() {
    const { data } = await supabase
      .from('site_images')
      .select('storage_path, updated_at')
      .eq('image_key', 'logo')
      .maybeSingle();

    if (data?.storage_path && logoImg) {
      logoImg.src = publicUrl(data.storage_path, data.updated_at);
    }
  }

  loadDynamicLogo();

  // ============================================================
  // Scroll-hide — নিচে স্ক্রল করলে হেডার লুকাবে, উপরে স্ক্রল করলে
  // ফিরে আসবে। ছোট থ্রেশহোল্ড (৬px) রাখা হয়েছে যাতে সামান্য
  // ফ্লিকার/জিটার স্ক্রলে হেডার বারবার লাফায় না। পেজের একদম উপরে
  // (scrollY <= 0) থাকলে সবসময় ভিজিবল থাকবে।
  // ============================================================
  let lastScrollY = window.scrollY;
  let ticking = false;
  const SCROLL_THRESHOLD = 6;

  function handleScroll() {
    const currentScrollY = window.scrollY;
    const diff = currentScrollY - lastScrollY;

    if (currentScrollY <= 0) {
      navbar?.classList.remove('nav-hidden');
    } else if (diff > SCROLL_THRESHOLD) {
      navbar?.classList.add('nav-hidden');
      lastScrollY = currentScrollY;
    } else if (diff < -SCROLL_THRESHOLD) {
      navbar?.classList.remove('nav-hidden');
      lastScrollY = currentScrollY;
    }

    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(handleScroll);
      ticking = true;
    }
  }, { passive: true });
</script>
