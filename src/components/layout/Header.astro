---
// ============================================================
// কম্পোনেন্ট: হেডার (ন্যাভবার) — মিনিমাল
// ব্র্যান্ড: স্মার্ট ফেনী
// লেআউট: লোকেশন (বাম) — লোগো+ট্যাগলাইন (মাঝে) — নোটিফিকেশন+প্রোফাইল (ডান)
// আপডেট: উপজেলা-ভিত্তিক হেডার ব্যাকগ্রাউন্ড ইমেজ যোগ করা হলো
// (site_images টেবিল থেকে, smartfeni:upazila-changed ইভেন্ট শুনে
// লাইভ বদলায়, কিছু না থাকলে আগের প্লেইন সাদা হেডারই থাকবে)
// আপডেট: লোগো এখন site_images ('logo' key) থেকে ডাইনামিক লোড হয়,
// না পেলে ফলব্যাক /logo.png (static ফাইল, আগের মতোই)
// আপডেট: হেডার ব্যাকগ্রাউন্ড ইমেজেও এখন ?v=updated_at cache-busting
// যোগ করা হলো (লোগোর মতো একই প্যাটার্ন)
// আপডেট (নতুন): ProfileMenu ড্রপডাউন সরিয়ে ফেলা হলো — এখন প্রোফাইল
// আইকনে ক্লিক করলে লগইন করা থাকলে সরাসরি /profile/edit এ চলে যাবে
// (রোল-ভিত্তিক শর্টকাট — অ্যাডমিন প্যানেল/আমার শপ/আমার ক্লাব, ব্লাড
// ডোনার টগল, লগ আউট — সব এখন প্রোফাইল পেজেই থাকবে, ড্রপডাউনে না)।
// লগইন করা না থাকলে আগের মতোই AuthModal খুলবে।
//
// আপডেট (নতুন): নোটিফিকেশন বেল আইকন যোগ হলো, প্রোফাইল বাটনের পাশে।
// user_notifications টেবিল থেকে ফেচ হয় (RLS: শুধু নিজের রো)।
// লগইন না থাকলে বেল লুকানো থাকবে। আনরিড কাউন্ট ব্যাজ, ক্লিক করলে
// ড্রপডাউন প্যানেল খুলবে।
//
// আপডেট (বাগফিক্স): .notif-item এলিমেন্টগুলো JS দিয়ে
// document.createElement() করে বানানো হয় বলে Astro এর স্কোপড CSS
// এদের উপর কাজ করছিল না — এখন <style is:global> ব্লকে সরানো হলো।
//
// আপডেট (নতুন): লম্বা মেসেজ (৩ লাইনের বেশি) ক্লিক করলে এখন
// এক্সপ্যান্ড/কোলাপ্স হয় (আগে সরাসরি নেভিগেট হয়ে যেত, পড়ার সুযোগ
// পাওয়া যেত না)। listing_id থাকলে ভেতরে আলাদা ছোট লিংক থাকবে
// ("সম্পর্কিত লিস্টিং দেখুন →"), সেটাতেই শুধু নেভিগেট হবে।
// ============================================================

import LocationSelector from '../ui/LocationSelector.astro';
import AuthModal from '../ui/AuthModal.astro';
---

<nav class="navbar" id="siteNavbar">
  <div class="navbar-bg-overlay"></div>
  <div class="container navbar-inner">
    <div class="navbar-left">
      <LocationSelector />
    </div>

    <a href="/" class="logo-center">
      <img src="/logo.png" alt="স্মার্ট ফেনী লোগো" class="logo-img" id="siteLogoImg" />
      <span class="logo-tagline">Global Standards. Local Service.</span>
    </a>

    <div class="navbar-right">
      <div class="notif-wrap" id="notifWrap" style="display:none;">
        <button class="notif-btn" id="notifBtn" aria-label="নোটিফিকেশন" type="button">
          <i class="fas fa-bell"></i>
          <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
        </button>

        <div class="notif-panel" id="notifPanel">
          <div class="notif-panel-header">
            <span>নোটিফিকেশন</span>
            <button id="notifMarkAllBtn" type="button">সব পড়া হয়েছে</button>
          </div>
          <div class="notif-list" id="notifList"></div>
          <p class="notif-empty" id="notifEmpty" style="display:none;">
            <i class="fas fa-bell-slash"></i>
            কোনো নোটিফিকেশন নেই
          </p>
        </div>
      </div>

      <button class="profile-btn" id="profileBtn" aria-label="প্রোফাইল">
        <span class="profile-avatar" id="profileAvatar">
          <img id="profileAvatarImg" src="" alt="প্রোফাইল ছবি" />
          <i class="fas fa-circle-user" id="profileDefaultIcon"></i>
        </span>
        <span class="profile-label" id="profileLabel">প্রোফাইল</span>
      </button>
    </div>
  </div>
</nav>

<AuthModal />

<style>
  .navbar {
    padding: 10px 0;
    background: rgba(255, 255, 255, 0.98);
    background-size: cover;
    background-position: center;
    position: sticky;
    top: 0;
    z-index: 999;
    border-bottom: 1px solid rgba(27, 42, 74, 0.06);
    transition: background-image 0.3s ease;
  }

  .navbar-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.9);
    pointer-events: none;
    z-index: 0;
  }

  .navbar.has-bg-image {
    background-color: transparent;
  }

  .navbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  .navbar-left {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    min-width: 0;
  }

  .navbar-right {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .logo-center {
    --logo-h: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    line-height: 1.15;
    padding: 2px 8px;
  }

  .logo-img {
    height: var(--logo-h);
    width: auto;
    display: block;
    margin-bottom: 3px;
  }

  .logo-tagline {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 0.7rem;
    font-weight: 600;
    font-style: italic;
    color: #1B2A4A;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }

  /* ===== নোটিফিকেশন বেল (স্ট্যাটিক শেল) ===== */
  .notif-wrap {
    position: relative;
  }

  .notif-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: #5A6E85;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .notif-btn:hover {
    background: #F4F7FC;
  }

  .notif-badge {
    position: absolute;
    top: 3px;
    right: 3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 20px;
    background: #D14343;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 0 0 2px #fff;
  }

  .notif-panel {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 340px;
    max-width: 90vw;
    max-height: 440px;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.18);
    overflow: hidden;
    z-index: 1000;
    border: 1px solid #EEF3F9;
  }

  .notif-panel.open {
    display: flex;
    flex-direction: column;
  }

  .notif-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid #EEF3F9;
    font-size: 0.92rem;
    font-weight: 700;
    color: #1B2A4A;
  }

  .notif-panel-header button {
    background: none;
    border: none;
    color: #FF6B35;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 8px;
  }

  .notif-panel-header button:hover {
    background: #FFF0EA;
  }

  .notif-list {
    overflow-y: auto;
    flex: 1;
  }

  .notif-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    color: #B0BCCB;
    font-size: 0.85rem;
    padding: 48px 24px;
    margin: 0;
  }

  .notif-empty i {
    font-size: 1.8rem;
    color: #D7E0EC;
  }

  /* ===== প্রোফাইল আইকন (গোলাকার) ===== */
  .profile-btn {
    display: flex;
    align-items: center;
    gap: 9px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 10px 4px 4px;
    border-radius: 40px;
    transition: background 0.2s ease;
  }

  .profile-btn:hover {
    background: #F4F7FC;
  }

  .profile-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FFF0EA;
    border: 2px solid #FFE3D4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }

  .profile-btn:hover .profile-avatar {
    border-color: #FF6B35;
  }

  .profile-avatar #profileDefaultIcon {
    color: #FF6B35;
    font-size: 1.5rem;
    line-height: 1;
  }

  .profile-avatar img {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-avatar.has-photo #profileDefaultIcon {
    display: none;
  }

  .profile-avatar.has-photo img {
    display: block;
  }

  .profile-label {
    color: #1B2A4A;
    font-weight: 600;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .logo-center {
      --logo-h: 60px;
    }

    .logo-tagline {
      font-size: 0.6rem;
    }

    .profile-btn {
      flex-direction: column;
      gap: 2px;
      padding: 4px 6px;
    }

    .profile-label {
      font-size: 0.62rem;
      font-weight: 600;
    }

    .profile-avatar {
      width: 34px;
      height: 34px;
    }

    .profile-avatar #profileDefaultIcon {
      font-size: 1.3rem;
    }

    .notif-btn {
      width: 34px;
      height: 34px;
      font-size: 1rem;
    }

    .notif-panel {
      right: -10px;
      width: 300px;
    }
  }

  @media (max-width: 480px) {
    .logo-center {
      --logo-h: 50px;
    }

    .logo-tagline {
      font-size: 0.52rem;
    }

    .profile-avatar {
      width: 30px;
      height: 30px;
    }

    .profile-avatar #profileDefaultIcon {
      font-size: 1.15rem;
    }

    .profile-label {
      font-size: 0.56rem;
    }

    .notif-panel {
      width: 270px;
    }
  }
</style>

<!-- ============================================================
  is:global — .notif-item এলিমেন্টগুলো JS দিয়ে ডাইনামিকালি বানানো
  হয় বলে Astro এর স্কোপড CSS এদের উপর বসে না।
============================================================ -->
<style is:global>
  .notif-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #F4F7FC;
    padding: 14px 18px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease;
  }

  .notif-item:last-child {
    border-bottom: none;
  }

  .notif-item:hover {
    background: #F8FAFC;
  }

  .notif-item.unread {
    background: #FFF8F5;
  }

  .notif-item.unread:hover {
    background: #FFF0EA;
  }

  .notif-item-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F4F7FC;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    position: relative;
  }

  .notif-item.unread .notif-item-icon {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .notif-item.unread .notif-item-icon::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #FF6B35;
    border: 2px solid #fff;
  }

  .notif-item-body {
    flex: 1;
    min-width: 0;
  }

  .notif-item-msg {
    font-size: 0.84rem;
    color: #1B2A4A;
    line-height: 1.5;
    white-space: pre-line;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .notif-item-msg.expanded {
    -webkit-line-clamp: unset;
    display: block;
  }

  .notif-item.unread .notif-item-msg {
    font-weight: 600;
  }

  .notif-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
  }

  .notif-item-time {
    font-size: 0.72rem;
    color: #8FA0BC;
  }

  .notif-item-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #FF6B35;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .notif-item-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const profileBtn = document.getElementById('profileBtn');
  const avatarWrap = document.getElementById('profileAvatar');
  const avatarImg = document.getElementById('profileAvatarImg');
  const label = document.getElementById('profileLabel');

  let isLoggedIn = false;

  function showLoggedInState(name, avatarUrl) {
    isLoggedIn = true;
    if (avatarUrl) {
      avatarImg.src = avatarUrl;
      avatarWrap?.classList.add('has-photo');
    }
    if (label) {
      label.textContent = name || 'প্রোফাইল';
    }
    notifWrap.style.display = 'block';
    loadNotifications();
  }

  function showLoggedOutState() {
    isLoggedIn = false;
    avatarImg.src = '';
    avatarWrap?.classList.remove('has-photo');
    if (label) {
      label.textContent = 'প্রোফাইল';
    }
    notifWrap.style.display = 'none';
    notifPanel.classList.remove('open');
  }

  // পেজ লোড হলে আগে থেকে সেশন আছে কিনা চেক করা (রিফ্রেশেও লগইন থাকবে)
  async function restoreSession() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name, avatar_url')
      .eq('id', session.user.id)
      .single();

    showLoggedInState(profile?.full_name, profile?.avatar_url);
  }

  restoreSession();

  // প্রোফাইল বাটন — লগইন করা না থাকলে AuthModal খুলবে, থাকলে সরাসরি
  // প্রোফাইল পেজে নিয়ে যাবে
  profileBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isLoggedIn) {
      window.location.href = '/profile/edit';
    } else {
      window.openAuthModal?.('login');
    }
  });

  window.addEventListener('smartfeni:auth-changed', (e) => {
    const { name, avatarUrl } = e.detail || {};
    showLoggedInState(name, avatarUrl);
  });

  window.addEventListener('smartfeni:logged-out', () => {
    showLoggedOutState();
  });

  // ============================================================
  // নোটিফিকেশন বেল
  // ============================================================
  const notifWrap = document.getElementById('notifWrap');
  const notifBtn = document.getElementById('notifBtn');
  const notifBadge = document.getElementById('notifBadge');
  const notifPanel = document.getElementById('notifPanel');
  const notifList = document.getElementById('notifList');
  const notifEmpty = document.getElementById('notifEmpty');
  const notifMarkAllBtn = document.getElementById('notifMarkAllBtn');

  function toBnDigits(num) {
    const bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    return num.toString().replace(/[0-9]/g, (d) => bn[d]);
  }

  function relativeTimeBn(dateString) {
    const then = new Date(dateString);
    const diffSec = Math.floor((Date.now() - then.getTime()) / 1000);
    const diffMin = Math.floor(diffSec / 60);
    const diffHour = Math.floor(diffMin / 60);
    const diffDay = Math.floor(diffHour / 24);

    if (diffSec < 60) return 'এইমাত্র';
    if (diffMin < 60) return `${toBnDigits(diffMin)} মিনিট আগে`;
    if (diffHour < 24) return `${toBnDigits(diffHour)} ঘণ্টা আগে`;
    if (diffDay < 30) return `${toBnDigits(diffDay)} দিন আগে`;
    return `${toBnDigits(Math.floor(diffDay / 30))} মাস আগে`;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  function renderNotifications(items) {
    notifList.innerHTML = '';

    if (!items || items.length === 0) {
      notifEmpty.style.display = 'flex';
      return;
    }
    notifEmpty.style.display = 'none';

    items.forEach((n) => {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = `notif-item ${n.is_read ? '' : 'unread'}`;
      el.innerHTML = `
        <span class="notif-item-icon"><i class="fas fa-bell"></i></span>
        <span class="notif-item-body">
          <span class="notif-item-msg">${escapeHtml(n.message)}</span>
          <span class="notif-item-footer">
            <span class="notif-item-time">${relativeTimeBn(n.created_at)}</span>
            ${n.listing_id ? '<button type="button" class="notif-item-link" data-open-listing>সম্পর্কিত লিস্টিং দেখুন →</button>' : ''}
          </span>
        </span>
      `;

      // মূল আইটেমে ক্লিক করলে — টেক্সট এক্সপ্যান্ড/কোলাপ্স + read মার্ক
      el.addEventListener('click', async () => {
        const msgEl = el.querySelector('.notif-item-msg');
        msgEl.classList.toggle('expanded');

        if (!n.is_read) {
          n.is_read = true;
          el.classList.remove('unread');
          await supabase.from('user_notifications').update({ is_read: true }).eq('id', n.id);
          updateBadgeCount();
        }
      });

      // "সম্পর্কিত লিস্টিং দেখুন" — আলাদাভাবে নেভিগেট করবে, এক্সপ্যান্ড ট্রিগার করবে না
      const linkBtn = el.querySelector('[data-open-listing]');
      linkBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        window.location.href = `/listing/${n.listing_id}`;
      });

      notifList.appendChild(el);
    });
  }

  let latestNotifications = [];

  function updateBadgeCount() {
    const unreadCount = latestNotifications.filter((n) => !n.is_read).length;
    if (unreadCount > 0) {
      notifBadge.textContent = unreadCount > 9 ? '৯+' : toBnDigits(unreadCount);
      notifBadge.style.display = 'flex';
    } else {
      notifBadge.style.display = 'none';
    }
  }

  async function loadNotifications() {
    const { data, error } = await supabase
      .from('user_notifications')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(20);

    if (error) return;

    latestNotifications = data || [];
    renderNotifications(latestNotifications);
    updateBadgeCount();
  }

  notifBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const willOpen = !notifPanel.classList.contains('open');
    notifPanel.classList.toggle('open', willOpen);
    if (willOpen) loadNotifications();
  });

  document.addEventListener('click', () => {
    notifPanel.classList.remove('open');
  });

  notifMarkAllBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    await supabase.from('user_notifications').update({ is_read: true }).eq('user_id', user.id).eq('is_read', false);
    loadNotifications();
  });

  // ============================================================
  // উপজেলা-ভিত্তিক হেডার ব্যাকগ্রাউন্ড ইমেজ
  // ============================================================
  const navbar = document.getElementById('siteNavbar');
  const BUCKET = 'listing-images';
  const STORAGE_KEY = 'smartfeni_upazila';

  function publicUrl(path, updatedAt) {
    const { data } = supabase.storage.from(BUCKET).getPublicUrl(path);
    const bust = updatedAt ? new Date(updatedAt).getTime() : Date.now();
    return `${data.publicUrl}?v=${bust}`;
  }

  async function loadHeaderBg(upazilaSlug) {
    if (!navbar) return;

    let record = null;

    if (upazilaSlug) {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', `header_${upazilaSlug}`)
        .maybeSingle();
      record = data;
    }

    if (!record) {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', 'header_default')
        .maybeSingle();
      record = data;
    }

    if (record?.storage_path) {
      navbar.style.backgroundImage = `url('${publicUrl(record.storage_path, record.updated_at)}')`;
      navbar.classList.add('has-bg-image');
    } else {
      navbar.style.backgroundImage = '';
      navbar.classList.remove('has-bg-image');
    }
  }

  const savedUpazila = localStorage.getItem(STORAGE_KEY);
  loadHeaderBg(savedUpazila);

  window.addEventListener('smartfeni:upazila-changed', (e) => {
    loadHeaderBg(e.detail?.upazila);
  });

  // ============================================================
  // ডাইনামিক লোগো
  // ============================================================
  const logoImg = document.getElementById('siteLogoImg');

  async function loadDynamicLogo() {
    const { data } = await supabase
      .from('site_images')
      .select('storage_path, updated_at')
      .eq('image_key', 'logo')
      .maybeSingle();

    if (data?.storage_path && logoImg) {
      logoImg.src = publicUrl(data.storage_path, data.updated_at);
    }
  }

  loadDynamicLogo();
</script>