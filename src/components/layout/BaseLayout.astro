---
// ============================================================
// কম্পোনেন্ট: বেস লেআউট
// ফাংশন: সব পেজের মাস্টার টেমপ্লেট
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — Phase 3 শেষ): PostFlowDrawer এখানে গ্লোবালি
// মাউন্ট করা হলো (bottom nav-এর "➕পোস্ট" থেকে
// smartfeni:open-post-flow ইভেন্ট dispatch করে ট্রিগার হয়)
//
// আপডেট (Play Store TWA প্রস্তুতি): service worker (/sw.js)
// রেজিস্ট্রেশন যোগ করা হলো — PWABuilder এটা ছাড়া PWA হিসেবে
// qualify করবে না। এটা Add-to-Home-Screen ইনস্টল ফ্লোতে কোনো
// পরিবর্তন আনে না, শুধু PWA হিসেবে টেকনিক্যালি complete করে।
// ============================================================

import Header from './Header.astro';
import Footer from './Footer.astro';
import BottomNav from './BottomNav.astro';
import CategoryDrawer from './CategoryDrawer.astro';
import NotificationDrawer from './NotificationDrawer.astro';
import HamburgerMenu from './HamburgerMenu.astro';
import PostFlowDrawer from './PostFlowDrawer.astro';
import ChatWidget from '../ChatWidget.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string | null;
  canonicalPath?: string | null;
  showChatWidget?: boolean;
}

const {
  title,
  description = 'স্মার্ট ফেনী - ফেনী জেলার প্রথম ডিজিটাল কমিউনিটি সার্ভিস ডিরেক্টরি। বাসা ভাড়া, টিউশন, রক্তদাতা, হোম ফুড, রিপেয়ার সহ ১৮+ ধরনের লোকাল সেবা এক জায়গায়।',
  keywords = 'স্মার্ট ফেনী, Smart Feni, ফেনী সার্ভিস ডিরেক্টরি, ফেনী কমিউনিটি প্ল্যাটফর্ম, ফেনী লোকাল সেবা',
  ogImage,
  canonicalPath,
  showChatWidget = false,
} = Astro.props;

const safeOgImage = ogImage || '/logo.png';
const safeCanonicalPath = canonicalPath || null;

const GA_MEASUREMENT_ID = 'G-RWTRLNTCD6';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://smartfeni.com';
const canonicalUrl = safeCanonicalPath
  ? `${siteUrl}${safeCanonicalPath.startsWith('/') ? safeCanonicalPath : `/${safeCanonicalPath}`}`
  : `${siteUrl}${Astro.url.pathname}`;
const absoluteOgImage = safeOgImage.startsWith('http') ? safeOgImage : `${siteUrl}${safeOgImage}`;

function guessImageType(url) {
  const lower = url.toLowerCase();
  if (lower.endsWith('.png')) return 'image/png';
  if (lower.endsWith('.webp')) return 'image/webp';
  if (lower.endsWith('.gif')) return 'image/gif';
  return 'image/jpeg';
}
const ogImageType = guessImageType(absoluteOgImage);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'স্মার্ট ফেনী (Smart Feni)',
  alternateName: 'Smart Feni Service Directory',
  description: 'ফেনী জেলার মাল্টি-ক্যাটাগরি হাইপারলোকাল কমিউনিটি সার্ভিস প্ল্যাটফর্ম',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  image: absoluteOgImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'ফেনী',
    addressRegion: 'চট্টগ্রাম বিভাগ',
    addressCountry: 'BD',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'ফেনী জেলা',
  },
};
---

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:secure_url" content={absoluteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="স্মার্ট ফেনী" />
  <meta property="og:locale" content="bn_BD" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
  <script define:vars={{ GA_MEASUREMENT_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID);
    window.gtag = gtag;
  </script>

  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#FF6B35" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="SmartFeni" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #F8FAFC;
      color: #1B2A4A;
      line-height: 1.6;
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FF6B35;
      color: #fff;
      padding: 14px 32px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 8px 24px rgba(255, 107, 53, 0.25);
    }

    .btn-primary:hover {
      background: #e85a2a;
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(255, 107, 53, 0.35);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      color: #1B2A4A;
      padding: 14px 32px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      border: 2px solid #1B2A4A;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-outline:hover {
      background: #1B2A4A;
      color: #fff;
    }

    .section-header {
      text-align: center;
      margin-bottom: 48px;
    }

    .section-tag {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 600;
      color: #FF6B35;
      background: #FFF0EA;
      padding: 4px 16px;
      border-radius: 40px;
      margin-bottom: 12px;
    }

    .section-header h2 {
      font-size: 2.4rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .section-header h2 .accent {
      color: #FF6B35;
    }

    .section-header p {
      color: #5A6E85;
      font-size: 1.1rem;
      margin-top: 8px;
    }

    @media (max-width: 768px) {
      .section-header h2 {
        font-size: 1.8rem;
      }
    }
  </style>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <BottomNav />
  <CategoryDrawer />
  <NotificationDrawer />
  <HamburgerMenu />
  <PostFlowDrawer />
  {showChatWidget && <ChatWidget />}

  <script>
    window.deferredInstallPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      window.deferredInstallPrompt = e;
      window.dispatchEvent(new CustomEvent('smartfeni:install-available'));
    });

    window.addEventListener('appinstalled', () => {
      window.deferredInstallPrompt = null;
      window.dispatchEvent(new CustomEvent('smartfeni:install-done'));
    });

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>

  <script>
    import { trackEvent } from '../../lib/analytics.js';

    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[href^="tel:"]');
      if (!link) return;

      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const category = pathParts[pathParts.length - 1] || 'home';

      const shopName = link.getAttribute('data-shop-name') || null;
      const upazila = localStorage.getItem('smartfeni_upazila');

      trackEvent('call_button_click', {
        category,
        upazila: upazila || null,
        ...(shopName ? { shop_name: shopName } : {}),
      });
    });
  </script>
</body>
</html>