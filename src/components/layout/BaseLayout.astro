---
// ============================================================
// কম্পোনেন্ট: বেস লেআউট
// ফাংশন: সব পেজের মাস্টার টেমপ্লেট
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (Play Store TWA প্রস্তুতি): service worker (/sw.js)
// রেজিস্ট্রেশন যোগ করা হলো
//
// আপডেট (থিম কালার ফিক্স): theme-color এখন সিস্টেমের
// light/dark মোড অনুযায়ী automatically সাদা/কালো হবে
//
// আপডেট (Push Notification, Phase 4): VAPID public key
// window global variable হিসেবে ক্লায়েন্ট-সাইডে পাঠানো হচ্ছে
// (GA_MEASUREMENT_ID এর মতো define:vars প্যাটার্নে)
//
// আপডেট ২ (Push Notification, Phase 4): NotificationPermissionPrompt
// কম্পোনেন্ট গ্লোবালি মাউন্ট করা হলো (NotificationDrawer এর মতো)
// — এটা নিজে থেকেই লগইন/পারমিশন স্ট্যাটাস চেক করে প্রয়োজনে দেখাবে
//
// আপডেট ৩ (Footer শুধু হোমপেজে): নতুন optional prop showFooter
// (ডিফল্ট false) যোগ হলো। <Footer /> এখন শুধু showFooter={true}
// পাস করা পেজে দেখাবে। index.astro তে showFooter={true} সেট করা
// আছে, বাকি সব পেজে (my-shop, checkout, product/[id] ইত্যাদি) prop
// পাস না করায় ফুটার অটোমেটিক হাইড থাকবে।
// ============================================================

import Header from './Header.astro';
import Footer from './Footer.astro';
import BottomNav from './BottomNav.astro';
import CategoryDrawer from './CategoryDrawer.astro';
import NotificationDrawer from './NotificationDrawer.astro';
import HamburgerMenu from './HamburgerMenu.astro';
import PostFlowDrawer from './PostFlowDrawer.astro';
import ChatWidget from '../ChatWidget.astro';
import NotificationPermissionPrompt from '../shared/NotificationPermissionPrompt.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string | null;
  canonicalPath?: string | null;
  showChatWidget?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description = 'স্মার্ট ফেনী - ফেনী জেলার প্রথম ডিজিটাল কমিউনিটি সার্ভিস ডিরেক্টরি। বাসা ভাড়া, টিউশন, রক্তদাতা, হোম ফুড, রিপেয়ার সহ ১৮+ ধরনের লোকাল সেবা এক জায়গায়।',
  keywords = 'স্মার্ট ফেনী, Smart Feni, ফেনী সার্ভিস ডিরেক্টরি, ফেনী কমিউনিটি প্ল্যাটফর্ম, ফেনী লোকাল সেবা',
  ogImage,
  canonicalPath,
  showChatWidget = false,
  showFooter = false,
} = Astro.props;

const safeOgImage = ogImage || '/logo.png';
const safeCanonicalPath = canonicalPath || null;

const GA_MEASUREMENT_ID = 'G-RWTRLNTCD6';

// Push Notification VAPID public key — সার্ভার-সাইডে যেকোনো নামের
// env var অ্যাক্সেস করা যায় (Astro ফ্রন্টম্যাটার সবসময় সার্ভারে চলে),
// তাই "PUBLIC_" প্রিফিক্স ছাড়াই এখানে পড়া সম্ভব
const VAPID_PUBLIC_KEY = import.meta.env.PUSH_KEY_PUBLIC || '';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://smartfeni.com';
const canonicalUrl = safeCanonicalPath
  ? `${siteUrl}${safeCanonicalPath.startsWith('/') ? safeCanonicalPath : `/${safeCanonicalPath}`}`
  : `${siteUrl}${Astro.url.pathname}`;
const absoluteOgImage = safeOgImage.startsWith('http') ? safeOgImage : `${siteUrl}${safeOgImage}`;

function guessImageType(url) {
  const lower = url.toLowerCase();
  if (lower.endsWith('.png')) return 'image/png';
  if (lower.endsWith('.webp')) return 'image/webp';
  if (lower.endsWith('.gif')) return 'image/gif';
  return 'image/jpeg';
}
const ogImageType = guessImageType(absoluteOgImage);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'স্মার্ট ফেনী (Smart Feni)',
  alternateName: 'Smart Feni Service Directory',
  description: 'ফেনী জেলার মাল্টি-ক্যাটাগরি হাইপারলোকাল কমিউনিটি সার্ভিস প্ল্যাটফর্ম',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  image: absoluteOgImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'ফেনী',
    addressRegion: 'চট্টগ্রাম বিভাগ',
    addressCountry: 'BD',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'ফেনী জেলা',
  },
};
---

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:secure_url" content={absoluteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="স্মার্ট ফেনী" />
  <meta property="og:locale" content="bn_BD" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
  <script define:vars={{ GA_MEASUREMENT_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID);
    window.gtag = gtag;
  </script>

  <script define:vars={{ VAPID_PUBLIC_KEY }}>
    window.__SMARTFENI_VAPID_KEY = VAPID_PUBLIC_KEY;
  </script>

  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="SmartFeni" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #F8FAFC;
      color: #1B2A4A;
      line-height: 1.6;
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* আপডেট (Laptop/Desktop Full-Width Fix): বড় স্ক্রিনে .container
       এর max-width ডাইনামিকভাবে বাড়বে, যাতে ল্যাপটপ/ডেস্কটপ মনিটরে
       দুই পাশে অতিরিক্ত খালি জায়গা না থাকে। মোবাইল/ট্যাবলেট ভিউ
       (max-width: 768px এর নিচের সব breakpoint) সম্পূর্ণ অপরিবর্তিত। */
    @media (min-width: 1440px) {
      .container {
        max-width: 1400px;
      }
    }

    @media (min-width: 1920px) {
      .container {
        max-width: 1680px;
      }
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FF6B35;
      color: #fff;
      padding: 14px 32px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 8px 24px rgba(255, 107, 53, 0.25);
    }

    .btn-primary:hover {
      background: #e85a2a;
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(255, 107, 53, 0.35);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      color: #1B2A4A;
      padding: 14px 32px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
      border: 2px solid #1B2A4A;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-outline:hover {
      background: #1B2A4A;
      color: #fff;
    }

    .section-header {
      text-align: center;
      margin-bottom: 48px;
    }

    .section-tag {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 600;
      color: #FF6B35;
      background: #FFF0EA;
      padding: 4px 16px;
      border-radius: 40px;
      margin-bottom: 12px;
    }

    .section-header h2 {
      font-size: 2.4rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .section-header h2 .accent {
      color: #FF6B35;
    }

    .section-header p {
      color: #5A6E85;
      font-size: 1.1rem;
      margin-top: 8px;
    }

    @media (max-width: 768px) {
      .section-header h2 {
        font-size: 1.8rem;
      }
    }

    /* ============================================================
       গ্লোবাল টোস্ট নোটিফিকেশন সিস্টেম
       (window.showToast(message, type, duration) দিয়ে যেকোনো
       পেজ/কম্পোনেন্ট/মোডাল থেকে কল করা যাবে)
       ============================================================ */
    .sf-toast-overlay {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      pointer-events: none;
    }

    .sf-toast {
      display: flex;
      align-items: center;
      gap: 14px;
      background: #FFFFFF;
      color: #1B2A4A;
      padding: 18px 28px;
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(27, 42, 74, 0.25);
      font-weight: 600;
      font-size: 0.98rem;
      max-width: 90vw;
      min-width: 260px;
      opacity: 0;
      transform: scale(0.85) translateY(10px);
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: auto;
      border-left: 6px solid #FF6B35;
    }

    .sf-toast.sf-toast-show {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    .sf-toast.sf-toast-success {
      border-left-color: #2ECC71;
    }

    .sf-toast.sf-toast-error {
      border-left-color: #E74C3C;
    }

    .sf-toast-icon {
      flex-shrink: 0;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      color: #fff;
    }

    .sf-toast-success .sf-toast-icon {
      background: #2ECC71;
    }

    .sf-toast-error .sf-toast-icon {
      background: #E74C3C;
    }

    .sf-toast-message {
      line-height: 1.4;
    }

    @media (max-width: 480px) {
      .sf-toast {
        padding: 16px 20px;
        font-size: 0.9rem;
        min-width: 0;
        width: calc(100vw - 48px);
      }
    }

    /* ============================================================
       গ্লোবাল Mandatory Field ভ্যালিডেশন স্টাইল
       (window.SFValidateForm(form) হেল্পার ফাংশনের সাথে ব্যবহারের জন্য)
       ============================================================ */
    .required-mark {
      color: #E74C3C;
      margin-left: 3px;
      font-weight: 700;
    }

    .field-error-msg {
      display: none;
      align-items: center;
      gap: 5px;
      color: #E74C3C;
      font-size: 0.8rem;
      font-weight: 500;
      margin-top: 6px;
    }

    .field-error-msg.show {
      display: flex;
    }

    .field-invalid {
      border-color: #E74C3C !important;
      background: #FFF5F5 !important;
    }
  </style>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  {showFooter && <Footer />}
  <BottomNav />
  <CategoryDrawer />
  <NotificationDrawer />
  <HamburgerMenu />
  <PostFlowDrawer />
  <NotificationPermissionPrompt />
  {showChatWidget && <ChatWidget />}

  <div id="sf-toast-overlay" class="sf-toast-overlay"></div>

  <script>
    window.deferredInstallPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      window.deferredInstallPrompt = e;
      window.dispatchEvent(new CustomEvent('smartfeni:install-available'));
    });

    window.addEventListener('appinstalled', () => {
      window.deferredInstallPrompt = null;
      window.dispatchEvent(new CustomEvent('smartfeni:install-done'));
    });

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>

  <script>
    import { trackEvent } from '../../lib/analytics.js';

    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[href^="tel:"]');
      if (!link) return;

      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const category = pathParts[pathParts.length - 1] || 'home';

      const shopName = link.getAttribute('data-shop-name') || null;
      const upazila = localStorage.getItem('smartfeni_upazila');

      trackEvent('call_button_click', {
        category,
        upazila: upazila || null,
        ...(shopName ? { shop_name: shopName } : {}),
      });
    });
  </script>

  <script>
    // ============================================================
    // গ্লোবাল টোস্ট নোটিফিকেশন
    // ব্যবহার: window.showToast('মেসেজ', 'success' | 'error', 3000)
    // ============================================================
    window.showToast = function (message, type = 'success', duration = 3000) {
      const overlay = document.getElementById('sf-toast-overlay');
      if (!overlay) return;

      // আগের টোস্ট থাকলে সরিয়ে নতুনটা দেখাবে
      overlay.innerHTML = '';

      const toast = document.createElement('div');
      toast.className = `sf-toast sf-toast-${type === 'error' ? 'error' : 'success'}`;

      const icon = document.createElement('div');
      icon.className = 'sf-toast-icon';
      icon.innerHTML =
        type === 'error'
          ? '<i class="fa-solid fa-xmark"></i>'
          : '<i class="fa-solid fa-check"></i>';

      const msg = document.createElement('div');
      msg.className = 'sf-toast-message';
      msg.textContent = message;

      toast.appendChild(icon);
      toast.appendChild(msg);
      overlay.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.add('sf-toast-show');
      });

      clearTimeout(window.__sfToastTimer);
      window.__sfToastTimer = setTimeout(() => {
        toast.classList.remove('sf-toast-show');
        setTimeout(() => {
          if (toast.parentNode) toast.parentNode.removeChild(toast);
        }, 250);
      }, duration);
    };

    // ============================================================
    // গ্লোবাল Mandatory Field ভ্যালিডেশন হেল্পার
    // ব্যবহার: const ok = window.SFValidateForm(formElement);
    // if (!ok) return; // submit বন্ধ
    //
    // প্রতিটা required ইনপুট/সিলেক্ট/টেক্সটএরিয়ার সাথে সংশ্লিষ্ট
    // error মেসেজ এলিমেন্ট খোঁজা হয় এভাবে:
    //   1) form এর ভিতরে [data-error-for="ইনপুটের id"]
    //   2) না পেলে, ইনপুটের প্যারেন্টের ভিতরে .field-error-msg
    // ============================================================
    window.SFValidateForm = function (form) {
      if (!form) return true;

      let isValid = true;
      let firstInvalidEl = null;

      const fields = form.querySelectorAll('[required]');

      fields.forEach((field) => {
        field.classList.remove('field-invalid');

        const errorEl =
          (field.id && form.querySelector(`[data-error-for="${field.id}"]`)) ||
          field.parentElement?.querySelector('.field-error-msg');

        if (errorEl) errorEl.classList.remove('show');

        let empty = false;

        if (field.type === 'checkbox') {
          empty = !field.checked;
        } else if (field.type === 'radio') {
          const group = form.querySelectorAll(`input[type="radio"][name="${field.name}"]`);
          empty = ![...group].some((r) => r.checked);
        } else {
          empty = !field.value || !String(field.value).trim();
        }

        if (empty) {
          isValid = false;
          field.classList.add('field-invalid');
          if (errorEl) errorEl.classList.add('show');
          if (!firstInvalidEl) firstInvalidEl = field;
        }
      });

      if (!isValid && firstInvalidEl) {
        firstInvalidEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => firstInvalidEl.focus(), 300);
      }

      return isValid;
    };

    // টাইপ করার সময় সংশ্লিষ্ট এরর অটোমেটিক মুছে যাবে (UX ইম্প্রুভমেন্ট)
    document.addEventListener('input', (e) => {
      const field = e.target;
      if (!field.classList || !field.classList.contains('field-invalid')) return;

      field.classList.remove('field-invalid');
      const form = field.closest('form');
      const errorEl =
        (field.id && form?.querySelector(`[data-error-for="${field.id}"]`)) ||
        field.parentElement?.querySelector('.field-error-msg');
      if (errorEl) errorEl.classList.remove('show');
    });
  </script>
</body>
</html>
