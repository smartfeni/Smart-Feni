---
// ============================================================
// কম্পোনেন্ট: বটম নেভিগেশন বার (মোবাইল-ফার্স্ট)
// অর্ডার: হোম | ক্যাটাগরি | ➕পোস্ট(elevated) | মেসেজ | প্রোফাইল
//
// আপডেট (Oct 2026): "মেসেজ" বাটন লগইন ছাড়াও খোলে — লগইন না থাকলে
// গেস্ট প্রমো তালিকা (অফার ও খবর), লগইন থাকলে ব্যক্তিগত ইনবক্স।
//
// আপডেট: "প্রোফাইল" বাটনের আইকন fa-circle-user → fa-bars —
// এটা HamburgerMenu (ড্রয়ার) খোলে, সরাসরি প্রোফাইলে যায় না, তাই
// মেনু-স্টাইল আইকন বেশি accurate। লেবেল ("প্রোফাইল") অপরিবর্তিত।
// ============================================================
---

<nav class="bottom-nav" id="bottomNav">
  <a href="/" class="bn-item" id="bnHome" data-path="/">
    <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>
    <span>হোম</span>
  </a>

  <button type="button" class="bn-item" id="bnCategory">
    <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    <span>ক্যাটাগরি</span>
  </button>

  <button type="button" class="bn-item bn-center" id="bnPost">
    <span class="bn-center-circle">
      <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true" style="stroke-width:3"><path d="M12 5v14M5 12h14"/></svg>
    </span>
    <span class="bn-center-label">পোস্ট</span>
  </button>

  <button type="button" class="bn-item bn-msg" id="bnMessage">
    <span class="bn-icon-wrap">
      <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01" style="stroke-width:3"/></svg>
      <span class="bn-badge" id="bnMsgBadge" style="display:none;">0</span>
    </span>
    <span>মেসেজ</span>
  </button>

  <button type="button" class="bn-item" id="bnProfile" data-path="/profile/edit">
    <span class="bn-icon-wrap">
      <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <span class="bn-badge" id="bnMenuBadge" style="display:none;">0</span>
    </span>
    <span>মেনু</span>
  </button>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 998;
    background: #fff;
    border-top: 1px solid #EEF3F9;
    box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: flex-start;
    justify-content: space-around;
    padding: 8px 4px calc(6px + env(safe-area-inset-bottom));
  }

  .bn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: none;
    border: none;
    text-decoration: none;
    color: #5C7086;
    font-size: 0.65rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    padding: 4px 6px;
    flex: 1;
    min-width: 0;
  }

  .bn-item i {
    font-size: 1.15rem;
    margin-bottom: 1px;
  }

  /* inline SVG আইকন — FontAwesome ফন্ট লোডের অপেক্ষা নেই, প্রথম ফ্রেমেই দেখায় */
  .bn-svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .bn-item.active {
    color: #FF6B35;
  }

  .bn-icon-wrap {
    position: relative;
    display: flex;
  }

  .bn-badge {
    position: absolute;
    top: -4px;
    right: -8px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    border-radius: 20px;
    background: #D14343;
    color: #fff;
    font-size: 0.55rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 0 0 2px #fff;
  }

  .bn-center {
    position: relative;
    flex: 1;
    color: #1B2A4A;
  }

  .bn-center-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #FF6B35;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-top: -26px;
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    border: 4px solid #fff;
  }

  .bn-center-label {
    margin-top: 2px;
    font-size: 0.65rem;
    font-weight: 700;
    color: #1B2A4A;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { applyProNav } from '../../lib/proApp.js';

  const bnCategory = document.getElementById('bnCategory');
  const bnProfile = document.getElementById('bnProfile');
  const bnPost = document.getElementById('bnPost');
  const bnMessage = document.getElementById('bnMessage');
  const bnMsgBadge = document.getElementById('bnMsgBadge');
  const bnMenuBadge = document.getElementById('bnMenuBadge');

  bnCategory?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('smartfeni:open-category-drawer'));
  });

  // মেসেজ বক্স এখন লগইন ছাড়াও খোলে: লগইন থাকলে ব্যক্তিগত ইনবক্স, না থাকলে
  // অ্যাডমিনের অফার ও খবরের পাবলিক তালিকা (NotificationDrawer.astro নিজেই
  // সেশন দেখে ঠিক করে কোনটা খুলবে)
  bnMessage?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('smartfeni:open-notification-drawer'));
  });

  bnProfile?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.dispatchEvent(new CustomEvent('smartfeni:open-hamburger-menu'));
    } else {
      window.openAuthModal?.('login');
    }
  });

  bnPost?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('smartfeni:open-post-flow'));
  });

  window.addEventListener('smartfeni:notification-count', (e) => {
    const count = e.detail?.count || 0;
    if (!bnMsgBadge) return;
    if (count > 0) {
      bnMsgBadge.textContent = count > 9 ? '৯+' : String(count);
      bnMsgBadge.style.display = 'flex';
    } else {
      bnMsgBadge.style.display = 'none';
    }
  });

  // অ্যাডমিন/মডারেটর: চ্যাট বটের নতুন ম্যানুয়াল অর্ডার সংখ্যা (HamburgerMenu ইভেন্ট পাঠায়)
  window.addEventListener('smartfeni:manual-order-count', (e) => {
    const count = e.detail?.count || 0;
    if (!bnMenuBadge) return;
    if (count > 0) {
      bnMenuBadge.textContent = count > 9 ? '৯+' : String(count).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
      bnMenuBadge.style.display = 'flex';
    } else {
      bnMenuBadge.style.display = 'none';
    }
  });

  window.addEventListener('smartfeni:logged-out', () => {
    if (bnMsgBadge) bnMsgBadge.style.display = 'none';
    if (bnMenuBadge) bnMenuBadge.style.display = 'none';
  });

  // Pro অ্যাপে (com.smartfeni.pro) হোম বাটন ও লোগো /pro-তে যাবে; ওয়েব/মেইন অ্যাপে কিছুই করে না
  applyProNav();

  const currentPath = window.location.pathname;
  document.querySelectorAll('.bn-item[data-path]').forEach((el) => {
    const path = el.dataset.path;
    if (path === '/' ? currentPath === '/' : currentPath.startsWith(path)) {
      el.classList.add('active');
    }
  });
</script>