---
// ============================================================
// কম্পোনেন্ট: বটম নেভিগেশন — "দ্বীপ" ডিজাইন (নভে ২০২৬, SF)
// বাঁ দ্বীপ: হোম | মাঝের ক্যাপসুল: ক্যাটাগরি · বড় গোল পোস্ট · মেসেজ | ডান দ্বীপ: মেনু
// - গাঢ় কাচ (backdrop blur), পেছনের কনটেন্ট দ্বীপগুলোর ফাঁক দিয়ে দেখা যায়
// - চালু বাটন: আইকনের পেছনে সাদা টিপ + নাম গাঢ়; বাটনের মাপ বদলায় না (লেআউট নড়ে না)
// - সবসময় স্থির থাকে, স্ক্রলে লুকায় না (SF, নভে ২০২৬)
// - প্রথমবার পোস্ট বাটন একবার হালকা নড়ে (localStorage: sf_post_hint_v1); reduced-motion-এ নড়ে না
// আইডি (bnHome, bnCategory, bnPost, bnMessage, bnProfile, bnMsgBadge, bnMenuBadge) ও ইভেন্ট আগের মতো;
// proApp.js-এর applyProNav() bnHome-এর href/active বদলায়।
// "মেসেজ" লগইন ছাড়াও খোলে (গেস্টে অফার ও খবর); "মেনু" HamburgerMenu খোলে, লগইন না থাকলে লগইন।
// ============================================================
---

<nav class="bottom-nav" id="bottomNav" aria-label="প্রধান নেভিগেশন">
  <div class="bn-island">
    <a href="/" class="bn-item" id="bnHome" data-path="/">
      <span class="bn-ic">
        <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 10.2 12 4l7.5 6.2V19a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19z"/><path d="M10 20.5v-5h4v5"/></svg>
      </span>
      <span class="bn-lb">হোম</span>
    </a>
  </div>

  <div class="bn-island bn-mid">
    <button type="button" class="bn-item" id="bnCategory">
      <span class="bn-ic">
        <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><circle cx="17" cy="17" r="3.5"/></svg>
      </span>
      <span class="bn-lb">ক্যাটাগরি</span>
    </button>

    <button type="button" class="bn-post" id="bnPost" aria-label="পোস্ট">
      <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    </button>

    <button type="button" class="bn-item" id="bnMessage">
      <span class="bn-ic">
        <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c4.9 0 8.5 3.4 8.5 7.6s-3.6 7.6-8.5 7.6c-1 0-2-.1-2.9-.4L4.5 20l1-3.7a7.3 7.3 0 0 1-2-5.2c0-4.2 3.6-7.6 8.5-7.6z"/></svg>
        <span class="bn-badge" id="bnMsgBadge" style="display:none;">0</span>
      </span>
      <span class="bn-lb">মেসেজ</span>
    </button>
  </div>

  <div class="bn-island">
    <button type="button" class="bn-item" id="bnProfile" data-path="/profile/edit">
      <span class="bn-ic">
        <svg class="bn-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
        <span class="bn-badge" id="bnMenuBadge" style="display:none;">0</span>
      </span>
      <span class="bn-lb">মেনু</span>
    </button>
  </div>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    left: 12px;
    right: 12px;
    max-width: 440px;
    margin: 0 auto;
    bottom: calc(14px + env(safe-area-inset-bottom));
    z-index: 998;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .bn-island {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: 29px;
    background: rgba(19, 32, 43, 0.86);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 12px 28px rgba(19, 32, 43, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bn-island {
      background: rgba(19, 32, 43, 0.96);
    }
  }

  .bn-item {
    width: 56px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 24px;
    background: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: rgba(255, 255, 255, 0.8);
    font-family: inherit;
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .bn-ic {
    position: relative;
    width: 40px;
    height: 26px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .bn-lb {
    white-space: nowrap;
  }

  /* inline SVG আইকন — ফন্ট লোডের অপেক্ষা নেই, প্রথম ফ্রেমেই দেখায় */
  .bn-svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .bn-item:active .bn-ic {
    background: rgba(255, 255, 255, 0.16);
  }

  .bn-item.active {
    color: #fff;
    font-weight: 800;
  }

  .bn-item.active .bn-ic {
    background: #fff;
    color: #13202B;
  }

  .bn-item:focus-visible,
  .bn-post:focus-visible {
    outline: 3px solid #FF6B35;
    outline-offset: 2px;
  }

  .bn-badge {
    position: absolute;
    top: -5px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    box-sizing: border-box;
    border-radius: 8px;
    background: #FF6B35;
    color: #fff;
    font-size: 0.58rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 0 0 2px #13202B;
  }

  .bn-post {
    width: 60px;
    height: 60px;
    margin: -14px 2px;
    padding: 0;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.95);
    box-sizing: border-box;
    background: #FF6B35;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 22px rgba(255, 107, 53, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s ease;
  }

  .bn-post .bn-svg {
    width: 26px;
    height: 26px;
    stroke-width: 2.4;
  }

  .bn-post:active {
    transform: scale(0.94);
  }

  /* প্রথমবার একবার হালকা নড়া */
  .bn-post.bn-wiggle {
    animation: bnWiggle 0.9s ease 0.8s 1;
  }

  @keyframes bnWiggle {
    0%, 100% { transform: rotate(0) scale(1); }
    20% { transform: rotate(-12deg) scale(1.06); }
    40% { transform: rotate(10deg) scale(1.06); }
    60% { transform: rotate(-6deg) scale(1.03); }
    80% { transform: rotate(3deg) scale(1.01); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bn-ic,
    .bn-post {
      transition: none;
    }
    .bn-post.bn-wiggle {
      animation: none;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { applyProNav } from '../../lib/proApp.js';

  const bnCategory = document.getElementById('bnCategory');
  const bnProfile = document.getElementById('bnProfile');
  const bnPost = document.getElementById('bnPost');
  const bnMessage = document.getElementById('bnMessage');
  const bnMsgBadge = document.getElementById('bnMsgBadge');
  const bnMenuBadge = document.getElementById('bnMenuBadge');

  bnCategory?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('smartfeni:open-category-drawer'));
  });

  // মেসেজ বক্স লগইন ছাড়াও খোলে: লগইন থাকলে ব্যক্তিগত ইনবক্স, না থাকলে
  // অ্যাডমিনের অফার ও খবরের পাবলিক তালিকা (NotificationDrawer.astro নিজেই সেশন দেখে)
  bnMessage?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('smartfeni:open-notification-drawer'));
  });

  bnProfile?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.dispatchEvent(new CustomEvent('smartfeni:open-hamburger-menu'));
    } else {
      (window as any).openAuthModal?.('login');
    }
  });

  bnPost?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('smartfeni:open-post-flow'));
  });

  window.addEventListener('smartfeni:notification-count', (e: any) => {
    const count = e.detail?.count || 0;
    if (!bnMsgBadge) return;
    if (count > 0) {
      bnMsgBadge.textContent = count > 9 ? '৯+' : String(count);
      bnMsgBadge.style.display = 'flex';
    } else {
      bnMsgBadge.style.display = 'none';
    }
  });

  // অ্যাডমিন/মডারেটর: চ্যাট বটের নতুন ম্যানুয়াল অর্ডার সংখ্যা (HamburgerMenu ইভেন্ট পাঠায়)
  window.addEventListener('smartfeni:manual-order-count', (e: any) => {
    const count = e.detail?.count || 0;
    if (!bnMenuBadge) return;
    if (count > 0) {
      bnMenuBadge.textContent = count > 9 ? '৯+' : String(count).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
      bnMenuBadge.style.display = 'flex';
    } else {
      bnMenuBadge.style.display = 'none';
    }
  });

  window.addEventListener('smartfeni:logged-out', () => {
    if (bnMsgBadge) bnMsgBadge.style.display = 'none';
    if (bnMenuBadge) bnMenuBadge.style.display = 'none';
  });

  // Pro অ্যাপে (com.smartfeni.pro) হোম বাটন ও লোগো /pro-তে যাবে; ওয়েব/মেইন অ্যাপে কিছুই করে না
  applyProNav();

  const currentPath = window.location.pathname;
  document.querySelectorAll<HTMLElement>('.bn-item[data-path]').forEach((el) => {
    const path = el.dataset.path || '';
    if (path === '/' ? currentPath === '/' : currentPath.startsWith(path)) {
      el.classList.add('active');
      el.setAttribute('aria-current', 'page');
    }
  });

  // নতুন ইউজারকে পোস্ট বাটন চেনাতে প্রথমবার একবার নড়া
  try {
    if (bnPost && !localStorage.getItem('sf_post_hint_v1')) {
      bnPost.classList.add('bn-wiggle');
      localStorage.setItem('sf_post_hint_v1', '1');
      bnPost.addEventListener('animationend', () => bnPost.classList.remove('bn-wiggle'), { once: true });
    }
  } catch (e) {}
</script>
