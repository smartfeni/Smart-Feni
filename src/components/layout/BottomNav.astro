<!-- path: src/components/layout/BottomNav.astro -->
---
// ============================================================
// কম্পোনেন্ট: বটম নেভিগেশন বার (মোবাইল-ফার্স্ট)
// ইন্সপিরেশন: smartfenibd.com এর bottom nav, কিন্তু Smart Feni
// ব্র্যান্ডিং এ অ্যাডাপ্ট করা — মাঝের "পোস্ট" বাটন elevated/circular।
// অর্ডার: হোম | ক্যাটাগরি | ➕পোস্ট(elevated) | মেসেজ | প্রোফাইল
// এই ধাপে শুধু UI/navigation shell — ক্যাটাগরি ও পোস্ট এখনো
// placeholder (পরের ফেজে আসল ফাংশনালিটি বসবে)।
// ============================================================
---

<nav class="bottom-nav" id="bottomNav">
  <a href="/" class="bn-item" id="bnHome" data-path="/">
    <i class="fas fa-house"></i>
    <span>হোম</span>
  </a>

  <a href="/" class="bn-item" id="bnCategory">
    <i class="fas fa-grip"></i>
    <span>ক্যাটাগরি</span>
  </a>

  <button type="button" class="bn-item bn-center" id="bnPost">
    <span class="bn-center-circle">
      <i class="fas fa-plus"></i>
    </span>
    <span class="bn-center-label">পোস্ট</span>
  </button>

  <button type="button" class="bn-item" id="bnMessage">
    <i class="fas fa-comment-dots"></i>
    <span>মেসেজ</span>
  </button>

  <button type="button" class="bn-item" id="bnProfile" data-path="/profile/edit">
    <i class="fas fa-circle-user"></i>
    <span>প্রোফাইল</span>
  </button>
</nav>

<div class="bn-toast" id="bnToast"></div>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 998;
    background: #fff;
    border-top: 1px solid #EEF3F9;
    box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: flex-start;
    justify-content: space-around;
    padding: 8px 4px calc(6px + env(safe-area-inset-bottom));
  }

  .bn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: none;
    border: none;
    text-decoration: none;
    color: #8FA0BC;
    font-size: 0.65rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    padding: 4px 6px;
    flex: 1;
    min-width: 0;
  }

  .bn-item i {
    font-size: 1.15rem;
    margin-bottom: 1px;
  }

  .bn-item.active {
    color: #FF6B35;
  }

  /* ===== মাঝের elevated পোস্ট বাটন ===== */
  .bn-center {
    position: relative;
    flex: 1;
    color: #1B2A4A;
  }

  .bn-center-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #FF6B35;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-top: -26px;
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    border: 4px solid #fff;
  }

  .bn-center-label {
    margin-top: 2px;
    font-size: 0.65rem;
    font-weight: 700;
    color: #1B2A4A;
  }

  /* ===== ছোট টোস্ট (placeholder ফিচারের জন্য) ===== */
  .bn-toast {
    position: fixed;
    bottom: 78px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #1B2A4A;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 40px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 1500;
    white-space: nowrap;
  }

  .bn-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const bnProfile = document.getElementById('bnProfile');
  const bnPost = document.getElementById('bnPost');
  const bnMessage = document.getElementById('bnMessage');
  const bnToast = document.getElementById('bnToast');

  let toastTimer = null;
  function showToast(text) {
    if (!bnToast) return;
    bnToast.textContent = text;
    bnToast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => bnToast.classList.remove('show'), 1800);
  }

  // প্রোফাইল — Header.astro এর একই প্যাটার্ন: লগইন থাকলে সরাসরি
  // পেজে, না থাকলে AuthModal
  bnProfile?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.location.href = '/profile/edit';
    } else {
      window.openAuthModal?.('login');
    }
  });

  // পোস্ট ও মেসেজ — এখনো placeholder (পরের ফেজে আসল ফাংশন বসবে)
  bnPost?.addEventListener('click', () => {
    showToast('এই ফিচার শীঘ্রই আসছে');
  });

  bnMessage?.addEventListener('click', () => {
    showToast('এই ফিচার শীঘ্রই আসছে');
  });

  // ===== অ্যাক্টিভ স্টেট (বর্তমান পেজ অনুযায়ী) =====
  const currentPath = window.location.pathname;
  document.querySelectorAll('.bn-item[data-path]').forEach((el) => {
    const path = el.dataset.path;
    if (path === '/' ? currentPath === '/' : currentPath.startsWith(path)) {
      el.classList.add('active');
    }
  });
</script>