<!-- path: src/components/layout/HamburgerMenu.astro -->
---
// ============================================================
// কম্পোনেন্ট: HamburgerMenu — bottom nav "প্রোফাইল" আইকন থেকে
// ট্রিগার (লগইন থাকলে) — ডান দিক থেকে স্লাইড-ইন।
// ট্রিগার: window.dispatchEvent(new CustomEvent('smartfeni:open-hamburger-menu'))
//
// আপডেট: ট্রিগার বাটনের আইকন BottomNav.astro-তে বদলানো হয়েছে
// (fa-circle-user → fa-bars, মেনু-স্টাইল) — এই ড্রয়ারের ভেতরের
// কনটেন্ট অপরিবর্তিত (অ্যাভাটার+নাম+"প্রোফাইল এডিট করুন" কার্ড আগের মতোই)।
//
// রোল-চেক লজিক profile/edit.astro থেকে হুবহু কপি:
//   isAdminOrMod = role === 'admin' || role === 'moderator'
//   isAdmin      = role === 'admin' (strict, লাকি ড্র-র জন্য)
//   isShopOwner  = !!is_shop_owner
//   isClubOwner  = !!is_club_owner
// ডেলিভারি হিরো → /delivery-hero (delivery_riders-এ নিজের রো থাকলেই
// দেখাবে, is_active অন/অফ যাই থাকুক)। লাকি ড্র → শুধু strict admin।
//
// আপডেট (এই সেশন):
// - প্রোফাইল রো: এখন পুরো রো ক্লিকযোগ্য না — নামের পাশে ছোট
//   গিয়ার আইকন বাটন (শুধু আইকন) /profile/edit এ নিয়ে যায়।
//   নামের নিচে "প্রোফাইল এডিট করুন" হিন্টের বদলে ফোন নাম্বার।
// - নিচের মেনু লিস্ট (.hm-list) vertical row থেকে 2-column গ্রিড
//   কার্ডে বদলানো হয়েছে (আইকন উপরে, নাম নিচে) — প্রোফাইল রো এবং
//   লগ আউট বাটন আগের মতোই ফুল-উইথ থাকছে, শুধু মাঝের আইটেমগুলো গ্রিড।
//
// আপডেট (প্রোফাইল ফ্ল্যাশ ফিক্স, Header.astro-র সাথে কনসিস্টেন্ট):
// মেনু ওপেন করলেই আগে সব রোল-চেক নেটওয়ার্ক কল (profile + moderators
// + delivery_riders) শেষ না হওয়া পর্যন্ত নাম "প্রোফাইল" আর সব
// শপ/ক্লাব/অ্যাডমিন আইটেম হঠাৎ ভেসে উঠত। এখন cache-first: আগের
// সফল ফলাফল localStorage ('sf_hamburger_cache_v1') এ রাখা হয়, মেনু
// ওপেন করা মাত্রই সেটা সাথে সাথে দেখানো হয়, ব্যাকগ্রাউন্ডে ফ্রেশ
// ডেটা এসে সাইলেন্টলি কারেক্ট করে দেয়। cache না থাকলে (প্রথমবার)
// নাম/অ্যাভাটারে শুধু শিমার দেখাবে (আইটেমগুলো এমনিতেই ডিফল্ট hidden,
// তাই ভুল কিছু দেখানোর ঝুঁকি নেই)। ভিন্ন ইউজারের cache পেলে (শেয়ারড
// ডিভাইস) সেটা ক্লিয়ার করে ফ্রেশ ডেটার জন্য অপেক্ষা করে।
// ============================================================
---

<div class="hm-overlay" id="hamburgerMenuOverlay">
  <aside class="hm-panel" id="hamburgerMenuPanel">
    <div class="hm-header">
      <button class="hm-close" id="hamburgerMenuClose" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="hm-profile-row" id="hmProfileRow">
      <span class="hm-avatar" id="hmAvatar">
        <img id="hmAvatarImg" src="" alt="প্রোফাইল ছবি" />
        <i class="fas fa-circle-user" id="hmDefaultIcon"></i>
      </span>
      <span class="hm-profile-info">
        <span class="hm-profile-name" id="hmProfileName">প্রোফাইল</span>
        <span class="hm-profile-phone" id="hmProfilePhone"></span>
      </span>
      <a href="/profile/edit" class="hm-settings-btn" id="hmSettingsBtn" aria-label="প্রোফাইল এডিট করুন">
        <i class="fas fa-gear"></i>
      </a>
    </div>

    <div class="hm-list">
      <a href="/my-shop" class="hm-item" id="hmShopItem" style="display:none;">
        <span class="hm-item-icon"><i class="fas fa-store"></i></span>
        <span class="hm-item-label">আমার শপ</span>
      </a>

      <a href="/my-club" class="hm-item" id="hmClubItem" style="display:none;">
        <span class="hm-item-icon"><i class="fas fa-people-group"></i></span>
        <span class="hm-item-label">আমার ক্লাব</span>
      </a>

      <a href="/admin" class="hm-item" id="hmAdminItem" style="display:none;">
        <span class="hm-item-icon"><i class="fas fa-user-shield"></i></span>
        <span class="hm-item-label">অ্যাডমিন প্যানেল</span>
      </a>

      <a href="/admin/lucky-draw" class="hm-item" id="hmLuckyDrawItem" style="display:none;">
        <span class="hm-item-icon"><i class="fas fa-gift"></i></span>
        <span class="hm-item-label">লাকি ড্র</span>
      </a>

      <a href="/delivery-hero" class="hm-item" id="hmRiderItem" style="display:none;">
        <span class="hm-item-icon"><i class="fas fa-motorcycle"></i></span>
        <span class="hm-item-label">ডেলিভারি হিরো</span>
      </a>

      <a href="/ride-hero" class="hm-item" id="hmRideRiderItem" style="display:none;">
        <span class="hm-item-icon"><i class="fas fa-route"></i></span>
        <span class="hm-item-label">রাইড হিরো</span>
      </a>

      <a href="/my-listings" class="hm-item">
        <span class="hm-item-icon"><i class="fas fa-list-check"></i></span>
        <span class="hm-item-label">আমার পোস্ট</span>
      </a>

      <a href="/my-orders" class="hm-item">
        <span class="hm-item-icon"><i class="fas fa-receipt"></i></span>
        <span class="hm-item-label">আমার অর্ডার</span>
      </a>
    </div>

    <button type="button" class="hm-logout-btn" id="hmLogoutBtn">
      <i class="fas fa-arrow-right-from-bracket"></i>
      <span id="hmLogoutText">লগ আউট</span>
    </button>
  </aside>
</div>

<style>
  .hm-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 2200;
  }

  .hm-overlay.open {
    display: block;
  }

  .hm-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 86vw);
    background: #fff;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }

  .hm-overlay.open .hm-panel {
    transform: translateX(0);
  }

  .hm-header {
    display: flex;
    justify-content: flex-end;
    padding: 14px 14px 0;
  }

  .hm-close {
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hm-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .hm-profile-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 20px 18px;
    border-bottom: 1px solid #EEF3F9;
    margin-bottom: 8px;
  }

  .hm-settings-btn {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #F4F7FC;
    color: #5A6E85;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .hm-settings-btn:hover,
  .hm-settings-btn:active {
    background: #FF6B35;
    color: #fff;
  }

  .hm-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF0EA;
    border: 2px solid #FFE3D4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .hm-avatar #hmDefaultIcon {
    color: #FF6B35;
    font-size: 1.9rem;
  }

  .hm-avatar img {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hm-avatar.has-photo #hmDefaultIcon {
    display: none;
  }

  .hm-avatar.has-photo img {
    display: block;
  }

  .hm-profile-info {
    min-width: 0;
  }

  .hm-profile-name {
    display: block;
    font-size: 1.02rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hm-profile-phone {
    display: block;
    font-size: 0.8rem;
    color: #8FA0BC;
    font-weight: 600;
    margin-top: 2px;
    direction: ltr;
    unicode-bidi: isolate;
  }

  /* ===== স্কেলিটন শিমার — cache না থাকলে প্রথমবার মেনু ওপেনের সময়
     (Header.astro-র hdr-skeleton এর সাথে কনসিস্টেন্ট প্যাটার্ন) ===== */
  @keyframes hmShimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
  }

  .hm-avatar.hm-skeleton {
    background: linear-gradient(90deg, #EEF1F6 25%, #E2E6ED 37%, #EEF1F6 63%);
    background-size: 400% 100%;
    animation: hmShimmer 1.4s ease infinite;
    border-color: #E2E6ED;
  }

  .hm-avatar.hm-skeleton #hmDefaultIcon,
  .hm-avatar.hm-skeleton img {
    visibility: hidden;
  }

  .hm-profile-name.hm-skeleton {
    display: inline-block;
    width: 90px;
    height: 13px;
    border-radius: 6px;
    color: transparent;
    background: linear-gradient(90deg, #EEF1F6 25%, #E2E6ED 37%, #EEF1F6 63%);
    background-size: 400% 100%;
    animation: hmShimmer 1.4s ease infinite;
  }

  .hm-profile-phone.hm-skeleton {
    display: inline-block;
    width: 70px;
    height: 11px;
    border-radius: 6px;
    color: transparent;
    background: linear-gradient(90deg, #EEF1F6 25%, #E2E6ED 37%, #EEF1F6 63%);
    background-size: 400% 100%;
    animation: hmShimmer 1.4s ease infinite;
    margin-top: 2px;
  }

  /* নোট: 2-column গ্রিড — আগে vertical লিস্ট ছিল */
  .hm-list {
    flex: 1;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 2px 10px;
  }

  .hm-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 8px;
    border-radius: 16px;
    background: #F8FAFC;
    text-decoration: none;
    color: #1B2A4A;
    text-align: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  a.hm-item:hover,
  a.hm-item:active {
    background: #FFF0EA;
    transform: translateY(-1px);
  }

  .hm-item-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  a.hm-item:hover .hm-item-icon,
  a.hm-item:active .hm-item-icon {
    background: #fff;
  }

  .hm-item-label {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .hm-logout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin: 10px 16px calc(16px + env(safe-area-inset-bottom));
    padding: 13px;
    border-radius: 14px;
    background: #FFF0EA;
    color: #D14343;
    border: 1.5px solid #FFD9CC;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hm-logout-btn.confirming {
    background: #D14343;
    color: #fff;
    border-color: #D14343;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const overlay = document.getElementById('hamburgerMenuOverlay');
  const closeBtn = document.getElementById('hamburgerMenuClose');

  const avatarWrap = document.getElementById('hmAvatar');
  const avatarImg = document.getElementById('hmAvatarImg');
  const profileName = document.getElementById('hmProfileName');
  const profilePhone = document.getElementById('hmProfilePhone');

  const shopItem = document.getElementById('hmShopItem');
  const clubItem = document.getElementById('hmClubItem');
  const adminItem = document.getElementById('hmAdminItem');
  const luckyDrawItem = document.getElementById('hmLuckyDrawItem');
  const riderItem = document.getElementById('hmRiderItem');
  const rideRiderItem = document.getElementById('hmRideRiderItem');

  const logoutBtn = document.getElementById('hmLogoutBtn');
  const logoutText = document.getElementById('hmLogoutText');
  let logoutConfirming = false;

  const HAMBURGER_CACHE_KEY = 'sf_hamburger_cache_v1';

  async function loadProfileAndRoles() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name, phone, avatar_url, role, is_shop_owner, is_club_owner')
      .eq('id', session.user.id)
      .single();

    if (!profile) return;

    const { data: modRows } = await supabase
      .from('moderators')
      .select('entity_type')
      .eq('profile_id', session.user.id);

    const isShopModerator = (modRows || []).some((m) => m.entity_type === 'shop');
    const isClubModerator = (modRows || []).some((m) => m.entity_type === 'club');

    // ===== ডেলিভারি/রাইড হিরো — যার যেই ক্যাটাগরিতে (checkbox)
    // রেজিস্ট্রেশন করা আছে সেটাই দেখাবে, is_active (অনলাইন/অফলাইন)
    // যাই থাকুক না কেন — টগল অফ থাকলেও রাইডার নিজের ড্যাশবোর্ড
    // অ্যাক্সেস করতে পারবে =====
    const { data: riderRow } = await supabase
      .from('delivery_riders')
      .select('id, offers_delivery, offers_ride')
      .eq('profile_id', session.user.id)
      .maybeSingle();

    const state = {
      userId: session.user.id,
      name: profile.full_name || null,
      phone: profile.phone || null,
      avatarUrl: profile.avatar_url || null,
      isAdminOrMod: profile.role === 'admin' || profile.role === 'moderator',
      isAdmin: profile.role === 'admin',
      isShopOwner: !!profile.is_shop_owner,
      isClubOwner: !!profile.is_club_owner,
      isShopModerator,
      isClubModerator,
      offersDelivery: !!riderRow?.offers_delivery,
      offersRide: !!riderRow?.offers_ride,
    };

    applyState(state);
    writeHamburgerCache(state);
  }

  function applyState(state) {
    setSkeleton(false);
    profileName.textContent = state.name || 'প্রোফাইল';
    profilePhone.textContent = state.phone || '';
    if (state.avatarUrl) {
      avatarImg.src = state.avatarUrl;
      avatarWrap?.classList.add('has-photo');
    } else {
      avatarImg.src = '';
      avatarWrap?.classList.remove('has-photo');
    }

    // ===== মডারেটর চেক — is_shop_owner/is_club_owner ফ্ল্যাগ শুধু
    // আসল ওউনারের জন্য সেট হয়, মডারেটরের জন্য না। তাই moderators
    // টেবিলে নিজের রো (যেকোনো entity_id) আছে কিনা আলাদাভাবে চেক
    // করতে হবে — নাহলে মডারেটর হ্যামবার্গার মেনুতে "আমার শপ"/
    // "আমার ক্লাব" দেখতেই পাবে না, /my-shop বা /my-club এ ঢোকার
    // কোনো পথ থাকবে না। =====
    shopItem.style.display = state.isShopOwner || state.isShopModerator ? 'flex' : 'none';
    clubItem.style.display = state.isClubOwner || state.isClubModerator ? 'flex' : 'none';
    adminItem.style.display = state.isAdminOrMod ? 'flex' : 'none';
    luckyDrawItem.style.display = state.isAdmin ? 'flex' : 'none';
    riderItem.style.display = state.offersDelivery ? 'flex' : 'none';
    rideRiderItem.style.display = state.offersRide ? 'flex' : 'none';
  }

  function setSkeleton(on) {
    avatarWrap?.classList.toggle('hm-skeleton', on);
    profileName?.classList.toggle('hm-skeleton', on);
    profilePhone?.classList.toggle('hm-skeleton', on);
  }

  function readHamburgerCache() {
    try {
      const raw = localStorage.getItem(HAMBURGER_CACHE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function writeHamburgerCache(state) {
    try {
      localStorage.setItem(HAMBURGER_CACHE_KEY, JSON.stringify(state));
    } catch {
      // localStorage ব্লকড/ডিসেবল থাকলে চুপচাপ ইগনোর — cache ছাড়াই কাজ চলবে
    }
  }

  function clearHamburgerCache() {
    try {
      localStorage.removeItem(HAMBURGER_CACHE_KEY);
    } catch {
      // ইগনোর
    }
  }

  function openMenu() {
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';

    // ===== ধাপ ১ (cache-first): নেটওয়ার্ক ফেচ শেষ হওয়ার আগেই cache
    // থাকলে সাথে সাথে দেখানো হয়। ধাপ ২ (skeleton): cache না থাকলে
    // নাম/অ্যাভাটারে শিমার — আইটেমগুলো ডিফল্ট hidden-ই থাকে, তাই
    // ভুল কিছু দেখানোর ঝুঁকি নেই। =====
    const cached = readHamburgerCache();
    if (cached) {
      applyState(cached);
    } else {
      setSkeleton(true);
    }

    loadProfileAndRolesSafe(cached);
  }

  // সেশনের ইউজার আইডি cache-এর সাথে না মিললে (শেয়ারড ডিভাইসে
  // অ্যাকাউন্ট বদল) — ভুল ইউজারের তথ্য দেখিয়ে না রেখে cache ক্লিয়ার
  // করে স্কেলিটনে ফিরিয়ে ফ্রেশ ডেটার জন্য অপেক্ষা করা
  async function loadProfileAndRolesSafe(cached) {
    const { data: { session } } = await supabase.auth.getSession();
    if (session && cached && cached.userId !== session.user.id) {
      clearHamburgerCache();
      setSkeleton(true);
    }
    await loadProfileAndRoles();
  }

  function closeMenu() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
    logoutConfirming = false;
    logoutBtn?.classList.remove('confirming');
    if (logoutText) logoutText.textContent = 'লগ আউট';
  }

  window.addEventListener('smartfeni:open-hamburger-menu', openMenu);

  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeMenu();
  });

  logoutBtn?.addEventListener('click', async () => {
    if (!logoutConfirming) {
      logoutConfirming = true;
      logoutBtn.classList.add('confirming');
      if (logoutText) logoutText.textContent = 'নিশ্চিত করুন?';
      return;
    }
    await supabase.auth.signOut();
    clearHamburgerCache();
    window.dispatchEvent(new CustomEvent('smartfeni:logged-out'));
    window.location.href = '/';
  });
</script>
