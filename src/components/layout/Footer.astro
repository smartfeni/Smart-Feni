---
// ============================================================
// কম্পোনেন্ট: ফুটার (রিডিজাইন, নভে ২০২৬ — ছোট ও পরিষ্কার)
// সারি ১: লোগো + ট্যাগলাইন | Google Play বাটন (installBtn — iOS টিপ ও নেটিভ অ্যাপে লুকানো আগের মতো)
// সারি ২: যোগাযোগ (ইমেইল, ফোন) | সোশ্যাল মিডিয়া (শুধু আইকন)
// সারি ৩: কোম্পানি লিংক + কপিরাইট
// সোশ্যাল লিংক বদলাতে/যোগ করতে শুধু নিচের SOCIAL তালিকা বদলান (url খালি হলে আইকন দেখাবে না)।
// ============================================================

const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.smartfeni.app';

const contact = {
  email: 'info@smartfeni.com',
  phone: '+8801816355833',
};

const SOCIAL = [
  { label: 'ফেসবুক', icon: 'fa-facebook-f', bg: '#1877F2', url: 'https://www.facebook.com/smartfeni247' },
  { label: 'ইউটিউব', icon: 'fa-youtube', bg: '#FF0000', url: 'https://www.youtube.com/@smartfeni' },
  { label: 'টিকটক', icon: 'fa-tiktok', bg: '#13202B', url: 'https://www.tiktok.com/@smart_feni' },
].filter((s) => s.url);
---

<footer class="sf-footer">
  <div class="container">
    <div class="sff-top">
      <div class="sff-brand">
        <a href="/" aria-label="স্মার্ট ফেনী হোম"><img src="/logo.png" alt="স্মার্ট ফেনী" class="sff-logo" width="59" height="32" loading="lazy" decoding="async" /></a>
        <p class="sff-tagline">প্রয়োজন আপনার, দায়িত্ব আমাদের</p>
      </div>
      <a
        class="sf-play-btn"
        id="installBtn"
        href={PLAY_STORE_URL}
        target="_blank"
        rel="noopener"
        aria-label="Google Play থেকে স্মার্ট ফেনী অ্যাপ ডাউনলোড করুন"
      >
        <svg class="sf-play-icon" viewBox="0 0 24 24" aria-hidden="true">
          <polygon fill="#00B7FF" points="3,1.8 3,22.2 13,12" />
          <polygon fill="#00D874" points="3,1.8 13,12 16.8,9.4" />
          <polygon fill="#FF3A44" points="3,22.2 13,12 16.8,14.6" />
          <polygon fill="#FFC800" points="16.8,9.4 21.5,12 16.8,14.6 13,12" />
        </svg>
        <span class="sf-play-text">
          <small>এখনই পান</small>
          <strong>Google Play</strong>
        </span>
      </a>
    </div>

    <div class="sff-mid">
      <div class="sff-col">
        <h4>যোগাযোগ</h4>
        <a href={`mailto:${contact.email}`} class="sff-link"><i class="fas fa-envelope" aria-hidden="true"></i><span>{contact.email}</span></a>
        <a href={`tel:${contact.phone}`} class="sff-link"><i class="fas fa-phone" aria-hidden="true"></i><span>{contact.phone}</span></a>
      </div>
      <div class="sff-col">
        <h4>সোশ্যাল মিডিয়া</h4>
        <div class="sff-social">
          {SOCIAL.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label} style={`background:${s.bg}`}>
              <i class={`fab ${s.icon}`} aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="sff-bottom">
      <nav class="sff-legal" aria-label="কোম্পানি">
        <a href="/about">আমাদের সম্পর্কে</a>
        <a href="/privacy-policy">প্রাইভেসি পলিসি</a>
        <a href="/terms-of-service">শর্তাবলী</a>
      </nav>
      <p class="sff-copy">© ২০২৬ স্মার্ট ফেনী, সর্বস্বত্ব সংরক্ষিত</p>
    </div>
  </div>
</footer>

<!-- iOS টিপ (আগের মতো) -->
<div class="ios-tip-overlay" id="iosTipOverlay">
  <div class="ios-tip-box">
    <button class="ios-tip-close" id="iosTipClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
    <i class="fas fa-mobile-screen-button ios-tip-icon"></i>
    <h4>আইফোনে অ্যাপ ইনস্টল করুন</h4>
    <ol>
      <li>নিচে <i class="fas fa-arrow-up-from-bracket"></i> শেয়ার বাটনে ট্যাপ করুন</li>
      <li>"Add to Home Screen" সিলেক্ট করুন</li>
      <li>উপরে ডানে "Add" ট্যাপ করুন</li>
    </ol>
  </div>
</div>

<style is:global>
  footer.sf-footer {
    position: relative;
    background: #E7F0E9;
    color: #13202B;
    padding: 20px 0 14px;
    border-radius: 24px 24px 0 0;
    margin-top: 24px;
  }

  .sff-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .sff-brand { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .sff-logo { display: block; height: 32px; width: auto; }
  .sff-tagline { margin: 0; font-size: 0.82rem; color: #4F5D57; }

  .sf-play-btn {
    flex: none;
    height: 44px;
    padding: 0 12px;
    border-radius: 12px;
    background: #13202B;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .sf-play-btn:hover { background: #22344A; }
  .sf-play-btn:active { background: #0B141C; }
  .sf-play-btn.hidden { display: none; }
  .sf-play-icon { width: 20px; height: 20px; flex: none; }
  .sf-play-text { display: flex; flex-direction: column; line-height: 1.05; }
  .sf-play-text small { font-size: 0.62rem; color: #C9D3CD; }
  .sf-play-text strong { font-size: 0.88rem; font-weight: 700; }

  .sff-mid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #CFDDD3;
  }
  .sff-col { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .sff-col h4 { margin: 0 0 4px; font-size: 0.88rem; font-weight: 700; color: #13202B; }
  .sff-link { min-height: 34px; display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #2C3A44; text-decoration: none; min-width: 0; }
  .sff-link i { color: #0A662A; width: 16px; text-align: center; flex: none; }
  .sff-link span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sff-link:hover span { text-decoration: underline; }

  .sff-social { display: flex; flex-wrap: wrap; gap: 10px; }
  .sff-social a {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.15rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .sff-social a:active { transform: scale(0.92); }

  .sff-bottom {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid #CFDDD3;
  }
  .sff-legal { display: flex; flex-wrap: wrap; gap: 0 16px; }
  .sff-legal a { min-height: 34px; display: inline-flex; align-items: center; font-size: 0.82rem; color: #2C3A44; text-decoration: none; }
  .sff-legal a:hover { text-decoration: underline; }
  .sff-copy { margin: 0; font-size: 0.75rem; color: #4F5D57; }

  footer.sf-footer a:focus-visible { outline: 3px solid #FF6B35; outline-offset: 2px; border-radius: 8px; }

  @media (min-width: 769px) {
    footer.sf-footer { padding: 28px 0 18px; }
    .sff-mid { grid-template-columns: repeat(2, minmax(0, 320px)); gap: 48px; }
    .sff-bottom { flex-direction: row; justify-content: space-between; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sff-social a, .sf-play-btn { transition: none; }
  }

  /* ===== iOS টিপ স্টাইল ===== */
  .ios-tip-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    z-index: 2100;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
  }

  .ios-tip-overlay.open {
    display: flex;
  }

  .ios-tip-box {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 420px;
    border-radius: 24px 24px 0 0;
    padding: 32px 28px 36px;
    text-align: center;
    animation: iosTipUp 0.25s ease;
  }

  @keyframes iosTipUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .ios-tip-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
  }

  .ios-tip-icon {
    font-size: 2rem;
    color: #FF6B35;
    margin-bottom: 12px;
  }

  .ios-tip-box h4 {
    color: #1B2A4A;
    font-size: 1.1rem;
    margin-bottom: 18px;
  }

  .ios-tip-box ol {
    text-align: right;
    padding-right: 26px;
    color: #5A6E85;
    font-size: 0.88rem;
    line-height: 2;
  }

  .ios-tip-box ol i {
    color: #FF6B35;
    margin: 0 4px;
  }
</style>

<script>
  import { isNativeApp } from '../../lib/native-bridge.js';

  const installBtn = document.getElementById('installBtn');
  const iosOverlay = document.getElementById('iosTipOverlay');
  const iosClose = document.getElementById('iosTipClose');

  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches
    || window.navigator.standalone === true;

  // নিজেই native app এর ভেতরে থাকলে "App ইনস্টল করুন" বাটন দেখানোর
  // কোনো মানে নাই — ইউজার ইতিমধ্যেই app ব্যবহার করছেন
  if (isNativeApp()) {
    installBtn?.classList.add('hidden');
  }

  if (isStandalone) {
    installBtn?.classList.add('hidden');
  }

  // Android/ডেস্কটপে লিংক নিজেই Play Store খোলে; iPhone-এ Play Store নেই, তাই টিপ
  installBtn?.addEventListener('click', (e) => {
    if (isIOS) {
      e.preventDefault();
      iosOverlay?.classList.add('open');
    }
  });

  iosClose?.addEventListener('click', () => iosOverlay?.classList.remove('open'));
  iosOverlay?.addEventListener('click', (e) => {
    if (e.target === iosOverlay) iosOverlay.classList.remove('open');
  });

  window.addEventListener('smartfeni:install-done', () => {
    installBtn?.classList.add('hidden');
  });
</script>
