---
// ============================================================
// কম্পোনেন্ট: ফুটার
// ব্র্যান্ড: স্মার্ট ফেনী
// ফিচার: লাইট গ্লাসমরফিজম থিম, লাইন-বাই-লাইন আইকন চিপ সেকশন
// ============================================================

const contact = {
  email: 'info@smartfeni.com',
  phone: '+8801816355833',
  facebook: 'https://www.facebook.com/smartfeni247',
};
---

<footer>
  <div class="container">
    <!-- ব্র্যান্ড হেডার -->
    <div class="footer-brand">
      <a href="/" class="wordmark">SMART FENI</a>
      <p class="footer-tagline"><span class="tag-bar"></span>"প্রয়োজন আপনার, দায়িত্ব আমাদের"</p>
      <p class="footer-desc">Your digital gateway to all essential services in Feni city.</p>
    </div>

    <!-- জনপ্রিয় সেবা -->
    <div class="footer-section">
      <h4>জনপ্রিয় সেবা</h4>
      <div class="chip-row">
        <a href="/services/ride" class="glass-chip"><i class="fas fa-motorcycle"></i> রাইড হিরো</a>
        <a href="/services/courier" class="glass-chip"><i class="fas fa-box"></i> ডেলিভারি হিরো</a>
        <a href="/services/online-shop" class="glass-chip"><i class="fas fa-bag-shopping"></i> অনলাইন শপ</a>
      </div>
    </div>

    <!-- কোম্পানি -->
    <div class="footer-section">
      <h4>কোম্পানি</h4>
      <div class="chip-row">
        <a href="/about" class="glass-chip"><i class="fas fa-circle-info"></i> আমাদের সম্পর্কে</a>
        <a href="/privacy-policy" class="glass-chip"><i class="fas fa-shield-halved"></i> প্রাইভেসি পলিসি</a>
        <a href="/terms-of-service" class="glass-chip"><i class="fas fa-file-contract"></i> শর্তাবলী</a>
      </div>
    </div>

    <!-- যোগাযোগ -->
    <div class="footer-section">
      <h4>যোগাযোগ</h4>
      <div class="chip-row">
        <a href={`mailto:${contact.email}`} class="glass-chip"><i class="fas fa-envelope"></i> {contact.email}</a>
        <a href={`tel:${contact.phone}`} class="glass-chip"><i class="fas fa-phone"></i> {contact.phone}</a>
        <a href={contact.facebook} class="glass-chip"><i class="fab fa-facebook-f"></i> Facebook</a>
      </div>
      <button class="install-btn" id="installBtn" type="button">
        <i class="fas fa-mobile-screen-button"></i> অ্যাপ ইনস্টল করুন
      </button>
    </div>

    <div class="footer-bottom">
      <p>© ২০২৬ স্মার্ট ফেনী · সর্বস্বত্ব সংরক্ষিত &nbsp; <i class="fas fa-heart"></i> &nbsp; MADE FOR FENI</p>
    </div>
  </div>
</footer>

<!-- iOS টিপ (আগের মতো) -->
<div class="ios-tip-overlay" id="iosTipOverlay">
  <div class="ios-tip-box">
    <button class="ios-tip-close" id="iosTipClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
    <i class="fas fa-mobile-screen-button ios-tip-icon"></i>
    <h4>আইফোনে অ্যাপ ইনস্টল করুন</h4>
    <ol>
      <li>নিচে <i class="fas fa-arrow-up-from-bracket"></i> শেয়ার বাটনে ট্যাপ করুন</li>
      <li>"Add to Home Screen" সিলেক্ট করুন</li>
      <li>উপরে ডানে "Add" ট্যাপ করুন</li>
    </ol>
  </div>
</div>

<style is:global>
  footer {
    position: relative;
    background:
      radial-gradient(circle at 90% 5%, rgba(255, 107, 53, 0.16) 0%, transparent 42%),
      radial-gradient(circle at 5% 95%, rgba(27, 42, 74, 0.10) 0%, transparent 42%),
      radial-gradient(rgba(27, 42, 74, 0.12) 1.5px, transparent 1.5px),
      linear-gradient(160deg, #EDEAE3 0%, #F3D9BE 100%);
    background-size: auto, auto, 20px 20px, auto;
    color: #4A5A72;
    padding: 28px 0 16px;
    border-radius: 24px 24px 0 0;
    margin-top: 32px;
    box-shadow: 0 -10px 28px rgba(27, 42, 74, 0.1);
    overflow: hidden;
  }

  footer .container {
    position: relative;
    z-index: 1;
  }

  /* ===== ব্র্যান্ড ===== */
  .footer-brand {
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px dashed rgba(27, 42, 74, 0.2);
  }

  .wordmark {
    display: inline-block;
    font-size: 1.4rem;
    font-weight: 800;
    color: #1B2A4A;
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .footer-tagline {
    display: flex;
    align-items: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 0.82rem;
    color: #8A5230;
    margin: 0 0 4px;
  }

  .tag-bar {
    display: inline-block;
    width: 3px;
    height: 14px;
    background: #FF6B35;
    border-radius: 2px;
    margin-right: 8px;
  }

  .footer-desc {
    font-size: 0.76rem;
    color: #33445E;
    opacity: 0.9;
    margin: 0 0 0 11px;
  }

  /* ===== সেকশন ===== */
  .footer-section {
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px dashed rgba(27, 42, 74, 0.16);
  }

  .footer-section:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .footer-section h4 {
    color: #E85A2A;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0 0 10px;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* ===== গ্লাস চিপ ===== */
  .glass-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 4px 12px rgba(27, 42, 74, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.95);
    color: #1B2A4A;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .glass-chip i {
    color: #FF6B35;
    font-size: 0.8rem;
  }

  .glass-chip:hover {
    background: rgba(255, 255, 255, 0.92);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(27, 42, 74, 0.16), inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .install-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 107, 53, 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 107, 53, 0.5);
    color: #C8481F;
    padding: 8px 16px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.76rem;
    cursor: pointer;
    margin-top: 12px;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .install-btn:hover {
    background: #FF6B35;
    color: #fff;
    transform: translateY(-2px);
  }

  .install-btn.hidden {
    display: none;
  }

  .footer-bottom {
    padding-top: 14px;
    font-size: 0.7rem;
    color: #6C7A8E;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer-bottom i.fa-heart {
    color: #FF6B35;
    font-size: 0.7rem;
  }

  /* ============================================================
     মোবাইল রেসপন্সিভ
     ============================================================ */
  @media (max-width: 768px) {
    footer {
      padding: 22px 0 14px;
    }

    .wordmark {
      font-size: 1.2rem;
    }

    .footer-tagline {
      font-size: 0.75rem;
    }

    .footer-desc {
      font-size: 0.7rem;
    }

    .footer-section h4 {
      font-size: 0.72rem;
    }

    .glass-chip {
      font-size: 0.7rem;
      padding: 6px 12px;
    }

    .install-btn {
      font-size: 0.7rem;
      padding: 7px 14px;
    }

    .footer-bottom {
      font-size: 0.64rem;
    }
  }

  @media (max-width: 480px) {
    footer {
      padding: 18px 0 12px;
      border-radius: 18px 18px 0 0;
      margin-top: 24px;
    }

    .glass-chip {
      font-size: 0.66rem;
      padding: 6px 10px;
    }

    .chip-row {
      gap: 8px;
    }
  }

  /* ===== iOS টিপ স্টাইল ===== */
  .ios-tip-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    z-index: 2100;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
  }

  .ios-tip-overlay.open {
    display: flex;
  }

  .ios-tip-box {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 420px;
    border-radius: 24px 24px 0 0;
    padding: 32px 28px 36px;
    text-align: center;
    animation: iosTipUp 0.25s ease;
  }

  @keyframes iosTipUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .ios-tip-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
  }

  .ios-tip-icon {
    font-size: 2rem;
    color: #FF6B35;
    margin-bottom: 12px;
  }

  .ios-tip-box h4 {
    color: #1B2A4A;
    font-size: 1.1rem;
    margin-bottom: 18px;
  }

  .ios-tip-box ol {
    text-align: right;
    padding-right: 26px;
    color: #5A6E85;
    font-size: 0.88rem;
    line-height: 2;
  }

  .ios-tip-box ol i {
    color: #FF6B35;
    margin: 0 4px;
  }
</style>

<script>
  const installBtn = document.getElementById('installBtn');
  const iosOverlay = document.getElementById('iosTipOverlay');
  const iosClose = document.getElementById('iosTipClose');

  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches
    || window.navigator.standalone === true;

  if (isStandalone) {
    installBtn?.classList.add('hidden');
  }

  installBtn?.addEventListener('click', async () => {
    if (isIOS) {
      iosOverlay?.classList.add('open');
      return;
    }

    const promptEvent = window.deferredInstallPrompt;
    if (!promptEvent) {
      alert('আপনার ব্রাউজারে ইতিমধ্যে ইনস্টল করা আছে অথবা এই মুহূর্তে ইনস্টল অপশন উপলব্ধ নেই।');
      return;
    }

    promptEvent.prompt();
    await promptEvent.userChoice;
    window.deferredInstallPrompt = null;
  });

  iosClose?.addEventListener('click', () => iosOverlay?.classList.remove('open'));
  iosOverlay?.addEventListener('click', (e) => {
    if (e.target === iosOverlay) iosOverlay.classList.remove('open');
  });

  window.addEventListener('smartfeni:install-done', () => {
    installBtn?.classList.add('hidden');
  });
</script>
