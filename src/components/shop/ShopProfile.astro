<script>
  import { supabase } from '../../lib/supabase.js';
  import { initListingDetailModal } from '../../lib/listingDetailModal.js';

  const dataEl = document.getElementById('shopProductsData');
  const products = dataEl ? JSON.parse(dataEl.textContent) : [];

  const metaEl = document.getElementById('shopMetaData');
  const shopMeta = metaEl ? JSON.parse(metaEl.textContent) : {};

  const cards = document.querySelectorAll('.product-card');
  const searchInput = document.getElementById('productSearchInput');
  const noResults = document.getElementById('noResults');
  const cartCountBadge = document.getElementById('cartCountBadge');

  let currentUserId = null;
  const viewedThisSession = new Set();

  searchInput?.addEventListener('input', () => {
    const keyword = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = keyword === '' || (card.dataset.search || '').includes(keyword);
      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  });

  initListingDetailModal({
    listings: products,
    typeNameMap: {},
    typeIcons: {},
    cardSelector: '.product-card',
  });

  // ===== 'view' ইভেন্ট ট্র্যাকিং =====
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('.add-cart-btn') || e.target.closest('.share-product-btn')) return;
      const listingId = card.dataset.listingId;
      if (!listingId || viewedThisSession.has(listingId)) return;
      viewedThisSession.add(listingId);
      logProductEvent('view', listingId, card.dataset.shopId);
    });
  });

  async function logProductEvent(eventType, listingId, shopIdOverride) {
    if (!currentUserId) return;
    const btnEl = document.querySelector(`.add-cart-btn[data-listing-id="${listingId}"]`);
    const shopId = shopIdOverride || btnEl?.dataset.shopId || null;

    await supabase.from('product_events').insert({
      event_type: eventType,
      shop_id: shopId,
      listing_id: listingId,
      user_id: currentUserId,
    });
  }

  // ===== কার্টে যোগ করুন =====
  document.querySelectorAll('.add-cart-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();

      if (!currentUserId) {
        window.openAuthModal?.('login');
        return;
      }

      const listingId = btn.dataset.listingId;
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      const { data: existing } = await supabase
        .from('cart_items')
        .select('id, quantity')
        .eq('user_id', currentUserId)
        .eq('listing_id', listingId)
        .maybeSingle();

      if (existing) {
        await supabase.from('cart_items').update({ quantity: existing.quantity + 1 }).eq('id', existing.id);
      } else {
        await supabase.from('cart_items').insert({ user_id: currentUserId, listing_id: listingId, quantity: 1 });
      }

      await logProductEvent('cart_add', listingId, btn.dataset.shopId);

      btn.classList.add('added');
      btn.innerHTML = '<i class="fas fa-check"></i>';
      btn.disabled = false;

      setTimeout(() => {
        btn.classList.remove('added');
        btn.innerHTML = originalHtml;
      }, 1200);

      refreshCartCount();
    });
  });

  // ===== প্রোডাক্ট শেয়ার =====
  document.querySelectorAll('.share-product-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const listingId = btn.dataset.listingId;
      const title = btn.dataset.title || 'প্রোডাক্ট';
      const url = `https://smartfeni.com/${shopMeta.slug}?product=${listingId}`;

      if (navigator.share) {
        try {
          await navigator.share({ title, text: `${title} — স্মার্ট ফেনী তে দেখুন`, url });
        } catch (err) {}
      } else {
        await navigator.clipboard.writeText(url);
        alert('লিংক কপি হয়েছে ✓');
      }
    });
  });

  // ===== শপ শেয়ার =====
  document.getElementById('shareShopBtn')?.addEventListener('click', async () => {
    const url = `https://smartfeni.com/${shopMeta.slug}`;

    if (navigator.share) {
      try {
        await navigator.share({ title: shopMeta.name, text: `${shopMeta.name} — স্মার্ট ফেনী তে দেখুন`, url });
      } catch (err) {}
    } else {
      await navigator.clipboard.writeText(url);
      alert('লিংক কপি হয়েছে ✓');
    }
  });

  async function refreshCartCount() {
    if (!currentUserId || !cartCountBadge) return;
    const { data } = await supabase.from('cart_items').select('quantity').eq('user_id', currentUserId);
    const total = (data || []).reduce((sum, row) => sum + row.quantity, 0);

    if (total > 0) {
      cartCountBadge.textContent = total;
      cartCountBadge.style.display = 'flex';
    } else {
      cartCountBadge.style.display = 'none';
    }
  }

  // ===== ?product=id দিয়ে ডিপ-লিংক — সরাসরি সেই প্রোডাক্টের মোডাল খুলে দেয় =====
  function openProductFromQuery() {
    const params = new URLSearchParams(window.location.search);
    const productId = params.get('product');
    if (!productId) return;

    const targetCard = document.querySelector(`.product-card[data-listing-id="${productId}"]`);
    if (targetCard) {
      setTimeout(() => targetCard.click(), 200);
    }
  }

  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;
    refreshCartCount();
    openProductFromQuery();
  })();
</script>