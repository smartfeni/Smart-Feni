---
// ============================================================
// কম্পোনেন্ট: ShopProfile — পাবলিক শপ প্রোফাইল পেজ
// আপডেট (v4): প্রোডাক্ট গ্রিড কার্ড থেকে শেয়ার বাটন সরানো হয়েছে —
// শেয়ার শুধু প্রোডাক্ট প্রিভিউ পেজে (/product/{id}) থাকবে। শপ-লেভেল
// শেয়ার বাটন (টপবারে) অপরিবর্তিত আছে।
// props: shop (shops টেবিলের row), products (listings অ্যারে)
// ============================================================

const { shop, products } = Astro.props;

const sortedProducts = [...products].sort((a, b) => (b.is_best_seller ? 1 : 0) - (a.is_best_seller ? 1 : 0));
---

<div class="shop-page">
  <div class="shop-topbar">
    <div class="container topbar-inner">
      {shop.logo_image ? (
        <img src={shop.logo_image} alt={shop.name} class="topbar-logo" />
      ) : (
        <div class="topbar-logo-placeholder"><i class="fas fa-store"></i></div>
      )}

      <div class="topbar-info">
        <h1 class="topbar-name">
          {shop.name}
          {shop.is_verified && <i class="fas fa-circle-check verified-icon" title="ভেরিফায়েড শপ"></i>}
        </h1>
        <div class="topbar-meta">
          {shop.location_name && (
            <span class="meta-chip"><i class="fas fa-location-dot"></i> {shop.location_name}</span>
          )}
          <span class="meta-chip"><i class="fas fa-box"></i> {products.length} প্রোডাক্ট</span>
        </div>
      </div>

      <button class="shop-share-btn" id="shareShopBtn" aria-label="শপ শেয়ার করুন">
        <i class="fas fa-share-nodes"></i>
      </button>
    </div>
  </div>

  {shop.cover_image && (
    <div class="shop-banner-wrap">
      <img src={shop.cover_image} alt={`${shop.name} ব্যানার`} class="shop-banner-img" />
    </div>
  )}

  <div class="container">
    {shop.phone && (
      <div class="quick-contact-row">
        <a href={`tel:${shop.phone}`} class="contact-pill call-pill">
          <i class="fas fa-phone"></i> কল করুন
        </a>
        <a href={`https://wa.me/${shop.phone.replace(/\D/g, '')}`} target="_blank" rel="noopener" class="contact-pill wa-pill">
          <i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ
        </a>
      </div>
    )}

    {shop.description && (
      <div class="shop-description-card">
        <p>{shop.description}</p>
      </div>
    )}

    <div class="products-block">
      <div class="products-block-header">
        <p class="section-label"><i class="fas fa-shop"></i> প্রোডাক্টসমূহ</p>
        {products.length > 0 && (
          <div class="search-box">
            <i class="fas fa-magnifying-glass"></i>
            <input type="text" id="productSearchInput" placeholder="প্রোডাক্ট খুঁজুন..." />
          </div>
        )}
      </div>

      {products.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-box-open"></i>
          <p>এখনো কোনো প্রোডাক্ট যোগ হয়নি</p>
        </div>
      ) : (
        <>
          <div class="product-grid" id="productGrid">
            {sortedProducts.map((item) => (
              <a
                href={`/product/${item.id}`}
                class={`product-card ${item.is_best_seller ? 'best-seller-card' : ''}`}
                data-listing-id={item.id}
                data-shop-id={shop.id}
                data-search={`${item.title || ''} ${item.description || ''}`.toLowerCase()}
              >
                <div class="product-photo-wrap">
                  {item.images && item.images.length > 0 ? (
                    <img src={item.images[0]} alt={item.title} class="product-photo" />
                  ) : (
                    <div class="product-icon">
                      <i class="fas fa-box"></i>
                    </div>
                  )}
                  {item.is_best_seller && (
                    <span class="best-seller-overlay"><i class="fas fa-star"></i> বেস্ট সেলার</span>
                  )}
                </div>

                <div class="product-card-body">
                  <h3 class="product-title">{item.title}</h3>
                  {item.price && <p class="product-price">৳{item.price}</p>}
                  <button type="button" class="add-cart-btn" data-listing-id={item.id} data-shop-id={shop.id}>
                    <i class="fas fa-cart-plus"></i> কার্টে যোগ করুন
                  </button>
                </div>
              </a>
            ))}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </div>

  <a href="/cart" class="floating-cart-btn" id="floatingCartBtn">
    <i class="fas fa-cart-shopping"></i>
    <span class="cart-count" id="cartCountBadge" style="display:none;">0</span>
  </a>

  <script type="application/json" id="shopMetaData" set:html={JSON.stringify({ slug: shop.slug, name: shop.name })} />
</div>

<style is:global>
  .shop-page {
    padding-bottom: 60px;
    background: #F8FAFC;
  }

  .shop-topbar {
    background: #fff;
    border-bottom: 1px solid #EEF3F9;
    padding: 14px 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .topbar-logo {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .topbar-logo-placeholder {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .topbar-info {
    flex: 1;
    min-width: 0;
  }

  .topbar-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.08rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .verified-icon {
    color: #2563EB;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .topbar-meta {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .meta-chip {
    background: #F8FAFC;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #5A6E85;
    white-space: nowrap;
  }

  .meta-chip i {
    color: #FF6B35;
    margin-right: 3px;
  }

  .shop-share-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #F4F7FC;
    color: #1B2A4A;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .shop-banner-wrap {
    max-width: 900px;
    margin: 16px auto 0;
    padding: 0 16px;
  }

  .shop-banner-img {
    width: 100%;
    aspect-ratio: 21/8;
    object-fit: cover;
    border-radius: 18px;
    display: block;
  }

  .quick-contact-row {
    display: flex;
    gap: 10px;
    max-width: 400px;
    margin: 18px auto 18px;
  }

  .contact-pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 11px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .call-pill {
    background: #EAF2FF;
    color: #2563EB;
  }

  .call-pill:hover {
    background: #2563EB;
    color: #fff;
  }

  .wa-pill {
    background: #E9F9EF;
    color: #1EA952;
  }

  .wa-pill:hover {
    background: #1EA952;
    color: #fff;
  }

  .shop-description-card {
    max-width: 620px;
    margin: 0 auto 20px;
    background: #fff;
    border-radius: 16px;
    padding: 14px 18px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .shop-description-card p {
    font-size: 0.86rem;
    color: #3A4A60;
    line-height: 1.7;
  }

  .products-block {
    max-width: 900px;
    margin: 0 auto;
  }

  .products-block-header {
    margin-bottom: 16px;
  }

  .section-label {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .section-label i {
    color: #FF6B35;
  }

  .search-box {
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    border-radius: 40px;
    padding: 10px 18px;
    margin-top: 8px;
  }

  .search-box i {
    color: #A0AFC0;
  }

  .search-box input {
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.88rem;
    font-family: inherit;
    background: transparent;
    color: #1B2A4A;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  .product-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    text-align: left;
    text-decoration: none;
    display: block;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .product-card.best-seller-card {
    border: 1.5px solid #FFE9B8;
  }

  .product-card.hidden {
    display: none;
  }

  .product-photo-wrap {
    position: relative;
  }

  .best-seller-overlay {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    background: #FFD700;
    color: #7A5C00;
    font-size: 0.66rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 3px 8px rgba(255, 184, 0, 0.35);
  }

  .product-icon {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }

  .product-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    object-position: center;
    display: block;
    background: #F4F7FC;
  }

  .product-card-body {
    padding: 14px;
  }

  .product-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FF6B35;
  }

  .add-cart-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #FFF0EA;
    color: #FF6B35;
    border: none;
    padding: 9px;
    border-radius: 10px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 10px;
  }

  .add-cart-btn:hover {
    background: #FF6B35;
    color: #fff;
  }

  .add-cart-btn.added {
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .floating-cart-btn {
    position: fixed;
    bottom: calc(78px + env(safe-area-inset-bottom));
    right: 20px;
    background: #1B2A4A;
    color: #fff;
    border: none;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
    cursor: pointer;
    z-index: 500;
    text-decoration: none;
  }

  .floating-cart-btn .cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #FF6B35;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  .no-results {
    text-align: center;
    color: #A0AFC0;
    font-size: 0.95rem;
    padding: 40px 0;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const metaEl = document.getElementById('shopMetaData');
  const shopMeta = metaEl ? JSON.parse(metaEl.textContent) : {};

  const cards = document.querySelectorAll('.product-card');
  const searchInput = document.getElementById('productSearchInput');
  const noResults = document.getElementById('noResults');
  const cartCountBadge = document.getElementById('cartCountBadge');

  let currentUserId = null;

  searchInput?.addEventListener('input', () => {
    const keyword = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = keyword === '' || (card.dataset.search || '').includes(keyword);
      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  });

  document.querySelectorAll('.add-cart-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      if (!currentUserId) {
        window.openAuthModal?.('login');
        return;
      }

      const listingId = btn.dataset.listingId;
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      const { data: existing } = await supabase
        .from('cart_items')
        .select('id, quantity')
        .eq('user_id', currentUserId)
        .eq('listing_id', listingId)
        .maybeSingle();

      if (existing) {
        await supabase.from('cart_items').update({ quantity: existing.quantity + 1 }).eq('id', existing.id);
      } else {
        await supabase.from('cart_items').insert({ user_id: currentUserId, listing_id: listingId, quantity: 1 });
      }

      await supabase.from('product_events').insert({
        event_type: 'cart_add',
        shop_id: btn.dataset.shopId,
        listing_id: listingId,
        user_id: currentUserId,
      });

      btn.classList.add('added');
      btn.innerHTML = '<i class="fas fa-check"></i>';
      btn.disabled = false;

      setTimeout(() => {
        btn.classList.remove('added');
        btn.innerHTML = originalHtml;
      }, 1200);

      refreshCartCount();
    });
  });

  document.getElementById('shareShopBtn')?.addEventListener('click', async () => {
    const url = `https://smartfeni.com/${shopMeta.slug}`;

    if (navigator.share) {
      try {
        await navigator.share({ title: shopMeta.name, text: `${shopMeta.name} — স্মার্ট ফেনী তে দেখুন`, url });
      } catch (err) {}
    } else {
      await navigator.clipboard.writeText(url);
      alert('লিংক কপি হয়েছে ✓');
    }
  });

  async function refreshCartCount() {
    if (!currentUserId || !cartCountBadge) return;
    const { data } = await supabase.from('cart_items').select('quantity').eq('user_id', currentUserId);
    const total = (data || []).reduce((sum, row) => sum + row.quantity, 0);

    if (total > 0) {
      cartCountBadge.textContent = total;
      cartCountBadge.style.display = 'flex';
    } else {
      cartCountBadge.style.display = 'none';
    }
  }

  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;
    refreshCartCount();
  })();
</script>