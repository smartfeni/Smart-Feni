---
// ============================================================
// কম্পোনেন্ট: ShopProfile — পাবলিক শপ প্রোফাইল পেজ
// ClubProfile.astro এর হিরো স্টাইল (কভার + সেন্টার লোগো) অনুসরণ
// করে, সাথে প্রোডাক্ট গ্রিড (আগের shop/[id].astro থেকে) যোগ করা।
// props: shop (shops টেবিলের row), products (listings অ্যারে)
// আপডেট (Phase F): কার্টে যোগ করুন বাটন + view/cart_add ইভেন্ট
// ট্র্যাকিং + ফ্লোটিং কার্ট বাটন
// ============================================================

import ListingDetailModal from '../ui/ListingDetailModal.astro';

const { shop, products } = Astro.props;

const UPAZILA_LABELS = {
  'feni-sadar': 'ফেনী সদর',
  'chhagalnaiya': 'ছাগলনাইয়া',
  'daganbhuiyan': 'দাগনভূঞা',
  'parshuram': 'পরশুরাম',
  'fulgazi': 'ফুলগাজী',
  'sonagazi': 'সোনাগাজী',
};

const upazilaLabel = shop.upazila ? UPAZILA_LABELS[shop.upazila] || shop.upazila : '';
---

<div class="shop-page">
  <!-- ===== কভার ===== -->
  <div class="shop-cover-wrap">
    {shop.cover_image ? (
      <img src={shop.cover_image} alt={shop.name} class="shop-cover-img" />
    ) : (
      <div class="shop-cover-placeholder"></div>
    )}
  </div>

  <!-- ===== লোগো (কভারের উপর সেন্টার-ওভারল্যাপ) ===== -->
  <div class="shop-logo-center">
    {shop.logo_image ? (
      <img src={shop.logo_image} alt={shop.name} class="shop-logo" />
    ) : (
      <div class="shop-logo-placeholder"><i class="fas fa-store"></i></div>
    )}
  </div>

  <div class="container">
    <!-- ===== নাম, ট্যাগলাইন, মেটা ===== -->
    <div class="shop-identity">
      <h1 class="shop-name-text">
        {shop.name}
        {shop.is_verified && <i class="fas fa-circle-check verified-icon" title="ভেরিফায়েড শপ"></i>}
      </h1>
      {shop.tagline && <p class="shop-tagline">{shop.tagline}</p>}
      <div class="shop-meta-row">
        {upazilaLabel && (
          <span class="meta-chip"><i class="fas fa-location-dot"></i> {upazilaLabel}</span>
        )}
        <span class="meta-chip"><i class="fas fa-box"></i> {products.length} টি প্রোডাক্ট</span>
      </div>
    </div>

    {shop.description && (
      <div class="shop-description-card">
        <span class="desc-icon"><i class="fas fa-store"></i></span>
        <p>{shop.description}</p>
      </div>
    )}

    <!-- ===== যোগাযোগ ===== -->
    {(shop.phone || shop.facebook_link || shop.address) && (
      <div class="contact-card">
        <h3><i class="fas fa-address-card"></i> যোগাযোগ</h3>
        <div class="contact-grid">
          {shop.phone && (
            <a href={`tel:${shop.phone}`} class="contact-item">
              <span class="contact-icon"><i class="fas fa-phone"></i></span> {shop.phone}
            </a>
          )}
          {shop.facebook_link && (
            <a href={shop.facebook_link} target="_blank" rel="noopener" class="contact-item">
              <span class="contact-icon fb"><i class="fab fa-facebook-f"></i></span> ফেসবুক পেজ
            </a>
          )}
          {shop.address && (
            <p class="contact-item">
              <span class="contact-icon"><i class="fas fa-map-pin"></i></span> {shop.address}
            </p>
          )}
        </div>
      </div>
    )}

    <!-- ===== প্রোডাক্ট সেকশন ===== -->
    <div class="products-block">
      <h2 class="products-heading"><i class="fas fa-box"></i> প্রোডাক্টসমূহ</h2>

      {products.length > 0 && (
        <div class="search-box">
          <i class="fas fa-magnifying-glass"></i>
          <input type="text" id="productSearchInput" placeholder="প্রোডাক্ট খুঁজুন..." />
        </div>
      )}

      {products.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-box-open"></i>
          <p>এখনো কোনো প্রোডাক্ট যোগ হয়নি</p>
        </div>
      ) : (
        <>
          <div class="product-grid" id="productGrid">
            {products.map((item, i) => (
              <div
                class="product-card"
                data-detail-index={i}
                data-search={`${item.title || ''} ${item.description || ''}`.toLowerCase()}
                tabindex="0"
                role="button"
              >
                {item.images && item.images.length > 0 ? (
                  <img src={item.images[0]} alt={item.title} class="product-photo" />
                ) : (
                  <div class="product-icon">
                    <i class="fas fa-box"></i>
                  </div>
                )}

                <div class="product-card-body">
                  <h3 class="product-title">{item.title}</h3>
                  {item.price && <p class="product-price">৳{item.price}</p>}
                  <button
                    type="button"
                    class="add-cart-btn"
                    data-listing-id={item.id}
                    data-shop-id={shop.id}
                  >
                    <i class="fas fa-cart-plus"></i> কার্টে যোগ করুন
                  </button>
                </div>
              </div>
            ))}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </div>

  <a href="/cart" class="floating-cart-btn" id="floatingCartBtn">
    <i class="fas fa-cart-shopping"></i>
    <span class="cart-count" id="cartCountBadge" style="display:none;">0</span>
  </a>

  <ListingDetailModal />

  <script type="application/json" id="shopProductsData" set:html={JSON.stringify(products)} />
</div>

<style>
  .shop-page {
    padding-bottom: 60px;
    background: #F8FAFC;
  }

  .shop-cover-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 0 0 36px 36px;
    overflow: hidden;
    position: relative;
    background: #1B2A4A;
  }

  .shop-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .shop-cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #FFF0EA, #F4F7FC);
  }

  .shop-logo-center {
    display: flex;
    justify-content: center;
    margin-top: -48px;
    margin-bottom: 14px;
    position: relative;
    z-index: 2;
  }

  .shop-logo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    border: 5px solid #fff;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.16);
  }

  .shop-logo-placeholder {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    border: 5px solid #fff;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.9rem;
  }

  .shop-identity {
    text-align: center;
    margin-bottom: 18px;
  }

  .shop-name-text {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 1.3rem;
    font-weight: 700;
    color: #1B2A4A;
    padding: 0 8px;
  }

  .verified-icon {
    color: #2563EB;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .shop-tagline {
    font-size: 0.88rem;
    color: #5A6E85;
    margin-top: 4px;
  }

  .shop-meta-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 12px;
  }

  .meta-chip {
    background: #fff;
    border: 1px solid #E5EAF0;
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #5A6E85;
    white-space: nowrap;
  }

  .meta-chip i {
    color: #FF6B35;
    margin-right: 4px;
  }

  .shop-description-card {
    background: #EAF2FF;
    border-radius: 18px;
    padding: 16px 18px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .desc-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #2563EB;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .shop-description-card p {
    font-size: 0.9rem;
    color: #1B3A6B;
    line-height: 1.7;
    padding-top: 6px;
  }

  .contact-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 20px;
  }

  .contact-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-card h3 i {
    color: #FF6B35;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    color: #3A4A60;
    text-decoration: none;
    font-weight: 600;
  }

  .contact-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #2563EB;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .contact-icon.fb {
    background: #1877F2;
  }

  .products-block {
    margin-top: 24px;
  }

  .products-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .products-heading i {
    color: #FF6B35;
  }

  .search-box {
    max-width: 480px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    border-radius: 40px;
    padding: 12px 20px;
  }

  .search-box i {
    color: #A0AFC0;
  }

  .search-box input {
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.9rem;
    font-family: inherit;
    background: transparent;
    color: #1B2A4A;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  .product-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    padding: 0;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .product-card.hidden {
    display: none;
  }

  .product-icon {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }

  .product-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    object-position: center;
    display: block;
    background: #F4F7FC;
  }

  .product-card-body {
    padding: 14px;
  }

  .product-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FF6B35;
  }

  .add-cart-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #FFF0EA;
    color: #FF6B35;
    border: none;
    padding: 9px;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 10px;
  }

  .add-cart-btn:hover {
    background: #FF6B35;
    color: #fff;
  }

  .add-cart-btn.added {
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .floating-cart-btn {
    position: fixed;
    bottom: 24px;
    right: 20px;
    background: #1B2A4A;
    color: #fff;
    border: none;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
    cursor: pointer;
    z-index: 500;
    text-decoration: none;
  }

  .floating-cart-btn .cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #FF6B35;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  .no-results {
    text-align: center;
    color: #A0AFC0;
    font-size: 0.95rem;
    padding: 40px 0;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { initListingDetailModal } from '../../lib/listingDetailModal.js';

  const dataEl = document.getElementById('shopProductsData');
  const products = dataEl ? JSON.parse(dataEl.textContent) : [];

  const cards = document.querySelectorAll('.product-card');
  const searchInput = document.getElementById('productSearchInput');
  const noResults = document.getElementById('noResults');
  const cartCountBadge = document.getElementById('cartCountBadge');

  let currentUserId = null;
  const viewedThisSession = new Set();

  searchInput?.addEventListener('input', () => {
    const keyword = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = keyword === '' || (card.dataset.search || '').includes(keyword);
      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  });

  initListingDetailModal({
    listings: products,
    typeNameMap: {},
    typeIcons: {},
    cardSelector: '.product-card',
  });

  // ===== 'view' ইভেন্ট ট্র্যাকিং — কার্ড ক্লিক করলে (প্রতি প্রোডাক্ট প্রতি সেশনে একবার) =====
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('.add-cart-btn')) return; // কার্ট বাটনে ক্লিক হলে ভিউ লগ না
      const idx = card.dataset.detailIndex;
      const listing = products[idx];
      if (!listing || viewedThisSession.has(listing.id)) return;
      viewedThisSession.add(listing.id);
      logProductEvent('view', listing.id);
    });
  });

  async function logProductEvent(eventType, listingId) {
    if (!currentUserId) return; // লগইন করা না থাকলে ইভেন্ট লগ হয় না
    const shopIdEl = document.querySelector(`[data-listing-id="${listingId}"]`);
    const shopId = shopIdEl?.dataset.shopId || null;

    await supabase.from('product_events').insert({
      event_type: eventType,
      shop_id: shopId,
      listing_id: listingId,
      user_id: currentUserId,
    });
  }

  // ===== কার্টে যোগ করুন =====
  document.querySelectorAll('.add-cart-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();

      if (!currentUserId) {
        window.openAuthModal?.('login');
        return;
      }

      const listingId = btn.dataset.listingId;
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> যোগ হচ্ছে...';

      // আগে থেকে কার্টে থাকলে quantity +1, না থাকলে নতুন row
      const { data: existing } = await supabase
        .from('cart_items')
        .select('id, quantity')
        .eq('user_id', currentUserId)
        .eq('listing_id', listingId)
        .maybeSingle();

      if (existing) {
        await supabase.from('cart_items').update({ quantity: existing.quantity + 1 }).eq('id', existing.id);
      } else {
        await supabase.from('cart_items').insert({ user_id: currentUserId, listing_id: listingId, quantity: 1 });
      }

      await logProductEvent('cart_add', listingId);

      btn.classList.add('added');
      btn.innerHTML = '<i class="fas fa-check"></i> কার্টে যোগ হয়েছে';
      btn.disabled = false;

      setTimeout(() => {
        btn.classList.remove('added');
        btn.innerHTML = originalHtml;
      }, 1500);

      refreshCartCount();
    });
  });

  async function refreshCartCount() {
    if (!currentUserId || !cartCountBadge) return;

    const { data } = await supabase.from('cart_items').select('quantity').eq('user_id', currentUserId);
    const total = (data || []).reduce((sum, row) => sum + row.quantity, 0);

    if (total > 0) {
      cartCountBadge.textContent = total;
      cartCountBadge.style.display = 'flex';
    } else {
      cartCountBadge.style.display = 'none';
    }
  }

  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;
    refreshCartCount();
  })();
</script>