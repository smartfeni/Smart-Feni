---
// ============================================================
// কম্পোনেন্ট: ShopProfile — পাবলিক শপ প্রোফাইল পেজ
// সম্পূর্ণ রিডিজাইন (Club থেকে আলাদা, ইউনিক শপ-স্পেসিফিক লেআউট):
//   - কমপ্যাক্ট টপবার (ছোট লোগো + নাম + শেয়ার বাটন, ইনলাইন)
//   - কভার এখন সেকেন্ডারি ব্যানার (বড় হিরো না, ছোট প্রোমো স্ট্রিপ)
//   - কল+হোয়াটসঅ্যাপ বাটন আগেভাগে (কন্টাক্ট কার্ড দূরে না)
//   - বেস্ট সেলার প্রোডাক্ট বড় কার্ডে সবার উপরে ফিচার্ড
//   - বাজার/এলাকার নাম চিপ (উপজেলা পাবলিকলি দেখানো হয় না)
//   - প্রতি প্রোডাক্টে শেয়ার বাটন + ?product=id দিয়ে ডিপ-লিংক সাপোর্ট
// props: shop (shops টেবিলের row), products (listings অ্যারে)
// ============================================================

import ListingDetailModal from '../ui/ListingDetailModal.astro';

const { shop, products } = Astro.props;

const bestSeller = products.find((p) => p.is_best_seller);
const restProducts = products.filter((p) => !p.is_best_seller);
---

<div class="shop-page">
  <!-- ===== কমপ্যাক্ট টপবার ===== -->
  <div class="shop-topbar">
    <div class="container topbar-inner">
      {shop.logo_image ? (
        <img src={shop.logo_image} alt={shop.name} class="topbar-logo" />
      ) : (
        <div class="topbar-logo-placeholder"><i class="fas fa-store"></i></div>
      )}

      <div class="topbar-info">
        <h1 class="topbar-name">
          {shop.name}
          {shop.is_verified && <i class="fas fa-circle-check verified-icon" title="ভেরিফায়েড শপ"></i>}
        </h1>
        <div class="topbar-meta">
          {shop.location_name && (
            <span class="meta-chip"><i class="fas fa-location-dot"></i> {shop.location_name}</span>
          )}
          <span class="meta-chip"><i class="fas fa-box"></i> {products.length} প্রোডাক্ট</span>
        </div>
      </div>

      <button class="shop-share-btn" id="shareShopBtn" aria-label="শপ শেয়ার করুন">
        <i class="fas fa-share-nodes"></i>
      </button>
    </div>
  </div>

  <!-- ===== কভার ব্যানার (সেকেন্ডারি, প্রোমো স্ট্রিপ) ===== -->
  {shop.cover_image && (
    <div class="shop-banner-wrap">
      <img src={shop.cover_image} alt={`${shop.name} ব্যানার`} class="shop-banner-img" />
    </div>
  )}

  <div class="container">
    {shop.tagline && <p class="shop-tagline">{shop.tagline}</p>}

    <!-- ===== দ্রুত যোগাযোগ ===== -->
    {shop.phone && (
      <div class="quick-contact-row">
        <a href={`tel:${shop.phone}`} class="contact-pill call-pill">
          <i class="fas fa-phone"></i> কল করুন
        </a>
        <a href={`https://wa.me/${shop.phone.replace(/\D/g, '')}`} target="_blank" rel="noopener" class="contact-pill wa-pill">
          <i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ
        </a>
      </div>
    )}

    {shop.description && (
      <div class="shop-description-card">
        <p>{shop.description}</p>
      </div>
    )}

    {shop.address && (
      <p class="address-line"><i class="fas fa-map-pin"></i> {shop.address}</p>
    )}

    <!-- ===== বেস্ট সেলার — ফিচার্ড, বড় কার্ড ===== -->
    {bestSeller && (
      <div class="best-seller-section">
        <p class="section-label"><i class="fas fa-star"></i> বেস্ট সেলার</p>
        <div
          class="feature-card product-card"
          data-detail-index={products.indexOf(bestSeller)}
          data-listing-id={bestSeller.id}
          data-search={`${bestSeller.title || ''} ${bestSeller.description || ''}`.toLowerCase()}
          tabindex="0"
          role="button"
        >
          {bestSeller.images && bestSeller.images.length > 0 ? (
            <img src={bestSeller.images[0]} alt={bestSeller.title} class="feature-photo" />
          ) : (
            <div class="feature-icon"><i class="fas fa-box"></i></div>
          )}
          <div class="feature-body">
            <h3 class="feature-title">{bestSeller.title}</h3>
            {bestSeller.price && <p class="feature-price">৳{bestSeller.price}</p>}
            <div class="feature-actions">
              <button type="button" class="add-cart-btn" data-listing-id={bestSeller.id} data-shop-id={shop.id}>
                <i class="fas fa-cart-plus"></i> কার্টে যোগ করুন
              </button>
              <button type="button" class="share-product-btn" data-listing-id={bestSeller.id} data-title={bestSeller.title} aria-label="শেয়ার করুন">
                <i class="fas fa-share-nodes"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- ===== বাকি প্রোডাক্টসমূহ ===== -->
    <div class="products-block">
      <div class="products-block-header">
        <p class="section-label"><i class="fas fa-shop"></i> সব প্রোডাক্ট</p>
        {products.length > 0 && (
          <div class="search-box">
            <i class="fas fa-magnifying-glass"></i>
            <input type="text" id="productSearchInput" placeholder="প্রোডাক্ট খুঁজুন..." />
          </div>
        )}
      </div>

      {products.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-box-open"></i>
          <p>এখনো কোনো প্রোডাক্ট যোগ হয়নি</p>
        </div>
      ) : restProducts.length === 0 ? (
        <p class="no-results" style="display:block;">বাকি কোনো প্রোডাক্ট নেই</p>
      ) : (
        <>
          <div class="product-grid" id="productGrid">
            {restProducts.map((item) => (
              <div
                class="product-card"
                data-detail-index={products.indexOf(item)}
                data-listing-id={item.id}
                data-search={`${item.title || ''} ${item.description || ''}`.toLowerCase()}
                tabindex="0"
                role="button"
              >
                {item.images && item.images.length > 0 ? (
                  <img src={item.images[0]} alt={item.title} class="product-photo" />
                ) : (
                  <div class="product-icon">
                    <i class="fas fa-box"></i>
                  </div>
                )}

                <div class="product-card-body">
                  <h3 class="product-title">{item.title}</h3>
                  {item.price && <p class="product-price">৳{item.price}</p>}
                  <div class="card-actions-row">
                    <button type="button" class="add-cart-btn" data-listing-id={item.id} data-shop-id={shop.id}>
                      <i class="fas fa-cart-plus"></i> কার্টে যোগ করুন
                    </button>
                    <button type="button" class="share-product-btn" data-listing-id={item.id} data-title={item.title} aria-label="শেয়ার করুন">
                      <i class="fas fa-share-nodes"></i>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </div>

  <a href="/cart" class="floating-cart-btn" id="floatingCartBtn">
    <i class="fas fa-cart-shopping"></i>
    <span class="cart-count" id="cartCountBadge" style="display:none;">0</span>
  </a>

  <ListingDetailModal />

  <script type="application/json" id="shopProductsData" set:html={JSON.stringify(products)} />
  <script type="application/json" id="shopMetaData" set:html={JSON.stringify({ slug: shop.slug, name: shop.name })} />
</div>

