---
// ============================================================
// কম্পোনেন্ট: ক্যাটাগরি গ্রিড
// আপডেট: category_images টেবিল থেকে সব ক্যাটাগরির ছবি একবারে (bulk)
//         fetch করে প্রতিটা কার্ডে imageUrl পাস করা হচ্ছে
//         hidden: true থাকা ক্যাটাগরি grid থেকে বাদ দেওয়া হচ্ছে
// আপডেট (ম্যানুয়াল সিরিয়াল): category_settings টেবিলের sort_order
//         অনুযায়ী popular ও general — দুইটা গ্রুপই আলাদাভাবে সাজানো
//         হচ্ছে (অ্যাডমিন প্যানেল /admin/categories থেকে নিয়ন্ত্রিত)।
//         কোনো ক্যাটাগরির sort_order না থাকলে services.js এর মূল
//         ক্রম অনুযায়ী fallback হবে।
// আপডেট (part prop): হোমপেজে Featured Photos-কে Popular ও General
//         এর মাঝখানে বসানোর জন্য এখন কম্পোনেন্টটা `part` prop নিয়ে
//         শুধু "popular" বা শুধু "general" ব্লক আলাদাভাবে রেন্ডার
//         করতে পারে। prop না দিলে (ডিফল্ট) আগের মতোই দুইটাই একসাথে
//         রেন্ডার হবে (backward compatible)।
// ============================================================

import { categories } from '../../data/services.js';
import CategoryCard from '../shared/CategoryCard.astro';
import CategoryCardPopular from '../shared/CategoryCardPopular.astro';
import { supabase } from '../../lib/supabase.js';

interface Props {
  part?: 'popular' | 'general';
}

const { part } = Astro.props;
const showPopular = part !== 'general';
const showGeneral = part !== 'popular';

// কুইক ডেলিভারি (marketplace) জনপ্রিয়তে ১ নম্বরে; অনলাইন শপ সাধারণে।
// সুইচ (site_settings.marketplace_enabled) বন্ধ থাকলে নিচের স্ক্রিপ্ট কুইক ডেলিভারি লুকিয়ে
// অনলাইন শপকে আগের মতো জনপ্রিয়তে দেখায় (স্টাফ সুইচ বন্ধেও কুইক ডেলিভারি দেখে)।
const popularSlugs = ['local-ride', 'doctor-directory'];
const quickDeliveryCat = { id: 'quick-delivery', name: 'কুইক ডেলিভারি', icon: 'fa-bolt', desc: 'খাবার, বাজার, যেকোনো কিছু', slug: 'quick-delivery' };
// সুইচ বন্ধ করলে কুইক ডেলিভারির জায়গায় পুরনো ডেলিভারি হিরো (লুকানো ক্যাটাগরি) দেখাবে
const courierCat = categories.find((c) => c.slug === 'courier');

// দুইটা কোয়েরি একসাথে শুরু (সমান্তরাল), নিচে await হবে
const sortPromise = supabase.from('category_settings').select('category_id, sort_order');
const imagesPromise = supabase.from('category_images').select('category_slug, storage_path, updated_at');

const sortMap: Record<string, number> = {};
try {
  const { data: sortData, error: sortError } = await sortPromise;
  if (!sortError && sortData) {
    sortData.forEach((row) => {
      sortMap[row.category_id] = row.sort_order;
    });
  }
} catch (e) {
  // sort_order fetch ব্যর্থ হলে নিচের fallback (মূল অ্যারে-ইনডেক্স) ব্যবহার হবে
}

const categoriesWithOrder = categories.map((cat, idx) => ({
  ...cat,
  __sortOrder: sortMap[cat.id] ?? idx * 10,
}));

const popularCategories = categoriesWithOrder
  .filter(cat => popularSlugs.includes(cat.slug) && !cat.hidden)
  .sort((a, b) => a.__sortOrder - b.__sortOrder);

// "অনলাইন শপ" services.js-এ hidden (পোস্ট/ড্রয়ারে নেই), কিন্তু হোমে দেখায়: কুইক ডেলিভারির প্রি-অর্ডার দোকানে যায়
// (CategoryCard → /market?mode=preorder); কুইক ডেলিভারি বন্ধ থাকলে নিচের স্ক্রিপ্ট লুকায় (qd-entry)
const otherCategories = categoriesWithOrder
  .filter(c => !popularSlugs.includes(c.slug) && (!c.hidden || c.slug === 'online-shop'))
  .sort((a, b) => a.__sortOrder - b.__sortOrder);

const BUCKET = 'listing-images';
const categoryImageMap: Record<string, string> = {};

try {
  const { data, error } = await imagesPromise;

  if (!error && data) {
    data.forEach((row) => {
      const { data: urlData } = supabase.storage.from(BUCKET).getPublicUrl(row.storage_path);
      const bust = row.updated_at ? new Date(row.updated_at).getTime() : Date.now();
      categoryImageMap[row.category_slug] = `${urlData.publicUrl}?t=${bust}`;
    });
  }
} catch (e) {
  // fetch ব্যর্থ হলে সব ক্যাটাগরি fallback আইকন ডিজাইনেই থাকবে, পেজ ভাঙবে না
}

// গতি: এই ক্যাটাগরির ছবি রিপোর public/categories/-এ (WebP, Vercel CDN, SW cache-first)।
// ছবি বদলাতে ফাইল বদলাও ও নিচের v নম্বর বাড়াও (sw.js-এও একই v)। তালিকার বাইরের নতুন ক্যাটাগরি আগের মতো Supabase থেকে।
const LOCAL_CATEGORY_IMAGES = ['blood','car-rental','clubs','courier','doctor-directory','health','housing','job','local-ride','online-shop','recycle','repair','ride','sports','tuition'];
LOCAL_CATEGORY_IMAGES.forEach((s) => {
  categoryImageMap[s] = `/categories/${s}.webp?v=${s === 'local-ride' ? 3 : 1}`;
});
---

<section class="category-section">
  <div class="container">

    {showPopular && (
      <>
        <div class="popular-label">
          <i class="fas fa-fire"></i> জনপ্রিয়
        </div>
        <div class="category-grid category-grid-popular" id="categoryGridPopular">
          <CategoryCardPopular cat={quickDeliveryCat} imageUrl={categoryImageMap['quick-delivery'] || '/categories/quick-delivery.webp?v=2'} href="/market" extraClass="qd-entry" />
          {courierCat && <CategoryCardPopular cat={courierCat} imageUrl={categoryImageMap['courier']} extraClass="qd-fallback" hidden={true} />}
          {popularCategories.map((cat) => (
            <CategoryCardPopular cat={cat} imageUrl={categoryImageMap[cat.slug]} />
          ))}
        </div>
      </>
    )}

    {showGeneral && (
      <div class="category-grid" id="categoryGrid">
        {otherCategories.map((cat) => (
          <CategoryCard cat={cat} imageUrl={categoryImageMap[cat.slug]} extraClass={cat.slug === 'online-shop' ? 'qd-entry' : ''} />
        ))}
      </div>
    )}

  </div>
</section>


<script>
  // কুইক ডেলিভারি দেখানো হবে কিনা (সুইচ চালু, অথবা স্টাফ) — দেখালে অনলাইন শপ সাধারণে যায়
  import { marketAccess } from '../../lib/marketApi.js';
  function applyQd(show) {
    document.querySelectorAll('.qd-entry').forEach((el) => { el.hidden = !show; });
    document.querySelectorAll('.qd-fallback').forEach((el) => { el.hidden = show; });
  }
  marketAccess().then((a) => applyQd(!!(a && a.allowed))).catch(() => applyQd(false));
</script>

<style is:global>
  .category-card-popular[hidden], .category-card[hidden] { display: none !important; }
</style>

<style>
  .category-section {
    padding: 16px 0 24px;
    background: transparent;
  }

  .popular-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #CC4A1C;
    margin: 0 0 12px 4px;
  }

  .popular-label i {
    filter: drop-shadow(0 0 6px rgba(255, 107, 53, 0.5));
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 768px) {
    .category-section {
      padding: 4px 0 8px;
    }

    .popular-label {
      margin: 0 0 8px 4px;
    }

    .category-grid {
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .category-grid {
      gap: 8px;
    }
  }
</style>