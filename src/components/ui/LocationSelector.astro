// ============================================================
// কম্পোনেন্ট: লোকেশন সিলেক্টর (উপজেলা)
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আগের বাগফিক্স (বাংলা নাম): profiles.upazila কলামে ডেটা বাংলা নামে
// সেভ আছে ("ফেনী সদর", "দাগনভূঞা"), slug না। তাই বাংলা নাম দিয়ে
// ম্যাচ/সেভ করা হয় (existing ডেটার সাথে কনসিস্টেন্ট)।
//
// ============================================================
// নতুন আপডেট — ম্যাপ-ভিত্তিক উপজেলা/ইউনিয়ন সিলেকশন
// ============================================================
// ১. বাটনে ক্লিক করলে ছোট লিস্ট ড্রপডাউনের বদলে ফুলস্ক্রিন ম্যাপ শিট খোলে।
//    - ধাপ ১: ৬টা উপজেলা আলাদা রঙ, বাউন্ডারি ও নামসহ। ট্যাপ → ধাপ ২।
//    - ধাপ ২: শুধু সেই উপজেলায় জুম, প্রতিটা ইউনিয়ন বাউন্ডারি ও নামসহ।
//      ইউনিয়ন বাছা ঐচ্ছিক (আবার ট্যাপ করলে বাদ); উপজেলা বাছলেই সেভ করা যায়।
// ২. ম্যাপে বর্তমান ম্যাপের (OSM) টাইল হুবহু থাকে — স্কুল/বাজার/দোকানের নাম
//    কিছুই বদলায় না। শুধু ওপরে বাউন্ডারি + নাম ওভারলে। ফেনী জেলার পুরো
//    বাইরের সীমানা সবসময় বোল্ড (সাদা হ্যালো + কমলা লাইন)। ম্যাপ ফেনীর
//    সীমানার বাইরে প্যান করা যায় না।
// ৩. নতুন ভিজিটরের (প্রোফাইল/ক্যাশে কিছু নেই) জন্য ড্রপডাউন আর অটো খোলে না —
//    বাটনের নিচে আইকনসহ "উপজেলা সিলেক্ট করুন" ইনস্ট্রাকশন বাবল দেখায়।
// ৪. ঐচ্ছিক "আমার লোকেশন" বাটন — ট্যাপ করলে GPS থেকে উপজেলা/ইউনিয়ন ধরে
//    ধাপ ২-এ নিয়ে যায়। নিজে থেকে কিছু সেভ হয় না, "সেভ করুন" চাপতে হয়।
//    ফেনীর বাইরে হলে নোটিস দেখায়।
// ৫. ম্যাপ/geojson লোড না হলে পুরনো ৬টা বাটনের লিস্ট ফলব্যাক হিসেবে দেখায়।
// ৬. ইউনিয়ন সেভ হয় localStorage 'smartfeni_union'-এ (ইংরেজি shapeName)।
//    ডেটাবেজে যায় না। 'smartfeni:upazila-changed' ইভেন্টে detail.upazila
//    (slug, আগের মতোই) + নতুন detail.union (ইউনিয়ন বা null)।
//
// ============================================================
// নতুন আপডেট ২ — ৪ লেভেলের আলাদা রঙের বর্ডার + দেশ ভিউ
// ============================================================
// ১. বর্ডারের রঙ (feniAreas.js-এর BORDER_COLORS থেকে): দেশ নেভি, জেলা (ফেনী)
//    কমলা (সবচেয়ে বোল্ড — গ্লো + সাদা হ্যালো + লাইন), উপজেলা বেগুনি,
//    ইউনিয়ন টিল। উপজেলার ফিল আগের মতো উপজেলা-ভেদে আলাদা হালকা রঙ।
// ২. ধাপ ১-এও এখন ইউনিয়নের সরু টিল বর্ডার দেখায় (আগে শুধু ধাপ ২-এ)।
// ৩. "দেশ দেখুন" বাটন → বাংলাদেশ ভিউতে জুম-আউট: বাংলাদেশের বাইরে হালকা
//    মাস্ক, দেশের নেভি বর্ডার, ফেনী কমলা ফিল + পালস। ফেনীতে ট্যাপ করলে
//    (বা "ফেনীতে ফিরুন") আগের ফেনী ভিউতে ফেরে। দেশের ফাইল (ADM0) অনেক
//    সরলীকৃত, তাই ফেনীর কাছে এর লাইন ইউনিয়ন বর্ডার থেকে সরে যায় — এজন্য
//    দেশের বর্ডার শুধু দেশ ভিউতেই আঁকা হয়, ফেনী ভিউতে নয়।
// ৪. লেজেন্ড (বাম-ওপরে): রঙের চাবি + প্রতিটা লেভেল অন/অফ। ফেনী ভিউতে
//    জেলা/উপজেলা/ইউনিয়ন, দেশ ভিউতে দেশ/জেলা দেখায়।
// ৫. লোড: public/data/bangladesh.geojson প্রথমবার "দেশ দেখুন" চাপলেই লোড হয়
//    (ফেনী ভিউয়ের লোড সময় বাড়ে না)। লোড ব্যর্থ হলে নোটিস, ফেনী ভিউ ঠিক থাকে।
// ৬. OSM টাইল, GPS "আমার লোকেশন", সেভ লজিক, localStorage, ইভেন্ট ও Android
//    ব্যাক বাটন — সব আগের মতোই।
//
// ডেটা/হেল্পার: src/data/feniAreas.js, geojson: public/data/feni_unions.geojson,
// public/data/bangladesh.geojson (দেশ ভিউ)
// Android ব্যাক বাটন: শিটের root ক্লাস "ls-overlay" + ".active" এবং ক্লোজ
// বাটনের aria-label "বন্ধ করুন" — native-bridge.js-এর closeTopOverlay নিজে ধরে।
// ============================================================
---

<div class="location-selector" id="locationSelector">
  <button class="location-btn" id="locationBtn" type="button">
    <i class="fas fa-location-dot"></i>
    <span id="locationLabel">উপজেলা বেছে নিন</span>
    <i class="fas fa-chevron-down chevron"></i>
  </button>

  <button class="location-hint" id="locationHint" type="button">
    <i class="fas fa-hand-pointer"></i>
    <span>উপজেলা সিলেক্ট করুন</span>
  </button>
</div>

<!-- ফুলস্ক্রিন ম্যাপ শিট (JS এটাকে <body>-তে সরিয়ে নেয়, যাতে হেডারের stacking-এ আটকে না যায়) -->
<div class="ls-overlay" id="lsSheet">
  <div class="ls-header">
    <button type="button" class="ls-back-btn" id="lsBack" aria-label="সব উপজেলায় ফিরুন" hidden>
      <i class="fas fa-arrow-left"></i>
    </button>
    <div class="ls-title-wrap">
      <span class="ls-title" id="lsTitle">আপনার উপজেলা বেছে নিন</span>
      <span class="ls-sub" id="lsSub">যেকোনো উপজেলায় ট্যাপ করুন</span>
    </div>
    <button type="button" class="ls-x-btn" id="lsClose" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>
  </div>

  <div class="ls-map-wrap" id="lsMapWrap">
    <div class="ls-map" id="lsMap"></div>
    <button type="button" class="ls-locate" id="lsLocate">
      <i class="fas fa-crosshairs"></i>
      <span>আমার লোকেশন</span>
    </button>

    <!-- রঙের চাবি + লেভেল অন/অফ -->
    <div class="ls-legend" id="lsLegend" data-view="feni" role="group" aria-label="বর্ডারের রঙ">
      <button type="button" class="ls-leg-row" data-level="country" aria-pressed="true">
        <span class="ls-leg-line"></span><span>দেশ</span>
      </button>
      <button type="button" class="ls-leg-row" data-level="district" aria-pressed="true">
        <span class="ls-leg-line"></span><span>জেলা (ফেনী)</span>
      </button>
      <button type="button" class="ls-leg-row" data-level="upazila" aria-pressed="true">
        <span class="ls-leg-line"></span><span>উপজেলা</span>
      </button>
      <button type="button" class="ls-leg-row" data-level="union" aria-pressed="true">
        <span class="ls-leg-line"></span><span>ইউনিয়ন</span>
      </button>
    </div>

    <!-- ফেনী ভিউ ↔ বাংলাদেশ ভিউ -->
    <button type="button" class="ls-country-btn" id="lsCountryBtn">
      <i class="fas fa-earth-asia"></i>
      <span>দেশ দেখুন</span>
    </button>

    <div class="ls-loading" id="lsLoading">
      <i class="fas fa-spinner fa-spin"></i>
      <span>ম্যাপ লোড হচ্ছে…</span>
    </div>
  </div>

  <!-- ফলব্যাক: ম্যাপ লোড না হলে পুরনো লিস্ট -->
  <div class="ls-fallback" id="lsFallback" hidden>
    <p class="ls-fallback-note">ম্যাপ লোড হয়নি — লিস্ট থেকে বেছে নিন</p>
    <button class="upazila-option" data-upazila="feni-sadar" type="button">ফেনী সদর</button>
    <button class="upazila-option" data-upazila="chhagalnaiya" type="button">ছাগলনাইয়া</button>
    <button class="upazila-option" data-upazila="daganbhuiyan" type="button">দাগনভূঞা</button>
    <button class="upazila-option" data-upazila="parshuram" type="button">পরশুরাম</button>
    <button class="upazila-option" data-upazila="fulgazi" type="button">ফুলগাজী</button>
    <button class="upazila-option" data-upazila="sonagazi" type="button">সোনাগাজী</button>
  </div>

  <div class="ls-footer" id="lsFooter">
    <p class="ls-note" id="lsNote" hidden></p>
    <p class="ls-selected" id="lsSelected">ম্যাপে একটা উপজেলায় ট্যাপ করুন</p>
    <button type="button" class="ls-save" id="lsSave" disabled>সেভ করুন</button>
  </div>
</div>

<style>
  .location-selector {
    position: relative;
    margin-left: -24px;
  }

  .location-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(248, 250, 252, 0.9);
    color: #1B2A4A;
    border: 1px solid rgba(27, 42, 74, 0.08);
    border-radius: 30px;
    padding: 8px 12px 8px 14px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(27, 42, 74, 0.05);
    transition: color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
    max-width: 160px;
    overflow: hidden;
  }

  .location-btn span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location-btn:hover {
    color: #FF6B35;
    border-color: rgba(255, 107, 53, 0.3);
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.1);
  }

  .location-btn i.fa-location-dot {
    color: #FF6B35;
    flex-shrink: 0;
    font-size: 0.9rem;
  }

  .chevron {
    font-size: 0.6rem;
    margin-left: 1px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .location-selector.open .chevron {
    transform: rotate(180deg);
  }

  /* ---------- নতুন ভিজিটরের ইনস্ট্রাকশন বাবল ---------- */
  .location-hint {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 6px;
    align-items: center;
    gap: 8px;
    background: #1B2A4A;
    color: #fff;
    border: none;
    border-radius: 14px;
    padding: 9px 14px;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    white-space: nowrap;
    max-width: calc(100vw - 24px);
    box-shadow: 0 8px 24px rgba(27, 42, 74, 0.25);
    cursor: pointer;
    z-index: 1000;
    animation: hintFloat 2s ease-in-out infinite;
  }

  .location-hint::before {
    content: '';
    position: absolute;
    top: -6px;
    left: var(--caret-x, 26px);
    width: 12px;
    height: 12px;
    background: #1B2A4A;
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .location-hint i {
    color: #FF6B35;
    font-size: 1rem;
    animation: hintTap 1.2s ease-in-out infinite;
  }

  .location-selector.needs-pick .location-hint {
    display: inline-flex;
  }

  .location-selector.needs-pick .location-btn {
    border-color: rgba(255, 107, 53, 0.55);
    animation: btnPulse 2s ease-out infinite;
  }

  @keyframes hintFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @keyframes hintTap {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(2px, -3px); }
  }

  @keyframes btnPulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 107, 53, 0.45); }
    70% { box-shadow: 0 0 0 10px rgba(255, 107, 53, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 107, 53, 0); }
  }

  /* ---------- ফুলস্ক্রিন ম্যাপ শিট ---------- */
  .ls-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #fff;
    flex-direction: column;
  }

  .ls-overlay.active {
    display: flex;
  }

  .ls-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    padding-top: max(12px, env(safe-area-inset-top));
    border-bottom: 1px solid #E5EAF0;
    background: #fff;
    flex-shrink: 0;
  }

  .ls-title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ls-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ls-sub {
    font-size: 0.75rem;
    color: #5C7086;
    margin-top: 1px;
  }

  .ls-back-btn,
  .ls-x-btn {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F1F5F9;
    border: none;
    border-radius: 50%;
    color: #1B2A4A;
    font-size: 1rem;
    cursor: pointer;
  }

  .ls-back-btn[hidden] {
    display: none;
  }

  .ls-back-btn:hover,
  .ls-x-btn:hover {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .ls-map-wrap {
    position: relative;
    flex: 1;
    min-height: 0;
    background: #EAF0F6;
  }

  .ls-map-wrap[hidden] {
    display: none;
  }

  /* isolation: Leaflet-এর ভেতরের z-index (200-700) বাইরে escape করবে না */
  .ls-map {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }

  .ls-locate {
    position: absolute;
    left: 12px;
    bottom: 14px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #1B2A4A;
    border: 1px solid #E5EAF0;
    border-radius: 30px;
    padding: 10px 16px;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    box-shadow: 0 4px 14px rgba(27, 42, 74, 0.18);
    cursor: pointer;
  }

  .ls-locate i {
    color: #FF6B35;
  }

  .ls-locate:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .ls-loading {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(234, 240, 246, 0.92);
    color: #1B2A4A;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .ls-loading[hidden] {
    display: none;
  }

  .ls-footer {
    flex-shrink: 0;
    padding: 12px 14px;
    padding-bottom: max(12px, env(safe-area-inset-bottom));
    border-top: 1px solid #E5EAF0;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ls-footer[hidden] {
    display: none;
  }

  .ls-selected {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1B2A4A;
  }

  /* innerHTML দিয়ে বসানো এলিমেন্টে Astro scoped CSS লাগে না — তাই :global() */
  .ls-selected :global(small) {
    display: block;
    margin-top: 2px;
    font-size: 0.74rem;
    font-weight: 500;
    color: #5C7086;
  }

  .ls-selected :global(i) {
    color: #FF6B35;
    margin-right: 4px;
  }

  .ls-note {
    margin: 0;
    padding: 9px 12px;
    border-radius: 10px;
    background: #FFF4E5;
    color: #9A5B00;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .ls-note[hidden] {
    display: none;
  }

  .ls-save {
    width: 100%;
    background: #FF6B35;
    color: #fff;
    border: none;
    border-radius: 14px;
    padding: 13px;
    font-size: 0.95rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s ease, opacity 0.15s ease;
  }

  .ls-save:disabled {
    background: #CBD5E1;
    cursor: not-allowed;
  }

  /* ---------- লেজেন্ড (রঙের চাবি + অন/অফ) ---------- */
  .ls-legend {
    position: absolute;
    top: 12px;
    left: 12px;
