---
// ============================================================
// কম্পোনেন্ট: লোকেশন সিলেক্টর (উপজেলা)
// ফিক্স ১: ব্যাকগ্রাউন্ড বক্স সরিয়ে মিনিমাল (শুধু পিন+নাম), বাম কোণায়
// ফিক্স ২: ড্রপডাউন এখন header-এর exact নিচ থেকে, বাম পাশে fixed —
//          প্রতিবার খোলার সময় লাইভ measurement দিয়ে position বসে
// আপডেট: উপজেলা সিলেকশনে GA4/Supabase অ্যানালিটিক্স ইভেন্ট
// আপডেট ২: setUpazila এখন smartfeni:upazila-changed ইভেন্ট fire করে
//
// আপডেট (নতুন — GPS auto-detect সম্পূর্ণ বাদ): আগে
// navigator.geolocation দিয়ে ইউজারের লোকেশন নিয়ে nearest উপজেলা
// বের করা হতো (৪০কিমি রেডিয়াস চেক সহ) — এটা প্রথম ইম্প্রেশনে
// অপ্রয়োজনীয় permission popup তৈরি করত। এখন সম্পূর্ণ বাদ।
//
// নতুন priority লজিক:
// ১. লগইন করা থাকলে → profiles.upazila (DB থেকে, ক্রস-ডিভাইস
//    consistent — profiles টেবিলে এই কলাম already আছে)
// ২. না থাকলে → localStorage cache (আগের ভিজিটের সিলেকশন)
// ৩. কোনোটাই না থাকলে (একদম প্রথমবার) → ড্রপডাউন অটোমেটিক খুলে
//    যাবে, বাধ্যতামূলক সিলেকশন (একটা উপজেলা বেছে না নেওয়া পর্যন্ত
//    বাইরে ক্লিকে বন্ধ হবে না)
// ৪. যেকোনো সময় header dropdown থেকে ম্যানুয়াল বদল সম্ভব — লগইন
//    থাকলে profiles.upazila-ও আপডেট হয়ে যাবে (cross-device sync)
// ============================================================
---

<div class="location-selector" id="locationSelector">
  <button class="location-btn" id="locationBtn" type="button">
    <i class="fas fa-location-dot"></i>
    <span id="locationLabel">উপজেলা বেছে নিন</span>
    <i class="fas fa-chevron-down chevron"></i>
  </button>

  <div class="location-dropdown" id="locationDropdown">
    <p class="dropdown-title">আপনার উপজেলা বেছে নিন</p>
    <button class="upazila-option" data-upazila="feni-sadar">ফেনী সদর</button>
    <button class="upazila-option" data-upazila="chhagalnaiya">ছাগলনাইয়া</button>
    <button class="upazila-option" data-upazila="daganbhuiyan">দাগনভূঞা</button>
    <button class="upazila-option" data-upazila="parshuram">পরশুরাম</button>
    <button class="upazila-option" data-upazila="fulgazi">ফুলগাজী</button>
    <button class="upazila-option" data-upazila="sonagazi">সোনাগাজী</button>
  </div>
</div>

<style>
  .location-selector {
    position: relative;
    margin-left: -24px;
  }

  .location-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: #1B2A4A;
    border: none;
    padding: 8px 10px 8px 14px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.2s ease;
    white-space: nowrap;
    max-width: 160px;
    overflow: hidden;
  }

  .location-btn span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location-btn:hover {
    color: #FF6B35;
  }

  .location-btn i.fa-location-dot {
    color: #FF6B35;
    flex-shrink: 0;
    font-size: 0.9rem;
  }

  .chevron {
    font-size: 0.6rem;
    margin-left: 1px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .location-selector.open .chevron {
    transform: rotate(180deg);
  }

  .location-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 14px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    padding: 12px;
    width: 240px;
    z-index: 1000;
    border: 1px solid #EEF3F9;
  }

  .location-selector.open .location-dropdown {
    display: block;
  }

  .dropdown-title {
    font-size: 0.75rem;
    color: #7A8EA5;
    font-weight: 600;
    padding: 4px 12px 8px;
  }

  .upazila-option {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    color: #1B2A4A;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .upazila-option:hover {
    background: #F8FAFC;
  }

  .upazila-option.active {
    background: #FFF0EA;
    color: #FF6B35;
  }

  @media (max-width: 768px) {
    .location-btn {
      max-width: 130px;
      padding: 6px 8px 6px 12px;
    }

    .location-dropdown {
      position: fixed;
      left: 8px;
      top: 70px; /* fallback, JS দিয়ে override হবে */
      width: calc(100vw - 16px);
      max-width: 280px;
      max-height: calc(100vh - 90px);
      overflow-y: auto;
      z-index: 1000;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { trackEvent } from '../../lib/analytics.js';

  const UPAZILAS = [
    { id: 'feni-sadar', name: 'ফেনী সদর' },
    { id: 'chhagalnaiya', name: 'ছাগলনাইয়া' },
    { id: 'daganbhuiyan', name: 'দাগনভূঞা' },
    { id: 'parshuram', name: 'পরশুরাম' },
    { id: 'fulgazi', name: 'ফুলগাজী' },
    { id: 'sonagazi', name: 'সোনাগাজী' },
  ];

  const DEFAULT_UPAZILA = 'feni-sadar';
  const STORAGE_KEY = 'smartfeni_upazila';

  const selector = document.getElementById('locationSelector');
  const btn = document.getElementById('locationBtn');
  const label = document.getElementById('locationLabel');
  const dropdown = document.getElementById('locationDropdown');
  const options = document.querySelectorAll('.upazila-option');

  // যতক্ষণ কোনো উপজেলা কনফার্মড না হচ্ছে (প্রথম ভিজিট, বাধ্যতামূলক
  // সিলেকশন), ততক্ষণ বাইরে ক্লিকে ড্রপডাউন বন্ধ হবে না
  let hasResolvedUpazila = false;

  function setUpazila(id: string, { save = true, syncProfile = false } = {}) {
    const upazila = UPAZILAS.find((u) => u.id === id) || UPAZILAS.find((u) => u.id === DEFAULT_UPAZILA)!;
    label!.textContent = upazila.name;
    options.forEach((opt) => {
      opt.classList.toggle('active', (opt as HTMLElement).dataset.upazila === upazila.id);
    });

    hasResolvedUpazila = true;

    // অন্য কম্পোনেন্ট (Header ব্যাকগ্রাউন্ড, লোকেশন-সর্টিং) এই ইভেন্ট শুনে
    window.dispatchEvent(new CustomEvent('smartfeni:upazila-changed', { detail: { upazila: upazila.id } }));

    if (save) {
      localStorage.setItem(STORAGE_KEY, upazila.id);
      trackEvent('upazila_selected', { upazila: upazila.id });
    }

    if (syncProfile) {
      syncUpazilaToProfile(upazila.id);
    }

    return upazila;
  }

  async function syncUpazilaToProfile(id: string) {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    await supabase.from('profiles').update({ upazila: id }).eq('id', session.user.id);
  }

  function openDropdown() {
    selector!.classList.add('open');
    updateDropdownPosition();
  }

  function closeDropdown() {
    selector!.classList.remove('open');
  }

  // ===== dropdown-কে header-এর exact নিচে, বাম পাশে বসায় (লাইভ measurement) =====
  function updateDropdownPosition() {
    if (window.innerWidth > 768) {
      dropdown!.style.top = '';
      dropdown!.style.left = '';
      return;
    }
    const navbar = document.querySelector('.navbar') as HTMLElement | null;
    if (!navbar) return;
    const navRect = navbar.getBoundingClientRect();
    dropdown!.style.top = `${Math.round(navRect.bottom)}px`;
    dropdown!.style.left = '8px';
  }

  // ============================================================
  // প্রাথমিক উপজেলা নির্ণয় — priority: profile → cache → mandatory dropdown
  // ============================================================
  async function resolveInitialUpazila() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('upazila')
        .eq('id', session.user.id)
        .single();

      const profileUpazila = profile?.upazila;
      if (profileUpazila && UPAZILAS.some((u) => u.id === profileUpazila)) {
        setUpazila(profileUpazila, { save: true, syncProfile: false });
        return;
      }
    }

    const cached = localStorage.getItem(STORAGE_KEY);
    if (cached && UPAZILAS.some((u) => u.id === cached)) {
      setUpazila(cached, { save: false });
      return;
    }

    // একদম প্রথমবার — কোনো cache/profile নাই, বাধ্যতামূলক ম্যানুয়াল সিলেকশন
    label!.textContent = 'উপজেলা বেছে নিন';
    openDropdown();
  }

  resolveInitialUpazila();

  btn!.addEventListener('click', () => {
    const willOpen = !selector!.classList.contains('open');
    if (willOpen) {
      openDropdown();
    } else {
      closeDropdown();
    }
  });

  document.addEventListener('click', (e) => {
    if (!selector!.contains(e.target as Node)) {
      // প্রথমবার (কোনো উপজেলা এখনো কনফার্মড না) বাইরে ক্লিকে বন্ধ হবে না —
      // বাধ্যতামূলক সিলেকশন
      if (!hasResolvedUpazila) return;
      closeDropdown();
    }
  });

  window.addEventListener('resize', () => {
    if (selector!.classList.contains('open')) {
      updateDropdownPosition();
    }
  });

  options.forEach((opt) => {
    opt.addEventListener('click', () => {
      const id = (opt as HTMLElement).dataset.upazila!;
      setUpazila(id, { save: true, syncProfile: true });
      closeDropdown();
    });
  });
</script>
