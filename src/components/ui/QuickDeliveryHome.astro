---
// path: src/components/ui/QuickDeliveryHome.astro
// হোম পেজে কুইক ডেলিভারি: ব্যানার কার্ড + জনপ্রিয় খাবার চিপ (পিজ্জা/বার্গার/বিরিয়ানি/চিকেন)।
// চিপে ট্যাপ করলে /market?food=<নাম> — সেই আইটেমওয়ালা দোকানগুলো দেখায়।
// সুইচ (marketplace_enabled) বন্ধ থাকলে সাধারণ ইউজারের কাছে লুকানো (ক্লায়েন্টে যাচাই; হোম পেজ CDN-ক্যাশড)।
const FOODS = ['পিজ্জা', 'বার্গার', 'বিরিয়ানি', 'চিকেন'];
---
<section class="qd-home" id="qdHome" hidden aria-label="কুইক ডেলিভারি">
  <a class="qd-card" href="/market">
    <span class="qd-ic"><i class="fas fa-motorcycle" aria-hidden="true"></i></span>
    <span class="qd-tx">
      <b>কুইক ডেলিভারি</b>
      <small>খাবার, গ্রোসারি, ওষুধ, ফুল — ফেনীর সব দোকান এক জায়গায়</small>
    </span>
    <i class="fas fa-chevron-right" aria-hidden="true"></i>
  </a>
  <div class="qd-foods" role="list">
    {FOODS.map((f) => <a class="qd-food" role="listitem" href={'/market?food=' + encodeURIComponent(f)}>{f}</a>)}
  </div>
</section>

<style is:global>
  .qd-home { max-width: 1100px; margin: 10px auto 4px; padding: 0 16px; font-family: inherit; }
  .qd-home[hidden] { display: none; }
  .qd-card { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 18px; background: linear-gradient(135deg, #FF6B35, #FF8F5A); color: #fff; text-decoration: none; box-shadow: 0 4px 14px rgba(255, 107, 53, 0.3); }
  .qd-card:focus-visible, .qd-food:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
  .qd-ic { flex: none; width: 46px; height: 46px; border-radius: 14px; background: rgba(255, 255, 255, 0.22); display: flex; align-items: center; justify-content: center; font-size: 22px; }
  .qd-tx { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .qd-tx b { font-size: 17px; }
  .qd-tx small { font-size: 12.5px; opacity: 0.95; line-height: 1.4; }
  .qd-foods { display: flex; gap: 8px; overflow-x: auto; padding: 10px 0 2px; scrollbar-width: none; }
  .qd-food { flex: none; padding: 7px 16px; border-radius: 20px; background: #fff; border: 1.5px solid #EADBCF; color: #1B2A4A; font-size: 13.5px; font-weight: 700; text-decoration: none; }
</style>

<script>
  import { marketEnabledForMe } from '../../lib/marketApi.js';
  (async () => {
    const el = document.getElementById('qdHome');
    if (!el) return;
    try { if (await marketEnabledForMe()) el.hidden = false; } catch (e) {}
  })();
</script>
