---
// ============================================================
// কম্পোনেন্ট: ScratchCard — "আজকের স্ক্রেচ কার্ড" (হোমপেজ)  [v2]
//
// কী করে:
//   ১) লগইন করা ইউজার + ক্যাম্পেইন চালু থাকলে হোমে ছোট টিজার কার্ড দেখায়
//   ২) টিজারে ট্যাপ করলে ফুলস্ক্রিন শিটে ক্যানভাস স্ক্রেচ কার্ড (ঘষলে খোলে)
//   ৩) ঘষা শুরু হলেই সার্ভারে claim_scratch_card() যায়; ফল ঠিক করে সার্ভার,
//      ক্লায়েন্ট কিছু ঠিক করে না। ৪০% ঘষা হলে ফল দেখায়
//   ৪) একই ডিভাইসে দ্বিতীয় অ্যাকাউন্ট হলে ঘষার পর মেসেজ দেখায় (device_limit)
//   ৫) ক্যাশ জিতলে বিকাশ নম্বর + ঐচ্ছিক ফেসবুক পোস্ট লিংক ফর্ম (submit_scratch_bkash)
//   ৬) "পুরস্কার ও নিয়ম" ভাঁজ করা অংশ — অংক সবই অ্যাডমিন সেটিং থেকে আসে
//      (get_scratch_status().prizes); মেগা অংশ শুধু মেগা সুইচ অন + মেগা দিন বাকি +
//      বিজয়ী এখনো হয়নি হলে দেখায়, নইলে পুরোপুরি বাদ (সার্ভার prizes.mega = null দেয়)
//   ৭) সাম্প্রতিক ক্যাশ বিজয়ী: পুরো নাম + অংক, সর্বশেষ বিজয়ী সবার উপরে (get_scratch_winners)
//
// ইউজারকে বলা হয় না: দিনে/সপ্তাহে কয়জন ক্যাশ পায়, মেগা কোন দিনে হয় — এগুলো শুধু অ্যাডমিনের হিসাব।
//
// RPC: get_scratch_status(), claim_scratch_card(), submit_scratch_bkash(), get_scratch_winners()
// Android back বাটন: ওভারলের ক্লাস "sc-overlay" + ".open", বন্ধ বাটনের aria-label এ "বন্ধ"
// ============================================================
---

<section id="scTeaser" class="sc-teaser" hidden>
  <button type="button" id="scTeaserBtn" class="sc-teaser-btn">
    <span class="sc-teaser-ico" aria-hidden="true">🎁</span>
    <span class="sc-teaser-txt">
      <strong id="scTeaserTitle">আজকের স্ক্রেচ কার্ড</strong>
      <small id="scTeaserSub"></small>
    </span>
    <span class="sc-teaser-go" id="scTeaserGo">খুলুন</span>
  </button>
</section>

<div id="scOverlay" class="sc-overlay">
  <div class="sc-backdrop" id="scBackdrop"></div>
  <div class="sc-sheet" role="dialog" aria-modal="true" aria-label="আজকের স্ক্রেচ কার্ড">
    <div class="sc-head">
      <h3>আজকের স্ক্রেচ কার্ড</h3>
      <button type="button" class="sc-close" id="scClose" aria-label="বন্ধ করুন">✕</button>
    </div>

    <div class="sc-card" id="scCard">
      <div class="sc-face" id="scFace">
        <div class="sc-face-main" id="scFaceMain">…</div>
        <div class="sc-face-sub" id="scFaceSub"></div>
      </div>
      <canvas id="scCanvas" class="sc-canvas" width="300" height="170"></canvas>
    </div>
    <p class="sc-hint" id="scHint">রূপালি অংশে আঙুল বুলিয়ে কার্ডটি খুলুন</p>

    <div class="sc-streak" id="scStreak" hidden></div>
    <div class="sc-bonus" id="scBonus" hidden></div>
    <div class="sc-greet" id="scGreet" hidden></div>
    <div class="sc-error" id="scError" hidden></div>

    <div class="sc-pay" id="scPay" hidden>
      <h4>পুরস্কার গ্রহণের তথ্য</h4>
      <label for="scBkash">বিকাশ নম্বর <span class="required-mark" style="color:#D92D20;">*</span></label>
      <input id="scBkash" type="tel" inputmode="numeric" maxlength="11" placeholder="01XXXXXXXXX" autocomplete="off" required />
      <label for="scPost">ফেসবুক পোস্টের লিংক (ঐচ্ছিক)</label>
      <input id="scPost" type="url" inputmode="url" maxlength="500" placeholder="https://facebook.com/..." autocomplete="off" />
      <p class="sc-pay-note">আপনার জয়ের অভিজ্ঞতা ফেসবুকে শেয়ার করলে আমরা কৃতজ্ঞ থাকব। লিংক দেওয়া বাধ্যতামূলক নয়, না দিলেও পুরস্কার একইভাবে পাঠানো হবে।</p>
      <button type="button" id="scPaySubmit" class="sc-btn">তথ্য জমা দিন</button>
    </div>

    <div class="sc-done" id="scDone" hidden></div>

    <!-- পুরস্কার ও নিয়ম (ডিফল্টে ভাঁজ করা) -->
    <div class="sc-info" id="scInfo" hidden>
      <button type="button" class="sc-info-head" id="scInfoBtn" aria-expanded="false" aria-controls="scInfoBody">
        <span>পুরস্কার ও নিয়ম</span>
        <span class="sc-info-arrow" aria-hidden="true">▾</span>
      </button>
      <div class="sc-info-body" id="scInfoBody" hidden></div>
    </div>

    <!-- সাম্প্রতিক ক্যাশ বিজয়ী -->
    <div class="sc-wall" id="scWall" hidden>
      <h4>সাম্প্রতিক ক্যাশ বিজয়ী</h4>
      <div id="scWallList"></div>
    </div>
  </div>
</div>

<style is:global>
  .sc-teaser { margin: 12px 16px; }
  .sc-teaser[hidden] { display: none; }
  .sc-teaser-btn { width: 100%; display: flex; align-items: center; gap: 12px; padding: 14px; border: none; border-radius: 18px; cursor: pointer; text-align: left; color: #fff; background: linear-gradient(135deg, #FF6B35 0%, #FF8F5E 100%); box-shadow: 0 6px 18px rgba(255, 107, 53, 0.28); font-family: inherit; }
  .sc-teaser-ico { font-size: 1.9rem; line-height: 1; }
  .sc-teaser-txt { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .sc-teaser-txt strong { font-size: 1rem; font-weight: 800; }
  .sc-teaser-txt small { font-size: 0.8rem; opacity: 0.95; line-height: 1.5; }
  .sc-teaser-go { background: #fff; color: #FF6B35; font-weight: 800; font-size: 0.85rem; padding: 8px 14px; border-radius: 999px; white-space: nowrap; }

  .sc-overlay { position: fixed; inset: 0; z-index: 3600; display: none; }
  .sc-overlay.open { display: block; }
  .sc-backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.6); }
  .sc-sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 92vh; overflow-y: auto; background: #fff; border-radius: 24px 24px 0 0; padding: 18px 18px calc(24px + env(safe-area-inset-bottom, 0px)); }
  .sc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .sc-head h3 { margin: 0; font-size: 1.1rem; font-weight: 800; color: #1B2A4A; }
  .sc-close { border: none; background: #F1F4F9; width: 34px; height: 34px; border-radius: 50%; color: #1B2A4A; cursor: pointer; }

  .sc-card { position: relative; width: 100%; max-width: 340px; margin: 0 auto; aspect-ratio: 300 / 170; border-radius: 18px; overflow: hidden; background: #FFF4EC; border: 2px dashed #FF6B35; }
  .sc-face { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 10px; text-align: center; }
  .sc-face-main { font-size: 1.7rem; font-weight: 900; color: #1B2A4A; }
  .sc-face-sub { font-size: 0.85rem; color: #3C4C66; line-height: 1.5; }
  .sc-face.is-cash .sc-face-main { color: #FF6B35; font-size: 2rem; }
  .sc-face.is-error .sc-face-main { font-size: 1.05rem; color: #B42318; }
  .sc-canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: pointer; transition: opacity 0.35s ease; }
  .sc-canvas.gone { opacity: 0; pointer-events: none; }
  .sc-hint { text-align: center; margin: 10px 0 0; font-size: 0.85rem; color: #8090A6; }
  .sc-hint[hidden] { display: none; }

  .sc-streak { margin: 12px auto 0; max-width: 340px; text-align: center; font-size: 0.85rem; font-weight: 700; color: #B54708; background: #FFF4E5; border-radius: 12px; padding: 9px 12px; line-height: 1.6; }
  .sc-bonus { margin: 10px auto 0; max-width: 340px; text-align: center; font-size: 0.9rem; font-weight: 800; color: #067647; background: #E7F8EF; border-radius: 12px; padding: 10px 12px; line-height: 1.6; }
  .sc-greet { margin: 14px auto 0; max-width: 340px; text-align: center; font-size: 0.95rem; font-weight: 700; color: #1B2A4A; background: #FFF4EC; border-radius: 14px; padding: 12px 14px; line-height: 1.6; }
  .sc-error { margin: 14px auto 0; max-width: 340px; text-align: center; font-size: 0.9rem; font-weight: 700; color: #B42318; background: #FFE3E0; border-radius: 14px; padding: 12px 14px; line-height: 1.7; }
  .sc-streak[hidden], .sc-bonus[hidden], .sc-greet[hidden], .sc-error[hidden], .sc-wall[hidden], .sc-info[hidden] { display: none; }

  .sc-pay { margin: 16px auto 0; max-width: 340px; }
  .sc-pay[hidden] { display: none; }
  .sc-pay h4 { margin: 0 0 10px; font-size: 1rem; font-weight: 800; color: #1B2A4A; }
  .sc-pay label { display: block; font-size: 0.85rem; font-weight: 700; color: #1B2A4A; margin: 10px 0 4px; }
  .sc-pay input { width: 100%; box-sizing: border-box; padding: 12px; border: 1.5px solid #D5DCE8; border-radius: 12px; font-size: 1rem; font-family: inherit; }
  .sc-pay input:focus { outline: none; border-color: #FF6B35; }
  .sc-pay-note { font-size: 0.78rem; color: #6B7A90; line-height: 1.7; margin: 8px 0 12px; }
  .sc-btn { width: 100%; padding: 13px; border: none; border-radius: 14px; background: #FF6B35; color: #fff; font-size: 1rem; font-weight: 800; cursor: pointer; font-family: inherit; }
  .sc-btn:disabled { opacity: 0.6; cursor: default; }
  .sc-done { margin: 16px auto 0; max-width: 340px; text-align: center; font-size: 0.92rem; font-weight: 700; color: #067647; background: #E7F8EF; border-radius: 14px; padding: 12px 14px; line-height: 1.7; }
  .sc-done[hidden] { display: none; }

  .sc-info { margin: 18px auto 0; max-width: 340px; border: 1px solid #E5EAF0; border-radius: 14px; overflow: hidden; }
  .sc-info-head { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border: none; background: #F8FAFC; color: #1B2A4A; font-size: 0.92rem; font-weight: 800; cursor: pointer; font-family: inherit; }
  .sc-info-arrow { transition: transform 0.2s; }
  .sc-info-head[aria-expanded="true"] .sc-info-arrow { transform: rotate(180deg); }
  .sc-info-body { padding: 4px 14px 14px; font-size: 0.84rem; color: #3C4C66; line-height: 1.75; }
  .sc-info-body[hidden] { display: none; }
  .sc-info-body h5 { margin: 12px 0 4px; font-size: 0.86rem; font-weight: 800; color: #1B2A4A; }
  .sc-info-body ul { margin: 0; padding-left: 18px; }
  .sc-info-body li { margin-bottom: 4px; }

  .sc-wall { margin: 20px auto 0; max-width: 340px; }
  .sc-wall h4 { margin: 0 0 8px; font-size: 0.95rem; font-weight: 800; color: #1B2A4A; }
  .sc-wall-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: #F8FAFC; border-radius: 12px; padding: 10px 12px; margin-bottom: 6px; font-size: 0.88rem; color: #1B2A4A; }
  .sc-wall-item span { min-width: 0; overflow-wrap: anywhere; }
  .sc-wall-item b { font-weight: 800; color: #FF6B35; white-space: nowrap; }

  /* স্ক্রেচ কার্ডের শিট খোলা থাকলে চ্যাট বট বাটন/প্যানেল লুকানো */
  body.sc-sheet-open #sf-chat-root { display: none !important; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const $ = (id) => document.getElementById(id);
  const teaser = $('scTeaser');
  const overlay = $('scOverlay');
  const canvas = $('scCanvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.width;
  const H = canvas.height;
  const REVEAL_AT = 0.4; // এতটা ঘষা হলে ফল দেখায়

  let status = null;      // get_scratch_status() এর ফল
  let endTs = 0;          // আজকের কার্ড এক্সপায়ারের সময়
  let card = null;        // যে কার্ড এখন শিটে দেখাচ্ছি
  let claimPromise = null;
  let claimResult = null;
  let revealed = false;
  let drawing = false;
  let moves = 0;

  function bn(n) {
    return Number(n || 0).toLocaleString('bn-BD');
  }

  // [১, ২, ৩] → "১, ২ ও ৩"
  function joinBn(arr) {
    const a = arr.map((x) => String(x));
    if (a.length <= 1) return a.join('');
    return a.slice(0, -1).join(', ') + ' ও ' + a[a.length - 1];
  }

  function toast(msg, type) {
    if (typeof window.showToast === 'function') window.showToast(msg, type || 'success');
  }

  function leftText() {
    const sec = Math.max(0, Math.floor((endTs - Date.now()) / 1000));
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    return h > 0 ? `আর ${bn(h)} ঘণ্টা ${bn(m)} মিনিট` : `আর ${bn(m)} মিনিট`;
  }

  // ---------- টিজার ----------
  function setTeaser(title, sub, go) {
    teaser.hidden = false;
    $('scTeaserTitle').textContent = title;
    $('scTeaserSub').textContent = sub;
    $('scTeaserGo').textContent = go;
  }

  function renderTeaser() {
    const win = status && status.unsubmitted_win;
    if (win) {
      setTeaser(`আপনার ৳${bn(win.cash_amount)} পুরস্কার অপেক্ষায় আছে`, 'বিকাশ নম্বর জমা দিলেই পাঠিয়ে দেওয়া হবে', 'জমা দিন');
      return;
    }
    if (!status || !status.active) {
      teaser.hidden = true;
      return;
    }
    if (status.card) {
      // ঘষা হয়ে গেছে (ক্যাশ জিতে তথ্য জমা বাকি থাকলে উপরের unsubmitted_win শাখায় আগেই দেখানো হয়েছে):
      // হোমে টিজার লুকানো, কার্ড আবার দেখতে মেনু থেকে খোলা যায়
      teaser.hidden = true;
      return;
    } else {
      setTeaser(
        'আজকের স্ক্রেচ কার্ড',
        `আজকের কার্ডটি আপনার অপেক্ষায় আছে · ${leftText()}` + (status.streak > 0 ? ` · টানা ${bn(status.streak)} দিন` : ''),
        'খুলুন'
      );
    }
  }

  async function loadStatus() {
    try {
      const { data: sess } = await supabase.auth.getSession();
      if (!sess || !sess.session) {
        status = null;
        teaser.hidden = true;
        return;
      }
      const { data, error } = await supabase.rpc('get_scratch_status');
      if (error || !data) {
        teaser.hidden = true;
        return;
      }
      status = data;
      endTs = Date.now() + Number(data.seconds_left || 0) * 1000;
      renderTeaser();
    } catch (e) {
      teaser.hidden = true;
    }
  }

  // ---------- ক্যানভাস কভার ----------
  function drawCover() {
    ctx.globalCompositeOperation = 'source-over';
    const g = ctx.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, '#B9C0CC');
    g.addColorStop(0.5, '#E9ECF1');
    g.addColorStop(1, '#AEB6C3');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    for (let i = 0; i < 40; i++) {
      ctx.beginPath();
      ctx.arc(Math.random() * W, Math.random() * H, Math.random() * 2.2 + 0.6, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.fillStyle = '#6B7A90';
    ctx.font = '800 22px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('এখানে ঘষুন', W / 2, H / 2);
  }

  function clearedRatio() {
    const img = ctx.getImageData(0, 0, W, H).data;
    let clear = 0;
    let total = 0;
    for (let y = 0; y < H; y += 6) {
      for (let x = 0; x < W; x += 6) {
        total++;
        if (img[(y * W + x) * 4 + 3] < 40) clear++;
      }
    }
    return total ? clear / total : 0;
  }

  function pos(e) {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) * W) / r.width, y: ((e.clientY - r.top) * H) / r.height };
  }

  function scratchAt(p) {
    ctx.globalCompositeOperation = 'destination-out';
    ctx.beginPath();
    ctx.arc(p.x, p.y, 20, 0, Math.PI * 2);
    ctx.fill();
  }

  let last = null;
  function onDown(e) {
    if (revealed) return;
    drawing = true;
    last = pos(e);
    scratchAt(last);
    startClaim();
    try { canvas.setPointerCapture(e.pointerId); } catch (_) { /* ignore */ }
  }
  function onMove(e) {
    if (!drawing || revealed) return;
    const p = pos(e);
    // দুই পয়েন্টের মাঝে ফাঁক না রাখতে লাইন ধরে আঁকা
    const dx = p.x - last.x;
    const dy = p.y - last.y;
    const steps = Math.max(1, Math.floor(Math.hypot(dx, dy) / 8));
    for (let i = 1; i <= steps; i++) {
      scratchAt({ x: last.x + (dx * i) / steps, y: last.y + (dy * i) / steps });
    }
    last = p;
    moves++;
    if (moves % 6 === 0 && clearedRatio() >= REVEAL_AT) finishReveal();
  }
  function onUp() {
    drawing = false;
    if (!revealed && claimPromise && clearedRatio() >= REVEAL_AT) finishReveal();
  }
  canvas.addEventListener('pointerdown', onDown);
  canvas.addEventListener('pointermove', onMove);
  canvas.addEventListener('pointerup', onUp);
  canvas.addEventListener('pointercancel', onUp);

  // ---------- সার্ভারে ক্লেইম ----------
  function startClaim() {
    if (claimPromise) return;
    claimPromise = supabase
      .rpc('claim_scratch_card')
      .then(({ data, error }) => {
        claimResult = { data, error };
      })
      .catch(() => {
        claimResult = { data: null, error: { message: '' } };
      });
  }

  function showError(msg) {
    const box = $('scError');
    box.textContent = msg;
    box.hidden = false;
    $('scFace').classList.add('is-error');
    $('scFaceMain').textContent = 'কার্ড খোলা যায়নি';
    $('scFaceSub').textContent = '';
  }

  async function finishReveal() {
    if (revealed) return;
    revealed = true;
    $('scHint').hidden = true;
    canvas.classList.add('gone');
    await claimPromise;
    const res = claimResult || {};
    if (res.error) {
      // সার্ভারের বাংলা মেসেজ থাকলে সেটা, নইলে সাধারণ মেসেজ
      const raw = String(res.error.message || '');
      showError(/[\u0980-\u09FF]/.test(raw) ? raw : 'কার্ড আনতে সমস্যা হয়েছে। একটু পরে আবার চেষ্টা করুন।');
      claimPromise = null; // নেটওয়ার্ক সমস্যায় শিট আবার খুললে নতুন করে চেষ্টা
      return;
    }
    if (res.data && res.data.ok === false) {
      showError(res.data.message || 'এই মুহূর্তে কার্ড খোলা যাচ্ছে না।');
      return;
    }
    card = res.data.card;
    await loadStatus(); // স্ট্রিক ও পরের মাইলফলক হালনাগাদ
    renderCard(card, true);
    loadWinners();
  }

  // ---------- কার্ডের ফল ----------
  function renderCard(c, justRevealed) {
    const isCash = Number(c.cash_amount) > 0;
    $('scFace').classList.toggle('is-cash', isCash);
    if (isCash) {
      $('scFaceMain').textContent = `৳${bn(c.cash_amount)}`;
      $('scFaceSub').textContent = 'অভিনন্দন, আপনি জিতেছেন';
    } else {
      $('scFaceMain').textContent = `${bn(c.points)} পয়েন্ট`;
      $('scFaceSub').textContent = 'পয়েন্ট আপনার ব্যালেন্সে যোগ হয়েছে';
    }
    const greet = $('scGreet');
    if (c.greeting) {
      greet.textContent = c.greeting; // textContent: ইউজারের নাম নিরাপদে বসে
      greet.hidden = false;
    }
    renderPay(c);
    renderStreak(c);
    if (justRevealed && isCash) toast(`অভিনন্দন! আপনি ৳${bn(c.cash_amount)} জিতেছেন।`, 'success');
  }

  function renderStreak(c) {
    const bonus = $('scBonus');
    if (Number(c.streak_bonus) > 0) {
      bonus.textContent = `স্ট্রিক বোনাস হিসেবে আরও ${bn(c.streak_bonus)} পয়েন্ট যোগ হয়েছে।`;
      bonus.hidden = false;
    } else {
      bonus.hidden = true;
    }
    const sk = $('scStreak');
    if (status && status.streak > 0) {
      let t = `টানা ${bn(status.streak)} দিন কার্ড খুলেছেন।`;
      const nm = status.next_milestone;
      if (nm && nm.days_left > 0) t += ` আর ${bn(nm.days_left)} দিন খুললে ${bn(nm.points)} পয়েন্ট বোনাস পাবেন।`;
      sk.textContent = t;
      sk.hidden = false;
    } else {
      sk.hidden = true;
    }
  }

  function renderPay(c) {
    const pay = $('scPay');
    const done = $('scDone');
    pay.hidden = true;
    done.hidden = true;
    if (!(Number(c.cash_amount) > 0)) return;
    if (c.pay_status === 'none') {
      pay.hidden = false;
    } else if (c.pay_status === 'pending') {
      done.textContent = `আপনার তথ্য পেয়েছি। যাচাইয়ের পর বিকাশে ৳${bn(c.cash_amount)} পাঠিয়ে দেওয়া হবে।`;
      done.hidden = false;
    } else if (c.pay_status === 'paid') {
      done.textContent = 'পুরস্কারের টাকা বিকাশে পাঠানো হয়েছে।';
      done.hidden = false;
    } else if (c.pay_status === 'rejected') {
      done.textContent = 'দুঃখিত, এই পুরস্কারটি পাঠানো সম্ভব হয়নি। বিস্তারিত জানতে আমাদের সাথে যোগাযোগ করুন।';
      done.hidden = false;
    }
  }

  // ---------- পুরস্কার ও নিয়ম (তথ্য সবই সার্ভারের সেটিং থেকে) ----------
  function addSection(parent, title, lines) {
    if (!lines.length) return;
    const h = document.createElement('h5');
    h.textContent = title;
    parent.appendChild(h);
    const ul = document.createElement('ul');
    lines.forEach((t) => {
      const li = document.createElement('li');
      li.textContent = t;
      ul.appendChild(li);
    });
    parent.appendChild(ul);
  }

  function renderInfo() {
    const box = $('scInfo');
    const body = $('scInfoBody');
    const pr = status && status.prizes;
    if (!pr) {
      box.hidden = true;
      return;
    }
    body.textContent = '';

    const prizes = [];
    const pts = (pr.points || []).slice().sort((a, b) => a - b);
    if (pts.length) {
      let t = `প্রতিদিন কার্ড খুললে কমপক্ষে ${bn(pts[0])} পয়েন্ট নিশ্চিত।`;
      if (pts.length > 1) t += ` কখনো ${joinBn(pts.slice(1).map(bn))} পয়েন্টও মিলতে পারে।`;
      prizes.push(t);
    }
    const cash = pr.cash || [];
    if (cash.length) prizes.push(`ক্যাশ পুরস্কার জেতার সুযোগ আছে: ${joinBn(cash.map((x) => '৳' + bn(x)))}।`);
    // মেগা: সার্ভার null দিলে (সুইচ বন্ধ / মেগার দিন নেই / বিজয়ী হয়ে গেছে) এই লাইন পুরোপুরি বাদ
    if (pr.mega) prizes.push(`মেগা চমক হিসেবে ৳${bn(pr.mega)} জেতার সুযোগও আছে। যে কেউ হতে পারেন সেই ভাগ্যবান।`);
    const st = pr.streak || [];
    if (st.length) {
      prizes.push(
        `টানা ${joinBn(st.map((s) => bn(s.days)))} দিন কার্ড খুললে অতিরিক্ত ${joinBn(st.map((s) => bn(s.points)))} পয়েন্ট বোনাস।`
      );
    }
    addSection(body, 'কার্ডে কী কী পাওয়া যেতে পারে', prizes);

    const rules = ['প্রতিদিন রাত ১২টায় নতুন কার্ড আসে। আগের দিনের কার্ডের মেয়াদ শেষ হয়ে যায়।', 'একটি ডিভাইসে দিনে একবারই কার্ড খোলা যায়।'];
    if (cash.length || pr.mega) {
      if (Number(pr.min_age_hours) > 0) rules.push(`ক্যাশ পুরস্কারের জন্য অ্যাকাউন্ট কমপক্ষে ${bn(pr.min_age_hours)} ঘণ্টার পুরনো হতে হয়।`);
      rules.push('ক্যাশ জিতলে বিকাশ নম্বর জমা দিতে হয়। যাচাইয়ের পর টাকা পাঠানো হয়।');
    }
    rules.push('১০ পয়েন্টে ৳১। ১,০০০ পয়েন্ট জমলে উইথড্র করা যায়।');
    addSection(body, 'নিয়ম', rules);

    box.hidden = false;
  }

  function setInfoOpen(open) {
    $('scInfoBtn').setAttribute('aria-expanded', open ? 'true' : 'false');
    $('scInfoBody').hidden = !open;
  }
  $('scInfoBtn').addEventListener('click', () => {
    setInfoOpen($('scInfoBtn').getAttribute('aria-expanded') !== 'true');
  });

  // ---------- সাম্প্রতিক ক্যাশ বিজয়ী (পুরো নাম + অংক, সর্বশেষ সবার উপরে) ----------
  async function loadWinners() {
    const wall = $('scWall');
    try {
      const { data, error } = await supabase.rpc('get_scratch_winners');
      if (error || !Array.isArray(data) || !data.length) {
        wall.hidden = true;
        return;
      }
      const list = $('scWallList');
      list.textContent = '';
      data.forEach((x) => {
        const row = document.createElement('div');
        row.className = 'sc-wall-item';
        const name = document.createElement('span');
        name.textContent = x.name;
        const amt = document.createElement('b');
        amt.textContent = `৳${bn(x.amount)}`;
        row.appendChild(name);
        row.appendChild(amt);
        list.appendChild(row);
      });
      wall.hidden = false;
    } catch (e) {
      wall.hidden = true;
    }
  }

  // ---------- শিট খোলা/বন্ধ ----------
  function resetSheet() {
    revealed = false;
    drawing = false;
    moves = 0;
    claimResult = null;
    $('scError').hidden = true;
    $('scGreet').hidden = true;
    $('scPay').hidden = true;
    $('scDone').hidden = true;
    $('scStreak').hidden = true;
    $('scBonus').hidden = true;
    $('scHint').hidden = false;
    $('scFace').classList.remove('is-cash', 'is-error');
    $('scFaceMain').textContent = '…';
    $('scFaceSub').textContent = '';
    canvas.classList.remove('gone');
    setInfoOpen(false);
    drawCover();
  }

  function openSheet() {
    if (!status) return;
    resetSheet();
    // আগের দিনের জেতা কার্ড (বিকাশ নম্বর বাকি) থাকলে সরাসরি ফর্ম
    const win = status.unsubmitted_win;
    const todays = status.card;
    const show = todays && (!win || win.id === todays.id) ? todays : win || todays;
    if (show) {
      card = show;
      revealed = true;
      canvas.classList.add('gone');
      $('scHint').hidden = true;
      renderCard(show, false);
    } else if (!status.active) {
      return;
    } else {
      claimPromise = null;
      renderStreak({ streak_bonus: 0 });
    }
    renderInfo();
    loadWinners();
    overlay.classList.add('open');
  }

  function closeSheet() {
    overlay.classList.remove('open');
  }

  $('scTeaserBtn').addEventListener('click', openSheet);
  $('scClose').addEventListener('click', closeSheet);
  $('scBackdrop').addEventListener('click', closeSheet);

  // মেনু থেকে খোলা: ইভেন্ট (হোমে থাকলে) বা ?scratch=1 (অন্য পেজ থেকে এলে)
  async function openFromMenu() {
    if (!status) await loadStatus();
    openSheet();
  }
  window.addEventListener('smartfeni:open-scratch', openFromMenu);
  try {
    if (new URLSearchParams(location.search).get('scratch') === '1') {
      history.replaceState(null, '', location.pathname);
      openFromMenu();
    }
  } catch (e) { /* ignore */ }

  // শিট খোলা থাকলে চ্যাট বটের আইকন লুকানো (back বাটন/ব্যাকড্রপে বন্ধ হলেও ক্লাস দেখে সিঙ্ক)
  try {
    new MutationObserver(() => {
      document.body.classList.toggle('sc-sheet-open', overlay.classList.contains('open'));
    }).observe(overlay, { attributes: true, attributeFilter: ['class'] });
  } catch (e) { /* ignore */ }

  // ---------- বিকাশ নম্বর জমা ----------
  $('scPaySubmit').addEventListener('click', async () => {
    const btn = $('scPaySubmit');
    const num = String($('scBkash').value || '').trim();
    const link = String($('scPost').value || '').trim();
    if (!/^01[0-9]{9}$/.test(num)) {
      toast('সঠিক বিকাশ নম্বর দিন (১১ সংখ্যা)', 'error');
      return;
    }
    if (link && !/^https?:\/\/\S{4,}$/i.test(link)) {
      toast('পোস্টের সঠিক লিংক দিন', 'error');
      return;
    }
    if (!card) return;
    btn.disabled = true;
    btn.textContent = 'জমা হচ্ছে...';
    try {
      const { error } = await supabase.rpc('submit_scratch_bkash', {
        p_card_id: card.id,
        p_number: num,
        p_post_link: link || null,
      });
      if (error) {
        const raw = String(error.message || '');
        toast(/[\u0980-\u09FF]/.test(raw) ? raw : 'তথ্য জমা দেওয়া যায়নি। আবার চেষ্টা করুন।', 'error');
      } else {
        card.pay_status = 'pending';
        renderPay(card);
        toast('আপনার তথ্য জমা হয়েছে।', 'success');
        loadStatus();
      }
    } catch (e) {
      toast('নেটওয়ার্ক সমস্যা হয়েছে। আবার চেষ্টা করুন।', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'তথ্য জমা দিন';
    }
  });

  // ---------- শুরু ----------
  drawCover();
  loadStatus();
  // মিনিটে একবার কাউন্টডাউন আপডেট; দিন বদলালে (রাত ১২টা) নতুন স্ট্যাটাস
  setInterval(() => {
    if (endTs && Date.now() >= endTs) {
      loadStatus();
    } else if (status && status.active && !status.card && !status.unsubmitted_win) {
      renderTeaser();
    }
  }, 60000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) loadStatus();
  });
  // লগইন/লগআউটে টিজার ঠিক রাখা
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') loadStatus();
  });
</script>
