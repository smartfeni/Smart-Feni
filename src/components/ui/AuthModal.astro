---
// ============================================================
// কম্পোনেন্ট: অথ মোডাল (লগইন / নতুন অ্যাকাউন্ট)
// Supabase Auth-এর সাথে কানেক্টেড — ফোন নাম্বারকে ভেতরে ভেতরে
// ডামি ইমেইলে (phone@smartfeni.local) কনভার্ট করে Supabase Auth
// ব্যবহার করা হচ্ছে, যাতে ইউজারকে ইমেইল টাইপ করতে না হয়।
// প্রোফাইল ছবি এখন সার্ভার-সাইড /api/upload-avatar রুট দিয়ে
// আপলোড হয় (service role key ব্যবহার করে)।
// আপডেট: সাইনআপে ঐচ্ছিক রিকভারি ইমেইল, ব্লাড গ্রুপ, উপজেলা যোগ
// আপডেট ২: ব্লকড ইউজার লগইন করতে পারবে না, সাসপেনশন মেসেজ দেখাবে
// আপডেট ৩: /rider-profile আলাদা রিডাইরেক্ট সরানো হয়েছে — রাইডার
// সেটিংস এখন প্রোফাইল এডিট পেজের ভেতরেই দেখানো হয় (conditional card)
// আপডেট ৪ (বাগফিক্স/সরানো হয়েছে): admin ও shop_owner-এর জন্য
// লগইনের পর auto-redirect সরিয়ে ফেলা হয়েছে — এখন ProfileMenu.astro-তে
// "অ্যাডমিন প্যানেল" / "আমার শপ" বাটন থাকায় ইউজার নিজে ইচ্ছেমতো
// যেতে পারে, জোর করে redirect করার দরকার নেই।
// আপডেট ৫: "পাসওয়ার্ড ভুলে গেছেন?" এখন সত্যিকার ফিচার — ফোন নাম্বার
// দিয়ে /api/forgot-password কল করে, যেটা recovery_email-এ রিসেট
// লিংক পাঠায় (আগে href="#" ছিল, কিছুই হতো না)
// আপডেট ৬: সাইনআপে ইমেইল এখন বাধ্যতামূলক (forgot-password ফিচার
// recovery_email-এর উপর নির্ভরশীল, তাই ইমেইল ছাড়া অ্যাকাউন্ট খুললে
// ভবিষ্যতে পাসওয়ার্ড রিসেট করা যেত না)
// আপডেট ৭ (বাগফিক্স): সাইনআপ ও এডিট পেজ দুই জায়গাতেই ছবি আপলোড
// ব্যর্থ হচ্ছিল ("new row violates row-level security policy" —
// listing-images বাকেটে ইউজারের SELECT পলিসি না থাকায় Storage-এর
// INSERT…RETURNING ফেইল করত (রোলব্যাক টেস্টে কনফার্ম, ২ নভে ২০২৬)।
// এখন client-side supabase.storage.upload() এর বদলে
// সার্ভার-সাইড /api/upload-avatar রুট কল হয় (service role key
// দিয়ে), যেটা ইউজার-RLS বাইপাস করে।
// আপডেট ৮ (ফোন/ইমেইল ডুয়াল লগইন): Supabase Auth-এ প্রকৃত ইমেইল
// সবসময় ফোন থেকে বানানো ডামি ইমেইল (phone@smartfeni.local) —
// recovery_email শুধু profiles টেবিলে টেক্সট হিসেবে থাকত, লগইন
// আইডেন্টিফায়ার হিসেবে কাজ করত না। এখন লগইনে '@' থাকা identifier
// দিলে প্রথমে profiles.recovery_email দিয়ে ফোন নাম্বার লুকআপ করা
// হয় (profiles পাবলিকলি readable বলে সরাসরি ক্লায়েন্ট থেকেই সম্ভব,
// আলাদা সার্ভার এন্ডপয়েন্ট লাগে না), তারপর সেই ফোন থেকে বানানো
// ডামি ইমেইল দিয়ে signInWithPassword কল হয়। একাধিক অ্যাকাউন্টে
// একই ইমেইল থাকলে (পুরনো ডুপ্লিকেট ডেটা) ambiguous এরর দেখিয়ে
// ফোন দিয়ে লগইন করতে বলা হয়। সাইনআপ ও প্রোফাইল-এডিট দুই জায়গাতেই
// নতুন ইমেইল সেভের আগে uniqueness চেক যোগ হয়েছে যাতে নতুন করে আর
// ডুপ্লিকেট তৈরি না হয়।
// আপডেট ৯ (ব্লাড গ্রুপ বাধ্যতামূলক): সাইনআপে ব্লাড গ্রুপ এখন আবশ্যক।
// ড্রপডাউনে আলাদা "ডোনার নই" অপশন নেই — তার বদলে ইমেইল হিন্টের নিচে ও
// ব্লাড গ্রুপ ড্রপডাউনের উপরে একটা টিক বক্স "আমি ব্লাড ডোনার হতে চাই না"।
// টিক দিলে ড্রপডাউন বন্ধ হয়ে যায় (বাধ্যতামূলক নয়) এবং profiles.blood_group-এ
// NOT_DONOR সেভ হয়। NOT_DONOR কোনো রিকোয়েস্ট গ্রুপের সাথে মেলে না।
// আপডেট ১০ (ডোনার ডিফল্ট অন): আসল ব্লাড গ্রুপ বেছে সাইনআপ করলে is_blood_donor=true সেভ হয়।
// ব্লাড গ্রুপ ড্রপডাউনের ঠিক নিচে (এরর মেসেজের পরে) কার্ড-স্টাইল "ডোনার হতে চাই না" বক্স,
// তারপর উপজেলা — দুটো আলাদা সারিতে (আগে পাশাপাশি ছিল)।
// ============================================================

// আপডেট ১১ (রিডিজাইন, ৮ নভে ২০২৬): নিচ থেকে ওঠা শিট; ওপরে ট্যাব+✕ ও নিচে বাটন আটকানো, মাঝে স্ক্রল।
// সাইনআপ ২ ধাপ: (১) ফোন+ইমেইল+পাসওয়ার্ড (২) ছবি+নাম+ব্লাড গ্রুপ+উপজেলা। অ্যাকাউন্ট তৈরি হয় ধাপ ২-এর শেষে
// (signUp → প্রোফাইল আপডেট → applyPendingReferral ক্রম অপরিবর্তিত)। লোগো ও বড় শিরোনাম বাদ।
// আপডেট ১২ (৮ নভে ২০২৬): "ধাপ ১/২" লেবেল ও প্রগ্রেস দাগ বাদ; ধাপ ২-এ উপজেলা আগে, ব্লাড গ্রুপ পরে (আলাদা লাইনে);
// মোডাল খোলা থাকলে চ্যাটবট লুকানো (body.sf-auth-open)।
const bloodGroups = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];

const upazilas = [
  'ফেনী সদর',
  'ছাগলনাইয়া',
  'দাগনভূঞা',
  'পরশুরাম',
  'ফুলগাজী',
  'সোনাগাজী',
];
---

<div class="auth-overlay" id="authOverlay">
  <div class="auth-modal" role="dialog" aria-modal="true" aria-label="লগইন বা নতুন অ্যাকাউন্ট">
    <div class="auth-head">
      <div class="auth-tabs">
        <button class="auth-tab active" data-tab="signup" type="button">নতুন অ্যাকাউন্ট</button>
        <button class="auth-tab" data-tab="login" type="button">লগইন</button>
      </div>
      <button class="auth-close" id="authClose" aria-label="বন্ধ করুন" type="button">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <p class="auth-message" id="authMessage"></p>

    <!-- ===== সাইনআপ প্যানেল (২ ধাপ) ===== -->
    <div class="auth-pane active" id="signupPane">
      <div class="auth-pane-body">
        <!-- ধাপ ১ -->
        <div class="auth-fields" id="signupStep1">
          <div class="auth-field">
            <label class="auth-label" for="signupPhone">ফোন নম্বর<span class="required-mark">*</span></label>
            <input type="tel" inputmode="tel" class="auth-input" id="signupPhone" required placeholder="01XXXXXXXXX" autocomplete="tel" />
            <div class="field-error-msg" data-error-for="signupPhone">
              <i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর দিন</span>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="signupEmail">ইমেইল<span class="required-mark">*</span></label>
            <input type="email" class="auth-input" id="signupEmail" required placeholder="পাসওয়ার্ড রিসেটের জন্য" autocomplete="email" />
            <div class="field-error-msg" data-error-for="signupEmail">
              <i class="fas fa-circle-exclamation"></i><span>ইমেইল দিন</span>
            </div>
            <p class="auth-field-hint">ফোন নম্বর বা এই ইমেইল, যেকোনোটা দিয়ে পরে লগইন করা যাবে</p>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="signupPassword">পাসওয়ার্ড<span class="required-mark">*</span></label>
            <div class="auth-input-wrap auth-pw">
              <input type="password" class="auth-input" id="signupPassword" required placeholder="কমপক্ষে ৬ অক্ষর" autocomplete="new-password" />
              <i class="fas fa-eye auth-input-eye" role="button" aria-label="পাসওয়ার্ড দেখান/লুকান"></i>
            </div>
            <div class="field-error-msg" data-error-for="signupPassword">
              <i class="fas fa-circle-exclamation"></i><span>পাসওয়ার্ড দিন (কমপক্ষে ৬ অক্ষর)</span>
            </div>
          </div>
        </div>

        <!-- ধাপ ২ -->
        <div class="auth-fields" id="signupStep2" hidden>
          <div class="auth-photo-row">
            <label for="photoInput" class="auth-photo-circle" id="photoPreviewCircle">
              <img id="photoPreviewImg" src="" alt="প্রোফাইল ছবি" />
              <i class="fas fa-camera" id="photoPlaceholderIcon"></i>
            </label>
            <input type="file" id="photoInput" accept="image/*" style="display:none;" />
            <div class="auth-photo-text"><b>প্রোফাইল ছবি</b><span>ঐচ্ছিক, পরেও দেওয়া যাবে</span></div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="signupName">পূর্ণ নাম<span class="required-mark">*</span></label>
            <input type="text" class="auth-input" id="signupName" required placeholder="আপনার পূর্ণ নাম" autocomplete="name" />
            <div class="field-error-msg" data-error-for="signupName">
              <i class="fas fa-circle-exclamation"></i><span>পূর্ণ নাম দিন</span>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="signupUpazila">উপজেলা</label>
            <select class="auth-input auth-select" id="signupUpazila">
              <option value="">বাছুন</option>
              {upazilas.map((u) => <option value={u}>{u}</option>)}
            </select>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="signupBloodGroup">ব্লাড গ্রুপ<span class="required-mark" id="signupBloodStar">*</span></label>
            <select class="auth-input auth-select" id="signupBloodGroup" required>
              <option value="" disabled selected>বাছুন</option>
              {bloodGroups.map((bg) => <option value={bg}>{bg}</option>)}
            </select>
            <div class="field-error-msg" data-error-for="signupBloodGroup">
              <i class="fas fa-circle-exclamation"></i><span>ব্লাড গ্রুপ বাছুন</span>
            </div>
          </div>

          <label class="auth-optout-card" for="signupNotDonor">
            <input type="checkbox" id="signupNotDonor" class="auth-optout-input" />
            <span class="auth-optout-title">আমি ব্লাড ডোনার হতে চাই না</span>
          </label>
          <p class="auth-field-hint">রক্তের প্রয়োজনে আপনার নাম ও ফোন নম্বর রিকোয়েস্টকারীকে দেখানো হতে পারে</p>
        </div>
      </div>

      <div class="auth-pane-foot">
        <button class="auth-submit" id="signupNext" type="button">
          <span class="auth-submit-text">পরের ধাপ</span> <i class="fas fa-arrow-right"></i>
        </button>
        <div class="auth-foot-row" id="signupStep2Actions" hidden>
          <button class="auth-back" id="signupBack" type="button" aria-label="আগের ধাপে ফিরুন">
            <i class="fas fa-arrow-left"></i>
          </button>
          <button class="auth-submit" id="signupSubmit" type="button">
            <span class="auth-submit-text">অ্যাকাউন্ট তৈরি করুন</span>
          </button>
        </div>
        <div class="auth-swap">
          অ্যাকাউন্ট আছে? <button class="auth-link" data-tab="login" type="button">লগইন করুন</button>
        </div>
      </div>
    </div>

    <!-- ===== লগইন প্যানেল ===== -->
    <div class="auth-pane" id="loginPane">
      <div class="auth-pane-body">
        <div class="auth-fields">
          <div class="auth-field">
            <label class="auth-label" for="loginIdentifier">ফোন নম্বর বা ইমেইল<span class="required-mark">*</span></label>
            <input type="text" class="auth-input" id="loginIdentifier" required placeholder="01XXXXXXXXX অথবা ইমেইল" autocomplete="username" />
            <div class="field-error-msg" data-error-for="loginIdentifier">
              <i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর বা ইমেইল দিন</span>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="loginPassword">পাসওয়ার্ড<span class="required-mark">*</span></label>
            <div class="auth-input-wrap auth-pw">
              <input type="password" class="auth-input" id="loginPassword" required placeholder="পাসওয়ার্ড" autocomplete="current-password" />
              <i class="fas fa-eye auth-input-eye" role="button" aria-label="পাসওয়ার্ড দেখান/লুকান"></i>
            </div>
            <div class="field-error-msg" data-error-for="loginPassword">
              <i class="fas fa-circle-exclamation"></i><span>পাসওয়ার্ড দিন</span>
            </div>
          </div>

          <button class="auth-forgot" id="openForgotPane" type="button">পাসওয়ার্ড ভুলে গেছেন?</button>
        </div>
      </div>

      <div class="auth-pane-foot">
        <button class="auth-submit" id="loginSubmit" type="button">
          <span class="auth-submit-text">লগইন করুন</span>
        </button>
        <div class="auth-swap">
          নতুন এখানে? <button class="auth-link" data-tab="signup" type="button">অ্যাকাউন্ট খুলুন</button>
        </div>
      </div>
    </div>

    <!-- ===== পাসওয়ার্ড ভুলে গেছেন প্যানেল ===== -->
    <div class="auth-pane" id="forgotPane">
      <div class="auth-pane-body">
        <div class="auth-fields">
          <div>
            <h2 class="auth-title">পাসওয়ার্ড ভুলে গেছেন?</h2>
            <p class="auth-subtitle">ফোন নম্বর দিন, রিকভারি ইমেইলে রিসেট লিংক যাবে</p>
          </div>
          <div class="auth-field">
            <label class="auth-label" for="forgotPhone">ফোন নম্বর<span class="required-mark">*</span></label>
            <input type="tel" inputmode="numeric" class="auth-input" id="forgotPhone" required placeholder="01XXXXXXXXX" />
            <div class="field-error-msg" data-error-for="forgotPhone">
              <i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর দিন</span>
            </div>
          </div>
        </div>
      </div>

      <div class="auth-pane-foot">
        <button class="auth-submit" id="forgotSubmit" type="button">
          <span class="auth-submit-text">রিসেট লিংক পাঠান</span>
        </button>
        <div class="auth-swap">
          মনে পড়েছে? <button class="auth-link" id="backToLoginFromForgot" type="button">লগইনে ফিরুন</button>
        </div>
      </div>
    </div>

    <!-- ===== ডিলিটের অপেক্ষায় থাকা অ্যাকাউন্ট — ফিরিয়ে আনার প্যানেল ===== -->
    <div class="auth-pane" id="restorePane">
      <div class="auth-pane-body">
        <div class="auth-fields">
          <div>
            <h2 class="auth-title">অ্যাকাউন্ট ডিলিটের অপেক্ষায়</h2>
            <p class="auth-subtitle" id="restoreInfo"></p>
          </div>
        </div>
      </div>

      <div class="auth-pane-foot">
        <button class="auth-submit" id="restoreConfirm" type="button">
          <span class="auth-submit-text">অ্যাকাউন্ট ফিরিয়ে আনুন</span>
        </button>
        <div class="auth-swap">
          <button class="auth-link" id="restoreDecline" type="button">না, ডিলিটই থাক (লগআউট)</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* রিডিজাইন ৮ নভে ২০২৬: শিট লেআউট — head ও foot আটকানো, শুধু .auth-pane-body স্ক্রল */
  .auth-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 2000;
    align-items: flex-end;
    justify-content: center;
  }

  .auth-overlay.open {
    display: flex;
  }

  /* অথ মোডাল খোলা থাকলে চ্যাটবট লুকানো (চ্যাটবটের z-index বেশি, ফর্মের উপরে চলে আসত) */
  :global(body.sf-auth-open #sf-chat-root) {
    display: none !important;
  }

  .auth-modal {
    position: relative;
    display: flex;
