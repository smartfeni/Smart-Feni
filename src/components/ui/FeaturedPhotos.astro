---
// ============================================================
// কম্পোনেন্ট: ফিচার্ড ফটো স্লাইডশো
// featured_photos টেবিল থেকে ক্রমানুসারে ছবি এনে প্রতিটা ছবির নিজস্ব সময়ে (display_seconds, অ্যাডমিন ঠিক করে)
// ডান দিক থেকে স্লাইড করে বদলায়; ইউজার বাঁ/ডানে সোয়াইপও করতে পারে।
// কোনো ছবি না থাকলে fallback static ছবি দেখায়।
// বাগফিক্স: আগে define:vars + dynamic import ব্যবহার হচ্ছিল যা Astro/Vite
// bundle করে না, ফলে import silently fail করছিল — এখন static import
//
// পারফরম্যান্স ফিক্স (Aug 2026): এই ছবিটাই হোমপেজের LCP (Largest
// Contentful Paint) এলিমেন্ট — সার্চ বারের ঠিক নিচেই প্রথম দেখা যায়।
// আগে loading="lazy" থাকায় ব্রাউজার ইচ্ছাকৃত দেরি করছিল, যা PageSpeed
// রিপোর্টে LCP 6.9s দেখাচ্ছিল। তাই এখন eager + fetchpriority="high"।
//
// নতুন (Oct 2026) — ট্যাপযোগ্য ছবি: পুরো ছবিটাই বাটন। আলাদা কোনো
// CTA বাটন/টেক্সট/আইকন নেই — "ট্যাপ করুন" নির্দেশনা ছবির আর্টওয়ার্কেই
// থাকবে। প্রতিটা ছবির link_type / link_url (featured_photos টেবিল):
//   • none   → ট্যাপ করলে কিছু হয় না (আগের মতো)
//   • page   → পেজে যায় (যেমন /become-a-shop-owner,
//              /services/housing?openListing=1 — লিস্টিং ফর্ম সহ খোলে)
//   • action → ইন-পেজ অ্যাকশন: post-flow | category-drawer |
//              auth-login | auth-signup
// সেফটি: page হলে শুধু "/" দিয়ে শুরু (// ছাড়া) বা https:// লিংক, অ্যাকশন
// শুধু ফিক্সড তালিকা থেকে। ডেটাবেজেও একই CHECK constraint আছে।
// স্লাইড বদলালে কার্ডের লিংকও সাথে সাথে বদলে যায়।
// ============================================================

import { supabase } from '../../lib/supabase.js';

const fallbackSrc = '/featured/featured-photo.jpg';

// পারফরম্যান্স: প্রথম ফিচার্ড ছবির URL সার্ভারেই বের করে HTML-এ বসানো হচ্ছে,
// যাতে ব্রাউজার ছবিটা সাথে সাথে ডাউনলোড শুরু করে (আগে ফ্যালব্যাক নামত, তারপর JS
// চলে আসল ছবি আনত = দুইবার ডাউনলোড + দেরি)। ব্যর্থ হলে ফ্যালব্যাকই থাকবে।
let firstSrc = fallbackSrc;
try {
  const { data: firstRow } = await supabase
    .from('featured_photos')
    .select('storage_path')
    .order('sort_order', { ascending: true })
    .limit(1)
    .maybeSingle();
  if (firstRow?.storage_path) {
    firstSrc = supabase.storage.from('listing-images').getPublicUrl(firstRow.storage_path).data.publicUrl;
  }
} catch (e) {
  // fallback ছবিই থাকবে
}
---

<section class="featured-photo-section">
  <div class="container">
    <a class="photo-card" data-photo-card>
      <img
        class="photo-layer photo-base"
        src={firstSrc}
        alt="স্মার্ট ফেনী কমিউনিটি ফটো"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <img class="photo-layer photo-slide" data-slide-a alt="" loading="eager" />
      <img class="photo-layer photo-slide" data-slide-b alt="" loading="eager" />
    </a>
  </div>
</section>

<style>
  .featured-photo-section {
    padding: 24px 0 40px;
    background: transparent;
  }

  .photo-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    overflow: hidden;
    background: #F4F7FC;
    box-shadow: 0 16px 40px rgba(27, 42, 74, 0.14), 0 0 0 1px rgba(255, 107, 53, 0.08);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: pan-y;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  /* শুধু লিংক থাকা ছবিতে — কোনো ওভারলে/বাটন নেই, শুধু tap/hover অনুভূতি */
  .photo-card.tappable {
    cursor: pointer;
  }

  .photo-card.tappable:active {
    transform: scale(0.985);
    box-shadow: 0 8px 22px rgba(27, 42, 74, 0.16), 0 0 0 2px rgba(255, 107, 53, 0.28);
  }

  .photo-card.tappable:focus-visible {
    outline: 3px solid #FF6B35;
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .photo-card.tappable:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 46px rgba(27, 42, 74, 0.18), 0 0 0 1px rgba(255, 107, 53, 0.22);
    }
    .photo-card.tappable:active {
      transform: scale(0.985);
    }
  }

  .photo-layer {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
  }

  .photo-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translate3d(100%, 0, 0);
    will-change: transform;
  }

  @media (max-width: 480px) {
    .photo-card {
      border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card,
    .photo-slide {
      transition: none;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { trackEvent } from '../../lib/analytics.js';

  const SLIDE_INTERVAL_MS = 10000;
  const ALLOWED_ACTIONS = ['post-flow', 'category-drawer', 'auth-login', 'auth-signup'];

  // ডেটাবেজের CHECK constraint-এর পাশাপাশি ক্লায়েন্টেও যাচাই — ভুল/অনিরাপদ
  // লিংক থাকলে ছবিটা আর ট্যাপযোগ্য থাকে না (সাধারণ ছবি হিসেবেই দেখায়)
  function normalizeLink(type, url) {
    if (!url || typeof url !== 'string') return null;
    const value = url.trim();

    if (type === 'page') {
      const isInternal = value.startsWith('/') && !value.startsWith('//') && !value.includes('\\');
      const isHttps = /^https:\/\/[^\s]+$/i.test(value);
      if (isInternal || isHttps) return { type: 'page', url: value };
      return null;
    }

    if (type === 'action' && ALLOWED_ACTIONS.includes(value)) {
      return { type: 'action', url: value };
    }

    return null;
  }

  // ফিচার্ড ছবিতে ক্লিক গোনা: events টেবিলে 'featured_click' (meta: photo_id, link_type, link_url)।
  // পেজ বদলে গেলেও রিকোয়েস্ট যাতে বাতিল না হয় তাই keepalive fetch; ব্যর্থ হলে সাধারণ trackEvent।
  function trackFeaturedClick(photoId, link) {
    if (!photoId || !link) return;
    const params = { photo_id: photoId, link_type: link.type, link_url: link.url };
    try {
      if (typeof window.gtag === 'function') window.gtag('event', 'featured_click', params);
    } catch (_) {}
    try {
      const base = supabase.supabaseUrl;
      const key = supabase.supabaseKey;
      if (base && key) {
        fetch(base + '/rest/v1/events', {
          method: 'POST',
          keepalive: true,
          headers: {
            apikey: key,
            Authorization: 'Bearer ' + key,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({ event_name: 'featured_click', upazila: null, category: null, meta: params }),
        }).catch(() => {});
        return;
      }
    } catch (_) {}
    trackEvent('featured_click', params);
  }

  async function runAction(action) {
    if (action === 'post-flow') {
      window.dispatchEvent(new CustomEvent('smartfeni:open-post-flow'));
      return;
    }

    if (action === 'category-drawer') {
      window.dispatchEvent(new CustomEvent('smartfeni:open-category-drawer'));
      return;
    }

    if (action === 'auth-login' || action === 'auth-signup') {
      // ইউজার আগে থেকেই লগইন থাকলে লগইন/সাইনআপ মোডাল খোলার দরকার নেই
      const { data: { session } } = await supabase.auth.getSession();
      if (session) return;
      window.openAuthModal?.(action === 'auth-signup' ? 'signup' : 'login');
    }
  }

  async function initSlideshow() {
    const BUCKET = 'listing-images';
    const card = document.querySelector('[data-photo-card]');
    const layerA = document.querySelector('[data-slide-a]');
    const layerB = document.querySelector('[data-slide-b]');
    if (!card || !layerA || !layerB) return;

    const { data: photos, error } = await supabase
      .from('featured_photos')
      .select('id, storage_path, link_type, link_url, display_seconds')
      .order('sort_order', { ascending: true });

    if (error || !photos || photos.length === 0) return; // fallback ছবিই থাকবে

    const urls = photos.map((p) => supabase.storage.from(BUCKET).getPublicUrl(p.storage_path).data.publicUrl);
    const links = photos.map((p) => normalizeLink(p.link_type, p.link_url));
    const ids = photos.map((p) => p.id);
    // প্রতিটা ছবি কত মিলিসেকেন্ড দেখাবে (অ্যাডমিন ঠিক করে, ৩–৬০ সেকেন্ড; ভুল হলে ডিফল্ট)
    const durations = photos.map((p) => {
      const s = Number(p.display_seconds);
      return (Number.isFinite(s) && s >= 3 && s <= 60 ? s : SLIDE_INTERVAL_MS / 1000) * 1000;
    });

    let currentIndex = 0;
    let activeLayer = layerA;
    let inactiveLayer = layerB;
    let currentLink = null;
    let suppressClick = false; // সোয়াইপের পর ভুলে লিংক খুলে যাওয়া ঠেকাতে

    // কার্ডের বর্তমান লিংক সেট — লিংক থাকলে পুরো কার্ডই ট্যাপযোগ্য
    function applyLink(link) {
      currentLink = link;

      if (!link) {
        card.classList.remove('tappable');
        card.removeAttribute('href');
        card.removeAttribute('target');
        card.removeAttribute('rel');
        card.removeAttribute('role');
        card.removeAttribute('tabindex');
        card.removeAttribute('aria-label');
        return;
      }

      card.classList.add('tappable');
      card.setAttribute('aria-label', 'বিস্তারিত দেখতে ট্যাপ করুন');

      if (link.type === 'page') {
        card.setAttribute('href', link.url);
        card.removeAttribute('role');
        card.removeAttribute('tabindex');
        const isExternal = /^https:\/\//i.test(link.url) && !link.url.startsWith(window.location.origin);
        // নেটিভ অ্যাপে (Capacitor) বাইরের হোস্টের লিংক নিজেই ফোনের ব্রাউজার/
        // ফেসবুক অ্যাপে খোলে (Footer-এর লিংকের মতোই), তাই target=_blank দেওয়া
        // হয় না। শুধু ওয়েবসাইটে নতুন ট্যাবে খোলে।
        const isNative = !!window.Capacitor?.isNativePlatform?.();
        if (isExternal && !isNative) {
          card.setAttribute('target', '_blank');
          card.setAttribute('rel', 'noopener noreferrer');
        } else if (isExternal) {
          card.removeAttribute('target');
          card.setAttribute('rel', 'noopener noreferrer');
        } else {
          card.removeAttribute('target');
          card.removeAttribute('rel');
        }
      } else {
        // অ্যাকশন — href নেই, তাই কীবোর্ড/স্ক্রিন রিডারের জন্য role + tabindex
        card.removeAttribute('href');
        card.removeAttribute('target');
        card.removeAttribute('rel');
        card.setAttribute('role', 'button');
        card.setAttribute('tabindex', '0');
      }
    }

    card.addEventListener('click', (e) => {
      if (suppressClick) {
        e.preventDefault();
        return;
      }
      if (!currentLink) {
        e.preventDefault();
        return;
      }
      trackFeaturedClick(ids[currentIndex], currentLink);
      if (currentLink.type === 'action') {
        e.preventDefault();
        runAction(currentLink.url);
      }
      // page হলে ব্রাউজার নিজেই href-এ নিয়ে যাবে
    });

    card.addEventListener('keydown', (e) => {
      if (currentLink?.type === 'action' && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        trackFeaturedClick(ids[currentIndex], currentLink);
        runAction(currentLink.url);
      }
    });

    function preload(url) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve();
        img.onerror = () => resolve();
        img.src = url;
      });
    }

    // প্রথম ছবি সরাসরি দেখানো
    await preload(urls[0]);
    activeLayer.src = urls[0];
    activeLayer.style.opacity = '1';
    activeLayer.style.transform = 'translate3d(0, 0, 0)';
    applyLink(links[0]);

    if (urls.length <= 1) return; // একটাই ছবি হলে স্লাইডশো লাগবে না

    // ===== স্লাইড + সোয়াইপ =====
    // অটো বদল: পরের ছবি ডান দিক থেকে ঢোকে। আঙুল বাঁয়ে টানলে পরের, ডানে টানলে আগের ছবি।
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SLIDE_MS = reduceMotion ? 0 : 450;
    const SWIPE_MIN_PX = 50;
    const SWIPE_MIN_RATIO = 0.2;
    let animating = false;
    let timer = null;
    let drag = null;

    function setPos(layer, px, withTransition) {
      layer.style.transition = withTransition
        ? `transform ${SLIDE_MS}ms cubic-bezier(0.22, 0.61, 0.36, 1)`
        : 'none';
      layer.style.transform = `translate3d(${px}px, 0, 0)`;
    }

    function warmNeighbors() {
      preload(urls[(currentIndex + 1) % urls.length]);
      preload(urls[(currentIndex - 1 + urls.length) % urls.length]);
    }

    function clearTimer() {
      if (timer) {
        clearTimeout(timer);
        timer = null;
      }
    }

    // বর্তমান ছবির নিজস্ব সময় পার হলে পরের ছবি
    function schedule() {
      clearTimer();
      if (urls.length <= 1 || document.hidden) return;
      timer = setTimeout(() => {
        timer = null;
        if (drag && drag.locked) {
          schedule();
          return;
        }
        slideTo(1);
      }, durations[currentIndex]);
    }

    async function slideTo(dir, dragDx = 0) {
      if (animating) return;
      animating = true;
      clearTimer();

      const nextIndex = (currentIndex + dir + urls.length) % urls.length;
      await preload(urls[nextIndex]);

      const w = card.clientWidth || 1;
      const incoming = inactiveLayer;
      const outgoing = activeLayer;

      if (incoming.getAttribute('src') !== urls[nextIndex]) incoming.src = urls[nextIndex];
      incoming.style.opacity = '1';
      setPos(outgoing, dragDx, false);
      setPos(incoming, dir * w + dragDx, false);
      void incoming.offsetWidth; // শুরুর অবস্থান বসিয়ে তারপর অ্যানিমেশন
      setPos(outgoing, -dir * w, true);
      setPos(incoming, 0, true);

      currentIndex = nextIndex;
      activeLayer = incoming;
      inactiveLayer = outgoing;
      applyLink(links[currentIndex]);
      warmNeighbors();

      setTimeout(() => {
        outgoing.style.opacity = '0';
        setPos(outgoing, w, false);
        animating = false;
        schedule();
      }, SLIDE_MS + 30);
    }

    // টানার সময় পাশের ছবি তৈরি রাখা (দিক বদলালে আবার)
    function prepNeighbor(dir) {
      if (drag.dir === dir) return;
      drag.dir = dir;
      const idx = (currentIndex + dir + urls.length) % urls.length;
      inactiveLayer.src = urls[idx];
      inactiveLayer.style.opacity = '1';
    }

    // যথেষ্ট টানা হয়নি — ছবি আগের জায়গায় ফিরে যায়
    function snapBack(dir) {
      animating = true;
      const w = card.clientWidth || 1;
      const neighbor = inactiveLayer;
      setPos(activeLayer, 0, true);
      setPos(neighbor, dir * w, true);
      setTimeout(() => {
        neighbor.style.opacity = '0';
        setPos(neighbor, w, false);
        animating = false;
        schedule();
      }, SLIDE_MS + 30);
    }

    function endDrag(e, cancelled) {
      if (!drag || e.pointerId !== drag.id) return;
      const d = drag;
      drag = null;
      card.classList.remove('dragging');
      if (!d.locked) return; // সাধারণ ট্যাপ — লিংক নিজের মতো কাজ করবে

      try { card.releasePointerCapture(e.pointerId); } catch (_) {}
      suppressClick = true;
      setTimeout(() => { suppressClick = false; }, 350);

      const w = card.clientWidth || 1;
      const passed = !cancelled && Math.abs(d.dx) > Math.max(SWIPE_MIN_PX, w * SWIPE_MIN_RATIO);
      if (passed) {
        slideTo(d.dx < 0 ? 1 : -1, d.dx);
      } else {
        snapBack(d.dir || (d.dx < 0 ? 1 : -1));
      }
    }

    card.addEventListener('pointerdown', (e) => {
      if (animating) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, dx: 0, dir: 0, locked: false };
    });

    card.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (animating) {
        drag = null;
        return;
      }
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;

      if (!drag.locked) {
        // উপর-নিচ টান হলে পেজ স্ক্রল করুক, আমরা ছেড়ে দিই
        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) {
          drag = null;
          return;
        }
        if (Math.abs(dx) < 8) return;
        drag.locked = true;
        clearTimer();
        try { card.setPointerCapture(e.pointerId); } catch (_) {}
        card.classList.add('dragging');
      }

      drag.dx = dx;
      const dir = dx < 0 ? 1 : -1;
      prepNeighbor(dir);
      const w = card.clientWidth || 1;
      setPos(activeLayer, dx, false);
      setPos(inactiveLayer, dir * w + dx, false);
    });

    card.addEventListener('pointerup', (e) => endDrag(e, false));
    card.addEventListener('pointercancel', (e) => endDrag(e, true));
    card.addEventListener('dragstart', (e) => e.preventDefault());

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearTimer();
      } else if (!animating && !(drag && drag.locked)) {
        schedule();
      }
    });

    warmNeighbors();
    schedule();
  }

  initSlideshow();
</script>
