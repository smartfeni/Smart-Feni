---
// ============================================================
// Skeleton — শেয়ার্ড স্কেলেটন (সার্ভার-রেন্ডার ভার্সন)
// স্টাইল আসে src/styles/sf-skeleton.css থেকে (BaseLayout-এ ইমপোর্ট করা)।
// মার্কআপ src/lib/sfSkeleton.js-এর skeletonMarkup() থেকে, তাই JS ভার্সনের সাথে হুবহু এক।
//
// ব্যবহার (ডাটা যে কন্টেইনারে বসবে তার ভেতরে):
//   <div id="list"><Skeleton preset="listing" count={4} /></div>
//   পরে JS-এ list.innerHTML = আসল কার্ড  -> স্কেলেটন নিজেই চলে যায়।
//
// প্রিসেট: card, listing, row, donor, doctor, order, profile, grid, table
// ============================================================
import { skeletonMarkup } from '../../lib/sfSkeleton.js';

interface Props {
  preset?: 'card' | 'listing' | 'row' | 'donor' | 'doctor' | 'order' | 'profile' | 'grid' | 'table';
  count?: number;
  label?: string;
}

const { preset = 'card', count = 3, label = 'লোড হচ্ছে' } = Astro.props;
---

<Fragment set:html={skeletonMarkup(preset, count, label)} />
