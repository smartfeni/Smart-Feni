---
// ============================================================
// কম্পোনেন্ট: নতুন লিস্টিং যোগ করার মোডাল (রিইউজেবল)
// প্রতিটা ক্যাটাগরি পেজ থেকে <AddListingModal category="repair" typeOptions={...} />
// আকারে কল হবে। লগইন করা না থাকলে প্রথমে AuthModal খুলবে।
// titleLabel/priceLabel দিয়ে লেবেল কাস্টমাইজ করা যাবে (যেমন job এ "পদবী"/"বেতন")
// companyLabel দিলে একটা এক্সট্রা ইনপুট দেখাবে, যেটা সাবমিটের সময় description এর শুরুতে জুড়ে যাবে
// নতুন: openListingModal('tutor') এর মতো প্যারামিটার দিলে "সার্ভিসের ধরন"
// ড্রপডাউনে সেই ভ্যালু আগে থেকেই সিলেক্ট করা থাকবে (tuition পেজের ২টা CTA-র জন্য)
// নতুন: autoActive={true} দিলে সাবমিটের সময় সরাসরি status='active' হয়ে যাবে
// (এডমিন approve লাগবে না) — শুধু ভেরিফাইড ইউজার (যেমন শপ ওউনার) এর জন্য
// আপডেট: ক্লাব ওনার একাউন্ট থেকে লিস্টিং পোস্ট করা ব্লক করা হয়েছে —
// ক্লাব ওনার শুধু "আমার ক্লাব" থেকে ক্লাবের পোস্ট দিতে পারবে, সাধারণ
// লিস্টিং সিস্টেমে না (রিড-অনলি ইউজার হিসেবে থাকবে)
// আপডেট: ছবি আপলোড প্রিভিউ এখন Instagram/Urban Company স্টাইল ছোট
// স্কয়ার ড্রপবক্স গ্রিড — প্রথমে শুধু ➕ বক্স, ছবি সিলেক্ট করলে পাশে
// থাম্বনেইল + রিমুভ বাটন, পাশে সবসময় আরেকটা ➕ বক্স (আরও ছবি যোগ করতে)
// নতুন: typeOptions এ id="other" থাকলে সিলেক্ট করার সাথে সাথে একটা
// এক্সট্রা টেক্সট ইনপুট দেখাবে ("নতুন ক্যাটাগরির নাম লিখুন")। সাবমিটের
// সময় সেই কাস্টম টেক্সটটাই আসল `type` ভ্যালু হিসেবে সেভ হয় (literal
// "other" স্ট্রিং না) — তাই ডিসপ্লে/ব্যাজ/সার্চ কোথাও এক্সট্রা কোড
// ছাড়াই স্বয়ংক্রিয়ভাবে কাজ করে (fallback: typeNameMap[item.type] || item.type)
// ============================================================

export interface Props {
  category: string;
  typeOptions: { id: string; label: string }[];
  titleLabel?: string;
  priceLabel?: string;
  companyLabel?: string;
  autoActive?: boolean;
}

const {
  category,
  typeOptions,
  titleLabel = 'টাইটেল',
  priceLabel = 'দাম / রেট',
  companyLabel,
  autoActive = false,
} = Astro.props;

const upazilas = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];
---

<div class="listing-overlay" id="listingOverlay" data-category={category} data-company-label={companyLabel || ''} data-auto-active={autoActive ? '1' : ''}>
  <div class="listing-modal">
    <button class="listing-close" id="listingClose" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <h2 class="listing-title"><i class="fas fa-plus-circle"></i> নতুন লিস্টিং যোগ করুন</h2>
    <p class="listing-subtitle">তথ্য পূরণ করুন, সবাই দেখতে পাবে</p>

    <p class="listing-message" id="listingMessage"></p>

    <label class="listing-label">সার্ভিসের ধরন</label>
    <select class="listing-input" id="listingType">
      {typeOptions.map((t) => (
        <option value={t.id}>{t.label}</option>
      ))}
    </select>

    <div class="listing-custom-type-wrap" id="listingCustomTypeWrap" style="display:none;">
      <label class="listing-label">নতুন ক্যাটাগরির নাম লিখুন</label>
      <input type="text" class="listing-input" id="listingCustomType" placeholder="যেমন: থাই গ্লাস মিস্ত্রি" />
    </div>

    {companyLabel && (
      <>
        <label class="listing-label">{companyLabel}</label>
        <input type="text" class="listing-input" id="listingCompany" placeholder="" />
      </>
    )}

    <label class="listing-label">{titleLabel}</label>
    <input type="text" class="listing-input" id="listingTitle" placeholder="" />

    <label class="listing-label">বিবরণ (ঐচ্ছিক)</label>
    <textarea class="listing-input" id="listingDescription" rows="3" placeholder=""></textarea>

    <label class="listing-label">{priceLabel}</label>
    <input type="text" class="listing-input" id="listingPrice" placeholder="" />

    <label class="listing-label">উপজেলা</label>
    <select class="listing-input" id="listingUpazila">
      {upazilas.map((u) => (
        <option value={u}>{u}</option>
      ))}
    </select>

    <label class="listing-label">যোগাযোগ নাম্বার</label>
    <input type="text" class="listing-input" id="listingPhone" placeholder="01xxxxxxxxx" />

    <label class="listing-label">ছবি (ঐচ্ছিক, একাধিক দেওয়া যাবে)</label>
    <input type="file" id="listingImages" accept="image/*" multiple hidden />
    <div class="listing-image-grid" id="listingImageGrid"></div>

    <button class="listing-submit" id="listingSubmit" type="button">
      <i class="fas fa-check"></i> <span class="listing-submit-text">লিস্টিং পোস্ট করুন</span>
    </button>
  </div>
</div>

<style>
  .listing-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  .listing-overlay.open {
    display: flex;
  }

  .listing-modal {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 460px;
    border-radius: 28px;
    padding: 36px 32px 28px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    margin: auto;
    max-height: 90vh;
    overflow-y: auto;
  }

  .listing-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #5A6E85;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .listing-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .listing-title {
    font-size: 1.3rem;
    color: #1B2A4A;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .listing-title i {
    color: #FF6B35;
  }

  .listing-subtitle {
    color: #8FA0BC;
    font-size: 0.85rem;
    margin-bottom: 18px;
  }

  .listing-message {
    display: none;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 12px;
    margin-bottom: 12px;
    text-align: center;
  }

  .listing-message.show-error {
    display: block;
    background: #FFF0EA;
    color: #D14343;
  }

  .listing-message.show-success {
    display: block;
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .listing-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #1B2A4A;
    margin-bottom: 6px;
    margin-top: 14px;
  }

  .listing-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1.5px solid #E5EAF0;
    font-size: 0.9rem;
    font-family: inherit;
    color: #1B2A4A;
    background: #FBFCFE;
  }

  .listing-input:focus {
    outline: none;
    border-color: #FF6B35;
    background: #fff;
  }

  textarea.listing-input {
    resize: vertical;
  }

  .listing-submit {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    margin-top: 22px;
    box-shadow: 0 10px 24px rgba(255, 107, 53, 0.28);
  }

  .listing-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .listing-modal {
      padding: 28px 22px 22px;
      border-radius: 22px;
    }
  }
</style>

<style is:global>
  /* ছবি আপলোড গ্রিড — JS দিয়ে dynamically তৈরি হওয়ায় এই স্টাইলগুলো
     গ্লোবাল রাখা হয়েছে (Astro scoped CSS dynamically তৈরি এলিমেন্টে বসে না) */
  .listing-image-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .listing-image-box {
    width: 72px;
    height: 72px;
    border-radius: 14px;
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
  }

  .listing-image-box.add-box {
    border: 1.5px dashed #D8E0EA;
    background: #FBFCFE;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8FA0BC;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .listing-image-box.add-box:hover {
    border-color: #FF6B35;
    color: #FF6B35;
    background: #FFF7F3;
  }

  .listing-image-box.thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 1px solid #E5EAF0;
    border-radius: 14px;
  }

  .listing-image-remove-btn {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    color: #fff;
    border: none;
    font-size: 0.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .listing-image-remove-btn:hover {
    background: #D14343;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const overlay = document.getElementById('listingOverlay');
  const closeBtn = document.getElementById('listingClose');
  const messageEl = document.getElementById('listingMessage');
  const submitBtn = document.getElementById('listingSubmit');
  const typeSelect = document.getElementById('listingType');
  const customTypeWrap = document.getElementById('listingCustomTypeWrap');
  const customTypeInput = document.getElementById('listingCustomType');
  const category = overlay?.dataset.category || '';
  const companyLabel = overlay?.dataset.companyLabel || '';
  const autoActive = overlay?.dataset.autoActive === '1';

  // "অন্যান্য" সিলেক্ট করলে কাস্টম-টাইপ ইনপুট বক্স দেখানো/লুকানো
  function toggleCustomType() {
    const isOther = typeSelect?.value === 'other';
    if (customTypeWrap) customTypeWrap.style.display = isOther ? 'block' : 'none';
    if (!isOther && customTypeInput) customTypeInput.value = '';
  }
  typeSelect?.addEventListener('change', toggleCustomType);

  // presetType দিলে "সার্ভিসের ধরন" ড্রপডাউনে সেই ভ্যালু আগে থেকেই সিলেক্ট থাকবে
  async function openListingModal(presetType) {
    clearMessage();

    // ক্লাব ওনার একাউন্ট থেকে লিস্টিং দেওয়া ব্লক — শুধু ক্লাব ম্যানেজ
    // করতে পারবে, বাকি সবকিছু read-only/সেবা নেওয়ার জন্য
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('is_club_owner')
        .eq('id', session.user.id)
        .single();

      if (profile?.is_club_owner) {
        alert('ক্লাব একাউন্ট থেকে লিস্টিং পোস্ট করা যায় না। শুধু "আমার ক্লাব" থেকে ক্লাবের পোস্ট/অর্জন যোগ করা যাবে।');
        return;
      }
    }

    if (presetType && typeSelect) {
      typeSelect.value = presetType;
    }
    toggleCustomType();
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeListingModal() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  function showMessage(text, type = 'error') {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.className = `listing-message ${type === 'error' ? 'show-error' : 'show-success'}`;
  }

  function clearMessage() {
    if (!messageEl) return;
    messageEl.textContent = '';
    messageEl.className = 'listing-message';
  }

  closeBtn?.addEventListener('click', closeListingModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeListingModal();
  });

  // ছবি আপলোড — ছোট স্কয়ার ড্রপবক্স গ্রিড (থাম্বনেইল + সবসময় একটা ➕ বক্স)
  const imagesInput = document.getElementById('listingImages');
  const imageGrid = document.getElementById('listingImageGrid');
  let selectedFiles = [];

  function renderImageGrid() {
    imageGrid.innerHTML = '';

    selectedFiles.forEach((file, index) => {
      const box = document.createElement('div');
      box.className = 'listing-image-box thumb-box';

      const img = document.createElement('img');
      const reader = new FileReader();
      reader.onload = () => { img.src = reader.result; };
      reader.readAsDataURL(file);
      box.appendChild(img);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'listing-image-remove-btn';
      removeBtn.innerHTML = '<i class="fas fa-xmark"></i>';
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedFiles.splice(index, 1);
        renderImageGrid();
      });
      box.appendChild(removeBtn);

      imageGrid.appendChild(box);
    });

    // সবসময় শেষে একটা ➕ বক্স — ক্লিক করলে আরও ছবি যোগ করা যাবে
    const addBox = document.createElement('div');
    addBox.className = 'listing-image-box add-box';
    addBox.innerHTML = '<i class="fas fa-plus"></i>';
    addBox.addEventListener('click', () => imagesInput.click());
    imageGrid.appendChild(addBox);
  }

  imagesInput?.addEventListener('change', () => {
    const newFiles = Array.from(imagesInput.files || []);
    selectedFiles = selectedFiles.concat(newFiles);
    imagesInput.value = ''; // রিসেট, যাতে একই ফাইল আবার সিলেক্ট করা যায়
    renderImageGrid();
  });

  renderImageGrid(); // শুরুতে শুধু ➕ বক্স দেখানোর জন্য

  // ছবি আপলোড — সার্ভার-সাইড /api/upload-image রুট দিয়ে (service role
  // key ব্যবহার করে)। আগে ক্লায়েন্ট থেকে সরাসরি supabase.storage.upload()
  // কল হতো, কিন্তু Storage সার্ভিস ইউজার-সেশন JWT ভেরিফাই করতে ব্যর্থ
  // হচ্ছিল ("new row violates row-level security policy" — লগে
  // কনফার্ম করা হয়েছে)।
  async function uploadImages(userId, accessToken) {
    const urls = [];
    for (const file of selectedFiles) {
      const fileExt = file.name.split('.').pop();
      const filePath = `${category}/${userId}-${Date.now()}-${Math.random().toString(36).slice(2, 7)}.${fileExt}`;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('path', filePath);

      const res = await fetch('/api/upload-image', {
        method: 'POST',
        headers: { Authorization: `Bearer ${accessToken}` },
        body: formData,
      });
      const result = await res.json();

      if (res.ok && result.url) {
        urls.push(result.url);
      } else {
        console.error('ছবি আপলোড এরর:', result.error);
      }
    }
    return urls;
  }

  submitBtn?.addEventListener('click', async () => {
    clearMessage();

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      closeListingModal();
      window.openAuthModal?.('login');
      return;
    }

    let type = typeSelect?.value;
    const title = document.getElementById('listingTitle')?.value?.trim();
    let description = document.getElementById('listingDescription')?.value?.trim();
    const price = document.getElementById('listingPrice')?.value?.trim();
    const upazila = document.getElementById('listingUpazila')?.value;
    const phone = document.getElementById('listingPhone')?.value?.trim();
    const companyInput = document.getElementById('listingCompany');
    const company = companyInput?.value?.trim();

    if (!title || !phone) {
      showMessage('টাইটেল ও যোগাযোগ নাম্বার আবশ্যক');
      return;
    }

    if (type === 'other') {
      const customType = customTypeInput?.value?.trim();
      if (!customType) {
        showMessage('নতুন ক্যাটাগরির নাম লিখুন');
        return;
      }
      type = customType;
    }

    if (companyLabel && company) {
      description = `${companyLabel}: ${company}${description ? '\n' + description : ''}`;
    }

    const textEl = submitBtn.querySelector('.listing-submit-text');
    const originalText = textEl.textContent;
    textEl.textContent = 'পোস্ট হচ্ছে...';
    submitBtn.disabled = true;

    const imageUrls = selectedFiles.length ? await uploadImages(session.user.id, session.access_token) : [];

    const insertPayload = {
      user_id: session.user.id,
      category,
      type,
      title,
      description,
      price,
      upazila,
      images: imageUrls,
      contact_phone: phone,
    };

    if (autoActive) {
      insertPayload.status = 'active';
    }

    const { error } = await supabase.from('listings').insert(insertPayload);

    textEl.textContent = originalText;
    submitBtn.disabled = false;

    if (error) {
      showMessage('পোস্ট করা যায়নি: ' + error.message);
      return;
    }

    showMessage('লিস্টিং সফলভাবে পোস্ট হয়েছে!', 'success');
    setTimeout(() => {
      closeListingModal();
      window.location.reload();
    }, 1200);
  });

  window.openListingModal = openListingModal;
</script>