<!-- path: src/components/ui/AddListingModal.astro -->
---
// ============================================================
// কম্পোনেন্ট: নতুন লিস্টিং যোগ করার মোডাল (রিইউজেবল)
// প্রতিটা ক্যাটাগরি পেজ থেকে <AddListingModal category="repair" typeOptions={...} />
// আকারে কল হবে। লগইন করা না থাকলে প্রথমে AuthModal খুলবে।
// titleLabel/priceLabel দিয়ে লেবেল কাস্টমাইজ করা যাবে (যেমন job এ "পদবী"/"বেতন")
// companyLabel দিলে একটা এক্সট্রা ইনপুট দেখাবে, যেটা সাবমিটের সময় description এর শুরুতে জুড়ে যাবে
// নতুন: openListingModal('tutor') এর মতো প্যারামিটার দিলে "সার্ভিসের ধরন"
// ড্রপডাউনে সেই ভ্যালু আগে থেকেই সিলেক্ট করা থাকবে (tuition পেজের ২টা CTA-র জন্য)
// নতুন: autoActive={true} দিলে সাবমিটের সময় সরাসরি status='active' হয়ে যাবে
// (এডমিন approve লাগবে না) — শুধু ভেরিফাইড ইউজার (যেমন শপ ওউনার) এর জন্য
// আপডেট (বাতিল): ক্লাব ওনার একাউন্ট থেকে লিস্টিং পোস্ট ব্লক করার
// ফিচারটা সরিয়ে ফেলা হয়েছে — ক্লাব, শপ, জেনারেল লিস্টিং সবই
// স্বতন্ত্র, একজন ইউজার চাইলে সবগুলাতেই পোস্ট করতে পারবে, কোনো
// একাউন্ট টাইপ অন্য কোনোটাকে ব্লক করবে না।
// আপডেট (শপ প্রোডাক্ট স্পেসিফিক): category="online-shop" হলে —
// (১) যোগাযোগ নাম্বার ফিল্ড হাইড + অবাধ্যতামূলক না (শপ প্রোডাক্ট
// cart/checkout ফ্লোতে চলে, ফোন-কল বাটন সিস্টেম ব্যবহার হয় না),
// (২) উপজেলা ফিল্ড হাইড — শপ ওউনারের নিজের প্রোফাইলের upazila
// সাবমিটের সময় সার্ভার থেকে অটো fetch করে বসানো হয় (শপ ব্রাউজিং
// upazila দিয়ে ফিল্টার হয় না, তাই প্রতি প্রোডাক্টে আলাদা জিজ্ঞেস
// করাটা অপ্রয়োজনীয়), (৩) দাম ও বিবরণ ফিল্ডের নিচে হিন্ট টেক্সট
// যোগ হয়েছে। নতুন: typeOptions এ একটাই অপশন থাকলে "সার্ভিসের ধরন"
// ড্রপডাউন না দেখিয়ে হিডেন ইনপুট দিয়ে অটো-সিলেক্ট করে দেওয়া হয়
// (জেনারেল রুল, ভবিষ্যতের যেকোনো single-option ক্যাটাগরির জন্যও
// কাজ করবে)। নতুন: autoActive={true} হলে is_reviewed=true-ও সেট
// হয় (এডমিন লিস্টিং পেজে অটো-এপ্রুভড প্রোডাক্ট "নতুন/আনরিভিউড"
// হিসেবে ভুলভাবে দেখানো বন্ধ করতে)। নতুন: nounLabel prop দিয়ে
// মোডালের টেক্সট কাস্টমাইজ করা যায় (ডিফল্ট "লিস্টিং", শপ প্রোডাক্টে
// "প্রোডাক্ট" পাস করা হয়)।
// আপডেট: ছবি আপলোড প্রিভিউ এখন Instagram/Urban Company স্টাইল ছোট
// স্কয়ার ড্রপবক্স গ্রিড — প্রথমে শুধু ➕ বক্স, ছবি সিলেক্ট করলে পাশে
// থাম্বনেইল + রিমুভ বাটন, পাশে সবসময় আরেকটা ➕ বক্স (আরও ছবি যোগ করতে)
// নতুন: typeOptions এ id="other" থাকলে সিলেক্ট করার সাথে সাথে একটা
// এক্সট্রা টেক্সট ইনপুট দেখাবে ("নতুন ক্যাটাগরির নাম লিখুন")। সাবমিটের
// সময় সেই কাস্টম টেক্সটটাই আসল `type` ভ্যালু হিসেবে সেভ হয় (literal
// "other" স্ট্রিং না) — তাই ডিসপ্লে/ব্যাজ/সার্চ কোথাও এক্সট্রা কোড
// ছাড়াই স্বয়ংক্রিয়ভাবে কাজ করে (fallback: typeNameMap[item.type] || item.type)
// ============================================================

export interface Props {
  category: string;
  typeOptions: { id: string; label: string }[];
  titleLabel?: string;
  priceLabel?: string;
  companyLabel?: string;
  autoActive?: boolean;
  nounLabel?: string;
  showUnion?: boolean;
}

const {
  category,
  typeOptions,
  titleLabel = 'টাইটেল',
  priceLabel = 'দাম / রেট',
  companyLabel,
  autoActive = false,
  showUnion = false,
  nounLabel = 'লিস্টিং',
} = Astro.props;

const isShopProduct = category === 'online-shop';

const upazilas = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];
---

<div class="listing-overlay" id="listingOverlay" data-category={category} data-company-label={companyLabel || ''} data-auto-active={autoActive ? '1' : ''} data-noun-label={nounLabel} data-show-union={showUnion ? '1' : ''}>
  <div class="listing-modal">
    <button class="listing-close" id="listingClose" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <h2 class="listing-title"><i class="fas fa-plus-circle"></i> নতুন {nounLabel} যোগ করুন</h2>
    <p class="listing-subtitle">তথ্য পূরণ করুন, সবাই দেখতে পাবে</p>

    <p class="listing-message" id="listingMessage"></p>

    {typeOptions.length > 1 ? (
      <>
        <label class="listing-label">সার্ভিসের ধরন</label>
        <select class="listing-input" id="listingType">
          {typeOptions.map((t) => (
            <option value={t.id}>{t.label}</option>
          ))}
        </select>
      </>
    ) : (
      <input type="hidden" id="listingType" value={typeOptions[0]?.id || ''} />
    )}

    <div class="listing-custom-type-wrap" id="listingCustomTypeWrap" style="display:none;">
      <label class="listing-label">নতুন ক্যাটাগরির নাম লিখুন<span class="required-mark">*</span></label>
      <input type="text" class="listing-input" id="listingCustomType" placeholder="যেমন: থাই গ্লাস মিস্ত্রি" />
      <div class="field-error-msg" data-error-for="listingCustomType">
        <i class="fas fa-circle-exclamation"></i><span>ক্যাটাগরির নাম লিখুন</span>
      </div>
    </div>

    {companyLabel && (
      <>
        <label class="listing-label">{companyLabel}</label>
        <input type="text" class="listing-input" id="listingCompany" placeholder="" />
      </>
    )}

    <label class="listing-label">{titleLabel}<span class="required-mark">*</span></label>
    <input type="text" class="listing-input" id="listingTitle" required placeholder="" maxlength={isShopProduct ? 80 : undefined} />
    <div class="field-error-msg" data-error-for="listingTitle">
      <i class="fas fa-circle-exclamation"></i><span>{titleLabel} দিন</span>
    </div>

    <label class="listing-label">বিবরণ (ঐচ্ছিক)</label>
    <textarea class="listing-input" id="listingDescription" rows="3" placeholder=""></textarea>
    {isShopProduct && <p class="listing-field-hint">পণ্যের পরিমাণ অথবা পণ্য সম্পর্কে লিখুন</p>}

    {isShopProduct ? (
      <>
        <label class="listing-label" for="listingPrice">{priceLabel}<span class="required-mark">*</span></label>
        <div class="listing-money">
          <b>৳</b>
          <input type="text" id="listingPrice" inputmode="numeric" autocomplete="off" required placeholder="যেমন: ১০০" />
        </div>
        <div class="field-error-msg" data-error-for="listingPrice">
          <i class="fas fa-circle-exclamation"></i><span>দাম সংখ্যায় লিখুন</span>
        </div>
        <p class="listing-field-hint">শুধু সংখ্যা লিখুন। ৳ বা "টাকা" লেখার দরকার নেই।</p>

        <label class="listing-label">একক (ঐচ্ছিক)</label>
        <div class="listing-chip-row" id="listingUnitChips"></div>

        <div id="listingProdCatWrap" style="display:none;">
          <label class="listing-label">প্রোডাক্ট ক্যাটাগরি (ঐচ্ছিক)</label>
          <div class="listing-chip-row" id="listingProdCatChips"></div>
        </div>
      </>
    ) : (
      <>
        <label class="listing-label">{priceLabel}</label>
        <input type="text" class="listing-input" id="listingPrice" placeholder="" />
      </>
    )}

    {!isShopProduct && (
      <>
        <label class="listing-label">উপজেলা</label>
        <select class="listing-input" id="listingUpazila">
          {upazilas.map((u) => (
            <option value={u}>{u}</option>
          ))}
        </select>

        {showUnion && (
          <>
            <label class="listing-label">ইউনিয়ন / এলাকা<span class="required-mark">*</span></label>
            <select class="listing-input" id="listingUnion" required>
              <option value="">ইউনিয়ন নির্বাচন করুন</option>
            </select>
            <div class="field-error-msg" data-error-for="listingUnion">
              <i class="fas fa-circle-exclamation"></i><span>ইউনিয়ন নির্বাচন করুন</span>
            </div>
          </>
        )}
      </>
    )}

    {!isShopProduct && (
      <>
        <label class="listing-label">যোগাযোগ নাম্বার<span class="required-mark">*</span></label>
        <input type="text" class="listing-input" id="listingPhone" required placeholder="01xxxxxxxxx" />
        <div class="field-error-msg" data-error-for="listingPhone">
          <i class="fas fa-circle-exclamation"></i><span>যোগাযোগ নাম্বার দিন</span>
        </div>
      </>
    )}

    <label class="listing-label">ছবি (ঐচ্ছিক, একাধিক দেওয়া যাবে)</label>
    <input type="file" id="listingImages" accept="image/*" multiple hidden />
    <div class="listing-image-grid" id="listingImageGrid"></div>

    <button class="listing-submit" id="listingSubmit" type="button">
      <i class="fas fa-check"></i> <span class="listing-submit-text">{nounLabel} পোস্ট করুন</span>
    </button>
  </div>
</div>

<style>
  .listing-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  .listing-overlay.open {
    display: flex;
  }

  .listing-modal {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 460px;
    border-radius: 28px;
    padding: 36px 32px 28px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    margin: auto;
    max-height: 90vh;
    overflow-y: auto;
  }

  .listing-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #5A6E85;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .listing-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .listing-title {
    font-size: 1.3rem;
    color: #1B2A4A;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .listing-title i {
    color: #FF6B35;
  }

  .listing-subtitle {
    color: #8FA0BC;
    font-size: 0.85rem;
    margin-bottom: 18px;
  }

  .listing-message {
    display: none;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 12px;
    margin-bottom: 12px;
    text-align: center;
  }

  .listing-message.show-error {
    display: block;
    background: #FFF0EA;
    color: #D14343;
  }

  .listing-message.show-success {
    display: block;
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .listing-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #1B2A4A;
    margin-bottom: 6px;
    margin-top: 14px;
  }

  .listing-field-hint {
    font-size: 0.74rem;
    color: #9AA8BC;
    margin-top: 5px;
  }

  /* গ্লোবাল .field-error-msg এর সাথে লিস্টিং ফর্মের স্পেসিং মিলিয়ে নেওয়া */
  .listing-modal .field-error-msg {
    margin-top: 6px;
    font-size: 0.76rem;
  }

  .listing-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1.5px solid #E5EAF0;
    font-size: 0.9rem;
    font-family: inherit;
    color: #1B2A4A;
    background: #FBFCFE;
  }

  .listing-input:focus {
    outline: none;
    border-color: #FF6B35;
    background: #fff;
  }

  textarea.listing-input {
    resize: vertical;
  }

  .listing-submit {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    margin-top: 22px;
    box-shadow: 0 10px 24px rgba(255, 107, 53, 0.28);
  }

  .listing-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .listing-modal {
      padding: 28px 22px 22px;
      border-radius: 22px;
    }
  }
</style>

<style is:global>
  /* ছবি আপলোড গ্রিড — JS দিয়ে dynamically তৈরি হওয়ায় এই স্টাইলগুলো
     গ্লোবাল রাখা হয়েছে (Astro scoped CSS dynamically তৈরি এলিমেন্টে বসে না) */
  .listing-image-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .listing-image-box {
    width: 72px;
    height: 72px;
    border-radius: 14px;
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
  }

  .listing-image-box.add-box {
    border: 1.5px dashed #D8E0EA;
    background: #FBFCFE;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8FA0BC;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .listing-image-box.add-box:hover {
    border-color: #FF6B35;
    color: #FF6B35;
    background: #FFF7F3;
  }

  .listing-image-box.thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 1px solid #E5EAF0;
    border-radius: 14px;
  }

  .listing-image-remove-btn {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    color: #fff;
    border: none;
    font-size: 0.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .listing-image-remove-btn:hover {
    background: #D14343;
  }

  /* শপ প্রোডাক্ট ফর্ম: ৳ প্রিফিক্সসহ দামের বক্স + একক/ক্যাটাগরি চিপ
     (ProductsTab এর এডিট মোডালও এই ক্লাসগুলো রিইউজ করে) */
  .listing-money {
    display: flex;
    align-items: center;
    border: 1.5px solid #E5EAF0;
    border-radius: 14px;
    background: #FBFCFE;
    overflow: hidden;
  }

  .listing-money:focus-within {
    border-color: #FF6B35;
    background: #fff;
  }

  .listing-money:has(.field-invalid) {
    border-color: #D14343;
  }

  .listing-money b {
    padding: 0 4px 0 14px;
    color: #FF6B35;
    font-size: 1.05rem;
  }

  .listing-money input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 12px 14px 12px 6px;
    font-size: 0.9rem;
    font-family: inherit;
    color: #1B2A4A;
  }

  .listing-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .listing-chip {
    border: 1.5px solid #E5EAF0;
    background: #fff;
    color: #1B2A4A;
    padding: 6px 13px;
    border-radius: 40px;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
  }

  .listing-chip.sel {
    background: #FF6B35;
    border-color: #FF6B35;
    color: #fff;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImages, isHeicFile } from '../../lib/imageCompress.js';
  import { getUnionsOfUpazilaName } from '../../data/feniAreas.js';
  import { sanitizePriceInput, PRICE_UNITS } from '../../lib/price.js';

  const overlay = document.getElementById('listingOverlay');
  const closeBtn = document.getElementById('listingClose');
  const messageEl = document.getElementById('listingMessage');
  const submitBtn = document.getElementById('listingSubmit');
  const typeSelect = document.getElementById('listingType');
  const customTypeWrap = document.getElementById('listingCustomTypeWrap');
  const customTypeInput = document.getElementById('listingCustomType');
  const category = overlay?.dataset.category || '';

  // ইউনিয়ন ড্রপডাউন (শুধু showUnion চালু থাকলে, যেমন গাড়ি ভাড়া) — উপজেলা বদলালে
  // সেই উপজেলার ইউনিয়ন দিয়ে ভরে যায়
  const showUnion = overlay?.dataset.showUnion === '1';
  const upazilaSelect = document.getElementById('listingUpazila');
  const unionSelect = document.getElementById('listingUnion');

  function fillUnions() {
    if (!unionSelect) return;
    const list = getUnionsOfUpazilaName(upazilaSelect?.value);
    unionSelect.innerHTML = '<option value="">ইউনিয়ন নির্বাচন করুন</option>' +
      list.map((u) => `<option value="${u}">${u}</option>`).join('');
  }

  if (showUnion) {
    fillUnions();
    upazilaSelect?.addEventListener('change', fillUnions);
  }
  const companyLabel = overlay?.dataset.companyLabel || '';
  const autoActive = overlay?.dataset.autoActive === '1';
  const isShopProduct = category === 'online-shop';
  const nounLabel = overlay?.dataset.nounLabel || 'লিস্টিং';

  // ===== শপ প্রোডাক্ট: দাম শুধু সংখ্যা (৳ অটো), একক ও প্রোডাক্ট ক্যাটাগরি চিপ =====
  let selectedUnit = '';
  let selectedProdCat = '';
  let shopProductCategories = [];
  const priceInput = document.getElementById('listingPrice');
  const unitChipsEl = document.getElementById('listingUnitChips');
  const prodCatWrap = document.getElementById('listingProdCatWrap');
  const prodCatChipsEl = document.getElementById('listingProdCatChips');

  function renderChips(container, items, selected, onPick) {
    if (!container) return;
    container.innerHTML = '';
    items.forEach((it) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'listing-chip' + (selected === it.value ? ' sel' : '');
      b.textContent = it.label;
      b.addEventListener('click', () => onPick(selected === it.value ? '' : it.value));
      container.appendChild(b);
    });
  }

  function renderUnitChips() {
    renderChips(unitChipsEl, PRICE_UNITS.map((u) => ({ value: u, label: 'প্রতি ' + u })), selectedUnit, (v) => {
      selectedUnit = v;
      renderUnitChips();
    });
  }

  function renderProdCatChips() {
    if (!prodCatWrap) return;
    prodCatWrap.style.display = shopProductCategories.length ? 'block' : 'none';
    renderChips(prodCatChipsEl, shopProductCategories.map((c) => ({ value: c.id, label: c.name })), selectedProdCat, (v) => {
      selectedProdCat = v;
      renderProdCatChips();
    });
  }

  if (isShopProduct) {
    renderUnitChips();

    priceInput?.addEventListener('input', () => {
      const clean = sanitizePriceInput(priceInput.value);
      if (clean !== priceInput.value) {
        const hadSymbol = /[^0-9০-৯]/.test(priceInput.value);
        priceInput.value = clean;
        if (hadSymbol) window.showToast?.('শুধু সংখ্যা লিখুন, ৳ নিজে থেকে বসবে');
      }
    });

    window.addEventListener('smartfeni:product-categories', (e) => {
      shopProductCategories = e.detail?.categories || [];
      renderProdCatChips();
    });
  }

  // "অন্যান্য" সিলেক্ট করলে কাস্টম-টাইপ ইনপুট বক্স দেখানো/লুকানো
  // (দেখানো অবস্থাতেই শুধু required — লুকানো থাকলে ভ্যালিডেশনে ধরা পড়বে না)
  function toggleCustomType() {
    const isOther = typeSelect?.value === 'other';
    if (customTypeWrap) customTypeWrap.style.display = isOther ? 'block' : 'none';
    if (customTypeInput) {
      if (isOther) {
        customTypeInput.setAttribute('required', 'required');
      } else {
        customTypeInput.removeAttribute('required');
        customTypeInput.classList.remove('field-invalid');
        customTypeInput.value = '';
      }
    }
  }
  typeSelect?.addEventListener('change', toggleCustomType);

  // presetType দিলে "সার্ভিসের ধরন" ড্রপডাউনে সেই ভ্যালু আগে থেকেই সিলেক্ট থাকবে
  async function openListingModal(presetType) {
    clearMessage();

    if (presetType && typeSelect) {
      typeSelect.value = presetType;
    }
    toggleCustomType();
    if (isShopProduct) {
      shopProductCategories = window.__shopProductCategories || shopProductCategories;
      selectedUnit = '';
      selectedProdCat = '';
      renderUnitChips();
      renderProdCatChips();
    }
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
    await applyCooldownState();
  }

  // ===== রিজেক্ট কুলডাউন: ২৪ ঘণ্টায় ৩টির বেশি বাতিল হলে ২৪ ঘণ্টা নতুন লিস্টিং বন্ধ =====
  // (আসল ব্লক ডাটাবেস ট্রিগারে; এখানে শুধু আগেভাগে মেসেজ, যাতে ফর্ম পূরণ ও ছবি আপলোড বৃথা না যায়)
  function formatTimeLeft(until) {
    const mins = Math.max(1, Math.ceil((until.getTime() - Date.now()) / 60000));
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    const bn = (n) => n.toLocaleString('bn-BD');
    return h > 0 ? `${bn(h)} ঘণ্টা ${bn(m)} মিনিট` : `${bn(m)} মিনিট`;
  }

  function cooldownText(until) {
    return `আপনার কয়েকটি লিস্টিং বাতিল হওয়ায় নতুন লিস্টিং দেওয়া সাময়িকভাবে বন্ধ আছে। আর ${formatTimeLeft(until)} পরে আবার চেষ্টা করুন।`;
  }

  async function getCooldownUntil(userId) {
    if (isShopProduct || !userId) return null;
    try {
      const { data } = await supabase
        .from('listing_cooldowns')
        .select('blocked_until')
        .eq('user_id', userId)
        .maybeSingle();
      if (!data?.blocked_until) return null;
      const until = new Date(data.blocked_until);
      return until.getTime() > Date.now() ? until : null;
    } catch (e) {
      return null;
    }
  }

  // ব্লক থাকলে true (মেসেজ দেখায় + সাবমিট বাটন বন্ধ), নাহলে false
  async function applyCooldownState() {
    if (isShopProduct) return false;
    const { data: { session } } = await supabase.auth.getSession();
    const until = await getCooldownUntil(session?.user?.id);
    if (until) {
      if (messageEl) {
        messageEl.textContent = cooldownText(until);
        messageEl.className = 'listing-message show-error';
      }
      if (submitBtn) submitBtn.disabled = true;
      return true;
    }
    if (submitBtn) submitBtn.disabled = false;
    return false;
  }

  function closeListingModal() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  function showMessage(text, type = 'error') {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.className = `listing-message ${type === 'error' ? 'show-error' : 'show-success'}`;

    // গ্লোবাল টোস্টেও দেখানো হয় — ইনলাইন মেসেজ স্ক্রিনের বাইরে থাকলেও যেন চোখে পড়ে
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  function clearMessage() {
    if (!messageEl) return;
    messageEl.textContent = '';
    messageEl.className = 'listing-message';
  }

  closeBtn?.addEventListener('click', closeListingModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeListingModal();
  });

  // ছবি আপলোড — ছোট স্কয়ার ড্রপবক্স গ্রিড (থাম্বনেইল + সবসময় একটা ➕ বক্স)
  const imagesInput = document.getElementById('listingImages');
  const imageGrid = document.getElementById('listingImageGrid');
  let selectedFiles = [];

  function renderImageGrid() {
    imageGrid.innerHTML = '';

    selectedFiles.forEach((file, index) => {
      const box = document.createElement('div');
      box.className = 'listing-image-box thumb-box';

      const img = document.createElement('img');
      const reader = new FileReader();
      reader.onload = () => { img.src = reader.result; };
      reader.readAsDataURL(file);
      box.appendChild(img);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'listing-image-remove-btn';
      removeBtn.innerHTML = '<i class="fas fa-xmark"></i>';
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedFiles.splice(index, 1);
        renderImageGrid();
      });
      box.appendChild(removeBtn);

      imageGrid.appendChild(box);
    });

    // সবসময় শেষে একটা ➕ বক্স — ক্লিক করলে আরও ছবি যোগ করা যাবে
    const addBox = document.createElement('div');
    addBox.className = 'listing-image-box add-box';
    addBox.innerHTML = '<i class="fas fa-plus"></i>';
    addBox.addEventListener('click', () => imagesInput.click());
    imageGrid.appendChild(addBox);
  }

  imagesInput?.addEventListener('change', async () => {
    const rawFiles = Array.from(imagesInput.files || []);
    imagesInput.value = ''; // রিসেট, যাতে একই ফাইল আবার সিলেক্ট করা যায়
    if (rawFiles.length === 0) return;

    // সিলেক্ট করার সাথে সাথেই কম্প্রেস (1600px / JPEG 82%) — Samsung/high-res
    // ফোনের ছবি হলেও আপলোডের আগেই ছোট হয়ে যাবে, Vercel-এর 4.5MB body
    // limit-এ আটকাবে না আর প্রিভিউ থাম্বনেইলও এই কম্প্রেসড ভার্সনেরই হবে
    const compressedAll = await compressImages(rawFiles);
    // HEIC/HEIF যা কনভার্ট হয়নি সেগুলো বাদ — বড় কাঁচা ফাইল (৪MB+) আপলোড হলে সাইট ধীর ও ব্যয়বহুল হয়
    const compressedFiles = compressedAll.filter((f) => !isHeicFile(f));
    if (compressedFiles.length < compressedAll.length) {
      const heicMsg = 'HEIC ছবি চলে না। ছবি JPEG বা PNG করে দিন (iPhone: Settings → Camera → Formats → Most Compatible)।';
      if (typeof window.showToast === 'function') window.showToast(heicMsg);
      else alert(heicMsg);
    }
    selectedFiles = selectedFiles.concat(compressedFiles);
    renderImageGrid();
  });

  renderImageGrid(); // শুরুতে শুধু ➕ বক্স দেখানোর জন্য

  // ছবি আপলোড — সার্ভার-সাইড /api/upload-image রুট দিয়ে (service role
  // key ব্যবহার করে)। আগে ক্লায়েন্ট থেকে সরাসরি supabase.storage.upload()
  // কল হতো, কিন্তু Storage সার্ভিস ইউজার-সেশন JWT ভেরিফাই করতে ব্যর্থ
  // হচ্ছিল ("new row violates row-level security policy" — লগে
  // কনফার্ম করা হয়েছে)।
  async function uploadImages(userId, accessToken) {
    const urls = [];
    for (const file of selectedFiles) {
      const fileExt = file.name.split('.').pop();
      const filePath = `${category}/${userId}-${Date.now()}-${Math.random().toString(36).slice(2, 7)}.${fileExt}`;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('path', filePath);

      const res = await fetch('/api/upload-image', {
        method: 'POST',
        headers: { Authorization: `Bearer ${accessToken}` },
        body: formData,
      });
      const result = await res.json();

      if (res.ok && result.url) {
        urls.push(result.url);
      } else {
        console.error('ছবি আপলোড এরর:', result.error);
      }
    }
    return urls;
  }

  submitBtn?.addEventListener('click', async () => {
    clearMessage();

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      closeListingModal();
      window.openAuthModal?.('login');
      return;
    }

    let type = typeSelect?.value;
    const title = document.getElementById('listingTitle')?.value?.trim();
    let description = document.getElementById('listingDescription')?.value?.trim();
    const priceRaw = document.getElementById('listingPrice')?.value?.trim();
    // শপ প্রোডাক্টে দাম শুধু ইংরেজি অঙ্ক হিসেবে সেভ হয়, ৳ ডিসপ্লেতে অটো বসে (lib/price.js)
    const price = isShopProduct ? sanitizePriceInput(priceRaw) : priceRaw;
    const phone = document.getElementById('listingPhone')?.value?.trim();
    const companyInput = document.getElementById('listingCompany');
    const company = companyInput?.value?.trim();

    if (!window.SFValidateForm(overlay)) {
      return;
    }

    if (isShopProduct && (!price || Number(price) < 1)) {
      showMessage('দাম সংখ্যায় লিখুন (যেমন ১০০)');
      return;
    }

    if (showUnion && !unionSelect?.value) {
      showMessage('ইউনিয়ন নির্বাচন করুন');
      return;
    }

    if (type === 'other') {
      type = customTypeInput?.value?.trim();
    }

    if (companyLabel && company) {
      description = `${companyLabel}: ${company}${description ? '\n' + description : ''}`;
    }

    if (await applyCooldownState()) return;

    const textEl = submitBtn.querySelector('.listing-submit-text');
    const originalText = textEl.textContent;
    textEl.textContent = 'পোস্ট হচ্ছে...';
    submitBtn.disabled = true;

    // ===== মডারেটর ফিক্স: ProductsTab.astro (বা অন্য কোনো মাল্টি-টেন্যান্ট
    // কনটেক্সট) থেকে overlay-তে data-target-user-id বসানো থাকলে সেটাই
    // ব্যবহার হবে (শপ ওউনারের ID) — নাহলে আগের মতো নিজের session ID।
    // এটা ছাড়া মডারেটরের যোগ করা প্রোডাক্ট শুধু মডারেটরের নিজের
    // অ্যাকাউন্টে সেভ হয়ে যেত, শপের লিস্টে দেখাত না (silent bug)।
    const targetUserId = overlay?.dataset.targetUserId || session.user.id;
    // শপ প্রোডাক্টের জন্য shop_id — ProductsTab.astro থেকে পাঠানো হয় (owner
    // পরে বদলে গেলেও প্রোডাক্ট সবসময় এই শপের সাথেই লিংকড থাকবে)
    const targetShopId = overlay?.dataset.targetShopId || null;

    // শপ প্রোডাক্টের জন্য উপজেলা আলাদা জিজ্ঞেস করা হয় না — শপ ওউনারের
    // নিজের প্রোফাইলের upazila অটো বসিয়ে দেওয়া হচ্ছে
    let upazila;
    if (isShopProduct) {
      const { data: ownerProfile } = await supabase
        .from('profiles')
        .select('upazila')
        .eq('id', targetUserId)
        .single();
      upazila = ownerProfile?.upazila || null;
    } else {
      upazila = document.getElementById('listingUpazila')?.value;
    }

    const imageUrls = selectedFiles.length ? await uploadImages(targetUserId, session.access_token) : [];

    const insertPayload = {
      user_id: targetUserId,
      category,
      type,
      title,
      description,
      price,
      upazila,
      images: imageUrls,
      contact_phone: phone || null,
      union_name: showUnion ? (unionSelect?.value || null) : null,
    };

    if (isShopProduct && targetShopId) {
      insertPayload.shop_id = targetShopId;
    }

    if (isShopProduct) {
      insertPayload.price_unit = selectedUnit || null;
      insertPayload.shop_category_id = selectedProdCat || null;
    }

    if (autoActive) {
      insertPayload.status = 'active';
      insertPayload.is_reviewed = true;
    }

    const { error } = await supabase.from('listings').insert(insertPayload);

    textEl.textContent = originalText;
    submitBtn.disabled = false;

    if (error) {
      if (error.code === 'P0001' && (error.message || '').includes('বাতিল')) {
        const until = error.details ? new Date(error.details) : null;
        showMessage(until && !isNaN(until.getTime()) ? cooldownText(until) : error.message);
        submitBtn.disabled = true;
        return;
      }
      showMessage('পোস্ট করা যায়নি: ' + error.message);
      return;
    }

    window.showToast(`${nounLabel} সফলভাবে পোস্ট হয়েছে ✓`, 'success');
    setTimeout(() => {
      closeListingModal();
      window.location.reload();
    }, 1200);
  });

  window.openListingModal = openListingModal;
</script>