</section>

<script>
  const services = [
    { name: 'ржмрж╛рж╕рж╛ ржнрж╛ржбрж╝рж╛', category: 'ржмрж╛ржбрж╝рж┐ ржнрж╛ржбрж╝рж╛/ржХрзНрж░ржпрж╝', slug: 'housing', keywords: ['house rent', 'rent', 'housing', 'flat', 'apartment', 'basa vara'] },
    { name: 'ржЪрж╛ржХрж░рж┐рж░ ржЦржмрж░', category: 'ржЪрж╛ржХрж░рж┐ ржкрзЛрж╕рзНржЯ/ржЦрзЛржБржЬ', slug: 'job', keywords: ['job', 'jobs', 'vacancy', 'career', 'chakri'] },
    { name: 'рж░рж┐ржкрзЗржпрж╝рж╛рж░ рж╕рж╛рж░рзНржнрж┐рж╕', category: 'ржорзЗрж░рж╛ржоржд рж╕рж╛рж░рзНржнрж┐рж╕', slug: 'repair', keywords: ['repair', 'fix', 'service', 'maintenance', 'mistri'] },
    { name: 'ржЧрж╛ржбрж╝рж┐ ржнрж╛ржбрж╝рж╛ рж╕рж╛рж░рзНржнрж┐рж╕', category: 'ржЧрж╛ржбрж╝рж┐/ржорж╛ржЗржХрзНрж░рзЛ/рж╕рж┐ржПржиржЬрж┐', slug: 'car-rental', keywords: ['car rental', 'car rent', 'car', 'cng', 'microbus', 'gari vara'] },
    { name: 'ржХрзБрж░рж┐ржпрж╝рж╛рж░/ржбрзЗрж▓рж┐ржнрж╛рж░рж┐ рж╕рж╛рж░рзНржнрж┐рж╕', category: 'ржбрзЗрж▓рж┐ржнрж╛рж░рж┐', slug: 'courier', keywords: ['courier', 'delivery', 'parcel', 'shipment'] },
    { name: 'ржЗржорж╛рж░рзНржЬрзЗржирзНрж╕рж┐ ржХржирзНржЯрж╛ржХрзНржЯ', category: 'ржЬрж░рзБрж░рж┐ ржпрзЛржЧрж╛ржпрзЛржЧ', slug: 'emergency', keywords: ['emergency', 'emergency contact', 'urgent', 'help', 'sos'] },
    { name: 'ржмрзНрж▓рж╛ржб ржбрзЛржирж╛рж░', category: 'рж░ржХрзНржд ржжрж╛ржи/рж╕ржВржЧрзНрж░рж╣', slug: 'blood', keywords: ['blood', 'blood donor', 'donate blood', 'donor'] },
    { name: 'рж╣рзЛржо ржорзЗрж╕ ржлрзБржб', category: 'ржмрж╛рж╕рж╛рж░ рждрзИрж░рж┐ ржЦрж╛ржмрж╛рж░', slug: 'home-food', keywords: ['home food', 'mess food', 'food', 'tiffin', 'catering'] },
    { name: 'рж░рж┐рж╕рж╛ржЗржХрзЗрж▓ ржорж╛рж░рзНржХрзЗржЯ', category: 'ржкрзБрж░ржирзЛ ржорж╛рж▓ ржХрзЗржирж╛ржмрзЗржЪрж╛', slug: 'recycle', keywords: ['recycle', 'second hand', 'used', 'old items', 'market'] },
    { name: 'ржЯрж┐ржЙрж╢ржи ржЦрзБржБржЬрзБржи', category: 'ржЯрж┐ржЙржЯрж░/рж╕рзНржЯрзБржбрзЗржирзНржЯ', slug: 'tuition', keywords: ['tuition', 'tutor', 'teacher', 'study', 'coaching'] },
    { name: 'ржЦрзЗрж▓рж╛ржзрзБрж▓рж╛ ржУ ржЗржнрзЗржирзНржЯрж╕', category: 'рж╕рзНржкрзЛрж░рзНржЯрж╕/ржмрж┐ржирзЛржжржи', slug: 'sports', keywords: ['sports', 'events', 'game', 'entertainment', 'khela'] },
    { name: 'рж▓рж╕рзНржЯ ржПржирзНржб ржлрж╛ржЙржирзНржб', category: 'рж╣рж╛рж░рж╛ржирзЛ-ржкрж╛ржУржпрж╝рж╛', slug: 'lost-found', keywords: ['lost and found', 'lost', 'found', 'missing'] },
    { name: 'рж╕рзНржмрж╛рж╕рзНржерзНржп ржкрж░рж╛ржорж░рзНрж╢', category: 'ржбрж╛ржХрзНрждрж╛рж░/ржкрж░рж╛ржорж░рзНрж╢', slug: 'health', keywords: ['health', 'health advice', 'consultation', 'doctor advice', 'shastho'] },
    { name: 'ржЖржЗржирж┐ ржкрж░рж╛ржорж░рзНрж╢', category: 'ржЖржЗржирж┐ ржкрж░рж╛ржорж░рзНрж╢ ржУ ржиржерж┐', slug: 'legal', keywords: ['legal', 'lawyer', 'law', 'legal advice', 'document'] },
    { name: 'ржЗржнрзЗржирзНржЯ ржорзНржпрж╛ржирзЗржЬржорзЗржирзНржЯ', category: 'ржЕржирзБрж╖рзНржарж╛ржи ржЖржпрж╝рзЛржЬржи', slug: 'event', keywords: ['event management', 'event', 'party', 'organizer', 'wedding'] },
    { name: 'рж▓ржирзНржбрзНрж░рж┐ рж╕рж╛рж░рзНржнрж┐рж╕', category: 'ржХрж╛ржкржбрж╝ ржзрзЛрж▓рж╛ржЗ', slug: 'laundry', keywords: ['laundry', 'laundry service', 'wash', 'dry clean', 'clothes'] },
    { name: 'ржбрж╛ржХрзНрждрж╛рж░ ржУ рж╣рж╛рж╕ржкрж╛рждрж╛рж▓ ржбрж┐рж░рзЗржХрзНржЯрж░рж┐', category: 'ржбрж╛ржХрзНрждрж╛рж░ ржбрж┐рж░рзЗржХрзНржЯрж░рж┐', slug: 'doctor-directory', keywords: ['doctor', 'hospital', 'doctor directory', 'clinic', 'physician'] },
  ];

  const heroSearchWrap = document.getElementById('heroSearchWrap');
  let wasResultsVisible = false;

  // sticky header-ржПрж░ ржирж┐ржЪрзЗ ржмржХрзНрж╕ржЯрж╛ржХрзЗ ржерж╛ржорж╛ржирзЛрж░ ржЬржирзНржп рж╕рж░рж╛рж╕рж░рж┐ рж╕рзНржХрзНрж░рж▓-ржкржЬрж┐рж╢ржи
  // рж╣рж┐рж╕рзЗржм ржХрж░рзЗ window.scrollTo ржХрж░рж╛ рж╣ржЪрзНржЫрзЗ тАФ scrollIntoView-ржПрж░ ржЪрзЗржпрж╝рзЗ
  // ржмрзЗрж╢рж┐ ржкрзНрж░рзЗржбрж┐ржХрзНржЯрзЗржмрж▓, sticky header/scroll-margin ржПрж░ ржУржкрж░ ржирж┐рж░рзНржнрж░ ржХрж░рзЗ ржирж╛
  function scrollSearchIntoView() {
    if (!heroSearchWrap) return;
    const HEADER_OFFSET = 96; // рж╕рзНржЯрж┐ржХрж┐ рж╣рзЗржбрж╛рж░рзЗрж░ ржЙржЪрзНржЪрждрж╛ + рж╕рж╛ржорж╛ржирзНржп ржЧрзНржпрж╛ржк
    const rect = heroSearchWrap.getBoundingClientRect();
    const targetY = window.scrollY + rect.top - HEADER_OFFSET;
    window.scrollTo({ top: Math.max(targetY, 0), behavior: 'smooth' });
  }

  function handleSearch(query: string) {
    const resultsContainer = document.getElementById('searchResults');
    const hint = document.getElementById('rotatingHint');
    if (!resultsContainer) return;

    if (hint) {
      hint.style.display = query && query.length > 0 ? 'none' : 'flex';
    }

    if (!query || query.trim() === '') {
      resultsContainer.style.display = 'none';
      wasResultsVisible = false;
      return;
    }

    const q = query.trim().toLowerCase();

    const filtered = services.filter((service) => {
      const nameMatch = service.name.toLowerCase().includes(q);
      const categoryMatch = service.category.toLowerCase().includes(q);
      const keywordMatch = service.keywords.some((k) => k.toLowerCase().includes(q));
      return nameMatch || categoryMatch || keywordMatch;
    });

    if (filtered.length === 0) {
      resultsContainer.innerHTML = `<p style="color:#5A6E85; padding:8px 4px; margin:0;">ЁЯФН ржХрзЛржирзЛ рж╕рзЗржмрж╛ ржкрж╛ржУржпрж╝рж╛ ржпрж╛ржпрж╝ржирж┐</p>`;
    } else {
      resultsContainer.innerHTML = filtered
        .map(
          (service) => `
        <a href="/services/${service.slug}"
           style="display:flex; flex-direction:column; padding:12px 14px; background:#F8FAFC; border-radius:12px; margin-bottom:6px; text-decoration:none; color:#1B2A4A;"
           onmouseover="this.style.background='#FFF0EA'"
           onmouseout="this.style.background='#F8FAFC'">
          <strong style="font-size:0.95rem; font-weight:600;">${service.name}</strong>
          <span style="color:#FF6B35; font-size:0.78rem; margin-top:2px;">${service.category}</span>
        </a>
      `
        )
        .join('');
    }

    resultsContainer.style.display = 'block';

    // рж░рзЗржЬрж╛рж▓рзНржЯ ржбрзНрж░ржкржбрж╛ржЙржи ржкрзНрж░ржержоржмрж╛рж░ ржжрзЗржЦрж╛ ржжрзЗржУржпрж╝рж╛рж░ ржорзБрж╣рзВрж░рзНрждрзЗржЗ рж╕рзНржХрзНрж░рж▓ ржХрж░рж┐ (ржкрзНрж░рждрж┐
    // ржХрж┐-рж╕рзНржЯрзНрж░рзЛржХрзЗ ржирж╛, рж╢рзБржзрзБ hidden тЖТ visible ржЯрзНрж░рж╛ржиржЬрж┐рж╢ржирзЗ) тАФ ржПржЯрж╛ржЗ ржЖрж╕рж▓ рж╕ржоржпрж╝
    // ржпржЦржи ржХрзАржмрзЛрж░рзНржб ржирж┐ржЪрзЗрж░ ржЬрж╛ржпрж╝ржЧрж╛ ржЦрзЗржпрж╝рзЗ ржлрзЗрж▓рж╛рж░ рж╕ржорж╕рзНржпрж╛ рж╣ржпрж╝
    if (!wasResultsVisible) {
      scrollSearchIntoView();
      wasResultsVisible = true;
    }
  }

  function handleSearchButtonClick() {
    const input = document.getElementById('searchInput') as HTMLInputElement;
    if (input) handleSearch(input.value);
  }

  (window as any).handleSearch = handleSearch;
  (window as any).handleSearchButtonClick = handleSearchButtonClick;

  // ===== Wipe-style рж░рзЛржЯрзЗржЯрж┐ржВ рж╣рж┐ржирзНржЯ =====
  const hintWords = [
    'рж╕рж┐ржПржиржЬрж┐?',
    'ржбрж╛ржХрзНрждрж╛рж░?',
    'ржмрж╛рж╕рж╛ ржнрж╛ржбрж╝рж╛?',
    'ржЪрж╛ржХрж░рж┐?',
    'рж╣рзЛржо ржбрзЗрж▓рж┐ржнрж╛рж░рж┐?',
    'ржкрзНрж▓рж╛ржорзНржмрж╛рж░?',
    'ржЗрж▓рзЗржХрзНржЯрзНрж░рж┐рж╢рж┐ржпрж╝рж╛ржи?',
    'ржЯрж┐ржЙрж╢ржи?',
    'ржЬрж░рзБрж░рж┐ ржорзЛржмрж╛ржЗрж▓ ржирж╛ржорзНржмрж╛рж░?',
    'рж░ржХрзНрждржжрж╛рждрж╛?',
  ];

  const wipeWordEl = document.getElementById('wipeWord');
  const searchInputEl = document.getElementById('searchInput') as HTMLInputElement;
  let wordIndex = 0;
  const HOLD_MS = 1300;
  const WIPE_MS = 400;

  function setClip(el: HTMLElement, percent: number, animate: boolean) {
    el.style.transition = animate ? `clip-path ${WIPE_MS}ms ease` : 'none';
    el.style.clipPath = `inset(0 ${percent}% 0 0)`;
  }

  function cycleWord() {
    if (!wipeWordEl || !searchInputEl) return;
    if (document.activeElement === searchInputEl || searchInputEl.value) return;

    setClip(wipeWordEl, 100, true);

    setTimeout(() => {
      wordIndex = (wordIndex + 1) % hintWords.length;
      wipeWordEl.textContent = hintWords[wordIndex];
      setClip(wipeWordEl, 100, false);

      requestAnimationFrame(() => {
        setClip(wipeWordEl, 0, true);
      });
    }, WIPE_MS);
  }

  if (wipeWordEl) {
    wipeWordEl.textContent = hintWords[0];
    setClip(wipeWordEl, 0, false);
  }

  setInterval(cycleWord, HOLD_MS + WIPE_MS);

  searchInputEl?.addEventListener('focus', () => {
    const hint = document.getElementById('rotatingHint');
    if (hint) hint.style.display = 'none';
  });

  searchInputEl?.addEventListener('blur', () => {
    const hint = document.getElementById('rotatingHint');
    if (hint && !searchInputEl.value) hint.style.display = 'flex';
  });
</script>

<style>
  .hero {
