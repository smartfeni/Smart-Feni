    font-size: 0.95rem;
    outline: none;
    background: transparent;
    color: #1B2A4A;
    position: relative;
    z-index: 2;
  }

  .rotating-hint {
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
    z-index: 1;
    max-width: 100%;
    overflow: hidden;
  }

  .hint-fixed {
    color: #A0B3C9;
    font-size: 0.95rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .wipe-word {
    color: #1B2A4A;
