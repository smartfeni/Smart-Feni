    white-space: nowrap;
    display: inline-block;
  }

  .search-card .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #CC4A1C;
    color: #fff;
    padding: 12px 24px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .search-card .btn-primary:hover {
    background: #e85a2a;
  }

  .search-results {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 20px;
    padding: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    z-index: 20;
    max-height: 320px;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 20px 0 24px;
    }

    .search-card {
      border-radius: 40px;
      padding: 6px 6px 6px 16px;
    }

    .hint-fixed,
    .wipe-word {
      font-size: 0.85rem;
    }
  }
</style>