---
// ============================================================
// SFLoader — শেয়ার্ড S-লুপ লোডার (সার্ভার-রেন্ডার ভার্সন)
// স্টাইল আসে src/styles/sf-loader.css থেকে (BaseLayout-এ ইমপোর্ট করা)।
//
// ব্যবহার:
//   <SFLoader />                              ছোট ইনলাইন (md)
//   <SFLoader size="lg" block label="লোড হচ্ছে…" />   সেকশন প্লেসহোল্ডার
//   <SFLoader size="sm" tone="current" />     বাটনের ভেতরে
// ============================================================
interface Props {
  size?: 'sm' | 'md' | 'lg';
  tone?: '' | 'dark' | 'current';
  label?: string;
  block?: boolean;
}

const { size = 'md', tone = '', label = 'লোড হচ্ছে…', block = false } = Astro.props;

const PATH = 'M14 44C6 30 20 12 40 20C58 28 62 44 80 44C94 44 96 26 86 22';
const cls = `sf-loader sf-loader-${size}${tone ? ` sf-loader-${tone}` : ''}`;
---

{block ? (
  <div class="sf-loader-block" role="status">
    <span class={cls} aria-hidden="true">
      <svg viewBox="0 0 100 60" focusable="false" aria-hidden="true">
        <path class="sf-l-track" pathLength="200" d={PATH} />
        <path class="sf-l-run" pathLength="200" d={PATH} />
      </svg>
    </span>
    {label && <span>{label}</span>}
  </div>
) : (
  <span class={cls} role="status" aria-label={label || 'লোড হচ্ছে'}>
    <svg viewBox="0 0 100 60" focusable="false" aria-hidden="true">
      <path class="sf-l-track" pathLength="200" d={PATH} />
      <path class="sf-l-run" pathLength="200" d={PATH} />
    </svg>
  </span>
)}
