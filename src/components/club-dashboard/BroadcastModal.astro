---
// path: src/components/club-dashboard/BroadcastModal.astro
// ব্রডকাস্ট মডাল (ইন্টারক্লাব নোটিফিকেশন)
//
// আপডেট (১৫ নভে ২০২৬): একই ক্লাবকে দিনে ১টা, মাসে সর্বোচ্চ ১০টা (DB ট্রিগার
// private.club_notif_before_insert)। মডাল খুললে RPC club_broadcast_quota থেকে
// blocked_today / blocked_month নিয়ে ওই ক্লাবগুলো ধূসর + সিলেক্ট-অসম্ভব করা হয়;
// "সব ক্লাব" মোডেও ওরা বাদ। নির্দিষ্ট তালিকায়: সার্চ, "সবাইকে সিলেক্ট", সংখ্যা।
// ক্লাবের নাম innerHTML-এ নয়, DOM/textContent দিয়ে (এস্কেপ)। CSS is:global
// কারণ তালিকার আইটেম JS দিয়ে বানানো (Astro scoped CSS কাজ করে না)।
---

<div class="broadcast-overlay" id="broadcastOverlay">
  <div class="broadcast-modal">
    <button class="broadcast-close" id="broadcastClose" type="button"><i class="fas fa-xmark"></i></button>

    <h3><i class="fas fa-tower-broadcast"></i> ব্রডকাস্ট পাঠান</h3>
    <p class="broadcast-post-title" id="broadcastPostTitle"></p>

    <div class="broadcast-note">
      <i class="fas fa-circle-info"></i>
      <span>একই ক্লাবকে দিনে ১টি এবং মাসে সর্বোচ্চ ১০টি ব্রডকাস্ট পাঠানো যায়। যাদের আজ পাঠানো হয়েছে বা মাসের সীমা শেষ, তারা ধূসর থাকবে এবং বাছাই করা যাবে না।</span>
    </div>

    <p class="form-msg" id="broadcastMsg"></p>

    <div class="broadcast-mode-tabs">
      <button class="myclub-tab active" data-mode="all" type="button">সব ক্লাব (উপজেলা ফিল্টার)</button>
      <button class="myclub-tab" data-mode="specific" type="button">নির্দিষ্ট ক্লাব বাছাই</button>
    </div>

    <div id="allModeFields">
      <label class="form-label">উপজেলা (ঐচ্ছিক — খালি রাখলে সব উপজেলা)</label>
      <select class="form-input" id="broadcastUpajilaSelect">
        <option value="">সব উপজেলা</option>
        <option value="feni-sadar">ফেনী সদর</option>
        <option value="chhagalnaiya">ছাগলনাইয়া</option>
        <option value="daganbhuiyan">দাগনভূঞা</option>
        <option value="parshuram">পরশুরাম</option>
        <option value="fulgazi">ফুলগাজী</option>
        <option value="sonagazi">সোনাগাজী</option>
      </select>
    </div>

    <div id="specificModeFields" style="display:none;">
      <label class="form-label">ক্লাব বাছাই করুন<span class="required-mark">*</span></label>
      <div class="broadcast-search-row">
        <input type="search" class="form-input" id="broadcastClubSearch" placeholder="ক্লাবের নাম খুঁজুন" autocomplete="off" />
        <button type="button" class="broadcast-selectall-btn" id="broadcastSelectAll">সবাইকে সিলেক্ট</button>
      </div>
      <div id="specificClubList" class="specific-club-list"></div>
    </div>

    <p class="broadcast-summary" id="broadcastSummary"></p>

    <button class="primary-btn" id="sendBroadcastBtn" type="button">
      <i class="fas fa-paper-plane"></i> <span>পাঠান</span>
    </button>
  </div>
</div>

<style is:global>
  .broadcast-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    align-items: flex-end;
    justify-content: center;
  }

  .broadcast-overlay.open {
    display: flex;
  }

  .broadcast-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
  }

  .broadcast-modal {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 520px;
    max-height: 86vh;
    overflow-y: auto;
    border-radius: 24px 24px 0 0;
    padding: 24px 20px 32px;
  }

  .broadcast-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
  }

  .broadcast-modal h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .broadcast-modal h3 i {
    color: #FF6B35;
  }

  .broadcast-post-title {
    font-size: 0.85rem;
    color: #8FA0BC;
    margin-bottom: 12px;
    margin-top: 4px;
  }

  .broadcast-note {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    background: #FFF4EC;
    border: 1px solid #FFD9C2;
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 14px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #1B2A4A;
  }

  .broadcast-note i {
    color: #FF6B35;
    margin-top: 3px;
  }

  .broadcast-mode-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .broadcast-search-row {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 10px;
  }

  .broadcast-search-row .form-input {
    flex: 1;
    min-width: 0;
  }

  .broadcast-selectall-btn {
    flex-shrink: 0;
    background: #FFF4EC;
    color: #FF6B35;
    border: 1px solid #FFD9C2;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .specific-club-list {
    max-height: 240px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .club-check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FBFCFE;
    border: 1px solid #EEF3F9;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 0.85rem;
    color: #1B2A4A;
    font-weight: 600;
  }

  .club-check-item input {
    width: auto;
    flex-shrink: 0;
  }

  .club-check-item .club-check-name {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .club-check-item.is-blocked {
    background: #F1F3F6;
    color: #9AA6B8;
    cursor: not-allowed;
  }

  .club-check-item .club-block-reason {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 600;
    color: #9AA6B8;
  }

  .broadcast-list-empty {
    font-size: 0.82rem;
    color: #8FA0BC;
    padding: 10px 4px;
  }

  .broadcast-summary {
    font-size: 0.82rem;
    font-weight: 600;
    color: #1B2A4A;
    margin: 14px 0 12px;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  let currentPostId = null;
  let currentClubId = null;
  let broadcastMode = 'all';
  let allClubs = [];
  let blockedToday = new Set();
  let blockedMonth = new Set();
  let selected = new Set();

  const $ = (id) => document.getElementById(id);

  function blockReason(id) {
    if (blockedMonth.has(id)) return 'এই মাসের সীমা শেষ';
    if (blockedToday.has(id)) return 'আজ পাঠানো হয়েছে';
    return '';
  }

  function isBlocked(id) {
    return blockedToday.has(id) || blockedMonth.has(id);
  }

  function allModeClubs() {
    const upajila = $('broadcastUpajilaSelect').value;
    return upajila ? allClubs.filter((c) => c.upajila === upajila) : allClubs;
  }

  function visibleSpecificClubs() {
    const q = ($('broadcastClubSearch').value || '').trim().toLowerCase();
    return q ? allClubs.filter((c) => (c.name || '').toLowerCase().includes(q)) : allClubs;
  }

  function updateSummary() {
    const el = $('broadcastSummary');
    if (broadcastMode === 'specific') {
      el.textContent = selected.size + ' টি ক্লাব নির্বাচিত';
      return;
    }
    const pool = allModeClubs();
    const ok = pool.filter((c) => !isBlocked(c.id)).length;
    const skipped = pool.length - ok;
    el.textContent = ok + ' টি ক্লাবকে যাবে' + (skipped > 0 ? ' (' + skipped + ' টি বাদ: আজ পাঠানো হয়েছে বা মাসের সীমা শেষ)' : '');
  }

  function updateSelectAllLabel() {
    const enabled = visibleSpecificClubs().filter((c) => !isBlocked(c.id));
    const allOn = enabled.length > 0 && enabled.every((c) => selected.has(c.id));
    $('broadcastSelectAll').textContent = allOn ? 'সব বাদ দিন' : 'সবাইকে সিলেক্ট';
  }

  function renderSpecificList() {
    const listEl = $('specificClubList');
    listEl.textContent = '';
    const clubs = visibleSpecificClubs();

    if (clubs.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'broadcast-list-empty';
      empty.textContent = 'কোনো ক্লাব পাওয়া যায়নি';
      listEl.appendChild(empty);
      updateSelectAllLabel();
      updateSummary();
      return;
    }

    clubs.forEach((c) => {
      const reason = blockReason(c.id);
      const item = document.createElement('label');
      item.className = 'club-check-item' + (reason ? ' is-blocked' : '');

      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.value = c.id;
      cb.disabled = !!reason;
      cb.checked = !reason && selected.has(c.id);
      cb.addEventListener('change', () => {
        if (cb.checked) selected.add(c.id);
        else selected.delete(c.id);
        updateSelectAllLabel();
        updateSummary();
      });

      const name = document.createElement('span');
      name.className = 'club-check-name';
      name.textContent = c.name || '';

      item.appendChild(cb);
      item.appendChild(name);

      if (reason) {
        const tag = document.createElement('span');
        tag.className = 'club-block-reason';
        tag.textContent = reason;
        item.appendChild(tag);
      }
      listEl.appendChild(item);
    });

    updateSelectAllLabel();
    updateSummary();
  }

  function setMode(mode) {
    broadcastMode = mode;
    document.querySelectorAll('.broadcast-mode-tabs .myclub-tab').forEach((t) => {
      t.classList.toggle('active', t.dataset.mode === mode);
    });
    $('allModeFields').style.display = mode === 'all' ? 'block' : 'none';
    $('specificModeFields').style.display = mode === 'specific' ? 'block' : 'none';
    if (mode === 'specific') renderSpecificList();
    else updateSummary();
  }

  function showMsg(text, isError) {
    const msgEl = $('broadcastMsg');
    msgEl.textContent = text || '';
    msgEl.className = text && isError ? 'form-msg show-error' : 'form-msg';
  }

  window.openBroadcastModal = async (postId, postTitle, clubId, clubName) => {
    currentPostId = postId;
    currentClubId = clubId;
    selected = new Set();
    allClubs = [];
    blockedToday = new Set();
    blockedMonth = new Set();

    $('broadcastPostTitle').textContent = postTitle || '';
    $('broadcastClubSearch').value = '';
    $('broadcastUpajilaSelect').value = '';
    showMsg('', false);
    setMode('all');
    $('broadcastSummary').textContent = 'লোড হচ্ছে...';
    $('broadcastOverlay').classList.add('open');

    const [clubsRes, quotaRes] = await Promise.all([
      supabase
        .from('clubs')
        .select('id, name, upajila')
        .eq('is_active', true)
        .neq('id', clubId)
        .order('name'),
      supabase.rpc('club_broadcast_quota', { p_club_id: clubId }),
    ]);

    allClubs = clubsRes.data || [];
    const q = quotaRes.data || {};
    blockedToday = new Set(q.blocked_today || []);
    blockedMonth = new Set(q.blocked_month || []);

    if (clubsRes.error) showMsg('ক্লাব তালিকা লোড হয়নি, আবার চেষ্টা করুন', true);

    if (broadcastMode === 'specific') renderSpecificList();
    else updateSummary();
  };

  $('broadcastClose')?.addEventListener('click', () => {
    $('broadcastOverlay').classList.remove('open');
  });

  document.querySelectorAll('.broadcast-mode-tabs .myclub-tab').forEach((btn) => {
    btn.addEventListener('click', () => setMode(btn.dataset.mode));
  });

  $('broadcastUpajilaSelect')?.addEventListener('change', updateSummary);
  $('broadcastClubSearch')?.addEventListener('input', renderSpecificList);

  $('broadcastSelectAll')?.addEventListener('click', () => {
    const enabled = visibleSpecificClubs().filter((c) => !isBlocked(c.id));
    const allOn = enabled.length > 0 && enabled.every((c) => selected.has(c.id));
    enabled.forEach((c) => {
      if (allOn) selected.delete(c.id);
      else selected.add(c.id);
    });
    renderSpecificList();
  });

  $('sendBroadcastBtn')?.addEventListener('click', async () => {
    const btn = $('sendBroadcastBtn');
    const span = btn.querySelector('span');

    let targetClubIds = [];
    if (broadcastMode === 'all') {
      targetClubIds = allModeClubs().filter((c) => !isBlocked(c.id)).map((c) => c.id);
    } else {
      targetClubIds = Array.from(selected).filter((id) => !isBlocked(id));
    }

    if (targetClubIds.length === 0) {
      showMsg('পাঠানোর মতো কোনো ক্লাব নেই (নির্বাচিত হয়নি, অথবা আজ পাঠানো হয়েছে/মাসের সীমা শেষ)', true);
      return;
    }

    span.textContent = 'পাঠানো হচ্ছে...';
    btn.disabled = true;

    const rows = targetClubIds.map((receiverId) => ({
      source_post_id: currentPostId,
      sender_club_id: currentClubId,
      receiver_club_id: receiverId,
    }));

    const { error } = await supabase.from('club_notifications').insert(rows);

    span.textContent = 'পাঠান';
    btn.disabled = false;

    if (error) {
      showMsg('ব্যর্থ: ' + error.message, true);
      return;
    }

    showMsg('', false);
    window.showToast(targetClubIds.length + ' টি ক্লাবকে জানানো হয়েছে ✓', 'success');
    setTimeout(() => {
      $('broadcastOverlay').classList.remove('open');
    }, 1200);
  });
</script>
