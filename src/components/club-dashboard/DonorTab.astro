<!-- path: src/components/club-dashboard/DonorTab.astro -->
---
---

<div class="dash-card">
  <h3><i class="fas fa-eye"></i> ক্লাব পেজে ডোনার লিস্ট</h3>
  <label class="donor-share-toggle" for="donorPublicToggle">
    <span class="donor-share-text">
      পাবলিকে ব্লাড ডোনার লিস্ট দেখান
      <small>চালু থাকলে ক্লাব পেজে সবাই (লগইন ছাড়াও) নাম, গ্রুপ, উপজেলা ও ফোন নম্বর দেখবে এবং কল করতে পারবে।</small>
    </span>
    <input type="checkbox" id="donorPublicToggle" />
    <span class="donor-switch"></span>
  </label>
</div>

<div class="dash-card" id="donorFormCard">
  <h3><i class="fas fa-droplet"></i> নতুন ডোনার যোগ করুন</h3>
  <p class="form-msg" id="donorMsg"></p>

  <label class="form-label">ডোনারের নাম<span class="required-mark">*</span></label>
  <input type="text" class="form-input" id="donorNameInput" required />
  <div class="field-error-msg" data-error-for="donorNameInput">
    <i class="fas fa-circle-exclamation"></i><span>ডোনারের নাম দিন</span>
  </div>

  <label class="form-label">ফোন নম্বর<span class="required-mark">*</span></label>
  <input type="text" class="form-input" id="donorPhoneInput" required placeholder="01xxxxxxxxx" />
  <div class="field-error-msg" data-error-for="donorPhoneInput">
    <i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর দিন</span>
  </div>

  <label class="form-label">ব্লাড গ্রুপ</label>
  <select class="form-input" id="donorGroupInput">
    <option value="A+">A+</option>
    <option value="A-">A-</option>
    <option value="B+">B+</option>
    <option value="B-">B-</option>
    <option value="AB+">AB+</option>
    <option value="AB-">AB-</option>
    <option value="O+">O+</option>
    <option value="O-">O-</option>
  </select>

  <label class="form-label">উপজেলা</label>
  <select class="form-input" id="donorUpazilaInput">
    <option value="">— ক্লাবের উপজেলা ব্যবহার হবে —</option>
    <option value="ফেনী সদর">ফেনী সদর</option>
    <option value="ছাগলনাইয়া">ছাগলনাইয়া</option>
    <option value="দাগনভূঞা">দাগনভূঞা</option>
    <option value="পরশুরাম">পরশুরাম</option>
    <option value="ফুলগাজী">ফুলগাজী</option>
    <option value="সোনাগাজী">সোনাগাজী</option>
  </select>

  <button class="primary-btn" id="addDonorBtn" type="button">
    <i class="fas fa-plus"></i> <span>যোগ করুন</span>
  </button>
</div>

<div class="dash-card">
  <h3><i class="fas fa-list"></i> আমার ডোনার লিস্ট</h3>
  <div id="donorExportRow" style="display:none; gap:8px; flex-wrap:wrap; margin-bottom:14px;">
    <button type="button" class="secondary-btn" id="donorDlPdf"><i class="fas fa-file-pdf"></i> PDF</button>
    <button type="button" class="secondary-btn" id="donorDlPng"><i class="fas fa-image"></i> ছবি</button>
    <button type="button" class="secondary-btn" id="donorDlXlsx"><i class="fas fa-file-excel"></i> Excel</button>
  </div>
  <div id="donorsList"></div>
  <p class="empty-note" id="donorsEmpty" style="display:none;">কোনো ডোনার যোগ করা হয়নি</p>
</div>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { downloadDonorList } from '../../lib/donorExport.js';

  let clubName = '';
  let clubId = null;
  let clubUpazilaLabel = null;
  let allDonors = [];

  function esc(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  const UPAZILA_LABELS = {
    'feni-sadar': 'ফেনী সদর',
    'chhagalnaiya': 'ছাগলনাইয়া',
    'daganbhuiyan': 'দাগনভূঞা',
    'parshuram': 'পরশুরাম',
    'fulgazi': 'ফুলগাজী',
    'sonagazi': 'সোনাগাজী',
  };

  const msgEl = document.getElementById('donorMsg');
  function showMsg(text, type = 'error') {
    msgEl.textContent = text;
    msgEl.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;
    // গ্লোবাল টোস্টেও দেখানো হয় — ইনলাইন মেসেজ স্ক্রিনের বাইরে থাকলেও যেন চোখে পড়ে
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  document.getElementById('addDonorBtn')?.addEventListener('click', async () => {
    if (!window.SFValidateForm(document.getElementById('donorFormCard'))) {
      return;
    }

    const name = document.getElementById('donorNameInput').value.trim();
    const phone = document.getElementById('donorPhoneInput').value.trim();
    const bloodGroup = document.getElementById('donorGroupInput').value;
    const selectedUpazila = document.getElementById('donorUpazilaInput').value;

    const btn = document.getElementById('addDonorBtn');
    const span = btn.querySelector('span');
    span.textContent = 'যোগ হচ্ছে...';
    btn.disabled = true;

    const { error } = await supabase.from('manual_blood_donors').upsert(
      {
        name,
        phone,
        blood_group: bloodGroup,
        upazila: selectedUpazila || clubUpazilaLabel,
        club_id: clubId,
        status: 'active',
        source: 'club-owner',
      },
      { onConflict: 'phone' }
    );

    span.textContent = 'যোগ করুন';
    btn.disabled = false;

    if (error) {
      showMsg('যোগ করতে ব্যর্থ: ' + error.message);
      return;
    }

    window.showToast('ডোনার যোগ হয়েছে ✓', 'success');
    document.getElementById('donorNameInput').value = '';
    document.getElementById('donorPhoneInput').value = '';
    document.getElementById('donorUpazilaInput').value = '';

    loadDonors();
  });

  function renderDonors() {
    const container = document.getElementById('donorsList');
    const emptyEl = document.getElementById('donorsEmpty');

    container.innerHTML = '';
    if (allDonors.length === 0) {
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    allDonors.forEach((d) => {
      const card = document.createElement('div');
      card.className = 'item-card';
      card.innerHTML = `
        <div class="item-photo-placeholder"><i class="fas fa-droplet"></i></div>
        <div class="item-body">
          <p class="item-title">${esc(d.name)} — ${esc(d.blood_group)}</p>
          <p class="item-sub">${esc(d.phone)} ${d.upazila ? '· ' + esc(d.upazila) : ''}</p>
        </div>
        <div class="item-actions">
          <button class="icon-btn delete"><i class="fas fa-trash"></i></button>
        </div>
      `;
      card.querySelector('.delete').addEventListener('click', () => deleteDonor(d.id));
      container.appendChild(card);
    });
  }

  async function deleteDonor(id) {
    if (!confirm('এই ডোনার এন্ট্রিটি মুছে ফেলতে চান?')) return;
    const { error } = await supabase.from('manual_blood_donors').delete().eq('id', id);
    if (error) {
      alert('ডিলিট ব্যর্থ: ' + error.message);
      return;
    }
    loadDonors();
  }

  async function loadDonors() {
    const { data } = await supabase
      .from('manual_blood_donors')
      .select('*')
      .eq('club_id', clubId)
      .order('created_at', { ascending: false });
    allDonors = data || [];
    renderDonors();
    const exportRow = document.getElementById('donorExportRow');
    if (exportRow) exportRow.style.display = allDonors.length ? 'flex' : 'none';
  }

  // ডাউনলোড বাটন (PDF / ছবি / Excel)
  [['donorDlPdf', 'pdf'], ['donorDlPng', 'png'], ['donorDlXlsx', 'xlsx']].forEach(([id, format]) => {
    const btn = document.getElementById(id);
    btn?.addEventListener('click', async () => {
      if (!allDonors.length) return;
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = 'তৈরি হচ্ছে...';
      try {
        const result = await downloadDonorList(format, allDonors, clubName);
        window.showToast(
          result.where === 'native'
            ? 'ফাইল সেভ হয়েছে: Documents/SmartFeni/' + result.filename
            : 'ডাউনলোড শুরু হয়েছে ✓',
          'success'
        );
      } catch (err) {
        window.showToast('ডাউনলোড ব্যর্থ: ' + (err?.message || 'আবার চেষ্টা করুন'), 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  });

  // পাবলিকে ডোনার লিস্ট দেখানোর টগল
  async function loadShareToggle() {
    const el = document.getElementById('donorPublicToggle');
    if (!el || !clubId) return;
    const { data } = await supabase.from('clubs').select('show_blood_donors').eq('id', clubId).maybeSingle();
    el.checked = !!data?.show_blood_donors;
  }

  document.getElementById('donorPublicToggle')?.addEventListener('change', async (ev) => {
    const el = ev.target;
    const want = el.checked;
    if (!clubId) { el.checked = !want; return; }
    if (want && !confirm('চালু করলে ক্লাব পেজে লগইন ছাড়া সবাই ডোনারদের নাম, গ্রুপ, উপজেলা ও ফোন নম্বর দেখতে পারবে। ডোনারদের সম্মতি নিয়েছেন তো? চালু করবেন?')) {
      el.checked = false;
      return;
    }
    el.disabled = true;
    const { data, error } = await supabase
      .from('clubs')
      .update({ show_blood_donors: want })
      .eq('id', clubId)
      .select('id');
    el.disabled = false;
    if (error || !data || data.length === 0) {
      el.checked = !want;
      window.showToast('বদলাতে ব্যর্থ: ' + (error?.message || 'অনুমতি নেই'), 'error');
      return;
    }
    window.showToast(want ? 'ক্লাব পেজে ডোনার লিস্ট এখন চালু ✓' : 'ক্লাব পেজে ডোনার লিস্ট বন্ধ করা হয়েছে ✓', 'success');
  });

  window.addEventListener('smartfeni:club-ready', (e) => {
    clubId = e.detail.clubId;
    clubName = e.detail.club?.name || '';
    clubUpazilaLabel = UPAZILA_LABELS[e.detail.club.upajila] || null;
    loadDonors();
    loadShareToggle();
  });
</script>

<style>
  .donor-share-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    cursor: pointer;
  }
  .donor-share-text {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    line-height: 1.4;
  }
  .donor-share-text small {
    display: block;
    font-weight: 500;
    font-size: 0.76rem;
    color: #5A6E85;
    margin-top: 4px;
  }
  .donor-share-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .donor-switch {
    position: relative;
    width: 50px;
    height: 28px;
    border-radius: 28px;
    background: #CBD5E1;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .donor-switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.25);
    transition: transform 0.2s;
  }
  .donor-share-toggle input:checked + .donor-switch { background: #16A34A; }
  .donor-share-toggle input:checked + .donor-switch::after { transform: translateX(22px); }
  .donor-share-toggle input:disabled + .donor-switch { opacity: 0.6; }
</style>