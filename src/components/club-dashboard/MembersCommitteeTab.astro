---
// ============================================================
// কম্পোনেন্ট: /my-club ড্যাশবোর্ড — সদস্য/কমিটি ম্যানেজমেন্ট
//
// আপডেট ৫:
// - আলাদা "কমিটি তালিকা" সেকশন সরানো হয়েছে। এখন শুধু একটা
//   "সদস্য তালিকা" — যেখানে কমিটি সদস্যরা position_order
//   অনুযায়ী আগে দেখাবে, তারপর সাধারণ সদস্যরা (created_at অনুযায়ী,
//   ডিফল্ট ক্রমে) পরে দেখাবে।
// - "কমিটি সদস্য?" চেকবক্স আগের মতোই আছে (অ্যাড ও এডিট ফর্ম দুই
//   জায়গাতেই) — টিক দিলে পদবি ও ক্রমিক নাম্বার ফিল্ড খুলবে, তাই
//   যেকোনো সাধারণ সদস্যকে পরে এডিট করে কমিটিতে ঢোকানো যাবে।
//
// আপডেট ৬ (permission CSS): my-club.astro এর init() ফাংশন body তে
// মডারেটরের can_manage_orders=false হলে 'mod-no-orders' ক্লাস বসায়
// (checkbox লেবেল: "জয়েন রিকোয়েস্ট/সদস্য ম্যানেজ করতে পারবে")।
// তখন "নতুন সদস্য যোগ করুন" বাটন/ফর্ম আর প্রতিটা সদস্যের এডিট/ডিলিট
// বাটন হাইড হবে — সদস্য তালিকা দেখা যাবে (view allowed)। CSS
// `#membersList .item-actions`-এ স্কোপ করা হয়েছে, যাতে অন্য ট্যাবের
// (যেমন PostsTab) একই নামের .item-actions ক্লাস প্রভাবিত না হয়।
// ============================================================
---

<button class="cta-toggle-btn" id="showMemberFormBtn" type="button">
  <i class="fas fa-user-plus"></i> নতুন সদস্য/কমিটি মেম্বার যোগ করুন
</button>

<div class="dash-card" id="memberFormBox" style="display:none;">
  <h3><i class="fas fa-user-plus"></i> নতুন সদস্য/কমিটি মেম্বার যোগ করুন</h3>
  <p class="form-msg" id="memberMsg"></p>

  <div class="photo-upload-circle" id="memberPhotoCircle">
    <img id="memberPhotoPreview" src="" alt="ছবি" />
    <i class="fas fa-user"></i>
  </div>
  <input type="file" id="memberPhotoInput" accept="image/*" style="display:none;" />

  <label class="form-label">নাম<span class="required-mark">*</span></label>
  <input type="text" class="form-input" id="memberNameInput" required />
  <div class="field-error-msg" data-error-for="memberNameInput">
    <i class="fas fa-circle-exclamation"></i><span>নাম দিন</span>
  </div>

  <label class="form-label">জন্ম তারিখ (ঐচ্ছিক)</label>
  <input type="date" class="form-input" id="memberDobInput" />

  <label class="form-label" style="display:flex;align-items:center;gap:8px;margin-top:16px;">
    <input type="checkbox" id="memberIsCommitteeInput" style="width:auto;" /> কমিটি সদস্য?
  </label>

  <div id="committeeFields" style="display:none;">
    <label class="form-label">পদবি</label>
    <input type="text" class="form-input" id="memberPositionInput" placeholder="যেমন: সভাপতি, সম্পাদক" />

    <p class="hint-note">নতুন কমিটি সদস্য তালিকার শেষে যোগ হবে। ক্রম বদলাতে নিচের তালিকায় "ক্রম বদলান" চাপুন।</p>
    <input type="hidden" id="memberOrderInput" value="" />
  </div>

  <button class="primary-btn" id="addMemberBtn" type="button">
    <i class="fas fa-plus"></i> <span>যোগ করুন</span>
  </button>
</div>

<div class="dash-card">
  <h3><i class="fas fa-user-group"></i> সদস্য তালিকা <span class="mc-count" id="mcCount"></span></h3>
  <div class="mc-tools" id="mcTools">
    <label class="mc-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="mcSearch" placeholder="নাম বা পদবি খুঁজুন" aria-label="সদস্য খুঁজুন" autocomplete="off" /></label>
    <button type="button" class="mc-reorder-btn" id="mcReorderBtn"><i class="fas fa-arrows-up-down"></i> ক্রম বদলান</button>
  </div>
  <p class="hint-note" id="mcHint">কমিটি আগে (ক্রম অনুযায়ী), সাধারণ সদস্যরা পরে দেখাবে।</p>
  <div id="membersList"></div>
  <p class="empty-note" id="membersEmpty" style="display:none;">এখনো কোনো সদস্য যোগ করা হয়নি</p>
</div>

<!-- ===== এডিট মোডাল ===== -->
<div class="edit-modal" id="editModal">
  <div class="edit-modal-backdrop" id="editModalBackdrop"></div>
  <div class="edit-modal-body">
    <button class="edit-modal-close" id="editModalClose" type="button"><i class="fas fa-xmark"></i></button>
    <h3><i class="fas fa-pen"></i> সদস্য তথ্য এডিট</h3>
    <p class="form-msg" id="editMsg"></p>

    <div class="photo-upload-circle" id="editPhotoCircle">
      <img id="editPhotoPreview" src="" alt="ছবি" />
      <i class="fas fa-user"></i>
    </div>
    <input type="file" id="editPhotoInput" accept="image/*" style="display:none;" />

    <label class="form-label">নাম<span class="required-mark">*</span></label>
    <input type="text" class="form-input" id="editNameInput" required />
    <div class="field-error-msg" data-error-for="editNameInput">
      <i class="fas fa-circle-exclamation"></i><span>নাম দিন</span>
    </div>

    <label class="form-label" style="display:flex;align-items:center;gap:8px;margin-top:16px;">
      <input type="checkbox" id="editIsCommitteeInput" style="width:auto;" /> কমিটি সদস্য?
    </label>

    <div id="editCommitteeFields" style="display:none;">
      <label class="form-label">পদবি</label>
      <input type="text" class="form-input" id="editPositionInput" placeholder="যেমন: সভাপতি, সম্পাদক" />

      <p class="hint-note">ক্রম বদলাতে তালিকায় "ক্রম বদলান" চাপুন।</p>
      <input type="hidden" id="editOrderInput" value="" />
    </div>

    <button class="primary-btn" id="saveEditBtn" type="button">
      <i class="fas fa-check"></i> <span>সেভ করুন</span>
    </button>
  </div>
</div>

<style is:global>
  .cta-toggle-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FFF0EA;
    color: #FF6B35;
    border: 1.5px dashed #FFD3BC;
    padding: 14px;
    border-radius: 16px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    margin-bottom: 18px;
  }

  .cta-toggle-btn:hover {
    background: #FF6B35;
    color: #fff;
    border-color: #FF6B35;
  }

  .hint-note {
    font-size: 0.76rem;
    color: #8FA0BC;
    margin: -6px 0 12px;
  }

  .item-actions {
    display: flex;
    gap: 6px;
  }

  .icon-btn.edit {
    background: #EAF2FF;
    color: #2F6FE0;
  }

  .committee-badge {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 700;
    color: #FF6B35;
    background: #FFF0EA;
    padding: 2px 8px;
    border-radius: 20px;
    margin-left: 6px;
  }

  /* ===== সদস্য তালিকা (কমপ্যাক্ট) ===== */
  .mc-count { font-size: 0.82rem; font-weight: 700; color: #8FA0BC; }
  .mc-tools { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
  .mc-search { flex: 1 1 180px; display: flex; align-items: center; gap: 8px; background: #F4F7FC; border-radius: 14px; padding: 0 12px; min-height: 44px; color: #8FA0BC; }
  .mc-search input { flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 0.92rem; color: #1B2A4A; outline: 0; min-height: 44px; }
  .mc-reorder-btn { min-height: 44px; border: 1.5px solid #D5DCE8; background: #fff; border-radius: 14px; padding: 0 14px; font: inherit; font-weight: 700; font-size: 0.85rem; color: #1B2A4A; cursor: pointer; }
  .mc-reorder-btn.on { background: #FFF0EA; border-color: #FF6B35; color: #FF6B35; }
  .mc-head { display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; font-weight: 700; color: #5A6E85; margin: 12px 2px 4px; }
  .mc-row { display: flex; align-items: center; gap: 10px; padding: 8px 4px; border-top: 1px solid #EEF2F8; min-height: 56px; background: #fff; }
  .mc-box > .mc-row:first-child { border-top: 0; }
  .mc-photo { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex: none; background: #F4F7FC; }
  .mc-ph { display: flex; align-items: center; justify-content: center; color: #B0BCCB; font-size: 0.95rem; }
  .mc-body { flex: 1; min-width: 0; }
  .mc-name { font-size: 0.93rem; font-weight: 700; color: #1B2A4A; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mc-sub { font-size: 0.76rem; color: #8FA0BC; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mc-grip { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #8A97AE; flex: none; }
  .mc-row .item-actions { flex: none; }
  .mc-more { width: 100%; min-height: 46px; margin-top: 8px; border: 1.5px dashed #FFD3BC; background: #FFF0EA; color: #FF6B35; border-radius: 14px; font: inherit; font-weight: 700; cursor: pointer; }
  body.mod-no-orders #mcReorderBtn { display: none !important; }

  /* ===== এডিট মোডাল ===== */
  .edit-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 400;
    align-items: flex-end;
    justify-content: center;
  }

  .edit-modal.open {
    display: flex;
  }

  .edit-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }

  .edit-modal-body {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 24px 24px 0 0;
    padding: 26px 20px 34px;
  }

  .edit-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    z-index: 2;
  }

  .edit-modal-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .edit-modal-body h3 i {
    color: #FF6B35;
  }
</style>

<!-- ============================================================
     পারমিশন-ভিত্তিক hide — my-club.astro এর init() ফাংশন body তে
     ক্লাস বসায়। is:global দরকার কারণ body এই কম্পোনেন্টের বাইরে।
     সিলেক্টর #membersList/#showMemberFormBtn/#memberFormBox দিয়ে
     স্কোপ করা হয়েছে, যাতে অন্য ট্যাবের একই ক্লাস নাম প্রভাবিত না হয়।
     ============================================================ -->
<style is:global>
  body.mod-no-orders #showMemberFormBtn,
  body.mod-no-orders #memberFormBox {
    display: none !important;
  }

  body.mod-no-orders #membersList .item-actions {
    display: none !important;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImage } from '../../lib/imageCompress.js';
  import { makeSortable } from '../../lib/sortable.js';
import { authFetch } from '../../lib/authToken.js';

  let clubId = null;
  let selectedPhotoFile = null;
  let editSelectedPhotoFile = null;
  let allMembers = [];
  let editingMemberId = null;

  document.getElementById('showMemberFormBtn')?.addEventListener('click', () => {
    document.getElementById('memberFormBox').style.display = 'block';
    document.getElementById('showMemberFormBtn').style.display = 'none';
  });

  const msgEl = document.getElementById('memberMsg');
  function showMsg(text, type = 'error') {
    msgEl.textContent = text;
    msgEl.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;
    // গ্লোবাল টোস্টেও দেখানো হয় — ইনলাইন মেসেজ স্ক্রিনের বাইরে থাকলেও যেন চোখে পড়ে
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  const editMsgEl = document.getElementById('editMsg');
  function showEditMsg(text, type = 'error') {
    editMsgEl.textContent = text;
    editMsgEl.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;
  }

  document.getElementById('memberPhotoCircle')?.addEventListener('click', () => {
    document.getElementById('memberPhotoInput').click();
  });

  document.getElementById('memberPhotoInput')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    selectedPhotoFile = await compressImage(file, { maxDimension: 1000 });
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById('memberPhotoPreview').src = reader.result;
      document.getElementById('memberPhotoCircle').classList.add('has-photo');
    };
    reader.readAsDataURL(selectedPhotoFile);
  });

  document.getElementById('memberIsCommitteeInput')?.addEventListener('change', (e) => {
    document.getElementById('committeeFields').style.display = e.target.checked ? 'block' : 'none';
  });

  // ===== এডিট মোডাল ফটো =====
  document.getElementById('editPhotoCircle')?.addEventListener('click', () => {
    document.getElementById('editPhotoInput').click();
  });

  document.getElementById('editPhotoInput')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    editSelectedPhotoFile = await compressImage(file, { maxDimension: 1000 });
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById('editPhotoPreview').src = reader.result;
      document.getElementById('editPhotoCircle').classList.add('has-photo');
    };
    reader.readAsDataURL(editSelectedPhotoFile);
  });

  document.getElementById('editIsCommitteeInput')?.addEventListener('change', (e) => {
    document.getElementById('editCommitteeFields').style.display = e.target.checked ? 'block' : 'none';
  });

  document.getElementById('editModalBackdrop')?.addEventListener('click', closeEditModal);
  document.getElementById('editModalClose')?.addEventListener('click', closeEditModal);

  function closeEditModal() {
    document.getElementById('editModal').classList.remove('open');
    editingMemberId = null;
    editSelectedPhotoFile = null;
  }

  // ছবি আপলোড — সার্ভার-সাইড /api/upload-image রুট দিয়ে (service role
  // key ব্যবহার করে)। ক্লায়েন্ট থেকে সরাসরি supabase.storage.upload()
  // কল করলে listing-images-এ ইউজারের SELECT পলিসি না থাকায়
  // INSERT…RETURNING ফেইল করে (RLS ভায়োলেশন)।
  async function uploadPhoto(file) {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return null;

    const ext = file.name.split('.').pop();
    const path = `club-members/${clubId}-${Date.now()}.${ext}`;

    const formData = new FormData();
    formData.append('file', file);
    formData.append('path', path);

    const res = await authFetch('/api/upload-image', {
      method: 'POST',
      headers: { Authorization: `Bearer ${session.access_token}` },
      body: formData,
    });
    const result = await res.json();

    if (!res.ok) {
      console.error('ছবি আপলোড এরর:', result.error);
      window.SFReportError?.({ kind: 'api_fail', action: 'club_member_photo_upload', title: 'ক্লাব সদস্যের ছবি আপলোড ব্যর্থ', message: String(result.error || res.status) });
      window.showToast?.('ছবি আপলোড হয়নি, আবার চেষ্টা করুন', 'error');
      return null;
    }
    return result.url || null;
  }

  document.getElementById('addMemberBtn')?.addEventListener('click', async () => {
    if (!window.SFValidateForm(document.getElementById('memberFormBox'))) {
      return;
    }

    const name = document.getElementById('memberNameInput').value.trim();

    const btn = document.getElementById('addMemberBtn');
    const span = btn.querySelector('span');
    span.textContent = 'যোগ হচ্ছে...';
    btn.disabled = true;

    let photoUrl = null;
    if (selectedPhotoFile) photoUrl = await uploadPhoto(selectedPhotoFile);

    const isCommittee = document.getElementById('memberIsCommitteeInput').checked;
    const newOrder = isCommittee ? nextCommitteeOrder() : 0;

    // ক্রমিক নাম্বার কনফ্লিক্ট চেক (কমিটি সদস্যদের মধ্যে) — কনফ্লিক্ট
    // থাকলে সেই নাম্বার ও তার পরের সবাইকে ১ ধাপ শিফট করে দেওয়া হয়
    if (isCommittee) {
      /* নতুন কমিটি সদস্য শেষে যোগ হয়, শিফট লাগে না */
    }

    const { error } = await supabase.from('club_members').insert({
      club_id: clubId,
      name,
      photo: photoUrl,
      dob: document.getElementById('memberDobInput').value || null,
      is_committee: isCommittee,
      position: isCommittee ? document.getElementById('memberPositionInput').value.trim() : null,
      position_order: newOrder,
    });

    span.textContent = 'যোগ করুন';
    btn.disabled = false;

    if (error) {
      showMsg('যোগ করা ব্যর্থ: ' + error.message);
      return;
    }

    window.showToast('যোগ হয়েছে ✓', 'success');
    document.getElementById('memberNameInput').value = '';
    document.getElementById('memberDobInput').value = '';
    document.getElementById('memberPositionInput').value = '';
    document.getElementById('memberOrderInput').value = '';
    document.getElementById('memberIsCommitteeInput').checked = false;
    document.getElementById('committeeFields').style.display = 'none';
    document.getElementById('memberPhotoCircle').classList.remove('has-photo');
    selectedPhotoFile = null;

    loadMembers();
  });

  // নতুন কমিটি সদস্য সবার শেষে যোগ হয় (ক্রম বদলাতে তালিকার "ক্রম বদলান" মোড)
  function nextCommitteeOrder() {
    let max = 0;
    allMembers.forEach((m) => {
      if (m.is_committee && (m.position_order || 0) > max) max = m.position_order || 0;
    });
    return max + 1;
  }

  function openEditModal(member) {
    editingMemberId = member.id;
    editSelectedPhotoFile = null;

    document.getElementById('editNameInput').value = member.name || '';
    document.getElementById('editPositionInput').value = member.position || '';
    document.getElementById('editOrderInput').value = member.position_order ?? 0;
    document.getElementById('editIsCommitteeInput').checked = !!member.is_committee;
    document.getElementById('editCommitteeFields').style.display = member.is_committee ? 'block' : 'none';

    const preview = document.getElementById('editPhotoPreview');
    const circle = document.getElementById('editPhotoCircle');
    if (member.photo) {
      preview.src = member.photo;
      circle.classList.add('has-photo');
    } else {
      preview.src = '';
      circle.classList.remove('has-photo');
    }

    editMsgEl.textContent = '';
    document.getElementById('editModal').classList.add('open');
  }

  document.getElementById('saveEditBtn')?.addEventListener('click', async () => {
    if (!editingMemberId) return;

    if (!window.SFValidateForm(document.getElementById('editModal'))) {
      return;
    }

    const name = document.getElementById('editNameInput').value.trim();

    const btn = document.getElementById('saveEditBtn');
    const span = btn.querySelector('span');
    span.textContent = 'সেভ হচ্ছে...';
    btn.disabled = true;

    let photoUrl = undefined; // undefined মানে ছবি বদলানো হয়নি
    if (editSelectedPhotoFile) {
      photoUrl = await uploadPhoto(editSelectedPhotoFile);
    }

    const isCommittee = document.getElementById('editIsCommitteeInput').checked;
    const prevM = allMembers.find((x) => x.id === editingMemberId);
    const newOrder = isCommittee ? (prevM && prevM.is_committee ? (prevM.position_order || 0) : nextCommitteeOrder()) : 0;

    if (isCommittee) {
      /* ক্রম অপরিবর্তিত বা শেষে, শিফট লাগে না */
    }

    const updatePayload = {
      name,
      is_committee: isCommittee,
      position: isCommittee ? document.getElementById('editPositionInput').value.trim() : null,
      position_order: newOrder,
    };
    if (photoUrl !== undefined && photoUrl !== null) updatePayload.photo = photoUrl;

    const { error } = await supabase.from('club_members').update(updatePayload).eq('id', editingMemberId);

    span.textContent = 'সেভ করুন';
    btn.disabled = false;

    if (error) {
      showEditMsg('সেভ ব্যর্থ: ' + error.message);
      return;
    }

    closeEditModal();
    window.showToast('তথ্য সেভ হয়েছে ✓', 'success');
    loadMembers();
  });

  // ---------- তালিকা UI: কমপ্যাক্ট সারি, সার্চ, আরও দেখুন, টেনে ক্রম বদল ----------
  const MC_PAGE = 15;
  const mcLimit = { c: MC_PAGE, r: MC_PAGE };
  let mcQuery = '';
  let mcReorder = false;
  let mcStop = null;

  function mcNum(n) {
    try { return Number(n).toLocaleString('bn-BD'); } catch (_) { return String(n); }
  }
  function mcEl(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    return e;
  }
  function mcRerender() {
    renderList(document.getElementById('membersList'), document.getElementById('membersEmpty'), allMembers);
  }

  function mcPlaceholder() {
    const ph = mcEl('div', 'mc-photo mc-ph');
    ph.innerHTML = '<i class="fas fa-user"></i>';
    return ph;
  }

  function mcRow(m, grip) {
    const row = mcEl('div', 'mc-row');
    row.setAttribute('data-id', m.id);
    if (m.photo) {
      const img = mcEl('img', 'mc-photo');
      img.src = m.photo;
      img.alt = '';
      img.loading = 'lazy';
      img.onerror = () => img.replaceWith(mcPlaceholder());
      row.appendChild(img);
    } else {
      row.appendChild(mcPlaceholder());
    }
    const body = mcEl('div', 'mc-body');
    body.appendChild(mcEl('div', 'mc-name', m.name || ''));
    const sub = m.position || (m.dob ? new Date(m.dob).toLocaleDateString('bn-BD') : '');
    if (sub) body.appendChild(mcEl('div', 'mc-sub', sub));
    row.appendChild(body);

    if (grip) {
      const g = mcEl('span', 'mc-grip');
      g.setAttribute('data-sort-handle', '1');
      g.setAttribute('aria-hidden', 'true');
      g.innerHTML = '<i class="fas fa-grip-vertical"></i>';
      row.appendChild(g);
      return row;
    }

    const act = mcEl('div', 'item-actions');
    const ed = mcEl('button', 'icon-btn edit');
    ed.type = 'button';
    ed.setAttribute('aria-label', (m.name || '') + ' এডিট');
    ed.innerHTML = '<i class="fas fa-pen"></i>';
    ed.addEventListener('click', () => openEditModal(m));
    const del = mcEl('button', 'icon-btn delete');
    del.type = 'button';
    del.setAttribute('aria-label', (m.name || '') + ' মুছুন');
    del.innerHTML = '<i class="fas fa-trash"></i>';
    del.addEventListener('click', () => deleteMember(m.id));
    act.appendChild(ed);
    act.appendChild(del);
    row.appendChild(act);
    return row;
  }

  function mcSection(container, title, list, key, canMore, grip) {
    if (!list.length) return null;
    const hd = mcEl('div', 'mc-head');
    hd.appendChild(mcEl('span', '', title));
    hd.appendChild(mcEl('span', '', mcNum(list.length)));
    container.appendChild(hd);
    const box = mcEl('div', 'mc-box');
    const shown = canMore ? list.slice(0, mcLimit[key]) : list;
    shown.forEach((m) => box.appendChild(mcRow(m, grip)));
    container.appendChild(box);
    if (canMore && list.length > shown.length) {
      const more = mcEl('button', 'mc-more', 'আরও দেখুন (' + mcNum(list.length - shown.length) + ')');
      more.type = 'button';
      more.addEventListener('click', () => {
        mcLimit[key] += MC_PAGE;
        mcRerender();
      });
      container.appendChild(more);
    }
    return box;
  }

  async function saveCommitteeOrder(ids) {
    const { data, error } = await supabase.rpc('club_reorder_members', { p_club_id: clubId, p_ids: ids });
    if (error || !data || !data.ok) {
      window.showToast?.('ক্রম সেভ হয়নি, আবার চেষ্টা করুন', 'error');
      await loadMembers();
      return;
    }
    ids.forEach((id, i) => {
      const m = allMembers.find((x) => x.id === id);
      if (m) m.position_order = i + 1;
    });
    allMembers = [
      ...allMembers.filter((m) => m.is_committee).sort((a, b) => (a.position_order || 0) - (b.position_order || 0)),
      ...allMembers.filter((m) => !m.is_committee),
    ];
    window.showToast?.('ক্রম সেভ হয়েছে ✓', 'success', 1500);
  }

  function renderList(container, emptyEl, items) {
    if (mcStop) { mcStop(); mcStop = null; }
    container.textContent = '';
    const cnt = document.getElementById('mcCount');
    const tools = document.getElementById('mcTools');
    if (cnt) cnt.textContent = items.length ? '(' + mcNum(items.length) + ')' : '';
    if (items.length === 0) {
      emptyEl.style.display = 'block';
      if (tools) tools.style.display = 'none';
      return;
    }
    emptyEl.style.display = 'none';
    if (tools) tools.style.display = '';

    const committee = items.filter((m) => m.is_committee);
    const regular = items.filter((m) => !m.is_committee);

    const rb = document.getElementById('mcReorderBtn');
    if (rb) {
      const canReorder = committee.length > 1 && !mcQuery.trim();
      rb.style.display = canReorder || mcReorder ? '' : 'none';
      rb.classList.toggle('on', mcReorder);
      rb.innerHTML = mcReorder ? '<i class="fas fa-check"></i> ক্রম ঠিক আছে' : '<i class="fas fa-arrows-up-down"></i> ক্রম বদলান';
    }
    const hint = document.getElementById('mcHint');
    if (hint) {
      hint.textContent = mcReorder
        ? 'কমিটির সদস্যকে চেপে ধরে ওপর-নিচে টেনে ক্রম সাজান। শেষ হলে ✓ চাপুন।'
        : 'কমিটি আগে (ক্রম অনুযায়ী), সাধারণ সদস্যরা পরে দেখাবে।';
    }

    if (mcReorder) {
      const box = mcSection(container, 'কমিটি', committee, 'c', false, true);
      if (box && committee.length > 1) mcStop = makeSortable(box, { itemSelector: '.mc-row', onChange: saveCommitteeOrder });
      return;
    }

    const q = mcQuery.trim().toLowerCase();
    const match = (m) => !q || String(m.name || '').toLowerCase().includes(q) || String(m.position || '').toLowerCase().includes(q);
    const cs = committee.filter(match);
    const rs = regular.filter(match);
    mcSection(container, 'কমিটি', cs, 'c', !q, false);
    mcSection(container, 'সাধারণ সদস্য', rs, 'r', !q, false);
    if (!cs.length && !rs.length) container.appendChild(mcEl('p', 'hint-note', 'কোনো সদস্য মেলেনি'));
  }

  document.getElementById('mcSearch')?.addEventListener('input', (e) => {
    mcQuery = e.target.value;
    mcReorder = false;
    mcLimit.c = MC_PAGE;
    mcLimit.r = MC_PAGE;
    mcRerender();
  });
  document.getElementById('mcReorderBtn')?.addEventListener('click', () => {
    mcReorder = !mcReorder;
    if (mcReorder) {
      mcQuery = '';
      const s = document.getElementById('mcSearch');
      if (s) s.value = '';
    }
    mcRerender();
  });

  async function deleteMember(id) {
    if (!confirm('এই সদস্যকে মুছে ফেলতে চান?')) return;

    // ধাপ ১: মেম্বার রেকর্ডটা আগে fetch করে user_id বের করা —
    // যাতে সংশ্লিষ্ট join_request খুঁজে পাওয়া যায়
    const memberToDelete = allMembers.find((m) => m.id === id);
    const memberUserId = memberToDelete?.user_id || null;

    // ধাপ ২: club_members থেকে delete (আগের মতোই)
    const { error } = await supabase.from('club_members').delete().eq('id', id);
    if (error) {
      alert('ডিলিট ব্যর্থ: ' + error.message);
      return;
    }

    // ধাপ ৩: যদি এই মেম্বার রেজিস্টার্ড ইউজার থেকে আসা হয় (user_id আছে),
    // তাহলে সংশ্লিষ্ট accepted join_request-টা status='rejected' এ
    // আপডেট করে দিতে হবে (delete() না, কারণ RLS-এ DELETE পলিসি নেই —
    // শুধু owner-এর জন্য UPDATE পলিসি আছে)
    if (memberUserId) {
      const { error: joinReqError } = await supabase
        .from('club_join_requests')
        .update({ status: 'rejected' })
        .eq('club_id', clubId)
        .eq('user_id', memberUserId)
        .eq('status', 'accepted');

      if (joinReqError) {
        console.error('join_request status রিসেট ব্যর্থ:', joinReqError.message);
        // এটা silent fail — মূল delete সফল হয়েছে, তাই ইউজারকে
        // এলার্ট দেখানো হচ্ছে না, শুধু কনসোলে লগ রাখা হলো
      }
    }

    loadMembers();
  }

  const MEMBER_COLS = 'id, club_id, user_id, name, photo, position, position_order, is_committee, created_at';

  async function loadMembers() {
    // কমিটি সদস্যরা position_order অনুযায়ী, তারপর সাধারণ সদস্য created_at অনুযায়ী
    const { data: committeeData } = await supabase
      .from('club_members')
      .select(MEMBER_COLS)
      .eq('club_id', clubId)
      .eq('is_committee', true)
      .order('position_order', { ascending: true })
      .order('created_at', { ascending: true });

    const { data: regularData } = await supabase
      .from('club_members')
      .select(MEMBER_COLS)
      .eq('club_id', clubId)
      .eq('is_committee', false)
      .order('created_at', { ascending: true });

    // জন্মতারিখ পাবলিক টেবিল-পড়ায় নেই; আলাদা RPC (শুধু ওউনার/মডারেটর/অ্যাডমিন)
    const dobMap = {};
    try {
      const { data: dobs } = await supabase.rpc('club_member_dobs', { p_club_id: clubId });
      (dobs || []).forEach((r) => { dobMap[r.id] = r.dob; });
    } catch (_) { /* জন্মতারিখ ছাড়াই চলবে */ }

    allMembers = [...(committeeData || []), ...(regularData || [])].map((m) => ({ ...m, dob: dobMap[m.id] || null }));

    renderList(document.getElementById('membersList'), document.getElementById('membersEmpty'), allMembers);
  }

  window.addEventListener('smartfeni:club-ready', (e) => {
    clubId = e.detail.clubId;
    loadMembers();
  });
</script>
