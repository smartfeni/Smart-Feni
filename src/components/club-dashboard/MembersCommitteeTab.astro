---
// ============================================================
// কম্পোনেন্ট: /my-club ড্যাশবোর্ড — সদস্য/কমিটি ম্যানেজমেন্ট
//
// আপডেট ৫ (সর্বশেষ):
// - আলাদা "কমিটি তালিকা" সেকশন সরানো হয়েছে। এখন শুধু একটা
//   "সদস্য তালিকা" — যেখানে কমিটি সদস্যরা position_order
//   অনুযায়ী আগে দেখাবে, তারপর সাধারণ সদস্যরা (created_at অনুযায়ী,
//   ডিফল্ট ক্রমে) পরে দেখাবে।
// - "কমিটি সদস্য?" চেকবক্স আগের মতোই আছে (অ্যাড ও এডিট ফর্ম দুই
//   জায়গাতেই) — টিক দিলে পদবি ও ক্রমিক নাম্বার ফিল্ড খুলবে, তাই
//   যেকোনো সাধারণ সদস্যকে পরে এডিট করে কমিটিতে ঢোকানো যাবে।
// ============================================================
---

<button class="cta-toggle-btn" id="showMemberFormBtn" type="button">
  <i class="fas fa-user-plus"></i> নতুন সদস্য/কমিটি মেম্বার যোগ করুন
</button>

<div class="dash-card" id="memberFormBox" style="display:none;">
  <h3><i class="fas fa-user-plus"></i> নতুন সদস্য/কমিটি মেম্বার যোগ করুন</h3>
  <p class="form-msg" id="memberMsg"></p>

  <div class="photo-upload-circle" id="memberPhotoCircle">
    <img id="memberPhotoPreview" src="" alt="ছবি" />
    <i class="fas fa-user"></i>
  </div>
  <input type="file" id="memberPhotoInput" accept="image/*" style="display:none;" />

  <label class="form-label">নাম</label>
  <input type="text" class="form-input" id="memberNameInput" />

  <label class="form-label">জন্ম তারিখ (ঐচ্ছিক)</label>
  <input type="date" class="form-input" id="memberDobInput" />

  <label class="form-label" style="display:flex;align-items:center;gap:8px;margin-top:16px;">
    <input type="checkbox" id="memberIsCommitteeInput" style="width:auto;" /> কমিটি সদস্য?
  </label>

  <div id="committeeFields" style="display:none;">
    <label class="form-label">পদবি</label>
    <input type="text" class="form-input" id="memberPositionInput" placeholder="যেমন: সভাপতি, সম্পাদক" />

    <label class="form-label">ক্রম (উপরে দেখানোর জন্য, ছোট সংখ্যা আগে — সভাপতির জন্য 1 দিন)</label>
    <input type="number" class="form-input" id="memberOrderInput" placeholder="0" />
  </div>

  <button class="primary-btn" id="addMemberBtn" type="button">
    <i class="fas fa-plus"></i> <span>যোগ করুন</span>
  </button>
</div>

<div class="dash-card">
  <h3><i class="fas fa-user-group"></i> সদস্য তালিকা</h3>
  <p class="hint-note">কমিটি সদস্যরা ক্রমিক অনুযায়ী আগে, সাধারণ সদস্যরা পরে দেখাবে</p>
  <div id="membersList"></div>
  <p class="empty-note" id="membersEmpty" style="display:none;">এখনো কোনো সদস্য যোগ করা হয়নি</p>
</div>

<!-- ===== এডিট মোডাল ===== -->
<div class="edit-modal" id="editModal">
  <div class="edit-modal-backdrop" id="editModalBackdrop"></div>
  <div class="edit-modal-body">
    <button class="edit-modal-close" id="editModalClose" type="button"><i class="fas fa-xmark"></i></button>
    <h3><i class="fas fa-pen"></i> সদস্য তথ্য এডিট</h3>
    <p class="form-msg" id="editMsg"></p>

    <div class="photo-upload-circle" id="editPhotoCircle">
      <img id="editPhotoPreview" src="" alt="ছবি" />
      <i class="fas fa-user"></i>
    </div>
    <input type="file" id="editPhotoInput" accept="image/*" style="display:none;" />

    <label class="form-label">নাম</label>
    <input type="text" class="form-input" id="editNameInput" />

    <label class="form-label" style="display:flex;align-items:center;gap:8px;margin-top:16px;">
      <input type="checkbox" id="editIsCommitteeInput" style="width:auto;" /> কমিটি সদস্য?
    </label>

    <div id="editCommitteeFields" style="display:none;">
      <label class="form-label">পদবি</label>
      <input type="text" class="form-input" id="editPositionInput" placeholder="যেমন: সভাপতি, সম্পাদক" />

      <label class="form-label">ক্রম (একই ক্রম আরেকজনের থাকলে, সেই ও পরের সবাই ১ ধাপ সরে যাবে)</label>
      <input type="number" class="form-input" id="editOrderInput" placeholder="0" />
    </div>

    <button class="primary-btn" id="saveEditBtn" type="button">
      <i class="fas fa-check"></i> <span>সেভ করুন</span>
    </button>
  </div>
</div>

<style>
  .cta-toggle-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FFF0EA;
    color: #FF6B35;
    border: 1.5px dashed #FFD3BC;
    padding: 14px;
    border-radius: 16px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    margin-bottom: 18px;
  }

  .cta-toggle-btn:hover {
    background: #FF6B35;
    color: #fff;
    border-color: #FF6B35;
  }

  .hint-note {
    font-size: 0.76rem;
    color: #8FA0BC;
    margin: -6px 0 12px;
  }

  .item-actions {
    display: flex;
    gap: 6px;
  }

  .icon-btn.edit {
    background: #EAF2FF;
    color: #2F6FE0;
  }

  .committee-badge {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 700;
    color: #FF6B35;
    background: #FFF0EA;
    padding: 2px 8px;
    border-radius: 20px;
    margin-left: 6px;
  }

  /* ===== এডিট মোডাল ===== */
  .edit-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 400;
    align-items: flex-end;
    justify-content: center;
  }

  .edit-modal.open {
    display: flex;
  }

  .edit-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }

  .edit-modal-body {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 24px 24px 0 0;
    padding: 26px 20px 34px;
  }

  .edit-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
    z-index: 2;
  }

  .edit-modal-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .edit-modal-body h3 i {
    color: #FF6B35;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImage } from '../../lib/imageCompress.js';

  let clubId = null;
  let selectedPhotoFile = null;
  let editSelectedPhotoFile = null;
  let allMembers = [];
  let editingMemberId = null;

  document.getElementById('showMemberFormBtn')?.addEventListener('click', () => {
    document.getElementById('memberFormBox').style.display = 'block';
    document.getElementById('showMemberFormBtn').style.display = 'none';
  });

  const msgEl = document.getElementById('memberMsg');
  function showMsg(text, type = 'error') {
    msgEl.textContent = text;
    msgEl.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;
  }

  const editMsgEl = document.getElementById('editMsg');
  function showEditMsg(text, type = 'error') {
    editMsgEl.textContent = text;
    editMsgEl.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;
  }

  document.getElementById('memberPhotoCircle')?.addEventListener('click', () => {
    document.getElementById('memberPhotoInput').click();
  });

  document.getElementById('memberPhotoInput')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    selectedPhotoFile = await compressImage(file, { maxDimension: 1000 });
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById('memberPhotoPreview').src = reader.result;
      document.getElementById('memberPhotoCircle').classList.add('has-photo');
    };
    reader.readAsDataURL(selectedPhotoFile);
  });

  document.getElementById('memberIsCommitteeInput')?.addEventListener('change', (e) => {
    document.getElementById('committeeFields').style.display = e.target.checked ? 'block' : 'none';
  });

  // ===== এডিট মোডাল ফটো =====
  document.getElementById('editPhotoCircle')?.addEventListener('click', () => {
    document.getElementById('editPhotoInput').click();
  });

  document.getElementById('editPhotoInput')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    editSelectedPhotoFile = await compressImage(file, { maxDimension: 1000 });
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById('editPhotoPreview').src = reader.result;
      document.getElementById('editPhotoCircle').classList.add('has-photo');
    };
    reader.readAsDataURL(editSelectedPhotoFile);
  });

  document.getElementById('editIsCommitteeInput')?.addEventListener('change', (e) => {
    document.getElementById('editCommitteeFields').style.display = e.target.checked ? 'block' : 'none';
  });

  document.getElementById('editModalBackdrop')?.addEventListener('click', closeEditModal);
  document.getElementById('editModalClose')?.addEventListener('click', closeEditModal);

  function closeEditModal() {
    document.getElementById('editModal').classList.remove('open');
    editingMemberId = null;
    editSelectedPhotoFile = null;
  }

  // ছবি আপলোড — সার্ভার-সাইড /api/upload-image রুট দিয়ে (service role
  // key ব্যবহার করে)। ক্লায়েন্ট থেকে সরাসরি supabase.storage.upload()
  // কল করলে JWT ভেরিফাই ব্যর্থ হয় (RLS ভায়োলেশন)।
  async function uploadPhoto(file) {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return null;

    const ext = file.name.split('.').pop();
    const path = `club-members/${clubId}-${Date.now()}.${ext}`;

    const formData = new FormData();
    formData.append('file', file);
    formData.append('path', path);

    const res = await fetch('/api/upload-image', {
      method: 'POST',
      headers: { Authorization: `Bearer ${session.access_token}` },
      body: formData,
    });
    const result = await res.json();

    if (!res.ok) {
      console.error('ছবি আপলোড এরর:', result.error);
      return null;
    }
    return result.url || null;
  }

  document.getElementById('addMemberBtn')?.addEventListener('click', async () => {
    const name = document.getElementById('memberNameInput').value.trim();
    if (!name) {
      showMsg('নাম দিন');
      return;
    }

    const btn = document.getElementById('addMemberBtn');
    const span = btn.querySelector('span');
    span.textContent = 'যোগ হচ্ছে...';
    btn.disabled = true;

    let photoUrl = null;
    if (selectedPhotoFile) photoUrl = await uploadPhoto(selectedPhotoFile);

    const isCommittee = document.getElementById('memberIsCommitteeInput').checked;
    const newOrder = isCommittee ? (parseInt(document.getElementById('memberOrderInput').value) || 0) : 0;

    // ক্রমিক নাম্বার কনফ্লিক্ট চেক (কমিটি সদস্যদের মধ্যে) — কনফ্লিক্ট
    // থাকলে সেই নাম্বার ও তার পরের সবাইকে ১ ধাপ শিফট করে দেওয়া হয়
    if (isCommittee) {
      await shiftOrdersIfNeeded(newOrder, null);
    }

    const { error } = await supabase.from('club_members').insert({
      club_id: clubId,
      name,
      photo: photoUrl,
      dob: document.getElementById('memberDobInput').value || null,
      is_committee: isCommittee,
      position: isCommittee ? document.getElementById('memberPositionInput').value.trim() : null,
      position_order: newOrder,
    });

    span.textContent = 'যোগ করুন';
    btn.disabled = false;

    if (error) {
      showMsg('যোগ করা ব্যর্থ: ' + error.message);
      return;
    }

    showMsg('যোগ হয়েছে ✓', 'success');
    document.getElementById('memberNameInput').value = '';
    document.getElementById('memberDobInput').value = '';
    document.getElementById('memberPositionInput').value = '';
    document.getElementById('memberOrderInput').value = '';
    document.getElementById('memberIsCommitteeInput').checked = false;
    document.getElementById('committeeFields').style.display = 'none';
    document.getElementById('memberPhotoCircle').classList.remove('has-photo');
    selectedPhotoFile = null;

    loadMembers();
  });

  // নতুন/এডিট করা এন্ট্রির ক্রমিক নাম্বার যদি আরেকজন কমিটি মেম্বারের
  // সাথে কনফ্লিক্ট করে, তাহলে সেই ও তার পরের সবার ক্রমিক ১ ধাপ করে
  // বাড়িয়ে দেওয়া হয় (cascade shift), যাতে ডুপ্লিকেট না থাকে।
  // excludeId: এডিট করার সময় নিজেকে বাদ দিতে হবে হিসাব থেকে।
  async function shiftOrdersIfNeeded(targetOrder, excludeId) {
    let query = supabase
      .from('club_members')
      .select('id, position_order')
      .eq('club_id', clubId)
      .eq('is_committee', true)
      .gte('position_order', targetOrder)
      .order('position_order', { ascending: true });

    if (excludeId) query = query.neq('id', excludeId);

    const { data: toShift } = await query;
    if (!toShift || toShift.length === 0) return;

    // ধারাবাহিক ব্লক (কোনো গ্যাপ ছাড়া) যতদূর আছে ততদূর শিফট করবো,
    // যাতে অপ্রয়োজনীয়ভাবে সবার ক্রমিক না বাড়ে
    let expected = targetOrder;
    const idsToShift = [];
    for (const m of toShift) {
      if (m.position_order === expected) {
        idsToShift.push(m.id);
        expected += 1;
      } else {
        break;
      }
    }

    // পেছন থেকে সামনের দিকে আপডেট করা হচ্ছে যাতে মাঝপথে কোনো
    // ইউনিক-জাতীয় কনফ্লিক্ট না হয়
    for (let i = idsToShift.length - 1; i >= 0; i--) {
      const id = idsToShift[i];
      const oldOrder = toShift.find((m) => m.id === id).position_order;
      await supabase.from('club_members').update({ position_order: oldOrder + 1 }).eq('id', id);
    }
  }

  function openEditModal(member) {
    editingMemberId = member.id;
    editSelectedPhotoFile = null;

    document.getElementById('editNameInput').value = member.name || '';
    document.getElementById('editPositionInput').value = member.position || '';
    document.getElementById('editOrderInput').value = member.position_order ?? 0;
    document.getElementById('editIsCommitteeInput').checked = !!member.is_committee;
    document.getElementById('editCommitteeFields').style.display = member.is_committee ? 'block' : 'none';

    const preview = document.getElementById('editPhotoPreview');
    const circle = document.getElementById('editPhotoCircle');
    if (member.photo) {
      preview.src = member.photo;
      circle.classList.add('has-photo');
    } else {
      preview.src = '';
      circle.classList.remove('has-photo');
    }

    editMsgEl.textContent = '';
    document.getElementById('editModal').classList.add('open');
  }

  document.getElementById('saveEditBtn')?.addEventListener('click', async () => {
    if (!editingMemberId) return;

    const name = document.getElementById('editNameInput').value.trim();
    if (!name) {
      showEditMsg('নাম দিন');
      return;
    }

    const btn = document.getElementById('saveEditBtn');
    const span = btn.querySelector('span');
    span.textContent = 'সেভ হচ্ছে...';
    btn.disabled = true;

    let photoUrl = undefined; // undefined মানে ছবি বদলানো হয়নি
    if (editSelectedPhotoFile) {
      photoUrl = await uploadPhoto(editSelectedPhotoFile);
    }

    const isCommittee = document.getElementById('editIsCommitteeInput').checked;
    const newOrder = isCommittee ? (parseInt(document.getElementById('editOrderInput').value) || 0) : 0;

    if (isCommittee) {
      await shiftOrdersIfNeeded(newOrder, editingMemberId);
    }

    const updatePayload = {
      name,
      is_committee: isCommittee,
      position: isCommittee ? document.getElementById('editPositionInput').value.trim() : null,
      position_order: newOrder,
    };
    if (photoUrl !== undefined && photoUrl !== null) updatePayload.photo = photoUrl;

    const { error } = await supabase.from('club_members').update(updatePayload).eq('id', editingMemberId);

    span.textContent = 'সেভ করুন';
    btn.disabled = false;

    if (error) {
      showEditMsg('সেভ ব্যর্থ: ' + error.message);
      return;
    }

    closeEditModal();
    loadMembers();
  });

  function renderList(container, emptyEl, items) {
    container.innerHTML = '';
    if (items.length === 0) {
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    items.forEach((m) => {
      const card = document.createElement('div');
      card.className = 'item-card';
      card.innerHTML = `
        ${m.photo ? `<img class="item-photo" src="${m.photo}" alt="${m.name}" />` : `<div class="item-photo-placeholder"><i class="fas fa-user"></i></div>`}
        <div class="item-body">
          <p class="item-title">${m.name}${m.is_committee ? '<span class="committee-badge">কমিটি</span>' : ''}</p>
          <p class="item-sub">${m.position || (m.dob ? new Date(m.dob).toLocaleDateString('bn-BD') : '')}</p>
        </div>
        <div class="item-actions">
          <button class="icon-btn edit"><i class="fas fa-pen"></i></button>
          <button class="icon-btn delete"><i class="fas fa-trash"></i></button>
        </div>
      `;
      card.querySelector('.edit').addEventListener('click', () => openEditModal(m));
      card.querySelector('.delete').addEventListener('click', () => deleteMember(m.id));
      container.appendChild(card);
    });
  }

  async function deleteMember(id) {
    if (!confirm('এই সদস্যকে মুছে ফেলতে চান?')) return;

    // ধাপ ১: মেম্বার রেকর্ডটা আগে fetch করে user_id বের করা —
    // যাতে সংশ্লিষ্ট join_request খুঁজে পাওয়া যায়
    const memberToDelete = allMembers.find((m) => m.id === id);
    const memberUserId = memberToDelete?.user_id || null;

    // ধাপ ২: club_members থেকে delete (আগের মতোই)
    const { error } = await supabase.from('club_members').delete().eq('id', id);
    if (error) {
      alert('ডিলিট ব্যর্থ: ' + error.message);
      return;
    }

    // ধাপ ৩: যদি এই মেম্বার রেজিস্টার্ড ইউজার থেকে আসা হয় (user_id আছে),
    // তাহলে সংশ্লিষ্ট accepted join_request-টা status='rejected' এ
    // আপডেট করে দিতে হবে (delete() না, কারণ RLS-এ DELETE পলিসি নেই —
    // শুধু owner-এর জন্য UPDATE পলিসি আছে)
    if (memberUserId) {
      const { error: joinReqError } = await supabase
        .from('club_join_requests')
        .update({ status: 'rejected' })
        .eq('club_id', clubId)
        .eq('user_id', memberUserId)
        .eq('status', 'accepted');

      if (joinReqError) {
        console.error('join_request status রিসেট ব্যর্থ:', joinReqError.message);
        // এটা silent fail — মূল delete সফল হয়েছে, তাই ইউজারকে
        // এলার্ট দেখানো হচ্ছে না, শুধু কনসোলে লগ রাখা হলো
      }
    }

    loadMembers();
  }

  async function loadMembers() {
    // কমিটি সদস্যরা position_order অনুযায়ী, তারপর সাধারণ সদস্যরা
    // created_at অনুযায়ী — দুইটা আলাদা কোয়েরি করে একসাথে জোড়া
    // লাগানো হচ্ছে
    const { data: committeeData } = await supabase
      .from('club_members')
      .select('*')
      .eq('club_id', clubId)
      .eq('is_committee', true)
      .order('position_order', { ascending: true });

    const { data: regularData } = await supabase
      .from('club_members')
      .select('*')
      .eq('club_id', clubId)
      .eq('is_committee', false)
      .order('created_at', { ascending: true });

    allMembers = [...(committeeData || []), ...(regularData || [])];

    renderList(document.getElementById('membersList'), document.getElementById('membersEmpty'), allMembers);
  }

  window.addEventListener('smartfeni:club-ready', (e) => {
    clubId = e.detail.clubId;
    loadMembers();
  });
</script>