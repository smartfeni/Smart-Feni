---
// ============================================================
// কম্পোনেন্ট: /my-club ড্যাশবোর্ড — ক্লাব প্রোফাইল এডিট
//
// আপডেট (permission CSS): my-club.astro এর init() ফাংশন body তে
// 'mod-no-settings' ক্লাস বসায় যখন মডারেটরের can_edit_settings
// পারমিশন নেই। তখন সব ইনপুট readonly-দেখাবে (ভিউ করা যাবে, এডিট
// না), লোগো/কভার পরিবর্তন ও সেভ বাটন হাইড হয়ে যাবে।
// আপডেট (U3.3): কভারের সর্বোচ্চ সাইজ ১৬০০ → ১২৮০px, আপলোডে
// cacheControl ১ বছর (আগে ডিফল্ট ছিল মাত্র ১ ঘণ্টা) — ছবি দ্রুত লোড হবে।
// আপডেট (বাগফিক্স, ২ নভে): লোগো/কভার আপলোড এখন সার্ভার-সাইড /api/upload-image
// দিয়ে (service role)। ক্লায়েন্ট থেকে সরাসরি supabase.storage.upload() কল করলে
// listing-images বাকেটে ইউজারের SELECT পলিসি নেই, তাই Storage-এর INSERT…RETURNING ফেইল করে
// ("new row violates row-level security policy")।
// আপডেট (ম্যাপ লিংক): Latitude/Longitude দুই ঘরের বদলে একটাই "গুগল ম্যাপ লিংক" ঘর।
// লিংক যেমন আছে তেমন clubs.map_link-এ সেভ হয়; পাবলিক পেজে বাটন ট্যাপে সেই লিংকই খোলে।
// ============================================================
---

<div class="dash-card">
  <h3><i class="fas fa-id-card"></i> ক্লাব প্রোফাইল</h3>
  <p class="form-msg" id="profileMsg"></p>

  <div class="photo-upload-circle" id="logoCircle">
    <img id="logoPreview" src="" alt="লোগো" />
    <i class="fas fa-people-group"></i>
  </div>
  <input type="file" id="logoInput" accept="image/*" style="display:none;" />
  <p class="form-hint" style="text-align:center;margin-top:-10px;margin-bottom:14px;">লোগো বদলাতে ছবিতে ট্যাপ করুন</p>

  <label class="form-label">কভার ছবি</label>
  <input type="file" id="coverInput" accept="image/*" class="form-input" />

  <label class="form-label">ক্লাবের নাম</label>
  <input type="text" class="form-input" id="clubNameDisplay" disabled />
  <p class="form-hint">নাম শুধু এডমিন বদলাতে পারবেন</p>

  <label class="form-label">ট্যাগলাইন</label>
  <input type="text" class="form-input" id="taglineInput" placeholder="এক লাইনের মটো" />

  <label class="form-label">বিস্তারিত বিবরণ</label>
  <textarea class="form-input" id="descriptionInput" rows="4"></textarea>

  <label class="form-label">ফোন নম্বর</label>
  <input type="text" class="form-input" id="phoneInput" />

  <label class="form-label">ফেসবুক পেজ লিংক</label>
  <input type="text" class="form-input" id="facebookInput" placeholder="https://facebook.com/..." />

  <label class="form-label">ঠিকানা</label>
  <input type="text" class="form-input" id="addressInput" />

  <label class="form-label">প্রতিষ্ঠার সাল</label>
  <input type="number" class="form-input" id="establishedInput" placeholder="যেমন: 2015" />

  <label class="form-label">ম্যাপ লোকেশন (গুগল ম্যাপ লিংক)</label>
  <input type="text" class="form-input" id="mapLinkInput" inputmode="url" autocomplete="off" placeholder="https://maps.app.goo.gl/..." />
  <p class="form-hint">গুগল ম্যাপে আপনার ক্লাবের জায়গা খুলে "শেয়ার" চেপে লিংক কপি করুন, এখানে পেস্ট করুন</p>

  <button class="primary-btn" id="saveProfileBtn" type="button">
    <i class="fas fa-check"></i> <span>সেভ করুন</span>
  </button>
</div>

<!-- ============================================================
     পারমিশন-ভিত্তিক lock — my-club.astro এর init() ফাংশন body তে
     'mod-no-settings' ক্লাস বসায় যখন মডারেটরের can_edit_settings
     পারমিশন নেই। is:global দরকার কারণ body এই কম্পোনেন্টের বাইরে।
     ============================================================ -->
<style is:global>
  body.mod-no-settings #logoCircle {
    pointer-events: none;
    cursor: not-allowed;
    opacity: 0.7;
  }

  body.mod-no-settings #coverInput,
  body.mod-no-settings #taglineInput,
  body.mod-no-settings #descriptionInput,
  body.mod-no-settings #phoneInput,
  body.mod-no-settings #facebookInput,
  body.mod-no-settings #addressInput,
  body.mod-no-settings #establishedInput,
  body.mod-no-settings #mapLinkInput {
    pointer-events: none;
    background: #F4F7FC;
    color: #9AA8BC;
  }

  body.mod-no-settings #saveProfileBtn {
    display: none !important;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImage } from '../../lib/imageCompress.js';
  import { uploadWithRetry } from '../../lib/uploadWithRetry.js';
import { authHeader } from '../../lib/authToken.js';
import { isMapUrl } from '../../lib/mapLinks.js';

  // টেক্সট থেকে প্রথম http(s) লিংক বের করে (সাথে অন্য কথা পেস্ট হলেও চলে), গুগল ম্যাপের না হলে null
  function pickMapLink(raw) {
    const m = (raw || '').match(/https?:\/\/[^\s<>"']+/i);
    if (!m) return null;
    const url = m[0].replace(/[)\].,;!?।]+$/u, '');
    return isMapUrl(url) ? url : null;
  }

  let clubId = null;
  let selectedLogoFile = null;
  let selectedCoverFile = null;

  // স্লো নেটে আপলোডের অগ্রগতি সেভ বাটনেই দেখানো হয় (সেভ শেষে handler আসল লেখা ফেরত দেয়)
  function setBtnText(text) {
    const s = document.querySelector('#saveProfileBtn span');
    if (s) s.textContent = text;
  }

  const msgEl = document.getElementById('profileMsg');
  function showMsg(text, type = 'error') {
    msgEl.textContent = text;
    msgEl.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;

    // গ্লোবাল টোস্টেও দেখানো হয় — ইনলাইন মেসেজ স্ক্রিনের বাইরে থাকলেও যেন চোখে পড়ে
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  document.getElementById('logoCircle')?.addEventListener('click', () => {
    document.getElementById('logoInput').click();
  });

  document.getElementById('logoInput')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    // লোগো PNG (transparent background) হলে PNG-ই রাখা হচ্ছে, নাহলে
    // ব্যাকগ্রাউন্ড সাদা/কালো হয়ে ট্রান্সপারেন্সি নষ্ট হয়ে যাবে
    const mimeType = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
    selectedLogoFile = await compressImage(file, { maxDimension: 512, mimeType, quality: 0.72, skipIfSmallerThan: 100 * 1024 });
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById('logoPreview').src = reader.result;
      document.getElementById('logoCircle').classList.add('has-photo');
    };
    reader.readAsDataURL(selectedLogoFile);
  });

  document.getElementById('coverInput')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    selectedCoverFile = file ? await compressImage(file, { maxDimension: 1024, quality: 0.72, skipIfSmallerThan: 100 * 1024 }) : null;
  });

  // বাগফিক্স: আগে upload fail করলে error silently ignore হয়ে যেত
  // (শুধু null return করত), তাই ইউজার বুঝতে পারতেন না কেন ছবি সেভ
  // হচ্ছে না। এখন error console-এ log হয় + { url, error } রিটার্ন
  // করে যাতে কলার (saveProfileBtn হ্যান্ডলার) exact কারণ দেখাতে পারে।
  // ফেইল রিপোর্টে যোগ হয়: ছবির সাইজ, নেটের ধরন, অনলাইন কিনা, কত বার চেষ্টা, অ্যাপ/ওয়েব
  function uploadDiag(file, attempts) {
    const c = navigator.connection || {};
    const kb = file && file.size ? Math.round(file.size / 1024) : 0;
    const env = (window.Capacitor && typeof window.Capacitor.isNativePlatform === 'function' && window.Capacitor.isNativePlatform()) ? 'app' : 'web';
    return `[${kb}KB, ${c.effectiveType || '?'}, ${navigator.onLine ? 'online' : 'offline'}, চেষ্টা ${attempts}, ${env}]`;
  }

  async function uploadImage(file, prefix) {
    let attempts = 1;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return { url: null, error: 'সেশন নেই, আবার লগইন করুন' };

      const nameExt = file.name && file.name.includes('.') ? file.name.split('.').pop().toLowerCase() : '';
      const ext = nameExt || (file.type === 'image/png' ? 'png' : 'jpg');
      const path = `clubs/${prefix}-${Date.now()}.${ext}`;

      const label = prefix.includes('-logo') ? 'লোগো' : 'কভার';
      const { status, data: result } = await uploadWithRetry('/api/upload-image', {
        headers: { Authorization: `Bearer ${session.access_token}` },
        getAuthHeader: authHeader,
        makeFormData: () => {
          const fd = new FormData();
          fd.append('file', file);
          fd.append('path', path);
          return fd;
        },
        onProgress: (pct) => setBtnText(`${label} আপলোড হচ্ছে… ${pct}%`),
        onRetry: (n, max) => {
          attempts = n + 1;
          setBtnText(`নেট ধীর, আবার চেষ্টা (${n}/${max})…`);
        },
      });

      if (!(status >= 200 && status < 300) || !result?.url) {
        const msg = (result && result.error) || `সার্ভার এরর (${status})`;
        console.error(`ছবি আপলোড ব্যর্থ (${prefix}):`, msg);
        window.SFReportError?.({ kind: 'api_fail', action: 'club_profile_image_upload', title: 'ক্লাব প্রোফাইল ছবি আপলোড ব্যর্থ', message: `${prefix.includes('-logo') ? 'logo' : 'cover'}: ${msg} ${uploadDiag(file, attempts)}` });
        return { url: null, error: msg };
      }
      return { url: result.url, error: null };
    } catch (err) {
      console.error(`ছবি আপলোড ব্যর্থ (${prefix}):`, err);
      window.SFReportError?.({ kind: 'api_fail', action: 'club_profile_image_upload', title: 'ক্লাব প্রোফাইল ছবি আপলোড ব্যর্থ', message: `${prefix.includes('-logo') ? 'logo' : 'cover'}: ${String((err && err.message) || err)} ${uploadDiag(file, attempts)}` });
      return { url: null, error: 'নেট খুব ধীর বা বন্ধ, কয়েকবার চেষ্টা করেও যায়নি' };
    }
  }

  document.getElementById('saveProfileBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('saveProfileBtn');
    const span = btn.querySelector('span');
    const original = span.textContent;
    span.textContent = 'সেভ হচ্ছে...';
    btn.disabled = true;

    // বাগফিক্স: ছবি আপলোডের ঠিক আগে সেশন সতেজ (refresh) করে নেওয়া হচ্ছে।
    // ফর্ম পূরণ করতে করতে access token মেয়াদ পার হয়ে গেলে storage
    // আপলোড 'anon' হিসেবে গিয়ে RLS ভায়োলেশন দিত। getSession() কল করলে
    // supabase-js নিজে থেকেই expired token refresh করার চেষ্টা করে।
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      span.textContent = original;
      btn.disabled = false;
      showMsg('সেশনের মেয়াদ শেষ হয়ে গেছে — পেজ রিলোড করে আবার লগইন করুন।');
      return;
    }

    const rawMap = document.getElementById('mapLinkInput').value.trim();
    let mapLink = null;
    if (rawMap) {
      mapLink = pickMapLink(rawMap);
      if (!mapLink) {
        span.textContent = original;
        btn.disabled = false;
        showMsg('ম্যাপ লিংক ঠিক নেই — গুগল ম্যাপ থেকে "শেয়ার" করে লিংক কপি করে দিন।');
        return;
      }
    }

    const updates = {
      tagline: document.getElementById('taglineInput').value.trim(),
      description: document.getElementById('descriptionInput').value.trim(),
      phone: document.getElementById('phoneInput').value.trim(),
      facebook_link: document.getElementById('facebookInput').value.trim(),
      address: document.getElementById('addressInput').value.trim(),
      established_year: document.getElementById('establishedInput').value ? parseInt(document.getElementById('establishedInput').value) : null,
      map_link: mapLink,
      // পুরনো পিন আর ফর্মে নেই; লিংক খালি করলে যেন পুরনো পিন ফিরে না আসে
      latitude: null,
      longitude: null,
    };

    const uploadErrors = [];

    if (selectedLogoFile) {
      const { url, error } = await uploadImage(selectedLogoFile, `${clubId}-logo`);
      if (url) updates.logo_image = url;
      if (error) uploadErrors.push(`লোগো: ${error}`);
    }
    if (selectedCoverFile) {
      const { url, error } = await uploadImage(selectedCoverFile, `${clubId}-cover`);
      if (url) updates.cover_image = url;
      if (error) uploadErrors.push(`কভার: ${error}`);
    }

    const { error } = await supabase.from('clubs').update(updates).eq('id', clubId);

    span.textContent = original;
    btn.disabled = false;

    if (error) {
      showMsg('সেভ ব্যর্থ: ' + error.message);
      return;
    }

    if (uploadErrors.length > 0) {
      showMsg('বাকি তথ্য সেভ হয়েছে, কিন্তু ছবি আপলোড ব্যর্থ — ' + uploadErrors.join(' | ') + ' (নেট ভালো হলে আবার সেভ চাপুন)');
      return;
    }

    window.showToast('প্রোফাইল সেভ হয়েছে ✓', 'success');
  });

  window.addEventListener('smartfeni:club-ready', (e) => {
    const { clubId: id, club } = e.detail;
    clubId = id;

    document.getElementById('clubNameDisplay').value = club.name || '';
    document.getElementById('taglineInput').value = club.tagline || '';
    document.getElementById('descriptionInput').value = club.description || '';
    document.getElementById('phoneInput').value = club.phone || '';
    document.getElementById('facebookInput').value = club.facebook_link || '';
    document.getElementById('addressInput').value = club.address || '';
    document.getElementById('establishedInput').value = club.established_year || '';
    document.getElementById('mapLinkInput').value =
      club.map_link || ((club.latitude && club.longitude) ? `https://www.google.com/maps?q=${club.latitude},${club.longitude}` : '');

    if (club.logo_image) {
      document.getElementById('logoPreview').src = club.logo_image;
      document.getElementById('logoCircle').classList.add('has-photo');
    }
  });
</script>
