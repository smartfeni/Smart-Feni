<!-- path: src/components/club-dashboard/MemberAnnounceTab.astro -->
---
// ============================================================
// কম্পোনেন্ট: ক্লাব ড্যাশবোর্ড — "ঘোষণা" ট্যাব
//
// একটাই জায়গা থেকে ক্লাবের ঘোষণা:
//   ১) হেডলাইন → club_posts (type='announcement') → ক্লাব পেজের টিকার বারে (আগের মতোই)
//   ২) ঐচ্ছিক: সদস্যদের নোটিফিকেশন (বেল + ইনবক্স + push) — RPC `club_send_announcement`
//
// - আগের "এনাউন্সমেন্ট" পোস্ট টাইপ PostsTab থেকে সরানো হয়েছে; এই ট্যাব থেকেই হবে
// - ঘোষণা দিতে: ওউনার বা can_edit_listings মডারেটর; নোটিফিকেশন পাঠাতে: ওউনার বা can_edit_settings
// - প্রাপক: club_members যাদের user_id আছে (অ্যাপ অ্যাকাউন্ট লিংকড), প্রেরক বাদ
// - সীমা (সার্ভারে যাচাই): ২৪ ঘণ্টায় ৫টা নোটিফিকেশন, বার্তা সর্বোচ্চ ৩০০ অক্ষর
// - নিচে বটম-নেভের জন্য বাড়তি padding আছে (কার্ডের নিচের অংশ ঢাকা পড়বে না)
// ============================================================
---

<div class="ann-wrap" id="annWrap">
  <div class="dash-card" id="annCard">
    <h3><i class="fas fa-bullhorn"></i> নতুন ঘোষণা</h3>
    <p class="ann-help">হেডলাইন ক্লাব পেজের উপরের চলমান ঘোষণা-বারে দেখাবে।</p>
    <div class="form-msg" id="annMsg"></div>

    <label class="form-label" for="annTitle">হেডলাইন<span class="required-mark">*</span></label>
    <input type="text" class="form-input" id="annTitle" maxlength="100" placeholder="যেমন: আগামীকাল বিকাল ৫টায় জরুরি সভা" required />
    <div class="field-error-msg" data-error-for="annTitle">
      <i class="fas fa-circle-exclamation"></i><span>হেডলাইন দিন</span>
    </div>

    <label class="form-label" for="annDesc">বিস্তারিত বার্তা (ঐচ্ছিক)</label>
    <textarea class="form-input" id="annDesc" rows="3" maxlength="190" placeholder="নোটিফিকেশনে হেডলাইনের সাথে যাবে"></textarea>

    <div id="annNotifyBox">
      <label class="ann-check-row">
        <input type="checkbox" id="annNotify" checked />
        <span>সদস্যদের নোটিফিকেশন পাঠান</span>
      </label>

      <label class="ann-check-row" id="annUrgentRow">
        <input type="checkbox" id="annUrgent" />
        <span><strong>জরুরি</strong> — উচ্চ গুরুত্বের নোটিফিকেশন হিসেবে যাবে</span>
      </label>

      <p class="ann-audience" id="annAudience">সদস্য সংখ্যা লোড হচ্ছে...</p>
    </div>

    <button type="button" class="primary-btn" id="annSend">
      <i class="fas fa-bullhorn"></i> <span>ঘোষণা দিন</span>
    </button>
  </div>

  <div class="dash-card">
    <h3><i class="fas fa-newspaper"></i> আমার ঘোষণা</h3>
    <div id="annList"></div>
    <p class="empty-note" id="annEmpty" style="display:none;">এখনো কোনো ঘোষণা নেই</p>
  </div>
</div>

<style is:global>
  /* বটম নেভ (BottomNav) যেন কার্ডের নিচের অংশ ঢেকে না দেয় */
  .ann-wrap {
    padding-bottom: calc(110px + env(safe-area-inset-bottom, 0px));
  }

  .ann-help {
    font-size: 0.8rem;
    color: #8FA0BC;
    margin: -4px 0 12px;
    line-height: 1.5;
  }

  .ann-check-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 14px;
    font-size: 0.84rem;
    color: #1B2A4A;
    cursor: pointer;
  }

  .ann-check-row input {
    margin-top: 3px;
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    accent-color: #FF6B35;
  }

  .ann-audience {
    margin: 14px 0 16px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #5A6E85;
    background: #F4F7FC;
    border-radius: 12px;
    padding: 10px 14px;
    line-height: 1.5;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  let clubId = null;
  let myId = null;
  let canNotify = false;
  let audienceCount = 0;

  const titleEl = document.getElementById('annTitle');
  const descEl = document.getElementById('annDesc');
  const notifyEl = document.getElementById('annNotify');
  const urgentEl = document.getElementById('annUrgent');
  const urgentRow = document.getElementById('annUrgentRow');
  const notifyBox = document.getElementById('annNotifyBox');
  const sendBtn = document.getElementById('annSend');
  const formMsg = document.getElementById('annMsg');
  const audienceEl = document.getElementById('annAudience');

  // ইউজারের লেখা টেক্সট innerHTML-এ বসানোর আগে এস্কেপ
  function esc(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function showMsg(type, text) {
    formMsg.className = 'form-msg ' + (type === 'error' ? 'show-error' : 'show-success');
    formMsg.textContent = text;
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  function clearMsg() {
    formMsg.className = 'form-msg';
    formMsg.textContent = '';
  }

  function syncNotifyUi() {
    urgentRow.style.display = notifyEl.checked ? 'flex' : 'none';
    audienceEl.style.display = notifyEl.checked ? 'block' : 'none';
  }

  async function loadAudience() {
    const { count: total } = await supabase
      .from('club_members')
      .select('id', { count: 'exact', head: true })
      .eq('club_id', clubId);

    let q = supabase
      .from('club_members')
      .select('user_id', { count: 'exact', head: true })
      .eq('club_id', clubId)
      .not('user_id', 'is', null);
    if (myId) q = q.neq('user_id', myId);
    const { count: reachable } = await q;

    audienceCount = reachable || 0;
    const totalCount = total || 0;

    if (audienceCount === 0) {
      audienceEl.textContent = `নোটিফিকেশন কারো কাছে যাবে না: মোট ${totalCount} জন সদস্যের কারো অ্যাপ অ্যাকাউন্ট লিংক করা নেই। অ্যাপের মাধ্যমে জয়েন করা সদস্যরাই নোটিফিকেশন পান। ঘোষণা শুধু ক্লাব পেজে দেখাবে।`;
    } else {
      audienceEl.textContent = `নোটিফিকেশন যাবে ${audienceCount} জনের কাছে (মোট ${totalCount} জন সদস্যের মধ্যে যাদের অ্যাপ অ্যাকাউন্ট আছে)।`;
    }
  }

  function formatDate(iso) {
    try {
      return new Date(iso).toLocaleString('bn-BD', {
        timeZone: 'Asia/Dhaka',
        day: 'numeric',
        month: 'short',
        hour: 'numeric',
        minute: '2-digit',
      });
    } catch (_) {
      return '';
    }
  }

  async function loadList() {
    const { data, error } = await supabase
      .from('club_posts')
      .select('id, title, description, created_at')
      .eq('club_id', clubId)
      .eq('type', 'announcement')
      .order('created_at', { ascending: false });

    const list = document.getElementById('annList');
    const emptyEl = document.getElementById('annEmpty');
    list.innerHTML = '';

    if (error || !data || data.length === 0) {
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    data.forEach((p) => {
      const card = document.createElement('div');
      card.className = 'item-card';
      card.innerHTML = `
        <div class="item-photo-placeholder"><i class="fas fa-bullhorn"></i></div>
        <div class="item-body">
          <p class="item-title">${esc(p.title)}</p>
          <p class="item-sub">${esc(p.description || '')}${p.description ? ' · ' : ''}${esc(formatDate(p.created_at))}</p>
        </div>
        <div class="item-actions">
          <button class="icon-btn delete" type="button"><i class="fas fa-trash"></i></button>
        </div>
      `;
      card.querySelector('.delete').addEventListener('click', () => deleteAnnouncement(p.id));
      list.appendChild(card);
    });
  }

  async function deleteAnnouncement(id) {
    if (!confirm('এই ঘোষণাটি মুছে ফেলতে চান?')) return;
    const { error } = await supabase.from('club_posts').delete().eq('id', id);
    if (error) {
      showMsg('error', 'ডিলিট ব্যর্থ: ' + error.message);
      return;
    }
    loadList();
  }

  async function sendAnnouncement() {
    clearMsg();
    if (!window.SFValidateForm(document.getElementById('annCard'))) return;

    const title = (titleEl.value || '').trim();
    const desc = (descEl.value || '').trim();
    const wantNotify = canNotify && notifyEl.checked && audienceCount > 0;
    const urgent = wantNotify && !!urgentEl.checked;

    if (wantNotify) {
      const ok = window.confirm(
        `ঘোষণাটি ক্লাব পেজে দেখানো হবে এবং ${audienceCount} জন সদস্যের কাছে ${urgent ? 'জরুরি ' : ''}নোটিফিকেশন যাবে। পাঠানোর পর নোটিফিকেশন ফেরত নেওয়া যাবে না। এগোবেন?`
      );
      if (!ok) return;
    }

    sendBtn.disabled = true;
    const label = sendBtn.querySelector('span');
    const originalLabel = label.textContent;
    label.textContent = 'পাঠানো হচ্ছে...';

    // ধাপ ১: ক্লাব পেজের টিকারে দেখানোর জন্য পোস্ট (আগের এনাউন্সমেন্ট সিস্টেমই)
    const { error: postError } = await supabase
      .from('club_posts')
      .insert({
        club_id: clubId,
        type: 'announcement',
        title,
        description: desc || null,
      });

    if (postError) {
      label.textContent = originalLabel;
      sendBtn.disabled = false;
      showMsg('error', 'ঘোষণা ব্যর্থ: ' + postError.message);
      return;
    }

    // ধাপ ২: ঐচ্ছিক সদস্য নোটিফিকেশন
    let notifyResult = null;
    let notifyError = null;
    if (wantNotify) {
      const message = (desc ? `${title} — ${desc}` : title).slice(0, 300);
      const { data, error } = await supabase.rpc('club_send_announcement', {
        p_club_id: clubId,
        p_message: message,
        p_urgent: urgent,
      });
      notifyResult = data;
      notifyError = error;
    }

    label.textContent = originalLabel;
    sendBtn.disabled = false;

    if (notifyError) {
      showMsg('error', `ঘোষণা ক্লাব পেজে দেওয়া হয়েছে, কিন্তু নোটিফিকেশন যায়নি: ${notifyError.message}`);
    } else if (wantNotify) {
      const sent = notifyResult?.recipient_count ?? audienceCount;
      const remaining = notifyResult?.remaining;
      showMsg(
        'success',
        `ঘোষণা দেওয়া হয়েছে, ${sent} জনের কাছে নোটিফিকেশন গেছে।` +
          (typeof remaining === 'number' ? ` আজ আর ${remaining}টা নোটিফিকেশন পাঠানো যাবে।` : '')
      );
    } else {
      showMsg('success', 'ঘোষণা ক্লাব পেজে দেওয়া হয়েছে ✓');
    }

    titleEl.value = '';
    descEl.value = '';
    urgentEl.checked = false;
    loadList();
  }

  notifyEl.addEventListener('change', syncNotifyUi);
  sendBtn.addEventListener('click', sendAnnouncement);

  window.addEventListener('smartfeni:club-ready', async (e) => {
    const { isOwner, permissions } = e.detail;
    const canPost = !!isOwner || !!permissions?.can_edit_listings;
    canNotify = !!isOwner || !!permissions?.can_edit_settings;

    // ঘোষণা দেওয়ার অধিকার না থাকলে ট্যাব ও প্যানেল সরিয়ে ফেলা
    if (!canPost) {
      document.querySelector('.myclub-tab[data-tab="announce"]')?.remove();
      document.querySelector('.myclub-panel[data-panel="announce"]')?.remove();
      return;
    }

    clubId = e.detail.clubId;
    const { data: { session } } = await supabase.auth.getSession();
    myId = session?.user?.id || null;

    if (!canNotify) {
      notifyBox.style.display = 'none';
      notifyEl.checked = false;
    } else {
      syncNotifyUi();
      loadAudience();
    }
    loadList();
  });
</script>
