---
// ============================================================
// শেয়ারড কম্পোনেন্ট: Push Notification "Soft-ask" প্রম্পট (Phase 4)
// ফাংশন: ব্রাউজারের নেটিভ পারমিশন পপ-আপ দেখানোর *আগে* একটা
// বন্ধুত্বপূর্ণ মোডাল দেখায় — কারণ সরাসরি নেটিভ পপ-আপে "Block"
// চাপলে ইউজার সহজে আর re-enable করতে পারে না, তাই আগে থেকেই
// প্রসঙ্গ বুঝিয়ে জিজ্ঞেস করা ভালো।
//
// দেখানোর শর্ত (client-side script এ চেক হয়):
//  - ইউজার লগইন করা আছে
//  - ব্রাউজার push সাপোর্ট করে
//  - Notification.permission === 'default' (আগে কখনো জিজ্ঞেস করা হয়নি)
//  - গত ৭ দিনে "পরে করব" চাপা হয়নি (localStorage cooldown)
//
// BaseLayout.astro এ গ্লোবালি মাউন্ট করা হবে (NotificationDrawer
// এর মতো), যেকোনো পেজে লগইন থাকলে অটো-দেখাবে।
//
// আপডেট (Android অ্যাপ): অ্যাপে কোনো নিজস্ব মোডাল/popup দেখানো হয় না —
// শুধু Android এর নিজের নোটিফিকেশন ডায়ালগ। অনুমতির আসল অবস্থা
// (checkPermissions) দেখে:
//   granted → কোনো ডায়ালগ ছাড়াই চুপচাপ সিঙ্ক (যেমন রিইনস্টলের পর)
//   denied  → কিছুই দেখায় না (Android তখন ডায়ালগ দেখায়ই না;
//             প্রোফাইলের নোটিফিকেশন কার্ডে নির্দেশনা আছে)
//   prompt  → ২.৫ সেকেন্ড পরে Android এর ডায়ালগ (৭ দিনের cooldown সহ)
// নির্দিষ্ট মুহূর্তে (ডোনার টগল, হিরো নিবন্ধন, প্রথম অর্ডার) অপেক্ষা ছাড়াই
// চাইতে যেকোনো পেজ থেকে ইভেন্ট পাঠান:
//   window.dispatchEvent(new CustomEvent('smartfeni:ask-push'))
// ওয়েব ব্রাউজারের soft-ask মোডাল যেমন ছিল তেমনই।
// ============================================================
---

<div class="np-overlay" id="npOverlay">
  <div class="np-modal">
    <div class="np-icon"><i class="fas fa-bell"></i></div>
    <h3>নোটিফিকেশন অন করবেন?</h3>
    <p>নতুন ডেলিভারি অফার, ব্লাড রিকোয়েস্ট, ও গুরুত্বপূর্ণ আপডেট মিস করবেন না — এমনকি অ্যাপ বন্ধ থাকলেও।</p>

    <p class="np-feedback" id="npFeedback"></p>

    <div class="np-actions">
      <button class="np-btn-skip" id="npSkipBtn" type="button">পরে করব</button>
      <button class="np-btn-allow" id="npAllowBtn" type="button">হ্যাঁ, অন করি</button>
    </div>
  </div>
</div>

<style>
  .np-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 2100;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
  }

  .np-overlay.open {
    display: flex;
  }

  @media (min-width: 640px) {
    .np-overlay {
      align-items: center;
      padding: 20px;
    }
  }

  .np-modal {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 420px;
    border-radius: 24px 24px 0 0;
    overflow: hidden;
    box-shadow: 0 -8px 40px rgba(15, 23, 42, 0.2);
    padding: 30px 26px 26px;
    text-align: center;
  }

  @media (min-width: 640px) {
    .np-modal {
      border-radius: 24px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    }
  }

  .np-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    font-size: 1.5rem;
    margin-bottom: 14px;
  }

  .np-modal h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1B2A4A;
    margin: 0 0 8px;
  }

  .np-modal p {
    font-size: 0.88rem;
    color: #5A6E85;
    margin: 0 0 6px;
    line-height: 1.6;
  }

  .np-feedback {
    font-size: 0.82rem;
    font-weight: 600;
    margin: 8px 0 0;
    display: none;
  }

  .np-feedback.error {
    display: block;
    color: #D14343;
  }

  .np-feedback.success {
    display: block;
    color: #1E9E5A;
  }

  .np-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }

  .np-btn-skip {
    flex: 1;
    background: #F8FAFC;
    border: 1.5px solid #EEF3F9;
    color: #5A6E85;
    padding: 13px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .np-btn-allow {
    flex: 1.4;
    background: #FF6B35;
    border: none;
    color: #fff;
    padding: 13px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .np-btn-allow:hover {
    background: #e85a2a;
  }

  .np-btn-allow:disabled {
    background: #D7E0EC;
    cursor: not-allowed;
  }
</style>

<script>
  import { subscribeToPush, getPushPermissionState, isPushSupported } from '../../lib/push.js';
  import { supabase } from '../../lib/supabase.js';
  import { isNativeApp } from '../../lib/native-bridge.js';

  const COOLDOWN_KEY = 'smartfeni_push_prompt_dismissed_at';
  const COOLDOWN_DAYS = 7;
  const ASK_SESSION_KEY = 'smartfeni_push_ask_event_done';

  // ফোনের নোটিফিকেশন অনুমতির আসল অবস্থা (Android):
  // 'granted' | 'denied' | 'prompt' | 'prompt-with-rationale' | 'unknown'
  async function getNativePermissionStatus() {
    try {
      const { PushNotifications } = await import('@capacitor/push-notifications');
      const perm = await PushNotifications.checkPermissions();
      return perm.receive;
    } catch (err) {
      return 'unknown';
    }
  }

  function shouldShowPrompt() {
    if (!isPushSupported()) return false;
    if (getPushPermissionState() !== 'default') return false;

    const dismissedAt = localStorage.getItem(COOLDOWN_KEY);
    if (dismissedAt) {
      const daysSince = (Date.now() - Number(dismissedAt)) / (1000 * 60 * 60 * 24);
      if (daysSince < COOLDOWN_DAYS) return false;
    }
    return true;
  }

  async function initPrompt() {
    const overlay = document.getElementById('npOverlay');
    const skipBtn = document.getElementById('npSkipBtn');
    const allowBtn = document.getElementById('npAllowBtn');
    const feedback = document.getElementById('npFeedback');
    if (!overlay || !skipBtn || !allowBtn || !feedback) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return; // লগইন করা না থাকলে প্রম্পট দেখানো হবে না

    if (isNativeApp()) {
      // অ্যাপে কোনো কাস্টম মোডাল নেই — শুধু Android এর নিজের ডায়ালগ, ফোনের
      // আসল অনুমতির অবস্থা দেখে
      const status = await getNativePermissionStatus();

      if (status === 'granted') {
        // আগে থেকেই অনুমতি আছে (যেমন রিইনস্টলের পর) — ডায়ালগ ছাড়াই সিঙ্ক
        subscribeToPush();
        return;
      }
      if (status === 'denied') {
        // স্থায়ীভাবে ব্লক — Android আর ডায়ালগ দেখায় না, তাই কিছু করার নেই
        return;
      }

      if (!shouldShowPrompt()) return; // ৭ দিনের cooldown / আগে জিজ্ঞেস করা হয়েছে

      setTimeout(async () => {
        const result = await subscribeToPush(); // Android এর নিজের ডায়ালগ
        if (!result.success && result.permission === 'denied') {
          localStorage.setItem(COOLDOWN_KEY, String(Date.now()));
        }
      }, 2500);
      return;
    }

    if (!shouldShowPrompt()) return;

    // একটু দেরি করে দেখানো — পেজ লোড হওয়ার সাথে সাথেই না, যাতে বিরক্তিকর না লাগে
    setTimeout(() => {
      overlay.classList.add('open');
    }, 2500);

    skipBtn.addEventListener('click', () => {
      localStorage.setItem(COOLDOWN_KEY, String(Date.now()));
      overlay.classList.remove('open');
    });

    allowBtn.addEventListener('click', async () => {
      allowBtn.disabled = true;
      allowBtn.textContent = 'একটু অপেক্ষা করুন...';
      feedback.className = 'np-feedback';
      feedback.textContent = '';

      const result = await subscribeToPush();

      if (result.success) {
        feedback.className = 'np-feedback success';
        feedback.textContent = 'নোটিফিকেশন চালু হয়েছে ✅';
        setTimeout(() => overlay.classList.remove('open'), 1200);
      } else {
        feedback.className = 'np-feedback error';
        feedback.textContent = result.error || 'কিছু ভুল হয়েছে, আবার চেষ্টা করুন';
        allowBtn.disabled = false;
        allowBtn.textContent = 'হ্যাঁ, অন করি';
        // permission denied হলে আর বিরক্ত না করে cooldown সেট করে দেওয়া
        if (result.permission === 'denied') {
          localStorage.setItem(COOLDOWN_KEY, String(Date.now()));
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrompt);
  } else {
    initPrompt();
  }

  // নির্দিষ্ট মুহূর্তে (ডোনার টগল, হিরো নিবন্ধন, প্রথম অর্ডার) অপেক্ষা ছাড়াই অনুমতি চাওয়া।
  // শুধু অ্যাপে; ৭ দিনের cooldown মানে না (ইউজার এইমাত্র প্রাসঙ্গিক কিছু করেছে),
  // কিন্তু ফোনে ব্লক থাকলে কিছু করে না এবং এক সেশনে একবারের বেশি নয়।
  window.addEventListener('smartfeni:ask-push', async () => {
    if (!isNativeApp()) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const status = await getNativePermissionStatus();
    if (status === 'granted') {
      subscribeToPush();
      return;
    }
    if (status === 'denied') return;

    if (sessionStorage.getItem(ASK_SESSION_KEY)) return;
    sessionStorage.setItem(ASK_SESSION_KEY, '1');

    const result = await subscribeToPush(); // Android এর নিজের ডায়ালগ
    if (!result.success && result.permission === 'denied') {
      localStorage.setItem(COOLDOWN_KEY, String(Date.now()));
    }
  });
</script>