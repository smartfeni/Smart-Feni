---
// ============================================================
// Pagination — লিস্টিং পেজের নিচে "‹ আগের  ১ ২ ৩ … ১৪  পরের ›"
// সাথে src/lib/listingQuery.js (fetchListingPage)।
//
// ব্যবহার: <Pagination page={result.page} pages={result.pages} anchor="listings" />
// লিংক বর্তমান URL-এর বাকি প্যারামিটার (type, q) রেখে শুধু page বদলায়।
// ১ পেজ হলে কিছুই দেখায় না।
// ============================================================
interface Props {
  page: number;
  pages: number;
  anchor?: string;
}

const { page, pages, anchor = '' } = Astro.props;

const BN = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
const bn = (n: number) => String(n).replace(/\d/g, (d) => BN[Number(d)]);

function href(p: number) {
  const u = new URL(Astro.url);
  if (p <= 1) u.searchParams.delete('page');
  else u.searchParams.set('page', String(p));
  u.searchParams.delete('openListing');
  const qs = u.searchParams.toString();
  return u.pathname + (qs ? '?' + qs : '') + (anchor ? '#' + anchor : '');
}

// দেখানোর মতো পেজ নম্বর: ১, শেষ, আর বর্তমানের দুপাশে ১টা করে; মাঝে ফাঁক হলে "…"
const items: (number | '…')[] = [];
if (pages > 1) {
  const keep = new Set([1, pages, page - 1, page, page + 1].filter((p) => p >= 1 && p <= pages));
  const sorted = [...keep].sort((a, b) => a - b);
  sorted.forEach((p, i) => {
    if (i > 0 && p - sorted[i - 1] > 1) items.push('…');
    items.push(p);
  });
}
---

{pages > 1 && (
  <nav class="sf-pager" aria-label="পেজ">
    {page > 1 ? (
      <a class="sf-pager-btn" href={href(page - 1)} rel="prev"><i class="fas fa-chevron-left" aria-hidden="true"></i> আগের</a>
    ) : (
      <span class="sf-pager-btn is-off" aria-disabled="true"><i class="fas fa-chevron-left" aria-hidden="true"></i> আগের</span>
    )}

    <span class="sf-pager-nums">
      {items.map((it) =>
        it === '…' ? (
          <span class="sf-pager-gap" aria-hidden="true">…</span>
        ) : it === page ? (
          <span class="sf-pager-num is-on" aria-current="page">{bn(it)}</span>
        ) : (
          <a class="sf-pager-num" href={href(it)}>{bn(it)}</a>
        )
      )}
    </span>

    {page < pages ? (
      <a class="sf-pager-btn" href={href(page + 1)} rel="next">পরের <i class="fas fa-chevron-right" aria-hidden="true"></i></a>
    ) : (
      <span class="sf-pager-btn is-off" aria-disabled="true">পরের <i class="fas fa-chevron-right" aria-hidden="true"></i></span>
    )}
  </nav>
)}

<style is:global>
  .sf-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 22px 0 8px;
  }
  .sf-pager-nums { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: center; }
  .sf-pager-btn,
  .sf-pager-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 40px;
    border-radius: 12px;
    background: #fff;
    color: #1B2A4A;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(27, 42, 74, 0.08);
    -webkit-tap-highlight-color: transparent;
  }
  .sf-pager-btn { padding: 0 14px; flex-shrink: 0; }
  .sf-pager-num { min-width: 40px; padding: 0 6px; }
  .sf-pager-num.is-on { background: #FF6B35; color: #fff; box-shadow: 0 3px 10px rgba(255, 107, 53, 0.3); }
  .sf-pager-btn.is-off { opacity: 0.4; box-shadow: none; }
  .sf-pager-gap { color: #8FA0BC; padding: 0 2px; }
  a.sf-pager-btn:active, a.sf-pager-num:active { transform: scale(0.96); }
  @media (max-width: 360px) {
    .sf-pager-btn { padding: 0 10px; font-size: 0.85rem; }
    .sf-pager-num { min-width: 34px; height: 36px; }
  }
</style>
