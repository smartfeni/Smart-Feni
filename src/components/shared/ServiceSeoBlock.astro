---
// path: src/components/shared/ServiceSeoBlock.astro
// সার্ভিস পেজের নিচে ভাঁজ করা SEO লেখা কার্ড (ডিফল্টে বন্ধ, ট্যাপে খোলে)।
// লেখা HTML-এই থাকে (hidden অ্যাট্রিবিউটে), তাই সার্চ ইঞ্জিন পড়তে পারে।
// ব্যবহার: <ServiceSeoBlock slug="car-rental" />  (লেখা src/data/seoContent.js-এ)
import { seoContent } from '../../data/seoContent.js';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const content = seoContent[slug];
const bodyId = `sf-seo-body-${slug}`;
---

{
  content && (
    <section class="sf-seo-block">
      <div class="container">
        <div class="sf-seo-card">
          <button type="button" class="sf-seo-head" aria-expanded="false" aria-controls={bodyId}>
            <span>{content.heading}</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="sf-seo-body" id={bodyId} hidden>
            {content.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll('.sf-seo-head').forEach((btn) => {
    if (btn.dataset.sfSeoBound) return;
    btn.dataset.sfSeoBound = '1';
    btn.addEventListener('click', () => {
      const body = document.getElementById(btn.getAttribute('aria-controls'));
      if (!body) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      body.hidden = open;
    });
  });
</script>

<style is:global>
  .sf-seo-block { margin: 24px 0 96px; }
  .sf-seo-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(27, 42, 74, 0.06); overflow: hidden; }
  .sf-seo-head { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; min-height: 48px; border: 0; background: none; color: #1b2a4a; font: inherit; font-size: 15px; font-weight: 700; text-align: left; cursor: pointer; }
  .sf-seo-head i { color: #ff6b35; font-size: 13px; transition: transform 0.2s; flex: none; }
  .sf-seo-head[aria-expanded='true'] i { transform: rotate(180deg); }
  .sf-seo-body { padding: 0 16px 14px; color: #4a5b6e; font-size: 14.5px; line-height: 1.7; }
  .sf-seo-body[hidden] { display: none; }
  .sf-seo-body p { margin: 0 0 10px; }
  .sf-seo-body p:last-child { margin-bottom: 0; }
</style>
