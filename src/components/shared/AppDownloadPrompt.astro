---
// ============================================================
// কম্পোনেন্ট: Android অ্যাপ ডাউনলোড প্রম্পট
//
// কখন দেখাবে:
//   ✅ শুধু Android ফোনের ব্রাউজারে
//   ❌ iPhone/iPad, ডেস্কটপ, ল্যাপটপ — কিছুই দেখাবে না, সরাসরি ওয়েবসাইট
//   ❌ নেটিভ Capacitor অ্যাপের ভেতরে (isNativeApp())
//   ❌ হোম-স্ক্রিনে ইনস্টল করা PWA (standalone মোড)
//   ❌ /admin ও /api পেজে
//
// ইউজার "ব্রাউজারে চালিয়ে যান" চাপলে বা Play Store বাটনে ক্লিক
// করলে ৭ দিন আর দেখাবে না (localStorage: sf_app_prompt_dismissed_at)।
//
// ফোকাস: বড় Play Store বাটন প্রধান, "ব্রাউজারে চালিয়ে যান"
// ছোট ও হালকা ধূসর — যেন নজর ডাউনলোডে থাকে।
//
// গুরুত্বপূর্ণ: Play Store লিংক তখনই কাজ করবে যখন অ্যাপ রিভিউ
// পেরিয়ে লাইভ হবে।
// ============================================================

const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.smartfeni.app';
---

<div
  id="sfAppPrompt"
  class="sf-app-prompt"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sfAppPromptTitle"
  hidden
>
  <div class="sf-app-prompt-bg-glow"></div>

  <div class="sf-app-prompt-inner">
    <div class="sf-app-prompt-logo-wrap">
      <img src="/logo.png" alt="স্মার্ট ফেনী" class="sf-app-prompt-logo" width="84" height="84" />
    </div>

    <h2 id="sfAppPromptTitle" class="sf-app-prompt-title">স্মার্ট ফেনী অ্যাপ</h2>
    <p class="sf-app-prompt-sub">প্রয়োজন আপনার, দায়িত্ব আমাদের</p>

    <ul class="sf-app-prompt-features">
      <li>
        <span class="sf-app-prompt-ico"><i class="fas fa-bolt"></i></span>
        <span>আরও দ্রুত ও স্মুথ অভিজ্ঞতা</span>
      </li>
      <li>
        <span class="sf-app-prompt-ico"><i class="fas fa-bell"></i></span>
        <span>অর্ডার, রাইড ও রক্তের জরুরি নোটিফিকেশন</span>
      </li>
      <li>
        <span class="sf-app-prompt-ico"><i class="fas fa-location-dot"></i></span>
        <span>সঠিক লোকেশনে সহজ সার্ভিস</span>
      </li>
    </ul>

    <a
      id="sfAppPromptDownload"
      class="sf-app-prompt-download"
      href={PLAY_STORE_URL}
      target="_blank"
      rel="noopener"
    >
      <i class="fab fa-google-play"></i>
      <span class="sf-app-prompt-download-text">
        <small>এখনই পান</small>
        <strong>Google Play থেকে ডাউনলোড</strong>
      </span>
    </a>

    <button id="sfAppPromptContinue" class="sf-app-prompt-continue" type="button">
      ব্রাউজারে চালিয়ে যান
    </button>
  </div>
</div>

<style is:global>
  .sf-app-prompt {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF6F1 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    padding-top: calc(24px + env(safe-area-inset-top));
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .sf-app-prompt[hidden] {
    display: none;
  }

  .sf-app-prompt.sf-app-prompt-show {
    opacity: 1;
  }

  .sf-app-prompt-bg-glow {
    position: absolute;
    top: -120px;
    right: -120px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .sf-app-prompt-inner {
    position: relative;
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transform: translateY(14px);
    transition: transform 0.35s ease;
  }

  .sf-app-prompt.sf-app-prompt-show .sf-app-prompt-inner {
    transform: translateY(0);
  }

  .sf-app-prompt-logo-wrap {
    width: 108px;
    height: 108px;
    border-radius: 30px;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 18px 44px rgba(255, 107, 53, 0.22), 0 4px 12px rgba(27, 42, 74, 0.08);
    margin-bottom: 22px;
  }

  .sf-app-prompt-logo {
    width: 84px;
    height: 84px;
    object-fit: contain;
    border-radius: 20px;
  }

  .sf-app-prompt-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #1B2A4A;
    line-height: 1.25;
  }

  .sf-app-prompt-sub {
    margin-top: 6px;
    font-size: 0.92rem;
    color: #5A6E85;
    font-weight: 500;
  }

  .sf-app-prompt-features {
    list-style: none;
    width: 100%;
    margin: 26px 0 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sf-app-prompt-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #FFFFFF;
    border: 1px solid #EEF3F9;
    border-radius: 16px;
    padding: 12px 14px;
    text-align: left;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1B2A4A;
    box-shadow: 0 4px 14px rgba(27, 42, 74, 0.04);
  }

  .sf-app-prompt-ico {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .sf-app-prompt-download {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: #FF6B35;
    color: #FFFFFF;
    text-decoration: none;
    padding: 16px 22px;
    border-radius: 18px;
    box-shadow: 0 12px 30px rgba(255, 107, 53, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sf-app-prompt-download:active {
    transform: scale(0.98);
  }

  .sf-app-prompt-download > i {
    font-size: 1.7rem;
  }

  .sf-app-prompt-download-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .sf-app-prompt-download-text small {
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .sf-app-prompt-download-text strong {
    font-size: 1.02rem;
    font-weight: 800;
  }

  .sf-app-prompt-continue {
    margin-top: 22px;
    background: none;
    border: none;
    color: #9AA8BC;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 8px 12px;
  }
</style>

<script>
  import { isNativeApp } from '../../lib/native-bridge.js';

  const DISMISS_KEY = 'sf_app_prompt_dismissed_at';
  const DISMISS_DAYS = 7;

  function isAndroidBrowser() {
    return /Android/i.test(navigator.userAgent || '');
  }

  function isStandalonePwa() {
    try {
      return (
        window.matchMedia('(display-mode: standalone)').matches ||
        window.navigator.standalone === true
      );
    } catch {
      return false;
    }
  }

  function isExcludedPath() {
    const p = window.location.pathname;
    return p.startsWith('/admin') || p.startsWith('/api') || p.startsWith('/.well-known');
  }

  function recentlyDismissed() {
    try {
      const raw = localStorage.getItem(DISMISS_KEY);
      if (!raw) return false;
      const ts = Number(raw);
      if (!Number.isFinite(ts)) return false;
      return Date.now() - ts < DISMISS_DAYS * 24 * 60 * 60 * 1000;
    } catch {
      return false;
    }
  }

  function markDismissed() {
    try {
      localStorage.setItem(DISMISS_KEY, String(Date.now()));
    } catch {
      // localStorage বন্ধ থাকলে সমস্যা নেই — শুধু এই সেশনে হাইড হবে
    }
  }

  function init() {
    const el = document.getElementById('sfAppPrompt');
    if (!el) return;

    // শুধু Android ব্রাউজারে — বাকি সব ডিভাইসে কিছুই হবে না
    if (!isAndroidBrowser()) return;
    if (isNativeApp()) return;
    if (isStandalonePwa()) return;
    if (isExcludedPath()) return;
    if (recentlyDismissed()) return;

    const downloadBtn = document.getElementById('sfAppPromptDownload');
    const continueBtn = document.getElementById('sfAppPromptContinue');

    function close() {
      el.classList.remove('sf-app-prompt-show');
      document.body.style.overflow = '';
      setTimeout(() => {
        el.hidden = true;
      }, 300);
    }

    continueBtn?.addEventListener('click', () => {
      markDismissed();
      close();
    });

    // ডাউনলোডে ক্লিক করলেও ৭ দিন আর বিরক্ত করবে না
    downloadBtn?.addEventListener('click', () => {
      markDismissed();
    });

    el.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.classList.add('sf-app-prompt-show');
        downloadBtn?.focus({ preventScroll: true });
      });
    });
  }

  init();
</script>