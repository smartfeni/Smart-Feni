---
// ============================================================
// শেয়ারড কম্পোনেন্ট: অভিযোগ (রিপোর্ট) মডাল
// যেকোনো লিস্টিং/ডোনার কার্ডে 🚩 আইকনে ক্লিক করলে এটা খুলবে।
// রিজন লিস্ট প্রতি পেজে ভিন্ন হতে পারে (যেমন ব্লাডের জন্য
// "এভেইলেবল না/প্রবাসে", হাউজিং এর জন্য "ভাড়া হয়ে গেছে") —
// তাই রিজন অপশনগুলো এখানে হার্ডকোড না করে src/lib/reportModal.js
// এর initReportModal({ reasons }) কল করার সময় পাস করতে হবে।
// লজিক (submitReport কল, success/error হ্যান্ডলিং) পরের ফাইলে
// reportModal.js এ থাকবে — এটা শুধু মার্কআপ + স্টাইল।
// ============================================================
---

<div class="report-overlay" id="reportOverlay">
  <div class="report-modal">
    <button class="report-close" id="reportClose" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <div class="report-header">
      <span class="report-icon"><i class="fas fa-flag"></i></span>
      <h3>অভিযোগ করুন</h3>
      <p>সমস্যাটা কী, জানান — আমরা রিভিউ করে ব্যবস্থা নেবো</p>
    </div>

    <div class="report-body">
      <div class="report-reasons" id="reportReasons">
        <!-- reportModal.js দিয়ে ডাইনামিক ভাবে ভরা হবে -->
      </div>

      <label class="report-details-label" for="reportDetailsInput">
        বিস্তারিত লিখুন <span>(ঐচ্ছিক)</span>
      </label>
      <textarea
        id="reportDetailsInput"
        class="report-details-input"
        rows="3"
        placeholder="যেমন: ফোন দিয়ে দেখলাম আগেই ভাড়া হয়ে গেছে..."
      ></textarea>

      <p class="report-feedback" id="reportFeedback"></p>

      <button class="report-submit-btn" id="reportSubmitBtn" type="button">
        জমা দিন
      </button>
    </div>
  </div>
</div>

<style>
  .report-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 2100;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  .report-overlay.open {
    display: flex;
  }

  .report-modal {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 420px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    margin: auto;
    max-height: 90vh;
    overflow-y: auto;
  }

  .report-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .report-close:hover {
    background: #FF6B35;
    color: #fff;
  }

  .report-header {
    text-align: center;
    padding: 30px 26px 16px;
  }

  .report-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF0EA;
    color: #D14343;
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .report-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1B2A4A;
    margin: 0 0 6px;
  }

  .report-header p {
    font-size: 0.85rem;
    color: #8FA0BC;
    margin: 0;
  }

  .report-body {
    padding: 4px 26px 26px;
  }

  .report-reasons {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 18px;
  }

  .report-reason-option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    text-align: left;
    background: #F8FAFC;
    border: 1.5px solid #EEF3F9;
    color: #1B2A4A;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .report-reason-option:hover {
    border-color: #FFB89C;
  }

  .report-reason-option.selected {
    background: #FFF0EA;
    border-color: #FF6B35;
    color: #FF6B35;
  }

  .report-reason-option .radio-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid #D7E0EC;
    flex-shrink: 0;
    position: relative;
  }

  .report-reason-option.selected .radio-dot {
    border-color: #FF6B35;
  }

  .report-reason-option.selected .radio-dot::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: #FF6B35;
  }

  .report-details-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #5A6E85;
    margin-bottom: 8px;
  }

  .report-details-label span {
    color: #B0BCCB;
    font-weight: 400;
  }

  .report-details-input {
    width: 100%;
    border: 1.5px solid #EEF3F9;
    border-radius: 14px;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 0.88rem;
    color: #1B2A4A;
    resize: vertical;
    margin-bottom: 12px;
  }

  .report-details-input:focus {
    outline: none;
    border-color: #FF6B35;
  }

  .report-feedback {
    font-size: 0.82rem;
    font-weight: 600;
    margin: 0 0 12px;
    display: none;
  }

  .report-feedback.error {
    display: block;
    color: #D14343;
  }

  .report-feedback.success {
    display: block;
    color: #1E9E5A;
  }

  .report-submit-btn {
    width: 100%;
    background: #1B2A4A;
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .report-submit-btn:hover {
    background: #FF6B35;
  }

  .report-submit-btn:disabled {
    background: #D7E0EC;
    cursor: not-allowed;
  }
</style>