---
// ============================================================
// কম্পোনেন্ট: জরুরি নাম্বার বাটন + বটম-শীট
// ব্যবহার: Header.astro-তে লোকেশনের নিচে বসানো
// ডেটা: Supabase `emergency_contacts` (পাবলিক রিড, লগইন লাগে না)
// শীট প্রথমবার খোলার সময় ডেটা লোড হয় (পেজ লোড হালকা থাকে)
// ফেচ ফেইল করলে ৯৯৯ ফলব্যাক দেখায়
// শীট document.body-তে সরিয়ে নেওয়া হয়, কারণ হেডারে
// transform থাকলে position:fixed ভেঙে যায়
//
// আপডেট (লগইন-ভিত্তিক): হেডারের বাটন শুধু লগইন না থাকলে দেখায়।
// লগইন থাকলে বাটন লুকায় — তখন HamburgerMenu.astro-র "জরুরি নাম্বার"
// আইটেম থেকে 'smartfeni:open-emergency' ইভেন্টে একই শীট খোলে।
// ফ্ল্যাশ এড়াতে: বাটনের ঠিক পরের inline স্ক্রিপ্ট Header-এর
// 'sf_profile_cache_v1' ক্যাশ দেখে সাথে সাথে লুকায়, পরে আসল
// সেশন চেক দিয়ে কারেক্ট করে। auth-changed / logged-out ইভেন্টে লাইভ বদলায়।
// ============================================================
---

<button type="button" class="emg-btn" id="emgOpenBtn" aria-haspopup="dialog">
  <span class="emg-dot"></span>
  <span>জরুরি নাম্বার</span>
</button>
<script is:inline>
  // পেইন্টের আগেই চলে — লগইন ক্যাশ থাকলে বাটন লুকায় (ফ্ল্যাশ ঠেকাতে)
  try {
    if (localStorage.getItem('sf_profile_cache_v1')) {
      document.getElementById('emgOpenBtn').style.display = 'none';
    }
  } catch (e) {}
</script>

<div class="emg-back" id="emgBack"></div>
<section class="emg-sheet" id="emgSheet" role="dialog" aria-modal="true" aria-labelledby="emgTitle" aria-hidden="true">
  <div class="emg-grab"></div>
  <div class="emg-head">
    <div>
      <h2 id="emgTitle">জরুরি নাম্বার</h2>
      <p>নাম্বারে ট্যাপ করলেই কল হবে</p>
    </div>
    <button type="button" class="emg-close" id="emgCloseBtn" aria-label="বন্ধ করুন">×</button>
  </div>
  <div class="emg-body" id="emgList"></div>
</section>

<style is:global>
  .emg-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1.5px solid #D92D20;
    background: #FEF0EE;
    color: #D92D20;
    border-radius: 999px;
    padding: 4px 11px 4px 9px;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    white-space: nowrap;
  }
  .emg-btn:focus-visible,
  .emg-close:focus-visible,
  .emg-call:focus-visible {
    outline: 3px solid #FF6B35;
    outline-offset: 2px;
  }
  .emg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #D92D20;
    animation: emgPulse 2.2s ease-out 3;
  }
  @keyframes emgPulse {
    0% { box-shadow: 0 0 0 0 rgba(217, 45, 32, 0.55); }
    100% { box-shadow: 0 0 0 10px rgba(217, 45, 32, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .emg-dot { animation: none; }
    .emg-sheet { transition: none !important; }
  }

  .emg-back {
    position: fixed;
    inset: 0;
    background: rgba(10, 15, 30, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 2000;
  }
  .emg-back.on { opacity: 1; pointer-events: auto; }

  .emg-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: 480px;
    margin: 0 auto;
    z-index: 2001;
    background: #F8FAFC;
    border-radius: 22px 22px 0 0;
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    transform: translateY(102%);
    transition: transform 0.26s ease;
    visibility: hidden;
  }
  .emg-sheet.on { transform: none; visibility: visible; }

  .emg-grab { width: 42px; height: 4px; border-radius: 4px; background: #E2E8F0; margin: 10px auto 0; }
  .emg-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px 10px; }
  .emg-head h2 { margin: 0; font-size: 1.15rem; font-weight: 800; color: #1B2A4A; }
  .emg-head p { margin: 2px 0 0; font-size: 0.8rem; color: #64748B; }
  .emg-close {
    border: 1px solid #E2E8F0;
    background: #fff;
    color: #1B2A4A;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .emg-body { overflow-y: auto; padding: 0 16px calc(24px + env(safe-area-inset-bottom, 0px)); }
  .emg-cat { font-size: 0.86rem; font-weight: 700; color: #64748B; margin: 16px 2px 8px; }
  .emg-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 11px 12px 11px 14px;
    margin-bottom: 8px;
  }
  .emg-info { flex: 1; min-width: 0; }
  .emg-name { font-size: 0.92rem; font-weight: 600; line-height: 1.35; color: #1B2A4A; }
  .emg-note { font-size: 0.78rem; color: #64748B; }
  .emg-num { font-size: 0.95rem; font-weight: 700; color: #1B2A4A; letter-spacing: 0.2px; margin-top: 1px; }
  .emg-call {
    flex: none;
    text-decoration: none;
    background: #E7F6EF;
    color: #12805C;
    font-weight: 700;
    font-size: 0.85rem;
    border-radius: 999px;
    padding: 9px 14px;
  }
  .emg-msg { text-align: center; color: #64748B; font-size: 0.88rem; padding: 18px 8px; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const openBtn = document.getElementById('emgOpenBtn');
  const sheet = document.getElementById('emgSheet');
  const back = document.getElementById('emgBack');
  const closeBtn = document.getElementById('emgCloseBtn');
  const list = document.getElementById('emgList');

  // হেডারের transform থেকে বাঁচাতে শীট ও ব্যাকড্রপ body-তে সরানো
  if (sheet && back) {
    document.body.appendChild(back);
    document.body.appendChild(sheet);
  }

  const ICONS = {
    'জরুরি সেবা': '🚨',
    'পুলিশ': '👮',
    'ফায়ার সার্ভিস': '🚒',
    'হাসপাতাল': '🏥',
    'অ্যাম্বুলেন্স': '🚑',
    'নারী ও শিশু': '🛡️',
    'বিদ্যুৎ': '⚡',
    'অন্যান্য': '📞',
  };

  let loaded = false;
  let loading = false;

  function cleanTel(p) {
    return String(p || '').replace(/[^0-9+]/g, '');
  }

  function msg(text) {
    list.innerHTML = '';
    const d = document.createElement('div');
    d.className = 'emg-msg';
    d.textContent = text;
    list.appendChild(d);
  }

  function itemEl(r) {
    const row = document.createElement('div');
    row.className = 'emg-item';

    const info = document.createElement('div');
    info.className = 'emg-info';

    const n = document.createElement('div');
    n.className = 'emg-name';
    n.textContent = r.name;
    info.appendChild(n);

    if (r.note) {
      const s = document.createElement('div');
      s.className = 'emg-note';
      s.textContent = r.note;
      info.appendChild(s);
    }

    const num = document.createElement('div');
    num.className = 'emg-num';
    num.textContent = r.phone;
    info.appendChild(num);

    const a = document.createElement('a');
    a.className = 'emg-call';
    a.href = 'tel:' + cleanTel(r.phone);
    a.textContent = '📞 কল';
    a.setAttribute('aria-label', r.name + ' — কল করুন');

    row.appendChild(info);
    row.appendChild(a);
    return row;
  }

  function render(rows) {
    list.innerHTML = '';
    if (!rows.length) {
      msg('এখনো কোনো নাম্বার যোগ করা হয়নি।');
      return;
    }
    let last = null;
    rows.forEach((r) => {
      if (r.category !== last) {
        last = r.category;
        const h = document.createElement('div');
        h.className = 'emg-cat';
        h.textContent = (ICONS[last] ? ICONS[last] + ' ' : '') + last;
        list.appendChild(h);
      }
      list.appendChild(itemEl(r));
    });
  }

  async function load() {
    if (loaded || loading) return;
    loading = true;
    msg('লোড হচ্ছে...');
    try {
      const { data, error } = await supabase
        .from('emergency_contacts')
        .select('category, name, phone, note, sort_order')
        .eq('is_active', true)
        .order('sort_order', { ascending: true });
      if (error) throw error;
      render(data || []);
      loaded = true;
    } catch (e) {
      list.innerHTML = '';
      const h = document.createElement('div');
      h.className = 'emg-cat';
      h.textContent = '🚨 জরুরি সেবা';
      list.appendChild(h);
      list.appendChild(itemEl({ name: '৯৯৯ (পুলিশ, ফায়ার, অ্যাম্বুলেন্স)', phone: '999', note: 'তালিকা লোড হয়নি, ইন্টারনেট চেক করে আবার চেষ্টা করুন' }));
    } finally {
      loading = false;
    }
  }

  let lastFocus = null;

  function show(on) {
    sheet.classList.toggle('on', on);
    back.classList.toggle('on', on);
    sheet.setAttribute('aria-hidden', on ? 'false' : 'true');
    if (on) {
      lastFocus = document.activeElement;
      load();
      closeBtn?.focus();
    } else {
      // বাটন লুকানো থাকলে (লগইন) ফোকাস ফেরানো হয় না
      if (openBtn && openBtn.style.display !== 'none') openBtn.focus();
      else if (lastFocus && document.body.contains(lastFocus)) lastFocus.focus?.();
    }
  }

  openBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    show(true);
  });
  closeBtn?.addEventListener('click', () => show(false));
  back?.addEventListener('click', () => show(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheet.classList.contains('on')) show(false);
  });

  // হ্যামবার্গার মেনু (লগইন থাকলে) থেকে খোলার ইভেন্ট
  window.addEventListener('smartfeni:open-emergency', () => show(true));

  // ===== লগইন থাকলে হেডার বাটন লুকানো, না থাকলে দেখানো =====
  function setHeaderBtn(loggedIn) {
    if (!openBtn) return;
    openBtn.style.display = loggedIn ? 'none' : '';
  }

  async function checkSession() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      setHeaderBtn(!!session);
    } catch (e) {
      // সেশন চেক ফেইল করলে ক্যাশের অবস্থাই থাকবে
    }
  }

  checkSession();
  window.addEventListener('smartfeni:auth-changed', () => setHeaderBtn(true));
  window.addEventListener('smartfeni:logged-out', () => setHeaderBtn(false));
</script>