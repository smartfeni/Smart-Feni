---
// ============================================================
// ConsoleShell — নতুন অ্যাডমিন অ্যাপের (/console) লেআউট
// হেডারে লগইন করা মানুষের ছবি, নাম, পদবি (শুধু দেখানো, মেনু নেই)।
// ফোনে নিচে ট্যাব বার, বড় স্ক্রিনে বাঁয়ে সাইডবার।
// গার্ড/প্রোফাইল: src/lib/consoleApp.js (initConsole, onConsoleReady)।
// পুরনো /admin প্যানেল অপরিবর্তিত; এখনো না বানানো পেজ পুরনো প্যানেলে খোলে।
//
// ব্যবহার:
//   <ConsoleShell title="অ্যাক্টিভিটি লগ" active="activity"> ...পেজ... </ConsoleShell>
// ============================================================
import BaseLayout from '../layout/BaseLayout.astro';
import Skeleton from '../ui/Skeleton.astro';

interface Props {
  title: string;
  active?: 'home' | 'todo' | 'orders' | 'search' | 'menu' | 'activity';
}
const { title, active = 'home' } = Astro.props;
const on = (k: string) => (active === k ? 'page' : undefined);
---

<BaseLayout title={`${title} | Smart Feni Admin`} bare noindex>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@500;600;700&family=Hind+Siliguri:wght@400;500;600&display=swap" rel="stylesheet" />

  <div class="cs-app" data-no-i18n>
    <aside class="cs-side" aria-label="অ্যাডমিন মেনু">
      <a href="/console" class="cs-brand">
        <span class="cs-brand-mark" aria-hidden="true">স</span>
        <span class="cs-brand-text"><b>স্মার্ট ফেনী</b><small>অ্যাডমিন</small></span>
      </a>
      <nav class="cs-side-nav">
        <a href="/console" aria-current={on('home')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>হোম
        </a>
        <a href="/console/todo" aria-current={on('todo')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l2 2 4-4"/><rect x="4" y="4" width="16" height="16" rx="3"/></svg>করণীয়<span class="cs-badge" data-cs-todo-badge hidden></span>
        </a>
        <a href="/console/orders" data-cs-admin-href="/admin/delivery-orders" aria-current={on('orders')} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>অর্ডার
        </a>
        <a href="/console/search" aria-current={on('search')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>খুঁজুন
        </a>
        <a href="/console/menu" aria-current={on('menu') || on('activity')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>মেনু
        </a>
      </nav>
    </aside>

    <div class="cs-main">
      <header class="cs-top">
        <div class="cs-me">
          <span class="cs-avatar" data-cs-avatar aria-hidden="true"></span>
          <span class="cs-me-text">
            <b data-cs-name><span class="sk sk-line" style="width:120px"></span></b>
            <small data-cs-role></small>
          </span>
        </div>
        <a href="/console/search" class="cs-icon-btn" aria-label="খুঁজুন">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
      </header>

      <div id="csGateLoading" class="cs-pad"><Skeleton preset="row" count={4} /></div>
      <div id="csGateDenied" class="cs-pad" hidden>
        <div class="cs-denied">
          <h1>অ্যাক্সেস নেই</h1>
          <p>এই অ্যাপ শুধু স্মার্ট ফেনীর অ্যাডমিন ও স্টাফদের জন্য।</p>
          <a href="/" class="cs-btn">স্মার্ট ফেনী হোমে যান</a>
          <button type="button" class="cs-btn cs-btn-ghost" data-cs-logout>অন্য অ্যাকাউন্টে লগইন</button>
        </div>
      </div>
      <div id="csContent" hidden>
        <slot />
      </div>
    </div>

    <nav class="cs-tabs" aria-label="প্রধান মেনু">
      <a href="/console" aria-current={on('home')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>হোম
      </a>
      <a href="/console/todo" aria-current={on('todo')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l2 2 4-4"/><rect x="4" y="4" width="16" height="16" rx="3"/></svg>করণীয়<span class="cs-badge" data-cs-todo-badge hidden></span>
      </a>
      <a href="/console/orders" data-cs-admin-href="/admin/delivery-orders" aria-current={on('orders')} hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>অর্ডার
      </a>
      <a href="/console/search" aria-current={on('search')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>খুঁজুন
      </a>
      <a href="/console/menu" aria-current={on('menu') || on('activity')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>মেনু
      </a>
    </nav>
  </div>
</BaseLayout>

<style is:global>
  body.sf-bare {
    background: #F7F5F2;
    padding-bottom: 0;
    font-family: 'Hind Siliguri', system-ui, sans-serif;
    color: #1B2A4A;
  }
  .cs-app { display: flex; min-height: 100vh; }
  .cs-app a { color: inherit; text-decoration: none; }
  .cs-app svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .cs-app [hidden] { display: none !important; }
  .cs-h { font-family: 'Anek Bangla', 'Hind Siliguri', sans-serif; font-weight: 600; letter-spacing: -.01em; }
  .cs-num { font-family: 'Anek Bangla', 'Hind Siliguri', sans-serif; font-weight: 700; }

  /* সাইডবার: বড় স্ক্রিনে */
  .cs-side { display: none; }
  @media (min-width: 900px) {
    .cs-side {
      display: flex; flex-direction: column; gap: 22px;
      width: 240px; flex-shrink: 0; background: #1B2A4A; color: #C9D2E0;
      padding: 22px 14px; box-sizing: border-box; position: sticky; top: 0; height: 100vh;
    }
  }
  .cs-brand { display: flex; align-items: center; gap: 10px; padding: 0 8px; }
  .cs-brand-mark { width: 34px; height: 34px; border-radius: 10px; background: #E8541C; color: #fff; display: flex; align-items: center; justify-content: center; font-family: 'Anek Bangla', sans-serif; font-weight: 700; font-size: 17px; }
  .cs-brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .cs-brand-text b { font-family: 'Anek Bangla', sans-serif; font-size: 17px; color: #fff; }
  .cs-brand-text small { font-size: 12px; color: #9FB0C8; }
  .cs-side-nav { display: flex; flex-direction: column; gap: 2px; }
  .cs-side-nav a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; font-size: 14.5px; min-height: 44px; box-sizing: border-box; }
  .cs-side-nav a:hover { background: rgba(255,255,255,.05); color: #fff; }
  .cs-side-nav a[aria-current="page"] { background: rgba(255,255,255,.09); color: #fff; font-weight: 600; }
  .cs-side-nav svg { width: 18px; height: 18px; }

  .cs-main { flex: 1; min-width: 0; padding-bottom: calc(78px + env(safe-area-inset-bottom)); }
  @media (min-width: 900px) { .cs-main { padding-bottom: 40px; } }

  /* হেডার: প্রোফাইল (শুধু দেখানো) + খোঁজ */
  .cs-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px 6px; max-width: 1180px; margin: 0 auto; }
  @media (min-width: 900px) { .cs-top { padding: 22px 32px 6px; } }
  .cs-me { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .cs-avatar { width: 42px; height: 42px; border-radius: 50%; background: #DCE3EC; color: #1B2A4A; display: flex; align-items: center; justify-content: center; font-family: 'Anek Bangla', sans-serif; font-weight: 700; font-size: 17px; overflow: hidden; flex-shrink: 0; box-shadow: 0 0 0 2px #fff, 0 0 0 3px #E7E2DA; }
  .cs-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .cs-me-text { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .cs-me-text b { font-weight: 600; font-size: 15.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cs-me-text small { font-size: 12.5px; color: #5F6B7E; }
  .cs-icon-btn { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cs-icon-btn:hover { background: #EFEBE5; }

  .cs-pad { padding: 14px 20px; max-width: 1180px; margin: 0 auto; box-sizing: border-box; }
  @media (min-width: 900px) { .cs-pad { padding: 14px 32px; } }
  .cs-denied { background: #fff; border: 1px solid #E7E2DA; border-radius: 18px; padding: 28px 22px; text-align: center; }
  .cs-denied h1 { margin: 0 0 6px; font-family: 'Anek Bangla', sans-serif; font-size: 22px; }
  .cs-denied p { margin: 0 0 18px; color: #5F6B7E; }
  .cs-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 18px; border-radius: 12px; background: #1B2A4A; color: #fff !important; font-weight: 600; }
  .cs-btn-ghost { background: #fff; color: #1B2A4A !important; border: 1.5px solid #D5DCE8; margin-left: 8px; cursor: pointer; font: inherit; font-weight: 600; }

  /* শেয়ার্ড কার্ড/সেকশন */
  .cs-card { background: #fff; border: 1px solid #E7E2DA; border-radius: 18px; }
  .cs-sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0 0 10px; }
  .cs-sec-head h2 { margin: 0; font-size: 19px; }
  .cs-muted { color: #5F6B7E; font-size: 13px; }
  .cs-tag { align-self: flex-start; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 6px; white-space: nowrap; }

  .cs-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }

  /* মেনু-ট্রি, খোঁজ ও করণীয় (consoleMenu.itemEl) */
  .cm-page { display: flex; flex-direction: column; gap: 14px; }
  .cm-title { margin: 6px 0 0; font-size: 26px; }
  .cm-hint { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 12.5px; }
  .cm-hint svg { width: 14px !important; height: 14px !important; }
  .cm-tree { display: flex; flex-direction: column; gap: 12px; }
  .cm-logout { margin-top: 22px; width: 100%; min-height: 50px; display: flex; align-items: center; justify-content: center; gap: 8px; border: 1.5px solid #FAD4D4; border-radius: 16px; background: #fff; color: #D14343; font: inherit; font-weight: 700; font-size: 15px; cursor: pointer; }
  .cm-logout svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cm-sec { display: flex; flex-direction: column; gap: 8px; }
  .cm-head { display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 16px; min-height: 64px; box-sizing: border-box; background: #fff; border: 1px solid #E7E2DA; border-radius: 16px; font: inherit; color: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .cm-head[aria-expanded="true"] { border-color: #D8D1C6; }
  .cm-ic { width: 40px; height: 40px; border-radius: 12px; background: #F1F3F6; color: #1B2A4A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cm-head[aria-expanded="true"] .cm-ic { background: #1B2A4A; color: #fff; }
  .cm-head-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
  .cm-head-t b { font-family: 'Anek Bangla', 'Hind Siliguri', sans-serif; font-weight: 600; font-size: 17px; }
  .cm-head-t small { font-size: 12.5px; color: #5F6B7E; }
  .cm-count { font-size: 12px; color: #5F6B7E; background: #F1F3F6; border-radius: 999px; padding: 1px 8px; }
  .cm-chev svg { width: 18px !important; height: 18px !important; color: #7A8597; transition: transform .2s; display: block; }
  .cm-head[aria-expanded="false"] .cm-chev svg { transform: rotate(-90deg); }
  .cm-body { display: flex; flex-direction: column; background: #fff; border: 1px solid #E7E2DA; border-radius: 16px; overflow: hidden; }
  .cm-group { margin: 4px 0 0; font-size: 13px; font-weight: 600; color: #5F6B7E; }
  .cm-item { display: flex; align-items: center; gap: 12px; padding: 13px 16px; min-height: 56px; box-sizing: border-box; }
  .cm-item + .cm-item { border-top: 1px solid #EFEBE5; }
  a.cm-item:hover { background: #FBFAF8; }
  .cm-item-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .cm-item-t b { font-weight: 600; font-size: 15px; }
  .cm-item-t small { font-size: 12.5px; color: #5F6B7E; line-height: 1.45; }
  .cm-arrow { width: 16px !important; height: 16px !important; color: #9AA3B2; }
  .cm-item.is-soon { opacity: .7; }
  .cm-badge { font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 6px; background: #FFF1E8; color: #B23A0B; white-space: nowrap; }
  .cm-input { display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 14px; background: #fff; border: 1px solid #E7E2DA; border-radius: 12px; max-width: 560px; }
  .cm-input svg { width: 18px; height: 18px; color: #5F6B7E; }
  .cm-input input { border: 0; outline: 0; background: transparent; flex: 1; min-width: 0; font: inherit; font-size: 14.5px; color: inherit; }

  .cs-side-nav a, .cs-tabs a { position: relative; }
  .cs-badge { min-width: 18px; height: 18px; padding: 0 5px; box-sizing: border-box; border-radius: 9px; background: #C2410C; color: #fff; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; }
  .cs-tabs .cs-badge { position: absolute; top: 2px; left: calc(50% + 6px); }
  .cs-side-nav .cs-badge { margin-left: auto; }
  /* নিচের ট্যাব: ফোনে */
  .cs-tabs { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: #fff; border-top: 1px solid #E7E2DA; display: flex; padding: 6px 6px calc(8px + env(safe-area-inset-bottom)); }
  .cs-tabs a { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 6px 0; min-height: 48px; box-sizing: border-box; font-size: 12px; color: #5F6B7E; }
  .cs-tabs a[aria-current="page"] { color: #E8541C; font-weight: 600; }
  @media (min-width: 900px) { .cs-tabs { display: none; } }
</style>

<script>
  import { initConsole } from '../../lib/consoleApp.js';
  initConsole();
</script>
