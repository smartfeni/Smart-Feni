---
// ============================================================
// কম্পোনেন্ট: OrdersTab (shop-dashboard) — অর্ডার হিস্ট্রি ও
// স্ট্যাটাস ট্র্যাকিং (৩০ দিনের হিস্ট্রি)
// Pending → Confirmed → Delivered (+ যেকোনো ধাপ থেকে Cancel)
// প্যারেন্ট পেজ থেকে 'smartfeni:shop-ready' ইভেন্ট দিয়ে shopId পায়।
//
// UI POLISH (v2): cart/checkout/my-orders এর সাথে ভিজুয়াল
// consistency — কাস্টমার নামের পাশে icon badge, status badge এ dot
// indicator, contact বাটনে hover fill, address/items dashed divider
// দিয়ে সেকশন আলাদা, action বাটন বড়/আইকন-সহ শ্যাডো, empty state এ
// gradient icon badge। <style is:global> আগে থেকেই ছিল, অপরিবর্তিত।
// JS লজিক (status update, Supabase কল) সম্পূর্ণ অপরিবর্তিত।
//
// আপডেট: WhatsApp লিংক এখন toWhatsAppNumber() হেল্পার দিয়ে
// কান্ট্রি কোডসহ (88) বসানো হচ্ছে — প্রবাস থেকে কাস্টমারের নম্বরে
// ক্লিক করলে আগে নম্বর খুঁজে পেত না, এখন ঠিকভাবে কাজ করবে।
// ============================================================
---

<div class="dash-card">
  <h3><span class="section-icon-badge"><i class="fas fa-receipt"></i></span> অর্ডার (গত ৩০ দিন)</h3>

  <div id="ordersContainer" class="orders-list"></div>

  <div id="emptyOrders" class="empty-note" style="display:none;">
    <div class="empty-icon-badge"><i class="fas fa-inbox"></i></div>
    গত ৩০ দিনে কোনো অর্ডার আসেনি
  </div>
</div>

<style is:global>
  .section-icon-badge {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .orders-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .order-card {
    background: #FBFCFE;
    border: 1px solid #EEF3F9;
    border-radius: 18px;
    padding: 16px;
    transition: box-shadow 0.2s ease;
  }

  .order-card:hover {
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
  }

  .order-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px dashed #E5EAF0;
  }

  .order-customer-block {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .customer-icon-badge {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: #EAF2FF;
    color: #2563EB;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .order-customer-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: #1B2A4A;
  }

  .order-date {
    font-size: 0.72rem;
    color: #9AA8BC;
    margin-top: 2px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 12px 5px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .status-pending {
    background: #FFF4E0;
    color: #B8860B;
  }

  .status-confirmed {
    background: #EAF2FF;
    color: #2563EB;
  }

  .status-delivered {
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .status-cancelled {
    background: #FFF0EA;
    color: #D14343;
  }

  .order-contact-row {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
  }

  .order-contact-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px;
    border-radius: 11px;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .order-call-btn {
    background: #EAF2FF;
    color: #2563EB;
  }

  .order-call-btn:hover {
    background: #2563EB;
    color: #fff;
  }

  .order-wa-btn {
    background: #E9F9EF;
    color: #1EA952;
  }

  .order-wa-btn:hover {
    background: #1EA952;
    color: #fff;
  }

  .order-address {
    font-size: 0.8rem;
    color: #5A6E85;
    background: #F8FAFC;
    padding: 9px 12px;
    border-radius: 12px;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .order-address i {
    color: #FF6B35;
    margin-right: 6px;
  }

  .order-items-list {
    background: #fff;
    border: 1px solid #F0F3F8;
    border-radius: 12px;
    padding: 10px 14px;
    margin-bottom: 14px;
  }

  .order-item-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #3A4A60;
    padding: 4px 0;
  }

  .order-actions {
    display: flex;
    gap: 10px;
  }

  .order-actions button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: none;
    padding: 11px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-confirm-order {
    background: #2563EB;
    color: #fff;
    box-shadow: 0 6px 14px rgba(37, 99, 235, 0.28);
  }

  .btn-confirm-order:hover {
    background: #1D4FC4;
  }

  .btn-deliver-order {
    background: #1B7A3C;
    color: #fff;
    box-shadow: 0 6px 14px rgba(27, 122, 60, 0.28);
  }

  .btn-deliver-order:hover {
    background: #156530;
  }

  .btn-cancel-order {
    background: #FFF0EA;
    color: #D14343;
  }

  .btn-cancel-order:hover {
    background: #D14343;
    color: #fff;
  }

  .empty-note {
    font-size: 0.84rem;
    color: #8FA0BC;
    text-align: center;
    padding: 30px 0 10px;
    font-weight: 500;
  }

  .empty-icon-badge {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #F4F7FC, #E9EEF6);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
  }

  .empty-icon-badge i {
    font-size: 1.4rem;
    color: #B0BCCB;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { toWhatsAppNumber } from '../../lib/whatsapp.js';

  const ordersContainer = document.getElementById('ordersContainer');
  const emptyOrders = document.getElementById('emptyOrders');

  let currentShopId = null;

  const STATUS_LABELS = {
    pending: 'পেন্ডিং',
    confirmed: 'কনফার্মড',
    delivered: 'ডেলিভার্ড',
    cancelled: 'বাতিল',
  };

  function formatDate(iso) {
    return new Date(iso).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  async function loadOrders() {
    const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();

    const { data, error } = await supabase
      .from('orders')
      .select('*, order_items(*)')
      .eq('shop_id', currentShopId)
      .gte('created_at', thirtyDaysAgo)
      .order('created_at', { ascending: false });

    if (error) {
      console.error('অর্ডার লোড এরর:', error.message);
      return;
    }

    renderOrders(data || []);
  }

  function renderOrders(orders) {
    ordersContainer.innerHTML = '';

    if (orders.length === 0) {
      emptyOrders.style.display = 'block';
      return;
    }
    emptyOrders.style.display = 'none';

    orders.forEach((order) => {
      const card = document.createElement('div');
      card.className = 'order-card';

      const itemsHtml = (order.order_items || [])
        .map((it) => `<div class="order-item-line"><span>${it.title || ''} × ${it.quantity}</span><span>৳${it.price || 0}</span></div>`)
        .join('');

      let actionsHtml = '';
      if (order.status === 'pending') {
        actionsHtml = `
          <div class="order-actions">
            <button class="btn-confirm-order"><i class="fas fa-check"></i> কনফার্ম করুন</button>
            <button class="btn-cancel-order"><i class="fas fa-xmark"></i> বাতিল</button>
          </div>
        `;
      } else if (order.status === 'confirmed') {
        actionsHtml = `
          <div class="order-actions">
            <button class="btn-deliver-order"><i class="fas fa-truck"></i> ডেলিভার্ড করুন</button>
            <button class="btn-cancel-order"><i class="fas fa-xmark"></i> বাতিল</button>
          </div>
        `;
      }

      card.innerHTML = `
        <div class="order-top-row">
          <div class="order-customer-block">
            <span class="customer-icon-badge"><i class="fas fa-user"></i></span>
            <div>
              <p class="order-customer-name">${order.customer_name || ''}</p>
              <p class="order-date">${formatDate(order.created_at)}</p>
            </div>
          </div>
          <span class="status-badge status-${order.status}">${STATUS_LABELS[order.status] || order.status}</span>
        </div>

        <div class="order-contact-row">
          <a href="tel:${order.customer_phone}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>
          <a href="https://wa.me/${toWhatsAppNumber(order.customer_phone)}" target="_blank" rel="noopener" class="order-contact-btn order-wa-btn"><i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ</a>
        </div>

        ${order.customer_address ? `<p class="order-address"><i class="fas fa-map-pin"></i> ${order.customer_address}</p>` : ''}

        <div class="order-items-list">${itemsHtml}</div>

        ${actionsHtml}
      `;

      card.querySelector('.btn-confirm-order')?.addEventListener('click', () => updateStatus(order.id, 'confirmed'));
      card.querySelector('.btn-deliver-order')?.addEventListener('click', () => updateStatus(order.id, 'delivered'));
      card.querySelector('.btn-cancel-order')?.addEventListener('click', () => {
        if (confirm('এই অর্ডারটি বাতিল করতে চান?')) updateStatus(order.id, 'cancelled');
      });

      ordersContainer.appendChild(card);
    });
  }

  async function updateStatus(orderId, newStatus) {
    const { error } = await supabase.from('orders').update({ status: newStatus }).eq('id', orderId);
    if (error) {
      alert('আপডেট ব্যর্থ: ' + error.message);
      return;
    }
    loadOrders();
  }

  window.addEventListener('smartfeni:shop-ready', (e) => {
    currentShopId = e.detail.shopId;
    loadOrders();
  });
</script>