---
// ============================================================
// কম্পোনেন্ট: ProductsTab (shop-dashboard) — প্রোডাক্ট Add/Edit/Delete
// আপডেট: শেয়ার বাটন সরানো হয়েছে (ড্যাশবোর্ডে দরকার নেই, শুধু
// প্রোডাক্ট প্রিভিউ পেজে /product/{id} শেয়ার থাকবে)
// আপডেট (বড়): এডিট মোডালে এখন সম্পূর্ণ ছবি ম্যানেজমেন্ট — বিদ্যমান
// ছবি রিমুভ + নতুন ছবি যোগ (AddListingModal এর ইতিমধ্যে global CSS
// class .listing-image-grid/.listing-image-box রিইউজ করা হয়েছে,
// যেহেতু এই পেজেই <AddListingModal /> রেন্ডার হয় বলে সেই is:global
// স্টাইল এমনিতেই লোড থাকে)। আগে টাইটেল/বিবরণ/দাম ছাড়া কিছুই এডিট
// করা যেত না, ছবি বদলাতে হলে পুরো প্রোডাক্ট ডিলিট করে নতুন করে
// বানাতে হতো।
// আপডেট: প্রোডাক্ট "সোল্ড আউট" টগল যোগ হয়েছে (is_sold_out কলাম) —
// বেস্ট সেলার টগলের মতোই প্যাটার্ন, প্রোডাক্ট শেষ হয়ে গেলে মার্ক
// করা যাবে, আবার স্টকে আসলে সরানো যাবে।
// বাগফিক্স: এই কম্পোনেন্টের এডিট মোডাল আগে .form-input/.form-label/
// .form-msg/.primary-btn ক্লাস ব্যবহার করত কিন্তু নিজের <style> এ
// ডিফাইন করত না — my-shop.astro (parent পেজ) এর স্কোপড স্টাইলের
// উপর নির্ভর করছিল, যেটা Astro এর component-scoped CSS নিয়মে
// আসলে কাজ করার কথা না (parent এর scoped স্টাইল child component এ
// প্রযোজ্য হয় না)। এখন এই কম্পোনেন্টের নিজের is:global ব্লকেই এই
// ক্লাসগুলা ডিফাইন করে দেওয়া হলো যাতে নিশ্চিতভাবে কাজ করে।
// ============================================================

import AddListingModal from '../ui/AddListingModal.astro';
---

<div class="dash-card">
  <h3><i class="fas fa-box"></i> প্রোডাক্ট তালিকা</h3>

  <button class="primary-btn" id="openAddListing" type="button" style="margin-top:0; margin-bottom:20px;">
    <i class="fas fa-plus"></i> নতুন প্রোডাক্ট যোগ করুন
  </button>

  <div id="productsContainer" class="products-grid"></div>

  <div id="emptyState" class="empty-note" style="display:none;">
    <i class="fas fa-box-open" style="font-size:1.6rem; color:#D7E0EC; display:block; margin-bottom:8px;"></i>
    এখনো কোনো প্রোডাক্ট যোগ করা হয়নি — উপরের বাটনে ক্লিক করে প্রথম প্রোডাক্ট যোগ করুন
  </div>
</div>

<!-- ===== প্রোডাক্ট এডিট মোডাল ===== -->
<div class="edit-overlay" id="editOverlay">
  <div class="edit-modal">
    <button class="edit-close" id="editClose" aria-label="বন্ধ করুন">
      <i class="fas fa-xmark"></i>
    </button>

    <h2 class="edit-title"><i class="fas fa-pen"></i> প্রোডাক্ট এডিট করুন</h2>

    <p class="form-msg" id="editMessage"></p>

    <label class="form-label">প্রোডাক্টের নাম</label>
    <input type="text" class="form-input" id="editTitle" />

    <label class="form-label">বিবরণ</label>
    <textarea class="form-input" id="editDescription" rows="3"></textarea>
    <p class="form-hint">পণ্যের পরিমাণ অথবা পণ্য সম্পর্কে লিখুন</p>

    <label class="form-label">দাম</label>
    <input type="text" class="form-input" id="editPrice" />
    <p class="form-hint">উদাহরণ: ১০০ টাকা, অথবা এককসহ যেমন ১৫০ টাকা (প্রতি কেজি)</p>

    <label class="form-label">ছবি</label>
    <input type="file" id="editImagesInput" accept="image/*" multiple hidden />
    <div class="listing-image-grid" id="editImageGrid"></div>

    <button class="primary-btn" id="editSaveBtn" type="button">
      <i class="fas fa-check"></i> <span>সেভ করুন</span>
    </button>
  </div>
</div>

<AddListingModal
  category="online-shop"
  typeOptions={[{ id: 'product', label: 'প্রোডাক্ট' }]}
  titleLabel="প্রোডাক্টের নাম"
  priceLabel="দাম"
  autoActive={true}
  nounLabel="প্রোডাক্ট"
/>

<style>
  .edit-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  .edit-overlay.open {
    display: flex;
  }

  .edit-modal {
    position: relative;
    background: #fff;
    width: 100%;
    max-width: 420px;
    border-radius: 28px;
    padding: 32px 28px 28px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
    margin: auto;
  }

  .edit-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #F4F7FC;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #5A6E85;
    cursor: pointer;
  }

  .edit-title {
    font-size: 1.15rem;
    color: #1B2A4A;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .edit-title i {
    color: #FF6B35;
  }
</style>

<style is:global>
  /* এডিট মোডালের ফর্ম স্টাইল — এই কম্পোনেন্টের নিজের is:global ব্লকে
     ডিফাইন করা হলো (আগে পাশাপাশি my-shop.astro এর উপর নির্ভর করত,
     যেটা Astro স্কোপিং নিয়মে ঠিক ছিল না) */
  .form-msg {
    display: none;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 12px;
    margin-bottom: 12px;
    text-align: center;
  }

  .form-msg.show-error {
    display: block;
    background: #FFF0EA;
    color: #D14343;
  }

  .form-msg.show-success {
    display: block;
    background: #EAFBF0;
    color: #1B7A3C;
  }

  .form-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #1B2A4A;
    margin-bottom: 6px;
    margin-top: 14px;
  }

  .form-label:first-of-type {
    margin-top: 0;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1.5px solid #E5EAF0;
    font-size: 0.9rem;
    font-family: inherit;
    color: #1B2A4A;
    background: #FBFCFE;
    resize: vertical;
  }

  .form-input:focus {
    outline: none;
    border-color: #FF6B35;
    background: #fff;
  }

  .form-hint {
    font-size: 0.74rem;
    color: #9AA8BC;
    margin-top: 5px;
  }

  .primary-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    border: none;
    padding: 13px;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    margin-top: 16px;
  }

  .primary-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }

  .product-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  }

  .product-photo-frame {
    width: 100%;
    height: 170px;
    overflow: hidden;
    background: #F4F7FC;
  }

  .product-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-photo-frame img {
    transform: scale(1.05);
  }

  .product-icon-frame {
    width: 100%;
    height: 170px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }

  .product-body {
    padding: 14px 16px 16px;
  }

  .product-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-price {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #FF6B35;
    background: #FFF0EA;
    padding: 2px 10px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  .product-photo-wrap {
    position: relative;
  }

  .best-seller-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #FFD700;
    color: #7A5C00;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .sold-out-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(15, 23, 42, 0.75);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .product-card.sold-out .product-photo-frame img,
  .product-card.sold-out .product-icon-frame {
    opacity: 0.5;
  }

  .btn-star {
    background: #FFF7DB;
    color: #B8860B;
  }

  .btn-star.active {
    background: #FFD700;
    color: #7A5C00;
  }

  .btn-soldout {
    background: #F4F7FC;
    color: #5A6E85;
  }

  .btn-soldout.active {
    background: #1B2A4A;
    color: #fff;
  }

  .product-actions {
    display: flex;
    gap: 8px;
  }

  .product-actions button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: none;
    padding: 9px;
    border-radius: 10px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .product-actions button:hover {
    opacity: 0.8;
  }

  .btn-edit {
    background: #F4F7FC;
    color: #1B2A4A;
  }

  .btn-delete {
    background: #FFF0EA;
    color: #D14343;
  }

  /* ============================================================
     পারমিশন-ভিত্তিক বাটন hide — my-shop.astro এর init() ফাংশন
     body তে mod-no-* ক্লাস বসায় (owner হলে কোনো ক্লাসই বসে না)।
     ============================================================ */
  body.mod-no-edit-listings #openAddListing,
  body.mod-no-edit-listings .btn-edit,
  body.mod-no-edit-listings .btn-star {
    display: none !important;
  }

  body.mod-no-delete .btn-delete {
    display: none !important;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImages } from '../../lib/imageCompress.js';

  const productsContainer = document.getElementById('productsContainer');
  const emptyState = document.getElementById('emptyState');

  let currentUserId = null;
  let currentShopSlug = null;
  let products = [];

  async function loadProducts() {
    const { data, error } = await supabase
      .from('listings')
      .select('*')
      .eq('category', 'online-shop')
      .eq('user_id', currentUserId)
      .order('created_at', { ascending: false });

    if (error) {
      console.error('প্রোডাক্ট লোড এরর:', error.message);
    }

    products = data || [];
    renderProducts();
  }

  function renderProducts() {
    productsContainer.innerHTML = '';

    if (products.length === 0) {
      emptyState.style.display = 'block';
      return;
    }
    emptyState.style.display = 'none';

    products.forEach((p) => {
      const card = document.createElement('div');
      card.className = `product-card ${p.is_sold_out ? 'sold-out' : ''}`;

      const imageHtml = p.images && p.images.length > 0
        ? `<div class="product-photo-frame"><img src="${p.images[0]}" alt="${p.title || ''}" /></div>`
        : `<div class="product-icon-frame"><i class="fas fa-box"></i></div>`;

      const bestSellerBadge = p.is_best_seller
        ? `<span class="best-seller-badge"><i class="fas fa-star"></i> বেস্ট সেলার</span>`
        : '';

      const soldOutBadge = p.is_sold_out
        ? `<span class="sold-out-badge"><i class="fas fa-ban"></i> সোল্ড আউট</span>`
        : '';

      card.innerHTML = `
        <div class="product-photo-wrap">
          ${imageHtml}
          ${bestSellerBadge}
          ${soldOutBadge}
        </div>
        <div class="product-body">
          <p class="product-title">${p.title || ''}</p>
          ${p.price ? `<span class="product-price">৳${p.price}</span>` : ''}
          <div class="product-actions">
            <button class="btn-edit"><i class="fas fa-pen"></i> এডিট</button>
            <button class="btn-delete"><i class="fas fa-trash"></i> ডিলিট</button>
          </div>
          <div class="product-actions">
            <button class="btn-star ${p.is_best_seller ? 'active' : ''}" style="flex:1;"><i class="fas fa-star"></i> ${p.is_best_seller ? 'বেস্ট সেলার' : 'বেস্ট সেলার করুন'}</button>
          </div>
          <div class="product-actions">
            <button class="btn-soldout ${p.is_sold_out ? 'active' : ''}" style="flex:1;"><i class="fas fa-ban"></i> ${p.is_sold_out ? 'সোল্ড আউট (সরান)' : 'সোল্ড আউট করুন'}</button>
          </div>
        </div>
      `;

      card.querySelector('.btn-edit').addEventListener('click', () => openEdit(p));
      card.querySelector('.btn-delete').addEventListener('click', () => deleteProduct(p.id));
      card.querySelector('.btn-star').addEventListener('click', () => toggleBestSeller(p));
      card.querySelector('.btn-soldout').addEventListener('click', () => toggleSoldOut(p));

      productsContainer.appendChild(card);
    });
  }

  async function toggleBestSeller(product) {
    const newValue = !product.is_best_seller;

    await supabase.from('listings').update({ is_best_seller: false }).eq('user_id', currentUserId);

    if (newValue) {
      await supabase.from('listings').update({ is_best_seller: true }).eq('id', product.id);
    }

    loadProducts();
  }

  async function toggleSoldOut(product) {
    const newValue = !product.is_sold_out;

    const { error } = await supabase.from('listings').update({ is_sold_out: newValue }).eq('id', product.id);
    if (error) {
      alert('আপডেট ব্যর্থ: ' + error.message);
      return;
    }

    loadProducts();
  }

  async function deleteProduct(id) {
    if (!confirm('এই প্রোডাক্টটি ডিলিট করতে চান?')) return;

    const { error } = await supabase.from('listings').delete().eq('id', id);
    if (error) {
      alert('ডিলিট ব্যর্থ: ' + error.message);
      return;
    }
    loadProducts();
  }

  const editOverlay = document.getElementById('editOverlay');
  const editClose = document.getElementById('editClose');
  const editMessage = document.getElementById('editMessage');
  const editTitleInput = document.getElementById('editTitle');
  const editDescInput = document.getElementById('editDescription');
  const editPriceInput = document.getElementById('editPrice');
  const editSaveBtn = document.getElementById('editSaveBtn');
  const editImagesInput = document.getElementById('editImagesInput');
  const editImageGrid = document.getElementById('editImageGrid');
  let editingId = null;
  let existingImageUrls = []; // ইতিমধ্যে আপলোড করা ছবি (URL) — রিমুভ করা যাবে
  let newImageFiles = []; // নতুন যোগ করা ছবি (কম্প্রেসড File) — সেভে আপলোড হবে

  function renderEditImageGrid() {
    editImageGrid.innerHTML = '';

    // বিদ্যমান ছবি (URL)
    existingImageUrls.forEach((url, index) => {
      const box = document.createElement('div');
      box.className = 'listing-image-box thumb-box';

      const img = document.createElement('img');
      img.src = url;
      box.appendChild(img);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'listing-image-remove-btn';
      removeBtn.innerHTML = '<i class="fas fa-xmark"></i>';
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        existingImageUrls.splice(index, 1);
        renderEditImageGrid();
      });
      box.appendChild(removeBtn);

      editImageGrid.appendChild(box);
    });

    // নতুন যোগ করা ছবি (এখনো আপলোড হয়নি, লোকাল প্রিভিউ)
    newImageFiles.forEach((file, index) => {
      const box = document.createElement('div');
      box.className = 'listing-image-box thumb-box';

      const img = document.createElement('img');
      const reader = new FileReader();
      reader.onload = () => { img.src = reader.result; };
      reader.readAsDataURL(file);
      box.appendChild(img);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'listing-image-remove-btn';
      removeBtn.innerHTML = '<i class="fas fa-xmark"></i>';
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        newImageFiles.splice(index, 1);
        renderEditImageGrid();
      });
      box.appendChild(removeBtn);

      editImageGrid.appendChild(box);
    });

    // সবসময় শেষে একটা ➕ বক্স
    const addBox = document.createElement('div');
    addBox.className = 'listing-image-box add-box';
    addBox.innerHTML = '<i class="fas fa-plus"></i>';
    addBox.addEventListener('click', () => editImagesInput.click());
    editImageGrid.appendChild(addBox);
  }

  editImagesInput?.addEventListener('change', async () => {
    const rawFiles = Array.from(editImagesInput.files || []);
    editImagesInput.value = '';
    if (rawFiles.length === 0) return;

    const compressedFiles = await compressImages(rawFiles);
    newImageFiles = newImageFiles.concat(compressedFiles);
    renderEditImageGrid();
  });

  // এডিট মোডালের ছবি আপলোড — AddListingModal এর /api/upload-image
  // রুটের একই প্যাটার্ন (service role key দিয়ে, RLS বাইপাস করে)
  async function uploadEditImages(accessToken) {
    const urls = [];
    for (const file of newImageFiles) {
      const fileExt = file.name.split('.').pop();
      const filePath = `online-shop/${currentUserId}-${Date.now()}-${Math.random().toString(36).slice(2, 7)}.${fileExt}`;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('path', filePath);

      const res = await fetch('/api/upload-image', {
        method: 'POST',
        headers: { Authorization: `Bearer ${accessToken}` },
        body: formData,
      });
      const result = await res.json();

      if (res.ok && result.url) {
        urls.push(result.url);
      } else {
        console.error('ছবি আপলোড এরর:', result.error);
      }
    }
    return urls;
  }

  function openEdit(product) {
    editingId = product.id;
    editTitleInput.value = product.title || '';
    editDescInput.value = product.description || '';
    editPriceInput.value = product.price || '';
    existingImageUrls = [...(product.images || [])];
    newImageFiles = [];
    renderEditImageGrid();
    editMessage.className = 'form-msg';
    editMessage.textContent = '';
    editOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeEdit() {
    editOverlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  editClose?.addEventListener('click', closeEdit);
  editOverlay?.addEventListener('click', (e) => {
    if (e.target === editOverlay) closeEdit();
  });

  editSaveBtn?.addEventListener('click', async () => {
    const title = editTitleInput.value.trim();
    if (!title) {
      editMessage.textContent = 'প্রোডাক্টের নাম আবশ্যক';
      editMessage.className = 'form-msg show-error';
      return;
    }

    editSaveBtn.disabled = true;
    const textEl = editSaveBtn.querySelector('span');
    const originalText = textEl.textContent;
    textEl.textContent = 'সেভ হচ্ছে...';

    const { data: { session } } = await supabase.auth.getSession();
    const newlyUploadedUrls = newImageFiles.length && session
      ? await uploadEditImages(session.access_token)
      : [];

    const finalImages = existingImageUrls.concat(newlyUploadedUrls);

    const { error } = await supabase
      .from('listings')
      .update({
        title,
        description: editDescInput.value.trim(),
        price: editPriceInput.value.trim(),
        images: finalImages,
      })
      .eq('id', editingId);

    editSaveBtn.disabled = false;
    textEl.textContent = originalText;

    if (error) {
      editMessage.textContent = 'সেভ ব্যর্থ: ' + error.message;
      editMessage.className = 'form-msg show-error';
      return;
    }

    editMessage.textContent = 'সেভ হয়েছে ✓';
    editMessage.className = 'form-msg show-success';
    setTimeout(() => {
      closeEdit();
      loadProducts();
    }, 700);
  });

  document.getElementById('openAddListing')?.addEventListener('click', () => {
    window.openListingModal?.('product');
  });

  window.addEventListener('smartfeni:shop-ready', (e) => {
    currentUserId = e.detail.shop.owner_id;
    currentShopSlug = e.detail.shop.slug;

    // ===== মডারেটর ফিক্স: AddListingModal-কে জানানো হচ্ছে নতুন
    // প্রোডাক্ট কার user_id দিয়ে সেভ হবে (শপ ওউনারের ID) — এটা না
    // করলে মডারেটরের যোগ করা প্রোডাক্ট মডারেটরের নিজের অ্যাকাউন্টে
    // সেভ হয়ে যেত, শপের প্রোডাক্ট লিস্টে দেখাত না =====
    const listingOverlay = document.getElementById('listingOverlay');
    if (listingOverlay) {
      listingOverlay.dataset.targetUserId = currentUserId;
    }

    loadProducts();
  });
</script>