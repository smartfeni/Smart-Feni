---
// ============================================================
// কম্পোনেন্ট: ProfileEditTab (shop-dashboard) — শপ প্রোফাইল এডিট
// শপের নাম, লোগো, কভার, বিবরণ, বাজার/এলাকার নাম, ফোন এডিট করা যায়।
// আপডেট (UI পুনর্বিন্যাস): Telegram অর্ডার নোটিফিকেশন সেকশন এখান
// থেকে সরিয়ে OrdersTab.astro তে নেওয়া হয়েছে (যেহেতু এটা অর্ডার
// নোটিফিকেশনের জন্য, তাই অর্ডার ট্যাবেই থাকা যুক্তিযুক্ত)।
// প্যারেন্ট পেজ (my-shop.astro) থেকে 'smartfeni:shop-ready' ইভেন্ট
// দিয়ে shop ডেটা পায়।
//
// আপডেট ২ (permission CSS): my-shop.astro এর init() ফাংশন body তে
// 'mod-no-settings' ক্লাস বসায় যখন মডারেটরের can_edit_settings
// পারমিশন নেই। তখন সব ইনপুট/সিলেক্ট readonly-দেখাবে (ভিউ করা যাবে,
// এডিট না), লোগো/কভার পরিবর্তন ও সেভ বাটন হাইড হয়ে যাবে — RLS policy
// moderator_update_shop-ও এই পারমিশন ছাড়া শপ আপডেট আটকে দেয়, তাই
// UI-ও সেভাবেই লক রাখা হলো। (Telegram কানেক্ট/ডিসকানেক্ট বাটনের
// একই পারমিশন-লক এখন OrdersTab.astro তে আছে, যেহেতু সেকশনটা
// সেখানে সরানো হয়েছে।)
// আপডেট (U3.3): কভারের সর্বোচ্চ সাইজ ১৬০০ → ১২৮০px — ছবি দ্রুত লোড হবে।
// (cacheControl আগে থেকেই api/upload-image.js এ ১ বছর সেট করা আছে)
// ============================================================
---

<div class="dash-card">
  <h3><i class="fas fa-id-card"></i> শপ প্রোফাইল</h3>

  <p class="form-msg" id="profileMsg"></p>

  <div class="photo-upload-circle" id="logoCircle">
    <img id="logoPreview" src="" alt="লোগো" />
    <i class="fas fa-store"></i>
  </div>
  <input type="file" id="logoInput" accept="image/*" style="display:none;" />
  <p class="form-hint" style="text-align:center; margin-top:-10px; margin-bottom:16px;">
    <button type="button" class="secondary-btn" id="chooseLogoBtn">লোগো পরিবর্তন করুন</button>
  </p>

  <label class="form-label">কভার ছবি</label>
  <div class="cover-preview" id="coverPreviewWrap">
    <img id="coverPreview" src="" alt="কভার" style="display:none;" />
    <div id="coverPlaceholder" class="cover-placeholder"><i class="fas fa-image"></i> কভার ছবি নেই</div>
  </div>
  <input type="file" id="coverInput" accept="image/*" style="display:none;" />
  <button type="button" class="secondary-btn" id="chooseCoverBtn" style="margin-top:8px;">কভার পরিবর্তন করুন</button>

  <label class="form-label">শপের নাম<span class="required-mark">*</span></label>
  <input type="text" class="form-input" id="shopNameInput" required placeholder="আপনার শপের নাম" />
  <div class="field-error-msg" data-error-for="shopNameInput">
    <i class="fas fa-circle-exclamation"></i><span>শপের নাম দিন</span>
  </div>

  <label class="form-label">বিবরণ</label>
  <textarea class="form-input" id="descriptionInput" rows="3" placeholder="আপনার শপ সম্পর্কে সংক্ষেপে লিখুন"></textarea>

  <label class="form-label">বাজার/এলাকার নাম</label>
  <input type="text" class="form-input" id="locationNameInput" placeholder="যেমন: সদর হাট, মিজান রোড ইত্যাদি" />
  <p class="form-hint">এটা শপ পেজে দেখানো হবে (উপজেলা পাবলিকলি দেখানো হয় না)</p>

  <label class="form-label">উপজেলা (শুধু অ্যাডমিন/অভ্যন্তরীণ ব্যবহারের জন্য)</label>
  <select class="form-input" id="upazilaInput">
    <option value="">নির্বাচন করুন</option>
    <option value="feni-sadar">ফেনী সদর</option>
    <option value="chhagalnaiya">ছাগলনাইয়া</option>
    <option value="daganbhuiyan">দাগনভূঞা</option>
    <option value="parshuram">পরশুরাম</option>
    <option value="fulgazi">ফুলগাজী</option>
    <option value="sonagazi">সোনাগাজী</option>
  </select>

  <label class="form-label">যোগাযোগের ফোন নম্বর</label>
  <input type="text" class="form-input" id="phoneInput" placeholder="01xxxxxxxxx" />

  <button class="primary-btn" id="saveProfileBtn" type="button">
    <i class="fas fa-check"></i> <span id="saveProfileBtnText">সেভ করুন</span>
  </button>
</div>

<!-- ===== শপের ধরন (সর্বোচ্চ ৩) ===== -->
<div class="dash-card" id="shopTypeCard">
  <h3><i class="fas fa-tags"></i> শপের ধরন</h3>
  <p class="form-hint" style="margin:-6px 0 12px;">সর্বোচ্চ ৩টা বাছুন — এই ধরন অনুযায়ী ক্রেতারা আপনার শপ খুঁজে পাবে</p>
  <div class="pe-chip-row" id="shopTypeChips"></div>
  <p class="form-hint" id="shopTypeCount"></p>
  <button class="primary-btn" id="saveShopTypeBtn" type="button">
    <i class="fas fa-check"></i> <span>সেভ করুন</span>
  </button>
</div>

<!-- ===== খোলার সময় ===== -->
<div class="dash-card" id="shopHoursCard">
  <h3><i class="fas fa-clock"></i> খোলার সময়</h3>
  <p class="form-hint" style="margin:-6px 0 12px;">বন্ধ সময়ে আপনার শপ ক্রেতাদের তালিকা থেকে নিজে থেকেই লুকিয়ে যাবে। ক্রেতারা কোনো "বন্ধ" লেখা দেখবে না।</p>

  <div class="pe-chip-row" id="hoursModeChips">
    <button type="button" class="pe-chip sel" data-mode="always">সবসময় খোলা</button>
    <button type="button" class="pe-chip" data-mode="timed">নির্দিষ্ট সময়</button>
  </div>

  <div id="hoursTimedWrap" style="display:none;">
    <div class="pe-time-row">
      <div>
        <label class="form-label">খোলে</label>
        <input type="time" class="form-input" id="hoursOpen" value="09:00" />
      </div>
      <div>
        <label class="form-label">বন্ধ হয়</label>
        <input type="time" class="form-input" id="hoursClose" value="21:00" />
      </div>
    </div>
    <p class="form-hint">রাত পার হলেও চলবে (যেমন রাত ১০টা থেকে ভোর ৪টা)। সময় বাংলাদেশ সময় ধরা হয়।</p>
  </div>

  <label class="form-label">সাপ্তাহিক বন্ধের দিন (ঐচ্ছিক)</label>
  <div class="pe-chip-row" id="offDayChips"></div>

  <label class="pe-toggle-row">
    <span>
      <b>সাময়িক বন্ধ</b>
      <small>ছুটি বা স্টক শেষ হলে চালু করুন, শপ সাথে সাথে লুকিয়ে যাবে</small>
    </span>
    <span class="pe-switch"><input type="checkbox" id="hoursPause" /><i></i></span>
  </label>

  <button class="primary-btn" id="saveHoursBtn" type="button">
    <i class="fas fa-check"></i> <span>সেভ করুন</span>
  </button>
</div>

<style>
  .cover-preview {
    width: 100%;
    aspect-ratio: 16/7;
    border-radius: 16px;
    overflow: hidden;
    background: #F4F7FC;
    border: 1.5px dashed #E5EAF0;
  }

  .cover-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #9AA8BC;
    font-size: 0.85rem;
  }
</style>

<!-- ============================================================
     পারমিশন-ভিত্তিক lock — my-shop.astro এর init() ফাংশন body তে
     'mod-no-settings' ক্লাস বসায় যখন মডারেটরের can_edit_settings
     পারমিশন নেই। is:global দরকার কারণ body এই কম্পোনেন্টের বাইরে।
     ============================================================ -->
<style is:global>
  body.mod-no-settings .photo-upload-circle {
    cursor: not-allowed;
    opacity: 0.7;
  }

  body.mod-no-settings #shopNameInput,
  body.mod-no-settings #descriptionInput,
  body.mod-no-settings #locationNameInput,
  body.mod-no-settings #upazilaInput,
  body.mod-no-settings #phoneInput {
    background: #F4F7FC;
    color: #9AA8BC;
    pointer-events: none;
  }

  body.mod-no-settings #chooseLogoBtn,
  body.mod-no-settings #chooseCoverBtn,
  body.mod-no-settings #saveProfileBtn,
  body.mod-no-settings #saveShopTypeBtn,
  body.mod-no-settings #saveHoursBtn {
    display: none !important;
  }

  body.mod-no-settings #shopTypeChips,
  body.mod-no-settings #hoursModeChips,
  body.mod-no-settings #offDayChips,
  body.mod-no-settings #hoursOpen,
  body.mod-no-settings #hoursClose,
  body.mod-no-settings .pe-toggle-row {
    pointer-events: none;
    opacity: 0.6;
  }

  /* শপের ধরন / খোলার সময় কার্ড */
  .pe-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pe-chip {
    border: 1.5px solid #E5EAF0;
    background: #fff;
    color: #1B2A4A;
    padding: 7px 14px;
    border-radius: 40px;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
  }

  .pe-chip.sel {
    background: #FF6B35;
    border-color: #FF6B35;
    color: #fff;
  }

  .pe-chip.off.sel {
    background: #1B2A4A;
    border-color: #1B2A4A;
  }

  .pe-time-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 4px;
  }

  .pe-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding: 12px 14px;
    background: #F8FAFC;
    border-radius: 14px;
    cursor: pointer;
  }

  .pe-toggle-row b {
    display: block;
    font-size: 0.86rem;
    color: #1B2A4A;
  }

  .pe-toggle-row small {
    display: block;
    font-size: 0.72rem;
    color: #8FA0BC;
    margin-top: 2px;
    line-height: 1.4;
  }

  .pe-switch {
    position: relative;
    width: 46px;
    height: 26px;
    flex-shrink: 0;
  }

  .pe-switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
    z-index: 2;
  }

  .pe-switch i {
    position: absolute;
    inset: 0;
    border-radius: 26px;
    background: #D7E0EC;
    transition: background 0.2s ease;
  }

  .pe-switch i::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.25);
    transition: transform 0.2s ease;
  }

  .pe-switch input:checked + i {
    background: #D14343;
  }

  .pe-switch input:checked + i::after {
    transform: translateX(20px);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImage } from '../../lib/imageCompress.js';

  let currentShopId = null;
  let selectedLogoFile = null;
  let selectedCoverFile = null;

  const profileMsg = document.getElementById('profileMsg');
  const shopNameInput = document.getElementById('shopNameInput');
  const locationNameInput = document.getElementById('locationNameInput');
  const descriptionInput = document.getElementById('descriptionInput');
  const upazilaInput = document.getElementById('upazilaInput');
  const phoneInput = document.getElementById('phoneInput');
  const saveBtn = document.getElementById('saveProfileBtn');
  const saveBtnText = document.getElementById('saveProfileBtnText');

  const logoCircle = document.getElementById('logoCircle');
  const logoPreview = document.getElementById('logoPreview');
  const logoInput = document.getElementById('logoInput');

  const coverPreview = document.getElementById('coverPreview');
  const coverPlaceholder = document.getElementById('coverPlaceholder');
  const coverInput = document.getElementById('coverInput');

  function showMsg(text, type = 'error') {
    profileMsg.textContent = text;
    profileMsg.className = `form-msg ${type === 'error' ? 'show-error' : 'show-success'}`;
    // গ্লোবাল টোস্টেও দেখানো হয় — ইনলাইন মেসেজ স্ক্রিনের বাইরে থাকলেও যেন চোখে পড়ে
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  function clearMsg() {
    profileMsg.textContent = '';
    profileMsg.className = 'form-msg';
  }

  document.getElementById('chooseLogoBtn')?.addEventListener('click', () => logoInput.click());
  document.getElementById('chooseCoverBtn')?.addEventListener('click', () => coverInput.click());

  logoInput?.addEventListener('change', async () => {
    const file = logoInput.files?.[0];
    if (!file) return;
    // লোগো PNG (transparent background) হলে PNG-ই রাখা হচ্ছে
    const mimeType = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
    selectedLogoFile = await compressImage(file, { maxDimension: 800, mimeType });
    const reader = new FileReader();
    reader.onload = () => {
      logoPreview.src = reader.result;
      logoCircle.classList.add('has-photo');
    };
    reader.readAsDataURL(selectedLogoFile);
  });

  coverInput?.addEventListener('change', async () => {
    const file = coverInput.files?.[0];
    if (!file) return;
    selectedCoverFile = await compressImage(file, { maxDimension: 1280 });
    const reader = new FileReader();
    reader.onload = () => {
      coverPreview.src = reader.result;
      coverPreview.style.display = 'block';
      coverPlaceholder.style.display = 'none';
    };
    reader.readAsDataURL(selectedCoverFile);
  });

  async function uploadImage(file, prefix) {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return null;

    const fileExt = file.name.split('.').pop();
    const filePath = `shops/${prefix}-${currentShopId}-${Date.now()}.${fileExt}`;

    const formData = new FormData();
    formData.append('file', file);
    formData.append('path', filePath);

    const res = await fetch('/api/upload-image', {
      method: 'POST',
      headers: { Authorization: `Bearer ${session.access_token}` },
      body: formData,
    });
    const result = await res.json();

    if (!res.ok) {
      console.error('ছবি আপলোড এরর:', result.error);
      return null;
    }
    return result.url || null;
  }

  saveBtn?.addEventListener('click', async () => {
    clearMsg();

    if (!window.SFValidateForm(document.querySelector('.dash-card'))) {
      return;
    }

    saveBtnText.textContent = 'সেভ হচ্ছে...';
    saveBtn.disabled = true;

    let logoUrl = null;
    let coverUrl = null;

    if (selectedLogoFile) {
      logoUrl = await uploadImage(selectedLogoFile, 'logo');
    }
    if (selectedCoverFile) {
      coverUrl = await uploadImage(selectedCoverFile, 'cover');
    }

    const shopName = shopNameInput.value.trim();

    const updates = {
      name: shopName,
      description: descriptionInput.value.trim(),
      location_name: locationNameInput.value.trim() || null,
      upazila: upazilaInput.value || null,
      phone: phoneInput.value.trim(),
    };
    if (logoUrl) updates.logo_image = logoUrl;
    if (coverUrl) updates.cover_image = coverUrl;

    const { error } = await supabase.from('shops').update(updates).eq('id', currentShopId);

    saveBtnText.textContent = 'সেভ করুন';
    saveBtn.disabled = false;

    if (error) {
      showMsg('সেভ ব্যর্থ: ' + error.message);
      return;
    }

    window.showToast('শপ প্রোফাইল সেভ হয়েছে ✓', 'success');
  });

  window.addEventListener('smartfeni:shop-ready', (e) => {
    const shop = e.detail.shop;
    currentShopId = shop.id;

    shopNameInput.value = shop.name || '';
    descriptionInput.value = shop.description || '';
    locationNameInput.value = shop.location_name || '';
    upazilaInput.value = shop.upazila || '';
    phoneInput.value = shop.phone || '';

    if (shop.logo_image) {
      logoPreview.src = shop.logo_image;
      logoCircle.classList.add('has-photo');
    }
    if (shop.cover_image) {
      coverPreview.src = shop.cover_image;
      coverPreview.style.display = 'block';
      coverPlaceholder.style.display = 'none';
    }
  });

  // ============================================================
  // শপের ধরন (সর্বোচ্চ ৩) — shops.category_slugs
  // ============================================================
  const MAX_TYPES = 3;
  const bnNum = (n) => String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
  const typeChipsEl = document.getElementById('shopTypeChips');
  const typeCountEl = document.getElementById('shopTypeCount');
  const saveTypeBtn = document.getElementById('saveShopTypeBtn');
  let allTypes = [];
  let pickedTypes = [];

  function renderTypeChips() {
    typeChipsEl.innerHTML = '';
    allTypes.forEach((t) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pe-chip' + (pickedTypes.includes(t.slug) ? ' sel' : '');
      b.textContent = t.name_bn;
      b.addEventListener('click', () => {
        if (pickedTypes.includes(t.slug)) {
          pickedTypes = pickedTypes.filter((s) => s !== t.slug);
        } else if (pickedTypes.length >= MAX_TYPES) {
          window.showToast?.('সর্বোচ্চ ৩টা ধরন বাছা যাবে', 'error', 2500);
          return;
        } else {
          pickedTypes.push(t.slug);
        }
        renderTypeChips();
      });
      typeChipsEl.appendChild(b);
    });
    typeCountEl.textContent = `${bnNum(pickedTypes.length)}/${bnNum(MAX_TYPES)}টা বাছা হয়েছে`;
  }

  saveTypeBtn?.addEventListener('click', async () => {
    if (!currentShopId) return;
    saveTypeBtn.disabled = true;
    const { error } = await supabase.from('shops').update({ category_slugs: pickedTypes }).eq('id', currentShopId);
    saveTypeBtn.disabled = false;
    if (error) {
      window.showToast?.('সেভ ব্যর্থ: ' + error.message, 'error', 3500);
      return;
    }
    window.showToast?.('শপের ধরন সেভ হয়েছে ✓', 'success');
  });

  // ============================================================
  // খোলার সময় — shops.opening_hours / shops.temporarily_closed
  // ফরম্যাট: {"open":"HH:MM","close":"HH:MM","off_days":[0-6]} (০ = রবিবার)
  // সময় ঠিক না করে শুধু ছুটির দিন দিলে open = close = "00:00" (সারাদিন খোলা)
  // ============================================================
  const DAY_NAMES = ['রবি', 'সোম', 'মঙ্গল', 'বুধ', 'বৃহ', 'শুক্র', 'শনি'];
  const modeChipsEl = document.getElementById('hoursModeChips');
  const timedWrap = document.getElementById('hoursTimedWrap');
  const openInput = document.getElementById('hoursOpen');
  const closeInput = document.getElementById('hoursClose');
  const offDayChipsEl = document.getElementById('offDayChips');
  const pauseInput = document.getElementById('hoursPause');
  const saveHoursBtn = document.getElementById('saveHoursBtn');
  let hoursMode = 'always';
  let offDays = [];

  function applyMode(mode) {
    hoursMode = mode;
    modeChipsEl.querySelectorAll('.pe-chip').forEach((c) => c.classList.toggle('sel', c.dataset.mode === mode));
    timedWrap.style.display = mode === 'timed' ? 'block' : 'none';
  }

  function renderOffDays() {
    offDayChipsEl.innerHTML = '';
    DAY_NAMES.forEach((name, idx) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pe-chip off' + (offDays.includes(idx) ? ' sel' : '');
      b.textContent = name;
      b.addEventListener('click', () => {
        offDays = offDays.includes(idx) ? offDays.filter((d) => d !== idx) : offDays.concat(idx);
        renderOffDays();
      });
      offDayChipsEl.appendChild(b);
    });
  }

  modeChipsEl?.addEventListener('click', (e) => {
    const btn = e.target.closest('.pe-chip');
    if (btn) applyMode(btn.dataset.mode);
  });

  saveHoursBtn?.addEventListener('click', async () => {
    if (!currentShopId) return;

    let hours = null;
    const sortedOff = [...offDays].sort((a, b) => a - b);

    if (hoursMode === 'timed') {
      const open = openInput.value;
      const close = closeInput.value;
      if (!open || !close) {
        window.showToast?.('খোলা ও বন্ধের সময় দিন', 'error', 3000);
        return;
      }
      hours = open === close
        ? { open: '00:00', close: '00:00', off_days: sortedOff }
        : { open, close, off_days: sortedOff };
    } else if (sortedOff.length) {
      hours = { open: '00:00', close: '00:00', off_days: sortedOff };
    }

    saveHoursBtn.disabled = true;
    const paused = !!pauseInput.checked;
    const { error } = await supabase
      .from('shops')
      .update({ opening_hours: hours, temporarily_closed: paused })
      .eq('id', currentShopId);
    saveHoursBtn.disabled = false;

    if (error) {
      window.showToast?.('সেভ ব্যর্থ: ' + error.message, 'error', 3500);
      return;
    }

    window.dispatchEvent(new CustomEvent('smartfeni:shop-hours-changed', {
      detail: { opening_hours: hours, temporarily_closed: paused, from: 'hours-card' },
    }));
    window.showToast?.('খোলার সময় সেভ হয়েছে ✓', 'success');
  });

  // ড্যাশবোর্ডের উপরের সুইচ থেকে সাময়িক বন্ধ বদলালে এখানকার সুইচও মিলিয়ে নেওয়া
  window.addEventListener('smartfeni:shop-hours-changed', (e) => {
    if (e.detail?.from === 'hours-card') return;
    pauseInput.checked = !!e.detail?.temporarily_closed;
  });

  window.addEventListener('smartfeni:shop-ready', async (e) => {
    const shop = e.detail.shop;

    // ধরন
    pickedTypes = Array.isArray(shop.category_slugs) ? [...shop.category_slugs] : [];
    const { data: types } = await supabase
      .from('shop_categories')
      .select('slug, name_bn, sort_order')
      .eq('is_active', true)
      .order('sort_order', { ascending: true });
    allTypes = types || [];
    renderTypeChips();

    // খোলার সময়
    const h = shop.opening_hours;
    offDays = h && Array.isArray(h.off_days) ? h.off_days.map(Number).filter((n) => n >= 0 && n <= 6) : [];
    if (h && h.open && h.close && h.open !== h.close) {
      openInput.value = h.open;
      closeInput.value = h.close;
      applyMode('timed');
    } else {
      applyMode('always');
    }
    pauseInput.checked = !!shop.temporarily_closed;
    renderOffDays();
  });
</script>
