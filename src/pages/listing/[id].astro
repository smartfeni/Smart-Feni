---
// ============================================================
// পেজ: জেনেরিক লিস্টিং শেয়ার/ডিটেইল পেজ (/listing/[id])
// ফাংশন: 'listings' টেবিলের যেকোনো ক্যাটাগরির একটা নির্দিষ্ট আইটেম
// শেয়ারেবল ফুল-পেজ আকারে দেখায়, প্রপার OG মেটা ট্যাগ সহ। ক্যাটাগরি
// অনুযায়ী টাইপ-লেবেল ও আইকন ম্যাপ করা আছে — নতুন ক্যাটাগরি এই
// সিস্টেমে যোগ করতে চাইলে শুধু CATEGORY_CONFIG-এ এন্ট্রি বাড়ালেই হবে।
// আপডেট: ছবি ক্যারোসেল ডট ইন্ডিকেটর + "কত দিন আগে" পোস্ট হয়েছে
// (relative time) + ইমেজ বক্স ফিক্সড-হাইট (cover) করা হলো
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import { supabase } from '../../lib/supabase.js';

const { id } = Astro.params;

const { data: item, error } = await supabase
  .from('listings')
  .select('*')
  .eq('id', id)
  .eq('status', 'active')
  .maybeSingle();

if (error) {
  console.error('listing fetch error:', error.message);
}

// ক্যাটাগরি অনুযায়ী কনফিগ — নতুন ক্যাটাগরি যোগ করতে চাইলে এখানে বাড়াবে
const CATEGORY_CONFIG = {
  housing: {
    pageLabel: 'বাসা ভাড়া',
    backLink: '/services/housing',
    icon: 'fa-house',
    typeLabels: { flat: 'ফ্ল্যাট', house: 'বাসা', mess: 'মেস', shop: 'দোকান-অফিস' },
    priceLabel: 'ভাড়া',
  },
  job: {
    pageLabel: 'চাকরির খবর',
    backLink: '/services/job',
    icon: 'fa-briefcase',
    typeLabels: { fulltime: 'ফুল-টাইম', parttime: 'পার্ট-টাইম', internship: 'ইন্টার্নশিপ' },
    priceLabel: 'বেতন',
  },
  tuition: {
    pageLabel: 'টিউশন',
    backLink: '/services/tuition',
    icon: 'fa-book-open',
    typeLabels: { tutor: 'টিউটর সার্ভিস দিচ্ছি', student: 'টিউটর প্রয়োজন' },
    priceLabel: 'রেট / বাজেট',
  },
  event: {
    pageLabel: 'ইভেন্ট ম্যানেজমেন্ট',
    backLink: '/services/event',
    icon: 'fa-champagne-glasses',
    typeLabels: {
      wedding: 'বিয়ে',
      birthday: 'জন্মদিন',
      'waz-mahfil': 'ওয়াজ মাহফিল',
      catering: 'ক্যাটারিং',
      decoration: 'ডেকোরেশন',
      photography: 'ফটোগ্রাফি/ভিডিওগ্রাফি',
      'sound-stage': 'সাউন্ড ও স্টেজ',
      other: 'অন্যান্য',
    },
    priceLabel: 'প্যাকেজ/রেট',
  },
  'home-food': {
    pageLabel: 'হোম মেস ফুড',
    backLink: '/services/home-food',
    icon: 'fa-utensils',
    typeLabels: {
      'per-meal': 'প্রতি মিল',
      'one-time-daily': '১ বেলা দৈনিক',
      'two-time-daily': '২ বেলা দৈনিক',
    },
    priceLabel: 'দাম',
  },
  sports: {
    pageLabel: 'খেলাধুলা ও ইভেন্ট',
    backLink: '/services/sports',
    icon: 'fa-calendar-check',
    typeLabels: {
      sports: 'খেলা',
      religious: 'ওয়াজ মাহফিল',
      cultural: 'সাংস্কৃতিক',
      education: 'শিক্ষা',
      health: 'স্বাস্থ্য',
      other: 'অন্যান্য',
    },
    priceLabel: 'তারিখ/সময়',
  },
  repair: {
    pageLabel: 'রিপেয়ার সার্ভিস',
    backLink: '/services/repair',
    icon: 'fa-screwdriver-wrench',
    typeLabels: {
      electrician: 'ইলেকট্রিশিয়ান',
      plumbing: 'প্লাম্বিং',
      'ac-fridge': 'এসি/ফ্রিজ',
      'mobile-computer': 'মোবাইল/কম্পিউটার',
      furniture: 'ফার্নিচার/কাঠমিস্ত্রি',
      appliance: 'গৃহস্থালি যন্ত্রপাতি',
      'gas-stove': 'গ্যাসের চুলা',
    },
    priceLabel: 'রেট',
  },
  recycle: {
    pageLabel: 'রিসাইকেল মার্কেট',
    backLink: '/services/recycle',
    icon: 'fa-recycle',
    typeLabels: {
      mobile: 'মোবাইল',
      bike: 'বাইক',
      electronics: 'ইলেকট্রনিক্স',
      furniture: 'আসবাবপত্র',
      other: 'অন্যান্য',
    },
    priceLabel: 'মূল্য',
  },
  'car-rental': {
    pageLabel: 'গাড়ি ভাড়া সার্ভিস',
    backLink: '/services/car-rental',
    icon: 'fa-car',
    typeLabels: {
      cng: 'সিএনজি',
      car: 'কার',
      pickup: 'পিকআপ ভ্যান',
      truck: 'ট্রাক',
      microbus: 'মাইক্রোবাস',
      'auto-rickshaw': 'অটো রিক্সা',
      ambulance: 'অ্যাম্বুলেন্স',
      other: 'অন্যান্য',
    },
    priceLabel: 'গাড়ির ধরন/মডেল',
    typeDefaultImages: {
      cng: '/images/car-types/cng-default.png',
      car: '/images/car-types/car-default.png',
      pickup: '/images/car-types/pickup-default.png',
      truck: '/images/car-types/truck-default.png',
      microbus: '/images/car-types/microbus-default.png',
      'auto-rickshaw': '/images/car-types/auto-rickshaw-default.png',
      ambulance: '/images/car-types/ambulance-default.png',
      other: '/images/car-types/other-default.png',
    },
  },
};

// বাংলা ডিজিটে কনভার্ট করার হেল্পার
function toBnDigits(num) {
  const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
  return num.toString().replace(/[0-9]/g, (d) => bnDigits[d]);
}

// created_at থেকে বাংলায় "কত দিন আগে" বের করার হেল্পার
function getRelativeTimeBn(dateString) {
  if (!dateString) return null;
  const then = new Date(dateString);
  if (isNaN(then.getTime())) return null;

  const diffMs = Date.now() - then.getTime();
  if (diffMs < 0) return 'এইমাত্র';

  const diffSec = Math.floor(diffMs / 1000);
  const diffMin = Math.floor(diffSec / 60);
  const diffHour = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHour / 24);
  const diffMonth = Math.floor(diffDay / 30);
  const diffYear = Math.floor(diffDay / 365);

  if (diffSec < 60) return 'এইমাত্র';
  if (diffMin < 60) return `${toBnDigits(diffMin)} মিনিট আগে`;
  if (diffHour < 24) return `${toBnDigits(diffHour)} ঘণ্টা আগে`;
  if (diffDay < 30) return `${toBnDigits(diffDay)} দিন আগে`;
  if (diffMonth < 12) return `${toBnDigits(diffMonth)} মাস আগে`;
  return `${toBnDigits(diffYear)} বছর আগে`;
}

const config = item ? CATEGORY_CONFIG[item.category] || { pageLabel: 'লিস্টিং', backLink: '/', icon: 'fa-tag', typeLabels: {}, priceLabel: 'মূল্য' } : null;
const typeLabel = item ? config.typeLabels[item.type] || item.type : null;
const images = item?.images && item.images.length > 0 ? item.images : [];
const postedAgo = item ? getRelativeTimeBn(item.created_at) : null;

// car-rental এর জন্য টাইপ-ভিত্তিক ফলব্যাক ইমেজ (ছবি না থাকলে ব্যবহার হবে)
const fallbackImage = item && config.typeDefaultImages ? (config.typeDefaultImages[item.type] || config.typeDefaultImages.other) : null;

const pageTitle = item ? `${item.title} | ${config.pageLabel} | স্মার্ট ফেনী` : 'পেজ পাওয়া যায়নি | স্মার্ট ফেনী';
const pageDescription = item
  ? item.description || `${config.pageLabel} — ${item.title}`
  : undefined;
const ogImage = item ? images[0] : undefined;
const canonicalPath = item ? `/listing/${item.id}` : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
>
  {item ? (
    <div class="listing-detail-page">
      <div class="container">

        <a href={config.backLink} class="back-link">
          <i class="fas fa-arrow-left"></i> {config.pageLabel} এ ফিরে যান
        </a>

        <div class="listing-card">
          <span class="type-badge"><i class={`fas ${config.icon}`}></i> {typeLabel}</span>

          {images.length > 0 ? (
            <>
              <div class="image-strip" id="imageStrip">
                {images.map((src) => (
                  <img src={src} alt={item.title} class="listing-img zoomable-listing-img" />
                ))}
              </div>
              {images.length > 1 && (
                <div class="image-dots" id="imageDots">
                  {images.map((_, i) => (
                    <span class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
                  ))}
                </div>
              )}
            </>
          ) : fallbackImage ? (
            <img src={fallbackImage} alt={item.title} class="listing-img-fallback" />
          ) : (
            <div class="listing-img-placeholder"><i class={`fas ${config.icon}`}></i></div>
          )}

          <div class="listing-body">
            <div class="listing-title-row">
              <h1 class="listing-title">{item.title}</h1>
              <button
                class="share-btn"
                data-share-url={`/listing/${item.id}`}
                data-share-title={item.title}
                aria-label="শেয়ার করুন"
              >
                <i class="fas fa-share-nodes"></i>
              </button>
            </div>

            {item.price && (
              <p class="listing-price">
                <span class="price-label">{config.priceLabel}:</span> {item.price}
              </p>
            )}

            <div class="listing-meta-row">
              {item.upazila && (
                <span class="listing-location"><i class="fas fa-location-dot"></i> {item.upazila}</span>
              )}
              {postedAgo && (
                <span class="listing-posted"><i class="fas fa-clock"></i> {postedAgo}</span>
              )}
            </div>

            {item.description && <p class="listing-desc">{item.description}</p>}

            {item.contact_phone && (
              <a href={`tel:${item.contact_phone}`} class="listing-call-btn">
                <i class="fas fa-phone"></i> কল করুন
              </a>
            )}
          </div>
        </div>

      </div>
    </div>
  ) : (
    <section class="not-found">
      <div class="container">
        <i class="fas fa-face-frown"></i>
        <p>এই লিস্টিংটি খুঁজে পাওয়া যায়নি</p>
        <a href="/" class="back-link-inline"><i class="fas fa-arrow-left"></i> হোমপেজে ফিরে যান</a>
      </div>
    </section>
  )}

  <div id="listingShareToast" class="share-toast">লিংক কপি হয়েছে ✓</div>

  <ImageLightbox />
</BaseLayout>

<style>
  .listing-detail-page {
    min-height: 70vh;
    padding: 28px 0 80px;
    background: #F8FAFC;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #5A6E85;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 18px;
  }

  .listing-card {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    max-width: 620px;
    margin: 0 auto;
  }

  .type-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFF0EA;
    color: #FF6B35;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 40px;
    margin: 18px 0 0 18px;
  }

  .image-strip {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    margin-top: 14px;
    scroll-snap-type: x mandatory;
  }

  .listing-img {
    flex: 0 0 100%;
    scroll-snap-align: start;
    width: 100%;
    height: 320px;
    max-height: 45vh;
    object-fit: cover;
    background: #F4F7FC;
    cursor: zoom-in;
  }

  .image-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 10px 0 0;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D8E0EA;
    transition: all 0.25s ease;
  }

  .dot.active {
    background: #FF6B35;
    width: 18px;
    border-radius: 4px;
  }

  .listing-img-fallback {
    width: 100%;
    height: 280px;
    max-height: 40vh;
    object-fit: contain;
    background: #F4F7FC;
    padding: 24px;
    margin-top: 14px;
    display: block;
  }

  .listing-img-placeholder {
    width: 100%;
    height: 280px;
    max-height: 40vh;
    background: #F4F7FC;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    margin-top: 14px;
  }

  .listing-body {
    padding: 20px 22px 26px;
  }

  .listing-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .listing-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1B2A4A;
    line-height: 1.4;
  }

  .share-btn {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #F4F7FC;
    color: #5A6E85;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    cursor: pointer;
    margin-top: 2px;
  }

  .share-btn:active {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .listing-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FF6B35;
    margin-top: 10px;
  }

  .price-label {
    font-weight: 600;
    color: #8FA0BC;
    font-size: 0.8rem;
  }

  .listing-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }

  .listing-location,
  .listing-posted {
    font-size: 0.82rem;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .listing-desc {
    font-size: 0.92rem;
    color: #5A6E85;
    line-height: 1.75;
    margin-top: 14px;
    white-space: pre-line;
  }

  .listing-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFF0EA;
    color: #FF6B35;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 40px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: 18px;
  }

  .not-found {
    padding: 120px 0;
    text-align: center;
    color: #B0BCCB;
  }
  .not-found i {
    font-size: 3rem;
    margin-bottom: 16px;
  }
  .not-found p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
  }
  .back-link-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #FF6B35;
    text-decoration: none;
    font-weight: 700;
  }

  .share-toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%) translateY(20px);
    background: #1B2A4A;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 40px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 999;
  }

  .share-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  function showListingShareToast() {
    const toast = document.getElementById('listingShareToast');
    if (!toast) return;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2000);
  }

  document.querySelectorAll('.share-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const path = btn.dataset.shareUrl;
      const title = btn.dataset.shareTitle;
      const fullUrl = `${window.location.origin}${path}`;

      if (navigator.share) {
        try {
          await navigator.share({ title, url: fullUrl });
        } catch (err) {
          // ইউজার শেয়ার শীট ক্যানসেল করলে কিছু করার দরকার নেই
        }
      } else {
        try {
          await navigator.clipboard.writeText(fullUrl);
          showListingShareToast();
        } catch (err) {
          console.error('কপি করা যায়নি:', err);
        }
      }
    });
  });

  // ছবিতে ক্লিক করলে গ্লোবাল ImageLightbox খুলবে (জুম + ডাউনলোড)
  document.querySelectorAll('.zoomable-listing-img').forEach((img) => {
    img.addEventListener('click', () => {
      window.openImageLightbox?.(img.src);
    });
  });

  // ছবি স্লাইড করলে (swipe) নিচের ডট ইন্ডিকেটর আপডেট হবে
  const imageStrip = document.getElementById('imageStrip');
  const dots = document.querySelectorAll('#imageDots .dot');
  if (imageStrip && dots.length > 0) {
    imageStrip.addEventListener('scroll', () => {
      const index = Math.round(imageStrip.scrollLeft / imageStrip.clientWidth);
      dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
    }, { passive: true });
  }
</script>