---
// ============================================================
// পেজ: /my-listings — "আমার পোস্ট" — ইউজারের নিজের করা সব
// ক্যাটাগরির লিস্টিং এক জায়গায় (দেখুন + এডিট + ডিলিট)।
// আপডেট: জেনেরিক এডিট মোডাল — টাইটেল, বিবরণ, দাম, উপজেলা, যোগাযোগ
// নম্বর এডিট করা যায় (এগুলো সব ক্যাটাগরিতে কমন কলাম)। type/category/
// ছবি এডিটেবল না — ক্যাটাগরি-ভিত্তিক টাইপ লিস্ট আলাদা ফাইলে থাকায়
// জেনেরিকভাবে আনা স্কোপের বাইরে রাখা হলো।
//
// আপডেট (এই সেশন — এডিট রিভিউ সিস্টেম):
// - এডিট সেভ এখন listings টেবিলে সরাসরি UPDATE নয়; submit_listing_edit
//   RPC কল হয়:
//     • লিস্টিং আগেই অনুমোদিত (পাবলিক) হলে → নতুন তথ্য listing_edits এ
//       pending হিসেবে যায়, আগের ভার্সন পাবলিকে থাকে, অ্যাডমিন/মডারেটর
//       অনুমোদন করলে তবেই আপডেট হয়
//     • লিস্টিং এখনো প্রথমবার রিভিউই হয়নি (পাবলিক না) হলে → সরাসরি আপডেট
// - কার্ডে "এডিট রিভিউতে আছে" নোটিশ + "এডিট বাতিল" বাটন; এডিট
//   প্রত্যাখ্যাত হলে (৩০ দিন পর্যন্ত) কারণসহ নোটিশ
// - pending এডিট থাকলে এডিট মোডালে সেই pending তথ্যই খোলে (যাতে মালিক
//   নিজের জমা দেওয়া ভার্সনেই আবার কাজ করতে পারে)
// - কার্ডের টাইটেল/ক্যাটাগরি/ছবি escape করা হয়েছে (innerHTML এ সরাসরি
//   ইউজারের লেখা বসত)
//
// আপডেট (ক্যাটাগরি-ভিত্তিক গ্রুপ UI):
// - উপরে স্ট্যাটাস চিপ (মোট / সক্রিয় / রিভিউ বাকি / বাতিল) — সংখ্যা সহ,
//   ট্যাপ করলে ওই স্ট্যাটাসের পোস্টগুলোই দেখায়
// - পোস্টগুলো ক্যাটাগরি অনুযায়ী গ্রুপে (services.js-এর ক্রমে); প্রতিটা
//   গ্রুপের হেডারে আইকন, নাম, পোস্ট সংখ্যা; ট্যাপ করলে ভাঁজ/খোলে
// - একটা গ্রুপে ১২টার বেশি হলে প্রথম ১২টা দেখায়, নিচে "আরো দেখান"
// - গ্রুপ হেডারে ক্যাটাগরি থাকায় কার্ড থেকে ক্যাটাগরির ট্যাগ সরানো হয়েছে
// - গাড়ি ভাড়া (car-rental): price কলামে দাম নয়, গাড়ির ধরন/মডেল থাকে —
//   তাই কার্ডে "৳" ছাড়া দেখায়, এডিট ফর্মে লেবেল "গাড়ির ধরন / মডেল"
//   (প্রোফাইল এডিট থেকে গাড়ির কার্ড সরে এখানে এসেছে; এডিট এখন
//   অন্য লিস্টিংয়ের মতোই submit_listing_edit রিভিউ নিয়মে যায়)
//
// my-orders.astro এর একই প্যাটার্ন: loading/login-required/content
// states, style is:global (কার্ড JS দিয়ে dynamically তৈরি হয় বলে
// Astro এর scoped CSS এতে কাজ করে না)।
// স্ট্যাটাস লেবেল/কালার admin/listings.astro এর statusLabels থেকে
// রিইউজ করা হয়েছে কনসিস্টেন্সির জন্য।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="আমার পোস্ট | স্মার্ট ফেনী">
  <div class="my-listings-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-lock"></i></div>
        <h2>লগইন করুন</h2>
        <p>নিজের পোস্ট করা লিস্টিং দেখতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="listingsContent" style="display:none;">
        <h1 class="page-title"><i class="fas fa-list-check"></i> আমার পোস্ট</h1>

        <div id="emptyListings" class="status-box" style="display:none;">
          <div class="status-icon-badge"><i class="fas fa-inbox"></i></div>
          <h2>কোনো লিস্টিং নেই</h2>
          <p>এখনো কোনো ক্যাটাগরিতে লিস্টিং পোস্ট করেননি</p>
          <a href="/" class="primary-link-btn">হোমপেজে যান</a>
        </div>

        <!-- ===== স্ট্যাটাস চিপ (সামারি + ফিল্টার) ===== -->
        <div class="ml-chips" id="summaryChips" style="display:none;">
          <button type="button" class="ml-chip active" data-filter="all">
            মোট <span class="ml-chip-num" data-count="all">0</span>
          </button>
          <button type="button" class="ml-chip" data-filter="active">
            <span class="ml-chip-dot" style="background:#1B7A3C;"></span>সক্রিয় <span class="ml-chip-num" data-count="active">0</span>
          </button>
          <button type="button" class="ml-chip" data-filter="pending">
            <span class="ml-chip-dot" style="background:#B36B00;"></span>রিভিউ বাকি <span class="ml-chip-num" data-count="pending">0</span>
          </button>
          <button type="button" class="ml-chip" data-filter="rejected">
            <span class="ml-chip-dot" style="background:#D14343;"></span>বাতিল <span class="ml-chip-num" data-count="rejected">0</span>
          </button>
        </div>

        <!-- ===== ক্যাটাগরি গ্রুপ (JS দিয়ে তৈরি হয়) ===== -->
        <div id="listingsContainer" class="ml-groups"></div>

        <p id="filterEmpty" class="ml-filter-empty" style="display:none;">এই স্ট্যাটাসে কোনো পোস্ট নেই</p>
      </div>

    </div>
  </div>

  <!-- ===== লিস্টিং এডিট মোডাল ===== -->
  <div class="ml-edit-overlay" id="mlEditOverlay">
    <div class="ml-edit-modal">
      <button class="ml-edit-close" id="mlEditClose" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>

      <h2 class="ml-edit-title"><i class="fas fa-pen"></i> লিস্টিং এডিট করুন</h2>

      <p class="ml-edit-info" id="mlEditInfo">
        অনুমোদিত লিস্টিং এডিট করলে নতুন তথ্য রিভিউয়ের জন্য যাবে। অনুমোদনের আগ পর্যন্ত আগের তথ্যই সবাই দেখবে।
      </p>

      <p class="ml-form-msg" id="mlEditMessage"></p>

      <label class="ml-form-label">টাইটেল</label>
      <input type="text" class="ml-form-input" id="mlEditTitle" />

      <label class="ml-form-label">বিবরণ</label>
      <textarea class="ml-form-input" id="mlEditDescription" rows="3"></textarea>

      <label class="ml-form-label" id="mlEditPriceLabel">দাম / রেট</label>
      <input type="text" class="ml-form-input" id="mlEditPrice" />

      <label class="ml-form-label">উপজেলা</label>
      <select class="ml-form-input" id="mlEditUpazila">
        <option value="ফেনী সদর">ফেনী সদর</option>
        <option value="ছাগলনাইয়া">ছাগলনাইয়া</option>
        <option value="দাগনভূঞা">দাগনভূঞা</option>
        <option value="পরশুরাম">পরশুরাম</option>
        <option value="ফুলগাজী">ফুলগাজী</option>
        <option value="সোনাগাজী">সোনাগাজী</option>
      </select>

      <label class="ml-form-label">যোগাযোগ নম্বর</label>
      <input type="tel" class="ml-form-input" id="mlEditPhone" />

      <button class="ml-primary-btn" id="mlEditSaveBtn" type="button">
        <i class="fas fa-check"></i> <span>সেভ করুন</span>
      </button>
    </div>
  </div>

  <style is:global>
    .my-listings-page {
      min-height: 70vh;
      padding: 28px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      text-align: center;
      background: #fff;
      border-radius: 20px;
      padding: 60px 24px;
      border: 1px dashed #E5EAF0;
      max-width: 420px;
      margin: 40px auto;
    }

    .status-icon-badge {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin: 0 auto 16px;
    }

    .status-box h2 {
      font-size: 1.1rem;
      color: #1B2A4A;
      margin-bottom: 6px;
    }

    .status-box p {
      color: #8FA0BC;
      font-size: 0.88rem;
      margin-bottom: 18px;
    }

    .primary-link-btn {
      display: inline-block;
      background: #FF6B35;
      color: #fff;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 11px 26px;
      border-radius: 40px;
      text-decoration: none;
    }

    .page-title {
      font-size: 1.4rem;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
    }

    .page-title i {
      color: #FF6B35;
      font-size: 1.15rem;
    }

    /* ===== স্ট্যাটাস চিপ (সামারি + ফিল্টার) ===== */
    .ml-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 18px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ml-chips::-webkit-scrollbar {
      display: none;
    }

    .ml-chip {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #fff;
      border: 1.5px solid #E5EAF0;
      border-radius: 40px;
      padding: 8px 14px;
      font-size: 0.78rem;
      font-weight: 700;
      font-family: inherit;
      color: #5A6E85;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .ml-chip-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .ml-chip-num {
      background: #F4F7FC;
      color: #1B2A4A;
      border-radius: 20px;
      min-width: 22px;
      padding: 1px 7px;
      font-size: 0.72rem;
      text-align: center;
    }

    .ml-chip.active {
      background: #1B2A4A;
      border-color: #1B2A4A;
      color: #fff;
    }

    .ml-chip.active .ml-chip-num {
      background: rgba(255, 255, 255, 0.18);
      color: #fff;
    }

    /* ===== ক্যাটাগরি গ্রুপ ===== */
    .ml-groups {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .ml-group {
      background: #fff;
      border: 1px solid #EEF3F9;
      border-radius: 20px;
      overflow: hidden;
    }

    .ml-group-head {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      background: #fff;
      border: none;
      padding: 14px 16px;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
    }

    .ml-group-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .ml-group-name {
      flex: 1;
      min-width: 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: #1B2A4A;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ml-group-count {
      background: #F4F7FC;
      color: #5A6E85;
      font-size: 0.74rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
    }

    .ml-group-chevron {
      color: #8FA0BC;
      font-size: 0.75rem;
      transition: transform 0.25s ease;
    }

    .ml-group.collapsed .ml-group-chevron {
      transform: rotate(-90deg);
    }

    .ml-group-body {
      padding: 0 16px 18px;
      border-top: 1px solid #EEF3F9;
    }

    .ml-group.collapsed .ml-group-body {
      display: none;
    }

    .ml-group-body .listings-grid {
      margin-top: 14px;
    }

    .ml-more {
      display: block;
      margin: 16px auto 0;
      background: #F4F7FC;
      border: none;
      color: #1B2A4A;
      font-weight: 700;
      font-size: 0.8rem;
      font-family: inherit;
      padding: 10px 22px;
      border-radius: 40px;
      cursor: pointer;
    }

    .ml-more:hover {
      background: #E5EAF0;
    }

    .ml-filter-empty {
      text-align: center;
      color: #8FA0BC;
      font-size: 0.88rem;
      font-weight: 600;
      padding: 30px 0;
    }

    .listings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
    }

    .ml-card {
      background: #fff;
      border-radius: 18px;
      border: 1px solid #EEF3F9;
      overflow: hidden;
      position: relative;
    }

    .ml-status-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
    }

    .ml-photo {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      background: #F4F7FC;
    }

    .ml-icon-fallback {
      width: 100%;
      aspect-ratio: 4 / 3;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
    }

    .ml-body {
      padding: 12px 14px 14px;
    }

    .ml-title {
      font-size: 0.87rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 3px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ml-price {
      font-size: 0.85rem;
      font-weight: 700;
      color: #FF6B35;
      margin-bottom: 8px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ===== এডিট রিভিউ নোটিশ (pending / প্রত্যাখ্যাত) ===== */
    .ml-note {
      display: none;
      font-size: 0.68rem;
      font-weight: 600;
      line-height: 1.5;
      padding: 8px 10px;
      border-radius: 10px;
      margin-bottom: 8px;
    }

    .ml-note-pending {
      display: block;
      background: #FFF3E0;
      color: #B36B00;
    }

    .ml-note-rejected {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .ml-note-cancel {
      display: inline-block;
      margin-top: 6px;
      background: transparent;
      border: 1.5px solid currentColor;
      color: inherit;
      font-size: 0.66rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      cursor: pointer;
    }

    .ml-note-cancel:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .ml-actions {
      display: flex;
      gap: 6px;
    }

    .ml-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 8px 6px;
      border-radius: 10px;
      cursor: pointer;
      border: none;
      text-decoration: none;
    }

    .ml-btn-view {
      background: #F4F7FC;
      color: #1B2A4A;
    }

    .ml-btn-view:hover {
      background: #E5EAF0;
    }

    .ml-btn-delete {
      background: #FFF0EA;
      color: #D14343;
    }

    .ml-btn-delete:hover {
      background: #FFE0D6;
    }

    .ml-btn-delete:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .ml-btn-edit {
      background: #EAF1FF;
      color: #1B5FE0;
    }

    .ml-btn-edit:hover {
      background: #D9E7FF;
    }

    /* ===== এডিট মোডাল ===== */
    .ml-edit-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow-y: auto;
    }

    .ml-edit-overlay.open {
      display: flex;
    }

    .ml-edit-modal {
      position: relative;
      background: #fff;
      width: 100%;
      max-width: 420px;
      border-radius: 28px;
      padding: 32px 28px 28px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
      margin: auto;
    }

    .ml-edit-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: #F4F7FC;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: #5A6E85;
      cursor: pointer;
    }

    .ml-edit-title {
      font-size: 1.15rem;
      color: #1B2A4A;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ml-edit-title i {
      color: #FF6B35;
    }

    .ml-edit-info {
      font-size: 0.78rem;
      color: #5A6E85;
      background: #F4F7FC;
      border-radius: 12px;
      padding: 10px 12px;
      line-height: 1.6;
      margin-bottom: 14px;
    }

    .ml-form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .ml-form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .ml-form-msg.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .ml-form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .ml-form-label:first-of-type {
      margin-top: 0;
    }

    .ml-form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .ml-form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .ml-primary-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-top: 16px;
    }

    .ml-primary-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
  </style>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase.js';
  import { categories } from '../data/services.js';

  const loadingState = document.getElementById('loadingState');
  const loginRequired = document.getElementById('loginRequired');
  const listingsContent = document.getElementById('listingsContent');
  const emptyListings = document.getElementById('emptyListings');
  const container = document.getElementById('listingsContainer');
  const summaryChips = document.getElementById('summaryChips');
  const filterEmpty = document.getElementById('filterEmpty');
  const chipButtons = document.querySelectorAll('.ml-chip');
  const chipNums = document.querySelectorAll('.ml-chip-num');

  // ক্যাটাগরির নাম/আইকন/ক্রম — services.js-এর ক্রম অনুযায়ী গ্রুপ সাজানো হয়
  const categoryMeta = Object.fromEntries(
    categories.map((c, index) => [c.id, { name: c.name, icon: c.icon, order: index }])
  );

  const statusLabels = {
    pending: { text: 'রিভিউ বাকি', bg: '#FFF3E0', color: '#B36B00' },
    active: { text: 'সক্রিয়', color: '#1B7A3C', bg: '#EAFBF0' },
    rejected: { text: 'বাতিল', color: '#D14343', bg: '#FFF0EA' },
  };

  // প্রত্যাখ্যাত এডিটের নোটিশ কত দিন পর্যন্ত দেখাবে
  const REJECTED_NOTE_DAYS = 30;

  // একটা গ্রুপে প্রথমে কয়টা কার্ড দেখাবে (বাকিগুলো "আরো দেখান" দিয়ে)
  const GROUP_PAGE_SIZE = 12;

  // গাড়ি ভাড়ার লিস্টিংয়ে price কলামে দাম নয়, গাড়ির ধরন/মডেল থাকে
  const CAR_CATEGORY = 'car-rental';

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  // কার্ডে দেখানোর দাম: গাড়ির জন্য "৳" ছাড়া
  function formatPrice(item) {
    if (!item.price) return '';
    return item.category === CAR_CATEGORY ? item.price : `৳${item.price}`;
  }

  // অচেনা স্ট্যাটাস "রিভিউ বাকি" হিসেবে ধরা হয় (কার্ডের ব্যাজের নিয়মের সাথে মিল রেখে)
  function statusKey(item) {
    return statusLabels[item.status] ? item.status : 'pending';
  }

  function groupKey(item) {
    return item.category || 'other';
  }

  let currentUserId = null;

  // listing_id -> সর্বশেষ pending / (সাম্প্রতিক) rejected এডিট
  let pendingByListing = {};
  let rejectedByListing = {};
  const cardsById = {};
  const itemsById = {};

  // categoryKey -> { el, grid, countEl, moreBtn, entries: [{item, card}], shown }
  const groups = {};
  let activeFilter = 'all';

  // ===== এডিট মোডাল এলিমেন্ট =====
  const editOverlay = document.getElementById('mlEditOverlay');
  const editClose = document.getElementById('mlEditClose');
  const editInfo = document.getElementById('mlEditInfo');
  const editMessage = document.getElementById('mlEditMessage');
  const editTitleInput = document.getElementById('mlEditTitle');
  const editDescInput = document.getElementById('mlEditDescription');
  const editPriceLabel = document.getElementById('mlEditPriceLabel');
  const editPriceInput = document.getElementById('mlEditPrice');
  const editUpazilaInput = document.getElementById('mlEditUpazila');
  const editPhoneInput = document.getElementById('mlEditPhone');
  const editSaveBtn = document.getElementById('mlEditSaveBtn');
  let editingId = null;
  let editingCard = null;
  let editingItem = null;

  // ===== গ্রুপ তৈরি / ভিউ আপডেট =====
  function createGroup(key) {
    const meta = categoryMeta[key] || {
      name: key === 'other' ? 'অন্যান্য' : key,
      icon: 'fa-folder',
      order: 999,
    };

    const el = document.createElement('section');
    el.className = 'ml-group';
    el.innerHTML = `
      <button type="button" class="ml-group-head" aria-expanded="true">
        <span class="ml-group-icon"><i class="fas ${escapeHtml(meta.icon)}"></i></span>
        <span class="ml-group-name">${escapeHtml(meta.name)}</span>
        <span class="ml-group-count">0</span>
        <i class="fas fa-chevron-down ml-group-chevron"></i>
      </button>
      <div class="ml-group-body">
        <div class="listings-grid"></div>
        <button type="button" class="ml-more" style="display:none;"></button>
      </div>
    `;

    const group = {
      el,
      grid: el.querySelector('.listings-grid'),
      countEl: el.querySelector('.ml-group-count'),
      moreBtn: el.querySelector('.ml-more'),
      entries: [],
      shown: GROUP_PAGE_SIZE,
    };

    const head = el.querySelector('.ml-group-head');
    head.addEventListener('click', () => {
      const collapsed = el.classList.toggle('collapsed');
      head.setAttribute('aria-expanded', String(!collapsed));
    });

    group.moreBtn.addEventListener('click', () => {
      group.shown += GROUP_PAGE_SIZE;
      applyView();
    });

    return group;
  }

  // চিপের সংখ্যা, প্রতিটা গ্রুপের কার্ড (ফিল্টার + "আরো দেখান"), খালি অবস্থা — সব একসাথে হালনাগাদ
  function applyView() {
    const counts = { all: 0, active: 0, pending: 0, rejected: 0 };
    Object.values(itemsById).forEach((item) => {
      counts.all += 1;
      counts[statusKey(item)] += 1;
    });

    chipNums.forEach((el) => {
      el.textContent = String(counts[el.dataset.count] ?? 0);
    });

    if (counts.all === 0) {
      summaryChips.style.display = 'none';
      filterEmpty.style.display = 'none';
      emptyListings.style.display = 'flex';
      return;
    }

    emptyListings.style.display = 'none';
    summaryChips.style.display = 'flex';

    let visibleTotal = 0;

    Object.values(groups).forEach((group) => {
      const matching = group.entries.filter(
        (entry) => activeFilter === 'all' || statusKey(entry.item) === activeFilter
      );

      group.entries.forEach((entry) => {
        entry.card.style.display = 'none';
      });
      matching.forEach((entry, index) => {
        entry.card.style.display = index < group.shown ? '' : 'none';
      });

      group.countEl.textContent = String(matching.length);
      group.el.style.display = matching.length ? '' : 'none';

      const rest = matching.length - group.shown;
      if (rest > 0) {
        group.moreBtn.style.display = 'block';
        group.moreBtn.textContent = `আরো দেখান (${rest})`;
      } else {
        group.moreBtn.style.display = 'none';
      }

      visibleTotal += matching.length;
    });

    filterEmpty.style.display = visibleTotal ? 'none' : 'block';
  }

  chipButtons.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter || 'all';
      chipButtons.forEach((c) => c.classList.toggle('active', c === chip));
      applyView();
    });
  });

  // ডিলিটের পর কার্ড/গ্রুপ পরিষ্কার করে ভিউ হালনাগাদ
  function removeItem(item) {
    const key = groupKey(item);
    const group = groups[key];

    if (group) {
      group.entries = group.entries.filter((entry) => entry.item.id !== item.id);
      if (group.entries.length === 0) {
        group.el.remove();
        delete groups[key];
      }
    }

    cardsById[item.id]?.remove();
    delete cardsById[item.id];
    delete itemsById[item.id];
    delete pendingByListing[item.id];
    delete rejectedByListing[item.id];

    applyView();
  }

  // ===== এডিট রিভিউ অবস্থা লোড (pending / rejected) =====
  async function loadEditStates() {
    pendingByListing = {};
    rejectedByListing = {};

    const { data, error } = await supabase
      .from('listing_edits')
      .select('*')
      .eq('user_id', currentUserId)
      .order('created_at', { ascending: false })
      .limit(200);

    if (error || !data) return;

    // প্রতিটা লিস্টিংয়ের সবচেয়ে নতুন এডিটই অবস্থা ঠিক করে:
    // pending → pending নোটিশ; rejected (সাম্প্রতিক) → কারণসহ নোটিশ;
    // approved → কিছু না
    const seen = new Set();
    data.forEach((row) => {
      if (seen.has(row.listing_id)) return;
      seen.add(row.listing_id);

      if (row.status === 'pending') {
        pendingByListing[row.listing_id] = row;
      } else if (row.status === 'rejected') {
        const when = new Date(row.reviewed_at || row.created_at).getTime();
        const ageDays = (Date.now() - when) / (1000 * 60 * 60 * 24);
        if (ageDays <= REJECTED_NOTE_DAYS) rejectedByListing[row.listing_id] = row;
      }
    });
  }

  function refreshNote(listingId) {
    const card = cardsById[listingId];
    if (!card) return;
    const slot = card.querySelector('.ml-note');
    if (!slot) return;

    const pending = pendingByListing[listingId];
    const rejected = rejectedByListing[listingId];

    slot.className = 'ml-note';
    slot.innerHTML = '';

    if (pending) {
      slot.className = 'ml-note ml-note-pending';
      slot.innerHTML = `
        <span>⏳ এডিট রিভিউতে আছে। অনুমোদনের আগে আগের তথ্যই সবাই দেখবে।</span><br />
        <button type="button" class="ml-note-cancel">এডিট বাতিল</button>
      `;

      const cancelBtn = slot.querySelector('.ml-note-cancel');
      cancelBtn?.addEventListener('click', async () => {
        if (!window.confirm('জমা দেওয়া এডিটটা বাতিল করবেন? আগের তথ্য যেমন আছে তেমনই থাকবে।')) return;

        cancelBtn.disabled = true;
        const { error } = await supabase
          .from('listing_edits')
          .delete()
          .eq('id', pending.id)
          .eq('status', 'pending');

        if (error) {
          alert('বাতিল করা যায়নি: ' + error.message);
          cancelBtn.disabled = false;
          return;
        }

        delete pendingByListing[listingId];
        refreshNote(listingId);
      });
    } else if (rejected) {
      slot.className = 'ml-note ml-note-rejected';
      slot.textContent = rejected.rejection_reason
        ? `❌ আপনার সর্বশেষ এডিট প্রত্যাখ্যাত হয়েছে (কারণ: ${rejected.rejection_reason}). আগের তথ্য চালু আছে।`
        : '❌ আপনার সর্বশেষ এডিট প্রত্যাখ্যাত হয়েছে। আগের তথ্য চালু আছে।';
    }
  }

  function refreshAllNotes() {
    Object.keys(cardsById).forEach(refreshNote);
  }

  function openEdit(item, card) {
    editingId = item.id;
    editingCard = card;
    editingItem = item;

    // pending এডিট থাকলে সেই তথ্যই খোলে, নইলে বর্তমান পাবলিক তথ্য
    const src = pendingByListing[item.id] || item;

    // গাড়ি ভাড়ায় price কলামে গাড়ির ধরন/মডেল থাকে, দাম নয়
    const isCar = item.category === CAR_CATEGORY;
    editPriceLabel.textContent = isCar ? 'গাড়ির ধরন / মডেল' : 'দাম / রেট';
    editPriceInput.placeholder = isCar ? 'যেমন: সিএনজি / টয়োটা পিকআপ' : '';

    editTitleInput.value = src.title || '';
    editDescInput.value = src.description || '';
    editPriceInput.value = src.price || '';
    editUpazilaInput.value = src.upazila || 'ফেনী সদর';
    editPhoneInput.value = src.contact_phone || '';
    editMessage.className = 'ml-form-msg';
    editMessage.textContent = '';

    // প্রথমবার রিভিউই হয়নি এমন লিস্টিংয়ে সরাসরি আপডেট হয়, তাই রিভিউয়ের নোট দেখানো হয় না
    editInfo.style.display = item.is_reviewed ? 'block' : 'none';

    editOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeEdit() {
    editOverlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  editClose?.addEventListener('click', closeEdit);
  editOverlay?.addEventListener('click', (e) => {
    if (e.target === editOverlay) closeEdit();
  });

  editSaveBtn?.addEventListener('click', async () => {
    const title = editTitleInput.value.trim();
    if (!title) {
      editMessage.textContent = 'টাইটেল আবশ্যক';
      editMessage.className = 'ml-form-msg show-error';
      return;
    }

    editSaveBtn.disabled = true;

    const updates = {
      title,
      description: editDescInput.value.trim(),
      price: editPriceInput.value.trim(),
      upazila: editUpazilaInput.value,
      contact_phone: editPhoneInput.value.trim(),
    };

    // সার্ভারে (RPC) মালিকানা ও শপ-প্রোডাক্ট চেক হয়। type ও ছবি এই মোডালে
    // এডিট হয় না, তাই বর্তমান মান যেমন আছে তেমনই পাঠানো হচ্ছে
    const { data, error } = await supabase.rpc('submit_listing_edit', {
      p_listing_id: editingId,
      p_title: updates.title,
      p_description: updates.description,
      p_price: updates.price,
      p_upazila: updates.upazila,
      p_type: editingItem.type || null,
      p_contact_phone: updates.contact_phone,
      p_images: editingItem.images || [],
    });

    editSaveBtn.disabled = false;

    if (error) {
      editMessage.textContent = 'সেভ ব্যর্থ: ' + error.message;
      editMessage.className = 'ml-form-msg show-error';
      return;
    }

    const mode = data?.mode;

    if (mode === 'pending') {
      // পাবলিক তথ্য বদলায়নি — কার্ডে আগের তথ্যই থাকবে, শুধু নোটিশ আসবে
      await loadEditStates();
      refreshNote(editingId);

      editMessage.textContent = 'এডিট রিভিউয়ের জন্য পাঠানো হয়েছে ✓ অনুমোদনের পর আপডেট হবে';
      editMessage.className = 'ml-form-msg show-success';
      setTimeout(closeEdit, 1500);
      return;
    }

    // mode === 'applied' — লিস্টিং এখনো পাবলিক হয়নি, সরাসরি আপডেট হয়েছে।
    // কার্ডে আপডেটেড ভ্যালু সাথে সাথে বসিয়ে দেওয়া হচ্ছে
    Object.assign(editingItem, updates);
    if (editingCard) {
      const titleEl = editingCard.querySelector('.ml-title');
      if (titleEl) titleEl.textContent = updates.title;

      const priceText = formatPrice(editingItem);
      let priceEl = editingCard.querySelector('.ml-price');
      if (priceText) {
        if (priceEl) {
          priceEl.textContent = priceText;
        } else {
          priceEl = document.createElement('p');
          priceEl.className = 'ml-price';
          priceEl.textContent = priceText;
          titleEl?.after(priceEl);
        }
      } else if (priceEl) {
        priceEl.remove();
      }
    }

    editMessage.textContent = 'সেভ হয়েছে ✓';
    editMessage.className = 'ml-form-msg show-success';
    setTimeout(closeEdit, 700);
  });

  // কার্ড তৈরি করে ফেরত দেয় (গ্রুপে বসানোর কাজ লোডের সময়)
  function renderCard(item) {
    const status = statusLabels[item.status] || statusLabels.pending;
    const card = document.createElement('div');
    card.className = 'ml-card';
    card.dataset.id = item.id;

    const photoHtml = item.images && item.images.length > 0
      ? `<img src="${escapeHtml(item.images[0])}" alt="${escapeHtml(item.title || '')}" class="ml-photo" />`
      : `<div class="ml-icon-fallback"><i class="fas fa-image"></i></div>`;

    const priceText = formatPrice(item);

    card.innerHTML = `
      <span class="ml-status-badge" style="background:${status.bg};color:${status.color};">${status.text}</span>
      ${photoHtml}
      <div class="ml-body">
        <p class="ml-title">${escapeHtml(item.title || '')}</p>
        ${priceText ? `<p class="ml-price">${escapeHtml(priceText)}</p>` : ''}
        <div class="ml-note"></div>
        <div class="ml-actions">
          <a href="/listing/${item.id}" class="ml-btn ml-btn-view"><i class="fas fa-eye"></i> দেখুন</a>
          <button type="button" class="ml-btn ml-btn-edit" data-edit-id="${item.id}"><i class="fas fa-pen"></i> এডিট</button>
          <button type="button" class="ml-btn ml-btn-delete" data-delete-id="${item.id}"><i class="fas fa-trash"></i> ডিলিট</button>
        </div>
      </div>
    `;

    cardsById[item.id] = card;

    const editBtn = card.querySelector('[data-edit-id]');
    editBtn?.addEventListener('click', () => openEdit(item, card));

    const deleteBtn = card.querySelector('[data-delete-id]');
    deleteBtn?.addEventListener('click', async () => {
      const confirmed = window.confirm('এই লিস্টিং পার্মানেন্টলি ডিলিট করবেন?');
      if (!confirmed) return;

      deleteBtn.disabled = true;
      deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      const { error } = await supabase.from('listings').delete().eq('id', item.id);

      if (error) {
        alert('ডিলিট করা যায়নি: ' + error.message);
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = '<i class="fas fa-trash"></i> ডিলিট';
        return;
      }

      removeItem(item);
    });

    return card;
  }

  async function loadMyListings() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      loadingState.style.display = 'none';
      loginRequired.style.display = 'flex';
      return;
    }

    currentUserId = session.user.id;

    const { data, error } = await supabase
      .from('listings')
      .select('*')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false });

    loadingState.style.display = 'none';
    listingsContent.style.display = 'block';

    if (error || !data || data.length === 0) {
      emptyListings.style.display = 'flex';
      return;
    }

    // এডিট রিভিউয়ের অবস্থা আগে আনা হয় (ফেইল করলেও কার্ড দেখাবে)
    await loadEditStates();

    // ক্যাটাগরি গ্রুপ — services.js-এর ক্রম অনুযায়ী, অচেনা ক্যাটাগরি সবার শেষে
    const keys = [...new Set(data.map(groupKey))].sort(
      (a, b) => (categoryMeta[a]?.order ?? 999) - (categoryMeta[b]?.order ?? 999)
    );

    keys.forEach((key) => {
      const group = createGroup(key);
      groups[key] = group;
      container.appendChild(group.el);
    });

    data.forEach((item) => {
      const card = renderCard(item);
      const group = groups[groupKey(item)];
      group.entries.push({ item, card });
      group.grid.appendChild(card);
      itemsById[item.id] = item;
    });

    refreshAllNotes();
    applyView();
  }

  loadMyListings();
</script>
