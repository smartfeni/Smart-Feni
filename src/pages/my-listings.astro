<!-- path: src/pages/my-listings.astro -->
---
// ============================================================
// পেজ: /my-listings — "আমার পোস্ট" — ইউজারের নিজের করা সব
// ক্যাটাগরির লিস্টিং এক জায়গায় (দেখুন + এডিট + ডিলিট)।
// আপডেট: জেনেরিক এডিট মোডাল যোগ করা হয়েছে — টাইটেল, বিবরণ, দাম,
// উপজেলা, যোগাযোগ নম্বর এডিট করা যায় (এগুলো সব ক্যাটাগরিতে কমন
// কলাম)। type/category/ছবি এডিটেবল না — ক্যাটাগরি-ভিত্তিক টাইপ
// লিস্ট আলাদা ফাইলে থাকায় জেনেরিকভাবে আনা স্কোপের বাইরে রাখা হলো।
// my-orders.astro এর একই প্যাটার্ন: loading/login-required/content
// states, style is:global (কার্ড JS দিয়ে dynamically তৈরি হয় বলে
// Astro এর scoped CSS এতে কাজ করে না)।
// স্ট্যাটাস লেবেল/কালার admin/listings.astro এর statusLabels থেকে
// রিইউজ করা হয়েছে কনসিস্টেন্সির জন্য।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="আমার পোস্ট | স্মার্ট ফেনী">
  <div class="my-listings-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-lock"></i></div>
        <h2>লগইন করুন</h2>
        <p>নিজের পোস্ট করা লিস্টিং দেখতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="listingsContent" style="display:none;">
        <h1 class="page-title"><i class="fas fa-list-check"></i> আমার পোস্ট</h1>

        <div id="emptyListings" class="status-box" style="display:none;">
          <div class="status-icon-badge"><i class="fas fa-inbox"></i></div>
          <h2>কোনো লিস্টিং নেই</h2>
          <p>এখনো কোনো ক্যাটাগরিতে লিস্টিং পোস্ট করেননি</p>
          <a href="/" class="primary-link-btn">হোমপেজে যান</a>
        </div>

        <div id="listingsContainer" class="listings-grid"></div>
      </div>

    </div>
  </div>

  <!-- ===== লিস্টিং এডিট মোডাল ===== -->
  <div class="ml-edit-overlay" id="mlEditOverlay">
    <div class="ml-edit-modal">
      <button class="ml-edit-close" id="mlEditClose" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>

      <h2 class="ml-edit-title"><i class="fas fa-pen"></i> লিস্টিং এডিট করুন</h2>

      <p class="ml-form-msg" id="mlEditMessage"></p>

      <label class="ml-form-label">টাইটেল</label>
      <input type="text" class="ml-form-input" id="mlEditTitle" />

      <label class="ml-form-label">বিবরণ</label>
      <textarea class="ml-form-input" id="mlEditDescription" rows="3"></textarea>

      <label class="ml-form-label">দাম / রেট</label>
      <input type="text" class="ml-form-input" id="mlEditPrice" />

      <label class="ml-form-label">উপজেলা</label>
      <select class="ml-form-input" id="mlEditUpazila">
        <option value="ফেনী সদর">ফেনী সদর</option>
        <option value="ছাগলনাইয়া">ছাগলনাইয়া</option>
        <option value="দাগনভূঞা">দাগনভূঞা</option>
        <option value="পরশুরাম">পরশুরাম</option>
        <option value="ফুলগাজী">ফুলগাজী</option>
        <option value="সোনাগাজী">সোনাগাজী</option>
      </select>

      <label class="ml-form-label">যোগাযোগ নম্বর</label>
      <input type="tel" class="ml-form-input" id="mlEditPhone" />

      <button class="ml-primary-btn" id="mlEditSaveBtn" type="button">
        <i class="fas fa-check"></i> <span>সেভ করুন</span>
      </button>
    </div>
  </div>

  <style is:global>
    .my-listings-page {
      min-height: 70vh;
      padding: 28px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      text-align: center;
      background: #fff;
      border-radius: 20px;
      padding: 60px 24px;
      border: 1px dashed #E5EAF0;
      max-width: 420px;
      margin: 40px auto;
    }

    .status-icon-badge {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin: 0 auto 16px;
    }

    .status-box h2 {
      font-size: 1.1rem;
      color: #1B2A4A;
      margin-bottom: 6px;
    }

    .status-box p {
      color: #8FA0BC;
      font-size: 0.88rem;
      margin-bottom: 18px;
    }

    .primary-link-btn {
      display: inline-block;
      background: #FF6B35;
      color: #fff;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 11px 26px;
      border-radius: 40px;
      text-decoration: none;
    }

    .page-title {
      font-size: 1.4rem;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
    }

    .page-title i {
      color: #FF6B35;
      font-size: 1.15rem;
    }

    .listings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
    }

    .ml-card {
      background: #fff;
      border-radius: 18px;
      border: 1px solid #EEF3F9;
      overflow: hidden;
      position: relative;
    }

    .ml-status-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
    }

    .ml-photo {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      background: #F4F7FC;
    }

    .ml-icon-fallback {
      width: 100%;
      aspect-ratio: 4 / 3;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
    }

    .ml-body {
      padding: 12px 14px 14px;
    }

    .ml-category {
      display: inline-block;
      font-size: 0.63rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 20px;
      background: #F4F7FC;
      color: #5A6E85;
      margin-bottom: 6px;
    }

    .ml-title {
      font-size: 0.87rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 3px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ml-price {
      font-size: 0.85rem;
      font-weight: 700;
      color: #FF6B35;
      margin-bottom: 8px;
    }

    .ml-actions {
      display: flex;
      gap: 6px;
    }

    .ml-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 8px 6px;
      border-radius: 10px;
      cursor: pointer;
      border: none;
      text-decoration: none;
    }

    .ml-btn-view {
      background: #F4F7FC;
      color: #1B2A4A;
    }

    .ml-btn-view:hover {
      background: #E5EAF0;
    }

    .ml-btn-delete {
      background: #FFF0EA;
      color: #D14343;
    }

    .ml-btn-delete:hover {
      background: #FFE0D6;
    }

    .ml-btn-delete:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .ml-btn-edit {
      background: #EAF1FF;
      color: #1B5FE0;
    }

    .ml-btn-edit:hover {
      background: #D9E7FF;
    }

    /* ===== এডিট মোডাল ===== */
    .ml-edit-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow-y: auto;
    }

    .ml-edit-overlay.open {
      display: flex;
    }

    .ml-edit-modal {
      position: relative;
      background: #fff;
      width: 100%;
      max-width: 420px;
      border-radius: 28px;
      padding: 32px 28px 28px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.25);
      margin: auto;
    }

    .ml-edit-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: #F4F7FC;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: #5A6E85;
      cursor: pointer;
    }

    .ml-edit-title {
      font-size: 1.15rem;
      color: #1B2A4A;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ml-edit-title i {
      color: #FF6B35;
    }

    .ml-form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .ml-form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .ml-form-msg.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .ml-form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .ml-form-label:first-of-type {
      margin-top: 0;
    }

    .ml-form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .ml-form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .ml-primary-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-top: 16px;
    }

    .ml-primary-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
  </style>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase.js';
  import { categories } from '../data/services.js';

  const loadingState = document.getElementById('loadingState');
  const loginRequired = document.getElementById('loginRequired');
  const listingsContent = document.getElementById('listingsContent');
  const emptyListings = document.getElementById('emptyListings');
  const container = document.getElementById('listingsContainer');

  const categoryNameMap = Object.fromEntries(categories.map((c) => [c.id, c.name]));

  const statusLabels = {
    pending: { text: 'রিভিউ বাকি', bg: '#FFF3E0', color: '#B36B00' },
    active: { text: 'সক্রিয়', color: '#1B7A3C', bg: '#EAFBF0' },
    rejected: { text: 'বাতিল', color: '#D14343', bg: '#FFF0EA' },
  };

  let currentUserId = null;

  // ===== এডিট মোডাল এলিমেন্ট =====
  const editOverlay = document.getElementById('mlEditOverlay');
  const editClose = document.getElementById('mlEditClose');
  const editMessage = document.getElementById('mlEditMessage');
  const editTitleInput = document.getElementById('mlEditTitle');
  const editDescInput = document.getElementById('mlEditDescription');
  const editPriceInput = document.getElementById('mlEditPrice');
  const editUpazilaInput = document.getElementById('mlEditUpazila');
  const editPhoneInput = document.getElementById('mlEditPhone');
  const editSaveBtn = document.getElementById('mlEditSaveBtn');
  let editingId = null;
  let editingCard = null;
  let editingItem = null;

  function openEdit(item, card) {
    editingId = item.id;
    editingCard = card;
    editingItem = item;
    editTitleInput.value = item.title || '';
    editDescInput.value = item.description || '';
    editPriceInput.value = item.price || '';
    editUpazilaInput.value = item.upazila || 'ফেনী সদর';
    editPhoneInput.value = item.contact_phone || '';
    editMessage.className = 'ml-form-msg';
    editMessage.textContent = '';
    editOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeEdit() {
    editOverlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  editClose?.addEventListener('click', closeEdit);
  editOverlay?.addEventListener('click', (e) => {
    if (e.target === editOverlay) closeEdit();
  });

  editSaveBtn?.addEventListener('click', async () => {
    const title = editTitleInput.value.trim();
    if (!title) {
      editMessage.textContent = 'টাইটেল আবশ্যক';
      editMessage.className = 'ml-form-msg show-error';
      return;
    }

    editSaveBtn.disabled = true;

    const updates = {
      title,
      description: editDescInput.value.trim(),
      price: editPriceInput.value.trim(),
      upazila: editUpazilaInput.value,
      contact_phone: editPhoneInput.value.trim(),
    };

    const { error } = await supabase
      .from('listings')
      .update(updates)
      .eq('id', editingId)
      .eq('user_id', currentUserId);

    editSaveBtn.disabled = false;

    if (error) {
      editMessage.textContent = 'সেভ ব্যর্থ: ' + error.message;
      editMessage.className = 'ml-form-msg show-error';
      return;
    }

    // কার্ডে আপডেটেড ভ্যালু সাথে সাথে বসিয়ে দেওয়া হচ্ছে
    Object.assign(editingItem, updates);
    if (editingCard) {
      const titleEl = editingCard.querySelector('.ml-title');
      if (titleEl) titleEl.textContent = updates.title;

      let priceEl = editingCard.querySelector('.ml-price');
      if (updates.price) {
        if (priceEl) {
          priceEl.textContent = `৳${updates.price}`;
        } else {
          priceEl = document.createElement('p');
          priceEl.className = 'ml-price';
          priceEl.textContent = `৳${updates.price}`;
          titleEl?.after(priceEl);
        }
      } else if (priceEl) {
        priceEl.remove();
      }
    }

    editMessage.textContent = 'সেভ হয়েছে ✓';
    editMessage.className = 'ml-form-msg show-success';
    setTimeout(closeEdit, 700);
  });

  function renderCard(item) {
    const status = statusLabels[item.status] || statusLabels.pending;
    const card = document.createElement('div');
    card.className = 'ml-card';
    card.dataset.id = item.id;

    const photoHtml = item.images && item.images.length > 0
      ? `<img src="${item.images[0]}" alt="${item.title || ''}" class="ml-photo" />`
      : `<div class="ml-icon-fallback"><i class="fas fa-image"></i></div>`;

    card.innerHTML = `
      <span class="ml-status-badge" style="background:${status.bg};color:${status.color};">${status.text}</span>
      ${photoHtml}
      <div class="ml-body">
        <span class="ml-category">${categoryNameMap[item.category] || item.category}</span>
        <p class="ml-title">${item.title || ''}</p>
        ${item.price ? `<p class="ml-price">৳${item.price}</p>` : ''}
        <div class="ml-actions">
          <a href="/listing/${item.id}" class="ml-btn ml-btn-view"><i class="fas fa-eye"></i> দেখুন</a>
          <button type="button" class="ml-btn ml-btn-edit" data-edit-id="${item.id}"><i class="fas fa-pen"></i> এডিট</button>
          <button type="button" class="ml-btn ml-btn-delete" data-delete-id="${item.id}"><i class="fas fa-trash"></i> ডিলিট</button>
        </div>
      </div>
    `;

    const editBtn = card.querySelector('[data-edit-id]');
    editBtn?.addEventListener('click', () => openEdit(item, card));

    const deleteBtn = card.querySelector('[data-delete-id]');
    deleteBtn?.addEventListener('click', async () => {
      const confirmed = window.confirm('এই লিস্টিং পার্মানেন্টলি ডিলিট করবেন?');
      if (!confirmed) return;

      deleteBtn.disabled = true;
      deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      const { error } = await supabase.from('listings').delete().eq('id', item.id);

      if (error) {
        alert('ডিলিট করা যায়নি: ' + error.message);
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = '<i class="fas fa-trash"></i> ডিলিট';
        return;
      }

      card.remove();
      if (!container.children.length) {
        emptyListings.style.display = 'flex';
      }
    });

    container.appendChild(card);
  }

  async function loadMyListings() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      loadingState.style.display = 'none';
      loginRequired.style.display = 'flex';
      return;
    }

    currentUserId = session.user.id;

    const { data, error } = await supabase
      .from('listings')
      .select('*')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false });

    loadingState.style.display = 'none';
    listingsContent.style.display = 'block';

    if (error || !data || data.length === 0) {
      emptyListings.style.display = 'flex';
      return;
    }

    data.forEach(renderCard);
  }

  loadMyListings();
</script>