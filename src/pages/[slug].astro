---
// ============================================================
// পেজ: root-level catch-all (/[slug])
// আগে শুধু clubs টেবিলে slug লুকআপ করত। এখন shops টেবিলেও চেক
// করে (club না পেলে) — কারণ club আর shop দুটোই এখন top-level
// slug URL শেয়ার করে (smartfeni.com/slug)।
// static ফাইল (about, contact, my-shop ইত্যাদি) সবসময় এই
// dynamic route এর আগে prioritize হয় — তাই conflict হবে না।
// ফিক্স (একাধিক শপ): শপের প্রোডাক্ট আগে ওউনারের user_id দিয়ে আনা হতো,
// তাই একই ওউনারের সব শপে সব প্রোডাক্ট মিশে যেত। এখন listings.shop_id
// দিয়ে আনা হয় — প্রতিটা শপে শুধু তার নিজের প্রোডাক্ট।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import ClubProfile from '../components/club/ClubProfile.astro';
import ShopProfile from '../components/shop/ShopProfile.astro';
import { supabase } from '../lib/supabase.js';

const { slug } = Astro.params;

const { data: club, error: clubError } = await supabase
  .from('clubs')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .maybeSingle();

if (clubError) {
  console.error('club fetch error:', clubError.message);
}

let members = [];
let posts = [];

if (club) {
  const [{ data: memberData }, { data: postData }] = await Promise.all([
    supabase
      .from('club_members')
      .select('*')
      .eq('club_id', club.id)
      .order('position_order', { ascending: true }),
    supabase
      .from('club_posts')
      .select('*')
      .eq('club_id', club.id)
      .order('created_at', { ascending: false }),
  ]);
  members = memberData || [];
  posts = postData || [];
}

// club না পাওয়া গেলে shops টেবিলে চেক
let shop = null;
let shopProducts = [];
let shopTotal = 0;
let shopCategories = [];
const SHOP_PAGE_SIZE = 10;

if (!club) {
  const { data: shopData, error: shopError } = await supabase
    .from('shops')
    .select('*')
    .eq('slug', slug)
    .eq('is_active', true)
    .maybeSingle();

  if (shopError) {
    console.error('shop fetch error:', shopError.message);
  }

  shop = shopData || null;

  if (shop) {
    // ব্যাচ ৩: শুধু প্রথম ১০টা প্রোডাক্ট সার্ভার থেকে (বাকি স্ক্রলে ক্লায়েন্ট আনে),
    // সাথে শপের প্রোডাক্ট ক্যাটাগরি; যে ক্যাটাগরিতে প্রোডাক্ট নেই সেটা বাদ
    const [firstPage, catRows, catLinks] = await Promise.all([
      supabase
        .from('listings')
        .select('id, title, price, price_unit, images, is_sold_out, is_best_seller, shop_category_id', { count: 'exact' })
        .eq('category', 'online-shop')
        .eq('shop_id', shop.id)
        .eq('status', 'active')
        .order('is_sold_out', { ascending: true, nullsFirst: true })
        .order('is_best_seller', { ascending: false, nullsFirst: false })
        .order('created_at', { ascending: false })
        .range(0, SHOP_PAGE_SIZE - 1),
      supabase
        .from('shop_product_categories')
        .select('id, name')
        .eq('shop_id', shop.id)
        .order('sort_order', { ascending: true })
        .order('created_at', { ascending: true }),
      supabase
        .from('listings')
        .select('shop_category_id')
        .eq('category', 'online-shop')
        .eq('shop_id', shop.id)
        .eq('status', 'active')
        .not('shop_category_id', 'is', null)
        .limit(2000),
    ]);

    shopProducts = firstPage.data || [];
    shopTotal = firstPage.count ?? shopProducts.length;

    const usedCats = new Set((catLinks.data || []).map((r) => r.shop_category_id));
    shopCategories = (catRows.data || []).filter((c) => usedCats.has(c.id));
  }
}

const notFound = !club && !shop;

const pageTitle = club
  ? `${club.name} | স্মার্ট ফেনী`
  : shop
  ? `${shop.name} | স্মার্ট ফেনী`
  : 'পেজ পাওয়া যায়নি | স্মার্ট ফেনী';

const pageDescription = club
  ? club.tagline || club.description || `${club.name} — ফেনীর একটি ক্লাব`
  : shop
  ? shop.tagline || shop.description || `${shop.name} — ফেনীর একটি অনলাইন শপ`
  : undefined;

const ogImage = club ? club.cover_image || club.logo_image : shop ? shop.cover_image || shop.logo_image : undefined;
const canonicalPath = club ? `/${club.slug}` : shop ? `/${shop.slug}` : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
>
  {club ? (
    <ClubProfile club={club} members={members} posts={posts} />
  ) : shop ? (
    <ShopProfile shop={shop} products={shopProducts} total={shopTotal} categories={shopCategories} pageSize={SHOP_PAGE_SIZE} />
  ) : (
    <section class="not-found">
      <div class="container">
        <i class="fas fa-face-frown"></i>
        <p>এই পেজটি খুঁজে পাওয়া যায়নি</p>
        <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> হোমপেজে ফিরে যান</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .not-found {
    padding: 120px 0;
    text-align: center;
    color: #B0BCCB;
  }
  .not-found i {
    font-size: 3rem;
    margin-bottom: 16px;
  }
  .not-found p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #FF6B35;
    text-decoration: none;
    font-weight: 700;
  }
</style>