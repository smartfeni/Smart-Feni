---
// ============================================================
// পেজ: root-level catch-all (/[slug])
// আগে শুধু clubs টেবিলে slug লুকআপ করত। এখন shops টেবিলেও চেক
// করে (club না পেলে) — কারণ club আর shop দুটোই এখন top-level
// slug URL শেয়ার করে (smartfeni.com/slug)।
// static ফাইল (about, contact, my-shop ইত্যাদি) সবসময় এই
// dynamic route এর আগে prioritize হয় — তাই conflict হবে না।
// ফিক্স (একাধিক শপ): শপের প্রোডাক্ট আগে ওউনারের user_id দিয়ে আনা হতো,
// তাই একই ওউনারের সব শপে সব প্রোডাক্ট মিশে যেত। এখন listings.shop_id
// দিয়ে আনা হয় — প্রতিটা শপে শুধু তার নিজের প্রোডাক্ট।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import ClubProfile from '../components/club/ClubProfile.astro';
import { supabase } from '../lib/supabase.js';

const { slug } = Astro.params;

const { data: club, error: clubError } = await supabase
  .from('clubs')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .maybeSingle();

if (clubError) {
  console.error('club fetch error:', clubError.message);
}

let members = [];
let posts = [];

if (club) {
  const [{ data: memberData }, { data: postData }] = await Promise.all([
    supabase
      .from('club_members')
      .select('id, club_id, name, photo, position, position_order, is_committee, created_at')
      .eq('club_id', club.id)
      .order('position_order', { ascending: true }),
    supabase
      .from('club_posts')
      .select('*')
      .eq('club_id', club.id)
      .order('created_at', { ascending: false }),
  ]);
  members = memberData || [];
  posts = postData || [];
}

// club না পেলে: পুরনো অনলাইন শপের স্লাগ → কুইক ডেলিভারির দোকানে রিডাইরেক্ট (শেয়ার করা পুরনো লিংক যেন না ভাঙে)
const shop = null;
if (!club) {
  const { data: ds } = await supabase.from('delivery_shops').select('id').ilike('legacy_slug', String(slug || '').replace(/[%_\\]/g, '')).maybeSingle();
  if (ds) return Astro.redirect('/market/shop?id=' + ds.id, 301);
}

const notFound = !club && !shop;

const pageTitle = club
  ? `${club.name} — ফেনীর ক্লাব | স্মার্ট ফেনী`
  : shop
  ? `${shop.name} — ফেনীর অনলাইন শপ | স্মার্ট ফেনী`
  : 'পেজ পাওয়া যায়নি | স্মার্ট ফেনী';

const pageDescription = club
  ? club.tagline || club.description || `${club.name} — ফেনীর একটি ক্লাব`
  : shop
  ? shop.tagline || shop.description || `${shop.name} — ফেনীর একটি অনলাইন শপ`
  : undefined;

const ogImage = club ? club.cover_image || club.logo_image : shop ? shop.cover_image || shop.logo_image : undefined;
const canonicalPath = club ? `/${club.slug}` : shop ? `/${shop.slug}` : undefined;

// না-পাওয়া পেজে সঠিক 404 স্ট্যাটাস (soft-404 এড়াতে)
if (notFound) {
  Astro.response.status = 404;
}

const metaDescription = pageDescription
  ? String(pageDescription).replace(/\s+/g, ' ').trim().slice(0, 160)
  : undefined;

const entity = club || shop;
const entityJsonLd = entity
  ? {
      '@context': 'https://schema.org',
      '@type': club ? 'Organization' : 'Store',
      name: entity.name,
      url: `https://smartfeni.com/${entity.slug}`,
      image: ogImage || undefined,
      description: metaDescription,
      areaServed: { '@type': 'AdministrativeArea', name: 'ফেনী জেলা' },
    }
  : null;
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  jsonLd={entityJsonLd}
>
  {club ? (
    <ClubProfile club={club} members={members} posts={posts} />
  ) : (
    <section class="not-found">
      <div class="container">
        <i class="fas fa-face-frown"></i>
        <p>এই পেজটি খুঁজে পাওয়া যায়নি</p>
        <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> হোমপেজে ফিরে যান</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .not-found {
    padding: 120px 0;
    text-align: center;
    color: #B0BCCB;
  }
  .not-found i {
    font-size: 3rem;
    margin-bottom: 16px;
  }
  .not-found p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #FF6B35;
    text-decoration: none;
    font-weight: 700;
  }
</style>