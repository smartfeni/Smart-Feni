---
// src/pages/terms-of-service.astro
import Layout from '../components/layout/BaseLayout.astro';
const lastUpdated = "১০ সেপ্টেম্বর, ২০২৬";
---

<Layout title="ব্যবহারের শর্তাবলী | স্মার্ট ফেনী">
  <main style="max-width: 800px; margin: 0 auto; padding: 40px 20px; color: #1B2A4A; line-height: 1.8;">
    <h1 style="font-size: 28px; margin-bottom: 8px;">ব্যবহারের শর্তাবলী</h1>
    <p style="color: #64748B; margin-bottom: 32px;">সর্বশেষ আপডেট: {lastUpdated}</p>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">১. প্ল্যাটফর্ম ব্যবহারের নিয়ম</h2>
      <p>স্মার্ট ফেনী (smartfeni.com) ব্যবহার করার মাধ্যমে আপনি এই শর্তাবলীতে সম্মত হচ্ছেন। এই প্ল্যাটফর্ম ফেনী জেলার মানুষের জন্য একটি হাইপারলোকাল কমিউনিটি সার্ভিস মার্কেটপ্লেস — যেখানে বাসা ভাড়া, চাকরি, রাইড, ডেলিভারি, অনলাইন শপ, টিউশন, ব্লাড ডোনার খোঁজাসহ বিভিন্ন সেবা একজন ইউজার আরেকজনের সাথে সংযুক্ত হতে পারেন।</p>
      <p style="margin-top: 10px;">অ্যাকাউন্ট তৈরি করতে হলে আপনাকে সঠিক ফোন নম্বর ব্যবহার করতে হবে। ১৮ বছরের কম বয়সী ব্যবহারকারীদের ক্ষেত্রে অভিভাবকের সম্মতি প্রয়োজন।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">২. ইউজারের দায়িত্ব</h2>
      <ul style="padding-left: 20px;">
        <li>আপনি যে লিস্টিং, বিজ্ঞাপন, প্রোডাক্ট বা তথ্য পোস্ট করবেন তা সঠিক ও সত্য হতে হবে</li>
        <li>নিজের অ্যাকাউন্টের নিরাপত্তা (পাসওয়ার্ড/ফোন নম্বর অ্যাক্সেস) বজায় রাখার দায়িত্ব আপনার</li>
        <li>অন্য ব্যবহারকারীর সাথে লেনদেন বা যোগাযোগের সময় সততা ও সম্মান বজায় রাখতে হবে</li>
        <li>রাইড/ডেলিভারি হিরো হিসেবে নিবন্ধনের সময় প্রদত্ত তথ্য (NID, পরিচয়) সঠিক হতে হবে</li>
      </ul>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৩. নিষিদ্ধ কার্যকলাপ</h2>
      <p>নিচের যেকোনো কার্যকলাপ প্ল্যাটফর্মে সম্পূর্ণ নিষিদ্ধ:</p>
      <ul style="margin-top: 10px; padding-left: 20px;">
        <li>ভুয়া বা প্রতারণামূলক লিস্টিং/বিজ্ঞাপন পোস্ট করা</li>
        <li>স্প্যাম, বারবার একই কনটেন্ট পোস্ট করা, বা বট ব্যবহার করা</li>
        <li>অবৈধ পণ্য/সেবা (মাদক, অস্ত্র, জাল ডকুমেন্ট ইত্যাদি) বিজ্ঞাপন দেওয়া</li>
        <li>অন্য ব্যবহারকারীকে হয়রানি, হুমকি, বা প্রতারণা করা</li>
        <li>কারো ব্যক্তিগত তথ্য (ফোন নম্বর, ঠিকানা) তার অনুমতি ছাড়া প্রকাশ করা</li>
        <li>প্ল্যাটফর্মের নিরাপত্তা ব্যবস্থা ভাঙার চেষ্টা করা (হ্যাকিং, স্ক্র্যাপিং ইত্যাদি)</li>
      </ul>
      <p style="margin-top: 10px;">এই নিয়ম ভঙ্গ করলে অ্যাডমিন কোনো পূর্বনোটিশ ছাড়াই সংশ্লিষ্ট লিস্টিং সরিয়ে ফেলতে বা অ্যাকাউন্ট সাসপেন্ড করতে পারবে।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৪. স্মার্ট ফেনীর ভূমিকা — শুধু সংযোগকারী প্ল্যাটফর্ম</h2>
      <p>স্মার্ট ফেনী শুধুমাত্র ইউজারদের একে অপরের সাথে সংযুক্ত করার একটি প্ল্যাটফর্ম। আমরা কোনো লিস্টিং, পণ্য, সার্ভিস প্রোভাইডার, বা ব্যবহারকারীর সরাসরি অংশ নই — অর্থাৎ কোনো বাসা ভাড়া, গাড়ি ভাড়া, টিউশন, রাইড, ডেলিভারি বা অনলাইন শপের লেনদেনে আমরা সরাসরি পক্ষ না।</p>
      <p style="margin-top: 10px;">দুই ইউজারের মধ্যে যেকোনো লেনদেন, চুক্তি, বা সার্ভিসের মান সংক্রান্ত বিরোধের জন্য স্মার্ট ফেনী দায়ী থাকবে না। আমরা লিস্টিং যাচাইয়ের যথাসাধ্য চেষ্টা করি, তবে সম্পূর্ণ নিশ্চয়তা দিতে পারি না।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৫. পেমেন্ট ও লেনদেন</h2>
      <p>বর্তমানে স্মার্ট ফেনী সরাসরি কোনো পেমেন্ট প্রসেস করে না — কেনাবেচা/সার্ভিসের মূল্য পরিশোধ সরাসরি ইউজারদের মধ্যে সম্পন্ন হয়। যেকোনো আর্থিক লেনদেনের ঝুঁকি ও দায়ভার সংশ্লিষ্ট ইউজারদের নিজস্ব।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৬. কনটেন্ট মালিকানা</h2>
      <p>আপনি যে ছবি, লেখা বা তথ্য পোস্ট করেন তার মালিকানা আপনারই থাকে। তবে প্ল্যাটফর্মে প্রদর্শনের জন্য আপনি স্মার্ট ফেনীকে সেই কনটেন্ট হোস্ট ও প্রদর্শনের অনুমতি দিচ্ছেন।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৭. অ্যাকাউন্ট সাসপেনশন ও বাতিল</h2>
      <p>শর্তাবলী লঙ্ঘন, প্রতারণামূলক কার্যকলাপ, বা অন্য ইউজারদের ক্ষতি করার প্রমাণ পেলে আমরা কোনো পূর্বনোটিশ ছাড়াই অ্যাকাউন্ট সাময়িক বা স্থায়ীভাবে বন্ধ করার অধিকার রাখি।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৮. শর্তাবলী পরিবর্তন</h2>
      <p>প্ল্যাটফর্মের প্রয়োজনে আমরা যেকোনো সময় এই শর্তাবলী পরিবর্তন বা আপডেট করতে পারি। উল্লেখযোগ্য পরিবর্তন হলে এই পেজে নতুন তারিখসহ আপডেট করা হবে। পরিবর্তনের পরও প্ল্যাটফর্ম ব্যবহার চালিয়ে যাওয়া মানে আপনি নতুন শর্তাবলীতে সম্মত।</p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৯. প্রযোজ্য আইন</h2>
      <p>এই শর্তাবলী বাংলাদেশের প্রচলিত আইন অনুযায়ী পরিচালিত হবে। যেকোনো আইনি বিরোধের ক্ষেত্রে বাংলাদেশের এখতিয়ারভুক্ত আদালত প্রযোজ্য হবে।</p>
    </section>

    <section>
      <h2 style="font-size: 20px; margin-bottom: 10px;">১০. যোগাযোগ</h2>
      <p>শর্তাবলী সংক্রান্ত কোনো প্রশ্ন থাকলে যোগাযোগ করুন: <a href="mailto:info@smartfeni.com" style="color: #FF6B35;">info@smartfeni.com</a></p>
    </section>
  </main>
</Layout>