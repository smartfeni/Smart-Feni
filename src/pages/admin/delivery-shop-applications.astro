---
// path: src/pages/admin/delivery-shop-applications.astro
// ============================================================
// পেজ: কুইক ডেলিভারির দোকানের আবেদন (/admin/delivery-shop-applications)
// আবেদন স্বয়ংসম্পূর্ণ আসে (/become-a-shop-owner)। অ্যাডমিন শুধু ক্যাটাগরি বেছে (আবেদনকারীর বাছাই টিক দেওয়া)
// অনুমোদন দেন → admin_approve_shop_app দোকান + মেনু তৈরি করে লাইভ করে, মালিককে Pro শপ দেয়।
// বাতিল: কারণসহ (admin_reject_shop_app)। পারমিশন: delivery_shops (adminGuard), RPC-তে delivery_shops.manage।
// সব টেক্সট textContent দিয়ে।
// ============================================================
export const prerender = false;
import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="দোকানের আবেদন | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="saa">
    <div id="adminLoadingState" class="saa-loading"><p>যাচাই করা হচ্ছে…</p></div>
    <div id="adminGuardedContent" style="display:none;">
      <div class="saa-head">
        <div class="saa-head-in">
          <a href="/admin/delivery-shops" class="saa-round" aria-label="দোকানের তালিকায় ফিরুন"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg></a>
          <div class="saa-title"><h1>দোকানের আবেদন</h1><span>কুইক ডেলিভারি · ক্যাটাগরি বেছে অনুমোদন</span></div>
          <img src="/market/icons/bags.webp" alt="" aria-hidden="true" class="saa-hic" />
        </div>
      </div>
      <div class="saa-body">
        <div class="saa-tabs" role="tablist" aria-label="আবেদনের অবস্থা">
          <button type="button" role="tab" class="saa-tab" data-t="pending" aria-selected="true">নতুন <b id="cPending">০</b></button>
          <button type="button" role="tab" class="saa-tab" data-t="approved" aria-selected="false">অনুমোদিত</button>
          <button type="button" role="tab" class="saa-tab" data-t="rejected" aria-selected="false">ফেরত</button>
        </div>
        <div id="saaList" class="saa-list" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <style is:global>
    .saa { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #F4F6FA; min-height: 70vh; padding-bottom: 100px; overflow-x: hidden; }
    .saa-loading { padding: 80px 16px; text-align: center; color: #5B6B86; }
    .saa-head { position: relative; left: 50%; width: 100vw; margin-left: -50vw; background: linear-gradient(135deg, #1B2A4A, #2C4372); color: #fff; }
    .saa-head-in { max-width: 640px; margin: 0 auto; padding: 14px 16px; display: flex; align-items: center; gap: 12px; min-height: 76px; }
    .saa-round { width: 44px; height: 44px; border-radius: 22px; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; flex: none; }
    .saa-round svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
    .saa-title { flex: 1; min-width: 0; }
    .saa-title h1 { margin: 0; font-size: 20px; color: #fff; }
    .saa-title span { font-size: 13px; opacity: .85; }
    .saa-hic { width: 46px; height: 46px; }
    .saa-body { max-width: 640px; margin: 0 auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 12px; }
    .saa-tabs { display: flex; gap: 8px; }
    .saa-tab { flex: 1; min-height: 44px; border-radius: 14px; border: 1.5px solid #E2E8F0; background: #fff; font: inherit; font-weight: 700; color: #1B2A4A; cursor: pointer; }
    .saa-tab b { margin-left: 4px; font-size: 12px; background: #FFE8DC; color: #C2410C; border-radius: 8px; padding: 1px 7px; }
    .saa-tab[aria-selected='true'] { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
    .saa-list { display: flex; flex-direction: column; gap: 14px; }
    .saa-card { background: #fff; border-radius: 22px; overflow: hidden; box-shadow: 0 4px 16px rgba(27,42,74,.08); }
    .saa-cover { height: 120px; background: linear-gradient(135deg,#FFE3D3,#FFD0B8) center/cover no-repeat; position: relative; }
    .saa-logo { position: absolute; left: 14px; bottom: -28px; width: 64px; height: 64px; border-radius: 18px; border: 3px solid #fff; background: #FFF1E8 center/cover no-repeat; box-shadow: 0 4px 12px rgba(0,0,0,.15); }
    .saa-kind { position: absolute; right: 12px; top: 12px; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: #fff; color: #1B2A4A; }
    .saa-kind.pre { background: #6D4AFF; color: #fff; }
    .saa-in { padding: 34px 14px 14px; display: flex; flex-direction: column; gap: 10px; }
    .saa-in h2 { margin: 0; font-size: 19px; }
    .saa-meta { font-size: 13.5px; color: #4A5568; line-height: 1.55; }
    .saa-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .saa-kv div { background: #F4F6FA; border-radius: 12px; padding: 8px 10px; }
    .saa-kv small { display: block; font-size: 11.5px; color: #5B6B86; font-weight: 600; }
    .saa-kv b { font-size: 14px; word-break: break-word; }
    .saa-map { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: #1D4ED8; text-decoration: none; font-size: 14px; }
    .saa-items { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; }
    .saa-it { flex: none; width: 112px; background: #F8FAFC; border-radius: 14px; overflow: hidden; font-size: 12.5px; }
    .saa-it div { height: 76px; background: #EEF2F8 center/cover no-repeat; }
    .saa-it p { margin: 6px 8px 8px; line-height: 1.35; }
    .saa-it b { display: block; color: #E2531F; }
    .saa-cats { display: flex; flex-wrap: wrap; gap: 8px; }
    .saa-cat { min-height: 40px; padding: 0 12px; border-radius: 999px; border: 1.5px solid #E2E8F0; background: #fff; font: inherit; font-weight: 700; font-size: 13.5px; color: #1B2A4A; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .saa-cat img { width: 22px; height: 22px; }
    .saa-cat[aria-pressed='true'] { border-color: #FF6B35; background: #FFF4EC; color: #C2410C; }
    .saa-cat .sug { font-size: 10.5px; background: #FFE8DC; border-radius: 6px; padding: 1px 5px; }
    .saa-row { display: flex; gap: 8px; align-items: center; }
    .saa-pct { display: inline-flex; align-items: center; gap: 4px; border: 1.5px solid #E2E8F0; border-radius: 12px; padding: 0 10px; height: 46px; background: #fff; }
    .saa-pct input { width: 46px; border: 0; outline: 0; font: inherit; font-size: 16px; font-weight: 700; text-align: right; }
    .saa-ok { flex: 1; min-height: 50px; border: 0; border-radius: 14px; background: linear-gradient(135deg,#22A06B,#1F8A5B); color: #fff; font: inherit; font-weight: 700; font-size: 16px; cursor: pointer; }
    .saa-act { flex: 1; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 14px; border: 1.5px solid #E2E7EF; background: #fff; color: #1B2A4A; font: inherit; font-weight: 700; font-size: 14px; text-decoration: none; padding: 0 10px; cursor: pointer; }
    .saa-act.danger { border-color: #FAD4D0; background: #FFF6F5; color: #B3261E; }
    .saa-act:disabled { opacity: .6; }
    .saa-no { min-height: 46px; border-radius: 14px; border: 1.5px solid #FAD4D0; background: #FFF6F5; color: #B3261E; font: inherit; font-weight: 700; padding: 0 14px; cursor: pointer; }
    .saa-ok:disabled, .saa-no:disabled { opacity: .55; }
    .saa-badge { align-self: flex-start; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
    .saa-empty { text-align: center; padding: 40px 12px; color: #5B6B86; background: #fff; border-radius: 18px; }
    .saa-tab:focus-visible, .saa-cat:focus-visible, .saa-ok:focus-visible, .saa-no:focus-visible { outline: 3px solid #FF6B35; outline-offset: 2px; }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';

    const $ = (id) => document.getElementById(id);
    const bn = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[d]);
    const toast = (m, t) => { if (window.showToast) window.showToast(m, t || 'info'); };
    function mk(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined && text !== null) e.textContent = text; return e; }
    const CAT_IMG = { food: 'food', grocery: 'grocery', pharmacy: 'pharmacy', flower: 'flower', flowers: 'flower', beauty: 'beauty', gadget: 'gadget', fashion: 'fashion', home: 'home', bakery: 'bakery', organic: 'organic', books: 'books', baby: 'baby', other: 'bags' };
    const DAYS = ['রবি', 'সোম', 'মঙ্গল', 'বুধ', 'বৃহস্পতি', 'শুক্র', 'শনি'];
    let rows = [];
    let cats = [];
    let tab = 'pending';
    let shopState = {}; // অনুমোদিত আবেদনের দোকান: id → { is_active }

    function card(a) {
      const c = mk('div', 'saa-card');
      const cv = mk('div', 'saa-cover');
      if (a.cover_url) cv.style.backgroundImage = 'url("' + encodeURI(a.cover_url) + '")';
      const lg = mk('div', 'saa-logo');
      if (a.logo_url) lg.style.backgroundImage = 'url("' + encodeURI(a.logo_url) + '")';
      cv.appendChild(lg);
      cv.appendChild(mk('span', 'saa-kind' + (a.delivery_kind === 'preorder' ? ' pre' : ''), a.delivery_kind === 'preorder' ? 'প্রি-অর্ডার' : 'এখনই ডেলিভারি'));
      c.appendChild(cv);
      const inn = mk('div', 'saa-in');
      inn.appendChild(mk('h2', '', a.name || '(নাম নেই)'));
      if (a.description) inn.appendChild(mk('div', 'saa-meta', a.description));
      if (a.sells) inn.appendChild(mk('div', 'saa-meta', '🛍️ ' + a.sells));
      const kv = mk('div', 'saa-kv');
      const add = (k, v) => { const d = mk('div'); d.appendChild(mk('small', '', k)); d.appendChild(mk('b', '', v || '—')); kv.appendChild(d); };
      add('আবেদনকারী', (a.profiles && a.profiles.full_name) || '');
      add('দোকানের ফোন', a.phone);
      add('এলাকা', [a.union_name, a.upazila].filter(Boolean).join(', '));
      add('সময়', (a.opens_at ? String(a.opens_at).slice(0, 5) : '') + ' – ' + (a.closes_at ? String(a.closes_at).slice(0, 5) : '') + (a.weekly_off !== null && a.weekly_off !== undefined ? ' · ছুটি ' + DAYS[a.weekly_off] : ''));
      add('পাওনা', (a.payout_method === 'nagad' ? 'নগদ ' : 'বিকাশ ') + (a.payout_number || ''));
      add('জমা', a.submitted_at ? new Date(a.submitted_at).toLocaleString('bn-BD', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Dhaka' }) : '');
      inn.appendChild(kv);
      if (a.address) inn.appendChild(mk('div', 'saa-meta', '📍 ' + a.address));
      if (a.lat !== null && a.lng !== null) {
        const m = mk('a', 'saa-map', '🗺️ ম্যাপে পিন দেখুন'); m.href = 'https://www.google.com/maps?q=' + Number(a.lat) + ',' + Number(a.lng); m.target = '_blank'; m.rel = 'noopener';
        inn.appendChild(m);
      }
      const items = Array.isArray(a.items) ? a.items : [];
      if (items.length) {
        const box = mk('div', 'saa-items');
        items.forEach((it) => {
          const d = mk('div', 'saa-it');
          const im = mk('div'); if (it.image_url) im.style.backgroundImage = 'url("' + encodeURI(it.image_url) + '")'; d.appendChild(im);
          const p = mk('p', '', it.name || ''); p.appendChild(mk('b', '', '৳' + bn(it.price || 0) + (it.unit ? ' / ' + it.unit : ''))); d.appendChild(p);
          box.appendChild(d);
        });
        inn.appendChild(box);
      }
      if (a.status === 'pending') {
        inn.appendChild(mk('b', '', 'ক্যাটাগরি (১–৩টা)'));
        const sel = new Set(a.suggested_category_ids || []);
        const cw = mk('div', 'saa-cats');
        cats.forEach((cat) => {
          const b = mk('button', 'saa-cat'); b.type = 'button'; b.setAttribute('aria-pressed', String(sel.has(cat.id)));
          const im = mk('img'); im.src = '/market/icons/' + (CAT_IMG[cat.icon] || CAT_IMG[cat.slug] || 'bags') + '.webp'; im.alt = ''; im.setAttribute('aria-hidden', 'true');
          b.appendChild(im); b.appendChild(document.createTextNode(cat.name + (cat.is_active ? '' : ' (বন্ধ)')));
          if ((a.suggested_category_ids || []).indexOf(cat.id) !== -1) b.appendChild(mk('span', 'sug', 'চেয়েছে'));
          b.addEventListener('click', () => {
            if (sel.has(cat.id)) sel.delete(cat.id); else { if (sel.size >= 3) { toast('সর্বোচ্চ ৩টা', 'warning'); return; } sel.add(cat.id); }
            b.setAttribute('aria-pressed', String(sel.has(cat.id)));
          });
          cw.appendChild(b);
        });
        inn.appendChild(cw);
        const row = mk('div', 'saa-row');
        const ok = mk('button', 'saa-ok', '✓ অনুমোদন · লাইভ করুন'); ok.type = 'button';
        ok.addEventListener('click', async () => {
          if (!sel.size) { toast('অন্তত ১টা ক্যাটাগরি বাছুন', 'warning'); return; }
          ok.disabled = true;
          // কমিশন ০% দিয়ে শুরু; পরে অ্যাডমিন → দোকান → % পেজ থেকে বসানো যায়
          const { data, error } = await supabase.rpc('admin_approve_shop_app', { p_id: a.id, p_category_ids: Array.from(sel), p_commission: 0 });
          ok.disabled = false;
          if (error || !data || !data.ok) { toast('অনুমোদন হয়নি: ' + ((data && data.reason) || (error && error.message) || ''), 'error'); return; }
          toast('"' + a.name + '" লাইভ হয়েছে 🎉', 'success');
          load();
        });
        row.appendChild(ok);
        inn.appendChild(row);
        const no = mk('button', 'saa-no', 'ফেরত পাঠান (কারণসহ)'); no.type = 'button';
        no.addEventListener('click', async () => {
          const why = prompt('কী ঠিক করতে হবে? (আবেদনকারী দেখবেন)');
          if (!why || why.trim().length < 3) return;
          no.disabled = true;
          const { data, error } = await supabase.rpc('admin_reject_shop_app', { p_id: a.id, p_reason: why.trim() });
          no.disabled = false;
          if (error || !data || !data.ok) { toast('হয়নি', 'error'); return; }
          toast('ফেরত পাঠানো হয়েছে', 'success'); load();
        });
        inn.appendChild(no);
      } else if (a.status === 'rejected') {
        const b = mk('span', 'saa-badge', 'ফেরত: ' + (a.reject_reason || '')); b.style.cssText += 'background:#FDECEA;color:#A3261B;'; inn.appendChild(b);
      } else if (a.status === 'approved') {
        const st = a.shop_id ? shopState[a.shop_id] : null;
        const b = mk('span', 'saa-badge', !st ? 'দোকান মুছে ফেলা হয়েছে' : st.is_active ? '✓ লাইভ' : '🙈 লুকানো আছে');
        b.style.cssText += !st ? 'background:#F1F3F7;color:#5B6B86;' : st.is_active ? 'background:#E6F6EE;color:#17663F;' : 'background:#FFF4E5;color:#7A3E00;';
        inn.appendChild(b);
        if (st) {
          const row = mk('div', 'saa-row');
          const ed = mk('a', 'saa-act', '✏️ এডিট'); ed.href = '/admin/delivery-shops?edit=' + encodeURIComponent(a.shop_id);
          row.appendChild(ed);
          const hd = mk('button', 'saa-act', st.is_active ? '🙈 লুকান' : '👁 আবার চালু'); hd.type = 'button';
          hd.addEventListener('click', async () => {
            hd.disabled = true;
            const { error } = await supabase.from('delivery_shops').update({ is_active: !st.is_active }).eq('id', a.shop_id);
            hd.disabled = false;
            if (error) { toast('বদলানো যায়নি: ' + error.message, 'error'); return; }
            toast(st.is_active ? 'দোকান লুকানো হয়েছে, কাস্টমার দেখবে না' : 'দোকান আবার লাইভ', 'success');
            load();
          });
          row.appendChild(hd);
          const del = mk('button', 'saa-act danger', '🗑 ডিলিট'); del.type = 'button';
          del.addEventListener('click', async () => {
            if (!confirm('"' + (a.name || '') + '" দোকান ও এর সব আইটেম ডিলিট করবেন? এটা ফেরানো যাবে না। শুধু সাময়িক বন্ধ রাখতে "লুকান" ব্যবহার করুন।')) return;
            del.disabled = true;
            const { error } = await supabase.from('delivery_shops').delete().eq('id', a.shop_id);
            del.disabled = false;
            if (error) { toast('ডিলিট হয়নি: ' + error.message, 'error'); return; }
            toast('দোকান ডিলিট হয়েছে', 'success');
            load();
          });
          row.appendChild(del);
          inn.appendChild(row);
        }
      }
      c.appendChild(inn);
      return c;
    }

    function render() {
      $('cPending').textContent = bn(rows.filter((r) => r.status === 'pending').length);
      const box = $('saaList'); box.textContent = '';
      const list = rows.filter((r) => r.status === tab);
      if (!list.length) { box.appendChild(mk('div', 'saa-empty', tab === 'pending' ? 'নতুন কোনো আবেদন নেই।' : 'কিছু নেই।')); return; }
      list.forEach((a) => box.appendChild(card(a)));
    }

    async function load() {
      const box = $('saaList');
      if (!rows.length && window.SFLoader) box.innerHTML = window.SFLoader.block('লোড হচ্ছে…');
      const [r, c] = await Promise.all([
        supabase.from('market_shop_applications').select('*, profiles!market_shop_applications_applicant_id_fkey(full_name)').neq('status', 'draft').order('submitted_at', { ascending: false }).limit(200),
        cats.length ? Promise.resolve({ data: cats }) : supabase.from('delivery_market_categories').select('id, slug, name, icon, is_active, sort_order').order('sort_order'),
      ]);
      if (r.error) {
        const r2 = await supabase.from('market_shop_applications').select('*').neq('status', 'draft').order('submitted_at', { ascending: false }).limit(200);
        rows = r2.data || [];
      } else rows = r.data || [];
      cats = c.data || [];
      const ids = rows.filter((x) => x.status === 'approved' && x.shop_id).map((x) => x.shop_id);
      shopState = {};
      if (ids.length) {
        const { data: sd } = await supabase.from('delivery_shops').select('id, is_active').in('id', ids);
        (sd || []).forEach((s) => { shopState[s.id] = s; });
      }
      render();
    }

    document.querySelectorAll('.saa-tab').forEach((b) => b.addEventListener('click', () => {
      tab = b.dataset.t;
      document.querySelectorAll('.saa-tab').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      render();
    }));
    let started = false;
    window.addEventListener('smartfeni:admin-ready', () => { if (started) return; started = true; load(); });
    initAdminGuard();
  </script>
</BaseLayout>
