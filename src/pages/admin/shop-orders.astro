---
// ============================================================
// পেজ: অ্যাডমিন — শপ অর্ডার ট্র্যাকিং (শুধু দেখা) (/admin/shop-orders)
// চলমান (pending/confirmed) / সম্পন্ন (delivered) / বাতিল (cancelled) সব অর্ডারের ডিটেইলস।
// ডিফল্ট: শেষ ৩০ দিন; ক্যালেন্ডারে দিন বা রেঞ্জ ট্যাপ করলে সেই সময়ের অর্ডার।
// ডেটা: সরাসরি orders query (RLS-এ shops.view পারমিশনে অ্যাডমিন/স্টাফ পড়তে পারে)।
// কোনো অ্যাকশন বাটন নেই। ইউজারের লেখা সব textContent দিয়ে বসানো।
// স্টাইল is:global, ক্লাব vw- দিয়ে শুরু।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="শপ অর্ডার | অ্যাডমিন">
  <div class="vw-page">
    <div class="container">

      <div id="adminLoadingState" class="vw-loading">
        <div class="vw-spin"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" style="display:none;">
        <a href="/admin" class="vw-back"><i class="fas fa-arrow-left"></i> ড্যাশবোর্ড</a>
        <h1 class="vw-h1">🛍️ শপ অর্ডার</h1>
        <p class="vw-sub" id="vwSub">লোড হচ্ছে...</p>

        <button type="button" class="vw-calbtn" id="vwCalToggle">📅 ক্যালেন্ডার (দিন বাছুন)</button>
        <div id="vwCal" style="display:none;"></div>

        <div class="vw-tabs" id="vwTabs"></div>
        <div id="vwList"></div>
      </div>

    </div>
  </div>

  <style is:global>
    .vw-page { min-height: 60vh; padding: 24px 0 90px; font-family: "Hind Siliguri", system-ui, sans-serif; color: #1B2A4A; }
    .vw-loading { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 120px 0; color: #5A6E85; font-weight: 600; }
    .vw-spin { width: 36px; height: 36px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: vwspin .8s linear infinite; }
    @keyframes vwspin { to { transform: rotate(360deg); } }
    .vw-back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #5A6E85; text-decoration: none; font-weight: 600; font-size: .9rem; }
    .vw-h1 { font-size: 1.5rem; font-weight: 700; margin: 4px 0 2px; }
    .vw-sub { font-size: .85rem; color: #8FA0BC; font-weight: 600; margin: 0 0 12px; }
    .vw-calbtn { width: 100%; min-height: 48px; border: 0; border-radius: 16px; background: #fff; box-shadow: 0 2px 12px rgba(27,42,74,.08); color: #1B2A4A; font-weight: 700; font-size: .95rem; font-family: inherit; cursor: pointer; margin-bottom: 12px; }
    .vw-tabs { display: flex; gap: 8px; margin: 4px 0 14px; overflow-x: auto; }
    .vw-tab { flex: 1 0 auto; min-height: 44px; padding: 0 14px; border: 0; border-radius: 14px; background: #fff; box-shadow: 0 1px 6px rgba(27,42,74,.08); color: #5A6E85; font-weight: 700; font-size: .9rem; font-family: inherit; cursor: pointer; white-space: nowrap; }
    .vw-tab.on { background: #1B2A4A; color: #fff; }
    .vw-empty { text-align: center; color: #8FA0BC; font-weight: 600; padding: 48px 0; }
    .vw-card { background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(27,42,74,.08); padding: 14px; margin-bottom: 12px; }
    .vw-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .vw-main { flex: 1; min-width: 0; }
    .vw-name { font-weight: 700; font-size: .98rem; }
    .vw-meta { font-size: .8rem; color: #5A6E85; font-weight: 600; margin-top: 2px; word-break: break-word; }
    .vw-badge { font-size: .72rem; font-weight: 800; padding: 4px 10px; border-radius: 20px; flex: none; }
    .vw-badge.pending { background: #FFF0E8; color: #FF6B35; }
    .vw-badge.confirmed { background: #E8F1FD; color: #2563EB; }
    .vw-badge.delivered { background: #E7F7EE; color: #16A34A; }
    .vw-badge.cancelled { background: #FDECEC; color: #D14343; }
    .vw-tel { color: #FF6B35; font-weight: 700; text-decoration: none; }
    .vw-items { margin-top: 10px; border-top: 1px solid #EEF1F6; padding-top: 8px; }
    .vw-it { display: flex; justify-content: space-between; gap: 8px; padding: 4px 0; font-size: .88rem; }
    .vw-it span:last-child { font-weight: 700; flex: none; }
    .vw-total { display: flex; justify-content: space-between; margin-top: 6px; padding-top: 8px; border-top: 1px dashed #E5EAF0; font-weight: 800; }
    .vw-cancel { margin-top: 10px; background: #FDECEC; color: #B42318; border-radius: 12px; padding: 8px 10px; font-size: .84rem; font-weight: 600; word-break: break-word; }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { createRangeCalendar, dhakaRangeIso, monthRangeIso, dayKeyOf, todayKey, addDaysKey, labelKey } from '../../lib/adminCalendar.js';

    const $ = (id) => document.getElementById(id);
    const bn = (v) => String(v).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
    const TABS = [
      { k: 'running', l: 'চলমান' },
      { k: 'done', l: 'সম্পন্ন' },
      { k: 'cancelled', l: 'বাতিল' },
    ];
    const STATUS_LABEL = { pending: 'নতুন', confirmed: 'কনফার্মড', delivered: 'সম্পন্ন', cancelled: 'বাতিল' };
    const BY_LABEL = { customer: 'কাস্টমার', shop: 'শপ', admin: 'অ্যাডমিন' };

    const state = { from: '', to: '', tab: 'running', rows: [] };
    let cal = null;
    let listToken = 0;
    let monthToken = 0;

    function el(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    }

    function groupOf(status) {
      if (status === 'delivered') return 'done';
      if (status === 'cancelled') return 'cancelled';
      return 'running';
    }

    function fmtTime(iso) {
      if (!iso) return '';
      return bn(new Date(iso).toLocaleString('en-GB', {
        timeZone: 'Asia/Dhaka', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', hour12: true,
      }));
    }

    // দাম টেক্সট ("340৳", "২৫০") থেকে সংখ্যা; না পারলে null
    function priceNum(p) {
      const s = String(p == null ? '' : p)
        .replace(/[০-৯]/g, (d) => '০১২৩৪৫৬৭৮৯'.indexOf(d))
        .replace(/[^\d.]/g, '');
      const n = parseFloat(s);
      return Number.isFinite(n) ? n : null;
    }

    function currentRange() {
      if (state.from) return dhakaRangeIso(state.from, state.to);
      const t = todayKey();
      return dhakaRangeIso(addDaysKey(t, -29), t);
    }

    function rangeLabel() {
      if (!state.from) return 'শেষ ৩০ দিন';
      return state.from === state.to ? labelKey(state.from) : labelKey(state.from) + ' – ' + labelKey(state.to);
    }

    function paintToggle() {
      const open = $('vwCal').style.display !== 'none';
      $('vwCalToggle').textContent = open
        ? '▲ ক্যালেন্ডার ভাঁজ করুন'
        : '📅 ক্যালেন্ডার' + (state.from ? ' · ' + rangeLabel() : ' (দিন বাছুন)');
    }

    function renderTabs() {
      const box = $('vwTabs');
      box.replaceChildren();
      TABS.forEach((t) => {
        const n = state.rows.filter((r) => groupOf(r.status) === t.k).length;
        const b = el('button', 'vw-tab' + (state.tab === t.k ? ' on' : ''), t.l + ' (' + bn(n) + ')');
        b.type = 'button';
        b.addEventListener('click', () => { state.tab = t.k; renderTabs(); renderList(); });
        box.appendChild(b);
      });
    }

    function card(r) {
      const c = el('div', 'vw-card');
      const row = el('div', 'vw-row');
      const main = el('div', 'vw-main');
      const shop = r.shops || {};
      main.appendChild(el('div', 'vw-name', '🏪 ' + (shop.name || 'শপ')));
      const cust = el('div', 'vw-meta');
      cust.appendChild(document.createTextNode('কাস্টমার: ' + (r.customer_name || '—') + ' · '));
      const a = el('a', 'vw-tel', bn(r.customer_phone || ''));
      a.href = 'tel:' + String(r.customer_phone || '').replace(/[^\d+]/g, '');
      cust.appendChild(a);
      main.appendChild(cust);
      if (r.customer_address) main.appendChild(el('div', 'vw-meta', '📍 ' + r.customer_address));
      main.appendChild(el('div', 'vw-meta', 'অর্ডার: ' + fmtTime(r.created_at)));
      row.appendChild(main);
      row.appendChild(el('span', 'vw-badge ' + (r.status || ''), STATUS_LABEL[r.status] || r.status || ''));
      c.appendChild(row);

      const items = Array.isArray(r.order_items) ? r.order_items : [];
      if (items.length) {
        const box = el('div', 'vw-items');
        let total = 0;
        let ok = true;
        items.forEach((it) => {
          const q = it.quantity || 1;
          const p = priceNum(it.price);
          if (p == null) ok = false; else total += p * q;
          const line = el('div', 'vw-it');
          line.appendChild(el('span', '', (it.title || 'আইটেম') + ' × ' + bn(q)));
          line.appendChild(el('span', '', p == null ? String(it.price || '') : '৳' + bn(p * q)));
          box.appendChild(line);
        });
        if (ok) {
          const t = el('div', 'vw-total');
          t.appendChild(el('span', '', 'মোট'));
          t.appendChild(el('span', '', '৳' + bn(total)));
          box.appendChild(t);
        }
        c.appendChild(box);
      }

      if (r.status === 'cancelled') {
        const by = BY_LABEL[r.cancelled_by] || r.cancelled_by || '';
        const txt = 'বাতিল' + (by ? ' (' + by + ')' : '') + (r.cancelled_at ? ' · ' + fmtTime(r.cancelled_at) : '')
          + (r.cancel_reason ? ' — ' + r.cancel_reason : '');
        c.appendChild(el('div', 'vw-cancel', txt));
      }
      return c;
    }

    function renderList() {
      const box = $('vwList');
      box.replaceChildren();
      const rows = state.rows.filter((r) => groupOf(r.status) === state.tab);
      if (!rows.length) {
        box.appendChild(el('div', 'vw-empty', 'এই সময়ে কোনো অর্ডার নেই'));
        return;
      }
      rows.forEach((r) => box.appendChild(card(r)));
    }

    async function loadList() {
      const token = ++listToken;
      $('vwSub').textContent = rangeLabel() + ' · লোড হচ্ছে...';
      const r = currentRange();
      const { data, error } = await supabase
        .from('orders')
        .select('id, status, created_at, customer_name, customer_phone, customer_address, cancelled_by, cancelled_at, cancel_reason, shops(name), order_items(title, price, quantity)')
        .gte('created_at', r.fromIso)
        .lt('created_at', r.toIso)
        .order('created_at', { ascending: false })
        .limit(500);
      if (token !== listToken) return;
      if (error) {
        $('vwSub').textContent = 'লোড করা যায়নি';
        if (window.showToast) window.showToast('অর্ডার লোড করা যায়নি', 'error');
        return;
      }
      state.rows = Array.isArray(data) ? data : [];
      $('vwSub').textContent = rangeLabel() + ' · মোট ' + bn(state.rows.length) + 'টি অর্ডার';
      renderTabs();
      renderList();
    }

    async function loadCalMonth() {
      if (!cal) return;
      const token = ++monthToken;
      const m = cal.getMonth();
      const r = monthRangeIso(m.y, m.m);
      const { data, error } = await supabase
        .from('orders')
        .select('created_at')
        .gte('created_at', r.fromIso)
        .lt('created_at', r.toIso)
        .limit(1000);
      if (token !== monthToken || !cal) return;
      const map = {};
      if (!error && Array.isArray(data)) {
        data.forEach((x) => {
          const k = dayKeyOf(new Date(x.created_at));
          map[k] = (map[k] || 0) + 1;
        });
      }
      cal.setCounts(map);
    }

    function init() {
      $('vwCalToggle').addEventListener('click', () => {
        const c = $('vwCal');
        c.style.display = c.style.display === 'none' ? '' : 'none';
        paintToggle();
      });
      cal = createRangeCalendar($('vwCal'), {
        unit: 'অর্ডার',
        onMonthChange: () => { loadCalMonth(); },
        onRangeChange: (from, to) => {
          state.from = from || '';
          state.to = to || '';
          paintToggle();
          loadList();
        },
      });
      paintToggle();
      loadCalMonth();
      loadList();
    }

    window.addEventListener('smartfeni:admin-ready', init, { once: true });
    initAdminGuard();
  </script>
</BaseLayout>
