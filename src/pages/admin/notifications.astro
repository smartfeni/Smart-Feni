<!-- path: src/pages/admin/notifications.astro -->
---
// ============================================================
// পেজ: অ্যাডমিন — কাস্টম নোটিফিকেশন পাঠানো (/admin/notifications)
// user_notifications টেবিলে ইনসার্ট করে — নির্দিষ্ট ইউজার (ফোন
// নাম্বার সার্চ করে) অথবা সবাইকে ব্রডকাস্ট। প্রতিটা পাঠানোর একটা
// লগ admin_notification_log এ থাকে (কতজনকে, কী মেসেজ, কবে)।
//
// আপডেট (Phase 5 — Push সিস্টেম ইন্টিগ্রেশন):
// - Category selector যোগ (সাধারণ মেসেজ / অফার-প্রমো) — এর আগে
//   category সেট হতো না (ডিফল্ট 'system' বসে যেত), ফলে ইউজারের
//   notification_preferences টগল respect হতো না। এখন সঠিক category
//   সেট হওয়ায় ইউজার প্রোফাইল সেটিংস থেকে অফ করলে push স্কিপ হবে।
// - sender_type: 'admin', sender_id: adminUser.id যোগ — কে পাঠালো
//   এখন ট্র্যাক হবে।
// - Broadcast এ ৫০০ জন করে ব্যাচে insert (আগে একবারে সব, বড়
//   ইউজারবেসে Supabase connection limit এ সমস্যা হতে পারত)
// - admin_notification_log এ category কলাম যোগ হয়েছে (migration)
//
// নোট: push পাঠানো dispatch_pending_push_notifications() cron
// (প্রতি মিনিটে) নিজে থেকেই handle করে — এখানে আলাদা কিছু করা
// লাগে না, শুধু সঠিক category সহ user_notifications এ insert
// করলেই যথেষ্ট।
//
// আপডেট (এই সেশন):
// - "লিংক করা আইটেম" সার্চ যোগ (শপ/ক্লাব/লিস্টিং, নাম দিয়ে) —
//   সিলেক্ট করলে link_label + action_url সেভ হয়, নোটিফিকেশনে
//   সেই নামটাই ক্লিকযোগ্য বাটন হয়ে সরাসরি সেই পেজে নিয়ে যায়
// - admin_notification_log এ link_label/action_url কলাম যোগ
//   (migration) — হিস্ট্রি লগেও কোন আইটেম লিংক করা ছিল দেখা যায়
// - .log-item-image ফিক্সড height + প্লেসহোল্ডার bg (আগে max-height
//   ছিল, স্লো নেটওয়ার্কে ছবি লোড হওয়ার সময় কার্ডের এলাইনমেন্ট
//   জাম্প করত)
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="নোটিফিকেশন পাঠান | অ্যাডমিন">
  <div class="admin-page">
    <div class="container">

      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i> ড্যাশবোর্ড</a>

        <div class="admin-header">
          <h1>নোটিফিকেশন পাঠান</h1>
          <p class="admin-subtitle">নির্দিষ্ট ইউজারকে অথবা সবাইকে কাস্টম মেসেজ পাঠান</p>
        </div>

        <div class="compose-card">
          <div class="target-tabs">
            <button class="target-tab active" data-target="single" type="button">নির্দিষ্ট ইউজার</button>
            <button class="target-tab" data-target="broadcast" type="button">সবাইকে (ব্রডকাস্ট)</button>
          </div>

          <!-- নির্দিষ্ট ইউজার সার্চ -->
          <div id="singleTargetPanel" class="target-panel">
            <label class="field-label">ফোন নাম্বার দিয়ে ইউজার খুঁজুন</label>
            <div class="search-row">
              <input type="text" id="userSearchInput" placeholder="01xxxxxxxxx" />
              <button id="userSearchBtn" type="button">খুঁজুন</button>
            </div>
            <div id="userSearchResult" class="user-search-result"></div>
          </div>

          <!-- ব্রডকাস্ট কনফার্মেশন -->
          <div id="broadcastTargetPanel" class="target-panel" style="display:none;">
            <p class="broadcast-note">
              <i class="fas fa-triangle-exclamation"></i>
              এই মেসেজ <strong>সব রেজিস্টার্ড ইউজারের</strong> কাছে যাবে। সতর্কতার সাথে ব্যবহার করুন।
            </p>
          </div>

          <!-- ক্যাটাগরি সিলেক্টর (নতুন) -->
          <label class="field-label">নোটিফিকেশনের ধরন</label>
          <div class="category-tabs">
            <button class="category-tab active" data-category="message" type="button">
              <i class="fas fa-comment"></i> সাধারণ মেসেজ
            </button>
            <button class="category-tab" data-category="promo" type="button">
              <i class="fas fa-tags"></i> অফার-প্রমো
            </button>
          </div>
          <p class="category-hint" id="categoryHint">ইউজার প্রোফাইল সেটিংসে "মেসেজ" নোটিফিকেশন অফ করলে এটা পাবে না</p>

          <label class="field-label" style="margin-top: 14px;">মেসেজ</label>
          <textarea id="messageInput" rows="4" placeholder="মেসেজ লিখুন..."></textarea>

          <!-- ছবি আপলোড (ঐচ্ছিক, নতুন — Phase 2) -->
          <label class="field-label" style="margin-top: 14px;">ছবি (ঐচ্ছিক)</label>
          <label for="imageInput" class="image-upload-box" id="imageUploadBox">
            <img id="imagePreview" src="" alt="প্রিভিউ" style="display:none;" />
            <span id="imageUploadPlaceholder"><i class="fas fa-image"></i> ছবি যোগ করুন (সর্বোচ্চ ২MB)</span>
            <button type="button" id="imageRemoveBtn" style="display:none;" aria-label="ছবি সরান">
              <i class="fas fa-xmark"></i>
            </button>
          </label>
          <input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp" style="display:none;" />
          <p class="send-feedback" id="imageFeedback"></p>

          <!-- লিংক করা আইটেম (ঐচ্ছিক, নতুন) — নির্দিষ্ট শপ/ক্লাব/
               লিস্টিং সার্চ করে সিলেক্ট করলে সেই নামটাই নোটিফিকেশনে
               ক্লিকযোগ্য বাটন হয়ে যাবে, সরাসরি সেই পেজে নিয়ে যাবে -->
          <label class="field-label" style="margin-top: 14px;">লিংক করা আইটেম (ঐচ্ছিক)</label>
          <div class="search-row">
            <input type="text" id="linkSearchInput" placeholder="শপ/ক্লাব/লিস্টিং এর নাম লিখুন..." />
            <button id="linkSearchBtn" type="button">খুঁজুন</button>
          </div>
          <div id="linkSearchResult" class="link-search-result"></div>
          <div class="selected-link-chip" id="selectedLinkChip">
            <span id="selectedLinkLabel"></span>
            <button type="button" id="selectedLinkRemoveBtn" aria-label="সরান"><i class="fas fa-xmark"></i></button>
          </div>

          <p class="send-feedback" id="sendFeedback"></p>

          <button id="sendBtn" class="send-btn" type="button" disabled>
            <i class="fas fa-paper-plane"></i> পাঠান
          </button>
        </div>

        <div class="log-section">
          <h2>সাম্প্রতিক পাঠানো</h2>
          <div id="logContainer" class="log-container"></div>
          <div id="logEmptyState" class="empty-state" style="display:none;">
            <i class="fas fa-inbox"></i>
            <p>এখনো কোনো নোটিফিকেশন পাঠানো হয়নি</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <style is:global>
    .admin-page {
      min-height: 60vh;
      padding: 32px 0 80px;
    }

    .admin-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .admin-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #5A6E85;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .back-link:hover {
      color: #FF6B35;
    }

    .admin-header {
      margin-bottom: 20px;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .admin-subtitle {
      font-size: 0.85rem;
      color: #8FA0BC;
      margin-top: 4px;
      font-weight: 600;
    }

    .compose-card {
      background: #fff;
      border-radius: 18px;
      padding: 22px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
      margin-bottom: 32px;
    }

    .target-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      background: #F4F7FC;
      border-radius: 40px;
      padding: 4px;
    }

    .target-tab {
      flex: 1;
      border: none;
      background: transparent;
      padding: 10px 12px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.85rem;
      color: #5A6E85;
      cursor: pointer;
    }

    .target-tab.active {
      background: #1B2A4A;
      color: #fff;
    }

    .target-panel {
      margin-bottom: 16px;
    }

    /* ===== ক্যাটাগরি ট্যাব (নতুন) ===== */
    .category-tabs {
      display: flex;
      gap: 8px;
    }

    .category-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 1.5px solid #E5EAF0;
      background: #fff;
      padding: 10px 12px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.82rem;
      color: #5A6E85;
      cursor: pointer;
    }

    .category-tab.active {
      border-color: #FF6B35;
      background: #FFF0EA;
      color: #FF6B35;
    }

    .category-hint {
      font-size: 0.74rem;
      color: #9AA8BC;
      margin-top: 6px;
    }

    .field-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: #5A6E85;
      margin-bottom: 6px;
    }

    .search-row {
      display: flex;
      gap: 8px;
    }

    .search-row input {
      flex: 1;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.88rem;
      font-family: inherit;
    }

    .search-row button {
      background: #1B2A4A;
      color: #fff;
      border: none;
      padding: 0 18px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .user-search-result {
      margin-top: 10px;
    }

    .user-result-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 14px;
      background: #F8FAFC;
      border-radius: 12px;
      margin-bottom: 6px;
      cursor: pointer;
      border: 2px solid transparent;
    }

    .user-result-item.selected {
      border-color: #FF6B35;
      background: #FFF0EA;
    }

    .user-result-name {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .user-result-phone {
      font-size: 0.78rem;
      color: #8FA0BC;
    }

    .no-user-found {
      font-size: 0.82rem;
      color: #D14343;
      padding: 8px 4px;
    }

    .broadcast-note {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      background: #FFF3E0;
      color: #B36B00;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 12px 14px;
      border-radius: 12px;
      line-height: 1.5;
    }

    #messageInput {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.88rem;
      font-family: inherit;
      resize: vertical;
      margin-bottom: 6px;
    }

    /* ===== ছবি আপলোড বক্স (নতুন) ===== */
    .image-upload-box {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 90px;
      border: 1.5px dashed #D7E0EC;
      border-radius: 14px;
      cursor: pointer;
      overflow: hidden;
      background: #F8FAFC;
      margin-bottom: 6px;
      transition: border-color 0.2s ease;
    }

    .image-upload-box:hover {
      border-color: #FF6B35;
    }

    .image-upload-box img {
      width: 100%;
      max-height: 180px;
      object-fit: cover;
      display: none;
    }

    .image-upload-box span {
      font-size: 0.82rem;
      color: #9AA8BC;
      font-weight: 600;
      padding: 20px;
      text-align: center;
    }

    .image-upload-box span i {
      display: block;
      font-size: 1.3rem;
      margin-bottom: 6px;
    }

    .image-upload-box button {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: none;
      background: rgba(15, 23, 42, 0.6);
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .send-feedback {
      font-size: 0.82rem;
      font-weight: 700;
      margin: 6px 0;
      display: none;
    }

    .send-feedback.error {
      display: block;
      color: #D14343;
    }

    .send-feedback.success {
      display: block;
      color: #1B7A3C;
    }

    .send-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      margin-top: 10px;
    }

    .send-btn:disabled {
      background: #D7E0EC;
      cursor: not-allowed;
    }

    .log-section h2 {
      font-size: 1.1rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
    }

    .log-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .log-item {
      background: #fff;
      border-radius: 14px;
      padding: 14px 16px;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
    }

    .log-item-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 6px;
    }

    .log-item-badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .log-item-badge {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      white-space: nowrap;
    }

    .log-item-badge.single {
      background: #E8F2FF;
      color: #1D6FE0;
    }

    .log-item-badge.broadcast {
      background: #FFF0EA;
      color: #FF6B35;
    }

    .log-item-badge.category-message {
      background: #F1F4F8;
      color: #5A6E85;
    }

    .log-item-badge.category-promo {
      background: #FDF0D5;
      color: #B36B00;
    }

    .log-item-msg {
      font-size: 0.85rem;
      color: #1B2A4A;
      line-height: 1.5;
      white-space: pre-line;
    }

    /* নোট: max-height এর বদলে ফিক্সড height + হালকা প্লেসহোল্ডার
       ব্যাকগ্রাউন্ড — ছবি লোড হওয়ার আগেই জায়গা রিজার্ভ থাকে, স্লো
       নেটওয়ার্কে ছবি লোড হওয়ার সময় কার্ডের এলাইনমেন্ট/লেআউট আর
       জাম্প করবে না */
    .log-item-image {
      display: block;
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-radius: 10px;
      margin-bottom: 8px;
      background: #F1F4F8;
    }

    /* ===== লিংক করা আইটেম (নতুন — শপ/ক্লাব/লিস্টিং সার্চ) ===== */
    .link-search-result {
      margin-top: 10px;
      max-height: 260px;
      overflow-y: auto;
    }

    .link-result-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      background: #F8FAFC;
      border-radius: 12px;
      margin-bottom: 6px;
      cursor: pointer;
      border: 2px solid transparent;
    }

    .link-result-item:hover {
      border-color: #E5EAF0;
    }

    .link-result-thumb {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      object-fit: cover;
      background: #E5EAF0;
      flex-shrink: 0;
    }

    .link-result-info {
      flex: 1;
      min-width: 0;
    }

    .link-result-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .link-result-sub {
      font-size: 0.72rem;
      color: #8FA0BC;
    }

    .link-result-type {
      font-size: 0.66rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      background: #E8F2FF;
      color: #1D6FE0;
      white-space: nowrap;
    }

    .link-result-type.club {
      background: #F0E8FF;
      color: #7B3FE0;
    }

    .link-result-type.listing {
      background: #FFF0EA;
      color: #FF6B35;
    }

    .selected-link-chip {
      display: none;
      align-items: center;
      gap: 8px;
      background: #FFF0EA;
      border: 1.5px solid #FF6B35;
      border-radius: 12px;
      padding: 8px 12px;
      margin-top: 10px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .selected-link-chip.show {
      display: flex;
    }

    .selected-link-chip span {
      flex: 1;
    }

    .selected-link-chip button {
      border: none;
      background: none;
      color: #FF6B35;
      cursor: pointer;
      font-size: 0.9rem;
    }

    .log-item-link-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.72rem;
      font-weight: 700;
      color: #1D6FE0;
      margin-top: 6px;
    }

    .log-item-meta {
      font-size: 0.75rem;
      color: #8FA0BC;
      margin-top: 8px;
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 60px 0;
      color: #B0BCCB;
    }

    .empty-state i {
      font-size: 2rem;
    }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { compressImage } from '../../lib/imageCompress.js';

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str ?? '';
      return div.innerHTML;
    }

    function formatDate(iso) {
      const d = new Date(iso);
      return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    // ============================================================
    // টার্গেট ট্যাব সুইচিং
    // ============================================================
    const targetTabs = document.querySelectorAll('.target-tab');
    const singlePanel = document.getElementById('singleTargetPanel');
    const broadcastPanel = document.getElementById('broadcastTargetPanel');

    let currentTarget = 'single';
    let selectedUser = null; // { id, full_name, phone }

    targetTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        targetTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentTarget = tab.dataset.target;
        singlePanel.style.display = currentTarget === 'single' ? 'block' : 'none';
        broadcastPanel.style.display = currentTarget === 'broadcast' ? 'block' : 'none';
        updateSendBtnState();
      });
    });

    // ============================================================
    // ক্যাটাগরি ট্যাব সুইচিং (নতুন)
    // ============================================================
    const categoryTabs = document.querySelectorAll('.category-tab');
    const categoryHint = document.getElementById('categoryHint');
    let currentCategory = 'message';

    const categoryHints = {
      message: 'ইউজার প্রোফাইল সেটিংসে "মেসেজ" নোটিফিকেশন অফ করলে এটা পাবে না',
      promo: 'ইউজার প্রোফাইল সেটিংসে "অফার ও প্রমো" নোটিফিকেশন অফ করলে এটা পাবে না',
    };

    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentCategory = tab.dataset.category;
        categoryHint.textContent = categoryHints[currentCategory];
      });
    });

    // ============================================================
    // ইউজার সার্চ (ফোন নাম্বার দিয়ে)
    // ============================================================
    const userSearchInput = document.getElementById('userSearchInput');
    const userSearchBtn = document.getElementById('userSearchBtn');
    const userSearchResult = document.getElementById('userSearchResult');

    async function searchUser() {
      const phone = userSearchInput.value.trim();
      if (!phone) return;

      userSearchResult.innerHTML = '<p style="font-size:0.82rem;color:#8FA0BC;">খোঁজা হচ্ছে...</p>';
      selectedUser = null;
      updateSendBtnState();

      const { data, error } = await supabase
        .from('profiles')
        .select('id, full_name, phone')
        .ilike('phone', `%${phone}%`)
        .limit(5);

      if (error || !data || data.length === 0) {
        userSearchResult.innerHTML = '<p class="no-user-found">কোনো ইউজার পাওয়া যায়নি</p>';
        return;
      }

      userSearchResult.innerHTML = '';
      data.forEach((u) => {
        const item = document.createElement('div');
        item.className = 'user-result-item';
        item.innerHTML = `
          <div>
            <div class="user-result-name">${escapeHtml(u.full_name || '(নাম নাই)')}</div>
            <div class="user-result-phone">${escapeHtml(u.phone || '')}</div>
          </div>
          <i class="fas fa-circle-check" style="color:#D7E0EC;"></i>
        `;
        item.addEventListener('click', () => {
          document.querySelectorAll('.user-result-item').forEach((el) => el.classList.remove('selected'));
          item.classList.add('selected');
          selectedUser = u;
          updateSendBtnState();
        });
        userSearchResult.appendChild(item);
      });
    }

    userSearchBtn.addEventListener('click', searchUser);
    userSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchUser();
    });

    // ============================================================
    // লিংক করা আইটেম সার্চ (নতুন) — শপ/ক্লাব/লিস্টিং, একসাথে
    // নাম দিয়ে সার্চ করে ক্লিকযোগ্য বাটনের জন্য নির্দিষ্ট আইটেম
    // সিলেক্ট করা যায়
    // ============================================================
    const linkSearchInput = document.getElementById('linkSearchInput');
    const linkSearchBtn = document.getElementById('linkSearchBtn');
    const linkSearchResult = document.getElementById('linkSearchResult');
    const selectedLinkChip = document.getElementById('selectedLinkChip');
    const selectedLinkLabel = document.getElementById('selectedLinkLabel');
    const selectedLinkRemoveBtn = document.getElementById('selectedLinkRemoveBtn');

    let selectedLink = null; // { label, url }

    const linkTypeLabels = { shop: 'শপ', club: 'ক্লাব', listing: 'লিস্টিং' };

    function showSelectedLink() {
      if (!selectedLink) {
        selectedLinkChip.classList.remove('show');
        return;
      }
      selectedLinkLabel.textContent = `🔗 ${selectedLink.label}`;
      selectedLinkChip.classList.add('show');
    }

    async function searchLinkItems() {
      const q = linkSearchInput.value.trim();
      if (!q) return;

      linkSearchResult.innerHTML = '<p style="font-size:0.82rem;color:#8FA0BC;">খোঁজা হচ্ছে...</p>';

      const [{ data: shops }, { data: clubs }, { data: listings }] = await Promise.all([
        supabase.from('shops').select('id, name, slug, logo_image, upazila').ilike('name', `%${q}%`).limit(6),
        supabase.from('clubs').select('id, name, slug, logo_image, upajila').ilike('name', `%${q}%`).limit(6),
        supabase.from('listings').select('id, title, category, images, upazila').ilike('title', `%${q}%`).limit(8),
      ]);

      const results = [
        ...(shops || []).map((s) => ({
          type: 'shop',
          label: s.name,
          url: `/${s.slug}`,
          image: s.logo_image || '',
          sub: s.upazila || 'শপ',
        })),
        ...(clubs || []).map((c) => ({
          type: 'club',
          label: c.name,
          url: `/${c.slug}`,
          image: c.logo_image || '',
          sub: c.upajila || 'ক্লাব',
        })),
        ...(listings || []).map((l) => ({
          type: 'listing',
          label: l.title,
          // অনলাইন-শপ ক্যাটাগরির লিস্টিং (শপের নির্দিষ্ট প্রোডাক্ট) এর
          // পাবলিক পেজ /product/{id}, বাকি সব ক্যাটাগরির জন্য
          // /listing/{id}
          url: l.category === 'online-shop' ? `/product/${l.id}` : `/listing/${l.id}`,
          image: (l.images && l.images[0]) || '',
          sub: `${l.category || ''}${l.upazila ? ' · ' + l.upazila : ''}`,
        })),
      ];

      if (results.length === 0) {
        linkSearchResult.innerHTML = '<p class="no-user-found">কিছু পাওয়া যায়নি</p>';
        return;
      }

      linkSearchResult.innerHTML = '';
      results.forEach((r) => {
        const item = document.createElement('div');
        item.className = 'link-result-item';
        item.innerHTML = `
          ${r.image ? `<img src="${r.image}" alt="" class="link-result-thumb" />` : '<div class="link-result-thumb"></div>'}
          <div class="link-result-info">
            <div class="link-result-name">${escapeHtml(r.label)}</div>
            <div class="link-result-sub">${escapeHtml(r.sub)}</div>
          </div>
          <span class="link-result-type ${r.type}">${linkTypeLabels[r.type]}</span>
        `;
        item.addEventListener('click', () => {
          selectedLink = { label: r.label, url: r.url };
          showSelectedLink();
          linkSearchResult.innerHTML = '';
          linkSearchInput.value = '';
        });
        linkSearchResult.appendChild(item);
      });
    }

    linkSearchBtn.addEventListener('click', searchLinkItems);
    linkSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchLinkItems();
    });

    selectedLinkRemoveBtn.addEventListener('click', () => {
      selectedLink = null;
      showSelectedLink();
    });

    // ============================================================
    // মেসেজ ইনপুট + সেন্ড বাটন স্টেট
    // ============================================================
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    const sendFeedback = document.getElementById('sendFeedback');

    function updateSendBtnState() {
      const hasMessage = messageInput.value.trim().length > 0;
      const targetReady = currentTarget === 'broadcast' || (currentTarget === 'single' && selectedUser);
      sendBtn.disabled = !(hasMessage && targetReady);
    }

    messageInput.addEventListener('input', updateSendBtnState);

    function showFeedback(text, type) {
      sendFeedback.textContent = text;
      sendFeedback.className = `send-feedback ${type}`;
    }

    // ============================================================
    // ছবি আপলোড হ্যান্ডলিং (নতুন — Phase 2)
    // ============================================================
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const imageUploadPlaceholder = document.getElementById('imageUploadPlaceholder');
    const imageRemoveBtn = document.getElementById('imageRemoveBtn');
    const imageFeedback = document.getElementById('imageFeedback');

    let selectedImageFile = null;

    imageInput.addEventListener('change', async () => {
      const file = imageInput.files?.[0];
      if (!file) return;

      imageFeedback.className = 'send-feedback';
      imageFeedback.textContent = '';

      const compressed = await compressImage(file, { maxDimension: 1000 });

      if (compressed.size > 2 * 1024 * 1024) {
        imageFeedback.className = 'send-feedback error';
        imageFeedback.textContent = 'ছবিটা ২MB এর চেয়ে বড় (কম্প্রেসের পরও), অন্য ছবি দিন';
        imageInput.value = '';
        return;
      }

      selectedImageFile = compressed;

      const reader = new FileReader();
      reader.onload = () => {
        imagePreview.src = reader.result;
        imagePreview.style.display = 'block';
        imageUploadPlaceholder.style.display = 'none';
        imageRemoveBtn.style.display = 'flex';
      };
      reader.readAsDataURL(compressed);
    });

    imageRemoveBtn.addEventListener('click', (e) => {
      e.preventDefault();
      selectedImageFile = null;
      imageInput.value = '';
      imagePreview.src = '';
      imagePreview.style.display = 'none';
      imageUploadPlaceholder.style.display = 'block';
      imageRemoveBtn.style.display = 'none';
      imageFeedback.className = 'send-feedback';
      imageFeedback.textContent = '';
    });

    function resetImageState() {
      selectedImageFile = null;
      imageInput.value = '';
      imagePreview.src = '';
      imagePreview.style.display = 'none';
      imageUploadPlaceholder.style.display = 'block';
      imageRemoveBtn.style.display = 'none';
    }

    // নির্বাচিত ছবি Supabase Storage এ আপলোড করে পাবলিক URL রিটার্ন করে
    async function uploadInboxImage(file) {
      const fileName = `${Date.now()}-${crypto.randomUUID()}.jpg`;

      const { error: uploadError } = await supabase.storage
        .from('inbox-images')
        .upload(fileName, file, { contentType: file.type });

      if (uploadError) {
        throw new Error('ছবি আপলোড ব্যর্থ: ' + uploadError.message);
      }

      const { data: publicUrlData } = supabase.storage.from('inbox-images').getPublicUrl(fileName);
      return publicUrlData.publicUrl;
    }

    // ============================================================
    // ব্যাচে insert করার হেল্পার (broadcast এর জন্য, ৫০০ জন করে)
    // ============================================================
    const BATCH_SIZE = 500;

    async function insertInBatches(rows) {
      for (let i = 0; i < rows.length; i += BATCH_SIZE) {
        const batch = rows.slice(i, i + BATCH_SIZE);
        const { error } = await supabase.from('user_notifications').insert(batch);
        if (error) throw error;
      }
    }

    // ============================================================
    // পাঠানো
    // ============================================================
    sendBtn.addEventListener('click', async () => {
      const message = messageInput.value.trim();
      if (!message) return;

      sendBtn.disabled = true;
      sendBtn.textContent = 'পাঠানো হচ্ছে...';
      showFeedback('', '');

      const { data: { user: adminUser } } = await supabase.auth.getUser();

      try {
        let imageUrl = null;
        if (selectedImageFile) {
          imageUrl = await uploadInboxImage(selectedImageFile);
        }

        if (currentTarget === 'single') {
          if (!selectedUser) throw new Error('একজন ইউজার সিলেক্ট করুন');

          const { error } = await supabase.from('user_notifications').insert({
            user_id: selectedUser.id,
            message,
            category: currentCategory,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            sender_type: 'admin',
            sender_id: adminUser?.id || null,
          });
          if (error) throw error;

          await supabase.from('admin_notification_log').insert({
            message,
            category: currentCategory,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            target_type: 'single',
            target_label: `${selectedUser.full_name || ''} (${selectedUser.phone || ''})`,
            recipient_count: 1,
            sent_by: adminUser?.id,
          });
        } else {
          const { data: allProfiles, error: profileError } = await supabase
            .from('profiles')
            .select('id');
          if (profileError) throw profileError;

          const rows = (allProfiles || []).map((p) => ({
            user_id: p.id,
            message,
            category: currentCategory,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            sender_type: 'admin',
            sender_id: adminUser?.id || null,
          }));
          if (rows.length === 0) throw new Error('কোনো ইউজার পাওয়া যায়নি');

          await insertInBatches(rows);

          await supabase.from('admin_notification_log').insert({
            message,
            category: currentCategory,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            target_type: 'broadcast',
            target_label: 'সবাইকে',
            recipient_count: rows.length,
            sent_by: adminUser?.id,
          });
        }

        showFeedback('সফলভাবে পাঠানো হয়েছে ✓', 'success');
        messageInput.value = '';
        selectedUser = null;
        userSearchResult.innerHTML = '';
        userSearchInput.value = '';
        resetImageState();
        selectedLink = null;
        showSelectedLink();
        linkSearchResult.innerHTML = '';
        linkSearchInput.value = '';
        loadLog();
      } catch (err) {
        showFeedback('পাঠানো ব্যর্থ: ' + err.message, 'error');
      }

      sendBtn.disabled = false;
      sendBtn.textContent = 'পাঠান';
      updateSendBtnState();
    });

    // ============================================================
    // হিস্ট্রি লগ
    // ============================================================
    const logContainer = document.getElementById('logContainer');
    const logEmptyState = document.getElementById('logEmptyState');

    const categoryLabels = {
      message: 'সাধারণ মেসেজ',
      promo: 'অফার-প্রমো',
    };

    async function loadLog() {
      const { data, error } = await supabase
        .from('admin_notification_log')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(30);

      if (error || !data || data.length === 0) {
        logContainer.innerHTML = '';
        logEmptyState.style.display = 'flex';
        return;
      }

      logEmptyState.style.display = 'none';
      logContainer.innerHTML = '';

      data.forEach((log) => {
        const item = document.createElement('div');
        item.className = 'log-item';
        item.innerHTML = `
          <div class="log-item-top">
            <div class="log-item-badges">
              <span class="log-item-badge ${log.target_type}">
                ${log.target_type === 'broadcast' ? 'সবাইকে' : escapeHtml(log.target_label || 'নির্দিষ্ট ইউজার')}
              </span>
              <span class="log-item-badge category-${log.category || 'message'}">
                ${categoryLabels[log.category] || 'সাধারণ মেসেজ'}
              </span>
            </div>
            <span style="font-size:0.72rem;color:#8FA0BC;">${log.recipient_count} জনকে</span>
          </div>
          ${log.image_url ? `<img src="${log.image_url}" alt="" class="log-item-image" />` : ''}
          <div class="log-item-msg">${escapeHtml(log.message)}</div>
          ${log.link_label ? `<div class="log-item-link-tag"><i class="fas fa-link"></i> ${escapeHtml(log.link_label)}</div>` : ''}
          <div class="log-item-meta">${formatDate(log.created_at)}</div>
        `;
        logContainer.appendChild(item);
      });
    }

    window.addEventListener('smartfeni:admin-ready', () => {
      loadLog();
    });

    initAdminGuard();
  </script>
</BaseLayout>
