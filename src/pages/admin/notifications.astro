      color: #1B2A4A;
    }
    .aud-all-row input { width: 20px; height: 20px; accent-color: #FF6B35; flex-shrink: 0; }
    .aud-all-row small { color: #8FA0BC; font-weight: 600; margin-left: 4px; }
    .aud-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
    .aud-guest-box {
      margin-top: 14px;
      border: 1.5px dashed #D7E0EC;
      border-radius: 14px;
      padding: 10px;
    }
    .aud-guest-hint {
      font-size: 0.76rem;
      line-height: 1.55;
      color: #5A6E85;
      font-weight: 600;
      margin: 8px 4px 2px;
    }
    .aud-summary {
      margin-top: 14px;
      padding: 10px 14px;
      background: #FFF4EE;
      border-radius: 12px;
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
    }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { compressImage } from '../../lib/imageCompress.js';

    // অ্যাডমিনের পাঠানো সব নোটিফিকেশনের priority — 'high' মানে পুশ সবসময় যাবে
    // (FCM high, ৬ ঘণ্টা মেয়াদ)। 'low' দিলে পুশ যেত না, তাই ব্যবহার করা হচ্ছে না।
    const ADMIN_PRIORITY = 'high';

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str ?? '';
      return div.innerHTML;
    }

    function formatDate(iso) {
      const d = new Date(iso);
      return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    // ============================================================
    // টার্গেট ট্যাব সুইচিং
    // ============================================================
    const targetTabs = document.querySelectorAll('.target-tab');
    const singlePanel = document.getElementById('singleTargetPanel');
    const broadcastPanel = document.getElementById('broadcastTargetPanel');

    let currentTarget = 'single';
    let selectedUser = null; // { id, full_name, phone }

    targetTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        targetTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentTarget = tab.dataset.target;
        singlePanel.style.display = currentTarget === 'single' ? 'block' : 'none';
        broadcastPanel.style.display = currentTarget === 'broadcast' ? 'block' : 'none';
        updateSendBtnState();
      });
    });

    // ============================================================
    // ক্যাটাগরি ট্যাব সুইচিং
    // ============================================================
    const categoryTabs = document.querySelectorAll('.category-tab');
    const categoryHint = document.getElementById('categoryHint');
    let currentCategory = 'message';

    const categoryHints = {
      message: 'উচ্চ গুরুত্বে (high) পাঠানো হবে। ইউজার ফোনের সেটিংসে "মেসেজ" চ্যানেল বন্ধ করলে ফোনে পুশ আসবে না, তবে অ্যাপের বেলে থাকবে',
      promo: 'উচ্চ গুরুত্বে (high) সবার কাছে পুশ যাবে (নিঃশব্দ "অফার" চ্যানেলে)। ইউজার ফোনের সেটিংসে "অফার" চ্যানেল বন্ধ করলে ফোনে পুশ আসবে না, তবে অ্যাপের বেলে থাকবে',
    };

    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentCategory = tab.dataset.category;
        categoryHint.textContent = categoryHints[currentCategory];
      });
    });

    // ============================================================
    // ইউজার সার্চ (ফোন নাম্বার দিয়ে)
    // ============================================================
    const userSearchInput = document.getElementById('userSearchInput');
    const userSearchBtn = document.getElementById('userSearchBtn');
    const userSearchResult = document.getElementById('userSearchResult');

    async function searchUser() {
      const phone = userSearchInput.value.trim();
      if (!phone) return;

      userSearchResult.innerHTML = '<p style="font-size:0.82rem;color:#8FA0BC;">খোঁজা হচ্ছে...</p>';
      selectedUser = null;
      updateSendBtnState();

      const { data, error } = await supabase
        .from('profiles')
        .select('id, full_name, phone')
        .ilike('phone', `%${phone}%`)
        .limit(5);

      if (error || !data || data.length === 0) {
        userSearchResult.innerHTML = '<p class="no-user-found">কোনো ইউজার পাওয়া যায়নি</p>';
        return;
      }

      userSearchResult.innerHTML = '';
      data.forEach((u) => {
        const item = document.createElement('div');
        item.className = 'user-result-item';
        item.innerHTML = `
          <div>
            <div class="user-result-name">${escapeHtml(u.full_name || '(নাম নাই)')}</div>
            <div class="user-result-phone">${escapeHtml(u.phone || '')}</div>
          </div>
          <i class="fas fa-circle-check" style="color:#D7E0EC;"></i>
        `;
        item.addEventListener('click', () => {
          document.querySelectorAll('.user-result-item').forEach((el) => el.classList.remove('selected'));
          item.classList.add('selected');
          selectedUser = u;
          updateSendBtnState();
        });
        userSearchResult.appendChild(item);
      });
    }

    userSearchBtn.addEventListener('click', searchUser);
    userSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchUser();
    });

    // ============================================================
    // লিংক করা আইটেম সার্চ — শপ/ক্লাব/লিস্টিং, একসাথে নাম দিয়ে সার্চ
    // ============================================================
    const linkSearchInput = document.getElementById('linkSearchInput');
    const linkSearchBtn = document.getElementById('linkSearchBtn');
    const linkSearchResult = document.getElementById('linkSearchResult');
    const selectedLinkChip = document.getElementById('selectedLinkChip');
    const selectedLinkLabel = document.getElementById('selectedLinkLabel');
    const selectedLinkRemoveBtn = document.getElementById('selectedLinkRemoveBtn');

    let selectedLink = null; // { label, url }

    const linkTypeLabels = { shop: 'শপ', club: 'ক্লাব', listing: 'লিস্টিং' };

    function showSelectedLink() {
      if (!selectedLink) {
        selectedLinkChip.classList.remove('show');
        return;
      }
      selectedLinkLabel.textContent = `🔗 ${selectedLink.label}`;
      selectedLinkChip.classList.add('show');
    }

    async function searchLinkItems() {
      const q = linkSearchInput.value.trim();
      if (!q) return;

      linkSearchResult.innerHTML = '<p style="font-size:0.82rem;color:#8FA0BC;">খোঁজা হচ্ছে...</p>';

      const [{ data: shops }, { data: clubs }, { data: listings }] = await Promise.all([
        supabase.from('shops').select('id, name, slug, logo_image, upazila').ilike('name', `%${q}%`).limit(6),
        supabase.from('clubs').select('id, name, slug, logo_image, upajila').ilike('name', `%${q}%`).limit(6),
        supabase.from('listings').select('id, title, category, images, upazila').ilike('title', `%${q}%`).limit(8),
      ]);

      const results = [
        ...(shops || []).map((s) => ({
          type: 'shop',
          label: s.name,
          url: `/${s.slug}`,
          image: s.logo_image || '',
          sub: s.upazila || 'শপ',
        })),
        ...(clubs || []).map((c) => ({
          type: 'club',
          label: c.name,
          url: `/${c.slug}`,
          image: c.logo_image || '',
          sub: c.upajila || 'ক্লাব',
        })),
        ...(listings || []).map((l) => ({
          type: 'listing',
          label: l.title,
          // অনলাইন-শপ ক্যাটাগরির লিস্টিং (শপের নির্দিষ্ট প্রোডাক্ট) এর
          // পাবলিক পেজ /product/{id}, বাকি সব ক্যাটাগরির জন্য
          // /listing/{id}
          url: l.category === 'online-shop' ? `/product/${l.id}` : `/listing/${l.id}`,
          image: (l.images && l.images[0]) || '',
          sub: `${l.category || ''}${l.upazila ? ' · ' + l.upazila : ''}`,
        })),
      ];

      if (results.length === 0) {
        linkSearchResult.innerHTML = '<p class="no-user-found">কিছু পাওয়া যায়নি</p>';
        return;
      }

      linkSearchResult.innerHTML = '';
      results.forEach((r) => {
        const item = document.createElement('div');
        item.className = 'link-result-item';
        item.innerHTML = `
          ${r.image ? `<img src="${r.image}" alt="" class="link-result-thumb" />` : '<div class="link-result-thumb"></div>'}
          <div class="link-result-info">
            <div class="link-result-name">${escapeHtml(r.label)}</div>
            <div class="link-result-sub">${escapeHtml(r.sub)}</div>
          </div>
          <span class="link-result-type ${r.type}">${linkTypeLabels[r.type]}</span>
        `;
        item.addEventListener('click', () => {
          selectedLink = { label: r.label, url: r.url };
          showSelectedLink();
          linkSearchResult.innerHTML = '';
          linkSearchInput.value = '';
        });
        linkSearchResult.appendChild(item);
      });
    }

    linkSearchBtn.addEventListener('click', searchLinkItems);
    linkSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchLinkItems();
    });

    selectedLinkRemoveBtn.addEventListener('click', () => {
      selectedLink = null;
      showSelectedLink();
    });

    // ============================================================
    // অডিয়েন্স সিলেক্টর: সব ইউজার / গ্রুপ ভিত্তিক ম্যানুয়াল বাছাই /
    // লগইন ছাড়া ইনস্টলড অ্যাপ (গেস্ট ডিভাইস, শুধু প্রমো)
    // তালিকা ও সংখ্যা আসে admin-only RPC থেকে। Astro scoped CSS
    // ডাইনামিক এলিমেন্টে কাজ করে না, তাই এখানে সব inline style।
    // ============================================================
    const AUDIENCE_GROUPS = [
      { key: 'delivery_hero', label: 'ডেলিভারি হিরো', icon: 'fa-motorcycle' },
      { key: 'ride_hero', label: 'রাইড হিরো', icon: 'fa-car-side' },
      { key: 'shop_owner', label: 'শপ ওনার', icon: 'fa-store' },
      { key: 'shop_moderator', label: 'শপ মডারেটর', icon: 'fa-user-shield' },
      { key: 'club_owner', label: 'ক্লাব ওনার', icon: 'fa-people-group' },
      { key: 'club_moderator', label: 'ক্লাব মডারেটর', icon: 'fa-user-gear' },
      { key: 'blood_donor', label: 'ব্লাড ডোনার', icon: 'fa-droplet' },
      { key: 'staff', label: 'অ্যাডমিন / মডারেটর', icon: 'fa-user-tie' },
    ];
    const UPAZILA_LIST = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];
    const MEMBER_PAGE = 100;

    const audAllInput = document.getElementById('audAll');
    const audAllCountEl = document.getElementById('audAllCount');
    const audAllNote = document.getElementById('audAllNote');
    const audGroupsWrap = document.getElementById('audGroupsWrap');
    const audGroupsEl = document.getElementById('audGroups');
    const audChipsEl = document.getElementById('audUpazilaChips');
    const audGuestInput = document.getElementById('audGuest');
    const audGuestCountEl = document.getElementById('audGuestCount');
    const audGuestHint = document.getElementById('audGuestHint');
    const audSummary = document.getElementById('audSummary');

    let audCounts = {};
    let audUpazila = '';
    const groupSel = {};   // key -> Map(userId -> {full_name, phone})
    const groupState = {}; // key -> { rows, total, offset, search, seq, open, loaded }
    const groupUI = {};    // key -> { countSpan, selBadge, ... }

    AUDIENCE_GROUPS.forEach((g) => { groupSel[g.key] = new Map(); });

    function mk(tag, css, text) {
      const e = document.createElement(tag);
      if (css) e.style.cssText = css;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    function selectedUserIds() {
      const s = new Set();
      AUDIENCE_GROUPS.forEach((g) => groupSel[g.key].forEach((_, id) => s.add(id)));
      return s;
    }

    function guestActive() {
      return currentCategory === 'promo' && audGuestInput.checked && Number(audCounts.guest_devices || 0) > 0;
    }

    function audienceReady() {
      return audAllInput.checked || selectedUserIds().size > 0 || guestActive();
    }

    function audienceLabel() {
      if (audAllInput.checked) return 'সবাইকে';
      const parts = AUDIENCE_GROUPS
        .filter((g) => groupSel[g.key].size > 0)
        .map((g) => `${g.label} (${groupSel[g.key].size})`);
      const label = parts.length ? 'বাছাই: ' + parts.join(', ') : 'লগইন ছাড়া ডিভাইস';
      return label.length > 180 ? label.slice(0, 177) + '...' : label;
    }

    function updateGuestBox() {
      const n = Number(audCounts.guest_devices || 0);
      const isPromo = currentCategory === 'promo';
      audGuestCountEl.textContent = `(${n}টি ডিভাইস)`;
      audGuestInput.disabled = !isPromo || n === 0;

      if (!isPromo) {
        audGuestHint.textContent = 'লগইন ছাড়া ডিভাইসে শুধু "অফার-প্রমো" ধরনের মেসেজ যায়। সাধারণ মেসেজ শুধু লগইন করা ইউজারদের কাছে যাবে — ওপরের "নোটিফিকেশনের ধরন" থেকে অফার-প্রমো বেছে নিলে এই অপশন চালু হবে।';
      } else if (n === 0) {
        audGuestHint.textContent = 'এখনো কোনো লগইন-ছাড়া ডিভাইস নেই। ইউজার অ্যাপ খুলে নোটিফিকেশনের অনুমতি দিলে ডিভাইস এখানে যোগ হবে।';
      } else {
        audGuestHint.textContent = 'ফোনে পুশ যাবে, আর অ্যাপের "মেসেজ" বক্সে (লগইন ছাড়াই) "অফার ও খবর" তালিকায় থাকবে। এই ডিভাইসগুলোর "কে পড়েছে" ট্র্যাকিং নেই, শুধু কতটিতে গেছে তার লগ থাকবে।';
      }
    }

    function updateAudienceSummary() {
      const parts = [];
      if (audAllInput.checked) {
        parts.push(`সব ইউজার (${audCounts.all_users ?? '?'} জন)`);
      } else {
        parts.push(`${selectedUserIds().size} জন বাছাই করা`);
      }
      if (guestActive()) parts.push(`${audCounts.guest_devices}টি লগইন-ছাড়া ডিভাইস`);
      audSummary.textContent = 'প্রাপক: ' + parts.join(' + ');
      updateSendBtnState();
    }

    // ---------- উপজেলা চিপ ----------
    function renderChips() {
      audChipsEl.innerHTML = '';
      ['', ...UPAZILA_LIST].forEach((u) => {
        const active = audUpazila === u;
        const chip = mk(
          'button',
          `border:1.5px solid ${active ? '#FF6B35' : '#D7E0EC'};background:${active ? '#FF6B35' : '#fff'};color:${active ? '#fff' : '#1B2A4A'};padding:7px 13px;border-radius:99px;font-size:0.78rem;font-weight:700;font-family:inherit;cursor:pointer;`,
          u || 'সব উপজেলা'
        );
        chip.type = 'button';
        chip.addEventListener('click', () => {
          audUpazila = u;
          renderChips();
          AUDIENCE_GROUPS.forEach((g) => {
            const st = groupState[g.key];
            st.loaded = false;
            if (st.open) groupUI[g.key].load(true);
          });
        });
        audChipsEl.appendChild(chip);
      });
    }

    // ---------- গ্রুপ কার্ড ----------
    function buildGroupCard(g) {
      const st = { rows: [], total: 0, offset: 0, search: '', seq: 0, open: false, loaded: false };
      groupState[g.key] = st;
      const map = groupSel[g.key];

      const card = mk('div', 'background:#fff;border:1.5px solid #E5EAF0;border-radius:14px;margin-top:10px;overflow:hidden;');

      const head = mk('button', 'width:100%;display:flex;align-items:center;gap:10px;padding:13px 14px;background:#fff;border:none;cursor:pointer;font-family:inherit;text-align:left;');
      head.type = 'button';
      const icon = mk('i', 'color:#FF6B35;width:20px;text-align:center;');
      icon.className = `fas ${g.icon}`;
      const name = mk('span', 'font-weight:700;color:#1B2A4A;font-size:0.9rem;', g.label);
      const countSpan = mk('span', 'font-size:0.78rem;color:#8FA0BC;font-weight:600;', '');
      const spacer = mk('span', 'flex:1;');
      const selBadge = mk('span', 'display:none;background:#FF6B35;color:#fff;font-size:0.72rem;font-weight:800;padding:3px 10px;border-radius:99px;', '');
      const chev = mk('i', 'color:#8FA0BC;font-size:0.8rem;transition:transform 0.2s;');
      chev.className = 'fas fa-chevron-down';
      [icon, name, countSpan, spacer, selBadge, chev].forEach((x) => head.appendChild(x));

      const body = mk('div', 'display:none;padding:0 14px 14px;border-top:1px solid #EEF2F7;');

      const toolbar = mk('div', 'display:flex;gap:8px;margin:12px 0 8px;');
      const selectAllBtn = mk('button', 'background:#FF6B35;color:#fff;border:none;padding:10px 14px;border-radius:12px;font-weight:700;font-size:0.8rem;font-family:inherit;cursor:pointer;white-space:nowrap;', '✓ সবাইকে সিলেক্ট');
      selectAllBtn.type = 'button';
      const search = mk('input', 'flex:1;min-width:0;padding:10px 12px;border:1.5px solid #D7E0EC;border-radius:12px;font-size:0.82rem;font-family:inherit;color:#1B2A4A;');
      search.type = 'text';
      search.placeholder = 'নাম বা ফোন খুঁজুন';
      toolbar.appendChild(selectAllBtn);
      toolbar.appendChild(search);

      const status = mk('p', 'font-size:0.76rem;color:#8FA0BC;font-weight:600;margin:4px 2px 8px;', '');
      const list = mk('div', 'display:flex;flex-direction:column;gap:6px;max-height:340px;overflow-y:auto;');
      const moreBtn = mk('button', 'display:none;width:100%;margin-top:8px;background:#F4F7FC;color:#1B2A4A;border:none;border-radius:12px;padding:10px;font-size:0.8rem;font-weight:700;font-family:inherit;cursor:pointer;', 'আরও দেখান');
      moreBtn.type = 'button';

      [toolbar, status, list, moreBtn].forEach((x) => body.appendChild(x));
      card.appendChild(head);
      card.appendChild(body);

      function updateSelBadge() {
        if (map.size > 0) {
          selBadge.style.display = 'inline-block';
          selBadge.textContent = `${map.size} নির্বাচিত`;
        } else {
          selBadge.style.display = 'none';
        }
      }

      function syncSelectAllLabel() {
        const everyoneShown = st.total > 0 && st.rows.length === st.total && st.rows.every((r) => map.has(r.id));
        selectAllBtn.textContent = everyoneShown ? '✕ সব বাদ দিন' : '✓ সবাইকে সিলেক্ট';
      }

      function renderRows() {
        list.innerHTML = '';
        st.rows.forEach((r) => {
          const row = mk('label', 'display:flex;align-items:center;gap:10px;padding:9px 10px;background:#F8FAFC;border-radius:10px;cursor:pointer;');
          const cb = mk('input', 'width:19px;height:19px;accent-color:#FF6B35;flex-shrink:0;');
          cb.type = 'checkbox';
          cb.checked = map.has(r.id);
          cb.addEventListener('change', () => {
            if (cb.checked) map.set(r.id, { full_name: r.full_name, phone: r.phone });
            else map.delete(r.id);
            updateSelBadge();
            syncSelectAllLabel();
            updateAudienceSummary();
          });
          const info = mk('div', 'min-width:0;flex:1;');
          info.appendChild(mk('div', 'font-size:0.85rem;font-weight:700;color:#1B2A4A;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;', r.full_name || 'নাম নেই'));
          info.appendChild(mk('div', 'font-size:0.74rem;color:#8FA0BC;font-weight:600;', `${r.phone || 'ফোন নেই'}${r.upazila ? ' • ' + r.upazila : ''}`));
          row.appendChild(cb);
          row.appendChild(info);
          list.appendChild(row);
        });
        syncSelectAllLabel();
      }

      async function load(reset) {
        if (reset) {
          st.offset = 0;
          st.rows = [];
        }
        const seq = ++st.seq; // পুরনো রেসপন্স নতুনটাকে ওভাররাইট করা আটকায়
        status.textContent = 'লোড হচ্ছে...';

        const { data, error } = await supabase.rpc('admin_audience_members', {
          p_group: g.key,
          p_upazila: audUpazila || null,
          p_search: st.search || null,
          p_limit: MEMBER_PAGE,
          p_offset: st.offset,
        });
        if (seq !== st.seq) return;

        if (error) {
          status.textContent = 'লোড করা যায়নি: ' + error.message;
          return;
        }

        const rows = data || [];
        if (rows.length > 0) st.total = Number(rows[0].total);
        else if (reset) st.total = 0;

        st.rows.push(...rows);
        st.offset += rows.length;
        st.loaded = true;

        status.textContent = st.rows.length === 0
          ? 'এই ফিল্টারে কেউ নেই'
          : `${st.total} জনের মধ্যে ${st.rows.length} জন দেখাচ্ছে`;
        moreBtn.style.display = st.rows.length < st.total ? 'block' : 'none';
        renderRows();
      }

      // "সবাইকে সিলেক্ট" — বর্তমান ফিল্টারের (উপজেলা + সার্চ) সবাই, শুধু দেখানো ১০০ জন না
      async function fetchAllMatching() {
        const all = [];
        for (let off = 0; ; off += 1000) {
          const { data, error } = await supabase.rpc('admin_audience_members', {
            p_group: g.key,
            p_upazila: audUpazila || null,
            p_search: st.search || null,
            p_limit: 1000,
            p_offset: off,
          });
          if (error) throw error;
          const rows = data || [];
          all.push(...rows);
          if (rows.length < 1000) break;
        }
        return all;
      }

      selectAllBtn.addEventListener('click', async () => {
        selectAllBtn.disabled = true;
        selectAllBtn.style.opacity = '0.6';
        try {
          const all = await fetchAllMatching();
          const allSelected = all.length > 0 && all.every((r) => map.has(r.id));
          all.forEach((r) => {
            if (allSelected) map.delete(r.id);
            else map.set(r.id, { full_name: r.full_name, phone: r.phone });
          });
          renderRows();
          updateSelBadge();
          updateAudienceSummary();
        } catch (err) {
          status.textContent = 'সিলেক্ট করা যায়নি: ' + (err.message || err);
        }
        selectAllBtn.disabled = false;
        selectAllBtn.style.opacity = '1';
      });

      let searchTimer = null;
      search.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          st.search = search.value.trim();
          load(true);
        }, 350);
      });

      moreBtn.addEventListener('click', () => load(false));

      head.addEventListener('click', () => {
        st.open = !st.open;
        body.style.display = st.open ? 'block' : 'none';
        chev.style.transform = st.open ? 'rotate(180deg)' : 'none';
        if (st.open && !st.loaded) load(true);
      });

      groupUI[g.key] = { countSpan, load, updateSelBadge };
      return card;
    }

    AUDIENCE_GROUPS.forEach((g) => audGroupsEl.appendChild(buildGroupCard(g)));
    renderChips();

    async function loadAudienceCounts() {
      const { data, error } = await supabase.rpc('admin_audience_counts');
      if (error) {
        audSummary.textContent = 'সংখ্যা আনা যায়নি: ' + error.message;
        return;
      }
      audCounts = {};
      (data || []).forEach((r) => { audCounts[r.grp] = Number(r.cnt); });

      audAllCountEl.textContent = `(${audCounts.all_users ?? 0} জন)`;
      AUDIENCE_GROUPS.forEach((g) => {
        groupUI[g.key].countSpan.textContent = `(${audCounts[g.key] ?? 0})`;
      });
      updateGuestBox();
      updateAudienceSummary();
    }

    audAllInput.addEventListener('change', () => {
      audGroupsWrap.style.display = audAllInput.checked ? 'none' : 'block';
      audAllNote.style.display = audAllInput.checked ? 'block' : 'none';
      updateAudienceSummary();
    });

    audGuestInput.addEventListener('change', updateAudienceSummary);

    // ক্যাটাগরি বদলালে (সাধারণ মেসেজ ↔ অফার-প্রমো) গেস্ট বক্সের অবস্থা বদলায়
    // (পুরনো ক্যাটাগরি হ্যান্ডলার আগে চলে currentCategory সেট করে, তারপর এটা)
    document.querySelectorAll('.category-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        updateGuestBox();
        updateAudienceSummary();
      });
    });

    // ============================================================
    // মেসেজ ইনপুট + সেন্ড বাটন স্টেট
    // ============================================================
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    const sendFeedback = document.getElementById('sendFeedback');

    function updateSendBtnState() {
      const hasMessage = messageInput.value.trim().length > 0;
      const targetReady = (currentTarget === 'broadcast' && audienceReady()) || (currentTarget === 'single' && selectedUser);
      sendBtn.disabled = !(hasMessage && targetReady);
    }

    messageInput.addEventListener('input', updateSendBtnState);

    function showFeedback(text, type) {
      sendFeedback.textContent = text;
      sendFeedback.className = `send-feedback ${type}`;
    }

    // ============================================================
    // ছবি আপলোড হ্যান্ডলিং
    // ============================================================
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const imageUploadPlaceholder = document.getElementById('imageUploadPlaceholder');
    const imageRemoveBtn = document.getElementById('imageRemoveBtn');
    const imageFeedback = document.getElementById('imageFeedback');

    let selectedImageFile = null;

    imageInput.addEventListener('change', async () => {
      const file = imageInput.files?.[0];
      if (!file) return;

      imageFeedback.className = 'send-feedback';
      imageFeedback.textContent = '';

      const compressed = await compressImage(file, { maxDimension: 1000 });

      if (compressed.size > 2 * 1024 * 1024) {
        imageFeedback.className = 'send-feedback error';
        imageFeedback.textContent = 'ছবিটা ২MB এর চেয়ে বড় (কম্প্রেসের পরও), অন্য ছবি দিন';
        imageInput.value = '';
        return;
      }

      selectedImageFile = compressed;

      const reader = new FileReader();
      reader.onload = () => {
        imagePreview.src = reader.result;
        imagePreview.style.display = 'block';
        imageUploadPlaceholder.style.display = 'none';
        imageRemoveBtn.style.display = 'flex';
      };
      reader.readAsDataURL(compressed);
    });

    imageRemoveBtn.addEventListener('click', (e) => {
      e.preventDefault();
      selectedImageFile = null;
      imageInput.value = '';
      imagePreview.src = '';
      imagePreview.style.display = 'none';
      imageUploadPlaceholder.style.display = 'block';
      imageRemoveBtn.style.display = 'none';
      imageFeedback.className = 'send-feedback';
      imageFeedback.textContent = '';
    });

    function resetImageState() {
      selectedImageFile = null;
      imageInput.value = '';
      imagePreview.src = '';
      imagePreview.style.display = 'none';
      imageUploadPlaceholder.style.display = 'block';
      imageRemoveBtn.style.display = 'none';
    }

    // নির্বাচিত ছবি Supabase Storage এ আপলোড করে পাবলিক URL রিটার্ন করে
    async function uploadInboxImage(file) {
      const fileName = `${Date.now()}-${crypto.randomUUID()}.jpg`;

      const { error: uploadError } = await supabase.storage
        .from('inbox-images')
        .upload(fileName, file, { contentType: file.type });

      if (uploadError) {
        throw new Error('ছবি আপলোড ব্যর্থ: ' + uploadError.message);
      }

      const { data: publicUrlData } = supabase.storage.from('inbox-images').getPublicUrl(fileName);
      return publicUrlData.publicUrl;
    }

    // ============================================================
    // সব ইউজারের id আনা — Supabase একবারে সর্বোচ্চ ১০০০ সারি দেয়,
    // তাই পাতা করে (১০০০ করে) আনা হয় যাতে সত্যিই সবাই পায়
    // ============================================================
    const PROFILE_PAGE_SIZE = 1000;

    async function fetchAllProfileIds() {
      const all = [];
      for (let from = 0; ; from += PROFILE_PAGE_SIZE) {
        const { data, error } = await supabase
          .from('profiles')
          .select('id')
          .order('id', { ascending: true })
          .range(from, from + PROFILE_PAGE_SIZE - 1);
        if (error) throw error;
        const rows = data || [];
        all.push(...rows);
        if (rows.length < PROFILE_PAGE_SIZE) break;
      }
      return all;
    }

    // ============================================================
    // ব্যাচে insert করার হেল্পার (broadcast এর জন্য, ৫০০ জন করে)
    // broadcastInserted — এ পর্যন্ত কতজনের কাছে সত্যিই গেছে (মাঝপথে
    // ব্যর্থ হলে আংশিক লগ সেভ করার জন্য)
    // ============================================================
    const BATCH_SIZE = 500;
    let broadcastInserted = 0;

    async function insertInBatches(rows) {
      for (let i = 0; i < rows.length; i += BATCH_SIZE) {
        const batch = rows.slice(i, i + BATCH_SIZE);
        const { error } = await supabase.from('user_notifications').insert(batch);
        if (error) throw error;
        broadcastInserted += batch.length;
      }
    }

    // ============================================================
    // পাঠানো
    // campaignId: আগে থেকে তৈরি UUID — সব user_notifications রো-তে
    // campaign_id হিসেবে এবং লগ রো-র id হিসেবে বসে, এভাবেই "কে পড়েছে"
    // ট্র্যাকিং কাজ করে।
    // ============================================================
    // লগইন ছাড়া ডিভাইসে প্রমো — সার্ভার রুট অ্যাডমিন যাচাই করে FCM পাঠায়
    async function sendGuestBroadcast({ message, imageUrl }) {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) throw new Error('লগইন সেশন পাওয়া যায়নি');

      const res = await fetch('/api/push/guest-broadcast', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({
          message,
          image_url: imageUrl,
          link_label: selectedLink?.label || null,
          action_url: selectedLink?.url || null,
        }),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(out.error || 'লগইন-ছাড়া ডিভাইসে পাঠানো ব্যর্থ');
      return out;
    }

    sendBtn.addEventListener('click', async () => {
      const message = messageInput.value.trim();
      if (!message) return;

      sendBtn.disabled = true;
      sendBtn.textContent = 'পাঠানো হচ্ছে...';
      showFeedback('', '');

      const { data: { user: adminUser } } = await supabase.auth.getUser();

      const campaignId = crypto.randomUUID();
      let isBroadcast = false;
      let logWarning = '';
      let sentSummary = '';
      let guestWarning = '';
      broadcastInserted = 0;

      try {
        let imageUrl = null;
        if (selectedImageFile) {
          imageUrl = await uploadInboxImage(selectedImageFile);
        }

        if (currentTarget === 'single') {
          if (!selectedUser) throw new Error('একজন ইউজার সিলেক্ট করুন');

          const { error } = await supabase.from('user_notifications').insert({
            user_id: selectedUser.id,
            message,
            category: currentCategory,
            priority: ADMIN_PRIORITY,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            sender_type: 'admin',
            sender_id: adminUser?.id || null,
            campaign_id: campaignId,
          });
          if (error) throw error;

          const { error: logError } = await supabase.from('admin_notification_log').insert({
            id: campaignId,
            message,
            category: currentCategory,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            target_type: 'single',
            target_label: `${selectedUser.full_name || ''} (${selectedUser.phone || ''})`,
            recipient_count: 1,
            sent_by: adminUser?.id,
          });
          if (logError) logWarning = logError.message;
        } else {
          isBroadcast = true;

          // প্রাপক: "সব ইউজার" হলে সব প্রোফাইল, নইলে গ্রুপ থেকে বাছাই করা (ডুপ্লিকেট ছাড়া)
          const userIds = audAllInput.checked
            ? (await fetchAllProfileIds()).map((p) => p.id)
            : [...selectedUserIds()];
          const sendToGuests = guestActive();

          if (userIds.length === 0 && !sendToGuests) throw new Error('কোনো প্রাপক বাছাই করা হয়নি');

          if (userIds.length > 0) {
            const rows = userIds.map((id) => ({
              user_id: id,
              message,
              category: currentCategory,
              priority: ADMIN_PRIORITY,
              image_url: imageUrl,
              link_label: selectedLink?.label || null,
              action_url: selectedLink?.url || null,
              sender_type: 'admin',
              sender_id: adminUser?.id || null,
              campaign_id: campaignId,
            }));
            await insertInBatches(rows);
          }

          // লগইন ছাড়া ইনস্টলড অ্যাপ (শুধু প্রমো)। লগইন করা ইউজারদের ইনসার্ট আগেই
          // হয়ে গেছে, তাই এখানে ব্যর্থ হলে পুরো পাঠানো ব্যর্থ না — শুধু সতর্কতা
          let guestDevices = 0;
          if (sendToGuests) {
            try {
              const out = await sendGuestBroadcast({ message, imageUrl });
              guestDevices = Number(out.sent || 0);
            } catch (guestErr) {
              if (userIds.length === 0) throw guestErr;
              guestWarning = guestErr.message;
            }
          }

          sentSummary = `${userIds.length} জন`;
          if (sendToGuests) sentSummary += ` + ${guestDevices}টি লগইন-ছাড়া ডিভাইস`;

          const { error: logError } = await supabase.from('admin_notification_log').insert({
            id: campaignId,
            message,
            category: currentCategory,
            image_url: imageUrl,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            target_type: 'broadcast',
            target_label: audienceLabel(),
            recipient_count: userIds.length,
            guest_device_count: guestDevices,
            sent_by: adminUser?.id,
          });
          if (logError) logWarning = logError.message;
        }

        if (logWarning) {
          showFeedback('পাঠানো হয়েছে, কিন্তু হিস্ট্রি লগ সেভ হয়নি: ' + logWarning, 'error');
        } else if (guestWarning) {
          showFeedback(`লগইন করা ইউজারদের পাঠানো হয়েছে (${sentSummary}), কিন্তু লগইন-ছাড়া ডিভাইসে ব্যর্থ: ${guestWarning}`, 'error');
        } else {
          showFeedback(sentSummary ? `সফলভাবে পাঠানো হয়েছে ✓ (${sentSummary})` : 'সফলভাবে পাঠানো হয়েছে ✓', 'success');
        }
        messageInput.value = '';
        selectedUser = null;
        userSearchResult.innerHTML = '';
        userSearchInput.value = '';
        resetImageState();
        selectedLink = null;
        showSelectedLink();
        linkSearchResult.innerHTML = '';
        linkSearchInput.value = '';
        loadLog();
      } catch (err) {
        let failMsg = 'পাঠানো ব্যর্থ: ' + err.message;

        // ব্রডকাস্ট মাঝপথে থেমে গেলে — যতজনের কাছে গেছে ততজনের আংশিক
        // লগ সেভ করি, যেন তাদের পড়া ট্র্যাক করা যায়
        if (isBroadcast && broadcastInserted > 0) {
          const { error: partialLogError } = await supabase.from('admin_notification_log').insert({
            id: campaignId,
            message,
            category: currentCategory,
            image_url: null,
            link_label: selectedLink?.label || null,
            action_url: selectedLink?.url || null,
            target_type: 'broadcast',
            target_label: 'সবাইকে (আংশিক — মাঝপথে ব্যর্থ)',
            recipient_count: broadcastInserted,
            sent_by: adminUser?.id,
          });
          failMsg += ` — ${broadcastInserted} জনের কাছে গেছে`;
          if (!partialLogError) loadLog();
        }

        showFeedback(failMsg, 'error');
      }

      sendBtn.disabled = false;
      sendBtn.textContent = 'পাঠান';
      updateSendBtnState();
    });

    // ============================================================
    // হিস্ট্রি লগ + পড়ার স্ট্যাটাস
    // ============================================================
    const logContainer = document.getElementById('logContainer');
    const logEmptyState = document.getElementById('logEmptyState');

    const categoryLabels = {
      message: 'সাধারণ মেসেজ',
      promo: 'অফার-প্রমো',
    };

    // কার্ডের "পড়ার স্ট্যাটাস" অংশ আঁকে
    function renderStats(container, log, stats, errorText) {
      if (errorText) {
        container.innerHTML = `<div class="log-stats-muted">পড়ার তথ্য আনা যায়নি</div>`;
        return;
      }

      const total = Number(stats?.total_count || 0);
      if (total === 0) {
        container.innerHTML = log.guest_device_count > 0 && !log.recipient_count
          ? `<div class="log-stats-muted">শুধু লগইন-ছাড়া ডিভাইসে গেছে (পড়ার ট্র্যাকিং নেই)</div>`
          : `<div class="log-stats-muted">পড়ার তথ্য নেই (ট্র্যাকিং চালুর আগের মেসেজ)</div>`;
        return;
      }

      const read = Number(stats.read_count || 0);
      const push = Number(stats.push_count || 0);
      const pct = Math.round((read / total) * 100);

      container.innerHTML = `
        <div class="log-stats-row">
          <span class="log-stats-read">পড়েছে <em>${read}</em> / ${total} (${pct}%)</span>
          <span class="log-stats-push"><i class="fas fa-bell"></i> Push ${push}</span>
        </div>
        <div class="log-stats-bar"><div class="log-stats-bar-fill" style="width:${pct}%;"></div></div>
        <button type="button" class="log-stats-btn">
          <i class="fas fa-users"></i> কে কে পড়েছে দেখুন
        </button>
      `;

      container.querySelector('.log-stats-btn').addEventListener('click', () => openReaders(log));
    }

    async function loadStatsFor(log, container) {
      const { data, error } = await supabase.rpc('admin_notification_stats', { p_log_id: log.id });
      if (error) {
        renderStats(container, log, null, error.message);
        return;
      }
      renderStats(container, log, Array.isArray(data) ? data[0] : data, null);
    }

    async function loadLog() {
      const { data, error } = await supabase
        .from('admin_notification_log')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(30);

      if (error || !data || data.length === 0) {
        logContainer.innerHTML = '';
        logEmptyState.style.display = 'flex';
        return;
      }

      logEmptyState.style.display = 'none';
      logContainer.innerHTML = '';

      data.forEach((log) => {
        const item = document.createElement('div');
        item.className = 'log-item';
        item.innerHTML = `
          <div class="log-item-top">
            <div class="log-item-badges">
              <span class="log-item-badge ${log.target_type}">
                ${log.target_type === 'broadcast' ? escapeHtml(log.target_label || 'সবাইকে') : escapeHtml(log.target_label || 'নির্দিষ্ট ইউজার')}
              </span>
              <span class="log-item-badge category-${log.category || 'message'}">
                ${categoryLabels[log.category] || 'সাধারণ মেসেজ'}
              </span>
            </div>
            <span style="font-size:0.72rem;color:#8FA0BC;">${log.recipient_count} জনকে${log.guest_device_count ? ` + ${log.guest_device_count}টি ডিভাইস` : ''}</span>
          </div>
          ${log.image_url ? `<img src="${log.image_url}" alt="" class="log-item-image" />` : ''}
          <div class="log-item-msg">${escapeHtml(log.message)}</div>
          ${log.link_label ? `<div class="log-item-link-tag"><i class="fas fa-link"></i> ${escapeHtml(log.link_label)}</div>` : ''}
          <div class="log-item-meta">${formatDate(log.created_at)}</div>
          <div class="log-stats"><div class="log-stats-muted">পড়ার তথ্য লোড হচ্ছে...</div></div>
        `;
        logContainer.appendChild(item);

        loadStatsFor(log, item.querySelector('.log-stats'));
      });
    }

    // ============================================================
    // "কে কে পড়েছে" বটম-শিট
    // ============================================================
    const READERS_PAGE_SIZE = 50;

    const readersOverlay = document.getElementById('readersOverlay');
    const readersMsg = document.getElementById('readersMsg');
    const readersList = document.getElementById('readersList');
    const readersMore = document.getElementById('readersMore');
    const readersSearch = document.getElementById('readersSearch');
    const readersClose = document.getElementById('readersClose');
    const readersRefresh = document.getElementById('readersRefresh');
    const readersTabs = document.querySelectorAll('.readers-tab');
    const rcAll = document.getElementById('rcAll');
    const rcRead = document.getElementById('rcRead');
    const rcUnread = document.getElementById('rcUnread');

    const readersState = {
      logId: null,
      filter: 'all',
      search: '',
      offset: 0,
      requestSeq: 0, // পুরনো রেসপন্স নতুনটাকে ওভাররাইট করা আটকায়
    };

    function setReadersCounts(stats) {
      const total = Number(stats?.total_count || 0);
      const read = Number(stats?.read_count || 0);
      const unread = Number(stats?.unread_count || 0);
      rcAll.textContent = `(${total})`;
      rcRead.textContent = `(${read})`;
      rcUnread.textContent = `(${unread})`;
    }

    function readerRowHtml(r) {
      const name = r.r_name || '(নাম নাই)';
      const initial = escapeHtml(Array.from(name.trim())[0] || '?');
      return `
        <div class="readers-row">
          <div class="readers-avatar">${initial}</div>
          <div class="readers-info">
            <div class="readers-name">${escapeHtml(name)}</div>
            <div class="readers-phone">${escapeHtml(r.r_phone || '—')}</div>
          </div>
          <span class="readers-chip ${r.r_is_read ? 'read' : 'unread'}">
            ${r.r_is_read ? '<i class="fas fa-check"></i> পড়েছে' : 'পড়েনি'}
          </span>
        </div>
      `;
    }

    async function loadReaders(reset) {
      if (!readersState.logId) return;

      const seq = ++readersState.requestSeq;

      if (reset) {
        readersState.offset = 0;
        readersList.innerHTML = '<div class="readers-state">লোড হচ্ছে...</div>';
        readersMore.style.display = 'none';
      } else {
        readersMore.disabled = true;
        readersMore.textContent = 'লোড হচ্ছে...';
      }

      const { data, error } = await supabase.rpc('admin_notification_readers', {
        p_log_id: readersState.logId,
        p_filter: readersState.filter,
        p_search: readersState.search,
        p_limit: READERS_PAGE_SIZE,
        p_offset: readersState.offset,
      });

      if (seq !== readersState.requestSeq) return; // এর মধ্যে নতুন রিকোয়েস্ট হয়ে গেছে

      readersMore.disabled = false;
      readersMore.textContent = 'আরও দেখুন';

      if (error) {
        if (reset) readersList.innerHTML = `<div class="readers-state error">তালিকা আনা যায়নি: ${escapeHtml(error.message)}</div>`;
        return;
      }

      const rows = data || [];

      if (reset) {
        readersList.innerHTML = '';
        if (rows.length === 0) {
          readersList.innerHTML = '<div class="readers-state">কাউকে পাওয়া যায়নি</div>';
        }
      }

      readersList.insertAdjacentHTML('beforeend', rows.map(readerRowHtml).join(''));
      readersState.offset += rows.length;
      readersMore.style.display = rows.length === READERS_PAGE_SIZE ? 'block' : 'none';
    }

    async function refreshReadersAll() {
      if (!readersState.logId) return;

      readersRefresh.classList.add('spinning');

      const { data } = await supabase.rpc('admin_notification_stats', { p_log_id: readersState.logId });
      setReadersCounts(Array.isArray(data) ? data[0] : data);

      await loadReaders(true);
      readersRefresh.classList.remove('spinning');
    }

    function openReaders(log) {
      readersState.logId = log.id;
      readersState.filter = 'all';
      readersState.search = '';
      readersSearch.value = '';
      readersTabs.forEach((t) => t.classList.toggle('active', t.dataset.filter === 'all'));
      readersMsg.textContent = log.message || '';
      setReadersCounts(null);

      readersOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      refreshReadersAll();
    }

    function closeReaders() {
      readersOverlay.style.display = 'none';
      document.body.style.overflow = '';
      readersState.logId = null;
      readersState.requestSeq++;
      loadLog(); // কার্ডের সংখ্যা সতেজ রাখতে
    }

    readersTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        readersTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        readersState.filter = tab.dataset.filter;
        loadReaders(true);
      });
    });

    let readersSearchTimer = null;
    readersSearch.addEventListener('input', () => {
      clearTimeout(readersSearchTimer);
      readersSearchTimer = setTimeout(() => {
        readersState.search = readersSearch.value.trim();
        loadReaders(true);
      }, 350);
    });

    readersMore.addEventListener('click', () => loadReaders(false));
    readersRefresh.addEventListener('click', refreshReadersAll);
    readersClose.addEventListener('click', closeReaders);

    readersOverlay.addEventListener('click', (e) => {
      if (e.target === readersOverlay) closeReaders();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && readersOverlay.style.display !== 'none') closeReaders();
    });

    window.addEventListener('smartfeni:admin-ready', () => {
      loadLog();
      loadAudienceCounts();
    });

    initAdminGuard();
  </script>
</BaseLayout>
