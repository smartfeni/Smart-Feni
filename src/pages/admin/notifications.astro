---
// ============================================================
// পেজ: অ্যাডমিন — কাস্টম নোটিফিকেশন পাঠানো (/admin/notifications)
// user_notifications টেবিলে ইনসার্ট করে — নির্দিষ্ট ইউজার (ফোন
// নাম্বার সার্চ করে) অথবা সবাইকে ব্রডকাস্ট। প্রতিটা পাঠানোর একটা
// লগ admin_notification_log এ থাকে (কতজনকে, কী মেসেজ, কবে)।
//
// আপডেট (Phase 5 — Push সিস্টেম ইন্টিগ্রেশন):
// - Category selector (সাধারণ মেসেজ / অফার-প্রমো)
// - sender_type: 'admin', sender_id: adminUser.id — কে পাঠালো ট্র্যাক হয়
// - Broadcast এ ৫০০ জন করে ব্যাচে insert
// - admin_notification_log এ category কলাম আছে (migration)
//
// নোট: push পাঠানো trg_notify_push_on_insert ট্রিগার (আর ব্যর্থ হলে
// cron) নিজে handle করে — এখানে শুধু সঠিক category + priority সহ
// user_notifications এ insert করলেই যথেষ্ট।
//
// আপডেট: "লিংক করা আইটেম" সার্চ (শপ/ক্লাব/লিস্টিং) — সিলেক্ট করলে
// link_label + action_url সেভ হয়।
//
// আপডেট (এই সেশন):
// - অ্যাডমিনের পাঠানো সব নোটিফিকেশন (সাধারণ মেসেজ ও অফার-প্রমো দুটোই)
//   এখন priority: 'high' — ফলে পুশ সবসময় যায় (priority 'low' হলে
//   পুশ যায় না, শুধু বেলে থাকে)। প্রমো পাঠানো হয় শুধু অ্যাডমিন
//   নিজে পাঠালে, তাই সবসময় high রাখা হয়েছে।
// - ব্রডকাস্টে profiles আগে একবারে select করায় Supabase এর ডিফল্ট
//   ১০০০ সারির সীমায় আটকে যেত → এখন পাতা করে (pagination) সব
//   ইউজারের id আনা হয়, যাতে সত্যিই সবাই পায়।
// - ক্যাটাগরির হিন্ট লেখা ঠিক করা: প্রোফাইলের টগল বাদ দেওয়া হয়েছে,
//   এখন ফোনের নোটিফিকেশন চ্যানেল দিয়ে নিয়ন্ত্রণ হয়।
//
// আপডেট (পড়ার ট্র্যাকিং — কে কে পড়েছে):
// - প্রতিটা পাঠানোর জন্য একটা campaign_id (UUID) আগে থেকে তৈরি হয়ে
//   সব user_notifications রো-তে বসে এবং একই আইডি admin_notification_log.id
//   হিসেবে সেভ হয় — এভাবেই লগ আর নোটিফিকেশন জোড়া লাগে।
// - হিস্ট্রি কার্ডে "পড়েছে X / Y (Z%)" প্রগ্রেস বার (RPC:
//   admin_notification_stats, শুধু admin)।
// - কার্ডের বাটনে চাপলে বটম-শিট: সব/পড়েছে/পড়েনি ট্যাব, নাম-ফোন সার্চ,
//   ৫০ জন করে "আরও দেখুন" (RPC: admin_notification_readers, শুধু admin)।
// - ব্রডকাস্টের মাঝপথে ব্যর্থ হলে যতজনের কাছে গেছে ততজনের আংশিক লগ
//   সেভ হয়, যেন তাদের পড়া ট্র্যাক করা যায়।
// - ট্র্যাকিং চালুর আগের পুরনো লগে campaign_id নেই, তাই সেগুলোতে
//   পড়ার তথ্য দেখায় না।
//
// আপডেট (Oct 2026 — অডিয়েন্স সিলেক্টর + লগইন ছাড়া ডিভাইস):
// - "সবাই / গ্রুপ" ট্যাব: "সব ইউজার" টগল অথবা গ্রুপ ভিত্তিক ম্যানুয়াল বাছাই
//   (ডেলিভারি হিরো, রাইড হিরো, শপ/ক্লাব ওনার ও মডারেটর, ব্লাড ডোনার,
//   অ্যাডমিন/মডারেটর) — প্রতিটা গ্রুপে সবার তালিকা, প্রতিজনের চেকবক্স,
//   গ্রুপ-ভিত্তিক "সবাইকে সিলেক্ট" বাটন, সার্চ ও উপজেলা ফিল্টার।
//   একজন একাধিক গ্রুপে থাকলেও একবারই মেসেজ পায়।
// - তালিকা/সংখ্যা আসে admin-only RPC (admin_audience_members /
//   admin_audience_counts) থেকে, Supabase-এ তৈরি।
// - নতুন বক্স "লগইন ছাড়া ইনস্টলড অ্যাপ": শুধু অফার-প্রমো ক্যাটাগরিতে চালু।
//   /api/push/guest-broadcast দিয়ে guest_push_devices-এর সব টোকেনে পুশ যায়
//   এবং guest_promos-এ সেভ হয় (গেস্টরা মেসেজ বক্সে "অফার ও খবর" দেখে)।
//   গেস্ট ডিভাইসে "কে পড়েছে" ট্র্যাকিং নেই, শুধু কতটি ডিভাইসে গেছে তার লগ।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="নোটিফিকেশন পাঠান | অ্যাডমিন">
  <div class="admin-page">
    <div class="container">

      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i> ড্যাশবোর্ড</a>

        <div class="admin-header">
          <h1>নোটিফিকেশন পাঠান</h1>
          <p class="admin-subtitle">নির্দিষ্ট ইউজারকে অথবা সবাইকে কাস্টম মেসেজ পাঠান</p>
        </div>

        <div class="compose-card">
          <div class="target-tabs">
            <button class="target-tab active" data-target="single" type="button">নির্দিষ্ট ইউজার</button>
            <button class="target-tab" data-target="broadcast" type="button">সবাই / গ্রুপ</button>
          </div>

          <!-- নির্দিষ্ট ইউজার সার্চ -->
          <div id="singleTargetPanel" class="target-panel">
            <label class="field-label">ফোন নাম্বার দিয়ে ইউজার খুঁজুন</label>
            <div class="search-row">
              <input type="text" id="userSearchInput" placeholder="01xxxxxxxxx" />
              <button id="userSearchBtn" type="button">খুঁজুন</button>
            </div>
            <div id="userSearchResult" class="user-search-result"></div>
          </div>

          <!-- অডিয়েন্স: সব ইউজার / গ্রুপ ভিত্তিক বাছাই / লগইন ছাড়া ডিভাইস -->
          <div id="broadcastTargetPanel" class="target-panel" style="display:none;">
            <label class="aud-all-row">
              <input type="checkbox" id="audAll" checked />
              <span><strong>সব ইউজার</strong> <small id="audAllCount"></small></span>
            </label>
            <p class="broadcast-note" id="audAllNote">
              <i class="fas fa-triangle-exclamation"></i>
              এই মেসেজ <strong>সব রেজিস্টার্ড ইউজারের</strong> কাছে যাবে এবং পুশ নোটিফিকেশনও যাবে। নির্দিষ্ট গ্রুপে পাঠাতে উপরের টিক তুলে দিন। সতর্কতার সাথে ব্যবহার করুন।
            </p>

            <div id="audGroupsWrap" style="display:none;">
              <label class="field-label">উপজেলা ফিল্টার (তালিকা ছোট করতে ও "সবাইকে সিলেক্ট"-এর জন্য)</label>
              <div id="audUpazilaChips" class="aud-chips"></div>
              <div id="audGroups"></div>
            </div>

            <div class="aud-guest-box">
              <label class="aud-all-row" style="margin:0;">
                <input type="checkbox" id="audGuest" checked />
                <span><strong>লগইন ছাড়া ইনস্টলড অ্যাপ</strong> <small id="audGuestCount"></small></span>
              </label>
              <p class="aud-guest-hint" id="audGuestHint"></p>
            </div>

            <p class="aud-summary" id="audSummary">প্রাপক: ...</p>
          </div>

          <!-- ক্যাটাগরি সিলেক্টর -->
          <label class="field-label">নোটিফিকেশনের ধরন</label>
          <div class="category-tabs">
            <button class="category-tab active" data-category="message" type="button">
              <i class="fas fa-comment"></i> সাধারণ মেসেজ
            </button>
            <button class="category-tab" data-category="promo" type="button">
              <i class="fas fa-tags"></i> অফার-প্রমো
            </button>
          </div>
          <p class="category-hint" id="categoryHint">উচ্চ গুরুত্বে (high) পাঠানো হবে। ইউজার ফোনের সেটিংসে "মেসেজ" চ্যানেল বন্ধ করলে ফোনে পুশ আসবে না, তবে অ্যাপের বেলে থাকবে</p>

          <label class="field-label" style="margin-top: 14px;">মেসেজ</label>
          <textarea id="messageInput" rows="4" placeholder="মেসেজ লিখুন..."></textarea>

          <!-- ছবি আপলোড (ঐচ্ছিক) -->
          <label class="field-label" style="margin-top: 14px;">ছবি (ঐচ্ছিক)</label>
          <label for="imageInput" class="image-upload-box" id="imageUploadBox">
            <img id="imagePreview" src="" alt="প্রিভিউ" style="display:none;" />
            <span id="imageUploadPlaceholder"><i class="fas fa-image"></i> ছবি যোগ করুন (সর্বোচ্চ ২MB)</span>
            <button type="button" id="imageRemoveBtn" style="display:none;" aria-label="ছবি সরান">
              <i class="fas fa-xmark"></i>
            </button>
          </label>
          <input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp" style="display:none;" />
          <p class="send-feedback" id="imageFeedback"></p>

          <!-- লিংক করা আইটেম (ঐচ্ছিক) — নির্দিষ্ট শপ/ক্লাব/
               লিস্টিং সার্চ করে সিলেক্ট করলে সেই নামটাই নোটিফিকেশনে
               ক্লিকযোগ্য বাটন হয়ে যাবে, সরাসরি সেই পেজে নিয়ে যাবে -->
          <label class="field-label" style="margin-top: 14px;">লিংক করা আইটেম (ঐচ্ছিক)</label>
          <div class="search-row">
            <input type="text" id="linkSearchInput" placeholder="শপ/ক্লাব/লিস্টিং এর নাম লিখুন..." />
            <button id="linkSearchBtn" type="button">খুঁজুন</button>
          </div>
          <div id="linkSearchResult" class="link-search-result"></div>
          <div class="selected-link-chip" id="selectedLinkChip">
            <span id="selectedLinkLabel"></span>
            <button type="button" id="selectedLinkRemoveBtn" aria-label="সরান"><i class="fas fa-xmark"></i></button>
          </div>

          <p class="send-feedback" id="sendFeedback"></p>

          <button id="sendBtn" class="send-btn" type="button" disabled>
            <i class="fas fa-paper-plane"></i> পাঠান
          </button>
        </div>

        <div class="log-section">
          <h2>সাম্প্রতিক পাঠানো</h2>
          <div id="logContainer" class="log-container"></div>
          <div id="logEmptyState" class="empty-state" style="display:none;">
            <i class="fas fa-inbox"></i>
            <p>এখনো কোনো নোটিফিকেশন পাঠানো হয়নি</p>
          </div>
        </div>

        <!-- ===== "কে কে পড়েছে" বটম-শিট ===== -->
        <div id="readersOverlay" class="readers-overlay" style="display:none;">
          <div class="readers-sheet" role="dialog" aria-modal="true" aria-labelledby="readersTitle">
            <div class="readers-head">
              <div class="readers-head-text">
                <h3 id="readersTitle">কে কে পড়েছে</h3>
                <p id="readersMsg" class="readers-msg"></p>
              </div>
              <div class="readers-head-actions">
                <button id="readersRefresh" type="button" aria-label="রিফ্রেশ"><i class="fas fa-rotate"></i></button>
                <button id="readersClose" type="button" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
              </div>
            </div>

            <div class="readers-tabs">
              <button type="button" class="readers-tab active" data-filter="all">সব <span id="rcAll"></span></button>
              <button type="button" class="readers-tab" data-filter="read">পড়েছে <span id="rcRead"></span></button>
              <button type="button" class="readers-tab" data-filter="unread">পড়েনি <span id="rcUnread"></span></button>
            </div>

            <input type="text" id="readersSearch" class="readers-search" placeholder="নাম বা ফোন দিয়ে খুঁজুন..." />

            <div id="readersList" class="readers-list"></div>
            <button id="readersMore" class="readers-more" type="button" style="display:none;">আরও দেখুন</button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <style is:global>
    .admin-page {
      min-height: 60vh;
      padding: 32px 0 80px;
    }

    .admin-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .admin-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #5A6E85;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .back-link:hover {
      color: #FF6B35;
    }

    .admin-header {
      margin-bottom: 20px;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .admin-subtitle {
      font-size: 0.85rem;
      color: #8FA0BC;
      margin-top: 4px;
      font-weight: 600;
    }

    .compose-card {
      background: #fff;
      border-radius: 18px;
      padding: 22px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
      margin-bottom: 32px;
    }

    .target-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      background: #F4F7FC;
      border-radius: 40px;
      padding: 4px;
    }

    .target-tab {
      flex: 1;
      border: none;
      background: transparent;
      padding: 10px 12px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.85rem;
      color: #5A6E85;
      cursor: pointer;
    }

    .target-tab.active {
      background: #1B2A4A;
      color: #fff;
    }

    .target-panel {
      margin-bottom: 16px;
    }

    /* ===== ক্যাটাগরি ট্যাব ===== */
    .category-tabs {
      display: flex;
      gap: 8px;
    }

    .category-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 1.5px solid #E5EAF0;
      background: #fff;
      padding: 10px 12px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.82rem;
      color: #5A6E85;
      cursor: pointer;
    }

    .category-tab.active {
      border-color: #FF6B35;
      background: #FFF0EA;
      color: #FF6B35;
    }

    .category-hint {
      font-size: 0.74rem;
      color: #9AA8BC;
      margin-top: 6px;
    }

    .field-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: #5A6E85;
      margin-bottom: 6px;
    }

    .search-row {
      display: flex;
      gap: 8px;
    }

    .search-row input {
      flex: 1;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.88rem;
      font-family: inherit;
    }

    .search-row button {
      background: #1B2A4A;
      color: #fff;
      border: none;
      padding: 0 18px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .user-search-result {
      margin-top: 10px;
    }

    .user-result-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 14px;
      background: #F8FAFC;
      border-radius: 12px;
      margin-bottom: 6px;
      cursor: pointer;
      border: 2px solid transparent;
    }

    .user-result-item.selected {
      border-color: #FF6B35;
      background: #FFF0EA;
    }

    .user-result-name {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .user-result-phone {
      font-size: 0.78rem;
      color: #8FA0BC;
    }

    .no-user-found {
      font-size: 0.82rem;
