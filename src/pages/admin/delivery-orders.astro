    function esc(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function bn(value) {
      return String(value).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
    }

    function money(value) {
      if (value === null || value === undefined || value === '') return '—';
      return '৳' + bn(Math.round(Number(value)));
    }

    function timeAgo(iso) {
      if (!iso) return '';
      const diff = Math.max(0, Date.now() - new Date(iso).getTime());
      const m = Math.floor(diff / 60000);
      if (m < 1) return 'এইমাত্র';
      if (m < 60) return bn(m) + ' মিনিট আগে';
      const h = Math.floor(m / 60);
      if (h < 24) return bn(h) + ' ঘণ্টা আগে';
      return bn(Math.floor(h / 24)) + ' দিন আগে';
    }

    function fullDate(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('bn-BD', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    }

    function catIcon(cat) { return cat === 'ride' ? '🏍️' : '📦'; }
    function catName(cat) { return cat === 'ride' ? 'রাইড' : 'ডেলিভারি'; }

    // ================= স্টেট =================
    const state = {
      tab: 'live',
      cat: '',
      filter: '',
      status: '',
      upazila: '',
      from: '',
      to: '',
      q: '',
      offset: 0,
      total: 0,
      loading: false,
      feed: [],
      feedOldestId: null,
      group: 'all',
      selected: new Set(),
      inbox: null,
      currentOrder: null,
      sound: true,
      initialized: false,
    };

    try { state.sound = localStorage.getItem('sf_do_sound') !== 'off'; } catch (e) { /* স্টোরেজ না থাকলে সমস্যা নেই */ }

    // ================= বীপ =================
    let audioCtx = null;
    function beep() {
      if (!state.sound) return;
      try {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.value = 880;
        gain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.25, audioCtx.currentTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.45);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.5);
      } catch (e) { /* ব্রাউজার ব্লক করলে চুপচাপ বাদ */ }
    }

    function renderSoundBtn() {
      const btn = $('doSoundBtn');
      btn.classList.toggle('off', !state.sound);
      btn.innerHTML = state.sound ? '<i class="fas fa-bell"></i>' : '<i class="fas fa-bell-slash"></i>';
    }

    // ================= সামারি =================
    async function loadOverview() {
      const [ov, ib] = await Promise.all([
        supabase.rpc('admin_orders_overview'),
        supabase.rpc('admin_delivery_inbox_counts'),
      ]);
      if (ib && !ib.error && ib.data) { state.inbox = ib.data; paintInbox(); }
      const { data, error } = ov;
      if (error || !data) return;
      $('stToday').textContent = bn(data.today_total ?? 0);
      // পাবলিশের অপেক্ষার অর্ডার (pending/hold) "চলমান"-এর গোনায় নয়, ওগুলো "নতুন" ট্যাবে
      const unpub = state.inbox ? (state.inbox.pending || 0) + (state.inbox.hold || 0) : 0;
      const live = Math.max(0, (data.live_open || 0) + (data.live_confirmed || 0) + (data.live_delivered || 0) + (data.disputed || 0) - unpub);
      $('stLive').textContent = bn(live);
      $('stDispute').textContent = bn(data.disputed ?? 0);
      $('stDisputeBox').classList.toggle('has', (data.disputed || 0) > 0);
      $('stDone').textContent = bn(data.today_completed ?? 0);
      $('stCancel').textContent = bn(data.today_cancelled ?? 0);
      $('stRiders').textContent = bn(data.online_riders ?? 0);

      const tabCount = $('tabLiveCount');
      tabCount.textContent = bn(live);
      tabCount.classList.toggle('show', live > 0);

      const chip = $('noOfferChip');
      chip.textContent = '⏳ অফারহীন' + (data.no_offer ? ' (' + bn(data.no_offer) + ')' : '');
    }

    // ================= স্ট্যাটাস ফিল্টারের অপশন =================
    function fillStatusOptions() {
      const sel = $('fStatus');
      const opts = state.tab === 'history'
        ? [['', 'সব স্ট্যাটাস'], ['completed', 'সম্পন্ন'], ['cancelled', 'বাতিল'], ['expired', 'মেয়াদ শেষ']]
        : [['', 'সব স্ট্যাটাস'], ['open', 'খোলা'], ['confirmed', 'কনফার্ম'], ['delivered', 'ডেলিভারড'], ['disputed', 'ডিসপিউট']];
      sel.innerHTML = opts.map(([v, l]) => `<option value="${v}">${l}</option>`).join('');
      sel.value = state.status;
      if (sel.value !== state.status) { state.status = ''; sel.value = ''; }
    }

    // ================= অর্ডার কার্ড =================
    const DOTS_SVG = '<svg width="20" height="20" viewBox="0 0 24 24" fill="#1B2A4A" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>';
    const TICK_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';

    function shopNamesOf(o) {
      const names = [];
      (Array.isArray(o.order_items) ? o.order_items : []).forEach((i) => {
        if (i.shop_name && names.indexOf(i.shop_name) === -1) names.push(i.shop_name);
      });
      return names;
    }

    // নতুন ট্যাবের কার্ড (মকআপ AdminNew)
    function newOrderCard(o, fresh) {
      const hold = o.publish_status === 'hold';
      const customer = o.customer || {};
      const shops = shopNamesOf(o);
      const pa = splitMapLink(o.pickup_address || '').text;
      const from = shops.length ? '<b>' + esc(shops.join(', ')) + '</b>' : esc(pa ? (pa.length > 28 ? pa.slice(0, 28) + '…' : pa) : 'পিকআপ');
      const where = [o.drop_union, o.upazila].filter(Boolean).map((x, i) => (i === 0 && o.drop_union ? '<b>' + esc(x) + '</b>' : esc(x))).join(', ');
      const items = Array.isArray(o.order_items) ? o.order_items : [];
      const itemsTxt = items.map((i) => (i.name || '') + (Number(i.qty) > 1 ? ' × ' + bn(i.qty) : '')).join(', ');
      const hasTotal = o.items_total !== null && o.items_total !== undefined;
      const sum = items.length
        ? esc(itemsTxt) + (hasTotal ? ' · আইটেম ' + money(o.items_total) : '')
        : esc(splitMapLink(o.description || '').text || 'কাস্টমারের লেখা অর্ডার');
      const chip = hold
        ? '<span class="do2-chip blue">অপেক্ষায় রাখা হয়েছে</span>'
        : (o.auto_publish_at ? `<span class="do2-chip y" data-eta="${esc(o.auto_publish_at)}">অটো-পাবলিশ <b></b></span>` : '<span class="do2-chip y">পাবলিশের অপেক্ষায়</span>');
      const phone = customer.phone ? `<a class="do2-mi" href="tel:${esc(customer.phone)}" data-mact="call">কাস্টমারকে কল</a>` : '';

      return `
        <div class="do-card do2-card ${fresh ? 'fresh' : ''}" data-no="${esc(o.order_no)}" data-id="${esc(o.id)}" data-eff="${esc(o.eff_status || o.status)}" data-cat="${esc(o.category)}" data-upazila="${esc(o.upazila || '')}" data-price="${esc(o.price ?? '')}" data-ps="${esc(o.publish_status || '')}">
          <div class="do2-row">
            <div class="do2-l"><div class="do2-no">${esc(o.order_no)}</div>${chip}</div>
            <button type="button" class="do2-dots" data-act="menu" aria-label="আরও অপশন">${DOTS_SVG}</button>
          </div>
          <div class="do2-line">${from} থেকে ${where || esc(o.upazila || '')}</div>
          ${o.is_asap === false && o.scheduled_at ? `<div class="do2-line" style="font-weight:800;color:#7A3E00;">🕐 শিডিউল: ${esc(new Date(o.scheduled_at).toLocaleString('bn-BD', { timeZone: 'Asia/Dhaka', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }))}</div>` : ''}
          <div class="do2-sum">${sum}</div>
          <button type="button" class="do2-cta" data-act="publish">পাবলিশ</button>
          <div class="do2-two">
            <button type="button" class="do2-ghost" data-act="assign">দাম ঠিক করে নিজস্ব রাইডার</button>
            <button type="button" class="do2-ghost" data-act="${hold ? 'unhold' : 'hold'}">${hold ? 'টাইমার চালু করুন' : 'অপেক্ষায় রাখুন'}</button>
          </div>
          <div class="do2-menu">
            <button type="button" class="do2-mi red" data-mact="cancel">বাতিল করুন</button>
            <button type="button" class="do2-mi" data-mact="note">নোট যোগ করুন</button>
            ${phone}
            <button type="button" class="do2-mi" data-mact="deal">💬 ডিল চ্যাট</button>
            <button type="button" class="do2-mi" data-mact="chat">চ্যাট দেখুন</button>
            <button type="button" class="do2-mi" data-mact="timer">টাইমার বদলান</button>
            <button type="button" class="do2-mi" data-mact="dispute">ডিসপিউট খুলুন</button>
          </div>
        </div>`;
    }

    function orderCard(o, { fresh = false } = {}) {
      const eff = o.eff_status || o.status;
      const unpub = o.status === 'open' && (o.publish_status === 'pending' || o.publish_status === 'hold');
      if (unpub && state.tab === 'new' && !state.q) return newOrderCard(o, fresh);

      // ঠিকানায় ম্যাপ লিংক থাকলে কার্ডে লিংক দেখাই না (ডিটেইলে "নেভিগেট করুন" বাটন)
      const pa = splitMapLink(o.pickup_address || '').text;
      const da = splitMapLink(o.drop_address || '').text;
      const route = pa && da
        ? `${esc(pa)} → ${esc(da)}`
        : esc(da || pa || o.description || '');
      const itemsTxt = Array.isArray(o.order_items) && o.order_items.length
        ? o.order_items.map((i) => (i.name || '') + (Number(i.qty) > 1 ? ' ×' + bn(i.qty) : '')).join(', ')
        : '';
      const customer = o.customer || {};
      const rider = o.rider;
      const canAlert = eff === 'open' && !unpub;
      const roleTag = o.role ? `<span class="do-role">${o.role === 'customer' ? 'কাস্টমার' : 'রাইডার'} হিসেবে</span>` : '';

      return `
        <div class="do-card ${fresh ? 'fresh' : ''}" data-no="${esc(o.order_no)}" data-id="${esc(o.id)}" data-eff="${esc(eff)}" data-cat="${esc(o.category)}" data-upazila="${esc(o.upazila || '')}" data-price="${esc(o.price ?? '')}">
          <div class="do-card-top">
            <span class="do-no ${o.category === 'ride' ? 'ride' : ''}">${catIcon(o.category)} ${esc(o.order_no)}</span>
            <span style="display:flex;gap:6px;align-items:center;">${roleTag}<span class="do-badge ${unpub ? 's-confirmed' : 's-' + esc(eff)}">${unpub ? (o.publish_status === 'hold' ? 'অপেক্ষায় রাখা হয়েছে' : 'পাবলিশের অপেক্ষায়') : (STATUS_LABEL[eff] || esc(eff))}</span></span>
          </div>
          <p class="do-route">${route || '—'}<small>${esc(o.upazila || '')}${o.drop_union ? ' · ' + esc(o.drop_union) : ''}${o.area_detail ? ' · ' + esc(o.area_detail) : ''}</small></p>
          ${itemsTxt ? `<p class="do-items">${esc(itemsTxt)}</p>` : ''}
          <div class="do-meta">
            <span class="do-price">${money(o.price)}</span>
            <span><i class="fas fa-user"></i>${esc(customer.name || 'কাস্টমার')}</span>
            ${rider ? `<span><i class="fas fa-motorcycle"></i>${esc(rider.name || 'হিরো')}</span>` : ''}
            ${eff === 'open' ? `<span><i class="fas fa-comments-dollar"></i>${bn(o.offers_count || 0)} অফার</span>` : ''}
            ${o.items_total !== null && o.items_total !== undefined ? `<span>আইটেম ${money(o.items_total)}</span>` : ''}
            <span><i class="fas fa-clock"></i>${timeAgo(o.created_at)}</span>
            ${o.is_asap === false && o.scheduled_at ? `<span style="font-weight:800;color:#7A3E00;">🕐 ${esc(new Date(o.scheduled_at).toLocaleString('bn-BD', { timeZone: 'Asia/Dhaka', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }))}</span>` : ''}
            ${eff === 'confirmed' && o.release_requested_at ? `<span style="font-weight:800;color:#B3261E;">🙋 ছাড়তে চান</span>` : ''}
            ${unpub && o.publish_status === 'pending' && o.auto_publish_at ? `<span class="do-eta" data-eta="${esc(o.auto_publish_at)}"><i class="fas fa-hourglass-half"></i> অটো-পাবলিশ <b></b></span>` : ''}
          </div>
          ${unpub ? `<div class="do-card-actions">
            <button type="button" class="do-btn primary-sm" data-act="publish">পাবলিশ</button>
            <button type="button" class="do-btn ghost" data-act="assign">রাইডারকে দিন</button>
            <button type="button" class="do-btn ghost" data-act="${o.publish_status === 'hold' ? 'unhold' : 'hold'}">${o.publish_status === 'hold' ? 'টাইমার চালু করুন' : 'অপেক্ষায় রাখুন'}</button>
          </div>` : canAlert ? `<div class="do-card-actions"><button type="button" class="do-btn alert" data-act="alert"><i class="fas fa-bell"></i> রাইডারদের এলার্ট দিন</button><button type="button" class="do-btn ghost" data-act="assign">রাইডারকে দিন</button></div>` : ''}
        </div>`;
    }

    // ================= লিস্ট লোড (লাইভ / হিস্ট্রি) =================
    let loadToken = 0;
    async function loadOrders({ reset = true, silent = false } = {}) {
      if (state.tab === 'feed' || state.tab === 'batch') return;
      const token = ++loadToken;
      if (reset) state.offset = 0;

      if (!silent) {
        $('doLoading').style.display = 'flex';
        if (reset) $('doList').innerHTML = '';
      }
      $('doEmpty').style.display = 'none';
      $('doMore').style.display = 'none';
      state.loading = true;

      const toIso = state.to ? new Date(state.to + 'T23:59:59').toISOString() : null;
      const fromIso = state.from ? new Date(state.from + 'T00:00:00').toISOString() : null;

      const { data, error } = await supabase.rpc('admin_search_orders', {
        p_query: state.q || null,
        // সার্চ চলাকালীন লাইভ + হিস্ট্রি দুটোতেই খুঁজি — যেকোনো সময়ের অর্ডার পাওয়া যাবে
        p_group: state.q ? 'all' : (state.tab === 'new' ? 'live' : state.tab),
        p_category: state.cat || null,
        p_status: state.status || null,
        p_upazila: state.upazila || null,
        p_from: fromIso,
        p_to: toIso,
        p_filter: (state.tab === 'new' && !state.q) ? 'unpublished' : (state.filter || null),
        p_limit: PAGE,
        p_offset: state.offset,
      });

      if (token !== loadToken) return; // নতুন রিকোয়েস্ট এসে গেছে, পুরনোটা বাদ
      state.loading = false;
      $('doLoading').style.display = 'none';

      if (error) {
        $('doList').innerHTML = `<p style="text-align:center;color:#D14343;padding:30px 0;">লোড করতে সমস্যা হয়েছে: ${esc(error.message)}</p>`;
        return;
      }

      const items = data?.items || [];
      state.total = data?.total || 0;

      // নতুন কার্ড হাইলাইট (silent রিফ্রেশে আগে না থাকা কার্ড)
      const existing = new Set([...$('doList').querySelectorAll('.do-card')].map((c) => c.dataset.no));
      const html = items.map((o) => orderCard(o, { fresh: silent && !existing.has(o.order_no) })).join('');

      if (reset) {
        $('doList').innerHTML = html;
      } else {
        $('doList').insertAdjacentHTML('beforeend', html);
      }

      renderUsers(data?.users || [], data?.mode);
      tickEta();

      const shown = $('doList').querySelectorAll('.do-card').length;
      if (shown === 0) {
        const msg = state.q
          ? 'এই সার্চে কোনো অর্ডার পাওয়া যায়নি'
          : state.tab === 'new' ? 'পাবলিশের অপেক্ষায় কোনো নতুন অর্ডার নেই ✅'
          : state.tab === 'live' ? 'এই মুহূর্তে কোনো চলমান অর্ডার নেই' : 'কোনো অর্ডার পাওয়া যায়নি';
        $('doEmpty').querySelector('p').textContent = msg;
        $('doEmpty').style.display = 'block';
      }
      $('doMore').style.display = shown < state.total ? 'block' : 'none';
      state.offset = shown;
    }

    // ================= ইউজার সামারি =================
    function renderUsers(users, mode) {
      const box = $('doUsers');
      if (mode !== 'user' || !users.length) {
        box.style.display = 'none';
        box.innerHTML = '';
        return;
      }
      box.style.display = 'flex';
      const note = users.length > 1
        ? `<p class="do-user-note">${bn(users.length)} জন ইউজার মিলেছে — সবার অর্ডার নিচে একসাথে দেখাচ্ছে।</p>` : '';
      box.innerHTML = note + users.map((u) => `
        <div class="do-user">
          <h4>${esc(u.name || 'নামহীন')}<small>${esc(u.phone || '')}</small></h4>
          <p class="do-user-sub">কাস্টমার হিসেবে</p>
          <div class="do-user-grid">
            <div><b>${bn(u.cust_total)}</b><span>মোট</span></div>
            <div><b>${bn(u.cust_completed)}</b><span>সম্পন্ন</span></div>
            <div><b>${bn(u.cust_cancelled)}</b><span>বাতিল</span></div>
            <div><b>${bn(u.cust_disputed)}</b><span>ডিসপিউট</span></div>
          </div>
          ${u.rider_total > 0 ? `
            <p class="do-user-sub">রাইডার/হিরো হিসেবে</p>
            <div class="do-user-grid" style="grid-template-columns:repeat(2,1fr);">
              <div><b>${bn(u.rider_total)}</b><span>মোট জব</span></div>
              <div><b>${bn(u.rider_completed)}</b><span>সম্পন্ন</span></div>
            </div>` : ''}
        </div>`).join('');
    }

    // ================= ফিড =================
    function feedItem(ev, { fresh = false } = {}) {
      const info = EVENT_INFO[ev.event_type] || { icon: '•', text: ev.event_type };
      let extra = '';
      if (ev.event_type === 'offer_made' && ev.meta?.price) extra = ' · ' + money(ev.meta.price);
      if (ev.event_type === 'rider_alert' && ev.meta?.sent !== undefined) extra = ' · ' + bn(ev.meta.sent) + ' জনকে';
      const note = ev.note && ev.event_type !== 'rider_alert' ? `<small>${esc(ev.note)}</small>` : '';
      const who = ev.actor_name && ['rider_alert', 'dispute_resolved'].includes(ev.event_type) ? ` (${esc(ev.actor_name)})` : '';
      return `
        <div class="do-feed-item ${fresh ? 'do-card fresh' : ''}" data-no="${esc(ev.order_no)}" data-feed="1">
          <span class="do-feed-ic">${info.icon}</span>
          <div class="do-feed-body">
            <b>${catIcon(ev.category)} #${esc(ev.order_no)} — ${info.text}${esc(extra)}${who}</b>
            <small>${esc(ev.upazila || '')}</small>
            ${note}
          </div>
          <span class="do-feed-time">${timeAgo(ev.created_at)}</span>
        </div>`;
    }

    async function loadFeed({ more = false, silent = false } = {}) {
      if (!silent) $('doLoading').style.display = 'flex';
      $('doEmpty').style.display = 'none';
      $('doMore').style.display = 'none';

      const { data, error } = await supabase.rpc('admin_order_feed', {
        p_limit: 40,
        p_before: more ? state.feedOldestId : null,
      });

      $('doLoading').style.display = 'none';
      if (error) {
        $('doList').innerHTML = `<p style="text-align:center;color:#D14343;padding:30px 0;">ফিড লোড করতে সমস্যা: ${esc(error.message)}</p>`;
        return;
      }

      const items = data || [];
      if (more) {
        state.feed = state.feed.concat(items);
        $('doList').insertAdjacentHTML('beforeend', items.map((e) => feedItem(e)).join(''));
      } else {
        const known = new Set(state.feed.map((e) => e.id));
        state.feed = items;
        $('doList').innerHTML = items.map((e) => feedItem(e, { fresh: silent && !known.has(e.id) })).join('');
      }
      if (state.feed.length) state.feedOldestId = state.feed[state.feed.length - 1].id;

      if (state.feed.length === 0) {
        $('doEmpty').querySelector('p').textContent = 'এখনো কোনো আপডেট নেই';
        $('doEmpty').style.display = 'block';
      }
      $('doMore').style.display = items.length >= 40 ? 'block' : 'none';
    }

    // ================= ট্যাব / রিফ্রেশ =================
    function applyTabUi() {
      document.querySelectorAll('.do-tab').forEach((t) => t.classList.toggle('active', t.dataset.tab === state.tab));
      const isFeed = state.tab === 'feed';
      const isBatch = state.tab === 'batch';
      const isNew = state.tab === 'new';
      $('doFilters').style.display = (isFeed || isBatch) ? 'none' : '';
      $('fStatus').style.display = isNew ? 'none' : '';
      $('batchSeg').style.display = isBatch ? 'flex' : 'none';
      gateVisible();
      $('dateRow').style.display = state.tab === 'history' ? 'flex' : 'none';
      $('noOfferChip').style.display = state.tab === 'live' ? '' : 'none';
      $('doUsers').style.display = (isFeed || isBatch) ? 'none' : $('doUsers').style.display;
      fillStatusOptions();
      document.querySelectorAll('#catChips .do-chip[data-cat]').forEach((c) => c.classList.toggle('active', c.dataset.cat === state.cat));
      $('noOfferChip').classList.toggle('active', state.filter === 'no_offer');
    }

    function syncUrl() {
      try {
        const p = new URLSearchParams();
        if (state.tab !== 'live') p.set('tab', state.tab);
        if (state.filter) p.set('filter', state.filter);
        if (state.q) p.set('q', state.q);
        const open = state.currentOrder;
        if (open) p.set('open', open);
        const qs = p.toString();
        history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
      } catch (e) { /* ইউআরএল আপডেট না হলেও সমস্যা নেই */ }
    }

    function refreshCurrent({ silent = true } = {}) {
      if (state.tab === 'feed') return loadFeed({ silent });
      if (state.tab === 'batch') return loadBatches({ silent });
      return loadOrders({ reset: true, silent });
    }

    function switchTab(tab) {
      state.tab = tab;
      state.status = '';
      if (tab !== 'live') state.filter = '';
      if (tab === 'history') { state.from = ''; state.to = ''; $('fFrom').value = ''; $('fTo').value = ''; }
      applyTabUi();
      syncUrl();
      if (tab === 'feed') {
        $('doUsers').style.display = 'none';
        $('doList').innerHTML = '';
        loadFeed();
      } else if (tab === 'batch') {
        $('doUsers').style.display = 'none';
        loadBatches();
      } else {
        loadOrders();
      }
    }

    // ================= পেমেন্ট প্রুফ lightbox =================
    function openLightbox(url) {
      $('doLightboxImg').src = url;
      $('doLightbox').classList.add('active');
    }

    function closeLightbox() {
      $('doLightbox').classList.remove('active');
      $('doLightboxImg').src = '';
    }

    // অর্ডারের পেমেন্ট প্রুফ ছবি আনা (admin RLS) + signed URL বানানো। ব্যর্থ হলে খালি লিস্ট।
    async function loadProofUrls(requestId) {
      try {
        const { data } = await supabase
          .from('delivery_payment_proofs')
          .select('image_urls')
          .eq('request_id', requestId);
        const raw = (data || []).flatMap((p) => p.image_urls || []);
        if (raw.length === 0) return [];
        return await getSignedUrls(supabase, PROOF_BUCKET, raw);
      } catch (e) {
        return [];
      }
    }

    // ================= ডিটেইল মোডাল =================
    let cooldownTimer = null;

    function openOverlay(id) { $(id).classList.add('active'); document.body.style.overflow = 'hidden'; }
    function closeOverlay(id) {
      $(id).classList.remove('active');
      if (!document.querySelector('.do-overlay.active')) document.body.style.overflow = '';
    }

    async function openDetail(key) {
      if (!key) return;
      openOverlay('doDetailOverlay');
      $('doDetailBody').innerHTML = '<div class="do-inline-loading"><div class="do-spinner"></div></div>';

      const { data, error } = await supabase.rpc('admin_get_order', { p_key: key });
      if (error || !data) {
        $('doDetailBody').innerHTML = `<p style="text-align:center;padding:40px 0;color:#D14343;">${error ? 'লোড করতে সমস্যা: ' + esc(error.message) : 'এই নাম্বারে কোনো অর্ডার পাওয়া যায়নি'}</p>`;
        return;
      }

      const o = data.order;
      state.currentOrder = o.order_no;
      state.currentDetail = data;
      syncUrl();

      const eff = o.eff_status;
      const c = data.customer || {};
      const r = data.rider;
      const price = o.price;
      const ps = o.publish_status;
      const unpub = o.status === 'open' && (ps === 'pending' || ps === 'hold');
      const items = Array.isArray(o.order_items) ? o.order_items : [];
      const itemsTotal = o.items_total !== null && o.items_total !== undefined ? Number(o.items_total) : null;
      const coordsOf = (la, ln) => (la !== null && la !== undefined && ln !== null && ln !== undefined ? { lat: la, lng: ln } : undefined);

      const proofUrls = await loadProofUrls(o.id);

      const offersHtml = (data.offers || []).length
        ? data.offers.map((f) => `
            <div class="do-offer">
              <span>${esc(f.name || 'হিরো')} <small style="color:#9AA8BC;">${esc(f.phone || '')}</small></span>
              <span><b class="do-price">${money(f.price)}</b> <span class="do-badge s-${f.status === 'active' ? 'open' : 'cancelled'}">${esc(f.status)}</span></span>
            </div>`).join('')
        : '<p class="do-text" style="color:#9AA8BC;">কোনো অফার আসেনি</p>';

      const tlHtml = (data.events || []).map((ev) => {
        const info = EVENT_INFO[ev.event_type] || { icon: '•', text: ev.event_type };
        let extra = '';
        if (ev.event_type === 'offer_made' && ev.meta?.price) extra = ' (' + money(ev.meta.price) + ')';
        if (ev.event_type === 'rider_alert' && ev.meta?.sent !== undefined) extra = ' (' + bn(ev.meta.sent) + ' জনকে)';
        const sub = [ev.actor_name, ev.note && ev.event_type !== 'rider_alert' ? ev.note : ''].filter(Boolean).map(esc).join(' · ');
        return `<li>${info.icon} ${info.text}${esc(extra)}<small>${fullDate(ev.created_at)}${sub ? ' · ' + sub : ''}</small></li>`;
      }).join('');

      const disputeHtml = (o.dispute_reason || eff === 'disputed' || o.disputed_at) ? `
        <div class="do-sec">
          <h5>ডিসপিউট</h5>
          <div class="do-reason">${esc(o.dispute_reason || 'কারণ উল্লেখ নেই')}</div>
          ${o.dispute_resolution ? `<p class="do-text" style="margin-top:8px;"><b>সিদ্ধান্ত:</b> ${o.dispute_resolution === 'resolve_completed' ? 'রাইডারের পক্ষে (সম্পন্ন)' : o.dispute_resolution === 'resolve_cancelled' ? 'ডিল বাতিল' : o.dispute_resolution === 'reassigned' ? 'নতুন রাইডারকে দেওয়া হয়েছে' : o.dispute_resolution === 'reopened' ? 'মার্কেটে ফেরত দেওয়া হয়েছে' : o.dispute_resolution === 'admin_cancelled' ? 'অ্যাডমিন বাতিল করেছেন' : esc(o.dispute_resolution)}</p>` : ''}
          ${eff === 'disputed' ? `<a class="do-btn blue" style="margin-top:8px;text-decoration:none;" href="/admin/delivery-disputes?q=${encodeURIComponent(o.order_no)}"><i class="fas fa-scale-balanced"></i> ডিসপিউট পেজে রিজলভ করুন</a>` : ''}
        </div>` : '';

      const releaseHtml = (eff === 'confirmed' && o.release_requested_at) ? `
        <div class="do-sec">
          <h5>🙋 রাইডার ছাড়তে চান</h5>
          <div class="do-reason">${esc(o.release_reason || 'কারণ উল্লেখ নেই')}</div>
          <p class="do-text" style="margin-top:6px;color:#8FA0BC;font-size:0.76rem;">অনুরোধ: ${fullDate(o.release_requested_at)}। অনুমোদনের আগে অর্ডারটা এই রাইডারেরই দায়িত্বে। চাইলে নিচের "রাইডার বদলান" দিয়ে সরাসরি অন্য রাইডারও দিতে পারেন।</p>
          <div class="do-actions" style="margin-top:8px;">
            <button type="button" class="do-btn primary-sm" id="relApproveBtn">✅ অনুমোদন (মার্কেটে ফেরান)</button>
            <button type="button" class="do-btn ghost" id="relRejectBtn">✖ না, রাইডারই করবেন</button>
          </div>
        </div>` : '';

      const canCancel = ['open', 'confirmed', 'delivered', 'disputed'].includes(eff);

      const cancelInfoHtml = (eff === 'cancelled' && o.cancel_reason) ? `
        <div class="do-sec">
          <h5>বাতিলের কারণ</h5>
          <div class="do-reason">${esc(o.cancel_reason)}</div>
          ${o.cancelled_at ? `<p class="do-text" style="margin-top:6px;color:#8FA0BC;font-size:0.76rem;">অ্যাডমিন/মডারেটর কর্তৃক · ${fullDate(o.cancelled_at)}</p>` : ''}
        </div>` : '';

      const proofsHtml = proofUrls.length > 0 ? `
        <div class="do-sec">
          <h5>পেমেন্ট প্রুফ (${bn(proofUrls.length)})</h5>
          <div class="do-proofs">
            ${proofUrls.map((u) => `<div class="do-proof-thumb" data-img="${esc(u)}"><img src="${esc(u)}" alt="পেমেন্ট প্রুফ" loading="lazy" /></div>`).join('')}
          </div>
        </div>` : '';

      $('doDetailBody').innerHTML = `
        <h3 class="do-sheet-title">${catIcon(o.category)} #${esc(o.order_no)} <span class="do-badge ${unpub ? 's-confirmed' : 's-' + esc(eff)}" style="margin-left:6px;">${unpub ? (ps === 'hold' ? '⏸️ হোল্ডে' : '🕒 পাবলিশের অপেক্ষায়') : (STATUS_LABEL[eff] || esc(eff))}</span></h3>
        <p class="do-sheet-sub">${catName(o.category)} · তৈরি: ${fullDate(o.created_at)} · ${timeAgo(o.created_at)}</p>
        ${o.is_asap === false && o.scheduled_at ? `<p class="do-text" style="font-weight:800;color:#7A3E00;margin:2px 0 8px;">🕐 শিডিউল: ${fullDate(o.scheduled_at)}</p>` : ''}

        <div class="do-sec">
          <h5>রুট</h5>
          <div class="do-text"><b>পিকআপ:</b><div id="doPickupAddr" class="do-addr"></div>${o.pickup_instructions ? `<small style="color:#8FA0BC;">${esc(o.pickup_instructions)}</small>` : ''}</div>
          <div class="do-text" style="margin-top:8px;"><b>${o.category === 'ride' ? 'গন্তব্য' : 'ডেলিভারি'}:</b><div id="doDropAddr" class="do-addr"></div>${o.drop_instructions ? `<small style="color:#8FA0BC;">${esc(o.drop_instructions)}</small>` : ''}</div>
          <p class="do-text" style="margin-top:8px;color:#5A6E85;">${esc(o.upazila || '')}${o.pickup_union ? ' · পিকআপ: ' + esc(o.pickup_union) : ''}${o.drop_union ? ' · ড্রপ: ' + esc(o.drop_union) : ''}${o.vehicle_type ? ' · বাহন: ' + esc(o.vehicle_type) : ''}${o.seat_count ? ' · সিট: ' + bn(o.seat_count) : ''}</p>
        </div>

        ${o.description ? `<div class="do-sec"><h5>বিবরণ</h5><p class="do-text">${esc(o.description)}</p></div>` : ''}

        ${items.length ? `<div class="do-sec"><h5>আইটেম (${bn(items.length)})</h5>${items.map((i) => `<div class="do-offer"><span>${esc(i.name)} × ${bn(i.qty)}${i.shop_name ? ` <small style="color:#9AA8BC;">${esc(i.shop_name)}</small>` : ''}</span><b>${money(Number(i.price) * Number(i.qty))}</b></div>`).join('')}</div>` : ''}

        <div class="do-sec">
          <h5>দাম</h5>
          ${itemsTotal !== null ? `
            <div class="do-line"><span>আইটেমের দাম</span><b>${money(itemsTotal)}</b></div>
            <div class="do-line"><span>ডেলিভারি চার্জ</span><b class="do-price">${money(price)}</b></div>
            <div class="do-line tot"><span>মোট</span><b>${money(itemsTotal + Number(price || 0))}</b></div>` : `<p class="do-text"><span class="do-price" style="font-size:1.1rem;">${money(price)}</span></p>`}
          ${o.customer_asking_price ? `<p class="do-text" style="margin-top:4px;"><small style="color:#8FA0BC;">কাস্টমার চেয়েছেন ${money(o.customer_asking_price)}</small></p>` : ''}
          ${o.admin_fixed_price ? `<p class="do-text" style="margin-top:4px;"><small style="color:#B45309;font-weight:700;">অ্যাডমিন ঠিক করেছেন ${money(o.admin_fixed_price)}</small></p>` : ''}
        </div>

        <div class="do-sec">
          <h5>দুই পক্ষ</h5>
          <div class="do-parties">
            <div class="do-party"><small>কাস্টমার</small><b>${esc(c.name || '—')}</b>${c.phone ? `<a href="tel:${esc(c.phone)}"><i class="fas fa-phone"></i> ${esc(c.phone)}</a>` : ''}</div>
            <div class="do-party"><small>রাইডার / হিরো</small>${r ? `<b>${esc(r.name || '—')}</b>${r.phone ? `<a href="tel:${esc(r.phone)}"><i class="fas fa-phone"></i> ${esc(r.phone)}</a>` : ''}<small style="margin-top:3px;">${r.total_completed ? bn(r.total_completed) + 'টা সম্পন্ন' : ''}${r.avg_rating ? ' · ⭐ ' + bn(Number(r.avg_rating).toFixed(1)) : ''}</small>` : '<b style="color:#9AA8BC;">এখনো কেউ নেই</b>'}</div>
          </div>
        </div>

        <div class="do-sec"><h5>অফার (${bn((data.offers || []).length)})</h5>${offersHtml}</div>
        ${disputeHtml}
        ${releaseHtml}
        ${cancelInfoHtml}
        ${proofsHtml}

        <div class="do-sec"><h5>টাইমলাইন</h5><ul class="do-tl">${tlHtml || '<li>কোনো ইভেন্ট নেই</li>'}</ul></div>

        <div class="do-menu-wrap">
        <div class="do-actions">
          ${unpub ? `<button type="button" class="do-btn primary-sm" id="detailPublishBtn">🚀 পাবলিশ করুন</button>` : ''}
          ${unpub ? `<button type="button" class="do-btn blue" id="detailDealBtn">💬 ডিল চ্যাট</button>` : ''}
          ${o.status === 'open' ? `<button type="button" class="do-btn blue" id="detailAssignBtn">🛵 রাইডারকে দিন</button>` : ''}
          ${eff === 'disputed' ? `<button type="button" class="do-btn ghost" id="detailCancelBtn2" style="color:#B3261E;">❌ বাতিল করুন</button>` : ''}
          ${['confirmed', 'disputed'].includes(eff) ? `<button type="button" class="do-btn blue" id="detailTransferBtn">🔄 রাইডার বদলান</button>` : ''}
          ${eff === 'open' && !unpub ? `<button type="button" class="do-btn alert" id="detailAlertBtn"><i class="fas fa-bell"></i> রাইডারদের এলার্ট দিন</button>` : ''}
          <button type="button" class="do-btn ghost do-more-btn" id="detailMoreBtn" aria-label="আরও অপশন">⋯</button>
        </div>
        <div class="do-menu" id="detailMenu">
          ${unpub ? `<button type="button" class="do-menu-item" id="detailHoldBtn">${ps === 'hold' ? '▶️ হোল্ড ছাড়ুন (অটো-পাবলিশ টাইমার চালু)' : '⏸️ হোল্ডে রাখুন (অটো-পাবলিশ টাইমার বন্ধ)'}</button>` : ''}
          <button type="button" class="do-menu-item" id="detailNoteBtn">📝 নোট যোগ করুন</button>
          ${c.phone ? `<a class="do-menu-item" href="tel:${esc(c.phone)}">📞 কাস্টমারকে কল</a>` : ''}
          ${r && r.phone ? `<a class="do-menu-item" href="tel:${esc(r.phone)}">📞 রাইডারকে কল</a>` : ''}
          ${data.chat_count > 0 ? `<button type="button" class="do-menu-item" id="detailChatBtn">💬 চ্যাট দেখুন (${bn(data.chat_count)})</button>` : ''}
          <a class="do-menu-item" href="/admin/delivery-disputes?q=${encodeURIComponent(o.order_no)}">⚖️ ডিসপিউট</a>
          ${['confirmed', 'disputed'].includes(eff) ? `<button type="button" class="do-menu-item" id="detailReopenBtn">↩️ মার্কেটে ফেরত দিন</button>` : ''}
          ${canCancel ? `<button type="button" class="do-menu-item danger" id="detailCancelBtn">❌ অর্ডার বাতিল করুন</button>` : ''}
        </div>
        </div>
        <p class="do-cooldown" id="detailCooldown" style="display:none;"></p>`;

      const reviewRelease = async (ord, approve) => {
        let note = null;
        if (approve) {
          if (!window.confirm('ছাড়ার অনুরোধ অনুমোদন করলে অর্ডারটা আবার মার্কেটে যাবে। নিশ্চিত?')) return;
        } else {
          note = (window.prompt('রাইডারকে কী জানাতে চান? (ঐচ্ছিক)') || '').trim().slice(0, 300) || null;
        }
        const { data: res, error } = await supabase.rpc('admin_review_release', { p_request_id: ord.id, p_approve: approve, p_note: note });
        if (error || !res?.ok) {
          const msgs = {
            no_request: 'এই অনুরোধ আর খোলা নেই।',
            already_picked_up: 'রাইডার ইতিমধ্যে পিকআপ করেছেন, এখন আর ফেরানো যাবে না।',
          };
          window.showToast?.(msgs[res?.reason] || 'হয়নি, আবার চেষ্টা করুন', 'error');
          return;
        }
        window.showToast?.(approve ? 'অনুমোদন হয়েছে, অর্ডার মার্কেটে ফিরেছে' : 'অনুরোধ প্রত্যাখ্যান করা হয়েছে, রাইডারকে জানানো হয়েছে', 'success');
        closeDetail();
        location.reload();
      };

      $('detailAlertBtn')?.addEventListener('click', () => openAlert(data));
      $('detailCancelBtn')?.addEventListener('click', () => openCancel(data));
      $('detailCancelBtn2')?.addEventListener('click', () => openCancel(data));
      $('relApproveBtn')?.addEventListener('click', () => reviewRelease(o, true));
      $('relRejectBtn')?.addEventListener('click', () => reviewRelease(o, false));
      $('detailReopenBtn')?.addEventListener('click', () => openCancel({ order: o, mode: 'reopen' }));
      $('detailTransferBtn')?.addEventListener('click', () => openAssign({
        order: { id: o.id, order_no: o.order_no, category: o.category, upazila: o.upazila, price, transfer: true },
      }));
      $('detailDealBtn')?.addEventListener('click', () => {
        closeDetail();
        // অ্যাডমিন ডিল চ্যাট (channel = 'admin'): প্রস্তাব বার ChatModal নিজেই দেখায়
        window.openChatModal?.({
          requestId: o.id,
          otherPartyName: c.name || 'কাস্টমার',
          channel: 'admin',
          deal: 'admin',
        });
      });
      $('detailChatBtn')?.addEventListener('click', () => {
        closeDetail();
        // c.id = কাস্টমারের profile id, r.id = রাইডারের profile id (admin_get_order থেকে);
        // এগুলোই delivery_chat_messages.sender_id এর সাথে মেলে — ChatModal এ লেবেল বসাতে লাগে
        window.openChatModal?.({
          requestId: o.id,
          otherPartyName: `${c.name || 'কাস্টমার'} ↔ ${r?.name || 'রাইডার'}`,
          readOnly: true,
          customerId: c.id || null,
          customerName: c.name || '',
          riderId: r?.id || null,
          riderName: r?.name || '',
        });
      });
      $('doDetailBody').querySelectorAll('.do-proof-thumb').forEach((thumb) => {
        thumb.addEventListener('click', () => openLightbox(thumb.dataset.img));
      });

      startCooldownLabel(data.alert_cooldown_secs || 0);

      // ঠিকানা: লিংক লুকিয়ে "নেভিগেট করুন" বাটন (lat/lng থাকলে লিংক ছাড়াও বাটন আসে)
      renderAddressWithNav($('doPickupAddr'), o.pickup_address || o.area_detail || '—', { coords: coordsOf(o.pickup_lat, o.pickup_lng) });
      renderAddressWithNav($('doDropAddr'), o.drop_address || '—', { coords: coordsOf(o.drop_lat, o.drop_lng) });

      const srcOrder = { order: { id: o.id, order_no: o.order_no, category: o.category, upazila: o.upazila, price } };
      $('detailPublishBtn')?.addEventListener('click', () => publishOrders([o.id]));
      $('detailAssignBtn')?.addEventListener('click', () => openAssign(srcOrder));
      $('detailHoldBtn')?.addEventListener('click', () => holdOrders([o.id], ps === 'pending'));
      $('detailNoteBtn')?.addEventListener('click', () => openNote(o));
      $('detailMoreBtn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        $('detailMenu')?.classList.toggle('open');
      });
      // মেনুর আইটেমে চাপলে বা বাইরে ট্যাপ করলে মেনু বন্ধ
      $('detailMenu')?.addEventListener('click', () => $('detailMenu')?.classList.remove('open'));
      $('doDetailBody').onclick = (e) => {
        if (!e.target.closest('#detailMenu') && !e.target.closest('#detailMoreBtn')) {
          $('detailMenu')?.classList.remove('open');
        }
      };
      tickEta();
    }

    function closeDetail() {
      closeOverlay('doDetailOverlay');
      state.currentOrder = null;
      state.currentDetail = null;
      clearInterval(cooldownTimer);
      syncUrl();
    }

    function startCooldownLabel(secs) {
      clearInterval(cooldownTimer);
      const label = $('detailCooldown');
      const btn = $('detailAlertBtn');
      if (!label) return;
      let left = secs;
      const tick = () => {
        if (left > 0) {
          label.style.display = 'block';
          label.textContent = `⏱️ আবার এলার্ট দেওয়া যাবে ${bn(Math.floor(left / 60))}:${bn(String(left % 60).padStart(2, '0'))} মিনিট পর`;
          if (btn) btn.disabled = true;
          left -= 1;
        } else {
          label.style.display = 'none';
          if (btn) btn.disabled = false;
          clearInterval(cooldownTimer);
        }
      };
      tick();
      if (left > 0) cooldownTimer = setInterval(tick, 1000);
    }

    // ================= এলার্ট মোডাল =================
    let alertTarget = null;

    function openAlert(src) {
      // src = admin_get_order এর ডেটা, অথবা কার্ড থেকে {order:{...}}
      alertTarget = src.order;
      const o = alertTarget;
      $('alertOrderLine').textContent = `${catName(o.category)} অর্ডার #${o.order_no} · ${o.upazila || ''} · ${money(o.price)}`;
      $('alertUpazila').value = ''; // রাইডার স্কোপ এখন সব উপজেলা (delivery_rider_scope=all)
      document.querySelector('input[name="alertScope"][value="online"]').checked = true;
      const icon = o.category === 'ride' ? '🏍️ নতুন রাইড রিকোয়েস্ট' : '📦 নতুন ডেলিভারি রিকোয়েস্ট';
      $('alertMessage').value = `${icon} #${o.order_no} — ${o.upazila || ''}${o.price ? ', ' + money(o.price) : ''}। অফার দিন!`;
      const res = $('alertResult');
      res.style.display = 'none';
      res.className = 'do-alert-result';
      $('alertSend').disabled = false;
      openOverlay('doAlertOverlay');
    }

    async function sendAlert() {
      if (!alertTarget) return;
      const btn = $('alertSend');
      const res = $('alertResult');
      btn.disabled = true;
      res.style.display = 'none';

      const scope = document.querySelector('input[name="alertScope"]:checked')?.value || 'online';
      const { data, error } = await supabase.rpc('admin_alert_riders', {
        p_request_id: alertTarget.id,
        p_message: $('alertMessage').value.trim() || null,
        p_scope: scope,
        p_upazila: $('alertUpazila').value || null,
      });

      res.style.display = 'block';
      if (error) {
        res.className = 'do-alert-result err';
        res.textContent = 'পাঠানো যায়নি: ' + error.message;
        btn.disabled = false;
        return;
      }
      if (!data?.ok) {
        res.className = 'do-alert-result err';
        if (data?.reason === 'cooldown') {
          const s = data.retry_in || 0;
          res.textContent = `এই অর্ডারে সম্প্রতি এলার্ট দেওয়া হয়েছে। ${bn(Math.floor(s / 60))} মিনিট ${bn(s % 60)} সেকেন্ড পর আবার চেষ্টা করুন।`;
        } else if (data?.reason === 'not_published') {
          res.textContent = 'অর্ডারটি এখনো পাবলিশ হয়নি। আগে পাবলিশ করুন, তারপর এলার্ট দিন।';
        } else if (data?.reason === 'not_open') {
          res.textContent = 'অর্ডারটি আর খোলা নেই, তাই এলার্ট দেওয়া যাবে না।';
        } else {
          res.textContent = 'অর্ডারটি পাওয়া যায়নি।';
        }
        btn.disabled = false;
        return;
      }

      res.className = 'do-alert-result ok';
      res.textContent = data.sent > 0
        ? `✅ ${bn(data.sent)} জন রাইডারকে পাঠানো হয়েছে`
        : 'মিলে যাওয়া কোনো রাইডার পাওয়া যায়নি (উপজেলা/স্কোপ বদলে দেখুন)';
      if (data.sent > 0) {
        setTimeout(() => {
          closeOverlay('doAlertOverlay');
          if ($('doDetailOverlay').classList.contains('active') && state.currentOrder) openDetail(state.currentOrder);
          refreshCurrent();
        }, 1400);
      } else {
        btn.disabled = false;
      }
    }

    // ================= অর্ডার বাতিল (admin/মডারেটর) =================
    let cancelTarget = null;
    let cancelMode = 'cancel'; // 'cancel' = অর্ডার বাতিল, 'reopen' = মার্কেটে ফেরত

    function openCancel(src) {
      cancelTarget = src.order;
      cancelMode = src.mode === 'reopen' ? 'reopen' : 'cancel';
      const reopen = cancelMode === 'reopen';
      $('cancelTitle').textContent = reopen ? '↩️ মার্কেটে ফেরত দিন' : '❌ অর্ডার বাতিল করুন';
      $('cancelHint').textContent = reopen
        ? 'রাইডারের কাছ থেকে অর্ডার সরিয়ে আবার সবার জন্য খোলা হবে। পুরনো রাইডার ও কাস্টমারকে নোটিফিকেশন যাবে। চাইলে পরে "রাইডারদের এলার্ট দিন" দিতে পারবেন।'
        : 'বাতিল করলে এটা ফেরানো যাবে না। কারো স্ট্যাটে কিছু যোগ হবে না, আর কাস্টমার ও (থাকলে) রাইডারের কাছে নোটিফিকেশন যাবে।';
      $('cancelSend').innerHTML = reopen
        ? '<i class="fas fa-rotate-left"></i> নিশ্চিত, মার্কেটে ফেরত দিন'
        : '<i class="fas fa-ban"></i> নিশ্চিত, বাতিল করুন';
      const o = cancelTarget;
      $('cancelOrderLine').textContent = `${catName(o.category)} অর্ডার #${o.order_no} · ${o.upazila || ''} · ${money(o.price)}`;
      $('cancelReason').value = '';
      $('cancelCount').textContent = bn(0) + '/' + bn(300);
      const res = $('cancelResult');
      res.style.display = 'none';
      res.className = 'do-alert-result';
      $('cancelSend').disabled = false;
      openOverlay('doCancelOverlay');
    }

    async function sendCancel() {
      if (!cancelTarget) return;
      const btn = $('cancelSend');
      const res = $('cancelResult');
      const reason = $('cancelReason').value.trim();

      res.style.display = 'block';
      if (reason.length < 3) {
        res.className = 'do-alert-result err';
        res.textContent = 'বাতিলের কারণ লিখুন (কমপক্ষে ৩ অক্ষর)।';
        return;
      }

      btn.disabled = true;
      const { data, error } = await supabase.rpc(cancelMode === 'reopen' ? 'admin_reopen_order' : 'admin_cancel_order', {
        p_request_id: cancelTarget.id,
        p_reason: reason,
      });

      if (error) {
        res.className = 'do-alert-result err';
        res.textContent = 'বাতিল করা যায়নি: ' + error.message;
        btn.disabled = false;
        return;
      }
      if (!data?.ok) {
        res.className = 'do-alert-result err';
        if (data?.reason === 'reason_required') res.textContent = 'বাতিলের কারণ লিখুন (কমপক্ষে ৩ অক্ষর)।';
        else if (data?.reason === 'reason_too_long') res.textContent = 'কারণ সর্বোচ্চ ৩০০ অক্ষরের হতে পারে।';
        else if (data?.reason === 'not_cancellable') res.textContent = 'এই অর্ডারটি এখন আর বাতিল করা যাবে না (স্ট্যাটাস: ' + (STATUS_LABEL[data.status] || data.status) + ')।';
        else if (data?.reason === 'not_confirmed' || data?.reason === 'already_picked_up') res.textContent = 'অর্ডারটি এখন আর "কনফার্ম, পিকআপের আগে" অবস্থায় নেই, তাই মার্কেটে ফেরানো যাবে না।';
        else res.textContent = 'অর্ডারটি পাওয়া যায়নি।';
        btn.disabled = false;
        return;
      }

      res.className = 'do-alert-result ok';
      res.textContent = cancelMode === 'reopen'
        ? '✅ অর্ডার মার্কেটে ফেরত গেছে, সংশ্লিষ্টদের জানানো হয়েছে'
        : '✅ অর্ডার বাতিল হয়েছে, দুই পক্ষকে জানানো হয়েছে';
      setTimeout(() => {
        closeOverlay('doCancelOverlay');
        if ($('doDetailOverlay').classList.contains('active') && state.currentOrder) openDetail(state.currentOrder);
        loadOverview();
        refreshCurrent();
      }, 1200);
    }

    // ================= ডেলিভারি UI v2: ইনবক্স (পাবলিশ / হোল্ড / ব্যাচ / অ্যাসাইন / নোট) =================
    function toast(text, type = 'success') { if (window.showToast) window.showToast(text, type); }

    function fmtLeft(ms) {
      if (ms <= 0) return 'এখনই';
      const s = Math.ceil(ms / 1000);
      return bn(Math.floor(s / 60)) + ':' + bn(String(s % 60).padStart(2, '0'));
    }

    function ageTxt(ts) {
      const m = Math.max(0, Math.floor((Date.now() - new Date(ts).getTime()) / 60000));
      if (m < 60) return bn(m) + ' মিনিটের';
      return bn(Math.floor(m / 60)) + ' ঘণ্টার';
    }

    // কার্ড/গ্রুপের অটো-পাবলিশ কাউন্টডাউন (শুধু সময় বসায়) + গেট লাইনের "পরের অটো-পাবলিশ"
    function tickEta() {
      document.querySelectorAll('[data-eta]').forEach((el) => {
        const t = new Date(el.dataset.eta).getTime();
        const b = el.querySelector('b');
        if (b && !isNaN(t)) b.textContent = fmtLeft(t - Date.now());
      });
      const nx = state.inbox && state.inbox.next_auto_publish;
      const nextEl = $('doGateNext');
      if (nextEl) nextEl.textContent = nx && state.inbox.gate_on ? 'পরের অটো-পাবলিশ: ' + fmtLeft(new Date(nx).getTime() - Date.now()) : '';
    }

    function gateVisible() {
      const g = $('doGate');
      if (!g) return;
      g.style.display = state.inbox && (state.tab === 'new' || state.tab === 'batch') ? '' : 'none';
    }

    function paintInbox() {
      const ib = state.inbox;
      if (!ib) return;
      $('doGateState').textContent = ib.gate_on
        ? 'অটো-পাবলিশ: ' + bn(ib.auto_minutes) + ' মিনিট পরে'
        : 'গেট বন্ধ: অর্ডার সরাসরি রাইডারের কাছে যাচ্ছে';
      if (document.activeElement !== $('doAutoMin')) $('doAutoMin').value = ib.auto_minutes;
      const n = (ib.pending || 0) + (ib.hold || 0);
      const em = $('tabNewCount');
      em.textContent = n ? bn(n) : '';
      em.classList.toggle('show', n > 0);
      gateVisible();
      tickEta();
    }

    async function saveAutoMin() {
      const v = parseInt($('doAutoMin').value, 10);
      if (!(v >= 1 && v <= 240)) { toast('১ থেকে ২৪০ মিনিটের মধ্যে দিন।', 'error'); return; }
      const btn = $('doAutoSave');
      btn.disabled = true;
      const { error } = await supabase
        .from('site_settings')
        .upsert({ key: 'delivery_auto_publish_minutes', value: String(v), updated_at: new Date().toISOString() }, { onConflict: 'key' });
      btn.disabled = false;
      if (error) { toast('সেভ হয়নি: ' + error.message, 'error'); return; }
      toast('অটো-পাবলিশ ' + bn(v) + ' মিনিট সেট হয়েছে (নতুন অর্ডার ও "টাইমার চালু"-তে প্রযোজ্য)');
      $('doGateSet').style.display = 'none';
      loadOverview();
    }

    function refreshAfterChange() {
      loadOverview();
      refreshCurrent({ silent: true });
      if ($('doDetailOverlay').classList.contains('active') && state.currentOrder) openDetail(state.currentOrder);
    }

    async function publishOrders(ids) {
      if (!ids || !ids.length) return;
      const { data, error } = await supabase.rpc('admin_publish_delivery_orders', { p_ids: ids });
      if (error || !data || !data.ok) {
        toast('পাবলিশ করা যায়নি' + (error ? ': ' + error.message : ''), 'error');
        return;
      }
      toast('🚀 ' + bn(data.published) + 'টি অর্ডার পাবলিশ হয়েছে' + (data.skipped ? ' · ' + bn(data.skipped) + 'টি বাদ (আগেই পাবলিশ বা বাতিল)' : ''));
      refreshAfterChange();
    }

    async function holdOrders(ids, hold) {
      if (!ids || !ids.length) return;
      const { data, error } = await supabase.rpc('admin_hold_delivery_orders', { p_ids: ids, p_hold: hold });
      if (error || !data || !data.ok) {
        toast('বদলানো যায়নি' + (error ? ': ' + error.message : ''), 'error');
        return;
      }
      toast(data.changed
        ? (hold ? bn(data.changed) + 'টি অপেক্ষায় রাখা হয়েছে (টাইমার বন্ধ)' : bn(data.changed) + 'টির টাইমার চালু হয়েছে')
        : 'কোনো পরিবর্তন হয়নি (অর্ডার আগের অবস্থাতেই ছিল)');
      refreshAfterChange();
    }

    // কার্ডের প্রধান বাটন (পাবলিশ / রাইডারকে দিন / অপেক্ষায় রাখুন / টাইমার চালু)
    function cardAction(act, card) {
      const id = card.dataset.id;
      if (act === 'publish') return publishOrders([id]);
      if (act === 'hold') return holdOrders([id], true);
      if (act === 'unhold') return holdOrders([id], false);
      if (act === 'assign') return openAssign({ order: orderOfCard(card) });
      return null;
    }

    function orderOfCard(card) {
      return {
        id: card.dataset.id, order_no: card.dataset.no, category: card.dataset.cat, upazila: card.dataset.upazila,
        price: card.dataset.price ? Number(card.dataset.price) : null,
      };
    }

    // ---------- ৩-ডট মেনু (নতুন ট্যাবের কার্ড) ----------
    function closeMenus() {
      document.querySelectorAll('.do2-menu.open').forEach((m) => {
        m.classList.remove('open');
        m.style.top = '';
      });
    }

    function toggleMenu(card) {
      const m = card.querySelector('.do2-menu');
      if (!m) return;
      const was = m.classList.contains('open');
      closeMenus();
      if (was) return;
      m.classList.add('open');
      // নিচে জায়গা না থাকলে (স্ক্রিনের নিচ/নেভ বারের কারণে কেটে যায়) বাটনের উপরের দিকে খুলবে
      const dots = card.querySelector('[data-act="menu"]');
      if (!dots) return;
      const dr = dots.getBoundingClientRect();
      const cr = card.getBoundingClientRect();
      const h = m.offsetHeight;
      const guard = 80;
      let top = dr.bottom + 6;
      if (top + h > window.innerHeight - guard) top = Math.max(8, dr.top - h - 6);
      m.style.top = (top - cr.top) + 'px';
    }

    async function menuAction(btn) {
      closeMenus();
      const card = btn.closest('.do-card');
      if (!card) return;
      const act = btn.dataset.mact;
      const o = orderOfCard(card);
      if (act === 'cancel') return openCancel({ order: o });
      if (act === 'note') return openNote(o);
      if (act === 'timer') return holdOrders([o.id], card.dataset.ps === 'pending');
      if (act === 'dispute') { window.location.href = '/admin/delivery-disputes?q=' + encodeURIComponent(o.order_no); return null; }
      if (act === 'deal') {
        await openDetail(o.order_no);
        const db = $('detailDealBtn');
        if (db) db.click(); else toast('এই অর্ডারে ডিল চ্যাট এখন চালু নেই।', 'error');
        return null;
      }
      if (act === 'chat') {
        await openDetail(o.order_no);
        const cb = $('detailChatBtn');
        if (cb) cb.click(); else toast('এই অর্ডারে এখনো কোনো চ্যাট নেই।', 'error');
      }
      return null;
    }

    // ---------- ব্যাচ ----------
    let batchGroups = {};
    const TYPE_LABEL = { union: 'ইউনিয়ন', upazila: 'উপজেলা', shop: 'দোকান' };

    function groupCard(g, key) {
      const nos = g.order_nos || [];
      const ids = g.order_ids || [];
      const chips = nos.map((no, i) => `<span class="do2-oc"><label class="do2-ckl" aria-label="${esc(no)} বাছুন"><input type="checkbox" class="do2-ckb" data-id="${esc(ids[i] || '')}" checked /><span class="do2-ck">${TICK_SVG}</span></label><button type="button" class="do2-ocn" data-no="${esc(no)}">${esc(no)}</button></span>`).join('');
      const chipCls = g._type === 'shop' ? 'yel' : 'blue';
      const sub = g._type === 'shop'
        ? bn(g.count) + 'টি অর্ডার, একই দোকান থেকে'
        : bn(g.count) + 'টি অর্ডার · সবচেয়ে পুরনোটি ' + ageTxt(g.oldest);
      return `
        <div class="do-card do2-card do-group" data-gkey="${key}">
          <div class="do2-gh">
            <span class="do2-chip ${chipCls}" style="margin:0;">${TYPE_LABEL[g._type] || ''}</span>
            <div class="do2-gname">${esc(g.label)}</div>
            ${g.next_auto_publish ? `<span class="do2-chip y" style="margin:0;" data-eta="${esc(g.next_auto_publish)}"><b></b></span>` : ''}
          </div>
          <div class="do2-gsub">${sub}</div>
          <div class="do2-row2">${chips}</div>
          <div class="do2-gbtns">
            <button type="button" class="do2-cta" data-gact="publish">${bn(nos.length)}টি পাবলিশ করুন</button>
            <button type="button" class="do2-ghost" data-gact="assign">এক রাইডারকে দিন</button>
          </div>
        </div>`;
    }

    function groupSelection(card) {
      return [...card.querySelectorAll('.do2-ckb:checked')].map((cb) => ({
        id: cb.dataset.id,
        no: cb.closest('.do2-oc').querySelector('.do2-ocn').dataset.no,
      }));
    }

    function updateGroupCta(card) {
      const n = groupSelection(card).length;
      const cta = card.querySelector('[data-gact="publish"]');
      const as = card.querySelector('[data-gact="assign"]');
      cta.textContent = bn(n) + 'টি পাবলিশ করুন';
      cta.disabled = n === 0;
      as.disabled = n === 0;
    }

    async function loadBatches({ silent = false } = {}) {
      const token = ++loadToken;
      if (!silent) {
        $('doLoading').style.display = 'flex';
        $('doList').innerHTML = '';
      }
      $('doEmpty').style.display = 'none';
      $('doMore').style.display = 'none';

      const types = state.group === 'all' ? ['union', 'shop'] : [state.group];
      const results = await Promise.all(types.map((t) => supabase.rpc('admin_delivery_batches', { p_group: t })));
      if (token !== loadToken) return;
      $('doLoading').style.display = 'none';

      const bad = results.find((r) => r.error);
      if (bad) {
        $('doList').innerHTML = `<p style="text-align:center;color:#B3261E;padding:30px 0;">ব্যাচ লোড করতে সমস্যা: ${esc(bad.error.message)}</p>`;
        return;
      }
      const groups = [];
      results.forEach((r, i) => {
        (Array.isArray(r.data) ? r.data : []).forEach((g) => { g._type = types[i]; groups.push(g); });
      });
      batchGroups = {};
      $('doList').innerHTML = groups.map((g, i) => {
        batchGroups['g' + i] = g;
        return groupCard(g, 'g' + i);
      }).join('');
      if (!groups.length) {
        $('doEmpty').querySelector('p').textContent = 'এখন কোনো ব্যাচ নেই: পাবলিশের অপেক্ষায় কোনো অর্ডার নেই ✅';
        $('doEmpty').style.display = 'block';
      }
      tickEta();
    }

    async function handleGroupAction(btn) {
      const card = btn.closest('.do-group');
      if (!card) return;
      const g = batchGroups[card.dataset.gkey];
      const sel = groupSelection(card);
      if (!sel.length) return;
      if (btn.dataset.gact === 'publish') {
        if (!window.confirm('"' + (g ? g.label : '') + '"-এর ' + bn(sel.length) + 'টি অর্ডার পাবলিশ করবেন?')) return;
        await publishOrders(sel.map((s) => s.id));
      } else if (btn.dataset.gact === 'assign') {
        openAssign({ orders: sel.map((s) => ({ id: s.id, order_no: s.no, category: 'delivery' })) });
      }
    }

    // ---------- রাইডারকে দিন (এক বা একাধিক অর্ডার) ----------
    let assignTarget = null;   // একটা অর্ডার
    let assignMulti = null;    // ব্যাচ: অর্ডারের তালিকা
    let assignRiders = [];
    let assignPick = null;
    let assignTransfer = false; // true = কনফার্ম অর্ডারের রাইডার বদল

    function renderAssignList() {
      const box = $('assignList');
      box.innerHTML = '';
      const q = $('assignSearch').value.trim().toLowerCase();
      const onlyOnline = $('assignOnline').checked;
      const list = assignRiders.filter((r) => {
        if (onlyOnline && !r.online) return false;
        if (!q) return true;
        return [r.name, r.phone, r.upazila].some((v) => (v || '').toLowerCase().indexOf(q) !== -1);
      });
      if (!list.length) {
        const p = document.createElement('p');
        p.className = 'do-hint';
        p.textContent = assignRiders.length ? 'কোনো রাইডার মেলেনি।' : 'কোনো অনুমোদিত রাইডার নেই।';
        box.appendChild(p);
        return;
      }
      list.forEach((r) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'do-rider' + (assignPick === r.rider_id ? ' sel' : '');
        const left = document.createElement('div');
        const n = document.createElement('b');
        n.textContent = r.name || 'নামহীন';
        const s = document.createElement('small');
        s.textContent = [r.phone, r.upazila, r.vehicle_type, r.total_completed ? bn(r.total_completed) + 'টা সম্পন্ন' : ''].filter(Boolean).join(' · ');
        left.appendChild(n);
        left.appendChild(s);
        const right = document.createElement('div');
        right.className = 'do-rbadges';
        if (r.is_own) {
          const o = document.createElement('span');
          o.className = 'do-rbadge own';
          o.textContent = 'নিজস্ব';
          right.appendChild(o);
        }
        const st = document.createElement('span');
        st.className = 'do-rbadge' + (r.online ? ' on' : '');
        st.textContent = r.online ? 'অনলাইন' : 'অফলাইন';
        right.appendChild(st);
        b.appendChild(left);
        b.appendChild(right);
        b.addEventListener('click', () => { assignPick = r.rider_id; renderAssignList(); });
        box.appendChild(b);
      });
    }

    async function openAssign(src) {
      assignTarget = src.order || null;
      assignTransfer = !!(src.order && src.order.transfer);
      assignMulti = src.orders || null;
      assignPick = null;
      const multi = !!assignMulti;
      const o = multi ? assignMulti[0] : assignTarget;
      $('assignOrderLine').textContent = multi
        ? bn(assignMulti.length) + 'টি অর্ডার একজন রাইডারকে'
        : catName(o.category) + ' অর্ডার ' + o.order_no + (o.upazila ? ' · ' + o.upazila : '');
      $('assignPriceWrap').style.display = multi ? 'none' : '';
      $('assignPriceHint').style.display = multi ? '' : 'none';
      $('assignPrice').value = !multi && o.price ? String(Math.round(o.price)) : '';
      $('assignSearch').value = '';
      $('assignOnline').checked = false;
      const res = $('assignResult');
      res.style.display = 'none';
      res.className = 'do-alert-result';
      $('assignSend').disabled = false;
      $('assignTitle').textContent = assignTransfer ? '🔄 রাইডার বদলান' : 'রাইডারকে দিন';
      $('assignSend').textContent = assignTransfer ? 'রাইডার বদলান' : 'রাইডারকে দিন';
      $('assignList').innerHTML = '';
      const p = document.createElement('p');
      p.className = 'do-hint';
      p.textContent = 'রাইডার লোড হচ্ছে...';
      $('assignList').appendChild(p);
      openOverlay('doAssignOverlay');

      // ব্যাচে প্রতিটি অর্ডারের নিজের চার্জ লাগে: আনপাবলিশড তালিকা থেকে নিই
      if (multi) {
        const pr = await supabase.rpc('admin_search_orders', { p_group: 'live', p_filter: 'unpublished', p_limit: 100 });
        const map = {};
        ((pr.data && pr.data.items) || []).forEach((it) => { map[it.id] = it.price; });
        assignMulti.forEach((x) => { x.price = map[x.id] || null; });
      }

      const { data, error } = await supabase.rpc('admin_assignable_riders', { p_category: o.category });
      if (!assignTarget && !assignMulti) return;
      if (error) {
        $('assignList').innerHTML = '';
        const e = document.createElement('p');
        e.className = 'do-alert-result err';
        e.style.display = 'block';
        e.textContent = 'রাইডার লোড হয়নি: ' + error.message;
        $('assignList').appendChild(e);
        return;
      }
      assignRiders = Array.isArray(data) ? data : [];
      renderAssignList();
    }

    function assignFailText(data) {
      const m = {
        bad_price: 'ডেলিভারি চার্জ সঠিক নয়।',
        not_found: 'অর্ডারটি পাওয়া যায়নি।',
        not_open: 'অর্ডারটি আর খোলা নেই।',
        rider_invalid: 'এই রাইডার এই অর্ডারের জন্য উপযুক্ত নন (বা কাস্টমার নিজেই)।',
        not_confirmed: 'অর্ডারটি এখন কনফার্ম অবস্থায় নেই।',
        already_picked_up: 'পিকআপ হয়ে গেছে, এখন রাইডার বদলানো যাবে না।',
        same_rider: 'এই রাইডারই এখন অর্ডারটি করছেন, অন্য রাইডার বাছুন।',
      };
      return m[data && data.reason] || 'দেওয়া যায়নি।';
    }

    async function sendAssign() {
      if (!assignTarget && !assignMulti) return;
      const res = $('assignResult');
      res.style.display = 'block';
      const rider = assignRiders.find((r) => r.rider_id === assignPick);
      if (!rider) { res.className = 'do-alert-result err'; res.textContent = 'একজন রাইডার বাছুন।'; return; }
      const btn = $('assignSend');

      if (assignMulti) {
        if (!window.confirm(bn(assignMulti.length) + 'টি অর্ডার "' + (rider.name || 'রাইডার') + '"-কে দেবেন?')) return;
        btn.disabled = true;
        let ok = 0;
        const fails = [];
        for (const x of assignMulti) {
          if (!x.price) { fails.push(x.order_no); continue; }
          const r = await supabase.rpc('admin_assign_delivery_order', { p_request_id: x.id, p_rider_id: rider.rider_id, p_price: x.price });
          if (r.error || !r.data || !r.data.ok) fails.push(x.order_no); else ok += 1;
        }
        res.className = 'do-alert-result ' + (fails.length ? 'err' : 'ok');
        res.textContent = (ok ? '✅ ' + bn(ok) + 'টি দেওয়া হয়েছে' : '') + (fails.length ? (ok ? ' · ' : '') + bn(fails.length) + 'টি হয়নি (' + fails.join(', ') + ')' : '');
        if (!ok) { btn.disabled = false; return; }
        setTimeout(() => { closeOverlay('doAssignOverlay'); assignTarget = null; assignMulti = null; refreshAfterChange(); }, 1300);
        return;
      }

      const price = parseFloat($('assignPrice').value);
      if (isNaN(price) || price <= 0 || price > 1000000) { res.className = 'do-alert-result err'; res.textContent = 'ডেলিভারি চার্জ সঠিক দিন।'; return; }
      const confirmText = assignTransfer
        ? assignTarget.order_no + ' অর্ডারের রাইডার বদলে "' + (rider.name || 'রাইডার') + '"-কে ডেলিভারি চার্জ ' + money(price) + ' তে দেবেন? পুরনো রাইডার, নতুন রাইডার ও কাস্টমারকে জানানো হবে।'
        : assignTarget.order_no + ' অর্ডার "' + (rider.name || 'রাইডার') + '"-কে ডেলিভারি চার্জ ' + money(price) + ' তে দেবেন?';
      if (!window.confirm(confirmText)) return;
      btn.disabled = true;
      const { data, error } = assignTransfer
        ? await supabase.rpc('admin_transfer_delivery_order', {
          p_request_id: assignTarget.id,
          p_new_rider_id: rider.rider_id,
          p_price: price,
        })
        : await supabase.rpc('admin_assign_delivery_order', {
          p_request_id: assignTarget.id,
          p_rider_id: rider.rider_id,
          p_price: price,
        });
      if (error) {
        res.className = 'do-alert-result err';
        res.textContent = 'দেওয়া যায়নি: ' + error.message;
        btn.disabled = false;
        return;
      }
      if (!data || !data.ok) {
        res.className = 'do-alert-result err';
        res.textContent = data && data.reason === 'not_open'
          ? 'অর্ডারটি আর খোলা নেই (স্ট্যাটাস: ' + (STATUS_LABEL[data.status] || data.status || '') + ')।'
          : assignFailText(data);
        btn.disabled = false;
        return;
      }
      res.className = 'do-alert-result ok';
      res.textContent = assignTransfer
        ? '✅ রাইডার বদলানো হয়েছে, তিন পক্ষকে জানানো হয়েছে'
        : '✅ রাইডারকে দেওয়া হয়েছে, দুই পক্ষকে জানানো হয়েছে';
      setTimeout(() => { closeOverlay('doAssignOverlay'); assignTarget = null; refreshAfterChange(); }, 1100);
    }

    // ---------- নোট ----------
    let noteTarget = null;

    function openNote(o) {
      noteTarget = o;
      $('noteOrderLine').textContent = catName(o.category) + ' অর্ডার ' + o.order_no;
      $('noteText').value = '';
      $('noteCount').textContent = bn(0) + '/' + bn(500);
      const res = $('noteResult');
      res.style.display = 'none';
      res.className = 'do-alert-result';
      $('noteSend').disabled = false;
      openOverlay('doNoteOverlay');
    }

    async function sendNote() {
      if (!noteTarget) return;
      const res = $('noteResult');
      const note = $('noteText').value.trim();
      res.style.display = 'block';
      if (!note) { res.className = 'do-alert-result err'; res.textContent = 'নোট লিখুন।'; return; }
      const btn = $('noteSend');
      btn.disabled = true;
      const { data, error } = await supabase.rpc('admin_add_order_note', { p_request_id: noteTarget.id, p_note: note });
      if (error || !data || !data.ok) {
        res.className = 'do-alert-result err';
        res.textContent = error ? 'সেভ হয়নি: ' + error.message : (data && data.reason === 'bad_note' ? 'নোট ১ থেকে ৫০০ অক্ষরের হতে হবে।' : 'সেভ হয়নি।');
        btn.disabled = false;
        return;
      }
      res.className = 'do-alert-result ok';
      res.textContent = '✅ নোট সেভ হয়েছে';
      setTimeout(() => {
        closeOverlay('doNoteOverlay');
        noteTarget = null;
        if ($('doDetailOverlay').classList.contains('active') && state.currentOrder) openDetail(state.currentOrder);
      }, 800);
    }

    function bindInboxEvents() {
      $('doAutoSave').addEventListener('click', saveAutoMin);
      $('doGateEdit').addEventListener('click', () => {
        const s = $('doGateSet');
        s.style.display = s.style.display === 'none' ? 'flex' : 'none';
      });

      // ব্যাচ সেগমেন্টেড
      document.querySelectorAll('#batchSeg button').forEach((b) => {
        b.addEventListener('click', () => {
          state.group = b.dataset.group;
          document.querySelectorAll('#batchSeg button').forEach((x) => x.classList.toggle('active', x === b));
          loadBatches();
        });
      });

      // ব্যাচ কার্ডের চেক-চিপ
      $('doList').addEventListener('change', (e) => {
        const cb = e.target.closest('.do2-ckb');
        if (!cb) return;
        cb.closest('.do2-oc').classList.toggle('off', !cb.checked);
        updateGroupCta(cb.closest('.do-group'));
      });

      // মেনুর বাইরে ক্লিক করলে বন্ধ
      document.addEventListener('click', (e) => { if (!e.target.closest('.do2-menu') && !e.target.closest('[data-act="menu"]')) closeMenus(); });

      // অ্যাসাইন মোডাল
      const closeAssign = () => { closeOverlay('doAssignOverlay'); assignTarget = null; assignMulti = null; };
      $('doAssignClose').addEventListener('click', closeAssign);
      $('doAssignOverlay').addEventListener('click', (e) => { if (e.target === $('doAssignOverlay')) closeAssign(); });
      $('assignSearch').addEventListener('input', renderAssignList);
      $('assignOnline').addEventListener('change', renderAssignList);
      $('assignSend').addEventListener('click', sendAssign);

      // নোট মোডাল
      $('doNoteClose').addEventListener('click', () => { closeOverlay('doNoteOverlay'); noteTarget = null; });
      $('doNoteOverlay').addEventListener('click', (e) => { if (e.target === $('doNoteOverlay')) { closeOverlay('doNoteOverlay'); noteTarget = null; } });
      $('noteText').addEventListener('input', (e) => { $('noteCount').textContent = bn(e.target.value.length) + '/' + bn(500); });
      $('noteSend').addEventListener('click', sendNote);

      setInterval(tickEta, 1000);
    }

    // ================= রিয়েলটাইম + পোলিং =================
    let refreshTimer = null;
    function scheduleRefresh() {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(() => {
        loadOverview();
        refreshCurrent({ silent: true });
      }, 600);
    }

    function startLive() {
      supabase
        .channel('admin-order-events')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'order_events' }, (payload) => {
          const type = payload?.new?.event_type;
          if (type === 'created') beep();
          scheduleRefresh();
          if (state.currentOrder) {
            // খোলা ডিটেইল মোডাল থাকলে সেটাও রিফ্রেশ (শুধু এই অর্ডারের ইভেন্ট হলে)
            const cur = state.currentDetail?.order?.id;
            if (cur && payload?.new?.request_id === cur) openDetail(state.currentOrder);
          }
        })
        .subscribe();

      setInterval(() => {
        if (document.visibilityState === 'visible') {
          loadOverview();
          refreshCurrent({ silent: true });
        }
      }, POLL_MS);

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') scheduleRefresh();
      });
    }

    // ================= ইভেন্ট বাইন্ডিং =================
    function bindEvents() {
      // ট্যাব
      document.querySelectorAll('.do-tab').forEach((t) => t.addEventListener('click', () => switchTab(t.dataset.tab)));

      // ক্যাটাগরি চিপ ও অফারহীন ফিল্টার
      document.querySelectorAll('#catChips .do-chip[data-cat]').forEach((chip) => {
        chip.addEventListener('click', () => {
          state.cat = chip.dataset.cat;
          applyTabUi();
          loadOrders();
        });
      });
      $('noOfferChip').addEventListener('click', () => {
        state.filter = state.filter === 'no_offer' ? '' : 'no_offer';
        applyTabUi();
        syncUrl();
        loadOrders();
      });

      $('fStatus').addEventListener('change', (e) => { state.status = e.target.value; loadOrders(); });
      $('fUpazila').addEventListener('change', (e) => { state.upazila = e.target.value; loadOrders(); });
      $('fFrom').addEventListener('change', (e) => { state.from = e.target.value; loadOrders(); });
      $('fTo').addEventListener('change', (e) => { state.to = e.target.value; loadOrders(); });

      // সার্চ (ডিবাউন্স)
      let searchTimer = null;
      $('doSearch').addEventListener('input', (e) => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          state.q = e.target.value.trim();
          syncUrl();
          // ফিড/ব্যাচ ট্যাবে থাকলে সার্চের জন্য চলমান ট্যাবের লিস্টে চলে আসি
          if ((state.tab === 'feed' || state.tab === 'batch') && state.q) {
            switchTab('live');
          } else if (state.tab === 'feed') {
            loadFeed();
          } else if (state.tab === 'batch') {
            loadBatches();
          } else {
            loadOrders();
          }
        }, 350);
      });

      // আরও দেখুন
      $('doMore').addEventListener('click', () => {
        if (state.tab === 'feed') loadFeed({ more: true });
        else loadOrders({ reset: false, silent: true });
      });

      // কার্ড / ফিড ক্লিক (ডেলিগেশন)
      $('doList').addEventListener('click', (e) => {
        if (e.target.closest('.do2-ckl')) return; // চেকবক্স ক্লিকে ডিটেইল খুলবে না
        const gbtn = e.target.closest('[data-gact]');
        if (gbtn) { handleGroupAction(gbtn); return; }
        const dots = e.target.closest('[data-act="menu"]');
        if (dots) { e.stopPropagation(); toggleMenu(dots.closest('.do-card')); return; }
        const mi = e.target.closest('[data-mact]');
        if (mi) { e.stopPropagation(); if (mi.dataset.mact === 'call') { closeMenus(); return; } menuAction(mi); return; }
        if (e.target.closest('.do2-menu')) return;
        const actBtn = e.target.closest('[data-act]');
        const alertBtn = actBtn && actBtn.dataset.act === 'alert' ? actBtn : null;
        const card = e.target.closest('[data-no]');
        if (!card) return;
        if (actBtn && !alertBtn) { e.stopPropagation(); cardAction(actBtn.dataset.act, card); return; }

        if (alertBtn) {
          e.stopPropagation();
          openAlert({
            order: {
              id: card.dataset.id,
              order_no: card.dataset.no,
              category: card.dataset.cat,
              upazila: card.dataset.upazila,
              price: card.dataset.price ? Number(card.dataset.price) : null,
            },
          });
          return;
        }
        openDetail(card.dataset.no);
      });

      // মোডাল বন্ধ
      $('doDetailClose').addEventListener('click', closeDetail);
      $('doDetailOverlay').addEventListener('click', (e) => { if (e.target === $('doDetailOverlay')) closeDetail(); });
      $('doAlertClose').addEventListener('click', () => closeOverlay('doAlertOverlay'));
      $('doAlertOverlay').addEventListener('click', (e) => { if (e.target === $('doAlertOverlay')) closeOverlay('doAlertOverlay'); });
      $('doCancelClose').addEventListener('click', () => closeOverlay('doCancelOverlay'));
      $('doCancelOverlay').addEventListener('click', (e) => { if (e.target === $('doCancelOverlay')) closeOverlay('doCancelOverlay'); });
      $('cancelReason').addEventListener('input', (e) => {
        $('cancelCount').textContent = bn(e.target.value.length) + '/' + bn(300);
      });
      $('cancelSend').addEventListener('click', sendCancel);
      $('doLightboxClose').addEventListener('click', closeLightbox);
      $('doLightbox').addEventListener('click', (e) => { if (e.target === $('doLightbox')) closeLightbox(); });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if ($('doLightbox').classList.contains('active')) closeLightbox();
        else if ($('doCancelOverlay').classList.contains('active')) closeOverlay('doCancelOverlay');
        else if ($('doAlertOverlay').classList.contains('active')) closeOverlay('doAlertOverlay');
        else if ($('doDetailOverlay').classList.contains('active')) closeDetail();
      });

      $('alertSend').addEventListener('click', sendAlert);
      bindInboxEvents();

      // শব্দ অন/অফ
      $('doSoundBtn').addEventListener('click', () => {
        state.sound = !state.sound;
        try { localStorage.setItem('sf_do_sound', state.sound ? 'on' : 'off'); } catch (e) { /* ঠিক আছে */ }
        renderSoundBtn();
        if (state.sound) beep();
      });
    }

    // ================= শুরু =================
    window.addEventListener('smartfeni:admin-ready', async () => {
      if (state.initialized) return;
      state.initialized = true;

      const params = new URLSearchParams(location.search);
      const tab = params.get('tab');
      if (['new', 'batch', 'live', 'history', 'feed'].includes(tab)) {
        state.tab = tab;
      } else if (!params.get('open') && !params.get('q') && !params.get('filter')) {
        // পাবলিশের অপেক্ষায় অর্ডার থাকলে সরাসরি "নতুন" ট্যাবে খুলি
        try {
          const ib = await supabase.rpc('admin_delivery_inbox_counts');
          if (ib && !ib.error && ib.data && ((ib.data.pending || 0) + (ib.data.hold || 0)) > 0) state.tab = 'new';
        } catch (e) { /* পারলে নতুন ট্যাব, না পারলে চলমান */ }
      }
      if (params.get('filter') === 'no_offer') state.filter = 'no_offer';
      if (params.get('q')) { state.q = params.get('q'); $('doSearch').value = state.q; }

      renderSoundBtn();
      bindEvents();
      applyTabUi();
      loadOverview();

      if (state.tab === 'feed') loadFeed();
      else if (state.tab === 'batch') loadBatches();
      else loadOrders();

      startLive();

      const open = params.get('open');
      if (open) openDetail(open);
    });

    initAdminGuard();
  </script>
</BaseLayout>
