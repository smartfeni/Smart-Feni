      .ldl-winner-ring { width: 140px; height: 140px; }
    }
  </style>

  <script>
    import { initAdminGuard } from '../../../../lib/adminGuard.js';
    import { supabase } from '../../../../lib/supabase.js';

    const overlay = document.getElementById('ldLiveOverlay');
    const drawId = overlay.dataset.drawId;

    const drawTitleEl = document.getElementById('ldlDrawTitle');
    const drawDescEl = document.getElementById('ldlDrawDescription');
    const eligibleCountEl = document.getElementById('ldlEligibleCount');
    const statusEl = document.getElementById('ldlStatus');
    const stageEl = document.getElementById('ldlStage');
    const slotView = document.getElementById('ldlGridView');
    const winnerView = document.getElementById('ldlWinnerView');
    const winnerPhotoImg = document.getElementById('ldlWinnerPhoto');
    const winnerPhotoIcon = document.getElementById('ldlWinnerPhotoIcon');
    const winnerNameEl = document.getElementById('ldlWinnerName');
    const winnerPhoneEl = document.getElementById('ldlWinnerPhone');
    const spinBtn = document.getElementById('spinBtn');
    const respinBtn = document.getElementById('respinBtn');
    const confettiCanvas = document.getElementById('ldlConfettiCanvas');
    const mainEl = document.getElementById('ldlMain');

    const IDLE_STATUS = 'আপনার ভাগ্য কি আজ খুলবে? 🍀';
    const COLORS = ['#FF6B35', '#c0267e', '#0e9f8e', '#7c3aed', '#e11d48', '#d97706', '#059669', '#db2777', '#4f46e5', '#0891b2'];

    let drawRecord = null;
    let eligibleProfiles = []; // [{id, full_name, phone, avatar_url}]
    let N = 0;
    let cur = 0;               // মাঝের (বড়) কার্ডের ইনডেক্স
    let isSpinning = false;
    let currentUserId = null;
    let idleTimer = null;
    let idleActive = false;

    // মাউন্টেড কার্ড (শুধু মাঝের ±২) — পারফরম্যান্সের জন্য
    const mounted = new Map(); // index -> element
    let neededSet = new Set();
    let cardW = 150;
    let cardH = 210;

    // ===== ব্র্যান্ড লোগো — Header.astro-র একই প্যাটার্ন =====
    async function loadBrandLogo() {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', 'logo')
        .maybeSingle();

      if (data?.storage_path) {
        const { data: urlData } = supabase.storage.from('listing-images').getPublicUrl(data.storage_path);
        const bust = data.updated_at ? new Date(data.updated_at).getTime() : Date.now();
        const url = `${urlData.publicUrl}?v=${bust}`;
        const topLogo = document.getElementById('ldlTopLogo');
        const wm = document.getElementById('ldlWatermark');
        if (topLogo) topLogo.src = url;
        if (wm) wm.src = url;
      }
    }
    loadBrandLogo();

    // ===== ভাসমান প্রাইজ আইকন (ব্যাকগ্রাউন্ড) =====
    function buildFloaters() {
      const host = document.getElementById('ldlFloaters');
      if (!host) return;
      const icons = ['fa-trophy', 'fa-gift', 'fa-star', 'fa-gem', 'fa-coins', 'fa-ticket', 'fa-crown', 'fa-sparkles'];
      icons.forEach((ic) => {
        for (let j = 0; j < 2; j++) {
          const el = document.createElement('i');
          el.className = `fas ${ic} ldl-fl`;
          el.style.left = Math.random() * 95 + '%';
          el.style.fontSize = 16 + Math.random() * 18 + 'px';
          el.style.animationDuration = 12 + Math.random() * 12 + 's';
          el.style.animationDelay = -Math.random() * 20 + 's';
          host.appendChild(el);
        }
      });
    }
    buildFloaters();

    // ===== এলিজিবল প্রোফাইল লিস্ট =====
    async function computeEligibleProfiles(filterCriteria) {
      const { data: profiles, error } = await supabase
        .from('profiles')
        .select('id, full_name, phone, avatar_url, created_at, role, is_shop_owner, is_club_owner, is_blocked')
        .eq('is_blocked', false)
        .order('created_at', { ascending: true });

      if (error || !profiles) return [];

      const excludeRoles = new Set(filterCriteria?.exclude_roles || []);
      let filtered = profiles.filter((p) => {
        if (excludeRoles.has(p.role)) return false;
        if (filterCriteria?.exclude_shop_owners && p.is_shop_owner) return false;
        if (filterCriteria?.exclude_club_owners && p.is_club_owner) return false;
        return true;
      });

      if (filterCriteria?.first_n) {
        filtered = filtered.slice(0, filterCriteria.first_n);
      }

      return filtered;
    }

    // ===== Fisher-Yates শাফল =====
    function shuffleArray(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // ===== ৩-কার্ড স্লট রেন্ডার =====
    function buildCard(index) {
      const p = eligibleProfiles[index];
      const card = document.createElement('div');
      card.className = 'ldl-cd';

      const ph = document.createElement('div');
      ph.className = 'ldl-ph';
      if (p.avatar_url) {
        const img = document.createElement('img');
        img.src = p.avatar_url;
        img.alt = p.full_name || '';
        ph.appendChild(img);
      } else {
        ph.style.background = COLORS[index % COLORS.length];
        const icon = document.createElement('i');
        icon.className = 'fas fa-user';
        ph.appendChild(icon);
      }

      const name = document.createElement('div');
      name.className = 'ldl-cd-name';
      name.textContent = p.full_name || 'ইউজার';

      const tag = document.createElement('div');
      tag.className = 'ldl-cd-tag';
      tag.textContent = 'স্মার্ট ফেনী সদস্য';

      card.appendChild(ph);
      card.appendChild(name);
      card.appendChild(tag);
      return card;
    }

    function offsetOf(i) {
      let o = (((i - cur) % N) + N) % N;
      if (o > N / 2) o -= N;
      return o;
    }

    function placeCard(card, o, forceHidden) {
      const k = Math.max(-2, Math.min(2, o));
      card.style.width = cardW + 'px';
      card.style.height = cardH + 'px';
      card.classList.toggle('c', o === 0);

      let t = 'translate(-50%, -50%) ';
      let op = 1;
      if (k === 0) {
        t += 'scale(1.08) translateZ(40px)';
      } else {
        const scale = Math.abs(k) === 1 ? 0.74 : 0.6;
        t += `translateX(${k * cardW * 0.8}px) scale(${scale}) rotateY(${-k * 28}deg)`;
        if (Math.abs(k) === 2) op = 0;
      }
      if (forceHidden) op = 0;

      card.style.transform = t;
      card.style.opacity = String(op);
      card.style.zIndex = o === 0 ? '3' : Math.abs(o) === 1 ? '2' : '1';
    }

    function render(dur) {
      if (!N) return;
      const sw = stageEl.clientWidth;
      const sh = stageEl.clientHeight;
      if (!sw || !sh) return;

      cardW = Math.min(190, Math.max(118, sw * 0.42));
      cardW = Math.min(cardW, (sh * 0.88) / 1.42);
      cardH = cardW * 1.42;
      stageEl.style.setProperty('--ldl-dur', dur + 's');

      neededSet = new Set();
      for (let o = -2; o <= 2; o++) {
        neededSet.add((((cur + o) % N) + N) % N);
      }

      neededSet.forEach((i) => {
        let card = mounted.get(i);
        const o = offsetOf(i);
        if (!card) {
          card = buildCard(i);
          card.style.transition = 'none';
          placeCard(card, o, true);
          stageEl.appendChild(card);
          mounted.set(i, card);
          void card.offsetWidth; // reflow — যাতে ট্রানজিশন শুধু পরের স্টেপে চলে
          card.style.transition = '';
        }
        if (card._rm) {
          clearTimeout(card._rm);
          card._rm = null;
        }
        placeCard(card, o, false);
      });

      mounted.forEach((card, i) => {
        if (neededSet.has(i)) return;
        placeCard(card, offsetOf(i) < 0 ? -3 : 3, true);
        if (!card._rm) {
          card._rm = setTimeout(() => {
            if (!neededSet.has(i)) {
              card.remove();
              mounted.delete(i);
            }
          }, dur * 1000 + 80);
        }
      });
    }

    function clearStage() {
      mounted.forEach((card) => card.remove());
      mounted.clear();
    }

    function slideTo(index, dur) {
      cur = index;
      render(dur == null ? 0.6 : dur);
    }

    // ===== idle — প্রতি ১ সেকেন্ডে এক ধাপ স্লাইড =====
    function idleStep() {
      if (!idleActive) return;
      slideTo((cur + 1) % N, 0.7);
      idleTimer = setTimeout(idleStep, 1000);
    }

    function startIdle() {
      if (idleActive || !N) return;
      idleActive = true;
      idleTimer = setTimeout(idleStep, 1000);
    }

    function stopIdle() {
      idleActive = false;
      if (idleTimer) clearTimeout(idleTimer);
    }

    // ===== স্পিন — ৫সে ধীরে শুরু, মাঝে ফুল স্পিড (কমপক্ষে ২ রাউন্ড),
    // শেষ ৫সে ধীরে থামা। যে কার্ডে থামে সেটাই বিজয়ী =====
    const SPIN_RAMP_MS = 5000;
    const SPIN_FAST_DELAY = 40;
    const SPIN_SLOW_DELAY = 480;

    function spinDelayAt(elapsed, totalDuration) {
      if (elapsed < SPIN_RAMP_MS) {
        const t = elapsed / SPIN_RAMP_MS;
        return SPIN_SLOW_DELAY + (SPIN_FAST_DELAY - SPIN_SLOW_DELAY) * t;
      }
      const rampDownStart = totalDuration - SPIN_RAMP_MS;
      if (elapsed >= rampDownStart) {
        const t = (elapsed - rampDownStart) / SPIN_RAMP_MS;
        return SPIN_FAST_DELAY + (SPIN_SLOW_DELAY - SPIN_FAST_DELAY) * t;
      }
      return SPIN_FAST_DELAY;
    }

    function spinToWinner(onLanded) {
      stopIdle();
      const startIndex = cur;

      // ফুল স্পিডে কমপক্ষে ২ রাউন্ড — ইউজার বেশি হলে মাঝের সময় বাড়ে (সর্বোচ্চ ৬০সে)
      const minMiddle = 2 * N * SPIN_FAST_DELAY + 1000;
      const middleDuration = Math.min(60000, Math.max(20000 + Math.random() * 5000, minMiddle));
      const totalDuration = SPIN_RAMP_MS * 2 + middleDuration;

      // আগে নিঃশব্দে সিমুলেট করে দেখা মোট কত ধাপ হবে → সেই কার্ডেই থামবে
      let simElapsed = 0;
      let simSteps = 0;
      while (simElapsed < totalDuration) {
        simElapsed += spinDelayAt(simElapsed, totalDuration);
        simSteps++;
      }
      const winnerIndex = (startIndex + simSteps) % N;

      const startTs = performance.now();
      let idx = startIndex;

      function tick() {
        const elapsed = performance.now() - startTs;
        if (elapsed >= totalDuration) {
          slideTo(winnerIndex, 0.5); // ড্রিফট হলেও নিশ্চিতভাবে সঠিক কার্ডে থামা
          onLanded(winnerIndex);
          return;
        }
        idx = (idx + 1) % N;
        const d = spinDelayAt(elapsed, totalDuration);
        slideTo(idx, Math.min((d * 0.95) / 1000, 0.5));
        setTimeout(tick, d);
      }
      tick();
    }

    // ===== কনফেটি =====
    let confettiRunning = false;

    function resizeCanvas() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function launchConfetti() {
      const ctx = confettiCanvas.getContext('2d');
      const colors = ['#FFD700', '#FF6B35', '#c0267e', '#4ADE80', '#fff'];
      const particles = Array.from({ length: 200 }, () => ({
        x: Math.random() * confettiCanvas.width,
        y: -20 - Math.random() * 300,
        r: 4 + Math.random() * 6,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: 2 + Math.random() * 4,
        vx: -2 + Math.random() * 4,
        rot: Math.random() * 360,
        vrot: -6 + Math.random() * 12,
      }));

      if (confettiRunning) return;
      confettiRunning = true;
      let frames = 0;

      function tick() {
        ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        frames++;
        let anyAlive = false;
        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vrot;
          if (p.y < confettiCanvas.height + 20) anyAlive = true;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.6);
          ctx.restore();
        });
        if (anyAlive && frames < 480) {
          requestAnimationFrame(tick);
        } else {
          confettiRunning = false;
          ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        }
      }
      requestAnimationFrame(tick);
    }

    // ===== মেইন স্পিন ফ্লো =====
    function startSpin() {
      if (isSpinning || N === 0) return;
      isSpinning = true;
      spinBtn.disabled = true;
      statusEl.textContent = '🔥 ড্র চলছে... ভাগ্যের চাকা ঘুরছে';
      statusEl.classList.add('live');

      spinToWinner((winnerIndex) => {
        isSpinning = false;
        statusEl.classList.remove('live');
        statusEl.textContent = '';

        const profile = eligibleProfiles[winnerIndex];
        const ph = mounted.get(winnerIndex)?.querySelector('.ldl-ph');

        // কিছুক্ষণ বিজয়ীর ছবি মাঝের কার্ডে গ্লো/পালস করবে, তারপর সেলিব্রেশন
        ph?.classList.add('pulse');
        setTimeout(() => {
          ph?.classList.remove('pulse');
          showWinner(profile);
        }, 3500);
      });
    }

    function showWinner(profile) {
      winnerNameEl.textContent = profile.full_name || 'ইউজার';
      winnerPhoneEl.textContent = profile.phone || '';

      if (profile.avatar_url) {
        winnerPhotoImg.src = profile.avatar_url;
        winnerPhotoImg.style.display = 'block';
        winnerPhotoIcon.style.display = 'none';
      } else {
        winnerPhotoImg.style.display = 'none';
        winnerPhotoIcon.style.display = 'block';
      }

      slotView.style.display = 'none';
      spinBtn.style.display = 'none';
      winnerView.style.display = 'flex';
      launchConfetti();
      setTimeout(launchConfetti, 2500);
    }

    function backToSlot() {
      winnerView.style.display = 'none';
      slotView.style.display = 'flex';
      spinBtn.style.display = 'inline-flex';
      spinBtn.disabled = false;
      statusEl.textContent = IDLE_STATUS;
      clearStage();
      render(0.01);
      startIdle();
    }

    spinBtn?.addEventListener('click', startSpin);
    respinBtn?.addEventListener('click', () => {
      backToSlot();
      startSpin();
    });

    window.addEventListener('resize', () => {
      if (N && slotView.style.display !== 'none') render(0.01);
    });

    // ===== ক্যামেরা — ছোট বক্স + ফুল স্ক্রিন (পাশাপাশি/উপর-নিচ) =====
    const cameraToggleBtn = document.getElementById('cameraToggleBtn');
    const camEl = document.getElementById('ldlCam');
    const cameraVideo = document.getElementById('ldlCameraVideo');
    const camFb = document.getElementById('ldlCamFb');
    const camFsBtn = document.getElementById('camFsBtn');
    const camFsIcon = document.getElementById('camFsIcon');
    const camCloseBtn = document.getElementById('camCloseBtn');
    let cameraStream = null;

    function relayout() {
      setTimeout(() => {
        if (N && slotView.style.display !== 'none') render(0.01);
      }, 60);
    }

    function closeCamera() {
      if (cameraStream) {
        cameraStream.getTracks().forEach((t) => t.stop());
        cameraStream = null;
      }
      cameraVideo.srcObject = null;
      cameraVideo.style.display = 'none';
      camEl.className = 'ldl-cam small';
      mainEl.classList.remove('cam-full');
      camFsIcon.className = 'fas fa-expand';
      cameraToggleBtn.classList.remove('on');
      relayout();
    }

    async function openCamera() {
      camEl.className = 'ldl-cam small on';
      cameraToggleBtn.classList.add('on');
      camFb.style.display = 'grid';
      camFb.textContent = 'ক্যামেরা চালু হচ্ছে...';
      relayout();
      try {
        cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        cameraVideo.srcObject = cameraStream;
        cameraVideo.style.display = 'block';
        camFb.style.display = 'none';
      } catch (err) {
        camFb.textContent = 'ক্যামেরা চালু করা যায়নি';
      }
    }

    cameraToggleBtn?.addEventListener('click', () => {
      if (camEl.classList.contains('on')) closeCamera();
      else openCamera();
    });

    camFsBtn?.addEventListener('click', () => {
      const goFull = !camEl.classList.contains('full');
      camEl.className = 'ldl-cam on ' + (goFull ? 'full' : 'small');
      mainEl.classList.toggle('cam-full', goFull);
      camFsIcon.className = goFull ? 'fas fa-compress' : 'fas fa-expand';
      relayout();
    });

    camCloseBtn?.addEventListener('click', closeCamera);

    // ===== ইনিশিয়ালাইজেশন =====
    async function loadDraw() {
      const { data, error } = await supabase
        .from('lucky_draws')
        .select('*')
        .eq('id', drawId)
        .single();

      if (error || !data) {
        drawTitleEl.textContent = 'ড্র পাওয়া যায়নি';
        spinBtn.style.display = 'none';
        statusEl.textContent = '';
        return;
      }

      drawRecord = data;
      // টাইটেল সবসময় ব্র্যান্ড লাইন; ড্রয়ের নাম/বর্ণনা প্রাইজ লাইনে
      const prizeLine = [data.title, data.description].filter(Boolean).join(' — ');
      drawDescEl.textContent = prizeLine ? `🎁 ${prizeLine}` : '';

      eligibleProfiles = shuffleArray(await computeEligibleProfiles(data.filter_criteria));
      N = eligibleProfiles.length;

      if (N === 0) {
        eligibleCountEl.textContent = 'এই ফিল্টারে কোনো এলিজিবল ইউজার নেই';
        statusEl.textContent = '';
        spinBtn.disabled = true;
        return;
      }

      eligibleCountEl.textContent = `মোট এলিজিবল: ${N} জন`;
      statusEl.textContent = IDLE_STATUS;
      cur = 0;
      render(0.01);
      startIdle();
    }

    window.addEventListener('smartfeni:admin-ready', (e) => {
      const { role, profile } = e.detail;
      if (role !== 'admin') {
        window.location.href = '/admin';
        return;
      }
      currentUserId = profile.id;
      loadDraw();
    });

    initAdminGuard();
  </script>
</BaseLayout>
