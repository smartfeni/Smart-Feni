---
// ============================================================
// পেজ: লাকি ড্র লাইভ (/admin/lucky-draw/[id]/live)
// শুধু role === 'admin' অ্যাক্সেস করতে পারবে (moderator ব্লক)।
// সম্পূর্ণ ইমার্সিভ ফুল-পেজ ওভারলে — BaseLayout না বদলেই।
//
// আপডেট (এই সেশন — সম্পূর্ণ রিডিজাইন):
//   - স্লট মেশিন সম্পূর্ণ সিম্পলিফাই করা হলো — ভারী ৩ডি ভার্চুয়াল
//     রিলের বদলে এখন: idle অবস্থায় হালকা pure-CSS মার্কি (নাম
//     লিস্ট ধীরে স্ক্রল, কোনো JS লুপ নাই — পারফরম্যান্ট), স্পিনের
//     সময় একটা ফ্ল্যাশিং টেক্সট ডিসপ্লে যেটা ধীরে ধীরে ডিসিলারেট
//     করে (দ্রুত থেকে আস্তে) ঠিক বিজয়ীর নামে থেমে যায়। এটা
//     ইউজারের পাঠানো রেফারেন্স ডিজাইনের প্যাটার্ন অনুসরণ করছে।
//   - হেডার এখন সাদা ব্যাকগ্রাউন্ড, ঠিক Header.astro-র মতো — মাঝে
//     ডাইনামিক লোগো + ট্যাগলাইন, ডান পাশে প্রোফাইল আইকনের জায়গায়
//     গোলাকার ক্যামেরা বাটন (টগল করলে সেই সার্কেলের ভেতরেই লাইভ
//     সেলফ-ভিউ দেখায়)। আগের ভাসমান ড্র্যাগেবল PIP বাদ দেওয়া হলো।
//   - বিজয়ী রিভিল এখন পুরো স্ক্রিন জুড়ে সেলিব্রেশন ওভারলে (ব্র্যান্ডিং
//     সহ), যেখানে "আবার ড্র করুন" আর ছোট্ট "ব্যাক" বাটন থাকে —
//     ব্যাক চাপলে ঠিক প্রথমবার ঢোকার idle অবস্থায় ফিরে যায় (ধীরে
//     স্ক্রলিং মার্কি লিস্ট)। কোণার ছোট্ট "সেভ" (লক) বাটন
//     সেলিব্রেশন স্ক্রিনেও থাকে।
//   - status === 'completed' হলে সরাসরি লক করা ফাইনাল সেলিব্রেশন
//     (রেসপিন/ব্যাক বাটন ছাড়া, শুধু তারিখ সহ) দেখাবে।
// ============================================================

export const prerender = false;

import BaseLayout from '../../../../components/layout/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="লাইভ ড্র | স্মার্ট ফেনী">
  <div id="ldLiveOverlay" class="ld-live-overlay" data-draw-id={id}>

    <!-- ===== লোডিং স্টেট (গার্ড + ডেটা লোড) ===== -->
    <div id="adminLoadingState" class="ldl-loading">
      <div class="ldl-spinner"></div>
      <p>যাচাই করা হচ্ছে...</p>
    </div>

    <!-- ===== আসল কন্টেন্ট (গার্ড পাস হলে দেখা যাবে) ===== -->
    <div id="adminGuardedContent" class="ldl-content-wrap" style="display:none;">

      <!-- ===== টপ হেডার — সাদা, সাইটের হেডারের স্টাইলে ===== -->
      <div class="ldl-topbar">
        <a href="/admin/lucky-draw" class="ldl-topbar-back" title="ফিরে যান">
          <i class="fas fa-arrow-left"></i>
        </a>

        <div class="ldl-topbar-logo">
          <img id="ldlTopLogo" src="/logo.png" alt="স্মার্ট ফেনী" />
          <span class="ldl-topbar-tag" id="ldlTopTag">লাকি ড্র</span>
        </div>

        <button type="button" class="ldl-camera-circle" id="cameraToggleBtn" title="ক্যামেরা">
          <video id="ldlCameraVideo" autoplay muted playsinline></video>
          <i class="fas fa-video" id="ldlCameraIcon"></i>
        </button>
      </div>

      <!-- ===== মূল ড্র স্টেজ (idle + স্পিন অবস্থা) ===== -->
      <div class="ldl-stage-area" id="ldlMainView">

        <div class="ldl-header">
          <h1 id="ldlDrawTitle">লোড হচ্ছে...</h1>
          <p id="ldlDrawDescription"></p>
        </div>

        <div class="ldl-stage" id="ldlStage">

          <!-- ===== স্লট মেশিন (সিম্পল ডিজিটাল ডিসপ্লে) ===== -->
          <div class="ldl-slot" id="ldlSlot" style="display:none;">
            <div class="ldl-slot-display">
              <div class="ldl-slot-label"><i class="fas fa-trophy"></i> বর্তমান বিজয়ী</div>

              <!-- idle: ধীরে স্ক্রলিং মার্কি (pure CSS, হালকা) -->
              <div class="ldl-slot-marquee" id="ldlSlotMarquee">
                <div class="ldl-slot-marquee-track" id="ldlSlotMarqueeTrack"></div>
              </div>

              <!-- স্পিন: ফ্ল্যাশিং টেক্সট -->
              <div class="ldl-slot-flash" id="ldlSlotFlash" style="display:none;"></div>

              <div class="ldl-slot-reels">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>

          <!-- ===== স্পিনিং হুইল স্টাইল (অপরিবর্তিত) ===== -->
          <div class="ldl-wheel-wrap" id="ldlWheelWrap" style="display:none;">
            <div class="ldl-wheel-pointer"><i class="fas fa-caret-down"></i></div>
            <div class="ldl-wheel" id="ldlWheel"></div>
          </div>

        </div>

        <p class="ldl-eligible-count" id="ldlEligibleCount"></p>

        <div class="ldl-controls">
          <button type="button" id="spinBtn" class="ldl-spin-btn">
            <i class="fas fa-play"></i> <span>ড্র শুরু করুন</span>
          </button>
        </div>
      </div>

      <!-- ===== ফুল-স্ক্রিন সেলিব্রেশন ওভারলে (বিজয়ী রিভিল / ফাইনাল লক) ===== -->
      <div class="ldl-celebration" id="ldlCelebration">
        <button type="button" id="backToIdleBtn" class="ldl-celeb-back" title="ফিরে যান">
          <i class="fas fa-arrow-left"></i>
        </button>

        <div class="ldl-celeb-brand">
          <img id="ldlCelebLogo" src="/logo.png" alt="স্মার্ট ফেনী" />
          <span>স্মার্ট ফেনী</span>
        </div>

        <i class="fas fa-trophy ldl-celeb-trophy"></i>
        <p class="ldl-celeb-label" id="ldlCelebLabel">বিজয়ী</p>
        <h2 class="ldl-celeb-name" id="ldlCelebName"></h2>
        <p class="ldl-celeb-phone" id="ldlCelebPhone"></p>
        <p class="ldl-celeb-date" id="ldlCelebDate" style="display:none;"></p>

        <button type="button" id="respinBtn" class="ldl-respin-btn">
          <i class="fas fa-rotate"></i> আবার ড্র করুন
        </button>
      </div>

      <!-- ===== ছোট্ট সেভ বাটন — বিজয়ী রিভিল হলে দেখা যাবে ===== -->
      <button type="button" id="saveWinnerBtn" class="ldl-save-btn" style="display:none;" title="এই ফলাফল ফাইনাল হিসেবে সেভ করুন">
        <i class="fas fa-lock"></i>
      </button>

      <!-- ===== canvas confetti ===== -->
      <canvas id="ldlConfettiCanvas" class="ldl-confetti-canvas"></canvas>

    </div>
  </div>

  <style>
    .ld-live-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: radial-gradient(circle at top, #223257 0%, #101a30 65%, #0a1122 100%);
      color: #fff;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .ldl-loading {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      color: #cfd8e8;
      font-weight: 600;
    }

    .ldl-spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(255,255,255,0.15);
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: ldl-spin 0.8s linear infinite;
    }

    @keyframes ldl-spin {
      to { transform: rotate(360deg); }
    }

    .ldl-content-wrap {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    /* ===== টপবার — সাদা, সাইট হেডারের স্টাইলে ===== */
    .ldl-topbar {
      background: #fff;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 5;
      flex-shrink: 0;
      box-shadow: 0 2px 14px rgba(0,0,0,0.18);
    }

    .ldl-topbar-back {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1B2A4A;
      text-decoration: none;
      background: #F4F7FC;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .ldl-topbar-back:hover {
      background: #FFF0EA;
      color: #FF6B35;
    }

    .ldl-topbar-logo {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ldl-topbar-logo img {
      height: 38px;
      width: auto;
      display: block;
      margin-bottom: 2px;
    }

    .ldl-topbar-tag {
      font-size: 0.62rem;
      font-weight: 700;
      color: #FF6B35;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ===== ক্যামেরা সার্কেল বাটন (প্রোফাইল অ্যাভাটারের জায়গায়) ===== */
    .ldl-camera-circle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #FFF0EA;
      border: 2px solid #FFE3D4;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      cursor: pointer;
      position: relative;
      flex-shrink: 0;
      padding: 0;
      transition: border-color 0.2s ease;
    }

    .ldl-camera-circle:hover {
      border-color: #FF6B35;
    }

    .ldl-camera-circle i {
      color: #FF6B35;
      font-size: 1.05rem;
    }

    .ldl-camera-circle video {
      display: none;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .ldl-camera-circle.active {
      border-color: #FF6B35;
    }

    .ldl-camera-circle.active i {
      display: none;
    }

    .ldl-camera-circle.active video {
      display: block;
    }

    /* ===== মূল স্টেজ এরিয়া ===== */
    .ldl-stage-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 28px 20px;
      text-align: center;
      overflow-y: auto;
    }

    .ldl-header {
      margin-bottom: 22px;
    }

    .ldl-header h1 {
      font-size: 1.8rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 8px;
      text-shadow: 0 4px 20px rgba(255, 107, 53, 0.3);
    }

    .ldl-header p {
      color: #a9b6cc;
      font-size: 0.95rem;
      max-width: 480px;
      margin: 0 auto;
    }

    .ldl-stage {
      margin-bottom: 20px;
      width: 100%;
      display: flex;
      justify-content: center;
    }

    /* ===== স্লট — সিম্পল ডিজিটাল ডিসপ্লে ===== */
    .ldl-slot-display {
      width: min(92vw, 420px);
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(12px);
      border-radius: 22px;
      border: 1px solid rgba(255,107,53,0.25);
      padding: 22px 20px 18px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    .ldl-slot-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #8a95ab;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .ldl-slot-label i {
      color: #FFD700;
    }

    .ldl-slot-marquee,
    .ldl-slot-flash {
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .ldl-slot-marquee-track {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      animation: ldl-marquee-scroll linear infinite;
    }

    .ldl-slot-marquee-track div {
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 800;
      color: #e8edf7;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      padding: 0 16px;
      width: 100%;
    }

    @keyframes ldl-marquee-scroll {
      from { transform: translateY(0); }
      to { transform: translateY(-50%); }
    }

    .ldl-slot-flash {
      font-size: 1.6rem;
      font-weight: 800;
      background: linear-gradient(to right, #FF6B35, #FFD27A);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      padding: 0 16px;
    }

    .ldl-slot-reels {
      display: flex;
      gap: 6px;
      justify-content: center;
      margin-top: 12px;
    }

    .ldl-slot-reels span {
      width: 6px;
      height: 26px;
      border-radius: 4px;
      background: linear-gradient(to bottom, #FF6B35, transparent, #FF6B35);
      opacity: 0.15;
      animation: ldl-reel-pulse 1.5s ease-in-out infinite;
    }

    .ldl-slot-reels span:nth-child(2) { animation-delay: 0.15s; }
    .ldl-slot-reels span:nth-child(3) { animation-delay: 0.3s; }
    .ldl-slot-reels span:nth-child(4) { animation-delay: 0.45s; }
    .ldl-slot-reels span:nth-child(5) { animation-delay: 0.6s; }

    @keyframes ldl-reel-pulse {
      0%, 100% { opacity: 0.12; transform: scaleY(0.6); }
      50% { opacity: 0.4; transform: scaleY(1); }
    }

    /* ===== স্পিনিং হুইল ===== */
    .ldl-wheel-wrap {
      position: relative;
      width: min(80vw, 320px);
      height: min(80vw, 320px);
    }

    .ldl-wheel-pointer {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 2.2rem;
      color: #FF6B35;
      z-index: 3;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
    }

    .ldl-wheel {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      position: relative;
      border: 6px solid #FF6B35;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      overflow: hidden;
      transition: transform 0.1s linear;
    }

    .ldl-wheel-label {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 46%;
      transform-origin: left center;
      font-size: 0.72rem;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    }

    .ldl-eligible-count {
      font-size: 0.88rem;
      color: #a9b6cc;
      margin-bottom: 18px;
      min-height: 1.2em;
    }

    .ldl-controls {
      margin-bottom: 6px;
    }

    .ldl-spin-btn,
    .ldl-respin-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 16px 40px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 1.02rem;
      cursor: pointer;
      box-shadow: 0 14px 34px rgba(255,107,53,0.4);
      transition: all 0.2s ease;
    }

    .ldl-spin-btn:hover,
    .ldl-respin-btn:hover {
      background: #e85a2a;
      transform: translateY(-2px);
    }

    .ldl-spin-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* ===== ফুল-স্ক্রিন সেলিব্রেশন ওভারলে ===== */
    .ldl-celebration {
      position: fixed;
      inset: 0;
      z-index: 10050;
      background: radial-gradient(circle at top, #2c3f6b 0%, #101a30 60%, #060a16 100%);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
      text-align: center;
    }

    .ldl-celeb-back {
      position: absolute;
      top: 20px;
      left: 20px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      border: none;
      color: #cfd8e8;
      font-size: 1.05rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .ldl-celeb-back:hover {
      background: rgba(255,255,255,0.18);
      color: #fff;
    }

    .ldl-celeb-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 24px;
      opacity: 0.85;
    }

    .ldl-celeb-brand img {
      height: 26px;
      width: auto;
    }

    .ldl-celeb-brand span {
      font-size: 0.9rem;
      font-weight: 700;
      color: #cfd8e8;
      letter-spacing: 0.3px;
    }

    .ldl-celeb-trophy {
      font-size: 3.2rem;
      color: #FFD700;
      margin-bottom: 12px;
      filter: drop-shadow(0 8px 20px rgba(255, 215, 0, 0.35));
      animation: ldl-trophy-bounce 1.4s ease-in-out infinite;
    }

    @keyframes ldl-trophy-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .ldl-celeb-label {
      color: #a9b6cc;
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 6px;
    }

    .ldl-celeb-name {
      font-size: 2.6rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
      text-shadow: 0 6px 30px rgba(255, 107, 53, 0.35);
    }

    .ldl-celeb-phone {
      color: #a9b6cc;
      font-size: 1.05rem;
      margin-bottom: 8px;
    }

    .ldl-celeb-date {
      color: #6f7f9c;
      font-size: 0.8rem;
      margin-bottom: 8px;
    }

    .ldl-respin-btn {
      margin-top: 24px;
    }

    .ldl-celebration.locked .ldl-respin-btn,
    .ldl-celebration.locked .ldl-celeb-back {
      display: none;
    }

    .ldl-save-btn {
      position: fixed;
      bottom: 18px;
      right: 18px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: #a9b6cc;
      font-size: 0.72rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      z-index: 10060;
    }

    .ldl-save-btn:hover {
      background: #FF6B35;
      color: #fff;
      border-color: #FF6B35;
    }

    .ldl-confetti-canvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 10040;
    }

    @media (max-width: 480px) {
      .ldl-topbar-logo img { height: 30px; }
      .ldl-header h1 { font-size: 1.4rem; }
      .ldl-slot-marquee-track div,
      .ldl-slot-flash { font-size: 1.15rem; }
      .ldl-celeb-name { font-size: 1.9rem; }
      .ldl-celeb-trophy { font-size: 2.4rem; }
    }
  </style>

  <script>
    import { initAdminGuard } from '../../../../lib/adminGuard.js';
    import { supabase } from '../../../../lib/supabase.js';

    const overlay = document.getElementById('ldLiveOverlay');
    const drawId = overlay.dataset.drawId;

    const drawTitleEl = document.getElementById('ldlDrawTitle');
    const drawDescEl = document.getElementById('ldlDrawDescription');
    const mainView = document.getElementById('ldlMainView');
    const stageEl = document.getElementById('ldlStage');
    const slotEl = document.getElementById('ldlSlot');
    const slotMarquee = document.getElementById('ldlSlotMarquee');
    const slotMarqueeTrack = document.getElementById('ldlSlotMarqueeTrack');
    const slotFlash = document.getElementById('ldlSlotFlash');
    const wheelWrapEl = document.getElementById('ldlWheelWrap');
    const wheelEl = document.getElementById('ldlWheel');
    const eligibleCountEl = document.getElementById('ldlEligibleCount');
    const spinBtn = document.getElementById('spinBtn');

    const celebration = document.getElementById('ldlCelebration');
    const celebLabel = document.getElementById('ldlCelebLabel');
    const celebName = document.getElementById('ldlCelebName');
    const celebPhone = document.getElementById('ldlCelebPhone');
    const celebDate = document.getElementById('ldlCelebDate');
    const respinBtn = document.getElementById('respinBtn');
    const backToIdleBtn = document.getElementById('backToIdleBtn');
    const saveWinnerBtn = document.getElementById('saveWinnerBtn');
    const confettiCanvas = document.getElementById('ldlConfettiCanvas');

    let drawRecord = null;
    let eligibleProfiles = []; // [{id, full_name, phone}]
    let currentWinner = null;
    let isSpinning = false;
    let currentUserId = null;

    function fmtDate(iso) {
      if (!iso) return '';
      return new Date(iso).toLocaleString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    // ===== ব্র্যান্ড লোগো — Header.astro-র একই প্যাটার্ন (site_images, key='logo') =====
    async function loadBrandLogo() {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', 'logo')
        .maybeSingle();

      if (data?.storage_path) {
        const { data: urlData } = supabase.storage.from('listing-images').getPublicUrl(data.storage_path);
        const bust = data.updated_at ? new Date(data.updated_at).getTime() : Date.now();
        const url = `${urlData.publicUrl}?v=${bust}`;
        const topLogo = document.getElementById('ldlTopLogo');
        const celebLogo = document.getElementById('ldlCelebLogo');
        if (topLogo) topLogo.src = url;
        if (celebLogo) celebLogo.src = url;
      }
    }
    loadBrandLogo();

    // ===== এলিজিবল প্রোফাইল লিস্ট (new.astro-র লজিকের সাথে সামঞ্জস্যপূর্ণ) =====
    async function computeEligibleProfiles(filterCriteria, excludePrevWinners) {
      const { data: profiles, error } = await supabase
        .from('profiles')
        .select('id, full_name, phone, created_at, role, is_shop_owner, is_club_owner, is_blocked')
        .eq('is_blocked', false)
        .order('created_at', { ascending: true });

      if (error || !profiles) return [];

      const excludeRoles = new Set(filterCriteria?.exclude_roles || []);
      let filtered = profiles.filter((p) => {
        if (excludeRoles.has(p.role)) return false;
        if (filterCriteria?.exclude_shop_owners && p.is_shop_owner) return false;
        if (filterCriteria?.exclude_club_owners && p.is_club_owner) return false;
        return true;
      });

      if (filterCriteria?.first_n) {
        filtered = filtered.slice(0, filterCriteria.first_n);
      }

      if (excludePrevWinners) {
        const { data: winners } = await supabase.from('lucky_draw_winners').select('profile_id');
        const winnerIds = new Set((winners || []).map((w) => w.profile_id));
        filtered = filtered.filter((p) => !winnerIds.has(p.id));
      }

      return filtered;
    }

    // ===== স্লট — idle মার্কি (pure CSS) =====
    function buildSlotMarquee(names) {
      slotMarqueeTrack.innerHTML = '';
      // দুইবার রিপিট করলে seamless লুপ পাওয়া যায় (translateY 0 → -50%)
      const loop = [...names, ...names];
      loop.forEach((name) => {
        const div = document.createElement('div');
        div.textContent = name;
        slotMarqueeTrack.appendChild(div);
      });
      // লিস্টের দৈর্ঘ্য অনুযায়ী গতি সামঞ্জস্য — সবসময় "ধীর" মনে হবে
      const duration = Math.max(names.length * 2.4, 10);
      slotMarqueeTrack.style.animationDuration = `${duration}s`;
    }

    function showSlotIdle() {
      slotFlash.style.display = 'none';
      slotMarquee.style.display = 'flex';
    }

    function showSlotFlash() {
      slotMarquee.style.display = 'none';
      slotFlash.style.display = 'flex';
    }

    // ===== স্লট স্পিন — ধীরে ধীরে ডিসিলারেট করা ফ্ল্যাশিং টেক্সট =====
    function spinSlotFlash(winnerName, durationMs, onDone) {
      showSlotFlash();
      const startTs = performance.now();
      let delay = 55;

      function tick() {
        const elapsed = performance.now() - startTs;
        if (elapsed >= durationMs) {
          slotFlash.textContent = winnerName;
          onDone();
          return;
        }
        const randomProfile = eligibleProfiles[Math.floor(Math.random() * eligibleProfiles.length)];
        slotFlash.textContent = randomProfile.full_name || 'ইউজার';
        delay = Math.min(420, delay * 1.045); // ধীরে ধীরে ডিসিলারেট
        setTimeout(tick, delay);
      }
      tick();
    }

    // ===== হুইল রেন্ডার/স্পিন (অপরিবর্তিত) =====
    let wheelRotation = 0;

    function buildWheel() {
      wheelEl.innerHTML = '';
      const n = eligibleProfiles.length;
      const segAngle = 360 / n;
      const colors = ['#FF6B35', '#1B2A4A', '#FF8C5A', '#2E3E63'];
      const gradientParts = eligibleProfiles.map((_, i) => {
        const color = colors[i % colors.length];
        return `${color} ${i * segAngle}deg ${(i + 1) * segAngle}deg`;
      });
      wheelEl.style.background = `conic-gradient(${gradientParts.join(',')})`;

      eligibleProfiles.forEach((p, i) => {
        const label = document.createElement('div');
        label.className = 'ldl-wheel-label';
        label.textContent = p.full_name || 'ইউজার';
        const angle = i * segAngle + segAngle / 2;
        label.style.transform = `rotate(${angle}deg)`;
        wheelEl.appendChild(label);
      });
    }

    function spinWheel(winnerIndex, durationMs) {
      const n = eligibleProfiles.length;
      const segAngle = 360 / n;
      const extraSpins = 10 + Math.floor(Math.random() * 6);
      const targetSegCenter = winnerIndex * segAngle + segAngle / 2;
      const finalRotation = wheelRotation + extraSpins * 360 + (360 - targetSegCenter);

      wheelEl.style.transition = `transform ${durationMs}ms cubic-bezier(0.1, 0.7, 0.15, 1)`;
      requestAnimationFrame(() => {
        wheelEl.style.transform = `rotate(${finalRotation}deg)`;
      });
      wheelRotation = finalRotation % 360;
    }

    // ===== কনফেটি (ছোট্ট ভ্যানিলা ক্যানভাস ইমপ্লিমেন্টেশন) =====
    let confettiParticles = [];
    let confettiRunning = false;

    function resizeCanvas() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function launchConfetti() {
      const ctx = confettiCanvas.getContext('2d');
      const colors = ['#FF6B35', '#FFD700', '#1B2A4A', '#4ADE80', '#fff'];
      confettiParticles = Array.from({ length: 160 }, () => ({
        x: Math.random() * confettiCanvas.width,
        y: -20 - Math.random() * 200,
        r: 4 + Math.random() * 5,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: 2 + Math.random() * 3,
        vx: -1.5 + Math.random() * 3,
        rot: Math.random() * 360,
        vrot: -6 + Math.random() * 12,
      }));

      if (confettiRunning) return;
      confettiRunning = true;
      let frames = 0;

      function tick() {
        ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        frames++;
        let anyAlive = false;
        confettiParticles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vrot;
          if (p.y < confettiCanvas.height + 20) anyAlive = true;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.6);
          ctx.restore();
        });
        if (anyAlive && frames < 420) {
          requestAnimationFrame(tick);
        } else {
          confettiRunning = false;
          ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        }
      }
      requestAnimationFrame(tick);
    }

    // ===== মেইন স্পিন ফ্লো =====
    function pickRandomWinner() {
      const idx = Math.floor(Math.random() * eligibleProfiles.length);
      return { profile: eligibleProfiles[idx], index: idx };
    }

    function startSpin() {
      if (isSpinning || eligibleProfiles.length === 0) return;
      isSpinning = true;
      spinBtn.disabled = true;

      const { profile, index } = pickRandomWinner();
      currentWinner = profile;

      const durationMs = 30000 + Math.floor(Math.random() * 10000); // ৩০-৪০ সেকেন্ড

      if (drawRecord.animation_style === 'wheel') {
        spinWheel(index, durationMs);
        setTimeout(() => {
          isSpinning = false;
          spinBtn.disabled = false;
          revealWinner(profile, false);
        }, durationMs + 200);
      } else {
        const winnerName = profile.full_name || 'ইউজার';
        spinSlotFlash(winnerName, durationMs, () => {
          isSpinning = false;
          spinBtn.disabled = false;
          revealWinner(profile, false);
        });
      }
    }

    // ===== সেলিব্রেশন দেখানো =====
    function revealWinner(profile, locked, drawnAt) {
      celebration.classList.toggle('locked', !!locked);
      celebLabel.textContent = locked ? 'ফাইনাল বিজয়ী 🎉' : 'বিজয়ী';
      celebName.textContent = profile.name || profile.full_name || 'ইউজার';
      celebPhone.textContent = profile.phone || '';

      if (locked) {
        celebDate.style.display = 'block';
        celebDate.textContent = 'ড্র হয়েছে: ' + fmtDate(drawnAt);
        saveWinnerBtn.style.display = 'none';
      } else {
        celebDate.style.display = 'none';
        saveWinnerBtn.style.display = 'flex';
      }

      celebration.style.display = 'flex';
      if (!locked) launchConfetti();
    }

    function backToIdle() {
      celebration.style.display = 'none';
      saveWinnerBtn.style.display = 'none';
      if (drawRecord?.animation_style !== 'wheel') {
        showSlotIdle();
      }
    }

    spinBtn?.addEventListener('click', startSpin);
    respinBtn?.addEventListener('click', () => {
      celebration.style.display = 'none';
      saveWinnerBtn.style.display = 'none';
      startSpin();
    });
    backToIdleBtn?.addEventListener('click', backToIdle);

    // ===== ফাইনাল সেভ (লক) =====
    saveWinnerBtn?.addEventListener('click', async () => {
      if (!currentWinner) return;
      saveWinnerBtn.disabled = true;

      const snapshot = {
        id: currentWinner.id,
        name: currentWinner.full_name,
        phone: currentWinner.phone,
      };

      const { error: winError } = await supabase.from('lucky_draw_winners').insert({
        lucky_draw_id: drawId,
        profile_id: currentWinner.id,
        name_snapshot: currentWinner.full_name,
        phone_snapshot: currentWinner.phone,
      });

      const { error: updateError } = await supabase
        .from('lucky_draws')
        .update({
          status: 'completed',
          winner_profile_id: currentWinner.id,
          winner_snapshot: snapshot,
          drawn_at: new Date().toISOString(),
        })
        .eq('id', drawId);

      if (winError || updateError) {
        saveWinnerBtn.disabled = false;
        alert('সেভ করতে সমস্যা হয়েছে, আবার চেষ্টা করুন।');
        return;
      }

      revealWinner(snapshot, true, new Date().toISOString());
    });

    // ===== ক্যামেরা (হেডার সার্কেল) =====
    const cameraToggleBtn = document.getElementById('cameraToggleBtn');
    const cameraVideo = document.getElementById('ldlCameraVideo');
    let cameraStream = null;

    cameraToggleBtn?.addEventListener('click', async () => {
      if (cameraStream) {
        cameraStream.getTracks().forEach((t) => t.stop());
        cameraStream = null;
        cameraVideo.srcObject = null;
        cameraToggleBtn.classList.remove('active');
        return;
      }
      try {
        cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        cameraVideo.srcObject = cameraStream;
        cameraToggleBtn.classList.add('active');
      } catch (err) {
        alert('ক্যামেরা চালু করা যায়নি: ' + err.message);
      }
    });

    // ===== ইনিশিয়ালাইজেশন =====
    async function loadDraw() {
      const { data, error } = await supabase
        .from('lucky_draws')
        .select('*')
        .eq('id', drawId)
        .single();

      if (error || !data) {
        drawTitleEl.textContent = 'ড্র পাওয়া যায়নি';
        eligibleCountEl.textContent = '';
        stageEl.style.display = 'none';
        spinBtn.style.display = 'none';
        return;
      }

      drawRecord = data;
      drawTitleEl.textContent = data.title;
      drawDescEl.textContent = data.description || '';

      const topTagEl = document.getElementById('ldlTopTag');
      if (topTagEl) {
        topTagEl.textContent = data.animation_style === 'wheel' ? 'লাকি ড্র হুইল' : 'লাকি ড্র স্লট';
      }

      if (data.status === 'completed') {
        mainView.style.display = 'none';
        const snap = data.winner_snapshot || {};
        revealWinner(snap, true, data.drawn_at);
        return;
      }

      eligibleProfiles = await computeEligibleProfiles(data.filter_criteria, data.exclude_previous_winners);

      if (eligibleProfiles.length === 0) {
        eligibleCountEl.textContent = 'এই ফিল্টারে কোনো এলিজিবল ইউজার নেই';
        spinBtn.disabled = true;
        return;
      }

      eligibleCountEl.textContent = `মোট এলিজিবল: ${eligibleProfiles.length} জন`;

      if (data.animation_style === 'wheel') {
        wheelWrapEl.style.display = 'block';
        buildWheel();
      } else {
        slotEl.style.display = 'block';
        const names = eligibleProfiles.map((p) => p.full_name || 'ইউজার');
        buildSlotMarquee(names);
        showSlotIdle();
      }
    }

    window.addEventListener('smartfeni:admin-ready', (e) => {
      const { role, profile } = e.detail;
      if (role !== 'admin') {
        window.location.href = '/admin';
        return;
      }
      currentUserId = profile.id;
      loadDraw();
    });

    initAdminGuard();
  </script>
</BaseLayout>
