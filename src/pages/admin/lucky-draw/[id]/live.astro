---
// ============================================================
// পেজ: লাকি ড্র লাইভ (/admin/lucky-draw/[id]/live)
// শুধু role === 'admin' অ্যাক্সেস করতে পারবে (moderator ব্লক)।
//
// আপডেট (নতুন সেলিব্রেশন ডিজাইন):
//   - ৩-কার্ড স্লট স্টাইল: মাঝেরটা বড়, দুই পাশের ২টা ছোট ও হেলানো
//     (perspective)। idle-এ প্রতি ১ সেকেন্ডে এক ধাপ স্লাইড।
//   - "উইনার খুজুন" চাপলে ৫সে ধীরে শুরু → ২০-২৫সে ফুল স্পিড (কমপক্ষে
//     ২ রাউন্ড নিশ্চিত) → ৫সে ধীরে থেমে যাওয়া। থামা কার্ডই বিজয়ী।
//   - থামার পর কার্ডের ছবি গ্লো/পালস করে, তারপর ফুল সেলিব্রেশন ভিউ।
//   - পার্পল-গোল্ড থিম, ভাসমান প্রাইজ আইকন, স্পটলাইট বিম, ওয়াটারমার্ক লোগো।
//   - ফুটারে স্মার্ট ফেনী অ্যাপ (Google Play) ডাউনলোডের আহ্বান।
//   - ক্যামেরা: ছোট বক্স + ফুল স্ক্রিন (পাশাপাশি/উপর-নিচ) অপশন।
//   - পারফরম্যান্স: শুধু মাঝের ±২ কার্ড DOM-এ থাকে (হাজার ইউজারেও হালকা)।
//   - কোনো DB রেকর্ড সেভ হয় না — প্রতিটা ড্র স্টেটলেস, আনলিমিটেড রি-ড্র।
// ============================================================

export const prerender = false;

import BaseLayout from '../../../../components/layout/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="লাইভ ড্র | স্মার্ট ফেনী">
  <div id="ldLiveOverlay" class="ld-live-overlay" data-draw-id={id}>

    <!-- ===== লোডিং স্টেট (গার্ড + ডেটা লোড) ===== -->
    <div id="adminLoadingState" class="ldl-loading">
      <div class="ldl-spinner"></div>
      <p>যাচাই করা হচ্ছে...</p>
    </div>

    <!-- ===== আসল কন্টেন্ট ===== -->
    <div id="adminGuardedContent" class="ldl-content-wrap" style="display:none;">

      <!-- ব্যাকগ্রাউন্ড ডেকোরেশন -->
      <div class="ldl-beam ldl-beam-a"></div>
      <div class="ldl-beam ldl-beam-b"></div>
      <img id="ldlWatermark" class="ldl-watermark" src="/logo.png" alt="" />
      <div id="ldlFloaters" class="ldl-floaters"></div>

      <!-- ===== টপবার — সাদা, লোগো সহ ===== -->
      <div class="ldl-topbar">
        <a href="/admin/lucky-draw" class="ldl-topbar-close" title="ড্র লিস্টে ফিরুন">
          <i class="fas fa-xmark"></i>
        </a>

        <div class="ldl-topbar-logo">
          <img id="ldlTopLogo" src="/logo.png" alt="স্মার্ট ফেনী" />
          <span class="ldl-topbar-tag">লাকি ড্র</span>
        </div>

        <button type="button" class="ldl-camera-btn" id="cameraToggleBtn" title="ক্যামেরা">
          <i class="fas fa-video"></i>
        </button>
      </div>

      <!-- ===== মেইন এরিয়া (ক্যামেরা + ড্র) ===== -->
      <div class="ldl-main" id="ldlMain">

        <!-- ক্যামেরা প্যানেল — ছোট বক্স / ফুল -->
        <div class="ldl-cam" id="ldlCam">
          <video id="ldlCameraVideo" autoplay muted playsinline></video>
          <div class="ldl-cam-fb" id="ldlCamFb">ক্যামেরা চালু হচ্ছে...</div>
          <div class="ldl-cam-btns">
            <button type="button" id="camFsBtn" title="ফুল স্ক্রিন / ছোট করুন"><i class="fas fa-expand" id="camFsIcon"></i></button>
            <button type="button" id="camCloseBtn" title="ক্যামেরা বন্ধ"><i class="fas fa-xmark"></i></button>
          </div>
        </div>

        <div class="ldl-draw">

          <!-- ----- স্লট ভিউ ----- -->
          <div class="ldl-slot-view" id="ldlGridView">
            <div class="ldl-head">
              <div class="ldl-chip"><i class="fas fa-gift"></i> মেগা লাকি ড্র</div>
              <h1 id="ldlDrawTitle">কে হবে স্মার্ট ফেনীর চমক উইনার?</h1>
              <div class="ldl-icons">
                <i class="fas fa-trophy"></i><i class="fas fa-gift"></i><i class="fas fa-crown"></i>
                <i class="fas fa-star"></i><i class="fas fa-gem"></i><i class="fas fa-coins"></i><i class="fas fa-ticket"></i>
              </div>
              <p class="ldl-prize" id="ldlDrawDescription"></p>
              <div class="ldl-status" id="ldlStatus">আপনার ভাগ্য কি আজ খুলবে? 🍀</div>
              <p class="ldl-eligible-count" id="ldlEligibleCount"></p>
            </div>

            <div class="ldl-stage" id="ldlStage"></div>
          </div>

          <!-- ড্র বাটন -->
          <button type="button" id="spinBtn" class="ldl-spin-btn">
            <i class="fas fa-play"></i> <span>উইনার খুজুন</span>
          </button>

          <!-- ----- বিজয়ী ভিউ ----- -->
          <div class="ldl-winner-view" id="ldlWinnerView" style="display:none;">
            <i class="fas fa-trophy ldl-winner-trophy"></i>
            <p class="ldl-winner-cong">🎉 অভিনন্দন! 🎉</p>
            <p class="ldl-winner-label">আজকের ভাগ্যবান বিজয়ী</p>
            <div class="ldl-winner-ring">
              <i class="fas fa-crown ldl-winner-crown"></i>
              <div class="ldl-winner-photo" id="ldlWinnerPhotoWrap">
                <img id="ldlWinnerPhoto" src="" alt="" style="display:none;" />
                <i class="fas fa-user" id="ldlWinnerPhotoIcon"></i>
              </div>
            </div>
            <h2 class="ldl-winner-name" id="ldlWinnerName"></h2>
            <p class="ldl-winner-phone" id="ldlWinnerPhone"></p>
            <p class="ldl-winner-wish">স্মার্ট ফেনীর পক্ষ থেকে শুভেচ্ছা 💛</p>

            <button type="button" id="respinBtn" class="ldl-respin-btn">
              <i class="fas fa-rotate"></i> আবার ড্র করুন
            </button>
          </div>

        </div>
      </div>

      <!-- ===== ফুটার — অ্যাপ ডাউনলোড ===== -->
      <div class="ldl-footer">
        <div class="ldl-footer-text">
          <i class="fas fa-mobile-screen-button"></i>
          <b>স্মার্ট ফেনী অ্যাপ</b> ডাউনলোড করুন — এখন প্লে স্টোরে!
        </div>
        <div class="ldl-store">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#00C3FF" d="M3.6 2.3L13.3 12 3.6 21.7C3.2 21.5 3 21.1 3 20.6V3.4c0-.5.2-.9.6-1.1z"/>
            <path fill="#00F076" d="M3.6 2.3L13.3 12l3.3-3.3L5 2.4c-.5-.3-1-.3-1.4-.1z"/>
            <path fill="#FF3A44" d="M3.6 21.7L13.3 12l3.3 3.3L5 21.6c-.5.3-1 .3-1.4.1z"/>
            <path fill="#FFD500" d="M16.6 8.7l3.8 2.2c.9.5.9 1.7 0 2.2l-3.8 2.2L13.3 12z"/>
          </svg>
          <div><small>GET IT ON</small><span>Google Play</span></div>
        </div>
        <div class="ldl-footer-slogan">প্রয়োজন আপনার, দায়িত্ব আমাদের</div>
      </div>

      <!-- ===== canvas confetti ===== -->
      <canvas id="ldlConfettiCanvas" class="ldl-confetti-canvas"></canvas>

    </div>
  </div>

  <style>
    .ld-live-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: radial-gradient(circle at 50% 0%, #5b1470 0%, #2a0a4a 55%, #1a0630 100%);
      color: #fff;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .ldl-loading {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      color: #e9d7ff;
      font-weight: 600;
    }

    .ldl-spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(255,255,255,0.15);
      border-top-color: #FFD700;
      border-radius: 50%;
      animation: ldl-spin 0.8s linear infinite;
    }

    @keyframes ldl-spin { to { transform: rotate(360deg); } }

    .ldl-content-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ===== ব্যাকগ্রাউন্ড ডেকোরেশন ===== */
    .ldl-beam {
      position: absolute;
      top: -30%;
      width: 60%;
      height: 140%;
      background: linear-gradient(180deg, rgba(255,215,0,0.18), transparent 70%);
      filter: blur(18px);
      transform-origin: top;
      pointer-events: none;
      animation: ldl-sweep 7s ease-in-out infinite alternate;
    }
    .ldl-beam-a { left: -10%; --r: -18deg; }
    .ldl-beam-b { right: -10%; --r: 18deg; animation-delay: -3s; }

    @keyframes ldl-sweep {
      from { transform: rotate(calc(var(--r) * -1)); }
      to { transform: rotate(var(--r)); }
    }

    .ldl-watermark {
      position: absolute;
      left: 50%;
      top: 52%;
      width: min(70vw, 420px);
      transform: translate(-50%, -50%);
      opacity: 0.05;
      pointer-events: none;
      filter: grayscale(1) brightness(2);
    }

    .ldl-floaters {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    :global(.ldl-fl) {
      position: absolute;
      color: #FFD700;
      opacity: 0.2;
      animation: ldl-float-up linear infinite;
    }

    @keyframes ldl-float-up {
      from { transform: translateY(110vh) rotate(0deg); }
      to { transform: translateY(-20vh) rotate(360deg); }
    }

    /* ===== টপবার ===== */
    .ldl-topbar {
      background: #fff;
      padding: 10px 16px;
      position: relative;
      z-index: 6;
      flex-shrink: 0;
      box-shadow: 0 3px 16px rgba(0,0,0,0.35);
      height: 64px;
    }

    .ldl-topbar-close {
      position: absolute;
      top: 50%;
      left: 16px;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #5b1470;
      text-decoration: none;
      background: #f4eefa;
      transition: all 0.2s ease;
    }

    .ldl-topbar-close:hover { background: #FFF0EA; color: #FF6B35; }

    .ldl-topbar-logo {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ldl-topbar-logo img {
      height: 40px;
      width: auto;
      display: block;
      margin-bottom: 1px;
    }

    .ldl-topbar-tag {
      font-size: 0.6rem;
      font-weight: 800;
      color: #FF6B35;
      letter-spacing: 0.6px;
    }

    .ldl-camera-btn {
      position: absolute;
      top: 50%;
      right: 16px;
      transform: translateY(-50%);
      width: 50px;
      height: 36px;
      border-radius: 10px;
      background: #FFF0EA;
      border: 2px solid #FFE3D4;
      color: #FF6B35;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s ease;
    }

    .ldl-camera-btn:hover, .ldl-camera-btn.on { border-color: #FF6B35; }

    /* ===== মেইন এরিয়া ===== */
    .ldl-main {
      position: relative;
      z-index: 3;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .ldl-draw {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* ===== ক্যামেরা ===== */
    .ldl-cam {
      display: none;
      position: relative;
      background: #12031f;
      overflow: hidden;
      border: 2px solid #FFD700;
      z-index: 7;
    }

    .ldl-cam.on { display: block; }

    .ldl-cam.small {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 112px;
      height: 150px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .ldl-cam.full {
      flex: 1.1;
      min-height: 38%;
      border-width: 0 0 2px 0;
      border-radius: 0;
    }

    .ldl-cam video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
      display: none;
    }

    .ldl-cam-fb {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 8px;
      text-align: center;
      font-size: 0.72rem;
      color: #e9d7ff;
    }

    .ldl-cam-btns {
      position: absolute;
      bottom: 6px;
      right: 6px;
      display: flex;
      gap: 6px;
      z-index: 2;
    }

    .ldl-cam-btns button {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 0;
      background: rgba(0,0,0,0.6);
      color: #fff;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .ldl-main.cam-full .ldl-chip,
    .ldl-main.cam-full .ldl-icons,
    .ldl-main.cam-full .ldl-eligible-count,
    .ldl-main.cam-full .ldl-prize { display: none; }

    .ldl-main.cam-full .ldl-head h1 { font-size: 1.05rem; }

    @media (min-width: 800px) {
      .ldl-main.cam-full { flex-direction: row; }
      .ldl-cam.full { flex: 1.3; min-height: 0; border-width: 0 2px 0 0; }
    }

    /* ===== স্লট ভিউ ===== */
    .ldl-slot-view {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .ldl-head {
      text-align: center;
      padding: 12px 14px 4px;
      flex-shrink: 0;
    }

    .ldl-chip {
      display: inline-block;
      background: linear-gradient(90deg, #FFD700, #FF6B35);
      color: #3b0a2a;
      font-weight: 800;
      font-size: 0.72rem;
      padding: 4px 14px;
      border-radius: 99px;
      margin-bottom: 6px;
    }

    .ldl-head h1 {
      font-size: clamp(1.2rem, 5.4vw, 1.9rem);
      font-weight: 800;
      line-height: 1.25;
      background: linear-gradient(180deg, #fff, #FFD700);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin: 0;
    }

    .ldl-icons {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin: 6px 0 2px;
      color: #FFD700;
      font-size: 1rem;
    }

    .ldl-icons i { animation: ldl-bob 2s ease-in-out infinite; }
    .ldl-icons i:nth-child(2n) { animation-delay: 0.4s; }
    .ldl-icons i:nth-child(3n) { animation-delay: 0.8s; }

    @keyframes ldl-bob { 50% { transform: translateY(-5px); } }

    .ldl-prize {
      color: #ffe9a8;
      font-size: 0.85rem;
      font-weight: 700;
      margin: 2px 0;
    }

    .ldl-prize:empty { display: none; }

    .ldl-status {
      font-size: 0.82rem;
      font-weight: 700;
      color: #ffe9a8;
      min-height: 22px;
      margin-top: 2px;
    }

    .ldl-status.live {
      display: inline-block;
      background: #e11d48;
      color: #fff;
      padding: 2px 14px;
      border-radius: 99px;
      animation: ldl-blink 1s infinite;
    }

    @keyframes ldl-blink { 50% { opacity: 0.6; } }

    .ldl-eligible-count {
      color: #e9d7ff;
      opacity: 0.75;
      font-size: 0.74rem;
      margin: 0;
    }

    .ldl-stage {
      position: relative;
      flex: 1;
      min-height: 0;
      perspective: 900px;
      overflow: hidden;
    }

    /* ===== ৩-কার্ড স্লট — JS দিয়ে তৈরি, তাই :global ===== */
    :global(.ldl-cd) {
      position: absolute;
      left: 50%;
      top: 50%;
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(255,255,255,0.96);
      color: #3b0a2a;
      box-shadow: 0 14px 30px rgba(0,0,0,0.45);
      transition: transform var(--ldl-dur, 0.6s) cubic-bezier(0.3, 0.8, 0.3, 1), opacity var(--ldl-dur, 0.6s);
      will-change: transform;
      box-sizing: border-box;
    }

    :global(.ldl-cd.c) {
      background: linear-gradient(160deg, #ffb347, #FF6B35 55%, #c0267e);
      color: #fff;
      box-shadow: 0 0 0 3px rgba(255,215,0,0.7), 0 0 40px rgba(255,170,0,0.65), 0 20px 40px rgba(0,0,0,0.5);
    }

    :global(.ldl-ph) {
      width: 62%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: #5b1470;
      border: 4px solid #fff;
      box-shadow: 0 6px 16px rgba(0,0,0,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
      box-sizing: border-box;
    }

    :global(.ldl-ph img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    :global(.ldl-ph i) {
      color: rgba(255,255,255,0.75);
      font-size: 2.2rem;
    }

    :global(.ldl-cd-name) {
      font-size: 0.95rem;
      font-weight: 700;
      text-align: center;
      padding: 0 10px;
      max-width: 100%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-sizing: border-box;
    }

    :global(.ldl-cd.c .ldl-cd-name) { font-size: 1.15rem; }

    :global(.ldl-cd-tag) {
      font-size: 0.68rem;
      opacity: 0.65;
    }

    :global(.ldl-cd.c .ldl-cd-tag) { opacity: 0.95; }

    /* বিজয়ী নির্ধারণের পর কার্ডের ছবি পালস */
    :global(.ldl-ph.pulse) {
      animation: ldl-pp 0.6s ease-in-out infinite;
    }

    @keyframes ldl-pp {
      50% {
        transform: scale(1.18);
        box-shadow: 0 0 0 6px rgba(255,215,0,0.6), 0 0 50px 14px rgba(255,215,0,0.85);
      }
    }

    /* ===== ড্র বাটন ===== */
    .ldl-spin-btn {
      align-self: center;
      margin: 8px 0 10px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border: 0;
      border-radius: 99px;
      padding: 14px 40px;
      font-weight: 800;
      font-size: 1.05rem;
      font-family: inherit;
      color: #3b0a2a;
      background: linear-gradient(90deg, #FFD700, #FF6B35);
      box-shadow: 0 10px 30px rgba(255,160,0,0.5);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      animation: ldl-btn-pulse 1.8s ease-in-out infinite;
      z-index: 4;
    }

    .ldl-spin-btn::after {
      content: "";
      position: absolute;
      top: 0;
      left: -60%;
      width: 40%;
      height: 100%;
      background: linear-gradient(100deg, transparent, rgba(255,255,255,0.7), transparent);
      animation: ldl-shine 2.4s infinite;
    }

    @keyframes ldl-shine { to { left: 130%; } }
    @keyframes ldl-btn-pulse { 50% { transform: scale(1.05); } }

    .ldl-spin-btn:disabled {
