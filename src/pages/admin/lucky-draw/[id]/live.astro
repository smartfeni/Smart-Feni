---
// ============================================================
// পেজ: লাকি ড্র লাইভ (/admin/lucky-draw/[id]/live)
// শুধু role === 'admin' অ্যাক্সেস করতে পারবে (moderator ব্লক)।
//
// আপডেট (এই সেশন — সম্পূর্ণ নতুন সিস্টেম):
//   - এখন থেকে "গ্রিড + গ্লো স্পটলাইট" মেকানিজম — সব এলিজিবল
//     এন্ট্রি ছবি (থাকলে) বা প্লেসহোল্ডার আইকন সহ গ্রিডে দেখায়।
//     একটা গ্লো হাইলাইট idle অবস্থায় সবসময় ধীরে ধীরে এলোমেলো
//     কার্ডে ঘুরতে থাকে। "ড্র শুরু করুন" চাপলে স্পিড বহুগুণ বেড়ে
//     যায় (২-৩ সেকেন্ডে পুরো গ্রিড কভার করে রিপিট), তারপর ধীরে
//     ধীরে ডিসিলারেট করে বিজয়ীর কার্ডে থেমে যায়।
//   - বিজয়ী রিভিল মাঝের এরিয়া জুড়ে (লোগো হেডার ও ওয়েবসাইট ফুটার
//     ফিক্সড থাকে, শুধু মাঝের কন্টেন্ট গ্রিড থেকে বিজয়ী কার্ডে
//     বদলে যায়)।
//   - কোনো DB রেকর্ড সেভ হয় না — প্রতিটা ড্র সম্পূর্ণ স্টেটলেস,
//     আনলিমিটেড রি-ড্র, রিলোড করলে আবার ফ্রেশ শুরু।
//   - কোণায় ক্রস (X) বাটন — ড্র লিস্ট পেজে ফিরিয়ে দেয়।
//   - ক্যামেরা বাটন ডিফল্টে ছোট, চালু করলে বড় হয়ে যায়।
// ============================================================

export const prerender = false;

import BaseLayout from '../../../../components/layout/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout title="লাইভ ড্র | স্মার্ট ফেনী">
  <div id="ldLiveOverlay" class="ld-live-overlay" data-draw-id={id}>

    <!-- ===== লোডিং স্টেট (গার্ড + ডেটা লোড) ===== -->
    <div id="adminLoadingState" class="ldl-loading">
      <div class="ldl-spinner"></div>
      <p>যাচাই করা হচ্ছে...</p>
    </div>

    <!-- ===== আসল কন্টেন্ট ===== -->
    <div id="adminGuardedContent" class="ldl-content-wrap" style="display:none;">

      <!-- ===== টপবার — ফিক্সড, সাদা ===== -->
      <div class="ldl-topbar">
        <a href="/admin/lucky-draw" class="ldl-topbar-close" title="ড্র লিস্টে ফিরুন">
          <i class="fas fa-xmark"></i>
        </a>

        <div class="ldl-topbar-logo">
          <img id="ldlTopLogo" src="/logo.png" alt="স্মার্ট ফেনী" />
          <span class="ldl-topbar-tag" id="ldlTopTag">লাকি ড্র</span>
        </div>

        <button type="button" class="ldl-camera-circle" id="cameraToggleBtn" title="ক্যামেরা">
          <video id="ldlCameraVideo" autoplay muted playsinline></video>
          <i class="fas fa-video" id="ldlCameraIcon"></i>
        </button>
      </div>

      <!-- ===== মাঝের এরিয়া — গ্রিড ভিউ / বিজয়ী ভিউ ===== -->
      <div class="ldl-middle">

        <!-- ----- গ্রিড ভিউ ----- -->
        <div class="ldl-grid-view" id="ldlGridView">
          <div class="ldl-draw-title">
            <h1 id="ldlDrawTitle">লোড হচ্ছে...</h1>
            <p id="ldlDrawDescription"></p>
            <p class="ldl-eligible-count" id="ldlEligibleCount"></p>
          </div>

          <div class="ldl-entry-grid" id="ldlEntryGrid"></div>
        </div>

        <!-- ----- বিজয়ী ভিউ (ফুল এরিয়া) ----- -->
        <div class="ldl-winner-view" id="ldlWinnerView" style="display:none;">
          <i class="fas fa-trophy ldl-winner-trophy"></i>
          <p class="ldl-winner-label">বিজয়ী</p>
          <div class="ldl-winner-photo" id="ldlWinnerPhotoWrap">
            <img id="ldlWinnerPhoto" src="" alt="" style="display:none;" />
            <i class="fas fa-user" id="ldlWinnerPhotoIcon"></i>
          </div>
          <h2 class="ldl-winner-name" id="ldlWinnerName"></h2>
          <p class="ldl-winner-phone" id="ldlWinnerPhone"></p>

          <button type="button" id="respinBtn" class="ldl-respin-btn">
            <i class="fas fa-rotate"></i> আবার ড্র করুন
          </button>
        </div>

      </div>

      <!-- ===== ড্র বাটন (গ্রিড ভিউতে ভাসমান, ফুটারের উপরে ফিক্সড) ===== -->
      <button type="button" id="spinBtn" class="ldl-spin-btn">
        <i class="fas fa-play"></i> <span>ড্র শুরু করুন</span>
      </button>

      <!-- ===== ফুটার — ফিক্সড ===== -->
      <div class="ldl-footer">
        <span>ভিজিট করুন: </span><span class="ldl-footer-domain">www.smartfeni.com</span>
      </div>

      <!-- ===== canvas confetti ===== -->
      <canvas id="ldlConfettiCanvas" class="ldl-confetti-canvas"></canvas>

    </div>
  </div>

  <style>
    .ld-live-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: radial-gradient(circle at top, #223257 0%, #101a30 65%, #0a1122 100%);
      color: #fff;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .ldl-loading {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      color: #cfd8e8;
      font-weight: 600;
    }

    .ldl-spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(255,255,255,0.15);
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: ldl-spin 0.8s linear infinite;
    }

    @keyframes ldl-spin {
      to { transform: rotate(360deg); }
    }

    .ldl-content-wrap {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    /* ===== টপবার — ফিক্সড সাদা ===== */
    .ldl-topbar {
      background: #fff;
      padding: 10px 16px;
      position: relative;
      z-index: 5;
      flex-shrink: 0;
      box-shadow: 0 2px 14px rgba(0,0,0,0.18);
      height: 60px;
    }

    .ldl-topbar-close {
      position: absolute;
      top: 50%;
      left: 16px;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1B2A4A;
      text-decoration: none;
      background: #F4F7FC;
      transition: all 0.2s ease;
    }

    .ldl-topbar-close:hover {
      background: #FFF0EA;
      color: #FF6B35;
    }

    .ldl-topbar-logo {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ldl-topbar-logo img {
      height: 36px;
      width: auto;
      display: block;
      margin-bottom: 2px;
    }

    .ldl-topbar-tag {
      font-size: 0.62rem;
      font-weight: 700;
      color: #FF6B35;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ===== ক্যামেরা বাটন — রেক্টেঙ্গেল, ডিফল্টে ছোট, চালু করলে বড় ===== */
    .ldl-camera-circle {
      position: absolute;
      top: 50%;
      right: 16px;
      transform: translateY(-50%);
      width: 50px;
      height: 36px;
      border-radius: 10px;
      background: #FFF0EA;
      border: 2px solid #FFE3D4;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      cursor: pointer;
      padding: 0;
      transition: width 0.3s ease, height 0.3s ease, border-color 0.2s ease, top 0.3s ease, border-radius 0.3s ease;
      z-index: 6;
    }

    .ldl-camera-circle:hover {
      border-color: #FF6B35;
    }

    .ldl-camera-circle i {
      color: #FF6B35;
      font-size: 1rem;
    }

    .ldl-camera-circle video {
      display: none;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .ldl-camera-circle.active {
      width: 118px;
      height: 168px;
      border-radius: 18px;
      border-color: #FF6B35;
      top: 78px;
    }

    .ldl-camera-circle.active i {
      display: none;
    }

    .ldl-camera-circle.active video {
      display: block;
    }

    /* ===== মাঝের এরিয়া ===== */
    .ldl-middle {
      flex: 1;
      min-height: 0;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .ldl-grid-view {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .ldl-draw-title {
      text-align: center;
      padding: 16px 20px 10px;
      flex-shrink: 0;
    }

    .ldl-draw-title h1 {
      font-size: 1.35rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 4px;
    }

    .ldl-draw-title p {
      color: #a9b6cc;
      font-size: 0.82rem;
    }

    .ldl-eligible-count {
      margin-top: 4px;
      color: #FF8C5A !important;
      font-weight: 700;
      font-size: 0.78rem !important;
    }

    .ldl-entry-grid {
      flex: 1;
      overflow-y: auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
      gap: 12px;
      padding: 6px 16px 100px;
    }

    /* ===== এই কার্ডগুলো JS দিয়ে document.createElement এ তৈরি হয়,
       তাই Astro-র scoped CSS attribute এদের গায়ে বসে না — :global()
       দিয়ে র‍্যাপ করা হলো যাতে স্টাইল ঠিকমতো অ্যাপ্লাই হয় ===== */
    :global(.ldl-entry-card) {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      padding: 6px;
      border-radius: 14px;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
      box-sizing: border-box;
    }

    :global(.ldl-entry-photo) {
      width: 58px;
      height: 58px;
      min-width: 58px;
      min-height: 58px;
      max-width: 58px;
      max-height: 58px;
      border-radius: 50%;
      background: #1B2A4A;
      border: 2px solid rgba(255,255,255,0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
      box-sizing: border-box;
    }

    :global(.ldl-entry-photo img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    :global(.ldl-entry-photo i) {
      color: #5A6E85;
      font-size: 1.4rem;
    }

    :global(.ldl-entry-name) {
      font-size: 0.66rem;
      font-weight: 600;
      color: #cfd8e8;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    /* ===== গ্লো স্পটলাইট ===== */
    :global(.ldl-entry-card.glow) {
      background: rgba(255, 107, 53, 0.12);
      transform: scale(1.08);
    }

    :global(.ldl-entry-card.glow .ldl-entry-photo) {
      border-color: #FF6B35;
      box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.35), 0 0 26px 6px rgba(255, 107, 53, 0.55);
    }

    :global(.ldl-entry-card.glow .ldl-entry-name) {
      color: #fff;
    }

    /* ===== বিজয়ী নির্ধারণের পর ৫ সেকেন্ড পালস (গ্লো জ্বলে-নিভে) ===== */
    :global(.ldl-entry-card.winner-pulse) {
      animation: ldl-winner-pulse 0.7s ease-in-out infinite;
      z-index: 2;
    }

    @keyframes ldl-winner-pulse {
      0%, 100% {
        transform: scale(1.08);
        background: rgba(255, 107, 53, 0.12);
      }
      50% {
        transform: scale(1.22);
        background: rgba(255, 107, 53, 0.28);
      }
    }

    :global(.ldl-entry-card.winner-pulse .ldl-entry-photo) {
      animation: ldl-winner-pulse-photo 0.7s ease-in-out infinite;
    }

    @keyframes ldl-winner-pulse-photo {
      0%, 100% {
        box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.35), 0 0 26px 6px rgba(255, 107, 53, 0.55);
      }
      50% {
        box-shadow: 0 0 0 5px rgba(255, 215, 0, 0.55), 0 0 44px 14px rgba(255, 215, 0, 0.75);
      }
    }

    /* ===== বিজয়ী ভিউ — মাঝের পুরো এরিয়া ===== */
    .ldl-winner-view {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      text-align: center;
    }

    .ldl-winner-trophy {
      font-size: 2.6rem;
      color: #FFD700;
      margin-bottom: 6px;
      filter: drop-shadow(0 8px 20px rgba(255, 215, 0, 0.35));
      animation: ldl-trophy-bounce 1.4s ease-in-out infinite;
    }

    @keyframes ldl-trophy-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .ldl-winner-label {
      color: #a9b6cc;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .ldl-winner-photo {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: #1B2A4A;
      border: 4px solid #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 18px;
      box-shadow: 0 20px 50px rgba(255, 107, 53, 0.35);
    }

    .ldl-winner-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ldl-winner-photo i {
      color: #5A6E85;
      font-size: 3.2rem;
    }

    .ldl-winner-name {
      font-size: 2.2rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 6px;
      text-shadow: 0 6px 30px rgba(255, 107, 53, 0.35);
    }

    .ldl-winner-phone {
      color: #a9b6cc;
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .ldl-respin-btn {
      margin-top: 26px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 15px 36px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 14px 34px rgba(255,107,53,0.4);
      transition: all 0.2s ease;
    }

    .ldl-respin-btn:hover {
      background: #e85a2a;
      transform: translateY(-2px);
    }

    /* ===== ড্র বাটন — ভাসমান, গ্রিডের উপরে ফিক্সড ===== */
    .ldl-spin-btn {
      position: absolute;
      bottom: 76px;
      left: 50%;
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 14px 36px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      box-shadow: 0 14px 34px rgba(255,107,53,0.45);
      transition: all 0.2s ease;
      z-index: 7;
    }

    .ldl-spin-btn:hover {
      background: #e85a2a;
      transform: translateX(-50%) translateY(-2px);
    }

    .ldl-spin-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: translateX(-50%);
    }

    /* ===== ফুটার — ফিক্সড ===== */
    .ldl-footer {
      flex-shrink: 0;
      text-align: center;
      padding: 12px 16px;
      background: rgba(0,0,0,0.35);
      border-top: 1px solid rgba(255,255,255,0.08);
      font-size: 0.82rem;
      color: #a9b6cc;
      z-index: 5;
    }

    .ldl-footer-domain {
      font-weight: 800;
      color: #fff;
    }

    .ldl-confetti-canvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 10040;
    }

    @media (max-width: 480px) {
      .ldl-topbar-logo img { height: 28px; }
      .ldl-draw-title h1 { font-size: 1.1rem; }
      .ldl-winner-name { font-size: 1.7rem; }
      .ldl-winner-photo { width: 110px; height: 110px; }
    }

    @media (max-width: 480px) {
      :global(.ldl-entry-photo) {
        width: 50px;
        height: 50px;
        min-width: 50px;
        min-height: 50px;
        max-width: 50px;
        max-height: 50px;
      }
    }
  </style>

  <script>
    import { initAdminGuard } from '../../../../lib/adminGuard.js';
    import { supabase } from '../../../../lib/supabase.js';

    const overlay = document.getElementById('ldLiveOverlay');
    const drawId = overlay.dataset.drawId;

    const drawTitleEl = document.getElementById('ldlDrawTitle');
    const drawDescEl = document.getElementById('ldlDrawDescription');
    const eligibleCountEl = document.getElementById('ldlEligibleCount');
    const entryGridEl = document.getElementById('ldlEntryGrid');
    const gridView = document.getElementById('ldlGridView');
    const winnerView = document.getElementById('ldlWinnerView');
    const winnerPhotoWrap = document.getElementById('ldlWinnerPhotoWrap');
    const winnerPhotoImg = document.getElementById('ldlWinnerPhoto');
    const winnerPhotoIcon = document.getElementById('ldlWinnerPhotoIcon');
    const winnerNameEl = document.getElementById('ldlWinnerName');
    const winnerPhoneEl = document.getElementById('ldlWinnerPhone');
    const spinBtn = document.getElementById('spinBtn');
    const respinBtn = document.getElementById('respinBtn');
    const confettiCanvas = document.getElementById('ldlConfettiCanvas');

    let drawRecord = null;
    let eligibleProfiles = []; // [{id, full_name, phone, avatar_url}]
    let cardEls = [];
    let isSpinning = false;
    let currentUserId = null;
    let glowIndex = -1;
    let idleTimer = null;
    let idleActive = false;

    // ===== ব্র্যান্ড লোগো — Header.astro-র একই প্যাটার্ন =====
    async function loadBrandLogo() {
      const { data } = await supabase
        .from('site_images')
        .select('storage_path, updated_at')
        .eq('image_key', 'logo')
        .maybeSingle();

      if (data?.storage_path) {
        const { data: urlData } = supabase.storage.from('listing-images').getPublicUrl(data.storage_path);
        const bust = data.updated_at ? new Date(data.updated_at).getTime() : Date.now();
        const topLogo = document.getElementById('ldlTopLogo');
        if (topLogo) topLogo.src = `${urlData.publicUrl}?v=${bust}`;
      }
    }
    loadBrandLogo();

    // ===== এলিজিবল প্রোফাইল লিস্ট =====
    async function computeEligibleProfiles(filterCriteria) {
      const { data: profiles, error } = await supabase
        .from('profiles')
        .select('id, full_name, phone, avatar_url, created_at, role, is_shop_owner, is_club_owner, is_blocked')
        .eq('is_blocked', false)
        .order('created_at', { ascending: true });

      if (error || !profiles) return [];

      const excludeRoles = new Set(filterCriteria?.exclude_roles || []);
      let filtered = profiles.filter((p) => {
        if (excludeRoles.has(p.role)) return false;
        if (filterCriteria?.exclude_shop_owners && p.is_shop_owner) return false;
        if (filterCriteria?.exclude_club_owners && p.is_club_owner) return false;
        return true;
      });

      if (filterCriteria?.first_n) {
        filtered = filtered.slice(0, filterCriteria.first_n);
      }

      return filtered;
    }

    // ===== Fisher-Yates শাফল — প্রতি রিফ্রেশে গ্রিডের অর্ডার আলাদা হবে =====
    function shuffleArray(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // ===== গ্রিড রেন্ডার =====
    function renderGrid() {
      entryGridEl.innerHTML = '';
      cardEls = eligibleProfiles.map((p) => {
        const card = document.createElement('div');
        card.className = 'ldl-entry-card';

        const photo = document.createElement('div');
        photo.className = 'ldl-entry-photo';
        if (p.avatar_url) {
          const img = document.createElement('img');
          img.src = p.avatar_url;
          img.alt = p.full_name || '';
          photo.appendChild(img);
        } else {
          const icon = document.createElement('i');
          icon.className = 'fas fa-image';
          photo.appendChild(icon);
        }

        const name = document.createElement('div');
        name.className = 'ldl-entry-name';
        name.textContent = p.full_name || 'ইউজার';

        card.appendChild(photo);
        card.appendChild(name);
        entryGridEl.appendChild(card);
        return card;
      });
    }

    function setGlow(index) {
      if (glowIndex >= 0 && cardEls[glowIndex]) {
        cardEls[glowIndex].classList.remove('glow');
      }
      glowIndex = index;
      if (glowIndex >= 0 && cardEls[glowIndex]) {
        cardEls[glowIndex].classList.add('glow');
        cardEls[glowIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    function randomIndexExcluding(exclude) {
      const n = cardEls.length;
      if (n <= 1) return 0;
      return (exclude + 1) % n;
    }

    // ===== idle — সবসময় ধীরে ধীরে এলোমেলো ঘুরতে থাকবে =====
    function idleStep() {
      if (!idleActive) return;
      setGlow(randomIndexExcluding(glowIndex));
      idleTimer = setTimeout(idleStep, 550 + Math.random() * 350);
    }

    function startIdle() {
      if (idleActive) return;
      idleActive = true;
      idleStep();
    }

    function stopIdle() {
      idleActive = false;
      if (idleTimer) clearTimeout(idleTimer);
    }

    // ===== স্পিন — ফ্যানের মতো টাইমিং: ৫সে ধীরে শুরু (accelerate),
    // মাঝে ২০-২৫সে পূর্ণ গতি, শেষ ৫সে ধীরে ধীরে থেমে যাওয়া
    // (decelerate)। বিজয়ী আগে থেকে ঠিক না করে — পুরো স্পিনের গতি-
    // কার্ভ অনুযায়ী ঠিক কোন কার্ডে গিয়ে থামবে সেটাই বিজয়ী, তাই
    // "জাম্প" ছাড়াই স্বাভাবিকভাবে ধারাবাহিক থেমে যায় =====
    const SPIN_RAMP_MS = 5000;
    const SPIN_FAST_DELAY = 40;
    const SPIN_SLOW_DELAY = 480;

    function spinDelayAt(elapsed, totalDuration) {
      if (elapsed < SPIN_RAMP_MS) {
        const t = elapsed / SPIN_RAMP_MS;
        return SPIN_SLOW_DELAY + (SPIN_FAST_DELAY - SPIN_SLOW_DELAY) * t;
      }
      const rampDownStart = totalDuration - SPIN_RAMP_MS;
      if (elapsed >= rampDownStart) {
        const t = (elapsed - rampDownStart) / SPIN_RAMP_MS;
        return SPIN_FAST_DELAY + (SPIN_SLOW_DELAY - SPIN_FAST_DELAY) * t;
      }
      return SPIN_FAST_DELAY;
    }

    function spinToWinner(onLanded) {
      stopIdle();
      const n = cardEls.length;
      const startIndex = glowIndex >= 0 ? glowIndex : 0;
      const middleDuration = 20000 + Math.random() * 5000; // ২০-২৫ সেকেন্ড ফুল স্পিড
      const totalDuration = SPIN_RAMP_MS * 2 + middleDuration; // মোট ~৩০-৩৫ সেকেন্ড

      // আগে থেকে (নিঃশব্দে, তাৎক্ষণিক) সিমুলেট করে বের করা হচ্ছে এই
      // গতি-কার্ভে মোট কতগুলো ধাপ হবে — সেই ধাপ অনুযায়ী যেখানে
      // থামবে সেটাই বিজয়ী কার্ড
      let simElapsed = 0;
      let simSteps = 0;
      while (simElapsed < totalDuration) {
        simElapsed += spinDelayAt(simElapsed, totalDuration);
        simSteps++;
      }
      const winnerIndex = (startIndex + simSteps) % n;

      // এখন একই গতি-কার্ভ দিয়ে বাস্তবে (রিয়েল-টাইমে) অ্যানিমেট করা
      // হচ্ছে — একই ফাংশন ব্যবহার করায় ঠিক ওই কার্ডেই গিয়ে থামবে
      const startTs = performance.now();
      let idx = startIndex;

      function tick() {
        const elapsed = performance.now() - startTs;
        if (elapsed >= totalDuration) {
          setGlow(winnerIndex); // টাইমিং ড্রিফট হলেও নিশ্চিতভাবে সঠিক কার্ডে থামা
          onLanded(winnerIndex);
          return;
        }
        idx = (idx + 1) % n;
        setGlow(idx);
        setTimeout(tick, spinDelayAt(elapsed, totalDuration));
      }
      tick();
    }

    // ===== কনফেটি =====
    let confettiParticles = [];
    let confettiRunning = false;

    function resizeCanvas() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function launchConfetti() {
      const ctx = confettiCanvas.getContext('2d');
      const colors = ['#FF6B35', '#FFD700', '#1B2A4A', '#4ADE80', '#fff'];
      confettiParticles = Array.from({ length: 160 }, () => ({
        x: Math.random() * confettiCanvas.width,
        y: -20 - Math.random() * 200,
        r: 4 + Math.random() * 5,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: 2 + Math.random() * 3,
        vx: -1.5 + Math.random() * 3,
        rot: Math.random() * 360,
        vrot: -6 + Math.random() * 12,
      }));

      if (confettiRunning) return;
      confettiRunning = true;
      let frames = 0;

      function tick() {
        ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        frames++;
        let anyAlive = false;
        confettiParticles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vrot;
          if (p.y < confettiCanvas.height + 20) anyAlive = true;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.6);
          ctx.restore();
        });
        if (anyAlive && frames < 420) {
          requestAnimationFrame(tick);
        } else {
          confettiRunning = false;
          ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        }
      }
      requestAnimationFrame(tick);
    }

    // ===== মেইন স্পিন ফ্লো =====
    function startSpin() {
      if (isSpinning || eligibleProfiles.length === 0) return;
      isSpinning = true;
      spinBtn.disabled = true;

      spinToWinner((winnerIndex) => {
        isSpinning = false;
        spinBtn.disabled = false;

        const profile = eligibleProfiles[winnerIndex];
        const card = cardEls[winnerIndex];

        // ৫ সেকেন্ড বিজয়ীর কার্ড গ্রিডেই কয়েকবার গ্লো/পালস করবে,
        // তারপর ফুল-স্ক্রিন সেলিব্রেশনে যাবে
        card?.classList.add('winner-pulse');
        setTimeout(() => {
          card?.classList.remove('winner-pulse');
          showWinner(profile);
        }, 5000);
      });
    }

    function showWinner(profile) {
      winnerNameEl.textContent = profile.full_name || 'ইউজার';
      winnerPhoneEl.textContent = profile.phone || '';

      if (profile.avatar_url) {
        winnerPhotoImg.src = profile.avatar_url;
        winnerPhotoImg.style.display = 'block';
        winnerPhotoIcon.style.display = 'none';
      } else {
        winnerPhotoImg.style.display = 'none';
        winnerPhotoIcon.style.display = 'block';
      }

      gridView.style.display = 'none';
      spinBtn.style.display = 'none';
      winnerView.style.display = 'flex';
      respinBtn.style.display = 'inline-flex';
      launchConfetti();
    }

    function backToGrid() {
      winnerView.style.display = 'none';
      gridView.style.display = 'flex';
      spinBtn.style.display = 'inline-flex';
      startIdle();
    }

    spinBtn?.addEventListener('click', startSpin);
    respinBtn?.addEventListener('click', () => {
      backToGrid();
      startSpin();
    });

    // ===== ক্যামেরা (ডিফল্টে ছোট, চালু করলে বড়) =====
    const cameraToggleBtn = document.getElementById('cameraToggleBtn');
    const cameraVideo = document.getElementById('ldlCameraVideo');
    let cameraStream = null;

    cameraToggleBtn?.addEventListener('click', async () => {
      if (cameraStream) {
        cameraStream.getTracks().forEach((t) => t.stop());
        cameraStream = null;
        cameraVideo.srcObject = null;
        cameraToggleBtn.classList.remove('active');
        return;
      }
      try {
        cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        cameraVideo.srcObject = cameraStream;
        cameraToggleBtn.classList.add('active');
      } catch (err) {
        alert('ক্যামেরা চালু করা যায়নি: ' + err.message);
      }
    });

    // ===== ইনিশিয়ালাইজেশন =====
    async function loadDraw() {
      const { data, error } = await supabase
        .from('lucky_draws')
        .select('*')
        .eq('id', drawId)
        .single();

      if (error || !data) {
        drawTitleEl.textContent = 'ড্র পাওয়া যায়নি';
        spinBtn.style.display = 'none';
        return;
      }

      drawRecord = data;
      drawTitleEl.textContent = data.title;
      drawDescEl.textContent = data.description || '';

      eligibleProfiles = shuffleArray(await computeEligibleProfiles(data.filter_criteria));

      if (eligibleProfiles.length === 0) {
        eligibleCountEl.textContent = 'এই ফিল্টারে কোনো এলিজিবল ইউজার নেই';
        spinBtn.disabled = true;
        return;
      }

      eligibleCountEl.textContent = `মোট এলিজিবল: ${eligibleProfiles.length} জন`;
      renderGrid();
      startIdle();
    }

    window.addEventListener('smartfeni:admin-ready', (e) => {
      const { role, profile } = e.detail;
      if (role !== 'admin') {
        window.location.href = '/admin';
        return;
      }
      currentUserId = profile.id;
      loadDraw();
    });

    initAdminGuard();
  </script>
</BaseLayout>
