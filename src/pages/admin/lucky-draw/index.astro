---
// ============================================================
// পেজ: লাকি ড্র ড্যাশবোর্ড (/admin/lucky-draw)
// শুধু role === 'admin' অ্যাক্সেস করতে পারবে (moderator ব্লক) —
// adminGuard.js দিয়ে সাধারণ admin+moderator গার্ড পাস করার পর
// এখানে extra role চেক করে moderator হলে /admin এ রিডাইরেক্ট।
// সব lucky_draws রেকর্ড লিস্ট করে দেখায়, draft হলে "ড্র চালু করুন"
// বাটন লাইভ পেজে নিয়ে যায়, completed হলে বিজয়ীর তথ্য দেখায়।
// ============================================================

export const prerender = false;

import BaseLayout from '../../../components/layout/BaseLayout.astro';
---

<BaseLayout title="লাকি ড্র | স্মার্ট ফেনী">
  <div class="ld-page">
    <div class="container">

      <!-- ===== লোডিং স্টেট (গার্ড চেক চলাকালীন) ===== -->
      <div id="adminLoadingState" class="ld-loading">
        <div class="ld-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <!-- ===== আসল কন্টেন্ট (গার্ড পাস হলে দেখা যাবে) ===== -->
      <div id="adminGuardedContent" class="ld-content" style="display:none;">

        <a href="/admin" class="ld-back-link"><i class="fas fa-arrow-left"></i> অ্যাডমিন ড্যাশবোর্ডে ফিরুন</a>

        <div class="ld-header">
          <div>
            <h1><i class="fas fa-gift"></i> লাকি ড্র</h1>
            <p class="ld-subtitle">অফার ও ক্যাম্পেইনের জন্য বিজয়ী নির্বাচন করুন</p>
          </div>
          <a href="/admin/lucky-draw/new" class="ld-new-btn">
            <i class="fas fa-plus"></i> নতুন ড্র
          </a>
        </div>

        <!-- ===== ড্র লিস্ট ===== -->
        <div id="drawListWrap">
          <div id="drawListLoading" class="ld-list-loading">
            <div class="ld-spinner ld-spinner-sm"></div>
          </div>

          <div id="drawEmptyState" class="ld-empty" style="display:none;">
            <i class="fas fa-gift"></i>
            <p>এখনো কোনো ড্র তৈরি হয়নি</p>
            <a href="/admin/lucky-draw/new" class="ld-new-btn ld-new-btn-outline">
              <i class="fas fa-plus"></i> প্রথম ড্র তৈরি করুন
            </a>
          </div>

          <div id="drawList" class="ld-list"></div>
        </div>

      </div>
    </div>
  </div>

  <style>
    .ld-page {
      min-height: 60vh;
      padding: 40px 0 80px;
    }

    .ld-loading,
    .ld-list-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 60px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .ld-loading {
      padding: 120px 0;
    }

    .ld-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: ld-spin 0.8s linear infinite;
    }

    .ld-spinner-sm {
      width: 26px;
      height: 26px;
      border-width: 2.5px;
    }

    @keyframes ld-spin {
      to { transform: rotate(360deg); }
    }

    .ld-back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #5A6E85;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 20px;
    }

    .ld-back-link:hover {
      color: #FF6B35;
    }

    .ld-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 32px;
      flex-wrap: wrap;
    }

    .ld-header h1 {
      font-size: 1.7rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ld-header h1 i {
      color: #FF6B35;
    }

    .ld-subtitle {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-top: 4px;
    }

    .ld-new-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 10px 24px rgba(255, 107, 53, 0.24);
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .ld-new-btn:hover {
      background: #e85a2a;
      transform: translateY(-2px);
    }

    .ld-new-btn-outline {
      background: transparent;
      color: #FF6B35;
      border: 1.5px solid #FF6B35;
      box-shadow: none;
      margin-top: 16px;
    }

    .ld-new-btn-outline:hover {
      background: #FFF0EA;
      color: #FF6B35;
    }

    .ld-empty {
      background: #fff;
      border-radius: 20px;
      padding: 60px 24px;
      text-align: center;
      border: 1px dashed #E5EAF0;
    }

    .ld-empty i {
      font-size: 2.2rem;
      color: #D7E0EC;
      margin-bottom: 14px;
    }

    .ld-empty p {
      font-weight: 700;
      color: #1B2A4A;
    }

    .ld-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .ld-card {
      background: #fff;
      border-radius: 20px;
      padding: 22px 24px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .ld-card-main {
      flex: 1;
      min-width: 200px;
    }

    .ld-card-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
      flex-wrap: wrap;
    }

    .ld-card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .ld-status-badge {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 40px;
      white-space: nowrap;
    }

    .ld-status-badge.draft {
      background: #FFF0EA;
      color: #FF6B35;
    }

    .ld-status-badge.completed {
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .ld-card-meta {
      font-size: 0.82rem;
      color: #8FA0BC;
    }

    .ld-card-winner {
      font-size: 0.85rem;
      color: #1B2A4A;
      font-weight: 600;
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .ld-card-winner i {
      color: #F5B800;
    }

    .ld-card-actions {
      display: flex;
      gap: 10px;
      flex-shrink: 0;
    }

    .ld-card-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      padding: 10px 18px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.82rem;
      transition: all 0.2s ease;
    }

    .ld-card-btn-primary {
      background: #1B2A4A;
      color: #fff;
    }

    .ld-card-btn-primary:hover {
      background: #101d38;
    }

    .ld-card-btn-outline {
      background: #F4F7FC;
      color: #5A6E85;
    }

    .ld-card-btn-outline:hover {
      background: #EEF3F9;
    }

    @media (max-width: 600px) {
      .ld-header {
        flex-direction: column;
      }
      .ld-card {
        flex-direction: column;
        align-items: flex-start;
      }
      .ld-card-actions {
        width: 100%;
      }
      .ld-card-btn {
        flex: 1;
        justify-content: center;
      }
    }
  </style>

  <script>
    import { initAdminGuard } from '../../../lib/adminGuard.js';
    import { supabase } from '../../../lib/supabase.js';

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str ?? '';
      return div.innerHTML;
    }

    function formatDate(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      return d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    async function loadDraws() {
      const listLoading = document.getElementById('drawListLoading');
      const emptyState = document.getElementById('drawEmptyState');
      const listEl = document.getElementById('drawList');

      const { data: draws, error } = await supabase
        .from('lucky_draws')
        .select('id, title, status, animation_style, winner_snapshot, drawn_at, created_at')
        .order('created_at', { ascending: false });

      if (listLoading) listLoading.style.display = 'none';

      if (error || !draws || draws.length === 0) {
        if (emptyState) emptyState.style.display = 'block';
        return;
      }

      listEl.innerHTML = draws.map((draw) => {
        const isCompleted = draw.status === 'completed';
        const statusLabel = isCompleted ? 'সম্পন্ন' : 'খসড়া';
        const winnerName = draw.winner_snapshot?.name || draw.winner_snapshot?.full_name;

        const winnerRow = isCompleted && winnerName
          ? `<div class="ld-card-winner"><i class="fas fa-trophy"></i> বিজয়ী: ${escapeHtml(winnerName)}</div>`
          : '';

        const metaText = isCompleted
          ? `ড্র হয়েছে: ${formatDate(draw.drawn_at)}`
          : `তৈরি হয়েছে: ${formatDate(draw.created_at)}`;

        const actionBtn = isCompleted
          ? `<a href="/admin/lucky-draw/${draw.id}" class="ld-card-btn ld-card-btn-outline"><i class="fas fa-eye"></i> বিস্তারিত</a>`
          : `<a href="/admin/lucky-draw/${draw.id}/live" class="ld-card-btn ld-card-btn-primary"><i class="fas fa-play"></i> ড্র চালু করুন</a>`;

        return `
          <div class="ld-card">
            <div class="ld-card-main">
              <div class="ld-card-title-row">
                <span class="ld-card-title">${escapeHtml(draw.title)}</span>
                <span class="ld-status-badge ${draw.status}">${statusLabel}</span>
              </div>
              <div class="ld-card-meta">${metaText}</div>
              ${winnerRow}
            </div>
            <div class="ld-card-actions">
              ${actionBtn}
            </div>
          </div>
        `;
      }).join('');
    }

    window.addEventListener('smartfeni:admin-ready', (e) => {
      const { role } = e.detail;

      // এই পেজ শুধু admin এর জন্য, moderator হলে ফিরিয়ে দেওয়া
      if (role !== 'admin') {
        window.location.href = '/admin';
        return;
      }

      loadDraws();
    });

    initAdminGuard();
  </script>
</BaseLayout>
