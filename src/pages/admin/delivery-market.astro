    function drawCheck(body) {
      let st = {};
      try { st = JSON.parse(localStorage.getItem('dmk_check') || '{}') || {}; } catch (e) { st = {}; }
      const save = () => { try { localStorage.setItem('dmk_check', JSON.stringify(st)); } catch (e) { /* ঠিক আছে */ } };
      const prog = mk('p', 'dmk-muted'); body.appendChild(prog);
      const total = CHECK.reduce((a, g) => a + g[1].length, 0);
      const upd = () => { prog.textContent = Object.values(st).filter(Boolean).length + ' / ' + total + ' সম্পন্ন (টিক এই ফোনে সেভ থাকে)'; };
      CHECK.forEach(([title, items], gi) => {
        const c = mk('div', 'dmk-card');
        c.appendChild(mk('div', 'dmk-lbl', title));
        items.forEach((txt, ii) => {
          const key = gi + '-' + ii;
          const row = mk('label'); row.style.cssText = 'display:flex;gap:10px;align-items:flex-start;padding:7px 0;font-size:14px;line-height:1.5;cursor:pointer';
          const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = !!st[key]; cb.style.cssText = 'width:20px;height:20px;margin-top:2px;flex:none';
          cb.addEventListener('change', () => { st[key] = cb.checked; save(); upd(); });
          row.appendChild(cb); row.appendChild(mk('span', null, txt));
          c.appendChild(row);
        });
        body.appendChild(c);
      });
      const rs = mk('button', 'dmk-btn', 'সব টিক মুছুন'); rs.type = 'button';
      rs.addEventListener('click', () => { st = {}; save(); draw(); });
      body.appendChild(rs);
      upd();
    }

    async function draw() {
      const body = $('dmkBody');
      body.textContent = '';
      body.appendChild(mk('p', 'dmk-muted', 'লোড হচ্ছে...'));
      const frag = mk('div'); frag.style.cssText = 'display:flex;flex-direction:column;gap:12px';
      try {
        if (tab === 'payments') await drawPayments(frag);
        else if (tab === 'shops') await drawShops(frag);
        else if (tab === 'riders') await drawRiders(frag);
        else if (tab === 'profit') await drawProfit(frag);
        else if (tab === 'online') await drawOnline(frag);
        else if (tab === 'check') drawCheck(frag);
        else await drawSettings(frag);
      } catch (e) { report(e, 'dmk-draw'); frag.appendChild(mk('p', 'dmk-muted', 'লোড করা যায়নি।')); }
      body.textContent = '';
      body.appendChild(frag);
    }

    window.addEventListener('smartfeni:admin-ready', (ev) => {
      access = (ev && ev.detail && ev.detail.access) || null;
      const t = new URLSearchParams(location.search).get('tab');
      if (t && TABS.some((x) => x[0] === t)) tab = t;
      renderTabs();
      draw();
    });
    initAdminGuard();
  </script>
</BaseLayout>
