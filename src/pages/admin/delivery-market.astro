      ['market_payment_note', 'পেমেন্ট নির্দেশনা (কাস্টমারকে দেখাবে)', 'text'],
      ['freelancer_commission_pct', 'ফ্রিলান্সার রাইডারের ডেলিভারি চার্জ থেকে কোম্পানির কমিশন (%)', 'number'],
      ['company_rider_daily_cost', 'কোম্পানি রাইডারের দৈনিক খরচ (টাকা)', 'number'],
