    ];
    async function drawSettings(body) {
      const { data } = await supabase.from('site_settings').select('key, value').in('key', SET_FIELDS.map((f) => f[0]));
      const cur = {}; (data || []).forEach((r) => { cur[r.key] = r.value; });
      const c = mk('div', 'dmk-card');
      const inputs = {};
      SET_FIELDS.forEach(([k, l, t]) => {
        c.appendChild(mk('label', 'dmk-lbl', l));
        let i;
        if (t === 'bool') {
          i = mk('select', 'dmk-in');
          [['false', 'বন্ধ (শুধু স্টাফ)'], ['true', 'চালু (সবার জন্য)']].forEach(([v, tx]) => { const o = mk('option', null, tx); o.value = v; i.appendChild(o); });
          i.value = String(cur[k] || 'false').replace(/"/g, '') === 'true' ? 'true' : 'false';
          i.setAttribute('aria-label', l);
        } else {
          i = mk('input', 'dmk-in'); i.type = t === 'number' ? 'number' : 'text'; i.maxLength = 200; i.value = cur[k] || ''; i.setAttribute('aria-label', l);
        }
        inputs[k] = i; c.appendChild(i);
      });
      const bt = mk('button', 'dmk-btn', 'সেভ করুন'); bt.type = 'button'; bt.style.marginTop = '12px'; bt.style.width = '100%';
      bt.addEventListener('click', async () => {
        if (busy) return; busy = true; bt.disabled = true;
        const rows = SET_FIELDS.map(([k]) => ({ key: k, value: String(inputs[k].value || '').trim() }));
        const { error } = await supabase.from('site_settings').upsert(rows, { onConflict: 'key' });
        busy = false; bt.disabled = false;
        if (error) { toast('সেভ হয়নি (অনুমতি নেই?)', 'error'); report(error, 'dmk-settings'); return; }
        toast('সেভ হয়েছে', 'success');
      });
      c.appendChild(bt);
      body.appendChild(c);
    }

