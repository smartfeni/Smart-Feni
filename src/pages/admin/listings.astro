---
// ============================================================
// পেজ: অ্যাডমিন — লিস্টিং ম্যানেজমেন্ট (/admin/listings)
// ট্যাব ১: সব ক্যাটাগরির লিস্টিং (listings টেবিল)
// ট্যাব ২: ম্যানুয়াল ব্লাড ডোনার রিভিউ + বাল্ক ক্লাব-লিংক (manual_blood_donors টেবিল)
// ট্যাব ৩: অভিযোগ/রিপোর্ট (content_reports টেবিল)
// আপডেট: cnglagbe সোর্সের লিস্টিং ডিলিট/Approve/Reject/Edit করলে ফোন নম্বর
//         scraper_blocklist এ যোগ হয়, যাতে পরের দিন স্ক্র্যাপার আবার একই
//         এন্ট্রি ওভাররাইট/পুনরায় তৈরি না করে
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import { categories } from '../../data/services.js';

const upazilaOptions = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];
---

<BaseLayout title="লিস্টিং ম্যানেজমেন্ট | অ্যাডমিন">
  <div class="admin-page">
    <div class="container">

      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i> ড্যাশবোর্ড</a>

        <div class="admin-header">
          <h1>লিস্টিং ম্যানেজমেন্ট</h1>
          <p class="admin-subtitle" id="resultCount"></p>
        </div>

        <!-- ===== ট্যাব সুইচার ===== -->
        <div class="tab-switcher">
          <button class="tab-btn active" data-tab="listings">লিস্টিং</button>
          <button class="tab-btn" data-tab="blood">ব্লাড ডোনার (ম্যানুয়াল)</button>
          <button class="tab-btn" data-tab="reports">রিপোর্ট <span id="reportsBadge" class="tab-badge" style="display:none;"></span></button>
        </div>

        <!-- ===== ট্যাব ১: লিস্টিং ===== -->
        <div id="listingsTab" class="tab-panel">
          <div class="filter-bar">
            <select id="categoryFilter" class="filter-select">
              <option value="all">সব ক্যাটাগরি</option>
              {categories.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>

            <select id="statusFilter" class="filter-select">
              <option value="all">সব স্ট্যাটাস</option>
              <option value="unreviewed">শুধু নতুন (আনরিভিউড)</option>
              <option value="pending">রিভিউ বাকি</option>
              <option value="active">সক্রিয়</option>
              <option value="rejected">বাতিল</option>
            </select>

            <select id="sourceFilter" class="filter-select">
              <option value="all">সব সোর্স</option>
              <option value="manual">ম্যানুয়াল/ইউজার এন্ট্রি</option>
              <option value="cnglagbe">cnglagbe থেকে</option>
              <option value="screenshot-import">স্ক্রিনশট ইম্পোর্ট</option>
            </select>
          </div>

          <div id="listingsContainer" class="listings-container"></div>

          <div id="emptyState" class="empty-state" style="display:none;">
            <i class="fas fa-inbox"></i>
            <p>কোনো লিস্টিং পাওয়া যায়নি</p>
          </div>
        </div>

        <!-- ===== ট্যাব ২: ব্লাড ডোনার ===== -->
        <div id="bloodTab" class="tab-panel" style="display:none;">

          <!-- ===== বাল্ক ক্লাব-লিংক সেকশন ===== -->
          <div class="link-section" id="clubLinkSection" style="display:none;">
            <h3><i class="fas fa-link"></i> ক্লাব-নাম লিংক করুন</h3>
            <p class="link-hint">স্ক্রিনশট থেকে আসা এই ক্লাবের নামগুলা এখনো কোনো existing ক্লাবের সাথে লিংকড না। মিলে গেলে সিলেক্ট করে লিংক করুন — একবারে সব এন্ট্রি আপডেট হবে।</p>
            <div id="clubLinkList"></div>
          </div>

          <div class="filter-bar">
            <select id="bloodStatusFilter" class="filter-select">
              <option value="pending">রিভিউ বাকি</option>
              <option value="active">সক্রিয়</option>
              <option value="rejected">বাতিল</option>
              <option value="all">সব স্ট্যাটাস</option>
            </select>

            <select id="bloodUpazilaFilter" class="filter-select">
              <option value="all">সব উপজিলা</option>
              {upazilaOptions.map((u) => <option value={u}>{u}</option>)}
            </select>
          </div>

          <div class="bulk-bar" id="bulkBar" style="display:none;">
            <span id="selectedCount">0 জন সিলেক্ট করা</span>
            <div style="display:flex;gap:8px;">
              <button id="bulkApproveBtn" class="bulk-btn approve">সিলেক্ট করা সবগুলা Approve করুন</button>
              <button id="bulkClearBtn" class="bulk-btn clear">সিলেকশন বাতিল</button>
            </div>
          </div>

          <div id="bloodContainer" class="listings-container"></div>

          <div id="bloodEmptyState" class="empty-state" style="display:none;">
            <i class="fas fa-droplet"></i>
            <p>কোনো ডোনার পাওয়া যায়নি</p>
          </div>
        </div>

        <!-- ===== ট্যাব ৩: রিপোর্ট/অভিযোগ ===== -->
        <div id="reportsTab" class="tab-panel" style="display:none;">
          <div class="filter-bar">
            <select id="reportStatusFilter" class="filter-select">
              <option value="pending">পেন্ডিং (একশন বাকি)</option>
              <option value="dismissed">সক্রিয় করা হয়েছে</option>
              <option value="resolved">সমাধান হয়েছে (ডিলিট)</option>
              <option value="all">সব স্ট্যাটাস</option>
            </select>

            <select id="reportTargetTypeFilter" class="filter-select">
              <option value="all">সব ধরনের কন্টেন্ট</option>
              <option value="listing">লিস্টিং</option>
              <option value="blood_profile">ব্লাড ডোনার (রেজিস্টার্ড)</option>
              <option value="blood_manual">ব্লাড ডোনার (ম্যানুয়াল)</option>
            </select>
          </div>

          <div id="reportsContainer" class="listings-container"></div>

          <div id="reportsEmptyState" class="empty-state" style="display:none;">
            <i class="fas fa-flag"></i>
            <p>কোনো রিপোর্ট পাওয়া যায়নি</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <style>
    .admin-page {
      min-height: 60vh;
      padding: 32px 0 80px;
    }

    .admin-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .admin-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #5A6E85;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .back-link:hover {
      color: #FF6B35;
    }

    .admin-header {
      margin-bottom: 20px;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .admin-subtitle {
      font-size: 0.85rem;
      color: #8FA0BC;
      margin-top: 4px;
      font-weight: 600;
    }

    .tab-switcher {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      border-bottom: 1.5px solid #E5EAF0;
    }

    .tab-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      padding: 10px 18px;
      font-size: 0.9rem;
      font-weight: 700;
      color: #8FA0BC;
      cursor: pointer;
      border-bottom: 3px solid transparent;
      margin-bottom: -1.5px;
    }

    .tab-btn.active {
      color: #FF6B35;
      border-bottom-color: #FF6B35;
    }

    .tab-badge {
      background: #D14343;
      color: #fff;
      font-size: 0.68rem;
      font-weight: 800;
      padding: 1px 7px;
      border-radius: 20px;
    }

    .filter-bar {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .filter-select {
      padding: 11px 16px;
      border-radius: 12px;
      border: 1.5px solid #E5EAF0;
      background: #fff;
      font-size: 0.88rem;
      font-weight: 600;
      color: #1B2A4A;
      cursor: pointer;
      flex: 1;
      min-width: 140px;
    }

    .listings-container {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 80px 0;
      color: #B0BCCB;
    }

    .empty-state i {
      font-size: 2.4rem;
    }

    .bulk-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #FFF3E0;
      border-radius: 14px;
      padding: 12px 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #B36B00;
    }

    .bulk-btn {
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .bulk-btn.approve {
      background: #1B7A3C;
      color: #fff;
    }

    .bulk-btn.clear {
      background: transparent;
      color: #8FA0BC;
      border: 1.5px solid #E5EAF0;
    }

    .link-section {
      background: #E8F2FF;
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 24px;
    }

    .link-section h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    .link-hint {
      font-size: 0.8rem;
      color: #5A6E85;
      margin-bottom: 14px;
    }

    .link-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #fff;
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }

    .link-row-name {
      flex: 1;
      min-width: 140px;
      font-weight: 700;
      font-size: 0.85rem;
      color: #1B2A4A;
    }

    .link-row-count {
      font-size: 0.75rem;
      color: #8FA0BC;
      font-weight: 600;
    }

    .link-select {
      padding: 8px 12px;
      border-radius: 10px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.82rem;
      font-family: inherit;
      background: #fff;
      min-width: 160px;
    }

    .link-btn {
      background: #1D6FE0;
      color: #fff;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .link-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>

  <script type="application/json" id="upazilaOptionsData" set:html={JSON.stringify(upazilaOptions)} />

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { categories } from '../../data/services.js';

    const upazilaOptionsEl = document.getElementById('upazilaOptionsData');
    const upazilaOptions = upazilaOptionsEl ? JSON.parse(upazilaOptionsEl.textContent) : [];

    const categoryNameMap = Object.fromEntries(categories.map((c) => [c.id, c.name]));

    const VERIFY_ENABLED_CATEGORIES = ['car-rental', 'clubs'];
    const CONNECT_ENABLED_CATEGORIES = ['car-rental'];

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str ?? '';
      return div.innerHTML;
    }

    function formatDate(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    // স্ক্র্যাপ করা লিস্টিং-এ কোনো এডমিন একশন (approve/reject/edit/delete)
    // নেওয়ার আগে ফোন নম্বরটা scraper_blocklist এ upsert করে — যাতে
    // স্ক্র্যাপার পরের রানে এই এন্ট্রি আর ওভাররাইট/রিক্রিয়েট না করে
    async function lockFromScraper(listing) {
      if (!listing.source || !listing.contact_phone) return;
      const { error } = await supabase
        .from('scraper_blocklist')
        .upsert(
          { source: listing.source, phone: listing.contact_phone },
          { onConflict: 'source,phone' }
        );
      if (error) {
        console.error('ব্লকলিস্টে যোগ করতে ব্যর্থ:', error.message);
      }
    }

    // ============================================================
    // ট্যাব সুইচিং
    // ============================================================
    const tabButtons = document.querySelectorAll('.tab-btn');
    const listingsTab = document.getElementById('listingsTab');
    const bloodTab = document.getElementById('bloodTab');
    const reportsTab = document.getElementById('reportsTab');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        listingsTab.style.display = 'none';
        bloodTab.style.display = 'none';
        reportsTab.style.display = 'none';

        if (btn.dataset.tab === 'listings') {
          listingsTab.style.display = 'block';
          loadListings();
        } else if (btn.dataset.tab === 'blood') {
          bloodTab.style.display = 'block';
          loadClubLinkSuggestions();
          loadBloodDonors();
        } else {
          reportsTab.style.display = 'block';
          loadReports();
        }
      });
    });

    // ============================================================
    // ট্যাব ১: লিস্টিং
    // ============================================================
    const container = document.getElementById('listingsContainer');
    const emptyState = document.getElementById('emptyState');
    const resultCount = document.getElementById('resultCount');
    const categoryFilter = document.getElementById('categoryFilter');
    const statusFilter = document.getElementById('statusFilter');
    const sourceFilter = document.getElementById('sourceFilter');

    const statusLabels = {
      pending: { text: 'রিভিউ বাকি', bg: '#FFF3E0', color: '#B36B00' },
      active: { text: 'সক্রিয়', color: '#1B7A3C', bg: '#EAFBF0' },
      rejected: { text: 'বাতিল', color: '#D14343', bg: '#FFF0EA' },
    };

    const sourceLabels = {
      cnglagbe: 'cnglagbe থেকে',
      'screenshot-import': 'স্ক্রিনশট ইম্পোর্ট',
    };

    function renderEditForm(listing) {
      const form = document.createElement('div');
      form.style.cssText = 'margin-top:14px;padding:14px;background:#F8FAFC;border-radius:14px;border:1px solid #EEF3F9;display:flex;flex-direction:column;gap:10px;';

      const upazilaOpts = upazilaOptions
        .map((u) => `<option value="${u}" ${listing.upazila === u ? 'selected' : ''}>${u}</option>`)
        .join('');

      form.innerHTML = `
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">নাম
          <input type="text" data-field="title" value="${escapeHtml(listing.title || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">বিবরণ / এলাকা
          <textarea data-field="description" rows="2" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;resize:vertical;">${escapeHtml(listing.description || '')}</textarea>
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">দাম / মূল্য
          <input type="text" data-field="price" value="${escapeHtml(listing.price || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">উপজেলা
          <select data-field="upazila" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;background:#fff;">
            <option value="">— নির্বাচন করুন —</option>
            ${upazilaOpts}
          </select>
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">ফোন নম্বর
          <input type="text" data-field="contact_phone" value="${escapeHtml(listing.contact_phone || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <div style="display:flex;gap:8px;margin-top:4px;">
          <button data-action="save" style="flex:1;background:#1B2A4A;color:#fff;border:none;padding:10px;border-radius:10px;font-size:0.85rem;font-weight:700;cursor:pointer;">সেভ করুন</button>
          <button data-action="cancel" style="background:transparent;color:#8FA0BC;border:1.5px solid #E5EAF0;padding:10px 16px;border-radius:10px;font-size:0.85rem;font-weight:700;cursor:pointer;">বাতিল</button>
        </div>
      `;

      form.querySelector('[data-action="cancel"]').addEventListener('click', () => form.remove());

      form.querySelector('[data-action="save"]').addEventListener('click', async () => {
        const saveBtn = form.querySelector('[data-action="save"]');
        saveBtn.textContent = 'সেভ হচ্ছে...';
        saveBtn.disabled = true;

        // এডিট করে সেভ করলে ফোন নম্বর ব্লকলিস্টে যোগ — স্ক্র্যাপার যেন এই
        // এডিটেড ডেটা আর ওভাররাইট না করে (পুরনো ফোন নম্বর দিয়ে ব্লক করা
        // হচ্ছে, কারণ cnglagbe সাইটে এন্ট্রিটা এই নম্বরেই থাকবে)
        await lockFromScraper(listing);

        const updates = {
          title: form.querySelector('[data-field="title"]').value.trim(),
          description: form.querySelector('[data-field="description"]').value.trim(),
          price: form.querySelector('[data-field="price"]').value.trim() || null,
          upazila: form.querySelector('[data-field="upazila"]').value || null,
          contact_phone: form.querySelector('[data-field="contact_phone"]').value.trim(),
        };

        const { error } = await supabase.from('listings').update(updates).eq('id', listing.id);

        if (error) {
          alert('সেভ ব্যর্থ: ' + error.message);
          saveBtn.textContent = 'সেভ করুন';
          saveBtn.disabled = false;
          return;
        }

        loadListings();
      });

      return form;
    }

    function renderCard(listing) {
      const status = statusLabels[listing.status] || statusLabels.pending;
      const categoryName = categoryNameMap[listing.category] || listing.category;
      const thumb = Array.isArray(listing.images) && listing.images.length > 0 ? listing.images[0] : null;
      const sourceLabel = listing.source ? (sourceLabels[listing.source] || listing.source) : null;
      const isUnclaimed = !listing.user_id;
      const canVerify = VERIFY_ENABLED_CATEGORIES.includes(listing.category);
      const canConnect = CONNECT_ENABLED_CATEGORIES.includes(listing.category);

      const card = document.createElement('div');
      card.style.cssText = 'background:#fff;border-radius:18px;padding:18px;box-shadow:0 4px 16px rgba(15,23,42,0.06);display:flex;gap:14px;flex-wrap:wrap;';

      card.innerHTML = `
        ${thumb
          ? `<img src="${thumb}" style="width:76px;height:76px;border-radius:14px;object-fit:cover;flex-shrink:0;" />`
          : `<div style="width:76px;height:76px;border-radius:14px;background:#F4F7FC;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#B0BCCB;font-size:1.4rem;"><i class="fas fa-image"></i></div>`
        }
        <div style="flex:1;min-width:0;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
            <h3 style="font-size:0.98rem;font-weight:700;color:#1B2A4A;">${listing.title || '(শিরোনামহীন)'}</h3>
            <span style="display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;">
              ${!listing.is_reviewed ? `<span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:#FF6B35;color:#fff;">নতুন</span>` : ''}
              <span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:${status.bg};color:${status.color};">${status.text}</span>
              ${listing.is_verified ? `<span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:#E8F2FF;color:#1D6FE0;"><i class="fas fa-circle-check"></i> ভ্যারিফাইড</span>` : ''}
              ${listing.is_disabled ? `<span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:#FFF0EA;color:#D14343;"><i class="fas fa-flag"></i> রিপোর্টেড</span>` : ''}
            </span>
          </div>
          <p style="font-size:0.82rem;color:#8FA0BC;margin-top:4px;">
            ${categoryName} ${listing.type ? '· ' + listing.type : ''}
            ${sourceLabel ? ` · <span style="color:#B36B00;font-weight:700;">${sourceLabel}</span>` : ''}
            ${isUnclaimed && listing.source ? ` · <span style="color:#8FA0BC;">আনক্লেইমড</span>` : ''}
            ${!listing.upazila ? ` · <span style="color:#D14343;">উপজেলা নাই</span>` : ''}
          </p>
          ${listing.description ? `<p style="font-size:0.85rem;color:#5A6E85;margin-top:6px;">${listing.description}</p>` : ''}
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;font-size:0.8rem;color:#5A6E85;">
            ${listing.price ? `<span><i class="fas fa-tag" style="color:#FF6B35;"></i> ${listing.price}</span>` : ''}
            ${listing.upazila ? `<span><i class="fas fa-location-dot" style="color:#FF6B35;"></i> ${listing.upazila}</span>` : ''}
            ${listing.contact_phone ? `<span><i class="fas fa-phone" style="color:#FF6B35;"></i> ${listing.contact_phone}</span>` : ''}
            ${listing.rating_count > 0 ? `<span><i class="fas fa-star" style="color:#F5A623;"></i> ${Number(listing.rating).toFixed(1)} (${listing.rating_count})</span>` : ''}
            <span><i class="fas fa-clock" style="color:#FF6B35;"></i> ${formatDate(listing.created_at)}</span>
          </div>
          <div class="card-actions" style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap;"></div>
          <div class="edit-form-slot"></div>
        </div>
      `;

      const actionsWrap = card.querySelector('.card-actions');
      const editSlot = card.querySelector('.edit-form-slot');

      if (listing.status !== 'active') {
        const approveBtn = document.createElement('button');
        approveBtn.textContent = 'Approve করুন';
        approveBtn.style.cssText = 'background:#1B7A3C;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        approveBtn.addEventListener('click', () => updateStatusAndLock(listing, 'active'));
        actionsWrap.appendChild(approveBtn);
      }

      if (listing.status !== 'rejected') {
        const rejectBtn = document.createElement('button');
        rejectBtn.textContent = 'Reject করুন';
        rejectBtn.style.cssText = 'background:#FFF0EA;color:#D14343;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        rejectBtn.addEventListener('click', () => updateStatusAndLock(listing, 'rejected'));
        actionsWrap.appendChild(rejectBtn);
      }

      if (!listing.is_reviewed) {
        const reviewedBtn = document.createElement('button');
        reviewedBtn.textContent = 'রিভিউ করা হয়েছে';
        reviewedBtn.style.cssText = 'background:#F4F7FC;color:#1B2A4A;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        reviewedBtn.addEventListener('click', () => markReviewed(listing.id));
        actionsWrap.appendChild(reviewedBtn);
      }

      if (canVerify) {
        const verifyBtn = document.createElement('button');
        verifyBtn.textContent = listing.is_verified ? 'আনভ্যারিফাই করুন' : 'ভ্যারিফাই করুন';
        verifyBtn.style.cssText = listing.is_verified
          ? 'background:#F4F7FC;color:#1B2A4A;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;'
          : 'background:#E8F2FF;color:#1D6FE0;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        verifyBtn.addEventListener('click', () => toggleVerified(listing.id, !listing.is_verified));
        actionsWrap.appendChild(verifyBtn);
      }

      if (isUnclaimed) {
        const editBtn = document.createElement('button');
        editBtn.textContent = 'এডিট করুন';
        editBtn.style.cssText = 'background:#FFF0EA;color:#FF6B35;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        editBtn.addEventListener('click', () => {
          editSlot.innerHTML = '';
          editSlot.appendChild(renderEditForm(listing));
        });
        actionsWrap.appendChild(editBtn);

        if (canConnect) {
          const connectBtn = document.createElement('button');
          connectBtn.textContent = 'ড্রাইভারের সাথে কানেক্ট করুন';
          connectBtn.style.cssText = 'background:#1B2A4A;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
          connectBtn.addEventListener('click', () => connectToProfile(listing.id, listing.contact_phone));
          actionsWrap.appendChild(connectBtn);
        }
      }

      const deleteBtn = document.createElement('button');
      deleteBtn.textContent = 'ডিলিট';
      deleteBtn.style.cssText = 'background:transparent;color:#8FA0BC;border:1.5px solid #E5EAF0;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
      let confirming = false;
      deleteBtn.addEventListener('click', () => {
        if (!confirming) {
          confirming = true;
          deleteBtn.textContent = 'নিশ্চিত করুন?';
          deleteBtn.style.cssText = 'background:#D14343;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
          return;
        }
        deleteListing(listing);
      });
      actionsWrap.appendChild(deleteBtn);

      return card;
    }

    async function markReviewed(id) {
      const { error } = await supabase.from('listings').update({ is_reviewed: true }).eq('id', id);
      if (error) { alert('আপডেট ব্যর্থ: ' + error.message); return; }
      loadListings();
    }

    // পুরনো updateStatus() রেখে দেওয়া হলো (অন্য কোথাও রেফারেন্স থাকলে
    // যেন না ভাঙে), কিন্তু approve/reject বাটন এখন updateStatusAndLock ব্যবহার করে
    async function updateStatus(id, status) {
      const { error } = await supabase.from('listings').update({ status }).eq('id', id);
      if (error) { alert('আপডেট ব্যর্থ: ' + error.message); return; }
      loadListings();
    }

    // Approve/Reject করার সাথে সাথে ফোন নম্বর ব্লকলিস্টে যোগ করে দেয় (যদি
    // সোর্স-ট্যাগড হয়) — যাতে স্ক্র্যাপার এই এন্ট্রি আর নতুন করে upsert
    // করে এডমিনের সিদ্ধান্ত ওভাররাইট না করে দেয়
    async function updateStatusAndLock(listing, status) {
      await lockFromScraper(listing);

      const { error } = await supabase.from('listings').update({ status }).eq('id', listing.id);
      if (error) { alert('আপডেট ব্যর্থ: ' + error.message); return; }
      loadListings();
    }

    async function toggleVerified(id, nextValue) {
      const { error } = await supabase.from('listings').update({ is_verified: nextValue }).eq('id', id);
      if (error) { alert('আপডেট ব্যর্থ: ' + error.message); return; }
      loadListings();
    }

    // ============================================================
    // ডিলিট — সোর্স-ট্যাগড (স্ক্র্যাপড) লিস্টিং হলে আগে ফোন নম্বর
    // scraper_blocklist এ যোগ করে, যাতে পরের স্ক্র্যাপ রানে এই এন্ট্রি
    // আর ফিরিয়ে আনা না হয়
    // ============================================================
    async function deleteListing(listing) {
      await lockFromScraper(listing);

      const { error } = await supabase.from('listings').delete().eq('id', listing.id);
      if (error) { alert('ডিলিট ব্যর্থ: ' + error.message); return; }
      loadListings();
    }

    async function connectToProfile(listingId, currentPhone) {
      const phone = prompt('ড্রাইভারের ফোন নম্বর দিন (যেটা দিয়ে তিনি Smart Feni-তে একাউন্ট খুলেছেন):', currentPhone || '');
      if (!phone) return;

      const cleanPhone = phone.trim();

      const { data: profiles, error } = await supabase
        .from('profiles')
        .select('id, full_name, phone')
        .eq('phone', cleanPhone);

      if (error) { alert('প্রোফাইল সার্চ ব্যর্থ: ' + error.message); return; }

      if (!profiles || profiles.length === 0) {
        alert('এই নম্বরে কোনো প্রোফাইল পাওয়া যায়নি। ড্রাইভারকে আগে Smart Feni-তে একাউন্ট খুলতে হবে (এই নম্বর দিয়েই)।');
        return;
      }

      let selectedProfile = profiles[0];

      if (profiles.length > 1) {
        const list = profiles.map((p, i) => `${i + 1}. ${p.full_name || '(নাম নাই)'} — ${p.phone}`).join('\n');
        const choice = prompt(`একাধিক প্রোফাইল পাওয়া গেছে, নম্বর লিখে বেছে নিন:\n${list}`, '1');
        const idx = parseInt(choice, 10) - 1;
        if (isNaN(idx) || !profiles[idx]) return;
        selectedProfile = profiles[idx];
      }

      const confirmMsg = `"${selectedProfile.full_name || selectedProfile.phone}" এর প্রোফাইলের সাথে এই লিস্টিং কানেক্ট করবেন?\n\nএর পর থেকে এই ড্রাইভার নিজে লগইন করে লিস্টিং এডিট করতে পারবেন।`;
      if (!confirm(confirmMsg)) return;

      const { error: updateError } = await supabase.from('listings').update({ user_id: selectedProfile.id }).eq('id', listingId);
      if (updateError) { alert('কানেক্ট করা ব্যর্থ: ' + updateError.message); return; }

      alert('কানেক্ট সফল হয়েছে।');
      loadListings();
    }

    async function loadListings() {
      container.innerHTML = '<p style="text-align:center;color:#8FA0BC;padding:40px 0;">লোড হচ্ছে...</p>';

      let query = supabase
        .from('listings')
        .select('*')
        .order('is_reviewed', { ascending: true })
        .order('created_at', { ascending: false });

      const category = categoryFilter.value;
      const status = statusFilter.value;
      const source = sourceFilter.value;

      if (category !== 'all') query = query.eq('category', category);

      if (status === 'unreviewed') {
        query = query.eq('is_reviewed', false);
      } else if (status !== 'all') {
        query = query.eq('status', status);
      }

      if (source === 'manual') {
        query = query.is('source', null);
      } else if (source !== 'all') {
        query = query.eq('source', source);
      }

      const { data, error } = await query;

      if (error) {
        container.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${error.message}</p>`;
        return;
      }

      const listings = data || [];
      resultCount.textContent = `মোট ${listings.length} টি লিস্টিং`;
      container.innerHTML = '';

      if (listings.length === 0) {
        emptyState.style.display = 'flex';
        return;
      }

      emptyState.style.display = 'none';
      listings.forEach((listing) => container.appendChild(renderCard(listing)));
    }

    categoryFilter.addEventListener('change', loadListings);
    statusFilter.addEventListener('change', loadListings);
    sourceFilter.addEventListener('change', loadListings);

    // ============================================================
    // বাল্ক ক্লাব-লিংক (club_name_raw -> clubs.id)
    // ============================================================
    let clubsList = [];

    async function loadClubsList() {
      const { data } = await supabase.from('clubs').select('id, name').order('name', { ascending: true });
      clubsList = data || [];
    }

    async function loadClubLinkSuggestions() {
      const section = document.getElementById('clubLinkSection');
      const listEl = document.getElementById('clubLinkList');

      const { data, error } = await supabase
        .from('manual_blood_donors')
        .select('club_name_raw')
        .is('club_id', null)
        .not('club_name_raw', 'is', null);

      if (error || !data || data.length === 0) {
        section.style.display = 'none';
        return;
      }

      const nameCounts = {};
      data.forEach((row) => {
        if (!row.club_name_raw) return;
        nameCounts[row.club_name_raw] = (nameCounts[row.club_name_raw] || 0) + 1;
      });

      const names = Object.keys(nameCounts);
      if (names.length === 0) {
        section.style.display = 'none';
        return;
      }

      section.style.display = 'block';
      listEl.innerHTML = '';

      const clubOptions = clubsList.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');

      names.forEach((rawName) => {
        const row = document.createElement('div');
        row.className = 'link-row';
        row.innerHTML = `
          <span class="link-row-name">${escapeHtml(rawName)} <span class="link-row-count">(${nameCounts[rawName]} জন)</span></span>
          <select class="link-select">
            <option value="">— ক্লাব বেছে নিন —</option>
            ${clubOptions}
          </select>
          <button class="link-btn" disabled>লিংক করুন</button>
        `;

        const select = row.querySelector('.link-select');
        const linkBtn = row.querySelector('.link-btn');

        select.addEventListener('change', () => {
          linkBtn.disabled = !select.value;
        });

        linkBtn.addEventListener('click', () => linkClubName(rawName, select.value, nameCounts[rawName]));

        listEl.appendChild(row);
      });
    }

    async function linkClubName(rawName, clubId, count) {
      if (!clubId) return;
      if (!confirm(`"${rawName}" এর ${count} জন ডোনারকে এই ক্লাবের সাথে লিংক করবেন?`)) return;

      const { error } = await supabase
        .from('manual_blood_donors')
        .update({ club_id: clubId })
        .eq('club_name_raw', rawName)
        .is('club_id', null);

      if (error) {
        alert('লিংক করতে ব্যর্থ: ' + error.message);
        return;
      }

      loadClubLinkSuggestions();
      loadBloodDonors();
    }

    // ============================================================
    // ট্যাব ২: ব্লাড ডোনার (manual_blood_donors)
    // ============================================================
    const bloodContainer = document.getElementById('bloodContainer');
    const bloodEmptyState = document.getElementById('bloodEmptyState');
    const bloodStatusFilter = document.getElementById('bloodStatusFilter');
    const bloodUpazilaFilter = document.getElementById('bloodUpazilaFilter');
    const bulkBar = document.getElementById('bulkBar');
    const selectedCountEl = document.getElementById('selectedCount');
    const bulkApproveBtn = document.getElementById('bulkApproveBtn');
    const bulkClearBtn = document.getElementById('bulkClearBtn');

    const bloodStatusLabels = {
      pending: { text: 'রিভিউ বাকি', bg: '#FFF3E0', color: '#B36B00' },
      active: { text: 'সক্রিয়', bg: '#EAFBF0', color: '#1B7A3C' },
      rejected: { text: 'বাতিল', bg: '#FFF0EA', color: '#D14343' },
      disabled: { text: 'রিপোর্টেড (ডিসেবল)', bg: '#FFF0EA', color: '#D14343' },
    };

    let selectedDonorIds = new Set();

    function updateBulkBar() {
      if (selectedDonorIds.size === 0) {
        bulkBar.style.display = 'none';
        return;
      }
      bulkBar.style.display = 'flex';
      selectedCountEl.textContent = `${selectedDonorIds.size} জন সিলেক্ট করা`;
    }

    function renderBloodEditForm(donor) {
      const form = document.createElement('div');
      form.style.cssText = 'margin-top:14px;padding:14px;background:#F8FAFC;border-radius:14px;border:1px solid #EEF3F9;display:flex;flex-direction:column;gap:10px;';

      const upazilaOpts = upazilaOptions
        .map((u) => `<option value="${u}" ${donor.upazila === u ? 'selected' : ''}>${u}</option>`)
        .join('');

      form.innerHTML = `
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">নাম
          <input type="text" data-field="name" value="${escapeHtml(donor.name || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">ফোন নম্বর
          <input type="text" data-field="phone" value="${escapeHtml(donor.phone || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">ব্লাড গ্রুপ
          <input type="text" data-field="blood_group" value="${escapeHtml(donor.blood_group || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">উপজেলা
          <select data-field="upazila" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;background:#fff;">
            ${upazilaOpts}
          </select>
        </label>
        <label style="font-size:0.78rem;font-weight:700;color:#5A6E85;">ক্লাবের নাম (টেক্সট)
          <input type="text" data-field="club_name_raw" value="${escapeHtml(donor.club_name_raw || '')}" style="width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1.5px solid #E5EAF0;font-size:0.88rem;font-family:inherit;" />
        </label>
        <div style="display:flex;gap:8px;margin-top:4px;">
          <button data-action="save" style="flex:1;background:#1B2A4A;color:#fff;border:none;padding:10px;border-radius:10px;font-size:0.85rem;font-weight:700;cursor:pointer;">সেভ করুন</button>
          <button data-action="cancel" style="background:transparent;color:#8FA0BC;border:1.5px solid #E5EAF0;padding:10px 16px;border-radius:10px;font-size:0.85rem;font-weight:700;cursor:pointer;">বাতিল</button>
        </div>
      `;

      form.querySelector('[data-action="cancel"]').addEventListener('click', () => form.remove());

      form.querySelector('[data-action="save"]').addEventListener('click', async () => {
        const saveBtn = form.querySelector('[data-action="save"]');
        saveBtn.textContent = 'সেভ হচ্ছে...';
        saveBtn.disabled = true;

        const updates = {
          name: form.querySelector('[data-field="name"]').value.trim(),
          phone: form.querySelector('[data-field="phone"]').value.trim(),
          blood_group: form.querySelector('[data-field="blood_group"]').value.trim(),
          upazila: form.querySelector('[data-field="upazila"]').value,
          club_name_raw: form.querySelector('[data-field="club_name_raw"]').value.trim() || null,
        };

        const { error } = await supabase.from('manual_blood_donors').update(updates).eq('id', donor.id);

        if (error) {
          alert('সেভ ব্যর্থ: ' + error.message);
          saveBtn.textContent = 'সেভ করুন';
          saveBtn.disabled = false;
          return;
        }

        loadBloodDonors();
      });

      return form;
    }

    function renderBloodCard(donor) {
      const status = bloodStatusLabels[donor.status] || bloodStatusLabels.pending;

      const card = document.createElement('div');
      card.style.cssText = 'background:#fff;border-radius:18px;padding:18px;box-shadow:0 4px 16px rgba(15,23,42,0.06);display:flex;gap:14px;';

      card.innerHTML = `
        <input type="checkbox" class="donor-checkbox" style="width:20px;height:20px;margin-top:2px;flex-shrink:0;cursor:pointer;" ${selectedDonorIds.has(donor.id) ? 'checked' : ''} />
        <div style="flex:1;min-width:0;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
            <h3 style="font-size:0.98rem;font-weight:700;color:#1B2A4A;">${escapeHtml(donor.name)}</h3>
            <span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:${status.bg};color:${status.color};">${status.text}</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;font-size:0.8rem;color:#5A6E85;">
            <span><i class="fas fa-droplet" style="color:#D14343;"></i> ${escapeHtml(donor.blood_group)}</span>
            <span><i class="fas fa-phone" style="color:#FF6B35;"></i> ${escapeHtml(donor.phone)}</span>
            <span><i class="fas fa-location-dot" style="color:#FF6B35;"></i> ${escapeHtml(donor.upazila || 'নাই')}</span>
            ${donor.club_id ? `<span style="color:#1D6FE0;font-weight:700;"><i class="fas fa-circle-check"></i> ক্লাব লিংকড</span>` : (donor.club_name_raw ? `<span><i class="fas fa-users" style="color:#FF6B35;"></i> ${escapeHtml(donor.club_name_raw)}</span>` : '')}
            <span><i class="fas fa-clock" style="color:#FF6B35;"></i> ${formatDate(donor.created_at)}</span>
          </div>
          <div class="card-actions" style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap;"></div>
          <div class="edit-form-slot"></div>
        </div>
      `;

      const checkbox = card.querySelector('.donor-checkbox');
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) selectedDonorIds.add(donor.id);
        else selectedDonorIds.delete(donor.id);
        updateBulkBar();
      });

      const actionsWrap = card.querySelector('.card-actions');
      const editSlot = card.querySelector('.edit-form-slot');

      if (donor.status !== 'active') {
        const approveBtn = document.createElement('button');
        approveBtn.textContent = 'Approve করুন';
        approveBtn.style.cssText = 'background:#1B7A3C;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        approveBtn.addEventListener('click', () => updateDonorStatus(donor.id, 'active'));
        actionsWrap.appendChild(approveBtn);
      }

      if (donor.status !== 'rejected') {
        const rejectBtn = document.createElement('button');
        rejectBtn.textContent = 'Reject করুন';
        rejectBtn.style.cssText = 'background:#FFF0EA;color:#D14343;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        rejectBtn.addEventListener('click', () => updateDonorStatus(donor.id, 'rejected'));
        actionsWrap.appendChild(rejectBtn);
      }

      const editBtn = document.createElement('button');
      editBtn.textContent = 'এডিট করুন';
      editBtn.style.cssText = 'background:#FFF0EA;color:#FF6B35;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
      editBtn.addEventListener('click', () => {
        editSlot.innerHTML = '';
        editSlot.appendChild(renderBloodEditForm(donor));
      });
      actionsWrap.appendChild(editBtn);

      const deleteBtn = document.createElement('button');
      deleteBtn.textContent = 'ডিলিট';
      deleteBtn.style.cssText = 'background:transparent;color:#8FA0BC;border:1.5px solid #E5EAF0;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
      let confirming = false;
      deleteBtn.addEventListener('click', () => {
        if (!confirming) {
          confirming = true;
          deleteBtn.textContent = 'নিশ্চিত করুন?';
          deleteBtn.style.cssText = 'background:#D14343;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
          return;
        }
        deleteDonor(donor.id);
      });
      actionsWrap.appendChild(deleteBtn);

      return card;
    }

    async function updateDonorStatus(id, status) {
      const { error } = await supabase.from('manual_blood_donors').update({ status }).eq('id', id);
      if (error) { alert('আপডেট ব্যর্থ: ' + error.message); return; }
      selectedDonorIds.delete(id);
      loadBloodDonors();
    }

    async function deleteDonor(id) {
      const { error } = await supabase.from('manual_blood_donors').delete().eq('id', id);
      if (error) { alert('ডিলিট ব্যর্থ: ' + error.message); return; }
      selectedDonorIds.delete(id);
      loadBloodDonors();
    }

    bulkApproveBtn.addEventListener('click', async () => {
      if (selectedDonorIds.size === 0) return;
      if (!confirm(`${selectedDonorIds.size} জন ডোনারকে Approve করবেন?`)) return;

      const ids = Array.from(selectedDonorIds);
      const { error } = await supabase.from('manual_blood_donors').update({ status: 'active' }).in('id', ids);

      if (error) { alert('বাল্ক Approve ব্যর্থ: ' + error.message); return; }

      selectedDonorIds.clear();
      loadBloodDonors();
    });

    bulkClearBtn.addEventListener('click', () => {
      selectedDonorIds.clear();
      updateBulkBar();
      loadBloodDonors();
    });

    async function loadBloodDonors() {
      bloodContainer.innerHTML = '<p style="text-align:center;color:#8FA0BC;padding:40px 0;">লোড হচ্ছে...</p>';

      let query = supabase.from('manual_blood_donors').select('*').order('created_at', { ascending: false });

      const status = bloodStatusFilter.value;
      const upazila = bloodUpazilaFilter.value;

      if (status !== 'all') query = query.eq('status', status);
      if (upazila !== 'all') query = query.eq('upazila', upazila);

      const { data, error } = await query;

      if (error) {
        bloodContainer.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${error.message}</p>`;
        return;
      }

      const donors = data || [];
      bloodContainer.innerHTML = '';
      updateBulkBar();

      if (donors.length === 0) {
        bloodEmptyState.style.display = 'flex';
        return;
      }

      bloodEmptyState.style.display = 'none';
      donors.forEach((donor) => bloodContainer.appendChild(renderBloodCard(donor)));
    }

    bloodStatusFilter.addEventListener('change', loadBloodDonors);
    bloodUpazilaFilter.addEventListener('change', loadBloodDonors);

    // ============================================================
    // ট্যাব ৩: রিপোর্ট/অভিযোগ (content_reports)
    // ============================================================
    const reportsContainer = document.getElementById('reportsContainer');
    const reportsEmptyState = document.getElementById('reportsEmptyState');
    const reportStatusFilter = document.getElementById('reportStatusFilter');
    const reportTargetTypeFilter = document.getElementById('reportTargetTypeFilter');
    const reportsBadge = document.getElementById('reportsBadge');

    const reasonLabelMap = {
      unavailable: 'এভেইলেবল না / প্রবাসে',
      behavior: 'আচরণ খারাপ',
      wrong_info: 'ভুল তথ্য',
      sold: 'বিক্রি হয়ে গেছে',
      rented: 'ভাড়া হয়ে গেছে',
      other: 'অন্যান্য',
    };

    const targetTypeLabels = {
      listing: 'লিস্টিং',
      blood_profile: 'ব্লাড ডোনার (রেজিস্টার্ড)',
      blood_manual: 'ব্লাড ডোনার (ম্যানুয়াল)',
    };

    async function refreshReportsBadge() {
      const { count } = await supabase
        .from('content_reports')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'pending');

      if (count && count > 0) {
        reportsBadge.textContent = count;
        reportsBadge.style.display = 'inline-block';
      } else {
        reportsBadge.style.display = 'none';
      }
    }

    function resolveTargetInfo(targetType, targetId, listingMap, profileMap, manualMap) {
      if (targetType === 'listing') {
        const l = listingMap[targetId];
        if (!l) return { title: '(লিস্টিং পাওয়া যায়নি — ডিলিট হয়ে থাকতে পারে)', subtitle: '', ownerUserId: null, isActive: false, notFound: true };
        return {
          title: l.title || '(শিরোনামহীন)',
          subtitle: categoryNameMap[l.category] || l.category,
          ownerUserId: l.user_id || null,
          isDisabled: !!l.is_disabled,
          notFound: false,
        };
      }
      if (targetType === 'blood_profile') {
        const p = profileMap[targetId];
        if (!p) return { title: '(প্রোফাইল পাওয়া যায়নি)', subtitle: '', ownerUserId: null, isDisabled: false, notFound: true };
        return {
          title: p.full_name || '(নাম নাই)',
          subtitle: `রক্তদাতা · ${p.phone || ''}`,
          ownerUserId: p.id,
          isDisabled: !!p.donor_disabled,
          notFound: false,
        };
      }
      if (targetType === 'blood_manual') {
        const m = manualMap[targetId];
        if (!m) return { title: '(ডোনার পাওয়া যায়নি — ডিলিট হয়ে থাকতে পারে)', subtitle: '', ownerUserId: null, isDisabled: false, notFound: true };
        return {
          title: m.name || '(নাম নাই)',
          subtitle: `রক্তদাতা (ম্যানুয়াল) · ${m.phone || ''}`,
          ownerUserId: null,
          isDisabled: m.status === 'disabled',
          notFound: false,
        };
      }
      return { title: targetId, subtitle: '', ownerUserId: null, isDisabled: false, notFound: true };
    }

    function renderReportGroupCard(group, targetInfo, reporterMap) {
      const card = document.createElement('div');
      card.style.cssText = 'background:#fff;border-radius:18px;padding:18px;box-shadow:0 4px 16px rgba(15,23,42,0.06);display:flex;flex-direction:column;gap:12px;';

      const reportRows = group.reports
        .map((r) => {
          const reporter = reporterMap[r.user_id];
          const reasonText = reasonLabelMap[r.reason_category] || r.reason_category;
          return `
            <div style="padding:10px 12px;background:#F8FAFC;border-radius:12px;font-size:0.82rem;color:#1B2A4A;">
              <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;">
                <span style="font-weight:700;">${escapeHtml(reporter?.full_name || 'অজানা ইউজার')} ${reporter?.phone ? `· ${escapeHtml(reporter.phone)}` : ''}</span>
                <span style="color:#8FA0BC;font-size:0.75rem;">${formatDate(r.created_at)}</span>
              </div>
              <div style="margin-top:4px;color:#D14343;font-weight:700;">${escapeHtml(reasonText)}</div>
              ${r.reason_details ? `<div style="margin-top:2px;color:#5A6E85;">${escapeHtml(r.reason_details)}</div>` : ''}
            </div>
          `;
        })
        .join('');

      card.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;flex-wrap:wrap;">
          <div>
            <span style="font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:20px;background:#F4F7FC;color:#5A6E85;">${targetTypeLabels[group.target_type] || group.target_type}</span>
            <h3 style="font-size:1rem;font-weight:700;color:#1B2A4A;margin-top:6px;">${escapeHtml(targetInfo.title)}</h3>
            ${targetInfo.subtitle ? `<p style="font-size:0.82rem;color:#8FA0BC;">${escapeHtml(targetInfo.subtitle)}</p>` : ''}
          </div>
          <span style="font-size:0.75rem;font-weight:800;padding:4px 12px;border-radius:20px;background:#FFF0EA;color:#D14343;white-space:nowrap;">
            ${group.reports.length} টা অভিযোগ
          </span>
        </div>

        <div style="display:flex;flex-direction:column;gap:8px;">${reportRows}</div>

        <div class="report-actions" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
      `;

      const actionsWrap = card.querySelector('.report-actions');

      if (!targetInfo.notFound) {
        if (targetInfo.isDisabled) {
          const activateBtn = document.createElement('button');
          activateBtn.textContent = 'সক্রিয় করুন';
          activateBtn.style.cssText = 'background:#1B7A3C;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
          activateBtn.addEventListener('click', () => activateTarget(group));
          actionsWrap.appendChild(activateBtn);
        }

        const deleteBtn = document.createElement('button');
        deleteBtn.textContent = group.target_type === 'blood_profile' ? 'তালিকা থেকে বাদ দিন' : 'ডিলিট করুন';
        deleteBtn.style.cssText = 'background:#FFF0EA;color:#D14343;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
        let confirming = false;
        deleteBtn.addEventListener('click', () => {
          if (!confirming) {
            confirming = true;
            deleteBtn.textContent = 'নিশ্চিত করুন?';
            deleteBtn.style.cssText = 'background:#D14343;color:#fff;border:none;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
            return;
          }
          deleteTarget(group);
        });
        actionsWrap.appendChild(deleteBtn);

        if (targetInfo.ownerUserId) {
          const blockBtn = document.createElement('button');
          blockBtn.textContent = 'ইউজার ব্লক করুন';
          blockBtn.style.cssText = 'background:transparent;color:#8FA0BC;border:1.5px solid #E5EAF0;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
          blockBtn.addEventListener('click', () => blockOwner(targetInfo.ownerUserId));
          actionsWrap.appendChild(blockBtn);
        }
      }

      const dismissBtn = document.createElement('button');
      dismissBtn.textContent = 'রিপোর্ট বাতিল করুন (সমস্যা নাই)';
      dismissBtn.style.cssText = 'background:transparent;color:#8FA0BC;border:1.5px solid #E5EAF0;padding:8px 16px;border-radius:10px;font-size:0.8rem;font-weight:700;cursor:pointer;';
      dismissBtn.addEventListener('click', () => dismissReports(group));
      actionsWrap.appendChild(dismissBtn);

      return card;
    }

    async function activateTarget(group) {
      let error = null;
      if (group.target_type === 'listing') {
        ({ error } = await supabase.from('listings').update({ is_disabled: false, disabled_at: null }).eq('id', group.target_id));
      } else if (group.target_type === 'blood_profile') {
        ({ error } = await supabase.from('profiles').update({ donor_disabled: false, donor_disabled_at: null }).eq('id', group.target_id));
      } else if (group.target_type === 'blood_manual') {
        ({ error } = await supabase.from('manual_blood_donors').update({ status: 'active' }).eq('id', group.target_id));
      }

      if (error) { alert('সক্রিয় করা ব্যর্থ: ' + error.message); return; }
      await dismissReports(group, false);
      loadReports();
    }

    async function deleteTarget(group) {
      let error = null;

      // লিস্টিং হলে, cnglagbe সোর্স হলে ব্লকলিস্টে ফোন নম্বর যোগ করা
      if (group.target_type === 'listing') {
        const { data: listingRow } = await supabase
          .from('listings')
          .select('source, contact_phone')
          .eq('id', group.target_id)
          .single();

        if (listingRow?.source && listingRow?.contact_phone) {
          await supabase
            .from('scraper_blocklist')
            .upsert(
              { source: listingRow.source, phone: listingRow.contact_phone },
              { onConflict: 'source,phone' }
            );
        }

        ({ error } = await supabase.from('listings').delete().eq('id', group.target_id));
      } else if (group.target_type === 'blood_manual') {
        ({ error } = await supabase.from('manual_blood_donors').delete().eq('id', group.target_id));
      } else if (group.target_type === 'blood_profile') {
        ({ error } = await supabase.from('profiles').update({ is_blood_donor: false, donor_disabled: true }).eq('id', group.target_id));
      }

      if (error) { alert('ব্যর্থ: ' + error.message); return; }

      const ids = group.reports.map((r) => r.id);
      await supabase.from('content_reports').update({ status: 'resolved' }).in('id', ids);

      loadReports();
      refreshReportsBadge();
    }

    async function dismissReports(group, reload = true) {
      const ids = group.reports.map((r) => r.id);
      const { error } = await supabase.from('content_reports').update({ status: 'dismissed' }).in('id', ids);
      if (error) { alert('ব্যর্থ: ' + error.message); return; }
      if (reload) {
        loadReports();
        refreshReportsBadge();
      }
    }

    async function blockOwner(userId) {
      if (!confirm('এই ইউজারকে ব্লক করবেন? ব্লক হলে তিনি আর লগইন করতে পারবেন না।')) return;
      const { error } = await supabase.from('profiles').update({ is_blocked: true }).eq('id', userId);
      if (error) { alert('ব্লক করা ব্যর্থ: ' + error.message); return; }
      alert('ইউজার ব্লক করা হয়েছে।');
    }

    async function loadReports() {
      reportsContainer.innerHTML = '<p style="text-align:center;color:#8FA0BC;padding:40px 0;">লোড হচ্ছে...</p>';

      let query = supabase.from('content_reports').select('*').order('created_at', { ascending: false });

      const status = reportStatusFilter.value;
      const targetType = reportTargetTypeFilter.value;

      if (status !== 'all') query = query.eq('status', status);
      if (targetType !== 'all') query = query.eq('target_type', targetType);

      const { data: reports, error } = await query;

      if (error) {
        reportsContainer.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${error.message}</p>`;
        return;
      }

      if (!reports || reports.length === 0) {
        reportsContainer.innerHTML = '';
        reportsEmptyState.style.display = 'flex';
        return;
      }

      reportsEmptyState.style.display = 'none';

      const groups = {};
      reports.forEach((r) => {
        const key = `${r.target_type}:${r.target_id}`;
        if (!groups[key]) groups[key] = { target_type: r.target_type, target_id: r.target_id, reports: [] };
        groups[key].reports.push(r);
      });
      const groupList = Object.values(groups);

      const reporterIds = [...new Set(reports.map((r) => r.user_id))];
      const { data: reporterProfiles } = reporterIds.length
        ? await supabase.from('profiles').select('id, full_name, phone').in('id', reporterIds)
        : { data: [] };
      const reporterMap = Object.fromEntries((reporterProfiles || []).map((p) => [p.id, p]));

      const listingIds = groupList.filter((g) => g.target_type === 'listing').map((g) => g.target_id);
      const profileIds = groupList.filter((g) => g.target_type === 'blood_profile').map((g) => g.target_id);
      const manualIds = groupList.filter((g) => g.target_type === 'blood_manual').map((g) => g.target_id);

      const [listingsRes, profilesRes, manualRes] = await Promise.all([
        listingIds.length ? supabase.from('listings').select('id, title, category, user_id, is_disabled').in('id', listingIds) : Promise.resolve({ data: [] }),
        profileIds.length ? supabase.from('profiles').select('id, full_name, phone, donor_disabled').in('id', profileIds) : Promise.resolve({ data: [] }),
        manualIds.length ? supabase.from('manual_blood_donors').select('id, name, phone, status').in('id', manualIds) : Promise.resolve({ data: [] }),
      ]);

      const listingMap = Object.fromEntries((listingsRes.data || []).map((l) => [l.id, l]));
      const profileMap = Object.fromEntries((profilesRes.data || []).map((p) => [p.id, p]));
      const manualMap = Object.fromEntries((manualRes.data || []).map((m) => [m.id, m]));

      reportsContainer.innerHTML = '';
      groupList.forEach((group) => {
        const targetInfo = resolveTargetInfo(group.target_type, group.target_id, listingMap, profileMap, manualMap);
        reportsContainer.appendChild(renderReportGroupCard(group, targetInfo, reporterMap));
      });
    }

    reportStatusFilter.addEventListener('change', loadReports);
    reportTargetTypeFilter.addEventListener('change', loadReports);

    // ============================================================
    window.addEventListener('smartfeni:admin-ready', () => {
      loadListings();
      loadClubsList();
      refreshReportsBadge();
    });

    initAdminGuard();
  </script>
</BaseLayout>