    .mo-cta:disabled, .mo-ghost:disabled { opacity: 0.55; cursor: not-allowed; }
    .mo-ghost { height: 44px; border: 1.5px solid #D5DCE8; border-radius: 14px; background: #fff; color: #1B2A4A; font-weight: 600; font-size: 14.5px; padding: 0 14px; cursor: pointer; }
    .mo-red { color: #B3261E; }
    .mo-add { height: 46px; border: 1.5px dashed #FF6B35; border-radius: 14px; background: #FFF6F1; font-weight: 700; font-size: 15px; color: #1B2A4A; cursor: pointer; }
    .mo-field { border: 1.5px solid #D5DCE8; border-radius: 14px; background: #fff; padding: 0 14px; min-height: 48px; display: flex; align-items: center; gap: 8px; color: #5B6B86; }
    .mo-field input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 15px; color: #1B2A4A; min-height: 44px; }
