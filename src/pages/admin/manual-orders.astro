      ph.appendChild(tel);
      card.appendChild(ph);

      const addr = el('div', 'mo-line');
      addr.appendChild(el('span', 'mo-lab', 'ড্রপ: '));
      addr.appendChild(document.createTextNode(o.drop_address + ' '));
      const dm = safeLink(o.drop_map_link);
      if (dm) { const a = el('a', '', 'ম্যাপ'); a.href = dm; a.target = '_blank'; a.rel = 'noopener'; addr.appendChild(a); }
      card.appendChild(addr);

      if (o.pickup_name) {
        const pk = el('div', 'mo-line');
        pk.appendChild(el('span', 'mo-lab', 'পিকআপ: '));
        pk.appendChild(document.createTextNode(o.pickup_name + ' '));
        const pm = safeLink(o.pickup_map_link);
        if (pm) { const a = el('a', '', 'ম্যাপ'); a.href = pm; a.target = '_blank'; a.rel = 'noopener'; pk.appendChild(a); }
        card.appendChild(pk);
      }
      const dt = el('div', 'mo-line');
      dt.appendChild(el('span', 'mo-lab', 'অর্ডার: '));
      dt.appendChild(document.createTextNode(o.details));
      card.appendChild(dt);

      const mon = el('div', 'mo-money');
      [['মোট', o.total_amount, ''], ['অ্যাডভান্স', o.advance_amount, ''], ['ক্যাশ নেবে', o.status === 'delivered' || o.status === 'completed' ? (o.cash_collected == null ? o.cod_amount : o.cash_collected) : o.cod_amount, 'cash']].forEach(([l, v, c]) => {
        const m = el('div', 'mo-m ' + c);
        m.appendChild(el('small', '', l));
        m.appendChild(el('b', '', money(v)));
        mon.appendChild(m);
      });
      card.appendChild(mon);

      const rd = riderOf(o);
      const rl = el('div', 'mo-line');
      rl.appendChild(el('span', 'mo-lab', 'রাইডার: '));
      rl.appendChild(document.createTextNode(rd ? rd.name + (rd.phone ? ' (' + rd.phone + ')' : '') + ' · পে ' + money(o.rider_pay) : '—'));
      card.appendChild(rl);

      if (o.status === 'cancelled' && o.cancel_reason) {
        const cr = el('div', 'mo-line');
        cr.appendChild(el('span', 'mo-lab', 'বাতিলের কারণ: '));
        cr.appendChild(document.createTextNode(o.cancel_reason));
        card.appendChild(cr);
      }
      if (o.note) {
        const nt = el('div', 'mo-line');
        nt.appendChild(el('span', 'mo-lab', 'নোট: '));
        nt.appendChild(document.createTextNode(o.note));
        card.appendChild(nt);
      }
      if (o.entered_by && names[o.entered_by]) {
        card.appendChild(el('div', 'mo-line', 'নিয়েছেন: ' + names[o.entered_by]));
      }

      const btns = el('div', 'mo-btns');
      if (o.status === 'new') {
        const b = el('button', 'mo-cta', 'রাইডার ঠিক করুন'); b.type = 'button';
        b.addEventListener('click', () => openOrderForm(o, 'f_rider'));
        btns.appendChild(b);
      } else if (o.status === 'rider_assigned') {
        const b = el('button', 'mo-cta', 'পিকআপ হয়েছে'); b.type = 'button';
        b.addEventListener('click', () => setStatus(o, 'picked_up'));
        btns.appendChild(b);
      } else if (o.status === 'picked_up') {
        const b = el('button', 'mo-cta', 'ডেলিভারড ✓'); b.type = 'button';
        b.addEventListener('click', () => openDeliver(o));
        btns.appendChild(b);
      }
      if (o.status === 'new' && !o.manual_rider_id) {
        const pub = el('button', 'mo-cta', o.published_at ? 'রাইডারদের কাছে আবার নোটিফাই' : 'রাইডারদের কাছে প্রকাশ');
        pub.type = 'button';
        pub.addEventListener('click', () => workflowAction('publish', o));
        btns.appendChild(pub);
        if (o.published_at && role === 'admin') {
          const pay = el('button', 'mo-ghost', 'রাইডার পে বাড়ান'); pay.type = 'button';
          pay.addEventListener('click', async () => {
            const value = prompt('নতুন রাইডার পে লিখুন (বর্তমান: ' + money(o.rider_pay) + ')');
            if (value === null) return;
            const amount = Number(value);
            if (!Number.isFinite(amount) || amount <= Number(o.rider_pay || 0)) return toast('বর্তমান পে-এর চেয়ে বেশি পরিমাণ লিখুন', 'error');
            await workflowAction('raise_pay', o, { riderPay: amount });
          });
          btns.appendChild(pay);
        }
      }
      if (['rider_assigned', 'picked_up'].includes(o.status) && !o.ready_at) {
        const ready = el('button', 'mo-cta', 'অর্ডার প্রস্তুত (Ready)');
        ready.type = 'button';
        ready.addEventListener('click', () => workflowAction('ready', o));
        btns.appendChild(ready);
      }
      if (role === 'admin' && ['delivered', 'completed'].includes(o.status)) {
        const cashEdit = el('button', 'mo-ghost', 'ক্যাশের হিসাব ঠিক করুন');
        cashEdit.type = 'button';
        cashEdit.addEventListener('click', async () => {
          const current = o.cash_collected == null ? o.cod_amount : o.cash_collected;
          const value = prompt('আসল ক্যাশ রিসিভের পরিমাণ লিখুন (বর্তমান: ' + money(current) + ')');
          if (value === null) return;
          const amount = Number(value);
          if (!Number.isFinite(amount) || amount < 0) return toast('সঠিক ক্যাশের পরিমাণ লিখুন', 'error');
          const note = prompt('কেন সংশোধন করা হচ্ছে? (ঐচ্ছিক)', '') || '';
          await workflowAction('adjust_cash', o, { cashReceived: amount, note });
        });
        btns.appendChild(cashEdit);
      }
      if (role === 'admin' && !ACTIVE_OFF.includes(o.status)) {
        const cancel = el('button', 'mo-ghost mo-red', 'অর্ডার বাতিল');
        cancel.type = 'button';
        cancel.addEventListener('click', () => {
          const reason = prompt('অর্ডার বাতিলের কারণ লিখুন:');
          if (reason === null) return;
          if (!reason.trim()) return toast('বাতিলের কারণ লিখুন', 'error');
          if (confirm(o.order_no + ' অর্ডার বাতিল করবেন?')) workflowAction('cancel', o, { reason: reason.trim() });
        });
        btns.appendChild(cancel);
      }
      const edit = el('button', 'mo-ghost', 'এডিট'); edit.type = 'button';
      edit.addEventListener('click', () => openOrderForm(o));
      btns.appendChild(edit);
      card.appendChild(btns);

      const btns2 = el('div', 'mo-btns');
      const cr = el('button', 'mo-ghost', 'রাইডার মেসেজ'); cr.type = 'button';
      cr.addEventListener('click', () => copyText(riderMsg(o)));
      const cc = el('button', 'mo-ghost', 'কাস্টমার মেসেজ'); cc.type = 'button';
      cc.addEventListener('click', () => copyText(customerMsg(o)));
      btns2.appendChild(cr);
      btns2.appendChild(cc);
      const wc = waNumber(o.customer_phone);
      if (wc) {
        const w = el('a', 'mo-ghost', 'WhatsApp');
        w.style.display = 'inline-flex'; w.style.alignItems = 'center'; w.style.textDecoration = 'none';
        w.href = 'https://wa.me/' + wc + '?text=' + encodeURIComponent(customerMsg(o));
        w.target = '_blank'; w.rel = 'noopener';
        btns2.appendChild(w);
      }
      card.appendChild(btns2);
      return card;
    }

    async function workflowAction(action, o, extra = {}) {
      if (busy) return;
      busy = true;
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) throw new Error('সেশন শেষ হয়েছে, আবার লগইন করুন।');
        const res = await fetch('/api/manual-orders/workflow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.access_token },
          body: JSON.stringify({ action, orderId: o.id, ...extra }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'অ্যাকশন সম্পন্ন হয়নি');
        toast(action === 'publish' ? 'রাইডারদের কাছে অর্ডার প্রকাশ করা হয়েছে' :
          action === 'ready' ? 'রাইডারকে Ready নোটিফিকেশন পাঠানো হয়েছে' :
          action === 'cancel' ? 'অর্ডার বাতিল হয়েছে' :
          action === 'raise_pay' ? 'রাইডার পে বাড়ানো হয়েছে' : 'আপডেট হয়েছে', 'success');
        await loadOrders();
      } catch (e) { toast(e.message || 'সমস্যা হয়েছে', 'error'); }
      finally { busy = false; }
    }

    // ---------- স্ট্যাটাস ----------
    async function setStatus(o, status) {
      if (busy) return;
      busy = true;
      const { error } = await supabase.from('manual_orders').update({ status }).eq('id', o.id);
      busy = false;
      if (error) { toast('বদলানো যায়নি', 'error'); return; }
      await loadOrders();
    }

    function openDeliver(o) {
      dvOrder = o;
      $('dvInfo').textContent = o.order_no + ' · ' + o.customer_name + ' · ক্যাশ নেওয়ার কথা ' + money(o.cod_amount);
      $('dv_cash').value = o.cod_amount;
      showErr('dvErr', '');
      openSheet('dvOverlay');
    }
    async function saveDeliver() {
      if (busy || !dvOrder) return;
      const v = $('dv_cash').value;
      if (v === '' || num(v) < 0) return showErr('dvErr', 'ক্যাশের পরিমাণ লিখুন (নাই হলে ০)।');
      busy = true;
      $('dvSave').disabled = true;
      const { error } = await supabase.from('manual_orders').update({ status: 'delivered', cash_collected: num(v) }).eq('id', dvOrder.id);
      busy = false;
      $('dvSave').disabled = false;
      if (error) return showErr('dvErr', 'সেভ হয়নি, আবার চেষ্টা করুন।');
      closeSheet('dvOverlay');
      toast('ডেলিভারড করা হয়েছে', 'success');
      await loadOrders();
    }

    // ---------- অর্ডার ফর্ম ----------
    function fillRiderSelect(selected) {
      const s = $('f_rider');
      s.replaceChildren();
      const none = el('option', '', 'রাইডার ঠিক হয়নি'); none.value = '';
      s.appendChild(none);
      riders.forEach((r) => { const op = el('option', '', r.name + (r.phone ? ' · ' + r.phone : '')); op.value = r.id; s.appendChild(op); });
      const nw = el('option', '', '+ নতুন রাইডার যোগ করুন'); nw.value = '__new';
      s.appendChild(nw);
      s.value = selected || '';
    }

    function updateCalc() {
      const price = num($('f_price').value);
      const fee = num($('f_fee').value);
      const adv = num($('f_adv').value);
      const pay = num($('f_pay').value);
      const total = price + fee;
      const cash = Math.max(total - adv, 0);
      const box = $('calcBox');
      box.replaceChildren();
      const rows = [['মোট (প্রোডাক্ট + ফি)', money(total), ''], ['অ্যাডভান্স', money(adv), ''], ['রাইডার ক্যাশ নেবে', money(cash), 'big'], ['আমাদের ডেলিভারি লাভ (ফি − রাইডার পে)', money(fee - pay), '']];
      rows.forEach(([l, v, c]) => {
        const d = el('div', c);
        d.appendChild(el('span', '', l));
        d.appendChild(el('b', '', v));
        box.appendChild(d);
      });
      showErrInline('advErr', adv > total ? 'অ্যাডভান্স মোটের চেয়ে বেশি হতে পারে না।' : '');
    }
    function showErrInline(id, text) {
      const e = $(id);
      e.textContent = text || '';
      e.style.display = text ? 'block' : 'none';
    }

    function syncAsap() {
      const asap = $('f_asap').checked;
      $('f_time').required = !asap;
      $('timeStar').style.display = asap ? 'none' : '';
    }

    function openOrderForm(o, focusId) {
      editing = o || null;
      $('orderFormTitle').textContent = o ? 'অর্ডার এডিট · ' + o.order_no : 'নতুন অর্ডার';
      $('saveOrderBtn').textContent = o ? 'পরিবর্তন সেভ করুন' : 'অর্ডার সেভ করুন';
      $('statusGroup').style.display = o ? '' : 'none';
      $('delOrderBtn').style.display = o && role === 'admin' ? '' : 'none';
      $('dupWarn').style.display = 'none';
      $('aiBox').style.display = o ? 'none' : '';
      $('aiText').value = '';
      setAiStatus('', false);
      showErr('formErr', '');
      const d = o ? new Date(o.scheduled_at) : new Date();
      $('f_name').value = o ? o.customer_name : '';
      $('f_phone').value = o ? o.customer_phone : '';
      $('f_addr').value = o ? o.drop_address : '';
      $('f_dmap').value = o ? o.drop_map_link || '' : '';
      $('f_pname').value = o ? o.pickup_name || '' : '';
      $('f_pmap').value = o ? o.pickup_map_link || '' : '';
      $('f_details').value = o ? o.details : '';
      $('f_date').value = dateInput(d);
      $('f_time').value = o ? timeInput(d) : '';
      $('f_asap').checked = o ? !!o.is_asap : false;
      $('f_strict').checked = o ? !!o.is_strict_time : false;
      $('f_price').value = o ? o.product_price : '';
      $('f_fee').value = o ? o.delivery_fee : '';
      $('f_adv').value = o && Number(o.advance_amount) ? o.advance_amount : '';
      $('f_advm').value = o ? o.advance_method || '' : '';
      $('f_trx').value = o ? o.advance_trx_id || '' : '';
      $('f_pay').value = o && Number(o.rider_pay) ? o.rider_pay : '';
      $('f_shop').value = o ? o.shop_paid_by : 'rider';
      $('f_cost').value = o && o.product_cost != null ? o.product_cost : '';
      $('f_note').value = o ? o.note || '' : '';
      $('f_status').value = o ? (o.status === 'completed' ? 'delivered' : o.status) : 'new';
      $('f_cancel').value = o ? o.cancel_reason || '' : '';
      $('cancelGroup').style.display = $('f_status').value === 'cancelled' ? '' : 'none';
      fillRiderSelect(o ? o.manual_rider_id : '');
      syncAsap();
      updateCalc();
      openSheet('orderOverlay');
      if (focusId) setTimeout(() => { const f = $(focusId); if (f) f.focus(); }, 150);
    }

    // ---------- অটো-ফিল (ফেসবুক মেসেজ → ফর্ম) ----------
    function setAiStatus(text, bad) {
      const s = $('aiStatus');
      s.textContent = text || '';
      s.classList.toggle('bad', !!bad);
      s.style.display = text ? 'block' : 'none';
    }

    function applyAi(f) {
      let n = 0;
      const set = (id, v) => { if (v !== null && v !== undefined && v !== '') { $(id).value = v; n++; } };
      set('f_name', f.customer_name);
      set('f_phone', f.customer_phone);
      set('f_addr', f.drop_address);
      set('f_dmap', f.drop_map_link);
      set('f_pname', f.pickup_name);
      set('f_details', f.details);
      set('f_date', f.delivery_date);
      set('f_time', f.delivery_time);
      if (f.is_asap) { $('f_asap').checked = true; n++; }
      syncAsap();
      set('f_price', f.product_price);
      set('f_fee', f.delivery_fee);
      set('f_adv', f.advance_amount);
      if (f.advance_amount > 0 && f.advance_method) $('f_advm').value = f.advance_method;
      set('f_trx', f.advance_trx_id);
      set('f_note', f.note);
      updateCalc();
      checkDup();
      if (n) setAiStatus('অটো-ফিল হয়েছে (' + bn(n) + 'টা ঘর)। সেভের আগে সব মিলিয়ে নিন, বিশেষ করে ফোন, সময় ও টাকা।', false);
      else setAiStatus('মেসেজ থেকে কিছু বের করা যায়নি, হাতে লিখুন।', true);
    }

    async function aiFill() {
      if (busy) return;
      const text = $('aiText').value.trim();
      if (text.length < 10) return setAiStatus('আগে কাস্টমারের মেসেজটা পেস্ট করুন।', true);
      busy = true;
      $('aiBtn').disabled = true;
      setAiStatus('মেসেজ পড়া হচ্ছে...', false);
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/admin/parse-manual-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (session ? session.access_token : '') },
          body: JSON.stringify({ text }),
        });
        const out = await res.json().catch(() => null);
        if (!res.ok || !out || !out.fields) {
          setAiStatus((out && out.error) || 'অটো-ফিল হয়নি, হাতে লিখুন।', true);
        } else {
          applyAi(out.fields);
        }
      } catch (e) {
        setAiStatus('নেটওয়ার্ক সমস্যা, আবার চেষ্টা করুন।', true);
      } finally {
        busy = false;
        $('aiBtn').disabled = false;
      }
    }

    async function checkDup() {
      if (editing) return;
      const phone = $('f_phone').value.trim();
      const w = $('dupWarn');
      if (phone.length < 6) { w.style.display = 'none'; return; }
      const { data } = await supabase.from('manual_orders').select('order_no, scheduled_at, status').eq('customer_phone', phone).not('status', 'in', '(delivered,completed,cancelled)').limit(5);
      if (data && data.length) {
        w.textContent = 'সতর্কতা: এই নম্বরে আগে থেকেই ' + bn(data.length) + 'টা চলমান অর্ডার আছে (' + data.map((x) => x.order_no).join(', ') + ')। ডুপ্লিকেট কিনা দেখে নিন।';
        w.style.display = 'block';
      } else w.style.display = 'none';
    }

    async function saveOrder() {
      if (busy) return;
      showErr('formErr', '');
      if (!window.SFValidateForm($('orderForm'))) return showErr('formErr', 'লাল চিহ্নিত ঘরগুলো পূরণ করুন।');
      const price = num($('f_price').value);
      const fee = num($('f_fee').value);
      const adv = num($('f_adv').value);
      if (adv > price + fee) return showErr('formErr', 'অ্যাডভান্স মোটের চেয়ে বেশি হতে পারে না।');
      const asap = $('f_asap').checked;
      let when;
      if (asap && !$('f_time').value) when = new Date();
      else when = new Date($('f_date').value + 'T' + $('f_time').value + ':00+06:00');
      if (isNaN(when.getTime())) return showErr('formErr', 'তারিখ ও সময় ঠিকভাবে দিন।');

      const riderId = $('f_rider').value || null;
      let status = editing ? $('f_status').value : (riderId ? 'rider_assigned' : 'new');
      if (editing && status === 'cancelled' && editing.status !== 'cancelled') {
        return showErr('formErr', 'অর্ডার বাতিল করতে কার্ডের “অর্ডার বাতিল” বাটন ব্যবহার করুন, যাতে কারণ ও নোটিফিকেশন সংরক্ষিত হয়।');
      }
      if (editing) {
        if (status === 'new' && riderId) status = 'rider_assigned';
        else if (status === 'rider_assigned' && !riderId) status = 'new';
      }
      const costV = $('f_cost').value;
      const payload = {
        customer_name: $('f_name').value.trim(),
        customer_phone: $('f_phone').value.trim(),
        drop_address: $('f_addr').value.trim(),
        drop_map_link: $('f_dmap').value.trim() || null,
        pickup_name: $('f_pname').value.trim() || null,
        pickup_map_link: $('f_pmap').value.trim() || null,
        details: $('f_details').value.trim(),
        scheduled_at: when.toISOString(),
        is_asap: asap,
        is_strict_time: $('f_strict').checked,
        product_price: price,
        delivery_fee: fee,
        product_cost: costV === '' ? null : num(costV),
        advance_amount: adv,
        advance_method: adv > 0 ? ($('f_advm').value || 'other') : null,
        advance_trx_id: adv > 0 ? ($('f_trx').value.trim() || null) : null,
        shop_paid_by: $('f_shop').value,
        manual_rider_id: riderId,
        rider_pay: num($('f_pay').value),
        note: $('f_note').value.trim() || null,
        status,
        cancel_reason: status === 'cancelled' ? ($('f_cancel').value.trim() || null) : null,
      };
      busy = true;
      $('saveOrderBtn').disabled = true;
      let error;
      if (editing) ({ error } = await supabase.from('manual_orders').update(payload).eq('id', editing.id));
      else ({ error } = await supabase.from('manual_orders').insert(payload));
      busy = false;
      $('saveOrderBtn').disabled = false;
      if (error) return showErr('formErr', 'সেভ হয়নি: ' + (error.message || 'আবার চেষ্টা করুন'));
      closeSheet('orderOverlay');
      toast(editing ? 'অর্ডার আপডেট হয়েছে' : 'নতুন অর্ডার যোগ হয়েছে', 'success');
      await loadOrders();
    }

    async function deleteOrder() {
      if (busy || !editing || role !== 'admin') return;
      if (!confirm(editing.order_no + ' অর্ডারটা চিরতরে ডিলিট করবেন? (হিসাব থেকেও চলে যাবে)')) return;
      busy = true;
      const { error } = await supabase.from('manual_orders').delete().eq('id', editing.id);
      busy = false;
      if (error) return showErr('formErr', 'ডিলিট হয়নি।');
      closeSheet('orderOverlay');
      toast('ডিলিট হয়েছে', 'success');
      await loadOrders();
    }

    // ---------- রাইডার যোগ ----------
    function openRiderSheet(cb) {
      rdCallback = cb || null;
      $('rd_name').value = '';
      $('rd_phone').value = '';
      showErr('rdErr', '');
      openSheet('rdOverlay');
    }
    async function saveRider() {
      if (busy) return;
      if (!window.SFValidateForm($('rdSheet'))) return showErr('rdErr', 'রাইডারের নাম লিখুন।');
      busy = true;
      $('rdSave').disabled = true;
      const { data, error } = await supabase.from('manual_riders').insert({ name: $('rd_name').value.trim(), phone: $('rd_phone').value.trim() || null }).select().single();
      busy = false;
      $('rdSave').disabled = false;
      if (error || !data) return showErr('rdErr', 'সেভ হয়নি, আবার চেষ্টা করুন।');
      riders.push(data);
      riders.sort((a, b) => a.name.localeCompare(b.name));
      closeSheet('rdOverlay');
      toast('রাইডার যোগ হয়েছে', 'success');
      if (rdCallback) rdCallback(data);
      else if (role === 'admin') loadAccounts();
    }

    // ---------- হিসাব ----------
    function periodStart() {
      const now = new Date();
      if (period === 'today') return startOfDay(now);
      if (period === 'week') return new Date(startOfDay(now).getTime() - 6 * 86400000);
      if (period === 'month') { const p = bdp(now); return new Date(Date.UTC(p.y, p.m - 1, 1) - BD_OFFSET_MS); }
      return null;
    }

    function renderPeriodChips() {
      const box = $('periodChips');
      box.replaceChildren();
      [['today', 'আজ'], ['week', 'শেষ ৭ দিন'], ['month', 'এই মাস'], ['all', 'সব']].forEach(([k, t]) => {
        const b = el('button', 'mo-pill' + (period === k ? ' active' : ''), t);
        b.type = 'button';
        b.addEventListener('click', () => { period = k; renderPeriodChips(); loadAccounts(); });
        box.appendChild(b);
      });
    }

    function sumM(rows, key) { return rows.reduce((s, r) => s + Number(r[key] || 0), 0); }

    async function loadAccounts() {
      if (role !== 'admin') return;
      $('accSummary').replaceChildren(el('p', 'mo-muted', 'লোড হচ্ছে...'));
      const start = periodStart();
      let qy = supabase.from('manual_orders').select('*').in('status', ['delivered', 'completed']).order('delivered_at', { ascending: false }).limit(2000);
      if (start) qy = qy.gte('delivered_at', start.toISOString());
      const [o, b] = await Promise.all([qy, supabase.from('manual_rider_balances').select('*').eq('is_active', true).order('name')]);
      if (o.error || b.error) {
        $('accSummary').replaceChildren(el('p', 'mo-muted', 'হিসাব লোড করা যায়নি।'));
        return;
      }
      accRows = o.data || [];
      const rows = accRows;
      const sales = sumM(rows, 'product_price');
      const fee = sumM(rows, 'delivery_fee');
      const pay = sumM(rows, 'rider_pay');
      const adv = sumM(rows, 'advance_amount');
      const cash = sumM(rows, 'cash_collected');

      const sum = el('div', 'mo-sum');
      [['ডেলিভারড অর্ডার', bn(rows.length) + 'টা'], ['প্রোডাক্ট বিক্রি', money(sales)], ['ডেলিভারি ফি', money(fee)], ['রাইডারকে পে', money(pay)], ['অ্যাডভান্স পেয়েছি', money(adv)], ['রাইডার ক্যাশ কালেক্ট', money(cash)]].forEach(([l, v]) => {
        const m = el('div', 'mo-m');
        m.appendChild(el('small', '', l));
        m.appendChild(el('b', '', v));
        sum.appendChild(m);
      });
      const net = el('div', 'mo-m wide');
      net.appendChild(el('small', '', 'নিট ডেলিভারি লাভ (ফি − রাইডার পে)'));
      net.appendChild(el('b', '', money(fee - pay)));
      sum.appendChild(net);
      $('accSummary').replaceChildren(sum);

      // রাইডার ব্যালেন্স
      const rb = $('riderBalances');
      rb.replaceChildren();
      const bal = b.data || [];
      if (!bal.length) rb.appendChild(el('p', 'mo-muted', 'এখনো কোনো রাইডার যোগ করা হয়নি।'));
      bal.forEach((r) => {
        const c = el('div', 'mo-rcard');
        const h = el('div', 'mo-row');
        h.appendChild(el('b', 'mo-cname', r.name));
        if (r.phone) h.appendChild(el('span', 'mo-ono', r.phone));
        c.appendChild(h);
        [['ক্যাশ কালেক্ট করেছে', r.cash_collected], ['আমাদের জমা দিয়েছে', r.deposited], ['এখন হাতে ক্যাশ আছে', r.holds_cash], ['রাইডারের পাওনা (পে + দোকানের টাকা)', r.we_owe], ['এর মধ্যে আমরা দিয়েছি', r.paid_out]].forEach(([l, v]) => {
          const k = el('div', 'mo-kv');
          k.appendChild(el('span', '', l));
          k.appendChild(el('b', '', money(v)));
          c.appendChild(k);
        });
        const n = Number(r.net_rider_owes_us || 0);
        const nt = el('div', 'mo-net ' + (n > 0 ? 'pos' : n < 0 ? 'neg' : 'zero'),
          n > 0 ? 'রাইডারের কাছে আমরা পাব ' + money(n) : n < 0 ? 'আমরা রাইডারকে দেব ' + money(-n) : 'হিসাব মিলে গেছে');
        c.appendChild(nt);
        const bt = el('div', 'mo-btns');
        const b1 = el('button', 'mo-cta', 'জমা নিলাম'); b1.type = 'button';
        b1.addEventListener('click', () => openEntry(r, 'deposit'));
        const b2 = el('button', 'mo-ghost', 'পে দিলাম'); b2.type = 'button';
        b2.addEventListener('click', () => openEntry(r, 'payout'));
        const b3 = el('button', 'mo-ghost', 'ইতিহাস'); b3.type = 'button';
        b3.addEventListener('click', () => openHistory(r));
        bt.appendChild(b1); bt.appendChild(b2); bt.appendChild(b3);
        c.appendChild(bt);
        rb.appendChild(c);
      });

      // কে কয়টা অর্ডার নিয়েছে (সব অর্ডার থেকে, এই সময়ের)
      let eq = supabase.from('manual_orders').select('entered_by').limit(5000);
      if (start) eq = eq.gte('created_at', start.toISOString());
      const e = await eq;
      const eb = $('enteredBy');
      eb.replaceChildren();
      const counts = {};
      (e.data || []).forEach((x) => { const k = x.entered_by || '—'; counts[k] = (counts[k] || 0) + 1; });
      const ids = Object.keys(counts).filter((k) => k !== '—' && !names[k]);
      if (ids.length) {
        try {
          const p = await supabase.from('profiles').select('id, full_name').in('id', ids);
          (p.data || []).forEach((x) => { names[x.id] = x.full_name || ''; });
        } catch (e2) { /* নাম না পেলেও চলবে */ }
      }
      const entries = Object.entries(counts).sort((a, b2) => b2[1] - a[1]);
      if (!entries.length) eb.appendChild(el('p', 'mo-muted', 'এই সময়ে কোনো অর্ডার নেই।'));
      entries.forEach(([k, n]) => {
        const row = el('div', 'mo-kv');
        row.style.padding = '8px 2px';
        row.appendChild(el('span', '', k === '—' ? 'অজানা' : (names[k] || 'অ্যাডমিন/মডারেটর')));
        row.appendChild(el('b', '', bn(n) + 'টা'));
        eb.appendChild(row);
      });
    }

    function openEntry(r, kind) {
      enRider = r;
      enKind = kind;
      $('enTitle').textContent = kind === 'deposit' ? 'জমা নিলাম' : 'পে দিলাম';
      $('enInfo').textContent = kind === 'deposit'
        ? r.name + ' আমাদের হাতে যে ক্যাশ জমা দিয়েছে তার পরিমাণ লিখুন।'
        : r.name + '-কে আমরা যে টাকা দিয়েছি (পে বা দোকানের টাকা ফেরত) তার পরিমাণ লিখুন।';
      $('en_amount').value = '';
      $('en_note').value = '';
      showErr('enErr', '');
      openSheet('enOverlay');
    }
    async function saveEntry() {
      if (busy || !enRider) return;
      if (!window.SFValidateForm($('enSheet'))) return showErr('enErr', 'টাকার পরিমাণ লিখুন।');
      const amt = num($('en_amount').value);
      if (amt <= 0) return showErr('enErr', 'টাকার পরিমাণ ০-এর বেশি হতে হবে।');
      busy = true;
      $('enSave').disabled = true;
      const { error } = await supabase.from('rider_cash_entries').insert({ manual_rider_id: enRider.manual_rider_id, kind: enKind, amount: amt, note: $('en_note').value.trim() || null });
      busy = false;
      $('enSave').disabled = false;
      if (error) return showErr('enErr', 'সেভ হয়নি, আবার চেষ্টা করুন।');
      closeSheet('enOverlay');
      toast('লেনদেন সেভ হয়েছে', 'success');
      await loadAccounts();
    }

    async function openHistory(r) {
      $('hiTitle').textContent = r.name + ' · লেনদেন';
      const box = $('hiList');
      box.replaceChildren(el('p', 'mo-muted', 'লোড হচ্ছে...'));
      openSheet('hiOverlay');
      const { data, error } = await supabase.from('rider_cash_entries').select('*').eq('manual_rider_id', r.manual_rider_id).order('created_at', { ascending: false }).limit(30);
      box.replaceChildren();
      if (error) { box.appendChild(el('p', 'mo-muted', 'লোড করা যায়নি।')); return; }
      if (!data.length) { box.appendChild(el('p', 'mo-muted', 'এখনো কোনো লেনদেন নেই।')); return; }
      data.forEach((x) => {
        const d = new Date(x.created_at);
        const row = el('div', 'mo-hi');
        const left = el('div', '');
        left.appendChild(el('b', '', x.kind === 'deposit' ? 'জমা নিয়েছি' : 'পে দিয়েছি'));
        left.appendChild(el('div', 'mo-line', dateBn(d) + ' ' + timeBn(d) + (x.note ? ' · ' + x.note : '')));
        row.appendChild(left);
        row.appendChild(el('b', '', money(x.amount)));
        box.appendChild(row);
      });
    }

    function downloadCsv() {
      if (!accRows.length) return toast('এই সময়ে কোনো ডেলিভারড অর্ডার নেই', 'error');
      const riderName = (id) => { const r = riders.find((x) => x.id === id); return r ? r.name : ''; };
      const head = ['Order No', 'Delivered At', 'Customer', 'Phone', 'Order', 'Product', 'Delivery Fee', 'Total', 'Advance', 'Cash Collected', 'Rider', 'Rider Pay', 'Entered By'];
      const cell = (v) => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
      const lines = [head.map(cell).join(',')];
      accRows.forEach((o) => {
        lines.push([o.order_no, o.delivered_at ? fmtEn(new Date(o.delivered_at)) : '', o.customer_name, o.customer_phone, o.details, o.product_price, o.delivery_fee, o.total_amount, o.advance_amount, o.cash_collected, riderName(o.manual_rider_id), o.rider_pay, names[o.entered_by] || ''].map(cell).join(','));
      });
      const blob = new Blob(['\ufeff' + lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'manual-orders-' + dateInput(new Date()) + '.csv';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    }

    // ---------- ট্যাব ----------
    function switchTab(t) {
      document.querySelectorAll('#mainTabs .mo-tab').forEach((b) => b.classList.toggle('active', b.dataset.tab === t));
      $('ordersPane').style.display = t === 'orders' ? '' : 'none';
      $('accountsPane').style.display = t === 'accounts' ? '' : 'none';
      if (t === 'accounts') { renderPeriodChips(); loadAccounts(); }
    }

    // ---------- ইনিট ----------
    function wire() {
      $('newOrderBtn').addEventListener('click', () => openOrderForm(null));
      $('orderClose').addEventListener('click', () => closeSheet('orderOverlay'));
      $('saveOrderBtn').addEventListener('click', saveOrder);
      $('delOrderBtn').addEventListener('click', deleteOrder);
      $('dvClose').addEventListener('click', () => closeSheet('dvOverlay'));
      $('dvSave').addEventListener('click', saveDeliver);
      $('rdClose').addEventListener('click', () => closeSheet('rdOverlay'));
      $('rdSave').addEventListener('click', saveRider);
      $('enClose').addEventListener('click', () => closeSheet('enOverlay'));
      $('enSave').addEventListener('click', saveEntry);
      $('hiClose').addEventListener('click', () => closeSheet('hiOverlay'));
      $('addRiderBtn').addEventListener('click', () => openRiderSheet(null));
      $('csvBtn').addEventListener('click', downloadCsv);
      ['f_price', 'f_fee', 'f_adv', 'f_pay'].forEach((id) => $(id).addEventListener('input', updateCalc));
      $('f_asap').addEventListener('change', syncAsap);
      $('f_phone').addEventListener('blur', checkDup);
      $('aiBtn').addEventListener('click', aiFill);
      $('f_status').addEventListener('change', () => { $('cancelGroup').style.display = $('f_status').value === 'cancelled' ? '' : 'none'; });
      $('f_rider').addEventListener('change', () => {
        if ($('f_rider').value === '__new') {
          $('f_rider').value = '';
          openRiderSheet((r) => { fillRiderSelect(r.id); });
        }
      });
      let t = null;
      $('searchIn').addEventListener('input', (e) => {
        clearTimeout(t);
        t = setTimeout(() => { q = e.target.value.trim(); renderOrders(); }, 200);
      });
      document.querySelectorAll('#mainTabs .mo-tab').forEach((b) => b.addEventListener('click', () => switchTab(b.dataset.tab)));
      document.querySelectorAll('.mo-overlay').forEach((ov) => ov.addEventListener('click', (e) => { if (e.target === ov) ov.classList.remove('active'); }));
      // প্রতি ১৫ সেকেন্ডে রিফ্রেশ (কোনো শিট খোলা না থাকলে)
      setInterval(() => { if (!document.hidden && !anyOpen() && $('ordersPane').style.display !== 'none') loadOrders(); }, 15000);
    }

    initAdminGuard();
    window.addEventListener('smartfeni:admin-ready', async (e) => {
      role = e.detail.role;
      userId = e.detail.profile ? e.detail.profile.id : null;
      if (role === 'admin') $('accountsTabBtn').style.display = '';
      wire();
      await loadOrders();
    }, { once: true });
  </script>
</BaseLayout>
