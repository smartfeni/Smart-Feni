    .mo-in:focus { outline: 0; border-color: #FF6B35; }
    textarea.mo-in { resize: vertical; }
    .mo-lbl { display: block; margin: 12px 0 4px; font-size: 12.5px; font-weight: 600; color: #5B6B86; }
    .mo-sec { margin: 20px 0 0; padding-top: 10px; border-top: 1px solid #EEF2F8; font-size: 14px; font-weight: 700; color: #FF6B35; }
    .mo-two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .mo-check { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 14.5px; font-weight: 600; }
    .mo-check input { width: 20px; height: 20px; accent-color: #FF6B35; }

    .mo-chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 2px; -webkit-overflow-scrolling: touch; }
    .mo-pill { flex: none; height: 40px; border: 1.5px solid #D5DCE8; border-radius: 20px; background: #fff; padding: 0 14px; font-size: 14px; font-weight: 700; color: #1B2A4A; cursor: pointer; white-space: nowrap; }
    .mo-pill.active { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
    .mo-pill b { color: #FF6B35; margin-left: 4px; }
    .mo-pill.active b { color: #FFB899; }
    .mo-summary { font-size: 13.5px; color: #5B6B86; padding: 0 2px; }

    .mo-card { background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(27, 42, 74, 0.08); padding: 14px; display: flex; flex-direction: column; gap: 10px; border-left: 6px solid #D5DCE8; }
    .mo-card.soon { border-left-color: #F59E0B; }
    .mo-card.late { border-left-color: #D92D20; }
    .mo-card.done { opacity: 0.8; border-left-color: #14A44D; }
    .mo-card.cancelled { opacity: 0.6; border-left-color: #B7C2D8; }
    .mo-top { }
    .mo-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .mo-time { font-size: 19px; font-weight: 700; }
    .mo-ono { margin-left: auto; font-size: 12.5px; font-weight: 700; color: #5B6B86; }
    .mo-cname { font-size: 17px; font-weight: 700; }
    .mo-line { font-size: 14px; color: #3A4A66; line-height: 1.45; word-break: break-word; }
    .mo-line a { color: #0B63CE; font-weight: 600; text-decoration: none; }
    .mo-lab { color: #5B6B86; font-weight: 600; }
    .mo-chip { display: inline-flex; align-items: center; gap: 4px; border-radius: 999px; padding: 3px 10px; font-size: 12.5px; font-weight: 700; background: #EEF2F8; color: #1B2A4A; }
    .mo-chip.green { background: #E8F7EE; color: #14693A; }
    .mo-chip.yel { background: #FFF1C9; color: #6B4A00; }
    .mo-chip.red { background: #FDECEA; color: #B3261E; }
    .mo-chip.blue { background: #DCE8FB; color: #0B3D91; }
    .mo-money { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .mo-m { background: #F8FAFC; border-radius: 12px; padding: 8px 6px; text-align: center; }
    .mo-m small { display: block; font-size: 11.5px; font-weight: 600; color: #5B6B86; }
    .mo-m b { font-size: 16px; }
    .mo-m.cash { background: #FFF1E8; }
    .mo-m.cash b { color: #C2410C; }
    .mo-btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .mo-btns .mo-cta { flex: 1; min-width: 140px; }
    .mo-btns .mo-ghost { height: 44px; }

    .mo-ai { margin-top: 10px; background: #FFF6F1; border: 1.5px dashed #FF6B35; border-radius: 16px; padding: 4px 12px 12px; }
    .mo-ai-btn { width: 100%; margin-top: 8px; }
    .mo-ai-status { margin: 8px 2px 0; font-size: 13.5px; font-weight: 600; color: #14693A; }
    .mo-ai-status.bad { color: #B3261E; }
    .mo-calc { margin-top: 12px; background: #F1F5F9; border-radius: 14px; padding: 10px 14px; display: grid; gap: 4px; font-size: 14px; }
    .mo-calc div { display: flex; justify-content: space-between; gap: 8px; }
    .mo-calc .big { font-weight: 700; color: #C2410C; font-size: 15.5px; }
    .mo-warn { margin: 8px 0 0; font-size: 13.5px; font-weight: 600; color: #8A5A00; background: #FFF1C9; border-radius: 12px; padding: 8px 12px; }
    .mo-err { margin: 12px 0 0; font-size: 14px; font-weight: 600; color: #B3261E; }

    .mo-overlay { position: fixed; inset: 0; z-index: 1050; background: rgba(27, 42, 74, 0.5); display: none; align-items: flex-end; justify-content: center; }
    .mo-overlay.mo-top { z-index: 1060; }
    .mo-overlay.active { display: flex; }
    .mo-sheet { position: relative; width: 100%; max-width: 560px; max-height: 92vh; overflow-y: auto; background: #fff; border-radius: 28px 28px 0 0; padding: 10px 20px calc(24px + env(safe-area-inset-bottom, 0px)); box-shadow: 0 -6px 24px rgba(27, 42, 74, 0.12); }
    .mo-grip { width: 44px; height: 5px; border-radius: 3px; background: #D5DCE8; margin: 2px auto 8px; }
    .mo-sheet-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .mo-sheet-h h2 { margin: 0; font-size: 21px; font-weight: 700; color: #1B2A4A; }
    .mo-x { width: 44px; height: 44px; border-radius: 22px; border: 0; background: #F1F5F9; color: #1B2A4A; cursor: pointer; font-size: 16px; }
    .mo-actions { display: flex; gap: 8px; margin-top: 16px; }
    .mo-actions .mo-cta { flex: 1; height: 48px; font-size: 16px; }
    .mo-actions .mo-ghost { height: 48px; }

    .mo-sum { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .mo-sum .mo-m { background: #fff; box-shadow: 0 2px 10px rgba(27, 42, 74, 0.07); padding: 12px 8px; }
    .mo-sum .mo-m.wide { grid-column: 1 / -1; background: #E8F7EE; }
    .mo-sum .mo-m.wide b { color: #14693A; font-size: 20px; }
    .mo-rcard { background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(27, 42, 74, 0.08); padding: 14px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
    .mo-kv { display: flex; justify-content: space-between; gap: 8px; font-size: 14px; }
    .mo-kv span:first-child { color: #5B6B86; }
    .mo-net { border-radius: 12px; padding: 10px 12px; font-weight: 700; font-size: 15px; }
    .mo-net.pos { background: #FFF1E8; color: #C2410C; }
    .mo-net.neg { background: #DCE8FB; color: #0B3D91; }
    .mo-net.zero { background: #E8F7EE; color: #14693A; }
    .mo-hi { display: flex; justify-content: space-between; gap: 8px; padding: 10px 0; border-top: 1px solid #EEF2F8; font-size: 14px; }

    @media (max-width: 380px) {
      .mo-two { grid-template-columns: 1fr; }
      .mo-money { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';

    const $ = (id) => document.getElementById(id);
    const BN = '০১২৩৪৫৬৭৮৯';
    const bn = (v) => String(v).replace(/\d/g, (d) => BN[d]);
    const num = (v) => { const n = parseFloat(v); return Number.isFinite(n) ? n : 0; };
    const money = (n) => '৳' + bn(Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }));
    const toast = (m, t) => { if (window.showToast) window.showToast(m, t); };

    const ACTIVE_OFF = ['delivered', 'completed', 'cancelled'];
    const STATUS = {
      new: { t: 'নতুন', c: 'yel' },
      rider_assigned: { t: 'রাইডার ঠিক', c: '' },
      picked_up: { t: 'পিকআপ হয়েছে', c: 'blue' },
      delivered: { t: 'ডেলিভারড', c: 'green' },
      completed: { t: 'সম্পন্ন', c: 'green' },
      cancelled: { t: 'বাতিল', c: 'red' },
    };
    const ADV_METHOD = { bkash: 'bKash', nagad: 'নগদ', rocket: 'রকেট', bank: 'ব্যাংক', cash_office: 'অফিসে ক্যাশ', other: 'অন্য' };

    let role = null;
    let userId = null;
    let active = [];
    let done = [];
    let riders = [];
    let names = {};
    let view = 'today';
    let q = '';
    let editing = null;
    let dvOrder = null;
    let enRider = null;
    let enKind = 'deposit';
    let rdCallback = null;
    let period = 'today';
    let accRows = [];
    let busy = false;

    function el(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    }
    function openSheet(id) { $(id).classList.add('active'); }
    function closeSheet(id) { $(id).classList.remove('active'); }
    function anyOpen() { return !!document.querySelector('.mo-overlay.active'); }
    function showErr(id, text) {
      const e = $(id);
      if (!text) { e.style.display = 'none'; return; }
      e.textContent = text;
      e.style.display = 'block';
      toast(text, 'error');
    }

    // ---------- তারিখ/সময় ----------
    function period12(h) {
      if (h < 4) return 'রাত';
      if (h < 6) return 'ভোর';
      if (h < 12) return 'সকাল';
      if (h < 15) return 'দুপুর';
      if (h < 18) return 'বিকাল';
      if (h < 20) return 'সন্ধ্যা';
      return 'রাত';
    }
    // সব সময় বাংলাদেশ টাইম (Asia/Dhaka, UTC+6, DST নেই) — ভিউয়ার ডুবাই/পর্তুগাল/সৌদি যেখানেই থাকুক
    const BD_OFFSET_MS = 6 * 3600000;
    function bdp(d) {
      const x = new Date(d.getTime() + BD_OFFSET_MS);
      return { y: x.getUTCFullYear(), m: x.getUTCMonth() + 1, d: x.getUTCDate(), h: x.getUTCHours(), mi: x.getUTCMinutes() };
    }
    function timeBn(d) {
      const p = bdp(d);
      return period12(p.h) + ' ' + bn(p.h % 12 || 12) + ':' + bn(String(p.mi).padStart(2, '0'));
    }
    function dateBn(d) { const p = bdp(d); return bn(p.d) + '/' + bn(p.m) + '/' + bn(p.y); }
    function bdDayNum(d) { return Math.floor((d.getTime() + BD_OFFSET_MS) / 86400000); }
    function startOfDay(d) { return new Date(bdDayNum(d) * 86400000 - BD_OFFSET_MS); }
    function dayDiff(d) { return bdDayNum(d) - bdDayNum(new Date()); }
    function dayLabel(d) {
      const k = dayDiff(d);
      if (k === 0) return 'আজ';
      if (k === 1) return 'আগামীকাল';
      if (k === -1) return 'গতকাল';
      return dateBn(d);
    }
    function fmtEn(d) {
      const p = bdp(d);
      return String(p.d).padStart(2, '0') + '/' + String(p.m).padStart(2, '0') + '/' + p.y + ', ' + (p.h % 12 || 12) + ':' + String(p.mi).padStart(2, '0') + ' ' + (p.h < 12 ? 'AM' : 'PM') + ' (BD time)';
    }
    function fmtDur(min) {
      const m = Math.round(Math.abs(min));
      if (m < 60) return bn(m) + ' মিনিট';
      return bn(Math.floor(m / 60)) + ' ঘণ্টা' + (m % 60 ? ' ' + bn(m % 60) + ' মিনিট' : '');
    }
    function dateInput(d) { const p = bdp(d); return p.y + '-' + String(p.m).padStart(2, '0') + '-' + String(p.d).padStart(2, '0'); }
    function timeInput(d) { const p = bdp(d); return String(p.h).padStart(2, '0') + ':' + String(p.mi).padStart(2, '0'); }

    // ---------- ফোন/লিংক ----------
    function waNumber(p) {
      let d = String(p || '').replace(/\D/g, '');
      if (d.startsWith('880')) return d;
      if (d.startsWith('0')) return '88' + d;
      return d ? '880' + d : '';
    }
    function safeLink(u) { return typeof u === 'string' && /^https?:\/\//i.test(u.trim()) ? u.trim() : null; }
    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        toast('কপি হয়েছে', 'success');
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); toast('কপি হয়েছে', 'success'); } catch (e2) { toast('কপি করা যায়নি', 'error'); }
        ta.remove();
      }
    }

    // ---------- কপি-মেসেজ (Excel টেমপ্লেটের মতো) ----------
    function riderOf(o) { return riders.find((r) => r.id === o.manual_rider_id) || null; }
    function riderMsg(o) {
      const lines = [
        '*New Delivery Order #' + o.order_no + '*',
        'Customer: ' + o.customer_name,
        'Phone: ' + o.customer_phone,
        'Delivery Time: ' + (o.is_asap ? 'ASAP, ' : '') + fmtEn(new Date(o.scheduled_at)) + (o.is_strict_time ? ' (MUST)' : ''),
        'Drop-off: ' + o.drop_address,
      ];
      if (o.drop_map_link) lines.push('Map: ' + o.drop_map_link);
      if (o.pickup_name) lines.push('Pickup: ' + o.pickup_name);
      if (o.pickup_map_link) lines.push('Pickup Map: ' + o.pickup_map_link);
      lines.push('Order: ' + o.details);
      lines.push('Product Price: BDT ' + o.product_price);
      lines.push('Collect Cash: BDT ' + o.cod_amount + (Number(o.cod_amount) === 0 ? ' (advance paid)' : ''));
      lines.push('Your Pay: BDT ' + o.rider_pay);
      return lines.join('\n');
    }
    function customerMsg(o) {
      const lines = [
        '*Order Confirmation #' + o.order_no + '*',
        'Name: ' + o.customer_name,
        'Phone: ' + o.customer_phone,
        'Delivery Date & Time: ' + fmtEn(new Date(o.scheduled_at)),
      ];
      if (o.pickup_name) lines.push('Pickup From: ' + o.pickup_name);
      lines.push('Deliver To: ' + o.drop_address);
      lines.push('Order: ' + o.details);
      lines.push('Product Price: BDT ' + o.product_price);
      lines.push('Delivery Charge: BDT ' + o.delivery_fee);
      lines.push('Total: BDT ' + o.total_amount);
      if (Number(o.advance_amount) > 0) lines.push('Advance Received: BDT ' + o.advance_amount);
      lines.push('Cash on Delivery: BDT ' + o.cod_amount);
      return lines.join('\n');
    }

    // ---------- ডেটা লোড ----------
    async function loadOrders() {
      const [a, d, r] = await Promise.all([
        supabase.from('manual_orders').select('*').not('status', 'in', '(delivered,completed,cancelled)').order('scheduled_at', { ascending: true }).limit(500),
        supabase.from('manual_orders').select('*').in('status', ['delivered', 'completed', 'cancelled']).order('scheduled_at', { ascending: false }).limit(100),
        supabase.from('manual_riders').select('*').eq('is_active', true).order('name'),
      ]);
      if (a.error || d.error || r.error) {
        $('orderList').replaceChildren(el('p', 'mo-muted', 'লোড করা যায়নি, আবার চেষ্টা করুন।'));
        return;
      }
      active = a.data || [];
      done = d.data || [];
      riders = r.data || [];
      const ids = [...new Set([...active, ...done].map((o) => o.entered_by).filter(Boolean))].filter((id) => !names[id]);
      if (ids.length) {
        try {
          const p = await supabase.from('profiles').select('id, full_name').in('id', ids);
          (p.data || []).forEach((x) => { names[x.id] = x.full_name || ''; });
        } catch (e) { /* নাম না পেলেও চলবে */ }
      }
      renderOrders();
    }

    function matches(o) {
      if (!q) return true;
      const s = q.toLowerCase();
      return [o.customer_name, o.customer_phone, o.order_no, o.drop_address, o.details, o.pickup_name]
        .some((x) => String(x || '').toLowerCase().includes(s));
    }

    function bucketOf(o) { const k = dayDiff(new Date(o.scheduled_at)); return k <= 0 ? 'today' : k === 1 ? 'tomorrow' : 'later'; }

    function renderOrders() {
      const act = active.filter(matches);
      const counts = {
        today: active.filter((o) => bucketOf(o) === 'today').length,
        tomorrow: active.filter((o) => bucketOf(o) === 'tomorrow').length,
        later: active.filter((o) => bucketOf(o) === 'later').length,
        norider: active.filter((o) => !o.manual_rider_id).length,
        done: done.length,
      };
      const defs = [['today', 'আজ'], ['tomorrow', 'আগামীকাল'], ['later', 'পরে'], ['norider', 'রাইডার নেই'], ['done', 'শেষ']];
      const chips = $('viewChips');
      chips.replaceChildren();
      defs.forEach(([k, t]) => {
        const b = el('button', 'mo-pill' + (view === k ? ' active' : ''));
        b.type = 'button';
        b.appendChild(document.createTextNode(t));
        b.appendChild(el('b', '', bn(counts[k])));
        b.addEventListener('click', () => { view = k; renderOrders(); });
        chips.appendChild(b);
      });

      const unassignedToday = active.filter((o) => bucketOf(o) === 'today' && !o.manual_rider_id).length;
      const cashPending = active.reduce((s, o) => s + Number(o.cod_amount || 0), 0);
      $('summaryLine').textContent = 'চলমান ' + bn(active.length) + 'টা · ক্যাশ আসবে ' + money(cashPending) + (unassignedToday ? ' · আজ রাইডার নেই ' + bn(unassignedToday) + 'টায়' : '');

      let list;
      if (view === 'done') list = done.filter(matches);
      else if (view === 'norider') list = act.filter((o) => !o.manual_rider_id);
      else list = act.filter((o) => bucketOf(o) === view);

      const box = $('orderList');
      box.replaceChildren();
      if (!list.length) {
        box.appendChild(el('p', 'mo-muted', q ? 'কিছু পাওয়া যায়নি।' : 'কোনো অর্ডার নেই।'));
        return;
      }
      const wrap = el('div', '');
      wrap.style.display = 'flex';
      wrap.style.flexDirection = 'column';
      wrap.style.gap = '12px';
      list.forEach((o) => wrap.appendChild(renderCard(o)));
      box.appendChild(wrap);
    }

    function renderCard(o) {
      const isActive = !ACTIVE_OFF.includes(o.status);
      const sched = new Date(o.scheduled_at);
      const diffMin = (sched.getTime() - Date.now()) / 60000;
      const card = el('div', 'mo-card');
      let urgencyChip = null;
      if (isActive) {
        if (!o.is_asap && diffMin < 0) { card.classList.add('late'); urgencyChip = el('span', 'mo-chip red', 'দেরি ' + fmtDur(diffMin)); }
        else if (!o.is_asap && diffMin <= 60) { card.classList.add('soon'); urgencyChip = el('span', 'mo-chip yel', fmtDur(diffMin) + ' বাকি'); }
      } else if (o.status === 'cancelled') card.classList.add('cancelled');
      else card.classList.add('done');

      const top = el('div', 'mo-row');
      top.appendChild(el('span', 'mo-time', o.is_asap ? 'এখনই · ' + dayLabel(sched) : dayLabel(sched) + ' · ' + timeBn(sched) + ' (BD)'));
      top.appendChild(el('span', 'mo-ono', o.order_no));
      card.appendChild(top);

      const chips = el('div', 'mo-row');
      const st = STATUS[o.status] || { t: o.status, c: '' };
      chips.appendChild(el('span', 'mo-chip ' + st.c, st.t));
