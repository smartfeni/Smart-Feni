---
// path: src/pages/admin/manual-orders.astro
// ============================================================
// পেজ: ম্যানুয়াল অর্ডার (/admin/manual-orders) — সব সময় বাংলাদেশ টাইম (Asia/Dhaka, UTC+6)
// ফেসবুক পেজ/মেসেজ থেকে আসা অর্ডার অ্যাডমিন প্যানেল থেকে ইনপুট দিয়ে সামলানোর জন্য।
// ট্যাব ১ "অর্ডার": ডেলিভারির সময় অনুযায়ী সিরিয়াল (আজ / আগামীকাল / পরে / রাইডার নেই / শেষ),
//   নতুন অর্ডার ফর্ম, স্ট্যাটাস বাটন (রাইডার ঠিক → পিকআপ → ডেলিভারড), কপি-মেসেজ, WhatsApp।
// ট্যাব ২ "হিসাব" (শুধু admin): বিক্রি, ডেলিভারি ফি, রাইডার পে, নিট লাভ, অ্যাডভান্স, ক্যাশ কালেক্ট,
//   রাইডারের হাতে ক্যাশ, "জমা নিলাম"/"পে দিলাম" লেনদেন, CSV এক্সপোর্ট।
// টেবিল: manual_orders, manual_riders, rider_cash_entries (শুধু যোগ), ভিউ manual_rider_balances
// RLS: অর্ডার/রাইডার = admin + moderator (অস্থায়ী, পরে has_permission); হিসাব = শুধু has_permission (ডিফল্টে admin)
// অটো-ফিল: নতুন অর্ডার ফর্মে ফেসবুক মেসেজ পেস্ট করলে /api/admin/parse-manual-order (Gemini) ফর্মের ঘর ভরে দেয়;
//   মানুষ মিলিয়ে সেভ করে। মেসেজ কোথাও সেভ হয় না।
// ইউজারের লেখা সব টেক্সট textContent দিয়ে বসানো (innerHTML-এ নয়)।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="ম্যানুয়াল অর্ডার | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="mo-page">

    <div id="adminLoadingState" class="mo-loading">
      <div class="mo-spinner"></div>
      <p>যাচাই করা হচ্ছে...</p>
    </div>

    <div id="adminGuardedContent" style="display:none;">

      <!-- ===== নেভি হেডার ===== -->
      <div class="mo-head">
        <div class="mo-head-in">
          <a href="/" class="mo-round" aria-label="হোমে ফিরুন"><i class="fas fa-arrow-left"></i></a>
          <h1 class="mo-title">ম্যানুয়াল অর্ডার</h1>
          <button type="button" class="mo-cta mo-cta-sm" id="newOrderBtn">+ নতুন অর্ডার</button>
        </div>
        <div class="mo-tabs" id="mainTabs">
          <button type="button" class="mo-tab active" data-tab="orders">অর্ডার</button>
          <button type="button" class="mo-tab" data-tab="accounts" id="accountsTabBtn" style="display:none;">হিসাব</button>
        </div>
      </div>

      <!-- ===== ট্যাব ১: অর্ডার ===== -->
      <div class="mo-body" id="ordersPane">
        <div class="mo-summary" id="summaryLine"></div>
        <label class="mo-field mo-search">
          <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
          <input id="searchIn" type="search" placeholder="নাম, ফোন, অর্ডার নম্বর বা ঠিকানা" autocomplete="off" aria-label="অর্ডার খুঁজুন" />
        </label>
        <div class="mo-chips" id="viewChips"></div>
        <div id="orderList"><p class="mo-muted">লোড হচ্ছে...</p></div>
      </div>

      <!-- ===== ট্যাব ২: হিসাব (শুধু admin) ===== -->
      <div class="mo-body" id="accountsPane" style="display:none;">
        <div class="mo-chips" id="periodChips"></div>
        <div id="accSummary"></div>
        <div class="mo-h">রাইডারের হিসাব</div>
        <div id="riderBalances"></div>
        <button type="button" class="mo-add" id="addRiderBtn">+ নতুন রাইডার যোগ করুন</button>
        <div class="mo-h">কে কয়টা অর্ডার নিয়েছে</div>
        <div id="enteredBy"></div>
        <button type="button" class="mo-ghost" id="csvBtn" style="width:100%;">এই সময়ের অর্ডার CSV ডাউনলোড</button>
      </div>

      <!-- ===== অর্ডার ফর্ম (নিচের শিট) ===== -->
      <div class="mo-overlay" id="orderOverlay">
        <div class="mo-sheet" role="dialog" aria-label="অর্ডারের তথ্য" id="orderForm">
          <div class="mo-grip"></div>
          <div class="mo-sheet-h">
            <h2 id="orderFormTitle">নতুন অর্ডার</h2>
            <button type="button" class="mo-x" id="orderClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
          </div>

          <div class="mo-ai" id="aiBox">
            <label class="mo-lbl" for="aiText" style="margin-top:8px;">ফেসবুক মেসেজ পেস্ট করুন (অটো-ফিল)</label>
            <textarea class="mo-in" id="aiText" rows="4" maxlength="4000" placeholder="কাস্টমারের মেসেজ এখানে পেস্ট করুন, নাম/ফোন/ঠিকানা/সময় নিজে বসে যাবে"></textarea>
            <button type="button" class="mo-cta mo-ai-btn" id="aiBtn">✨ অটো-ফিল করুন</button>
            <p class="mo-ai-status" id="aiStatus" style="display:none;"></p>
          </div>
          <div class="mo-sec">কাস্টমার</div>
          <label class="mo-lbl" for="f_name">কাস্টমারের নাম<span class="required-mark">*</span></label>
          <input class="mo-in" id="f_name" maxlength="120" required />
          <div class="field-error-msg" data-error-for="f_name"><i class="fas fa-circle-exclamation"></i><span>নাম লিখুন</span></div>

          <label class="mo-lbl" for="f_phone">ফোন নম্বর<span class="required-mark">*</span></label>
          <input class="mo-in" id="f_phone" type="tel" inputmode="tel" maxlength="30" required />
          <div class="field-error-msg" data-error-for="f_phone"><i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর লিখুন</span></div>
          <p class="mo-warn" id="dupWarn" style="display:none;"></p>

          <label class="mo-lbl" for="f_addr">ড্রপ ঠিকানা<span class="required-mark">*</span></label>
          <textarea class="mo-in" id="f_addr" rows="2" maxlength="500" required></textarea>
          <div class="field-error-msg" data-error-for="f_addr"><i class="fas fa-circle-exclamation"></i><span>ঠিকানা লিখুন</span></div>

          <label class="mo-lbl" for="f_dmap">ড্রপ ম্যাপ লিংক (ঐচ্ছিক)</label>
          <input class="mo-in" id="f_dmap" maxlength="500" placeholder="https://maps.google.com/..." />

          <div class="mo-sec">পিকআপ ও অর্ডার</div>
          <label class="mo-lbl" for="f_pname">পিকআপ কোথা থেকে (দোকান/জায়গা)</label>
          <input class="mo-in" id="f_pname" maxlength="200" placeholder="যেমন: KFC" />

          <label class="mo-lbl" for="f_pmap">পিকআপ ম্যাপ লিংক (ঐচ্ছিক)</label>
          <input class="mo-in" id="f_pmap" maxlength="500" />

          <label class="mo-lbl" for="f_details">অর্ডারের বিবরণ<span class="required-mark">*</span></label>
          <textarea class="mo-in" id="f_details" rows="3" maxlength="2000" required></textarea>
          <div class="field-error-msg" data-error-for="f_details"><i class="fas fa-circle-exclamation"></i><span>বিবরণ লিখুন</span></div>

          <div class="mo-sec">ডেলিভারি কখন চায় (বাংলাদেশ সময়)</div>
          <div class="mo-two">
            <div>
              <label class="mo-lbl" for="f_date">তারিখ<span class="required-mark">*</span></label>
              <input class="mo-in" id="f_date" type="date" required />
              <div class="field-error-msg" data-error-for="f_date"><i class="fas fa-circle-exclamation"></i><span>তারিখ দিন</span></div>
            </div>
            <div>
              <label class="mo-lbl" for="f_time">সময়<span class="required-mark" id="timeStar">*</span></label>
              <input class="mo-in" id="f_time" type="time" required />
              <div class="field-error-msg" data-error-for="f_time"><i class="fas fa-circle-exclamation"></i><span>সময় দিন</span></div>
            </div>
          </div>
          <label class="mo-check"><input type="checkbox" id="f_asap" /> যত দ্রুত সম্ভব (সময় ঠিক করা নেই)</label>
          <label class="mo-check"><input type="checkbox" id="f_strict" /> ঠিক এই সময়েই লাগবে (মাস্ট)</label>

          <div class="mo-sec">টাকার হিসাব</div>
          <div class="mo-two">
            <div>
              <label class="mo-lbl" for="f_price">প্রোডাক্ট প্রাইস (৳)</label>
              <input class="mo-in" id="f_price" type="number" inputmode="decimal" min="0" step="any" placeholder="0" />
            </div>
            <div>
              <label class="mo-lbl" for="f_fee">ডেলিভারি ফি (৳)<span class="required-mark">*</span></label>
              <input class="mo-in" id="f_fee" type="number" inputmode="decimal" min="0" step="any" placeholder="0" required />
              <div class="field-error-msg" data-error-for="f_fee"><i class="fas fa-circle-exclamation"></i><span>ডেলিভারি ফি দিন (নাই হলে ০)</span></div>
            </div>
          </div>
          <div class="mo-two">
            <div>
              <label class="mo-lbl" for="f_adv">অ্যাডভান্স পেয়েছি (৳)</label>
              <input class="mo-in" id="f_adv" type="number" inputmode="decimal" min="0" step="any" placeholder="0" />
            </div>
            <div>
              <label class="mo-lbl" for="f_advm">কিসে পেয়েছি</label>
              <select class="mo-in" id="f_advm">
                <option value="">—</option>
                <option value="bkash">bKash</option>
                <option value="nagad">নগদ</option>
                <option value="rocket">রকেট</option>
                <option value="bank">ব্যাংক</option>
                <option value="cash_office">অফিসে ক্যাশ</option>
                <option value="other">অন্য</option>
              </select>
            </div>
          </div>
          <label class="mo-lbl" for="f_trx">TrxID (ঐচ্ছিক)</label>
          <input class="mo-in" id="f_trx" maxlength="60" />

          <div class="mo-calc" id="calcBox"></div>
          <p class="mo-err" id="advErr" style="display:none;"></p>

          <div class="mo-sec">রাইডার ও দোকানের টাকা</div>
          <label class="mo-lbl" for="f_rider">রাইডার</label>
          <select class="mo-in" id="f_rider"></select>

          <label class="mo-lbl" for="f_pay">রাইডারকে পে (৳)</label>
          <input class="mo-in" id="f_pay" type="number" inputmode="decimal" min="0" step="any" placeholder="0" />

          <label class="mo-lbl" for="f_shop">দোকানের টাকা কে দেবে</label>
          <select class="mo-in" id="f_shop">
            <option value="rider">রাইডার নিজের টাকায় কিনবে (পরে ফেরত দেব)</option>
            <option value="admin">আমরা আগেই দোকানে দিয়েছি</option>
            <option value="none">প্রযোজ্য নয় (শুধু কুরিয়ার)</option>
          </select>

          <label class="mo-lbl" for="f_cost">দোকানকে আসলে কত দিতে হবে (৳, প্রাইসের থেকে আলাদা হলে)</label>
          <input class="mo-in" id="f_cost" type="number" inputmode="decimal" min="0" step="any" placeholder="খালি রাখলে প্রোডাক্ট প্রাইসই ধরা হবে" />

          <label class="mo-lbl" for="f_note">অভ্যন্তরীণ নোট (ঐচ্ছিক)</label>
          <textarea class="mo-in" id="f_note" rows="2" maxlength="1000"></textarea>

          <div id="statusGroup" style="display:none;">
            <label class="mo-lbl" for="f_status">স্ট্যাটাস</label>
            <select class="mo-in" id="f_status">
              <option value="new">নতুন</option>
              <option value="rider_assigned">রাইডার ঠিক</option>
              <option value="picked_up">পিকআপ হয়েছে</option>
              <option value="delivered">ডেলিভারড</option>
              <option value="cancelled">বাতিল</option>
            </select>
            <div id="cancelGroup" style="display:none;">
              <label class="mo-lbl" for="f_cancel">বাতিলের কারণ</label>
              <input class="mo-in" id="f_cancel" maxlength="300" />
            </div>
          </div>

          <p class="mo-err" id="formErr" style="display:none;"></p>
          <div class="mo-actions">
            <button class="mo-cta" id="saveOrderBtn" type="button">অর্ডার সেভ করুন</button>
            <button class="mo-ghost mo-red" id="delOrderBtn" type="button" style="display:none;">ডিলিট</button>
          </div>
        </div>
      </div>

      <!-- ===== ডেলিভারড শিট ===== -->
      <div class="mo-overlay" id="dvOverlay">
        <div class="mo-sheet" role="dialog" aria-label="ডেলিভারড" id="dvSheet">
          <div class="mo-grip"></div>
          <div class="mo-sheet-h">
            <h2>ডেলিভারড করুন</h2>
            <button type="button" class="mo-x" id="dvClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
          </div>
          <p class="mo-muted" id="dvInfo"></p>
          <label class="mo-lbl" for="dv_cash">রাইডার আসলে কত ক্যাশ কালেক্ট করেছে (৳)</label>
          <input class="mo-in" id="dv_cash" type="number" inputmode="decimal" min="0" step="any" />
          <p class="mo-err" id="dvErr" style="display:none;"></p>
          <div class="mo-actions">
            <button class="mo-cta" id="dvSave" type="button">ডেলিভারড নিশ্চিত করুন</button>
          </div>
        </div>
      </div>

      <!-- ===== রাইডার যোগ শিট ===== -->
      <div class="mo-overlay mo-top" id="rdOverlay">
        <div class="mo-sheet" role="dialog" aria-label="নতুন রাইডার" id="rdSheet">
          <div class="mo-grip"></div>
          <div class="mo-sheet-h">
            <h2>নতুন রাইডার</h2>
            <button type="button" class="mo-x" id="rdClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
          </div>
          <label class="mo-lbl" for="rd_name">রাইডারের নাম<span class="required-mark">*</span></label>
          <input class="mo-in" id="rd_name" maxlength="80" required />
          <div class="field-error-msg" data-error-for="rd_name"><i class="fas fa-circle-exclamation"></i><span>নাম লিখুন</span></div>
          <label class="mo-lbl" for="rd_phone">ফোন</label>
          <input class="mo-in" id="rd_phone" type="tel" inputmode="tel" maxlength="30" />
          <p class="mo-err" id="rdErr" style="display:none;"></p>
          <div class="mo-actions">
            <button class="mo-cta" id="rdSave" type="button">রাইডার সেভ করুন</button>
          </div>
        </div>
      </div>

      <!-- ===== জমা/পে শিট ===== -->
      <div class="mo-overlay" id="enOverlay">
        <div class="mo-sheet" role="dialog" aria-label="লেনদেন" id="enSheet">
          <div class="mo-grip"></div>
          <div class="mo-sheet-h">
            <h2 id="enTitle">লেনদেন</h2>
            <button type="button" class="mo-x" id="enClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
          </div>
          <p class="mo-muted" id="enInfo"></p>
          <label class="mo-lbl" for="en_amount">টাকার পরিমাণ (৳)<span class="required-mark">*</span></label>
          <input class="mo-in" id="en_amount" type="number" inputmode="decimal" min="0" step="any" required />
          <div class="field-error-msg" data-error-for="en_amount"><i class="fas fa-circle-exclamation"></i><span>টাকার পরিমাণ দিন</span></div>
          <label class="mo-lbl" for="en_note">নোট (ঐচ্ছিক)</label>
          <input class="mo-in" id="en_note" maxlength="300" />
          <p class="mo-err" id="enErr" style="display:none;"></p>
          <div class="mo-actions">
            <button class="mo-cta" id="enSave" type="button">সেভ করুন</button>
          </div>
        </div>
      </div>

      <!-- ===== লেনদেনের ইতিহাস শিট ===== -->
      <div class="mo-overlay" id="hiOverlay">
        <div class="mo-sheet" role="dialog" aria-label="লেনদেনের ইতিহাস" id="hiSheet">
          <div class="mo-grip"></div>
          <div class="mo-sheet-h">
            <h2 id="hiTitle">লেনদেনের ইতিহাস</h2>
            <button type="button" class="mo-x" id="hiClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
          </div>
          <div id="hiList"></div>
        </div>
      </div>

    </div>
  </div>

  <style is:global>
    .mo-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; min-height: 60vh; padding-bottom: 90px; overflow-x: hidden; background: #F8FAFC; }
    .mo-page * { box-sizing: border-box; }
    .mo-page button, .mo-page input, .mo-page select, .mo-page textarea { font-family: inherit; }
    .mo-loading { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 120px 0; color: #5B6B86; font-weight: 600; }
    .mo-spinner { width: 36px; height: 36px; border: 3px solid #E3E8F0; border-top-color: #FF6B35; border-radius: 50%; animation: moSpin 0.8s linear infinite; }
    @keyframes moSpin { to { transform: rotate(360deg); } }

    .mo-head { position: relative; left: 50%; width: 100vw; margin-left: -50vw; background: #1B2A4A; color: #fff; }
    .mo-head-in { max-width: 560px; margin: 0 auto; padding: 12px 16px 6px; display: flex; align-items: center; gap: 8px; min-height: 68px; }
    .mo-title { flex: 1; min-width: 0; margin: 0; font-size: 19px; font-weight: 700; color: #fff; }
    .mo-round { width: 44px; height: 44px; border-radius: 22px; background: rgba(255, 255, 255, 0.14); color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 17px; flex: none; }
    .mo-tabs { max-width: 560px; margin: 0 auto; padding: 0 16px; display: flex; gap: 6px; }
    .mo-tab { flex: 1; height: 44px; border: 0; border-radius: 12px 12px 0 0; background: rgba(255, 255, 255, 0.1); color: #fff; font-weight: 700; font-size: 15px; cursor: pointer; }
