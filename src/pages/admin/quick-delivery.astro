---
// path: src/pages/admin/quick-delivery.astro
// ============================================================
// পেজ: কুইক ডেলিভারি — অ্যাডমিন হাব (/admin/quick-delivery)
// কুইক ডেলিভারির সব অ্যাডমিন অপশন এক জায়গায়: অর্ডার, অগ্রিম পেমেন্ট যাচাই, হিসাব,
// দোকান ও মেনু, শপ ক্যাটাগরি, রাইডার ভেরিফিকেশন, ডিসপিউট, চার্জ সেটিং, লোকেশন ইম্পোর্ট।
// পারমিশন: পেজ = delivery_orders.view (adminGuard.js ম্যাপ); প্রতিটা কার্ড নিজের পেজের এলাকা অনুযায়ী
//   দেখায় (স্টাফ); ম্যাপে না থাকা পেজের কার্ড (data-admin-only) শুধু অ্যাডমিন দেখে।
// ব্যাজ: চলমান অর্ডার (admin_orders_overview), যাচাই-বাকি অগ্রিম পেমেন্ট, ডিসপিউট, রাইডার আবেদন।
// প্যাটার্ন: adminGuard.js + smartfeni:admin-ready। সব টেক্সট স্ট্যাটিক বা textContent।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="কুইক ডেলিভারি অ্যাডমিন | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="qda">
    <div id="adminLoadingState" class="qda-loading"><p>যাচাই করা হচ্ছে…</p></div>

    <div id="adminGuardedContent" style="display:none;">
      <div class="qda-head">
        <div class="qda-head-in">
          <a href="/admin" class="qda-round" aria-label="অ্যাডমিন ড্যাশবোর্ডে ফিরুন">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </a>
          <div class="qda-title">
            <h1>কুইক ডেলিভারি</h1>
            <span>অ্যাডমিন অপশন</span>
          </div>
          <img src="/market/icons/scooter.webp" alt="" aria-hidden="true" class="qda-hic" />
        </div>
      </div>

      <div class="qda-body">

        <section class="qda-group">
          <div class="qda-h">প্রতিদিনের কাজ</div>
          <div class="qda-grid">
            <a href="/admin/delivery-orders" class="qda-card" style="--c:#FF6B35;">
              <span class="qda-badge" id="qdaLive" style="display:none;">0</span>
              <span class="qda-ic"><i class="fas fa-box-open"></i></span>
              <b>অর্ডার</b>
              <small>নতুন, চলমান, সম্পন্ন অর্ডার, পাবলিশ ও রাইডার বদল</small>
            </a>
            <a href="/admin/delivery-market-payments" class="qda-card" style="--c:#16A34A;">
              <span class="qda-badge" id="qdaPay" style="display:none;">0</span>
              <span class="qda-ic"><i class="fas fa-money-bill-wave"></i></span>
              <b>অগ্রিম পেমেন্ট যাচাই</b>
              <small>বিকাশ/নগদের অগ্রিম মিলিয়ে কনফার্ম</small>
            </a>
            <a href="/admin/delivery-disputes" class="qda-card" style="--c:#EF4444;">
              <span class="qda-badge" id="qdaDisp" style="display:none;">0</span>
              <span class="qda-ic"><i class="fas fa-flag"></i></span>
              <b>ডিসপিউট</b>
              <small>রিপোর্ট করা সমস্যা দেখুন ও রিজলভ করুন</small>
            </a>
            <a href="/admin/delivery-market-accounts" class="qda-card" style="--c:#0EA5E9;">
              <span class="qda-ic"><i class="fas fa-calculator"></i></span>
              <b>হিসাব</b>
              <small>কুইক ডেলিভারির আয়-ব্যয় ও রাইডারের হিসাব</small>
            </a>
          </div>
        </section>

        <section class="qda-group">
          <div class="qda-h">দোকান ও মেনু</div>
          <div class="qda-grid">
            <a href="/admin/delivery-shops" class="qda-card" style="--c:#F59E0B;">
              <span class="qda-ic"><i class="fas fa-utensils"></i></span>
              <b>দোকান ও মেনু</b>
              <small>রেস্টুরেন্ট/দোকান, মেনু আইটেম, ছবি ও দাম</small>
            </a>
            <a href="/admin/delivery-categories" class="qda-card" data-admin-only="1" style="--c:#8B5CF6;">
              <span class="qda-ic"><i class="fas fa-tags"></i></span>
              <b>শপ ক্যাটাগরি</b>
              <small>কুইক ডেলিভারির দোকানের ক্যাটাগরি</small>
            </a>
          </div>
        </section>

        <section class="qda-group">
          <div class="qda-h">রাইডার ও চার্জ</div>
          <div class="qda-grid">
            <a href="/admin/delivery-riders" class="qda-card" style="--c:#FF6B35;">
              <span class="qda-badge" id="qdaRider" style="display:none;">0</span>
              <span class="qda-ic"><i class="fas fa-motorcycle"></i></span>
              <b>রাইডার ভেরিফিকেশন</b>
              <small>রাইডার আবেদন যাচাই, approve/reject</small>
            </a>
            <a href="/admin/delivery-fare" class="qda-card" data-admin-only="1" style="--c:#D97706;">
              <span class="qda-ic"><i class="fas fa-coins"></i></span>
              <b>চার্জ সেটিং</b>
              <small>অটো ডেলিভারি চার্জ, বেস, কিমি রেট, ইউনিয়ন চার্জ</small>
            </a>
            <a href="/admin/seed-locations" class="qda-card" style="--c:#14B8A6;">
              <span class="qda-ic"><i class="fas fa-map-location-dot"></i></span>
              <b>লোকেশন ইম্পোর্ট</b>
              <small>OSM থেকে ঠিকানা সাজেশন যোগ</small>
            </a>
          </div>
        </section>

        <a href="/market" class="qda-view">
          <i class="fas fa-eye"></i> কাস্টমার যেভাবে দেখে (/market)
        </a>

        <p class="qda-none" id="qdaEmpty" style="display:none;">এই রোলে দেখানোর মতো অপশন নেই</p>
      </div>
    </div>
  </div>

  <style is:global>
    .qda { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #F4F6FA; min-height: 70vh; padding-bottom: 100px; overflow-x: hidden; }
    .qda * { box-sizing: border-box; }
    .qda-loading { padding: 120px 0; text-align: center; color: #5B6B86; font-weight: 600; }
    .qda-head { position: relative; left: 50%; width: 100vw; margin-left: -50vw; background: linear-gradient(135deg, #1B2A4A, #2C4372); color: #fff; }
    .qda-head-in { max-width: 640px; margin: 0 auto; padding: 14px 16px; display: flex; align-items: center; gap: 12px; min-height: 76px; }
    .qda-round { width: 44px; height: 44px; border-radius: 22px; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; flex: none; }
    .qda-round svg { width: 21px; height: 21px; fill: none; stroke: #fff; stroke-width: 2.3; stroke-linecap: round; stroke-linejoin: round; }
    .qda-title { flex: 1; min-width: 0; }
    .qda-title h1 { margin: 0; font-size: 21px; font-weight: 700; color: #fff; }
    .qda-title span { font-size: 13px; opacity: .85; }
    .qda-hic { width: 44px; height: 44px; object-fit: contain; flex: none; }
    .qda-body { max-width: 640px; margin: 0 auto; padding: 8px 16px 0; }
    .qda-h { margin: 18px 2px 8px; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: #64748B; }
    .qda-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .qda-card { position: relative; display: flex; flex-direction: column; gap: 8px; background: #fff; border: 1px solid #E5EAF0; border-radius: 18px; padding: 14px 12px; text-decoration: none; color: #1B2A4A; transition: transform .12s ease, box-shadow .12s ease; }
    .qda-card:active { transform: scale(.97); box-shadow: 0 6px 18px rgba(15,23,42,.12); }
    .qda-card:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .qda-ic { width: 42px; height: 42px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 17px; color: var(--c); background: #FFF0EA; background: color-mix(in srgb, var(--c) 15%, #fff); }
    .qda-card b { font-size: 15px; line-height: 1.25; }
    .qda-card small { font-size: 12.5px; color: #5B6B86; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .qda-badge { position: absolute; top: 10px; right: 10px; background: #D14343; color: #fff; font-size: 12px; font-weight: 700; min-width: 22px; height: 22px; padding: 0 7px; border-radius: 22px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 2px #fff; }
    .qda-view { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 22px; min-height: 48px; border-radius: 16px; border: 1.5px dashed #C5CEDD; color: #1B2A4A; font-size: 14.5px; font-weight: 600; text-decoration: none; background: #fff; }
    .qda-none { text-align: center; color: #5B6B86; padding: 20px 0; font-size: 14px; }
  </style>

  <script>
    import { initAdminGuard, adminAreaOfPath } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';

    let isAdmin = false;
    let access = null;

    function cardAllowed(card) {
      // রোলওয়ালা স্টাফ: কার্ডের পেজের এলাকায় .view থাকলে; ম্যাপে না থাকা পেজ বন্ধ
      if (access && access.isStaff) {
        const area = adminAreaOfPath(card.getAttribute('href') || '');
        return !!area && access.can(area + '.view');
      }
      return !card.hasAttribute('data-admin-only') || isAdmin;
    }

    function applyVisibility() {
      let total = 0;
      document.querySelectorAll('.qda-group').forEach((group) => {
        let shown = 0;
        group.querySelectorAll('.qda-card').forEach((card) => {
          const ok = cardAllowed(card);
          card.style.display = ok ? '' : 'none';
          if (ok) shown += 1;
        });
        group.style.display = shown > 0 ? '' : 'none';
        total += shown;
      });
      const empty = document.getElementById('qdaEmpty');
      if (empty) empty.style.display = total === 0 ? 'block' : 'none';
    }

    function setBadge(id, count) {
      const el = document.getElementById(id);
      if (!el) return;
      if (count && count > 0) {
        el.textContent = count > 99 ? '৯৯+' : String(count);
        el.style.display = 'flex';
      } else {
        el.style.display = 'none';
      }
    }

    async function loadCounts() {
      try {
        const [pay, rider, ovRes] = await Promise.all([
          supabase.from('delivery_payments').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
          supabase.from('delivery_riders').select('*', { count: 'exact', head: true }).eq('verification_status', 'pending'),
          supabase.rpc('admin_orders_overview'),
        ]);
        const ov = ovRes.data || {};
        const live = (ov.live_open || 0) + (ov.live_confirmed || 0) + (ov.live_delivered || 0) + (ov.disputed || 0);
        setBadge('qdaLive', live);
        setBadge('qdaPay', pay.count || 0);
        setBadge('qdaDisp', ov.disputed || 0);
        setBadge('qdaRider', rider.count || 0);
      } catch (e) {
        // কাউন্ট না এলেও কার্ডগুলো কাজ করবে
      }
    }

    let started = false;
    window.addEventListener('smartfeni:admin-ready', (e) => {
      if (started) return;
      started = true;
      const { role, access: guardAccess } = e.detail;
      access = guardAccess || null;
      isAdmin = role === 'admin';
      applyVisibility();
      loadCounts();
      setInterval(() => { if (!document.hidden) loadCounts(); }, 30000);
    });

    initAdminGuard();
  </script>
</BaseLayout>
