<!-- path: src/pages/admin/categories.astro -->
---
// ============================================================
// পেজ: অ্যাডমিন — ক্যাটাগরি ম্যানেজমেন্ট (/admin/categories)
//
// দুইটা ফিচার:
// ১. হোমপেজ সেকশন অর্ডার — Featured Photos, Popular Category, ও
//    General Category — এই ৩টা ব্লকের মধ্যে Photos কোথায় বসবে তা
//    ৩টা অপশনে বেছে নেওয়া যায় (site_settings টেবিলের
//    'homepage_section_order' key: 'photos_first' | 'photos_middle' |
//    'photos_last')। Popular সবসময় General-এর আগে থাকে (fix) —
//    শুধু Photos-এর পজিশন বদলায়।
// ২. ক্যাটাগরি সিরিয়াল — services.js এর popularSlugs (courier, ride,
//    online-shop) ও বাকি সব ক্যাটাগরি, দুইটা আলাদা গ্রুপ হিসেবে
//    up/down বাটনে সিরিয়াল বদলানো যাবে (category_settings টেবিলের
//    sort_order কলাম, শপ ম্যানেজমেন্টের একই প্যাটার্নে)।
//    গ্রুপ অ্যাসাইনমেন্ট (কোনটা Popular, কোনটা General) কোডেই ফিক্সড
//    থাকছে — শুধু প্রতিটা গ্রুপের ভেতরের অর্ডার বদলানো যাবে।
//
// নোট (is:global): নিচের ক্যাটাগরি কার্ডগুলো (.cat-order-card ইত্যাদি)
// JS দিয়ে innerHTML হিসেবে dynamically তৈরি হয়, তাই Astro-র স্কোপড
// <style> এদের উপর প্রযোজ্য হয় না (স্কোপ অ্যাট্রিবিউট শুধু
// টেমপ্লেটে সরাসরি লেখা এলিমেন্টে বসে)। তাই পুরো স্টাইল ব্লকটাই
// is:global রাখা হয়েছে যাতে UI ঠিকমতো দেখায়।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="ক্যাটাগরি ম্যানেজমেন্ট | অ্যাডমিন">
  <div class="admin-page">
    <div class="container">

      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i> ড্যাশবোর্ড</a>

        <div class="admin-header">
          <h1>ক্যাটাগরি ম্যানেজমেন্ট</h1>
          <p class="admin-subtitle">হোমপেজ সেকশন অর্ডার ও ক্যাটাগরি সিরিয়াল নিয়ন্ত্রণ</p>
        </div>

        <!-- ===== হোমপেজ সেকশন অর্ডার ===== -->
        <div class="section-block">
          <h2 class="section-title"><i class="fas fa-layer-group"></i> হোমপেজ সেকশন অর্ডার</h2>
          <p class="section-hint">Popular ক্যাটাগরি সবসময় আগে, General সবসময় পরে — শুধু Featured Photos-এর পজিশন বেছে নিন</p>

          <div class="order-preview-box" id="orderPreviewBox"></div>

          <div class="order-option-list">
            <button type="button" class="order-option-btn" data-value="photos_first">
              <i class="fas fa-images"></i>
              <span>ফটো সবার উপরে</span>
              <small>Photos → Popular → General</small>
            </button>
            <button type="button" class="order-option-btn" data-value="photos_middle">
              <i class="fas fa-images"></i>
              <span>ফটো মাঝখানে</span>
              <small>Popular → Photos → General</small>
            </button>
            <button type="button" class="order-option-btn" data-value="photos_last">
              <i class="fas fa-images"></i>
              <span>ফটো সবার নিচে</span>
              <small>Popular → General → Photos</small>
            </button>
          </div>
        </div>

        <!-- ===== জনপ্রিয় ক্যাটাগরি সিরিয়াল ===== -->
        <div class="section-block">
          <h2 class="section-title"><i class="fas fa-fire"></i> জনপ্রিয় ক্যাটাগরি সিরিয়াল</h2>
          <p class="section-hint">হোমপেজে "জনপ্রিয়" ব্যাজের নিচে এই ৩টা যে ক্রমে দেখাবে</p>
          <div id="popularContainer" class="category-order-container"></div>
        </div>

        <!-- ===== সাধারণ ক্যাটাগরি সিরিয়াল ===== -->
        <div class="section-block">
          <h2 class="section-title"><i class="fas fa-grip"></i> সাধারণ ক্যাটাগরি সিরিয়াল</h2>
          <p class="section-hint">বাকি সব ক্যাটাগরির হোমপেজ ক্রম</p>
          <div id="generalContainer" class="category-order-container"></div>
        </div>

      </div>
    </div>
  </div>

  <style is:global>
    .admin-page {
      min-height: 60vh;
      padding: 32px 0 80px;
    }

    .admin-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .admin-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #5A6E85;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .back-link:hover {
      color: #FF6B35;
    }

    .admin-header {
      margin-bottom: 24px;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .admin-subtitle {
      font-size: 0.85rem;
      color: #8FA0BC;
      margin-top: 4px;
      font-weight: 600;
    }

    .section-block {
      margin-bottom: 28px;
    }

    .section-title {
      font-size: 1rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title i {
      color: #FF6B35;
    }

    .section-hint {
      font-size: 0.78rem;
      color: #8FA0BC;
      margin-bottom: 14px;
      line-height: 1.5;
    }

    .order-preview-box {
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: #F4F7FC;
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 14px;
    }

    .order-preview-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #fff;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .order-preview-row .order-preview-num {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      flex-shrink: 0;
    }

    .order-option-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .order-option-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      text-align: left;
      background: #fff;
      border: 1.5px solid #E5EAF0;
      border-radius: 14px;
      padding: 12px 14px;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    }

    .order-option-btn i {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #F4F7FC;
      color: #99A9BE;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.95rem;
    }

    .order-option-btn span {
      display: block;
      font-size: 0.88rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .order-option-btn small {
      display: block;
      font-size: 0.72rem;
      color: #8FA0BC;
      font-weight: 600;
      margin-top: 2px;
    }

    .order-option-btn.active {
      border-color: #FF6B35;
      background: #FFF6F2;
    }

    .order-option-btn.active i {
      background: #FF6B35;
      color: #fff;
    }

    .order-option-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .category-order-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .cat-order-card {
      background: #fff;
      border-radius: 14px;
      padding: 12px 14px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cat-order-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .cat-order-name {
      flex: 1;
      min-width: 0;
      font-size: 0.88rem;
      font-weight: 700;
      color: #1B2A4A;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .cat-order-actions {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }

    .cat-order-btn {
      background: #F4F7FC;
      color: #1B2A4A;
      border: none;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 0.85rem;
    }

    .cat-order-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .cat-order-loading {
      text-align: center;
      color: #8FA0BC;
      padding: 24px 0;
      font-size: 0.85rem;
    }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { categories } from '../../data/services.js';

    const POPULAR_SLUGS = ['courier', 'ride', 'online-shop'];

    const popularContainer = document.getElementById('popularContainer');
    const generalContainer = document.getElementById('generalContainer');
    const orderPreviewBox = document.getElementById('orderPreviewBox');
    const orderOptionBtns = document.querySelectorAll('.order-option-btn');

    const ORDER_SEQUENCES = {
      photos_first: ['ফিচার্ড ফটো গ্যালারি', 'জনপ্রিয় ক্যাটাগরি', 'সাধারণ ক্যাটাগরি'],
      photos_middle: ['জনপ্রিয় ক্যাটাগরি', 'ফিচার্ড ফটো গ্যালারি', 'সাধারণ ক্যাটাগরি'],
      photos_last: ['জনপ্রিয় ক্যাটাগরি', 'সাধারণ ক্যাটাগরি', 'ফিচার্ড ফটো গ্যালারি'],
    };

    // পুরনো ২-অপশন ভ্যালু ('category_first') থাকলে নতুন ৩-অপশন
    // সিস্টেমে ম্যাপ করা হচ্ছে যাতে আগের সেটিং নষ্ট না হয়
    function normalizeOrderValue(value) {
      if (value === 'category_first') return 'photos_last';
      if (ORDER_SEQUENCES[value]) return value;
      return 'photos_first';
    }

    let currentSectionOrder = 'photos_first';

    // ============ হোমপেজ সেকশন অর্ডার ============
    async function loadSectionOrder() {
      const { data } = await supabase
        .from('site_settings')
        .select('value')
        .eq('key', 'homepage_section_order')
        .maybeSingle();

      currentSectionOrder = normalizeOrderValue(data?.value);
      renderSectionOrder();
    }

    function renderSectionOrder() {
      const seq = ORDER_SEQUENCES[currentSectionOrder];
      orderPreviewBox.innerHTML = seq
        .map(
          (label, i) =>
            `<div class="order-preview-row"><span class="order-preview-num">${i + 1}</span> ${label}</div>`
        )
        .join('');

      orderOptionBtns.forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.value === currentSectionOrder);
      });
    }

    orderOptionBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const newOrder = btn.dataset.value;
        if (newOrder === currentSectionOrder) return;

        orderOptionBtns.forEach((b) => (b.disabled = true));

        const { error } = await supabase
          .from('site_settings')
          .update({ value: newOrder, updated_at: new Date().toISOString() })
          .eq('key', 'homepage_section_order');

        if (error) {
          alert('আপডেট ব্যর্থ: ' + error.message);
        } else {
          currentSectionOrder = newOrder;
          renderSectionOrder();
        }

        orderOptionBtns.forEach((b) => (b.disabled = false));
      });
    });

    // ============ ক্যাটাগরি সিরিয়াল ============
    let sortMap = {}; // category_id -> sort_order
    let popularList = [];
    let generalList = [];

    async function loadCategorySettings() {
      const { data } = await supabase.from('category_settings').select('category_id, sort_order');
      sortMap = {};
      (data || []).forEach((row) => {
        sortMap[row.category_id] = row.sort_order;
      });

      const withOrder = categories.map((cat, idx) => ({
        ...cat,
        sort_order: sortMap[cat.id] ?? idx * 10,
      }));

      popularList = withOrder
        .filter((c) => POPULAR_SLUGS.includes(c.slug))
        .sort((a, b) => a.sort_order - b.sort_order);

      generalList = withOrder
        .filter((c) => !POPULAR_SLUGS.includes(c.slug))
        .sort((a, b) => a.sort_order - b.sort_order);

      renderList(popularContainer, popularList);
      renderList(generalContainer, generalList);
    }

    function renderList(container, list) {
      container.innerHTML = '';
      list.forEach((cat, idx) => {
        const card = document.createElement('div');
        card.className = 'cat-order-card';
        card.innerHTML = `
          <div class="cat-order-icon"><i class="fas ${cat.icon}"></i></div>
          <span class="cat-order-name">${cat.name}${cat.hidden ? ' (হিডেন)' : ''}</span>
          <div class="cat-order-actions">
            <button type="button" class="cat-order-btn" data-dir="up" ${idx === 0 ? 'disabled' : ''}><i class="fas fa-arrow-up"></i></button>
            <button type="button" class="cat-order-btn" data-dir="down" ${idx === list.length - 1 ? 'disabled' : ''}><i class="fas fa-arrow-down"></i></button>
          </div>
        `;
        card.querySelectorAll('.cat-order-btn').forEach((btn) => {
          btn.addEventListener('click', () => moveCategory(list, cat, btn.dataset.dir));
        });
        container.appendChild(card);
      });
    }

    async function moveCategory(list, cat, direction) {
      const idx = list.findIndex((c) => c.id === cat.id);
      const swapIdx = direction === 'up' ? idx - 1 : idx + 1;
      if (swapIdx < 0 || swapIdx >= list.length) return;

      const other = list[swapIdx];
      const tempOrder = cat.sort_order;

      await Promise.all([
        supabase.from('category_settings').upsert({ category_id: cat.id, sort_order: other.sort_order }),
        supabase.from('category_settings').upsert({ category_id: other.id, sort_order: tempOrder }),
      ]);

      loadCategorySettings();
    }

    window.addEventListener('smartfeni:admin-ready', () => {
      loadSectionOrder();
      loadCategorySettings();
    });

    initAdminGuard();
  </script>
</BaseLayout>
