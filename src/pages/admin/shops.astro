<!-- path: src/pages/admin/shops.astro -->
---
// ============================================================
// পেজ: অ্যাডমিন — শপ ম্যানেজমেন্ট (/admin/shops)
// আপডেট: profiles টেবিলের বদলে এখন আলাদা shops টেবিল ব্যবহার করে
// (club এর প্যাটার্নে)। নতুন সংযোজন:
//   ১. ম্যানুয়াল শপ তৈরির ফর্মে slug ইনপুট যোগ হয়েছে
//   ২. "শপ আবেদন" সেকশন — ইউজারদের request-approve ফ্লো (নতুন
//      shop_requests টেবিল থেকে pending রিকোয়েস্ট দেখায়)
//   ৩. প্রতিটা শপে "ওউনার পরিবর্তন" বাটন — কোনো শপের owner_id
//      অন্য existing ইউজার অ্যাকাউন্টে রিলিংক করার জন্য
//   ৪. প্রতিটা শপে "ডিলিট" বাটন (২-ক্লিক কনফার্ম) — পার্মানেন্ট
//      ডিলিট, /api/delete-shop.js এন্ডপয়েন্ট cascade delete করে
//      (শপের online-shop listings + moderators রো + shops রো,
//      আর ওউনারের profiles ফ্ল্যাগ রিসেট করে)
//
// আপডেট (shop_order ফিক্স): loadShops()-এ shop_order ascending এর
// পাশাপাশি এখন created_at ascending সেকেন্ডারি সর্ট হিসেবে যোগ করা
// হলো। আগে সব শপের shop_order ডিফল্ট 0 থাকায় (কোথাও সেট হতো না)
// up/down বাটনে position change করলেও effect বোঝা যেত না — এখন
// create-shop.js ও approve-shop-request.js নতুন শপ তৈরির সময়
// shop_order বসিয়ে দেয়, আর এই সেকেন্ডারি সর্ট ভবিষ্যতে কোনো টাই
// হলে (দুইটা শপের shop_order সমান) স্টেবল/প্রেডিক্টেবল অর্ডার
// নিশ্চিত করবে।
//
// আপডেট (স্লাগ — অ্যাডমিন ঠিক করবে):
//   ক. পেন্ডিং আবেদন কার্ডে এখন স্লাগ বক্স + "চেক" বাটন আছে। শপের ইংরেজি নাম
//      থেকে সাজেস্টেড স্লাগ আগে থেকে বসে (বাংলা নাম হলে ফাঁকা — অ্যাডমিনকে
//      নিজে লিখতে হবে, ফাঁকা রেখে Approve করা যায় না)। টাইপ করার সময় লাইভ
//      চেক হয়; clubs/shops/reserved-এর সাথে কনফ্লিক্ট হলে "Not Available"
//      এরর দেখায় ও সার্ভারও approve আটকে দেয়।
//   খ. প্রতিটা শপে নতুন "স্লাগ পরিবর্তন" বাটন (লিংক আইকন) → মোডাল, একই
//      লাইভ চেক সহ (নিজের স্লাগ বাদ দিয়ে)। /api/update-shop-slug কল করে।
//      সতর্কতা: স্লাগ বদলালে পুরনো লিংক কাজ করবে না।
//   গ. সিকিউরিটি: আবেদনকারীর দেওয়া shop_name/phone/message আর শপের name/slug
//      আগে innerHTML-এ সরাসরি বসত (অ্যাডমিন পেজে স্টোর্ড XSS ঝুঁকি) — এখন
//      esc() দিয়ে এস্কেপ করা হয়।
// স্লাগের নিয়মকানুন (slugify, reserved) src/lib/slugRules.js-এ।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="শপ ম্যানেজমেন্ট | অ্যাডমিন">
  <div class="admin-page">
    <div class="container">

      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i> ড্যাশবোর্ড</a>

        <div class="admin-header">
          <h1>শপ ম্যানেজমেন্ট</h1>
          <p class="admin-subtitle" id="resultCount"></p>
        </div>

        <!-- ===== পেন্ডিং শপ আবেদন ===== -->
        <div class="section-block">
          <h2 class="section-title"><i class="fas fa-inbox"></i> পেন্ডিং আবেদন <span id="pendingCountBadge" class="count-badge" style="display:none;"></span></h2>
          <div id="requestsContainer" class="requests-container"></div>
          <p id="noRequestsMsg" class="no-items-msg" style="display:none;">কোনো পেন্ডিং আবেদন নেই</p>
        </div>

        <!-- ===== নতুন শপ তৈরির CTA (ম্যানুয়াল) ===== -->
        <button class="cta-toggle-btn" id="showCreateFormBtn" type="button">
          <i class="fas fa-plus"></i> ম্যানুয়ালি নতুন শপ যোগ করুন
        </button>

        <!-- ===== নতুন শপ তৈরির ফর্ম (ডিফল্টে লুকানো) ===== -->
        <div class="create-card" id="createFormBox" style="display:none;">
          <h2 class="create-title"><i class="fas fa-store"></i> নতুন শপ যোগ করুন</h2>

          <p class="form-message" id="createMessage"></p>

          <label class="form-label">শপের নাম<span class="required-mark">*</span></label>
          <input type="text" class="form-input" id="shopNameInput" required placeholder="যেমন: রহিম'স ক্লথিং শপ" />
          <div class="field-error-msg" data-error-for="shopNameInput">
            <i class="fas fa-circle-exclamation"></i><span>শপের নাম দিন</span>
          </div>

          <label class="form-label">স্লাগ (URL — যেমন smartfeni.com/<b>rahims-shop</b>)<span class="required-mark">*</span></label>
          <input type="text" class="form-input" id="shopSlugInput" required placeholder="rahims-shop" />
          <div class="field-error-msg" data-error-for="shopSlugInput">
            <i class="fas fa-circle-exclamation"></i><span>স্লাগ দিন</span>
          </div>

          <label class="form-label">ফোন নম্বর (লগইন আইডি হিসেবে ব্যবহার হবে)<span class="required-mark">*</span></label>
          <input type="text" class="form-input" id="shopPhoneInput" required placeholder="01xxxxxxxxx" />
          <div class="field-error-msg" data-error-for="shopPhoneInput">
            <i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর দিন</span>
          </div>

          <label class="form-label">পাসওয়ার্ড<span class="required-mark">*</span></label>
          <input type="password" class="form-input" id="shopPasswordInput" required placeholder="কমপক্ষে ৬ অক্ষর" />
          <div class="field-error-msg" data-error-for="shopPasswordInput">
            <i class="fas fa-circle-exclamation"></i><span>পাসওয়ার্ড দিন</span>
          </div>

          <button class="create-btn" id="createShopBtn" type="button">
            <i class="fas fa-plus"></i> <span id="createBtnText">শপ তৈরি করুন</span>
          </button>
        </div>

        <!-- ===== শপ তালিকা ===== -->
        <div class="section-block">
          <h2 class="section-title"><i class="fas fa-store"></i> সব শপ</h2>
          <div id="shopsContainer" class="shops-container"></div>
          <div id="emptyState" class="empty-state" style="display:none;">
            <i class="fas fa-store-slash"></i>
            <p>এখনো কোনো শপ যোগ করা হয়নি</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ===== ওউনার পরিবর্তন মোডাল ===== -->
  <div class="modal-overlay" id="reassignOverlay">
    <div class="modal-box">
      <button class="modal-close" id="reassignClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
      <h2 class="modal-title"><i class="fas fa-user-pen"></i> ওউনার পরিবর্তন</h2>
      <p class="modal-shop-name" id="reassignShopName"></p>
      <p class="modal-message" id="reassignMessage"></p>
      <label class="form-label">নতুন ওউনারের ফোন নম্বর (তার অ্যাকাউন্ট আগে থেকে থাকতে হবে)<span class="required-mark">*</span></label>
      <input type="text" class="form-input" id="reassignPhoneInput" required placeholder="01xxxxxxxxx" />
      <div class="field-error-msg" data-error-for="reassignPhoneInput">
        <i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর দিন</span>
      </div>
      <button class="create-btn" id="reassignSubmitBtn" type="button">
        <i class="fas fa-check"></i> <span id="reassignBtnText">পরিবর্তন করুন</span>
      </button>
    </div>
  </div>

  <!-- ===== স্লাগ (লিংক) পরিবর্তন মোডাল ===== -->
  <div class="modal-overlay" id="slugOverlay">
    <div class="modal-box">
      <button class="modal-close" id="slugClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
      <h2 class="modal-title"><i class="fas fa-link"></i> স্লাগ (লিংক) পরিবর্তন</h2>
      <p class="modal-shop-name" id="slugShopName"></p>
      <p class="slug-current" id="slugCurrent"></p>
      <p class="form-message" id="slugMessage"></p>
      <label class="form-label">নতুন স্লাগ (smartfeni.com/<b>rahims-shop</b>)</label>
      <input type="text" class="form-input" id="slugEditInput" placeholder="rahims-shop" autocomplete="off" autocapitalize="none" />
      <p class="slug-status" id="slugEditStatus"></p>
      <p class="slug-warn"><i class="fas fa-triangle-exclamation"></i> স্লাগ বদলালে পুরনো লিংক (যা শেয়ার বা ছাপানো হয়েছে) আর কাজ করবে না।</p>
      <button class="create-btn" id="slugSaveBtn" type="button">
        <i class="fas fa-check"></i> <span id="slugSaveBtnText">স্লাগ সেভ করুন</span>
      </button>
    </div>
  </div>

  <style is:global>
    .admin-page {
      min-height: 60vh;
      padding: 32px 0 80px;
    }

    .admin-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .admin-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #5A6E85;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .back-link:hover {
      color: #FF6B35;
    }

    .admin-header {
      margin-bottom: 24px;
    }

    .admin-header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .admin-subtitle {
      font-size: 0.85rem;
      color: #8FA0BC;
      margin-top: 4px;
      font-weight: 600;
    }

    .section-block {
      margin-bottom: 28px;
    }

    .section-title {
      font-size: 1rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title i {
      color: #FF6B35;
    }

    .count-badge {
      background: #FF6B35;
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 9px;
      border-radius: 40px;
    }

    .no-items-msg {
      text-align: center;
      color: #B0BCCB;
      font-size: 0.85rem;
      padding: 20px 0;
    }

    .requests-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .request-card {
      background: #fff;
      border-radius: 16px;
      padding: 16px 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
      border-left: 3px solid #FF6B35;
    }

    .request-name {
      font-size: 0.95rem;
      font-weight: 700;
      color: #1B2A4A;
    }

    .request-meta {
      font-size: 0.8rem;
      color: #8FA0BC;
      margin-top: 3px;
    }

    .request-message {
      font-size: 0.82rem;
      color: #5A6E85;
      margin-top: 8px;
      background: #F8FAFC;
      padding: 8px 10px;
      border-radius: 10px;
    }

    .request-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    .btn-approve, .btn-reject {
      flex: 1;
      border: none;
      padding: 9px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-approve {
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .btn-reject {
      background: #FFF0EA;
      color: #D14343;
    }

    .btn-approve:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    /* ===== স্লাগ বক্স (পেন্ডিং আবেদন কার্ড + স্লাগ মোডাল) ===== */
    .slug-box {
      margin-top: 12px;
      background: #F8FAFC;
      border-radius: 12px;
      padding: 10px 12px;
    }

    .slug-label {
      display: block;
      font-size: 0.76rem;
      font-weight: 700;
      color: #5A6E85;
      margin-bottom: 6px;
    }

    .slug-row {
      display: flex;
      gap: 8px;
    }

    .slug-row .form-input {
      flex: 1;
      min-width: 0;
      padding: 9px 12px;
      font-size: 0.85rem;
    }

    .slug-check-btn {
      flex-shrink: 0;
      background: #EFF6FF;
      color: #2563EB;
      border: none;
      padding: 0 14px;
      border-radius: 12px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .slug-status {
      display: none;
      font-size: 0.78rem;
      font-weight: 600;
      margin-top: 6px;
      line-height: 1.4;
    }

    .slug-status.slug-ok {
      display: block;
      color: #1B7A3C;
    }

    .slug-status.slug-bad {
      display: block;
      color: #D14343;
    }

    .slug-status.slug-checking {
      display: block;
      color: #8FA0BC;
    }

    .slug-current {
      font-size: 0.8rem;
      color: #5A6E85;
      font-weight: 600;
      margin-bottom: 12px;
      word-break: break-all;
    }

    .slug-warn {
      font-size: 0.76rem;
      color: #B45309;
      background: #FFF7ED;
      padding: 8px 10px;
      border-radius: 10px;
      margin-top: 12px;
      line-height: 1.4;
    }

    .cta-toggle-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FFF0EA;
      color: #FF6B35;
      border: 1.5px dashed #FFD3BC;
      padding: 14px;
      border-radius: 16px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-bottom: 24px;
    }

    .cta-toggle-btn:hover {
      background: #FF6B35;
      color: #fff;
      border-color: #FF6B35;
    }

    .create-card {
      background: #fff;
      border-radius: 20px;
      padding: 24px 22px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
      margin-bottom: 28px;
    }

    .create-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .create-title i {
      color: #FF6B35;
    }

    .form-message {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-message.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-message.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
    }

    .form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .create-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      margin-top: 20px;
    }

    .create-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .shops-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 60px 0;
      color: #B0BCCB;
    }

    .empty-state i {
      font-size: 2.4rem;
    }

    /* ===== মোডাল (ওউনার পরিবর্তন + স্লাগ পরিবর্তন) ===== */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal-box {
      background: #fff;
      border-radius: 20px;
      padding: 26px 22px;
      max-width: 420px;
      width: 100%;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: #F4F7FC;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: #5A6E85;
      cursor: pointer;
    }

    .modal-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .modal-title i {
      color: #FF6B35;
    }

    .modal-shop-name {
      font-size: 0.85rem;
      color: #8FA0BC;
      margin-bottom: 14px;
    }

    .modal-message {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .modal-message.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .modal-message.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { slugify } from '../../lib/slugRules.js';

    const container = document.getElementById('shopsContainer');
    const emptyState = document.getElementById('emptyState');
    const resultCount = document.getElementById('resultCount');

    const createMessage = document.getElementById('createMessage');
    const createBtn = document.getElementById('createShopBtn');
    const createBtnText = document.getElementById('createBtnText');

    document.getElementById('showCreateFormBtn')?.addEventListener('click', () => {
      document.getElementById('createFormBox').style.display = 'block';
      document.getElementById('showCreateFormBtn').style.display = 'none';
    });

    function showMsg(el, text, type = 'error') {
      el.textContent = text;
      el.className = `form-message ${type === 'error' ? 'show-error' : 'show-success'}`;
    }

    function clearMsg(el) {
      el.textContent = '';
      el.className = 'form-message';
    }

    // ইউজারের দেওয়া টেক্সট innerHTML-এ বসানোর আগে এস্কেপ (স্টোর্ড XSS ঠেকাতে)
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    // ===== স্লাগ লাইভ চেক (পেন্ডিং কার্ড + স্লাগ মোডাল দুটোতেই ব্যবহার) =====
    function setSlugStatus(el, type, text) {
      el.textContent = text || '';
      el.className = 'slug-status' + (type ? ` slug-${type}` : '');
    }

    async function checkSlugOnServer(slug, excludeShopId) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/check-shop-slug', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ slug, excludeShopId }),
        });
        const result = await res.json();
        if (!res.ok) {
          return { available: false, error: result.error || 'স্লাগ চেক করা যায়নি' };
        }
        return result;
      } catch (err) {
        return { available: false, error: 'নেটওয়ার্ক ত্রুটি: ' + err.message };
      }
    }

    // input-এ টাইপ করলে (৪৫০ms থেমে) আর "চেক" বাটনে চাপলে স্লাগ চেক করে স্ট্যাটাস দেখায়।
    // getExcludeId: স্লাগ এডিটের সময় নিজের শপের id ফেরত দেয়; পেন্ডিং আবেদনে undefined।
    function attachSlugChecker(input, statusEl, getExcludeId = () => undefined) {
      let timer = null;
      let seq = 0;

      async function run() {
        clearTimeout(timer);
        const cleaned = slugify(input.value);
        if (!cleaned) {
          seq++;
          setSlugStatus(statusEl, '', '');
          return null;
        }

        const mySeq = ++seq;
        setSlugStatus(statusEl, 'checking', 'চেক হচ্ছে...');
        const result = await checkSlugOnServer(cleaned, getExcludeId());

        // পরে আরেকটা চেক শুরু হয়ে গেলে এটার ফল বাদ
        if (mySeq !== seq) return null;

        if (result.available) {
          setSlugStatus(statusEl, 'ok', `✓ Available — smartfeni.com/${cleaned}`);
        } else {
          setSlugStatus(statusEl, 'bad', result.error || 'Not Available');
        }
        return result;
      }

      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(run, 450);
      });

      input.addEventListener('blur', () => {
        const cleaned = slugify(input.value);
        if (input.value && cleaned !== input.value) input.value = cleaned;
      });

      return { run };
    }

    // ===== ম্যানুয়াল শপ তৈরি =====
    createBtn?.addEventListener('click', async () => {
      clearMsg(createMessage);

      if (!window.SFValidateForm(document.getElementById('createFormBox'))) {
        return;
      }

      const shopName = document.getElementById('shopNameInput').value.trim();
      const slug = document.getElementById('shopSlugInput').value.trim();
      const phone = document.getElementById('shopPhoneInput').value.trim();
      const password = document.getElementById('shopPasswordInput').value;

      createBtnText.textContent = 'তৈরি হচ্ছে...';
      createBtn.disabled = true;

      try {
        const res = await fetch('/api/create-shop', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ shopName, slug, phone, password }),
        });
        const result = await res.json();

        if (!res.ok) {
          showMsg(createMessage, result.error || 'শপ তৈরি ব্যর্থ');
        } else {
          showMsg(createMessage, 'শপ সফলভাবে তৈরি হয়েছে ✓', 'success');
          document.getElementById('shopNameInput').value = '';
          document.getElementById('shopSlugInput').value = '';
          document.getElementById('shopPhoneInput').value = '';
          document.getElementById('shopPasswordInput').value = '';
          loadShops();
        }
      } catch (err) {
        showMsg(createMessage, 'নেটওয়ার্ক ত্রুটি: ' + err.message);
      }

      createBtnText.textContent = 'শপ তৈরি করুন';
      createBtn.disabled = false;
    });

    // ===== পেন্ডিং আবেদন =====
    const requestsContainer = document.getElementById('requestsContainer');
    const noRequestsMsg = document.getElementById('noRequestsMsg');
    const pendingCountBadge = document.getElementById('pendingCountBadge');

    async function loadRequests() {
      const { data, error } = await supabase
        .from('shop_requests')
        .select('*')
        .eq('status', 'pending')
        .order('created_at', { ascending: true });

      if (error) {
        console.error('আবেদন লোড এরর:', error.message);
        return;
      }

      const requests = data || [];
      requestsContainer.innerHTML = '';

      if (requests.length === 0) {
        noRequestsMsg.style.display = 'block';
        pendingCountBadge.style.display = 'none';
        return;
      }

      noRequestsMsg.style.display = 'none';
      pendingCountBadge.style.display = 'inline-block';
      pendingCountBadge.textContent = requests.length;

      requests.forEach((req) => {
        const card = document.createElement('div');
        card.className = 'request-card';
        card.innerHTML = `
          <p class="request-name">${esc(req.shop_name)}</p>
          <p class="request-meta"><i class="fas fa-phone"></i> ${esc(req.phone)} · ${new Date(req.created_at).toLocaleDateString('bn-BD')}</p>
          ${req.message ? `<p class="request-message">${esc(req.message)}</p>` : ''}
          <div class="slug-box">
            <label class="slug-label">স্লাগ (smartfeni.com/<b>…</b>)</label>
            <div class="slug-row">
              <input type="text" class="form-input slug-input" placeholder="ইংরেজিতে লিখুন, যেমন rahims-shop" autocomplete="off" autocapitalize="none" />
              <button type="button" class="slug-check-btn">চেক</button>
            </div>
            <p class="slug-status"></p>
          </div>
          <div class="request-actions">
            <button class="btn-approve"><i class="fas fa-check"></i> Approve</button>
            <button class="btn-reject"><i class="fas fa-xmark"></i> Reject</button>
          </div>
        `;

        const slugInput = card.querySelector('.slug-input');
        const slugStatus = card.querySelector('.slug-status');

        // শপের নাম ইংরেজি হলে সাজেস্টেড স্লাগ বসে; বাংলা হলে ফাঁকা থাকে (অ্যাডমিন নিজে লিখবে)
        const suggested = slugify(req.shop_name);
        if (suggested.length >= 3) slugInput.value = suggested;

        const checker = attachSlugChecker(slugInput, slugStatus);
        card.querySelector('.slug-check-btn').addEventListener('click', () => checker.run());
        if (slugInput.value) checker.run();

        card.querySelector('.btn-approve').addEventListener('click', (e) => {
          approveRequest(req, e.target.closest('button'), slugInput, slugStatus);
        });
        card.querySelector('.btn-reject').addEventListener('click', () => rejectRequest(req.id));

        requestsContainer.appendChild(card);
      });
    }

    async function approveRequest(req, btn, slugInput, slugStatus) {
      const slug = slugify(slugInput.value);
      slugInput.value = slug;

      if (!slug) {
        setSlugStatus(slugStatus, 'bad', 'স্লাগ দিন — শুধু ইংরেজি ছোট অক্ষর, সংখ্যা ও হাইফেন (যেমন rahims-shop)');
        slugInput.focus();
        return;
      }

      const originalHtml = btn.innerHTML;
      btn.innerHTML = 'অপেক্ষা করুন...';
      btn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/approve-shop-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ requestId: req.id, slug }),
        });
        const result = await res.json();

        if (!res.ok) {
          if (result.field === 'slug') {
            // স্লাগ কনফ্লিক্ট/ফরম্যাট এরর — alert না, বক্সের নিচেই দেখাও
            setSlugStatus(slugStatus, 'bad', result.error || 'Not Available');
            slugInput.focus();
          } else {
            alert('Approve ব্যর্থ: ' + (result.error || 'অজানা ত্রুটি'));
          }
          btn.innerHTML = originalHtml;
          btn.disabled = false;
          return;
        }

        loadRequests();
        loadShops();
      } catch (err) {
        alert('নেটওয়ার্ক ত্রুটি: ' + err.message);
        btn.innerHTML = originalHtml;
        btn.disabled = false;
      }
    }

    async function rejectRequest(id) {
      if (!confirm('এই আবেদনটি বাতিল করতে চান?')) return;

      const { error } = await supabase.from('shop_requests').update({ status: 'rejected' }).eq('id', id);
      if (error) {
        alert('বাতিল ব্যর্থ: ' + error.message);
        return;
      }
      loadRequests();
    }

    // ===== ওউনার পরিবর্তন মোডাল =====
    const reassignOverlay = document.getElementById('reassignOverlay');
    const reassignClose = document.getElementById('reassignClose');
    const reassignShopName = document.getElementById('reassignShopName');
    const reassignMessage = document.getElementById('reassignMessage');
    const reassignPhoneInput = document.getElementById('reassignPhoneInput');
    const reassignSubmitBtn = document.getElementById('reassignSubmitBtn');
    const reassignBtnText = document.getElementById('reassignBtnText');
    let reassignTargetShop = null;

    function openReassign(shop) {
      reassignTargetShop = shop;
      reassignShopName.textContent = shop.name;
      reassignPhoneInput.value = '';
      clearMsg(reassignMessage);
      reassignOverlay.classList.add('open');
    }

    function closeReassign() {
      reassignOverlay.classList.remove('open');
      reassignTargetShop = null;
    }

    reassignClose?.addEventListener('click', closeReassign);
    reassignOverlay?.addEventListener('click', (e) => {
      if (e.target === reassignOverlay) closeReassign();
    });

    reassignSubmitBtn?.addEventListener('click', async () => {
      clearMsg(reassignMessage);
      if (!window.SFValidateForm(document.querySelector('#reassignOverlay .modal-box'))) {
        return;
      }

      const newPhone = reassignPhoneInput.value.trim();

      reassignBtnText.textContent = 'পরিবর্তন হচ্ছে...';
      reassignSubmitBtn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/reassign-shop-owner', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ shopId: reassignTargetShop.id, newOwnerPhone: newPhone }),
        });
        const result = await res.json();

        if (!res.ok) {
          showMsg(reassignMessage, result.error || 'পরিবর্তন ব্যর্থ');
        } else {
          showMsg(reassignMessage, 'ওউনার পরিবর্তন হয়েছে ✓', 'success');
          setTimeout(() => {
            closeReassign();
            loadShops();
          }, 800);
        }
      } catch (err) {
        showMsg(reassignMessage, 'নেটওয়ার্ক ত্রুটি: ' + err.message);
      }

      reassignBtnText.textContent = 'পরিবর্তন করুন';
      reassignSubmitBtn.disabled = false;
    });

    // ===== স্লাগ (লিংক) পরিবর্তন মোডাল =====
    const slugOverlay = document.getElementById('slugOverlay');
    const slugClose = document.getElementById('slugClose');
    const slugShopName = document.getElementById('slugShopName');
    const slugCurrent = document.getElementById('slugCurrent');
    const slugMessage = document.getElementById('slugMessage');
    const slugEditInput = document.getElementById('slugEditInput');
    const slugEditStatus = document.getElementById('slugEditStatus');
    const slugSaveBtn = document.getElementById('slugSaveBtn');
    const slugSaveBtnText = document.getElementById('slugSaveBtnText');
    let slugTargetShop = null;

    // নিজের শপকে চেক থেকে বাদ দেওয়ার জন্য getter (মোডাল খোলার সময় slugTargetShop বদলায়)
    attachSlugChecker(slugEditInput, slugEditStatus, () => slugTargetShop?.id);

    function openSlugEdit(shop) {
      slugTargetShop = shop;
      slugShopName.textContent = shop.name;
      slugCurrent.textContent = `বর্তমান: smartfeni.com/${shop.slug}`;
      slugEditInput.value = shop.slug || '';
      clearMsg(slugMessage);
      setSlugStatus(slugEditStatus, '', '');
      slugOverlay.classList.add('open');
    }

    function closeSlugEdit() {
      slugOverlay.classList.remove('open');
      slugTargetShop = null;
    }

    slugClose?.addEventListener('click', closeSlugEdit);
    slugOverlay?.addEventListener('click', (e) => {
      if (e.target === slugOverlay) closeSlugEdit();
    });

    slugSaveBtn?.addEventListener('click', async () => {
      clearMsg(slugMessage);

      const slug = slugify(slugEditInput.value);
      slugEditInput.value = slug;

      if (!slug) {
        setSlugStatus(slugEditStatus, 'bad', 'স্লাগ দিন — শুধু ইংরেজি ছোট অক্ষর, সংখ্যা ও হাইফেন (যেমন rahims-shop)');
        slugEditInput.focus();
        return;
      }

      if (slug === slugTargetShop.slug) {
        showMsg(slugMessage, 'এটাই বর্তমান স্লাগ — কোনো পরিবর্তন নেই');
        return;
      }

      slugSaveBtnText.textContent = 'সেভ হচ্ছে...';
      slugSaveBtn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/update-shop-slug', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ shopId: slugTargetShop.id, slug }),
        });
        const result = await res.json();

        if (!res.ok) {
          if (result.field === 'slug') {
            setSlugStatus(slugEditStatus, 'bad', result.error || 'Not Available');
          } else {
            showMsg(slugMessage, result.error || 'স্লাগ পরিবর্তন ব্যর্থ');
          }
        } else {
          showMsg(slugMessage, 'স্লাগ পরিবর্তন হয়েছে ✓', 'success');
          setTimeout(() => {
            closeSlugEdit();
            loadShops();
          }, 800);
        }
      } catch (err) {
        showMsg(slugMessage, 'নেটওয়ার্ক ত্রুটি: ' + err.message);
      }

      slugSaveBtnText.textContent = 'স্লাগ সেভ করুন';
      slugSaveBtn.disabled = false;
    });

    // ===== শপ তালিকা =====
    function renderShop(shop, index, total, ownerPhone) {
      const card = document.createElement('div');
      card.style.cssText = `background:#fff;border-radius:16px;padding:16px 18px;box-shadow:0 4px 16px rgba(15,23,42,0.06);${shop.is_active ? '' : 'opacity:0.6;'}`;

      card.innerHTML = `
        <div style="display:flex;align-items:center;gap:14px;">
          <div style="width:44px;height:44px;border-radius:12px;background:#FFF0EA;color:#FF6B35;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;">
            <i class="fas fa-store"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <p style="font-size:0.95rem;font-weight:700;color:#1B2A4A;">${esc(shop.name)}</p>
            <p style="font-size:0.78rem;color:#8FA0BC;">/${esc(shop.slug)} · ${esc(ownerPhone) || 'ওউনার নেই'} ${shop.is_active ? '' : '· নিষ্ক্রিয়'}</p>
          </div>
        </div>
        <div class="shop-actions" style="display:flex;gap:6px;flex-shrink:0;margin-top:12px;"></div>
      `;

      const actions = card.querySelector('.shop-actions');

      const upBtn = document.createElement('button');
      upBtn.innerHTML = '<i class="fas fa-arrow-up"></i>';
      upBtn.disabled = index === 0;
      upBtn.style.cssText = `background:#F4F7FC;color:#1B2A4A;border:none;width:34px;height:34px;border-radius:10px;cursor:${index === 0 ? 'not-allowed' : 'pointer'};opacity:${index === 0 ? '0.4' : '1'};`;
      upBtn.addEventListener('click', () => moveShop(shop, 'up'));
      actions.appendChild(upBtn);

      const downBtn = document.createElement('button');
      downBtn.innerHTML = '<i class="fas fa-arrow-down"></i>';
      downBtn.disabled = index === total - 1;
      downBtn.style.cssText = `background:#F4F7FC;color:#1B2A4A;border:none;width:34px;height:34px;border-radius:10px;cursor:${index === total - 1 ? 'not-allowed' : 'pointer'};opacity:${index === total - 1 ? '0.4' : '1'};`;
      downBtn.addEventListener('click', () => moveShop(shop, 'down'));
      actions.appendChild(downBtn);

      const reassignBtn = document.createElement('button');
      reassignBtn.innerHTML = '<i class="fas fa-user-pen"></i>';
      reassignBtn.title = 'ওউনার পরিবর্তন';
      reassignBtn.style.cssText = 'background:#EFF6FF;color:#2563EB;border:none;width:34px;height:34px;border-radius:10px;cursor:pointer;';
      reassignBtn.addEventListener('click', () => openReassign(shop));
      actions.appendChild(reassignBtn);

      // ===== স্লাগ (লিংক) পরিবর্তন বাটন =====
      const slugBtn = document.createElement('button');
      slugBtn.innerHTML = '<i class="fas fa-link"></i>';
      slugBtn.title = 'স্লাগ (লিংক) পরিবর্তন';
      slugBtn.style.cssText = 'background:#F3F0FF;color:#6D4AE0;border:none;width:34px;height:34px;border-radius:10px;cursor:pointer;';
      slugBtn.addEventListener('click', () => openSlugEdit(shop));
      actions.appendChild(slugBtn);

      const toggleBtn = document.createElement('button');
      toggleBtn.textContent = shop.is_active ? 'নিষ্ক্রিয় করুন' : 'সক্রিয় করুন';
      toggleBtn.style.cssText = shop.is_active
        ? 'background:#FFF0EA;color:#D14343;border:none;padding:8px 14px;border-radius:10px;font-size:0.78rem;font-weight:700;cursor:pointer;white-space:nowrap;flex:1;'
        : 'background:#EAFBF0;color:#1B7A3C;border:none;padding:8px 14px;border-radius:10px;font-size:0.78rem;font-weight:700;cursor:pointer;white-space:nowrap;flex:1;';
      toggleBtn.addEventListener('click', () => toggleActive(shop.id, !shop.is_active));
      actions.appendChild(toggleBtn);

      // ===== ডিলিট বাটন — ২-ক্লিক কনফার্ম =====
      const deleteBtn = document.createElement('button');
      deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
      deleteBtn.title = 'শপ ডিলিট করুন';
      deleteBtn.style.cssText = 'background:#FFF0EA;color:#D14343;border:none;width:34px;height:34px;border-radius:10px;cursor:pointer;flex-shrink:0;';
      let deleteConfirming = false;
      deleteBtn.addEventListener('click', () => {
        if (!deleteConfirming) {
          deleteConfirming = true;
          deleteBtn.innerHTML = '<span style="font-size:0.68rem;font-weight:700;white-space:nowrap;">নিশ্চিত?</span>';
          deleteBtn.style.width = 'auto';
          deleteBtn.style.padding = '0 10px';
          deleteBtn.style.background = '#D14343';
          deleteBtn.style.color = '#fff';
          setTimeout(() => {
            if (deleteConfirming) {
              deleteConfirming = false;
              deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
              deleteBtn.style.width = '34px';
              deleteBtn.style.padding = '0';
              deleteBtn.style.background = '#FFF0EA';
              deleteBtn.style.color = '#D14343';
            }
          }, 3000);
          return;
        }
        deleteShop(shop, deleteBtn);
      });
      actions.appendChild(deleteBtn);

      return card;
    }

    async function deleteShop(shop, btn) {
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
      btn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/delete-shop', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ shopId: shop.id }),
        });
        const result = await res.json();

        if (!res.ok) {
          alert('ডিলিট ব্যর্থ: ' + (result.error || 'অজানা ত্রুটি'));
          btn.innerHTML = '<i class="fas fa-trash"></i>';
          btn.disabled = false;
          return;
        }

        loadShops();
      } catch (err) {
        alert('নেটওয়ার্ক ত্রুটি: ' + err.message);
        btn.innerHTML = '<i class="fas fa-trash"></i>';
        btn.disabled = false;
      }
    }

    let allShops = [];

    async function moveShop(shop, direction) {
      const idx = allShops.findIndex((s) => s.id === shop.id);
      const swapIdx = direction === 'up' ? idx - 1 : idx + 1;
      if (swapIdx < 0 || swapIdx >= allShops.length) return;

      const other = allShops[swapIdx];
      const tempOrder = shop.shop_order;

      await Promise.all([
        supabase.from('shops').update({ shop_order: other.shop_order }).eq('id', shop.id),
        supabase.from('shops').update({ shop_order: tempOrder }).eq('id', other.id),
      ]);

      loadShops();
    }

    async function toggleActive(id, newState) {
      const { error } = await supabase.from('shops').update({ is_active: newState }).eq('id', id);
      if (error) {
        alert('আপডেট ব্যর্থ: ' + error.message);
        return;
      }
      loadShops();
    }

    async function loadShops() {
      container.innerHTML = '<p style="text-align:center;color:#8FA0BC;padding:40px 0;">লোড হচ্ছে...</p>';

      const { data, error } = await supabase
        .from('shops')
        .select('*')
        .order('shop_order', { ascending: true })
        .order('created_at', { ascending: true });

      if (error) {
        container.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${esc(error.message)}</p>`;
        return;
      }

      allShops = data || [];
      resultCount.textContent = `মোট ${allShops.length} টি শপ`;
      container.innerHTML = '';

      if (allShops.length === 0) {
        emptyState.style.display = 'flex';
        return;
      }

      emptyState.style.display = 'none';

      const ownerIds = allShops.map((s) => s.owner_id).filter(Boolean);
      let phoneMap = {};
      if (ownerIds.length > 0) {
        const { data: owners } = await supabase.from('profiles').select('id, phone').in('id', ownerIds);
        (owners || []).forEach((o) => { phoneMap[o.id] = o.phone; });
      }

      allShops.forEach((shop, i) => container.appendChild(renderShop(shop, i, allShops.length, phoneMap[shop.owner_id])));
    }

    window.addEventListener('smartfeni:admin-ready', () => {
      loadRequests();
      loadShops();
    });

    initAdminGuard();
  </script>
</BaseLayout>
