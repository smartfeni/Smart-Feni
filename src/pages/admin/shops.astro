    }

    .sc-btn {
      border: none;
      border-radius: 10px;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.74rem;
      font-weight: 700;
      min-width: 34px;
      height: 34px;
      padding: 0 11px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      text-decoration: none;
      white-space: nowrap;
    }

    .sc-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .sc-btn.verify { background: #EFF6FF; color: #2563EB; }
    .sc-btn.verify.on { background: #2563EB; color: #fff; }
    .sc-btn.act-off { background: #FFF0EA; color: #D14343; }
    .sc-btn.act-on { background: #EAFBF0; color: #1B7A3C; }
    .sc-btn.gray { background: #F4F7FC; color: #1B2A4A; }
    .sc-btn.purple { background: #F3F0FF; color: #6D4AE0; }
    .sc-btn.blue { background: #EFF6FF; color: #2563EB; }
    .sc-btn.del { background: #FFF0EA; color: #D14343; }
    .sc-btn.del.confirm { background: #D14343; color: #fff; }

    /* শপের ধরন মোডাল */
    .type-chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .type-chip {
      border: 1.5px solid #E5EAF0;
      background: #fff;
      color: #1B2A4A;
      padding: 7px 14px;
      border-radius: 40px;
      font-size: 0.82rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
    }

    .type-chip.sel {
      background: #FF6B35;
      border-color: #FF6B35;
      color: #fff;
    }

    .type-count {
      font-size: 0.76rem;
      color: #8FA0BC;
      margin-top: 10px;
    }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';
    import { slugify } from '../../lib/slugRules.js';

    const container = document.getElementById('shopsContainer');
    const emptyState = document.getElementById('emptyState');
    const resultCount = document.getElementById('resultCount');

    const createMessage = document.getElementById('createMessage');
    const createBtn = document.getElementById('createShopBtn');
    const createBtnText = document.getElementById('createBtnText');

    document.getElementById('showCreateFormBtn')?.addEventListener('click', () => {
      document.getElementById('createFormBox').style.display = 'block';
      document.getElementById('showCreateFormBtn').style.display = 'none';
    });

    function showMsg(el, text, type = 'error') {
      el.textContent = text;
      el.className = `form-message ${type === 'error' ? 'show-error' : 'show-success'}`;
    }

    function clearMsg(el) {
      el.textContent = '';
      el.className = 'form-message';
    }

    // ইউজারের দেওয়া টেক্সট innerHTML-এ বসানোর আগে এস্কেপ (স্টোর্ড XSS ঠেকাতে)
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    // ===== স্লাগ লাইভ চেক (পেন্ডিং কার্ড + স্লাগ মোডাল দুটোতেই ব্যবহার) =====
    function setSlugStatus(el, type, text) {
      el.textContent = text || '';
      el.className = 'slug-status' + (type ? ` slug-${type}` : '');
    }

    async function checkSlugOnServer(slug, excludeShopId) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/check-shop-slug', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ slug, excludeShopId }),
        });
        const result = await res.json();
        if (!res.ok) {
          return { available: false, error: result.error || 'স্লাগ চেক করা যায়নি' };
        }
        return result;
      } catch (err) {
        return { available: false, error: 'নেটওয়ার্ক ত্রুটি: ' + err.message };
      }
    }

    // input-এ টাইপ করলে (৪৫০ms থেমে) আর "চেক" বাটনে চাপলে স্লাগ চেক করে স্ট্যাটাস দেখায়।
    // getExcludeId: স্লাগ এডিটের সময় নিজের শপের id ফেরত দেয়; পেন্ডিং আবেদনে undefined।
    function attachSlugChecker(input, statusEl, getExcludeId = () => undefined) {
      let timer = null;
      let seq = 0;

      async function run() {
        clearTimeout(timer);
        const cleaned = slugify(input.value);
        if (!cleaned) {
          seq++;
          setSlugStatus(statusEl, '', '');
          return null;
        }

        const mySeq = ++seq;
        setSlugStatus(statusEl, 'checking', 'চেক হচ্ছে...');
        const result = await checkSlugOnServer(cleaned, getExcludeId());

        // পরে আরেকটা চেক শুরু হয়ে গেলে এটার ফল বাদ
        if (mySeq !== seq) return null;

        if (result.available) {
          setSlugStatus(statusEl, 'ok', `✓ Available — smartfeni.com/${cleaned}`);
        } else {
          setSlugStatus(statusEl, 'bad', result.error || 'Not Available');
        }
        return result;
      }

      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(run, 450);
      });

      input.addEventListener('blur', () => {
        const cleaned = slugify(input.value);
        if (input.value && cleaned !== input.value) input.value = cleaned;
      });

      return { run };
    }

    // ===== ম্যানুয়াল শপ তৈরি =====
    createBtn?.addEventListener('click', async () => {
      clearMsg(createMessage);

      if (!window.SFValidateForm(document.getElementById('createFormBox'))) {
        return;
      }

      const shopName = document.getElementById('shopNameInput').value.trim();
      const slug = document.getElementById('shopSlugInput').value.trim();
      const phone = document.getElementById('shopPhoneInput').value.trim();
      const password = document.getElementById('shopPasswordInput').value;

      createBtnText.textContent = 'তৈরি হচ্ছে...';
      createBtn.disabled = true;

      try {
        const res = await fetch('/api/create-shop', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ shopName, slug, phone, password }),
        });
        const result = await res.json();

        if (!res.ok) {
          showMsg(createMessage, result.error || 'শপ তৈরি ব্যর্থ');
        } else {
          showMsg(createMessage, 'শপ সফলভাবে তৈরি হয়েছে ✓', 'success');
          document.getElementById('shopNameInput').value = '';
          document.getElementById('shopSlugInput').value = '';
          document.getElementById('shopPhoneInput').value = '';
          document.getElementById('shopPasswordInput').value = '';
          loadShops();
        }
      } catch (err) {
        showMsg(createMessage, 'নেটওয়ার্ক ত্রুটি: ' + err.message);
      }

      createBtnText.textContent = 'শপ তৈরি করুন';
      createBtn.disabled = false;
    });

    // ===== পেন্ডিং আবেদন =====
    const requestsContainer = document.getElementById('requestsContainer');
    const noRequestsMsg = document.getElementById('noRequestsMsg');
    const pendingCountBadge = document.getElementById('pendingCountBadge');

    async function loadRequests() {
      const { data, error } = await supabase
        .from('shop_requests')
        .select('*')
        .eq('status', 'pending')
        .order('created_at', { ascending: true });

      if (error) {
        console.error('আবেদন লোড এরর:', error.message);
        return;
      }

      const requests = data || [];
      requestsContainer.innerHTML = '';

      if (requests.length === 0) {
        noRequestsMsg.style.display = 'block';
        pendingCountBadge.style.display = 'none';
        return;
      }

      noRequestsMsg.style.display = 'none';
      pendingCountBadge.style.display = 'inline-block';
      pendingCountBadge.textContent = requests.length;

      requests.forEach((req) => {
        const card = document.createElement('div');
        card.className = 'request-card';
        card.innerHTML = `
          <p class="request-name">${esc(req.shop_name)}</p>
          <p class="request-meta"><i class="fas fa-phone"></i> ${esc(req.phone)} · ${new Date(req.created_at).toLocaleDateString('bn-BD')}</p>
          ${req.message ? `<p class="request-message">${esc(req.message)}</p>` : ''}
          <div class="slug-box">
            <label class="slug-label">স্লাগ (smartfeni.com/<b>…</b>)</label>
            <div class="slug-row">
              <input type="text" class="form-input slug-input" placeholder="ইংরেজিতে লিখুন, যেমন rahims-shop" autocomplete="off" autocapitalize="none" />
              <button type="button" class="slug-check-btn">চেক</button>
            </div>
            <p class="slug-status"></p>
          </div>
          <div class="request-actions">
            <button class="btn-approve"><i class="fas fa-check"></i> Approve</button>
            <button class="btn-reject"><i class="fas fa-xmark"></i> Reject</button>
          </div>
        `;

        const slugInput = card.querySelector('.slug-input');
        const slugStatus = card.querySelector('.slug-status');

        // শপের নাম ইংরেজি হলে সাজেস্টেড স্লাগ বসে; বাংলা হলে ফাঁকা থাকে (অ্যাডমিন নিজে লিখবে)
        const suggested = slugify(req.shop_name);
        if (suggested.length >= 3) slugInput.value = suggested;

        const checker = attachSlugChecker(slugInput, slugStatus);
        card.querySelector('.slug-check-btn').addEventListener('click', () => checker.run());
        if (slugInput.value) checker.run();

        card.querySelector('.btn-approve').addEventListener('click', (e) => {
          approveRequest(req, e.target.closest('button'), slugInput, slugStatus);
        });
        card.querySelector('.btn-reject').addEventListener('click', () => rejectRequest(req.id));

        requestsContainer.appendChild(card);
      });
    }

    async function approveRequest(req, btn, slugInput, slugStatus) {
      const slug = slugify(slugInput.value);
      slugInput.value = slug;

      if (!slug) {
        setSlugStatus(slugStatus, 'bad', 'স্লাগ দিন — শুধু ইংরেজি ছোট অক্ষর, সংখ্যা ও হাইফেন (যেমন rahims-shop)');
        slugInput.focus();
        return;
      }

      const originalHtml = btn.innerHTML;
      btn.innerHTML = 'অপেক্ষা করুন...';
      btn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/approve-shop-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ requestId: req.id, slug }),
        });
        const result = await res.json();

        if (!res.ok) {
          if (result.field === 'slug') {
            // স্লাগ কনফ্লিক্ট/ফরম্যাট এরর — alert না, বক্সের নিচেই দেখাও
            setSlugStatus(slugStatus, 'bad', result.error || 'Not Available');
            slugInput.focus();
          } else {
            alert('Approve ব্যর্থ: ' + (result.error || 'অজানা ত্রুটি'));
          }
          btn.innerHTML = originalHtml;
          btn.disabled = false;
          return;
        }

        loadRequests();
        loadShops();
      } catch (err) {
        alert('নেটওয়ার্ক ত্রুটি: ' + err.message);
        btn.innerHTML = originalHtml;
        btn.disabled = false;
      }
    }

    async function rejectRequest(id) {
      if (!confirm('এই আবেদনটি বাতিল করতে চান?')) return;

      const { error } = await supabase.from('shop_requests').update({ status: 'rejected' }).eq('id', id);
      if (error) {
        alert('বাতিল ব্যর্থ: ' + error.message);
        return;
      }
      loadRequests();
    }

    // ===== ওউনার পরিবর্তন মোডাল =====
    const reassignOverlay = document.getElementById('reassignOverlay');
    const reassignClose = document.getElementById('reassignClose');
    const reassignShopName = document.getElementById('reassignShopName');
    const reassignMessage = document.getElementById('reassignMessage');
    const reassignPhoneInput = document.getElementById('reassignPhoneInput');
    const reassignSubmitBtn = document.getElementById('reassignSubmitBtn');
    const reassignBtnText = document.getElementById('reassignBtnText');
    let reassignTargetShop = null;

    function openReassign(shop) {
      reassignTargetShop = shop;
      reassignShopName.textContent = shop.name;
      reassignPhoneInput.value = '';
      clearMsg(reassignMessage);
      reassignOverlay.classList.add('open');
    }

    function closeReassign() {
      reassignOverlay.classList.remove('open');
      reassignTargetShop = null;
    }

    reassignClose?.addEventListener('click', closeReassign);
    reassignOverlay?.addEventListener('click', (e) => {
      if (e.target === reassignOverlay) closeReassign();
    });

    reassignSubmitBtn?.addEventListener('click', async () => {
      clearMsg(reassignMessage);
      if (!window.SFValidateForm(document.querySelector('#reassignOverlay .modal-box'))) {
        return;
      }

      const newPhone = reassignPhoneInput.value.trim();

      reassignBtnText.textContent = 'পরিবর্তন হচ্ছে...';
      reassignSubmitBtn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/reassign-shop-owner', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ shopId: reassignTargetShop.id, newOwnerPhone: newPhone }),
        });
        const result = await res.json();

        if (!res.ok) {
          showMsg(reassignMessage, result.error || 'পরিবর্তন ব্যর্থ');
        } else {
          showMsg(reassignMessage, 'ওউনার পরিবর্তন হয়েছে ✓', 'success');
          setTimeout(() => {
            closeReassign();
            loadShops();
          }, 800);
        }
      } catch (err) {
        showMsg(reassignMessage, 'নেটওয়ার্ক ত্রুটি: ' + err.message);
      }

      reassignBtnText.textContent = 'পরিবর্তন করুন';
      reassignSubmitBtn.disabled = false;
    });

    // ===== স্লাগ (লিংক) পরিবর্তন মোডাল =====
    const slugOverlay = document.getElementById('slugOverlay');
    const slugClose = document.getElementById('slugClose');
    const slugShopName = document.getElementById('slugShopName');
    const slugCurrent = document.getElementById('slugCurrent');
    const slugMessage = document.getElementById('slugMessage');
    const slugEditInput = document.getElementById('slugEditInput');
    const slugEditStatus = document.getElementById('slugEditStatus');
    const slugSaveBtn = document.getElementById('slugSaveBtn');
    const slugSaveBtnText = document.getElementById('slugSaveBtnText');
    let slugTargetShop = null;

    // নিজের শপকে চেক থেকে বাদ দেওয়ার জন্য getter (মোডাল খোলার সময় slugTargetShop বদলায়)
    attachSlugChecker(slugEditInput, slugEditStatus, () => slugTargetShop?.id);

    function openSlugEdit(shop) {
      slugTargetShop = shop;
      slugShopName.textContent = shop.name;
      slugCurrent.textContent = `বর্তমান: smartfeni.com/${shop.slug}`;
      slugEditInput.value = shop.slug || '';
      clearMsg(slugMessage);
      setSlugStatus(slugEditStatus, '', '');
      slugOverlay.classList.add('open');
    }

    function closeSlugEdit() {
      slugOverlay.classList.remove('open');
      slugTargetShop = null;
    }

    slugClose?.addEventListener('click', closeSlugEdit);
    slugOverlay?.addEventListener('click', (e) => {
      if (e.target === slugOverlay) closeSlugEdit();
    });

    slugSaveBtn?.addEventListener('click', async () => {
      clearMsg(slugMessage);

      const slug = slugify(slugEditInput.value);
      slugEditInput.value = slug;

      if (!slug) {
        setSlugStatus(slugEditStatus, 'bad', 'স্লাগ দিন — শুধু ইংরেজি ছোট অক্ষর, সংখ্যা ও হাইফেন (যেমন rahims-shop)');
        slugEditInput.focus();
        return;
      }

      if (slug === slugTargetShop.slug) {
        showMsg(slugMessage, 'এটাই বর্তমান স্লাগ — কোনো পরিবর্তন নেই');
        return;
      }

      slugSaveBtnText.textContent = 'সেভ হচ্ছে...';
      slugSaveBtn.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/update-shop-slug', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ shopId: slugTargetShop.id, slug }),
        });
        const result = await res.json();

        if (!res.ok) {
          if (result.field === 'slug') {
            setSlugStatus(slugEditStatus, 'bad', result.error || 'Not Available');
          } else {
            showMsg(slugMessage, result.error || 'স্লাগ পরিবর্তন ব্যর্থ');
          }
        } else {
          showMsg(slugMessage, 'স্লাগ পরিবর্তন হয়েছে ✓', 'success');
          setTimeout(() => {
            closeSlugEdit();
            loadShops();
          }, 800);
        }
      } catch (err) {
        showMsg(slugMessage, 'নেটওয়ার্ক ত্রুটি: ' + err.message);
      }

      slugSaveBtnText.textContent = 'স্লাগ সেভ করুন';
      slugSaveBtn.disabled = false;
    });

    // ===== শপ তালিকা (ব্যাচ ৫) =====
    const bn = (n) => String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
    const statsEl = document.getElementById('shopStats');
    const filterChipsEl = document.getElementById('shopFilterChips');
    const filterSearchEl = document.getElementById('shopFilterSearch');
    const DAY_NAMES = ['রবি', 'সোম', 'মঙ্গল', 'বুধ', 'বৃহ', 'শুক্র', 'শনি'];
    const FILTERS = [
      { id: 'all', label: 'সব' },
      { id: 'live', label: 'লাইভ' },
      { id: 'hidden', label: 'লুকানো' },
      { id: 'inactive', label: 'নিষ্ক্রিয়' },
      { id: 'nocat', label: 'ধরন ছাড়া' },
      { id: 'unverified', label: 'ভেরিফায়েড নয়' },
    ];

    let allShops = [];
    let phoneMap = {};
    let productCountMap = {};
    let shopTypes = [];
    let typeNameMap = {};
    let activeFilter = 'all';
    let searchText = '';

    // DB ফাংশন shop_is_open_now() এর JS রূপ (বাংলাদেশ সময়) — শুধু অ্যাডমিন ব্যাজের জন্য
    function isOpenNow(shop) {
      if (shop.temporarily_closed) return false;
      const h = shop.opening_hours;
      if (!h) return true;
      const d = new Date(Date.now() + 6 * 3600 * 1000);
      const dow = d.getUTCDay();
      const mins = d.getUTCHours() * 60 + d.getUTCMinutes();
      if (Array.isArray(h.off_days) && h.off_days.map(Number).includes(dow)) return false;
      const toM = (t) => {
        const [a, b] = String(t || '').split(':').map(Number);
        return Number.isFinite(a) && Number.isFinite(b) ? a * 60 + b : null;
      };
      const o = toM(h.open);
      const c = toM(h.close);
      if (o === null || c === null || o === c) return true;
      return o < c ? (mins >= o && mins < c) : (mins >= o || mins < c);
    }

    function isLive(shop) {
      return !!shop.is_active && isOpenNow(shop);
    }

    function hoursSummary(shop) {
      if (shop.temporarily_closed) return 'সাময়িক বন্ধ';
      const h = shop.opening_hours;
      if (!h) return 'সবসময় খোলা';
      const parts = [];
      if (h.open && h.close && h.open !== h.close) parts.push(`${bn(h.open)} – ${bn(h.close)}`);
      else parts.push('সারাদিন');
      if (Array.isArray(h.off_days) && h.off_days.length) {
        parts.push('ছুটি: ' + h.off_days.map((n) => DAY_NAMES[Number(n)]).filter(Boolean).join(', '));
      }
      return parts.join(' · ');
    }

    function matchesFilter(shop) {
      switch (activeFilter) {
        case 'live': return isLive(shop);
        case 'hidden': return !!shop.is_active && !isOpenNow(shop);
        case 'inactive': return !shop.is_active;
        case 'nocat': return !(shop.category_slugs || []).length;
        case 'unverified': return !shop.is_verified;
        default: return true;
      }
    }

    function matchesSearch(shop) {
      const q = searchText.trim().toLowerCase();
      if (!q) return true;
      const hay = [shop.name, shop.slug, phoneMap[shop.owner_id], shop.phone]
        .map((v) => String(v || '').toLowerCase()).join(' ');
      return hay.includes(q);
    }

    function renderStats() {
      const total = allShops.length;
      const live = allShops.filter(isLive).length;
      const hidden = allShops.filter((s) => s.is_active && !isOpenNow(s)).length;
      const inactive = allShops.filter((s) => !s.is_active).length;
      statsEl.innerHTML = `
        <div class="shop-stat"><b>${bn(total)}</b><span>মোট শপ</span></div>
        <div class="shop-stat live"><b>${bn(live)}</b><span>লাইভ</span></div>
        <div class="shop-stat hid"><b>${bn(hidden)}</b><span>লুকানো</span></div>
        <div class="shop-stat"><b>${bn(inactive)}</b><span>নিষ্ক্রিয়</span></div>`;
      resultCount.textContent = `মোট ${bn(total)} টি শপ`;
    }

    function renderFilterChips() {
      filterChipsEl.innerHTML = '';
      FILTERS.forEach((f) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'filter-chip' + (activeFilter === f.id ? ' sel' : '');
        b.textContent = f.label;
        b.addEventListener('click', () => {
          activeFilter = f.id;
          renderFilterChips();
          renderList();
        });
        filterChipsEl.appendChild(b);
      });
    }

    function btn(cls, html, title, onClick) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'sc-btn ' + cls;
      b.innerHTML = html;
      if (title) b.title = title;
      b.addEventListener('click', onClick);
      return b;
    }

    function renderShop(shop, canReorder, idx, total) {
      const live = isLive(shop);
      const ownerPhone = phoneMap[shop.owner_id];
      const types = (shop.category_slugs || []).map((s) => typeNameMap[s]).filter(Boolean);

      const card = document.createElement('div');
      card.className = 'shop-card-adm' + (shop.is_active ? '' : ' is-off');

      const statusBadge = !shop.is_active
        ? '<span class="sc-badge off">নিষ্ক্রিয়</span>'
        : live
          ? '<span class="sc-badge live">লাইভ</span>'
          : `<span class="sc-badge hid">লুকানো (${shop.temporarily_closed ? 'সাময়িক বন্ধ' : 'খোলার সময়ের বাইরে'})</span>`;

      const logo = shop.logo_image
        ? `<img src="${esc(shop.logo_image)}" alt="" loading="lazy" decoding="async" />`
        : '<i class="fas fa-store"></i>';

      card.innerHTML = `
        <div class="sc-top">
          <div class="sc-logo">${logo}</div>
          <div class="sc-info">
            <p class="sc-name">${esc(shop.name)}${shop.is_verified ? '<i class="fas fa-circle-check sc-verified"></i>' : ''}</p>
            <p class="sc-sub">/${esc(shop.slug)} · ${esc(ownerPhone) || 'ওউনার নেই'}</p>
            <div class="sc-badges">
              ${statusBadge}
              ${types.map((t) => `<span class="sc-badge type">${esc(t)}</span>`).join('')}
              ${types.length ? '' : '<span class="sc-badge">ধরন নেই</span>'}
            </div>
          </div>
        </div>
        <div class="sc-meta">
          <span><i class="fas fa-box"></i>${bn(productCountMap[shop.id] || 0)} প্রোডাক্ট</span>
          <span><i class="fas fa-clock"></i>${esc(hoursSummary(shop))}</span>
        </div>
        <div class="sc-actions"></div>
      `;

      const actions = card.querySelector('.sc-actions');

      actions.appendChild(btn(
        'verify' + (shop.is_verified ? ' on' : ''),
        `<i class="fas fa-circle-check"></i> ${shop.is_verified ? 'ভেরিফায়েড' : 'ভেরিফাই করুন'}`,
        'ভেরিফায়েড ব্যাজ',
        () => toggleVerified(shop.id, !shop.is_verified),
      ));

      actions.appendChild(btn(
        shop.is_active ? 'act-off' : 'act-on',
        shop.is_active ? 'নিষ্ক্রিয় করুন' : 'সক্রিয় করুন',
        '',
        () => toggleActive(shop.id, !shop.is_active),
      ));

      const view = document.createElement('a');
      view.className = 'sc-btn gray';
      view.href = '/' + encodeURIComponent(shop.slug);
      view.target = '_blank';
      view.rel = 'noopener';
      view.title = 'শপ দেখুন';
      view.innerHTML = '<i class="fas fa-arrow-up-right-from-square"></i>';
      actions.appendChild(view);

      actions.appendChild(btn('blue', '<i class="fas fa-tags"></i>', 'শপের ধরন', () => openTypeEdit(shop)));
      actions.appendChild(btn('blue', '<i class="fas fa-user-pen"></i>', 'ওউনার পরিবর্তন', () => openReassign(shop)));
      actions.appendChild(btn('purple', '<i class="fas fa-link"></i>', 'স্লাগ (লিংক) পরিবর্তন', () => openSlugEdit(shop)));

      if (canReorder) {
        addDragHandle(card, shop);
        const up = btn('gray', '<i class="fas fa-arrow-up"></i>', 'উপরে', () => moveShop(shop, 'up'));
        up.disabled = idx === 0;
        const down = btn('gray', '<i class="fas fa-arrow-down"></i>', 'নিচে', () => moveShop(shop, 'down'));
        down.disabled = idx === total - 1;
        actions.appendChild(up);
        actions.appendChild(down);
      }

      // ডিলিট — ২-ক্লিক কনফার্ম
      let confirming = false;
      const del = btn('del', '<i class="fas fa-trash"></i>', 'শপ ডিলিট করুন', () => {
        if (!confirming) {
          confirming = true;
          del.classList.add('confirm');
          del.innerHTML = 'নিশ্চিত?';
          setTimeout(() => {
            if (confirming) {
              confirming = false;
              del.classList.remove('confirm');
              del.innerHTML = '<i class="fas fa-trash"></i>';
            }
          }, 3000);
          return;
        }
        deleteShop(shop, del);
      });
      actions.appendChild(del);

      return card;
    }

    function renderList() {
      renderStats();
      container.innerHTML = '';

      if (allShops.length === 0) {
        emptyState.style.display = 'flex';
        return;
      }
      emptyState.style.display = 'none';

      const visible = allShops.filter((s) => matchesFilter(s) && matchesSearch(s));

      if (visible.length === 0) {
        container.innerHTML = '<p style="text-align:center;color:#B0BCCB;padding:30px 0;font-size:0.88rem;">এই ফিল্টারে কোনো শপ নেই</p>';
        return;
      }

      // ক্রম বদল শুধু ফিল্টার/সার্চ ছাড়া পুরো তালিকায় (নইলে কে কার পাশে বোঝা যায় না)
      const canReorder = activeFilter === 'all' && !searchText.trim();
      visible.forEach((shop, i) => container.appendChild(renderShop(shop, canReorder, i, visible.length)));
    }

    filterSearchEl?.addEventListener('input', () => {
      searchText = filterSearchEl.value;
      renderList();
    });

    // ===== শপের ধরন মোডাল (সর্বোচ্চ ৩) =====
    const typeOverlay = document.getElementById('typeOverlay');
    const typeShopName = document.getElementById('typeShopName');
    const typeMessage = document.getElementById('typeMessage');
    const typeChips = document.getElementById('typeChips');
    const typeCount = document.getElementById('typeCount');
    const typeSaveBtn = document.getElementById('typeSaveBtn');
    const typeSaveBtnText = document.getElementById('typeSaveBtnText');
    let typeTargetShop = null;
    let typePicked = [];

    function renderTypeChips() {
      typeChips.innerHTML = '';
      shopTypes.forEach((t) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'type-chip' + (typePicked.includes(t.slug) ? ' sel' : '');
        b.textContent = t.name_bn;
        b.addEventListener('click', () => {
          if (typePicked.includes(t.slug)) {
            typePicked = typePicked.filter((s) => s !== t.slug);
          } else if (typePicked.length >= 3) {
            showMsg(typeMessage, 'সর্বোচ্চ ৩টা ধরন বাছা যাবে');
            return;
          } else {
            typePicked.push(t.slug);
          }
          clearMsg(typeMessage);
          renderTypeChips();
        });
        typeChips.appendChild(b);
      });
      typeCount.textContent = `${bn(typePicked.length)}/৩টা বাছা হয়েছে`;
    }

    function openTypeEdit(shop) {
      typeTargetShop = shop;
      typePicked = [...(shop.category_slugs || [])];
      typeShopName.textContent = shop.name;
      clearMsg(typeMessage);
      renderTypeChips();
      typeOverlay.classList.add('open');
    }

    function closeTypeEdit() {
      typeOverlay.classList.remove('open');
      typeTargetShop = null;
    }

    document.getElementById('typeClose')?.addEventListener('click', closeTypeEdit);
    typeOverlay?.addEventListener('click', (e) => {
      if (e.target === typeOverlay) closeTypeEdit();
    });

    typeSaveBtn?.addEventListener('click', async () => {
      if (!typeTargetShop) return;
      clearMsg(typeMessage);
      typeSaveBtnText.textContent = 'সেভ হচ্ছে...';
      typeSaveBtn.disabled = true;

      const { error } = await supabase
        .from('shops')
        .update({ category_slugs: typePicked })
        .eq('id', typeTargetShop.id);

      typeSaveBtnText.textContent = 'সেভ করুন';
      typeSaveBtn.disabled = false;

      if (error) {
        showMsg(typeMessage, 'সেভ ব্যর্থ: ' + error.message);
        return;
      }

      showMsg(typeMessage, 'শপের ধরন সেভ হয়েছে ✓', 'success');
      setTimeout(() => {
        closeTypeEdit();
        loadShops();
      }, 700);
    });

    // ===== অ্যাকশন =====
    async function deleteShop(shop, b) {
      b.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
      b.disabled = true;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/delete-shop', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ shopId: shop.id }),
        });
        const result = await res.json();

        if (!res.ok) {
          alert('ডিলিট ব্যর্থ: ' + (result.error || 'অজানা ত্রুটি'));
          b.innerHTML = '<i class="fas fa-trash"></i>';
          b.disabled = false;
          return;
        }

        loadShops();
      } catch (err) {
        alert('নেটওয়ার্ক ত্রুটি: ' + err.message);
        b.innerHTML = '<i class="fas fa-trash"></i>';
        b.disabled = false;
      }
    }

    // ===== ড্র্যাগ করে ক্রম বদল =====
    // হ্যান্ডেল ধরলেই কার্ড আঙুলের সাথে যায় (position: fixed), আসল জায়গায় ফাঁকা placeholder থাকে।
    // স্ক্রিনের উপর/নিচ কিনারায় নিলে পেজ নিজে স্ক্রল করে। ছাড়লে সেখানে বসে ও সেভ হয়।
    let shopDrag = null;

    function addDragHandle(card, shop) {
      const top = card.querySelector('.sc-top');
      if (!top) return;
      card.dataset.shopId = shop.id;

      const grip = document.createElement('div');
      grip.className = 'sc-grip';
      grip.title = 'ধরে রেখে উপরে-নিচে টানুন';
      grip.setAttribute('aria-label', 'ক্রম বদলাতে ধরে টানুন');
      grip.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 8h14M5 12h14M5 16h14"/></svg>';
      grip.addEventListener('contextmenu', (e) => e.preventDefault());
      grip.addEventListener('pointerdown', (e) => startShopDrag(e, card, shop, grip));
      top.appendChild(grip);
    }

    function startShopDrag(e, card, shop, grip) {
      if (shopDrag) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      e.preventDefault();

      const rect = card.getBoundingClientRect();
      const placeholder = document.createElement('div');
      placeholder.className = 'shop-drag-placeholder';
      placeholder.style.height = rect.height + 'px';
      container.insertBefore(placeholder, card);

      card.classList.add('is-dragging');
      card.style.top = rect.top + 'px';
      card.style.left = rect.left + 'px';
      card.style.width = rect.width + 'px';

      const onMove = (ev) => {
        if (!shopDrag || ev.pointerId !== shopDrag.id) return;
        shopDrag.lastY = Math.max(0, Math.min(window.innerHeight, ev.clientY));
        card.style.top = (ev.clientY - shopDrag.offsetY) + 'px';
        updateShopPlaceholder();
      };
      const onUp = (ev) => endShopDrag(ev, false);
      const onCancel = (ev) => endShopDrag(ev, true);

      shopDrag = {
        id: e.pointerId, card, shop, grip, placeholder,
        offsetY: e.clientY - rect.top, lastY: e.clientY, raf: 0,
        onMove, onUp, onCancel,
      };

      try { grip.setPointerCapture(e.pointerId); } catch (_) {}
      grip.addEventListener('pointermove', onMove);
      grip.addEventListener('pointerup', onUp);
      grip.addEventListener('pointercancel', onCancel);

      shopDrag.raf = requestAnimationFrame(shopDragLoop);
    }

    // কার্ডের মাঝামাঝি কোন কার্ডের আগে পড়ছে — placeholder সেখানে সরাও
    function updateShopPlaceholder() {
      const d = shopDrag;
      if (!d) return;
      const cr = d.card.getBoundingClientRect();
      const centerY = cr.top + cr.height / 2;

      let before = null;
      for (const el of container.children) {
        if (el === d.card || el === d.placeholder) continue;
        const r = el.getBoundingClientRect();
        if (r.top + r.height / 2 > centerY) {
          before = el;
          break;
        }
      }

      let cur = d.placeholder.nextElementSibling;
      while (cur === d.card) cur = cur.nextElementSibling;
      if (cur !== before) container.insertBefore(d.placeholder, before);
    }

    // কিনারার ৯০px-এর ভেতরে আঙুল গেলে পেজ অটো-স্ক্রল (কিনারার যত কাছে তত দ্রুত)
    function shopDragLoop() {
      const d = shopDrag;
      if (!d) return;
      const zone = 90;
      const vh = window.innerHeight;
      let dy = 0;
      if (d.lastY < zone) dy = -Math.ceil(((zone - d.lastY) / zone) * 18);
      else if (d.lastY > vh - zone) dy = Math.ceil(((d.lastY - (vh - zone)) / zone) * 18);
      if (dy) {
        window.scrollBy(0, dy);
        updateShopPlaceholder();
      }
      d.raf = requestAnimationFrame(shopDragLoop);
    }

    function endShopDrag(e, cancelled) {
      const d = shopDrag;
      if (!d || e.pointerId !== d.id) return;
      shopDrag = null;

      cancelAnimationFrame(d.raf);
      d.grip.removeEventListener('pointermove', d.onMove);
      d.grip.removeEventListener('pointerup', d.onUp);
      d.grip.removeEventListener('pointercancel', d.onCancel);
      try { d.grip.releasePointerCapture(e.pointerId); } catch (_) {}

      d.card.classList.remove('is-dragging');
      d.card.removeAttribute('style');

      if (cancelled) {
        d.placeholder.remove();
        renderList(); // আগের ক্রমে ফিরে যাও
        return;
      }

      container.insertBefore(d.card, d.placeholder);
      d.placeholder.remove();
      saveShopOrder();
    }

    async function saveShopOrder() {
      // হ্যান্ডেল শুধু ফিল্টার/সার্চ ছাড়া পুরো তালিকায় আছে, তাই container-এ সব শপই আছে
      const byId = new Map(allShops.map((s) => [s.id, s]));
      const reordered = [...container.querySelectorAll('.shop-card-adm')]
        .map((c) => byId.get(c.dataset.shopId))
        .filter(Boolean);

      if (reordered.length !== allShops.length) {
        loadShops();
        return;
      }

      // সবার shop_order 0,1,2… — শুধু যেগুলো বদলেছে সেগুলো আপডেট (moveShop-এর মতোই)
      const changed = reordered.map((s, i) => ({ s, i })).filter((x) => x.s.shop_order !== x.i);
      if (changed.length === 0) return;

      changed.forEach((x) => { x.s.shop_order = x.i; });
      allShops = reordered;
      renderList();

      const results = await Promise.all(
        changed.map((x) => supabase.from('shops').update({ shop_order: x.i }).eq('id', x.s.id))
      );
      const failed = results.find((r) => r.error);
      if (failed) {
        alert('ক্রম বদল ব্যর্থ: ' + failed.error.message);
        loadShops();
      }
    }

    async function moveShop(shop, direction) {
      const idx = allShops.findIndex((s) => s.id === shop.id);
      const swapIdx = direction === 'up' ? idx - 1 : idx + 1;
      if (swapIdx < 0 || swapIdx >= allShops.length) return;

      const reordered = [...allShops];
      [reordered[idx], reordered[swapIdx]] = [reordered[swapIdx], reordered[idx]];

      // সবার shop_order নতুন করে 0,1,2… (আগে সমান থাকলেও অদলবদল কাজ করে)
      const changed = reordered.map((s, i) => ({ s, i })).filter((x) => x.s.shop_order !== x.i);
      const results = await Promise.all(
        changed.map((x) => supabase.from('shops').update({ shop_order: x.i }).eq('id', x.s.id))
      );
      const failed = results.find((r) => r.error);
      if (failed) alert('ক্রম বদল ব্যর্থ: ' + failed.error.message);

      loadShops();
    }

    async function toggleActive(id, newState) {
      const { error } = await supabase.from('shops').update({ is_active: newState }).eq('id', id);
      if (error) {
        alert('আপডেট ব্যর্থ: ' + error.message);
        return;
      }
      loadShops();
    }

    async function toggleVerified(id, newState) {
      const { error } = await supabase.from('shops').update({ is_verified: newState }).eq('id', id);
      if (error) {
        alert('আপডেট ব্যর্থ: ' + error.message);
        return;
      }
      loadShops();
    }

    async function loadShops() {
      container.innerHTML = '<p style="text-align:center;color:#8FA0BC;padding:40px 0;">লোড হচ্ছে...</p>';

      const [shopsRes, typesRes, countsRes] = await Promise.all([
        supabase.from('shops').select('*')
          .order('shop_order', { ascending: true })
          .order('created_at', { ascending: true }),
        supabase.from('shop_categories').select('slug, name_bn, sort_order').order('sort_order', { ascending: true }),
        supabase.from('listings').select('shop_id')
          .eq('category', 'online-shop').eq('status', 'active').limit(5000),
      ]);

      if (shopsRes.error) {
        container.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${esc(shopsRes.error.message)}</p>`;
        return;
      }

      allShops = shopsRes.data || [];

      shopTypes = typesRes.data || [];
      typeNameMap = {};
      shopTypes.forEach((t) => { typeNameMap[t.slug] = t.name_bn; });

      productCountMap = {};
      (countsRes.data || []).forEach((r) => {
        productCountMap[r.shop_id] = (productCountMap[r.shop_id] || 0) + 1;
      });

      const ownerIds = allShops.map((s) => s.owner_id).filter(Boolean);
      phoneMap = {};
      if (ownerIds.length > 0) {
        const { data: owners } = await supabase.from('profiles').select('id, phone').in('id', ownerIds);
        (owners || []).forEach((o) => { phoneMap[o.id] = o.phone; });
      }

      renderFilterChips();
      renderList();
    }

    window.addEventListener('smartfeni:admin-ready', () => {
      loadRequests();
      loadShops();
    });

    initAdminGuard();
  </script>
</BaseLayout>
