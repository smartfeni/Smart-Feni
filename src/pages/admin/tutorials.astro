---
// ============================================================
// পেজ: টিউটোরিয়াল ও ইনফো ম্যানেজমেন্ট (/admin/tutorials)
// শুধু admin (RLS: is_admin())। moderator/স্টাফ ঢুকলে /admin-এ ফেরত।
// কাজ: ⓘ বাটনের ব্যাখ্যা লেখা, YouTube ভিডিও লিংক বসানো/বদলানো, চালু/বন্ধ, নতুন টপিক
// ভিডিও YouTube-এ আপলোড করে (Unlisted চলবে) লিংক এখানে বসান; কোড ডেপ্লয় লাগে না।
// প্যাটার্ন: adminGuard.js + smartfeni:admin-ready (বাকি admin পেজের মতোই)
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="টিউটোরিয়াল ম্যানেজমেন্ট | স্মার্ট ফেনী">
  <div class="tuta-page">
    <div class="container">

      <div id="adminLoadingState" class="tuta-loading">
        <div class="tuta-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <div id="adminGuardedContent" style="display:none;">

        <a href="/admin" class="tuta-back"><i class="fas fa-arrow-left"></i> অ্যাডমিন ড্যাশবোর্ড</a>
        <h1 class="tuta-title">টিউটোরিয়াল ও ইনফো</h1>
        <p class="tuta-sub">সাইটের ⓘ বাটনে যা দেখায় তা এখানে বদলান। ভিডিও YouTube-এ আপলোড করে (Unlisted চলবে) লিংক বসান।</p>

        <!-- ===== ফর্ম (যোগ / এডিট) ===== -->
        <div class="tuta-card" id="formCard">
          <div class="tuta-card-h" id="formTitle">নতুন টপিক যোগ করুন</div>

          <div id="keyWrap">
            <label class="tuta-lbl" for="fKey">টপিক কী (ইংরেজি ছোট হাতের, - দিয়ে)<span class="required-mark">*</span></label>
            <input class="tuta-in" id="fKey" placeholder="যেমন: lost-found" maxlength="40" autocomplete="off" required />
            <div class="field-error-msg" data-error-for="fKey"><i class="fas fa-circle-exclamation"></i><span>টপিক কী লিখুন</span></div>
          </div>

          <label class="tuta-lbl" for="fTitle">শিরোনাম<span class="required-mark">*</span></label>
          <input class="tuta-in" id="fTitle" placeholder="যেমন: ডেলিভারি হিরো কীভাবে কাজ করে" maxlength="100" required />
          <div class="field-error-msg" data-error-for="fTitle"><i class="fas fa-circle-exclamation"></i><span>শিরোনাম লিখুন</span></div>

          <label class="tuta-lbl" for="fDesc">ছোট ব্যাখ্যা (সর্বোচ্চ ৬০০ অক্ষর)</label>
          <textarea class="tuta-in" id="fDesc" rows="5" maxlength="600" placeholder="২-৪ লাইনে সহজ ভাষায় লিখুন"></textarea>

          <label class="tuta-lbl" for="fVideo">YouTube ভিডিও লিংক (ঐচ্ছিক)</label>
          <input class="tuta-in" id="fVideo" type="url" inputmode="url" placeholder="https://youtu.be/..." maxlength="300" autocomplete="off" />

          <label class="tuta-lbl" for="fSort">সিরিয়াল (ছোট নম্বর আগে)</label>
          <input class="tuta-in" id="fSort" type="number" inputmode="numeric" value="100" />

          <label class="tuta-check"><input type="checkbox" id="fActive" checked /> সাইটে দেখান</label>

          <p class="tuta-err" id="formErr" style="display:none;"></p>

          <div class="tuta-actions">
            <button class="tuta-btn tuta-primary" id="saveBtn" type="button">সেভ করুন</button>
            <button class="tuta-btn tuta-ghost" id="cancelBtn" type="button" style="display:none;">বাতিল</button>
          </div>
        </div>

        <!-- ===== তালিকা ===== -->
        <div class="tuta-card-h" style="margin-top:22px;">সব টপিক <span id="countLbl"></span></div>
        <div id="listWrap"><p class="tuta-muted">লোড হচ্ছে...</p></div>

      </div>
    </div>
  </div>

  <style is:global>
    .tuta-page { min-height: 60vh; padding: 28px 0 90px; }
    .tuta-loading { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 120px 0; color: #5A6E85; font-weight: 600; }
    .tuta-spinner { width: 36px; height: 36px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: tutaSpin 0.8s linear infinite; }
    @keyframes tutaSpin { to { transform: rotate(360deg); } }

    .tuta-back { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: #64748B; text-decoration: none; margin-bottom: 10px; }
    .tuta-title { margin: 0; font-size: 1.5rem; font-weight: 800; color: #1B2A4A; }
    .tuta-sub { margin: 4px 0 16px; font-size: 0.84rem; color: #64748B; }
    .tuta-muted { font-size: 0.86rem; color: #64748B; padding: 8px 2px; }

    .tuta-card { background: #fff; border: 1px solid #E5EAF0; border-radius: 18px; padding: 16px; }
    .tuta-card-h { font-size: 0.95rem; font-weight: 800; color: #1B2A4A; margin-bottom: 8px; }
    .tuta-card-h span { font-weight: 600; color: #64748B; font-size: 0.8rem; }
    .tuta-lbl { display: block; margin: 12px 0 5px; font-size: 0.78rem; font-weight: 700; color: #64748B; }
    .tuta-in { width: 100%; border: 1.5px solid #E5EAF0; border-radius: 12px; padding: 11px 12px; font: inherit; font-size: 0.92rem; color: #1B2A4A; background: #fff; box-sizing: border-box; }
    .tuta-in:focus { outline: 0; border-color: #FF6B35; }
    textarea.tuta-in { resize: vertical; line-height: 1.6; }
    .tuta-check { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 0.88rem; font-weight: 600; color: #1B2A4A; }
    .tuta-err { margin: 12px 0 0; font-size: 0.84rem; font-weight: 600; color: #D14343; }

    .tuta-actions { display: flex; gap: 8px; margin-top: 16px; }
    .tuta-btn { border: 0; border-radius: 12px; padding: 12px 18px; font: inherit; font-size: 0.9rem; font-weight: 700; cursor: pointer; }
    .tuta-btn:disabled { opacity: 0.6; cursor: default; }
    .tuta-primary { background: #FF6B35; color: #fff; flex: 1; }
    .tuta-ghost { background: #F1F5F9; color: #1B2A4A; }

    .tuta-row { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #E5EAF0; border-radius: 14px; padding: 10px 10px 10px 14px; margin-bottom: 8px; }
    .tuta-row.off { opacity: 0.55; }
    .tuta-info { flex: 1; min-width: 0; }
    .tuta-name { font-size: 0.9rem; font-weight: 700; color: #1B2A4A; line-height: 1.3; }
    .tuta-meta { font-size: 0.76rem; color: #64748B; margin-top: 2px; word-break: break-all; }
    .tuta-badge { display: inline-block; font-size: 0.7rem; font-weight: 800; padding: 2px 8px; border-radius: 999px; margin-right: 6px; }
    .tuta-badge.vid { background: #E8F7EE; color: #15803D; }
    .tuta-badge.txt { background: #F1F5F9; color: #64748B; }
    .tuta-tools { display: flex; gap: 6px; flex: none; }
    .tuta-ic { width: 36px; height: 36px; border-radius: 10px; border: 1px solid #E5EAF0; background: #F8FAFC; color: #1B2A4A; cursor: pointer; font-size: 0.85rem; }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';

    const $ = (id) => document.getElementById(id);

    let rows = [];
    let editingId = null;

    function isYoutube(url) {
      try {
        const u = new URL(url);
        const h = u.hostname.replace(/^(www\.|m\.)/, '');
        let id = null;
        if (h === 'youtu.be') id = u.pathname.slice(1).split('/')[0];
        else if (h === 'youtube.com' || h === 'youtube-nocookie.com') {
          if (u.pathname === '/watch') id = u.searchParams.get('v');
          else {
            const m = u.pathname.match(/^\/(shorts|embed|live)\/([^/?]+)/);
            if (m) id = m[2];
          }
        }
        return !!id && /^[A-Za-z0-9_-]{6,20}$/.test(id);
      } catch (_) { return false; }
    }

    function showErr(text) {
      const el = $('formErr');
      if (!text) { el.style.display = 'none'; return; }
      el.textContent = text;
      el.style.display = 'block';
      window.showToast?.(text, 'error');
    }

    function nextSort() {
      if (!rows.length) return 100;
      return Math.max(...rows.map((r) => r.sort_order || 0)) + 10;
    }

    function resetForm() {
      editingId = null;
      $('formTitle').textContent = 'নতুন টপিক যোগ করুন';
      $('keyWrap').style.display = '';
      $('fKey').value = '';
      $('fKey').required = true;
      $('fTitle').value = '';
      $('fDesc').value = '';
      $('fVideo').value = '';
      $('fSort').value = String(nextSort());
      $('fActive').checked = true;
      $('cancelBtn').style.display = 'none';
      showErr('');
    }

    function startEdit(r) {
      editingId = r.id;
      $('formTitle').textContent = 'এডিট: ' + r.topic_key;
      $('keyWrap').style.display = 'none';
      $('fKey').required = false;
      $('fTitle').value = r.title;
      $('fDesc').value = r.description || '';
      $('fVideo').value = r.video_url || '';
      $('fSort').value = String(r.sort_order ?? 0);
      $('fActive').checked = !!r.is_active;
      $('cancelBtn').style.display = '';
      showErr('');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderList() {
      const wrap = $('listWrap');
      wrap.innerHTML = '';
      $('countLbl').textContent = rows.length ? '(' + rows.length + 'টি)' : '';

      if (!rows.length) {
        const p = document.createElement('p');
        p.className = 'tuta-muted';
        p.textContent = 'এখনো কোনো টপিক নেই।';
        wrap.appendChild(p);
        return;
      }

      rows.forEach((r) => {
        const row = document.createElement('div');
        row.className = 'tuta-row' + (r.is_active ? '' : ' off');

        const info = document.createElement('div');
        info.className = 'tuta-info';
        const n = document.createElement('div');
        n.className = 'tuta-name';
        n.textContent = r.title;
        const m = document.createElement('div');
        m.className = 'tuta-meta';
        const b = document.createElement('span');
        b.className = 'tuta-badge ' + (r.video_url ? 'vid' : 'txt');
        b.textContent = r.video_url ? 'ভিডিও আছে' : 'শুধু লেখা';
        m.appendChild(b);
        m.appendChild(document.createTextNode(r.topic_key + (r.is_active ? '' : ' · বন্ধ')));
        info.appendChild(n);
        info.appendChild(m);

        const tools = document.createElement('div');
        tools.className = 'tuta-tools';

        const eb = document.createElement('button');
        eb.type = 'button';
        eb.className = 'tuta-ic';
        eb.setAttribute('aria-label', 'এডিট');
        eb.innerHTML = '<i class="fas fa-pen"></i>';
        eb.addEventListener('click', () => startEdit(r));

        const tb = document.createElement('button');
        tb.type = 'button';
        tb.className = 'tuta-ic';
        tb.setAttribute('aria-label', r.is_active ? 'বন্ধ করুন' : 'চালু করুন');
        tb.innerHTML = r.is_active ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        tb.addEventListener('click', () => toggleActive(r));

        tools.appendChild(eb);
        tools.appendChild(tb);
        row.appendChild(info);
        row.appendChild(tools);
        wrap.appendChild(row);
      });
    }

    async function loadRows() {
      const { data, error } = await supabase
        .from('tutorial_videos')
        .select('*')
        .order('sort_order', { ascending: true });
      if (error) {
        $('listWrap').innerHTML = '';
        const p = document.createElement('p');
        p.className = 'tuta-err';
        p.textContent = 'লোড করতে সমস্যা হয়েছে: ' + error.message;
        $('listWrap').appendChild(p);
        return;
      }
      rows = data || [];
      renderList();
      if (!editingId) $('fSort').value = String(nextSort());
    }

    async function save() {
      showErr('');
      if (!window.SFValidateForm($('formCard'))) return showErr('লাল চিহ্নিত ঘরগুলো পূরণ করুন।');

      const title = $('fTitle').value.trim();
      const desc = $('fDesc').value.trim();
      const video = $('fVideo').value.trim();
      const sort = parseInt($('fSort').value, 10);

      if (title.length < 2) return showErr('শিরোনাম লিখুন।');
      if (video && !isYoutube(video)) return showErr('এটা YouTube লিংক মনে হচ্ছে না। youtu.be বা youtube.com লিংক দিন।');

      const payload = {
        title,
        description: desc || null,
        video_url: video || null,
        sort_order: Number.isFinite(sort) ? sort : 100,
        is_active: $('fActive').checked,
        updated_at: new Date().toISOString(),
      };

      if (!editingId) {
        const key = $('fKey').value.trim().toLowerCase();
        if (!/^[a-z0-9-]{2,40}$/.test(key)) return showErr('টপিক কী-তে শুধু ইংরেজি ছোট হাতের অক্ষর, সংখ্যা ও - দিন (২-৪০ অক্ষর)।');
        payload.topic_key = key;
      }

      const btn = $('saveBtn');
      btn.disabled = true;
      btn.textContent = 'সেভ হচ্ছে...';

      const q = editingId
        ? supabase.from('tutorial_videos').update(payload).eq('id', editingId)
        : supabase.from('tutorial_videos').insert(payload);
      const { error } = await q;

      btn.disabled = false;
      btn.textContent = 'সেভ করুন';

      if (error) {
        const dup = error.code === '23505';
        return showErr(dup ? 'এই টপিক কী আগেই আছে।' : 'সেভ হয়নি: ' + error.message);
      }
      resetForm();
      window.showToast?.('সেভ হয়েছে ✓', 'success');
      await loadRows();
    }

    async function toggleActive(r) {
      const { error } = await supabase
        .from('tutorial_videos')
        .update({ is_active: !r.is_active, updated_at: new Date().toISOString() })
        .eq('id', r.id);
      if (error) { alert('বদলানো যায়নি: ' + error.message); return; }
      await loadRows();
    }

    $('saveBtn').addEventListener('click', save);
    $('cancelBtn').addEventListener('click', resetForm);

    window.addEventListener('smartfeni:admin-ready', (e) => {
      // শুধু admin; পুরনো moderator বা স্টাফ হলে ড্যাশবোর্ডে ফেরত
      if (!e.detail || e.detail.role !== 'admin') { window.location.href = '/admin'; return; }
      loadRows();
    });

    initAdminGuard();
  </script>
</BaseLayout>
