  <script>
    import { initAdminGuard, adminAreaOfPath } from '../../lib/adminGuard.js';
    import { getFavs, getRecent, toggleFav, saveBadges, bn } from '../../lib/adminShortcuts.js';
    import { supabase } from '../../lib/supabase.js';

    let isAdmin = false;
    let access = null; // adminGuard থেকে: রোলওয়ালা স্টাফ হলে রোলের permission

    function areaOfCard(card) { return adminAreaOfPath(card.getAttribute('href') || ''); }
    function staffCan(area) { return !!area && access.can(area + '.view'); }
    function applyStatAccess() {
      // উপরের ৩ বার: রোলওয়ালা স্টাফের সেই এলাকার পারমিশন না থাকলে বারটা লুকানো (কার্ডের মতোই)
      document.querySelectorAll('.adm-stat[data-href]').forEach((el) => {
        const href = el.getAttribute('data-href') || '';
        const ok = !(access && access.isStaff) || staffCan(adminAreaOfPath(href));
        el.style.display = ok ? '' : 'none';
      });
    }

    function cardAllowed(card) {
      // রোলওয়ালা স্টাফ: শুধু রোলে অনুমতি পাওয়া কার্ড
      if (access && access.isStaff) return staffCan(areaOfCard(card));
      return !card.hasAttribute('data-admin-only') || isAdmin;
    }

    // কার্ড দেখানো/লুকানো: রোল (data-admin-only) + সার্চ — দুটো একসাথে হিসাব করে
    function applyVisibility() {
      applyStatAccess();
      syncSearchUI();
      const q = (document.getElementById('adminSearch')?.value || '').trim().toLowerCase();
      let total = 0;

      document.querySelectorAll('.adm-group').forEach((group) => {
        let shown = 0;
        group.querySelectorAll('.adm-card').forEach((card) => {
          const roleOk = cardAllowed(card);
          const match = !q || (card.getAttribute('data-search') || '').toLowerCase().includes(q);
          const visible = roleOk && match;
          card.style.display = visible ? '' : 'none';
          const cw = card.closest('.adm-cw');
          if (cw) cw.style.display = visible ? '' : 'none';
          if (visible) shown += 1;
        });
        group.style.display = shown > 0 ? '' : 'none';
        group._shown = shown;
        updateGroupHead(group);
        total += shown;
      });

      const empty = document.getElementById('adminSearchEmpty');
      if (empty) empty.style.display = total === 0 ? 'block' : 'none';
      refreshGroups();
    }

    function setBadge(id, count) {
      const el = document.getElementById(id);
      if (!el) return;
      if (count && count > 0) {
        el.textContent = count > 99 ? '৯৯+' : String(count);
        el.style.display = 'flex';
      } else {
        el.style.display = 'none';
      }
    }

    // ===== v2: ভাঁজ করা গ্রুপ, ⭐ প্রিয়, শর্টকাট সারি, কার্ড/লিস্ট ভিউ =====
    const OPEN_KEY = 'sf_admin_open_groups';
    const VIEW_KEY = 'sf_admin_view';
    function lsGet(k) { try { return localStorage.getItem(k); } catch (_) { return null; } }
    function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (_) { /* বাদ */ } }
    const pathOf = (card) => (card.getAttribute('href') || '').split('?')[0];
    function searchQuery() { return (document.getElementById('adminSearch')?.value || '').trim(); }
    function badgeNum(card) {
      const b = card.querySelector('.adm-badge');
      if (!b || b.style.display === 'none') return 0;
      const s = (b.textContent || '').replace(/[০-৯]/g, (d) => '০১২৩৪৫৬৭৮৯'.indexOf(d));
      return parseInt(s, 10) || 0;
    }

    let openState = null;
    try { openState = JSON.parse(lsGet(OPEN_KEY) || 'null'); } catch (_) { openState = null; }
    if (!openState || typeof openState !== 'object') openState = null;

    function setGroupOpen(group, open) {
      if (!group._btn) return;
      group._btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      group._grid.hidden = !open;
    }
    function pendingOf(group) {
      let n = 0;
      group.querySelectorAll('.adm-card').forEach((c) => { if (cardAllowed(c)) n += badgeNum(c); });
      return n;
    }
    function updateGroupHead(group) {
      if (!group._btn) return;
      group._ct.textContent = bn(group._shown || 0) + 'টি';
      const p = pendingOf(group);
      group._pd.hidden = p <= 0;
      group._pd.textContent = bn(p) + ' পেন্ডিং';
    }
    function refreshGroups() {
      const q = searchQuery();
      groups.forEach((g) => {
        if (!g._btn) return;
        let open;
        if (q) open = (g._shown || 0) > 0;
        else if (openState) open = !!openState[g._name];
        else open = !!g._auto;
        setGroupOpen(g, open);
      });
    }
    function syncSearchUI() {
      const q = searchQuery();
      const clr = document.getElementById('adminSearchClear');
      if (clr) clr.hidden = !q;
      const st = document.querySelector('.adm-stats');
      if (st) st.style.display = q ? 'none' : '';
      const sc = document.getElementById('adminShortcuts');
      if (sc) sc.hidden = !!q || !sc.childElementCount;
    }

    // গ্রুপ হেডার → ভাঁজ করা বাটন (aria-expanded + hidden বডি)
    const groups = [...document.querySelectorAll('.adm-group')];
    groups.forEach((group, i) => {
      const h = group.querySelector('.adm-h');
      const grid = group.querySelector('.adm-grid');
      if (!h || !grid) return;
      group._name = (h.textContent || '').trim();
      grid.id = 'admGrid' + i;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'adm-gh';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', grid.id);
      const nm = document.createElement('span'); nm.className = 'adm-gn'; nm.textContent = group._name;
      const ct = document.createElement('span'); ct.className = 'adm-gc';
      const pd = document.createElement('span'); pd.className = 'adm-gp'; pd.hidden = true;
      const ch = document.createElement('i'); ch.className = 'fas fa-chevron-down adm-gv'; ch.setAttribute('aria-hidden', 'true');
      btn.append(nm, ct, pd, ch);
      h.replaceWith(btn);
      grid.hidden = true;
      group._btn = btn; group._grid = grid; group._ct = ct; group._pd = pd;
      btn.addEventListener('click', () => {
        if (searchQuery()) return;
        setGroupOpen(group, btn.getAttribute('aria-expanded') !== 'true');
        openState = {};
        groups.forEach((g) => { if (g._btn) openState[g._name] = g._btn.getAttribute('aria-expanded') === 'true'; });
        lsSet(OPEN_KEY, JSON.stringify(openState));
      });
    });

    // প্রতিটা কার্ডে ⭐ বাটন (কার্ডের পাশেই, ভেতরে নয় — লিংকের ভেতরে বাটন বসে না)
    function syncStars() {
      const favs = getFavs();
      document.querySelectorAll('.adm-star').forEach((s) => {
        const on = favs.indexOf(s.dataset.path) !== -1;
        s.setAttribute('aria-pressed', on ? 'true' : 'false');
        s.setAttribute('aria-label', s.dataset.name + (on ? ' প্রিয় থেকে সরান' : ' প্রিয়তে যোগ করুন'));
        if (s.firstChild) s.firstChild.className = (on ? 'fas' : 'far') + ' fa-star';
      });
    }
    document.querySelectorAll('.adm-group .adm-card').forEach((card) => {
      const w = document.createElement('div');
      w.className = 'adm-cw';
      card.replaceWith(w);
      w.appendChild(card);
      const s = document.createElement('button');
      s.type = 'button';
      s.className = 'adm-star';
      s.dataset.path = pathOf(card);
      s.dataset.name = (card.querySelector('b')?.textContent || '').trim() || pathOf(card);
      const star = document.createElement('i');
      star.className = 'far fa-star';
      star.setAttribute('aria-hidden', 'true');
      s.appendChild(star);
      s.addEventListener('click', () => { toggleFav(s.dataset.path); syncStars(); renderShortcuts(); });
      w.appendChild(s);
    });
    syncStars();

    // শর্টকাট সারি: প্রিয় → পেন্ডিং (বেশি আগে) → সাম্প্রতিক; সর্বোচ্চ ১২টা (২ সারি)
    function renderShortcuts() {
      const nav = document.getElementById('adminShortcuts');
      if (!nav) return;
      const cards = [...document.querySelectorAll('.adm-group .adm-card')].filter((c) => cardAllowed(c));
      const byPath = {};
      cards.forEach((c) => { byPath[pathOf(c)] = c; });
      const favs = getFavs().filter((p) => byPath[p]);
      const pend = cards.filter((c) => badgeNum(c) > 0).sort((a, b) => badgeNum(b) - badgeNum(a)).map(pathOf);
      const rec = getRecent().filter((p) => byPath[p]);
      const order = [];
      [favs, pend, rec].forEach((list) => list.forEach((p) => { if (order.indexOf(p) === -1) order.push(p); }));
      nav.replaceChildren();
      order.slice(0, 12).forEach((p) => {
        const c = byPath[p];
        const a = document.createElement('a');
        a.className = 'adm-sc';
        a.href = c.getAttribute('href');
        a.setAttribute('aria-label', (c.querySelector('b')?.textContent || '').trim());
        const src = c.querySelector('.adm-ic i');
        const ic = document.createElement('i');
        ic.className = src ? src.className : 'fas fa-circle';
        ic.setAttribute('aria-hidden', 'true');
        a.appendChild(ic);
        const n = badgeNum(c);
        if (n > 0) {
          const bd = document.createElement('span');
          bd.className = 'adm-scb';
          bd.textContent = n > 99 ? '৯৯+' : bn(n);
          a.appendChild(bd);
        }
        nav.appendChild(a);
      });
      syncSearchUI();
    }

    // কাউন্ট আসার পর: সবচেয়ে বেশি পেন্ডিংওয়ালা গ্রুপ খোলা (সেভ করা পছন্দ না থাকলে), কাউন্ট জমা, শর্টকাট
    function afterStats() {
      let best = null; let max = 0;
      groups.forEach((g) => {
        if (!g._btn) return;
        g._auto = false;
        const p = pendingOf(g);
        if (p > max) { max = p; best = g; }
      });
      if (!best) best = groups.find((g) => g._btn) || null;
      if (best) best._auto = true;
      const map = {};
      document.querySelectorAll('.adm-group .adm-card').forEach((c) => {
        if (!cardAllowed(c)) return;
        const n = badgeNum(c);
        if (n > 0) map[pathOf(c)] = n;
      });
      saveBadges(map);
      applyVisibility();
      renderShortcuts();
    }

    // কার্ড / লিস্ট ভিউ
    function setView(v) {
      const list = v === 'list';
      document.getElementById('adminGuardedContent')?.classList.toggle('adm-list', list);
      document.getElementById('admViewGrid')?.setAttribute('aria-pressed', list ? 'false' : 'true');
      document.getElementById('admViewList')?.setAttribute('aria-pressed', list ? 'true' : 'false');
      lsSet(VIEW_KEY, list ? 'list' : 'grid');
    }
    document.getElementById('admViewGrid')?.addEventListener('click', () => setView('grid'));
    document.getElementById('admViewList')?.addEventListener('click', () => setView('list'));
    setView(lsGet(VIEW_KEY) === 'list' ? 'list' : 'grid');

    async function loadStats() {
      const [
        { count: userCount },
        { count: listingCount },
        { count: pendingCount },
        { count: riderPendingCount },
        { count: botChatPendingCount },
        { count: disputePendingCount },
        { count: doctorPendingCount },
        { count: withdrawPendingCount },
        { data: ordersOverview },
        { count: errorOpenCount },
        { count: scratchPendingCount },
        { data: lrOverview },
        { count: advancePendingCount },
      ] = await Promise.all([
        supabase.from('profiles').select('*', { count: 'exact', head: true }),
        // শপ প্রোডাক্ট (shop_id আছে / online-shop) অ্যাডমিনের আওতায় নেই, তাই গণনা থেকে বাদ
        supabase.from('listings').select('*', { count: 'exact', head: true }).is('shop_id', null).neq('category', 'online-shop'),
        supabase.from('listings').select('*', { count: 'exact', head: true }).is('shop_id', null).neq('category', 'online-shop').eq('status', 'pending'),
        supabase.from('delivery_riders').select('*', { count: 'exact', head: true }).eq('verification_status', 'pending'),
        supabase.from('telegram_bot_chats').select('*', { count: 'exact', head: true }).eq('is_active', false),
        supabase.from('delivery_requests').select('*', { count: 'exact', head: true }).eq('status', 'disputed'),
        supabase.from('doctors').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
        // শুধু admin দেখতে পায় (RLS) — moderator এর জন্য কাউন্ট null আসে, কার্ডও লুকানো থাকে
        supabase.from('withdraw_requests').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
        // চলমান অর্ডারের সারাংশ — admin ও moderator দুজনেই পায় (সার্ভারে role চেক)
        supabase.rpc('admin_orders_overview'),
        // খোলা এরর — শুধু admin দেখতে পায় (RLS); moderator এর জন্য null আসে, কার্ডও লুকানো থাকে
        supabase.from('app_error_logs').select('*', { count: 'exact', head: true }).eq('status', 'open'),
        // স্ক্রেচ কার্ড: বিকাশ নম্বর জমা হয়েছে, পেমেন্ট বাকি — শুধু admin (RLS)
        supabase.from('scratch_cards').select('*', { count: 'exact', head: true }).eq('pay_status', 'pending'),
        // লোকাল রাইডের সারাংশ (permission local_ride.view; না থাকলে data null — তখন ০ ধরা হয়)
        supabase.rpc('admin_local_ride_overview'),
        // কুইক ডেলিভারি: যাচাই-বাকি অগ্রিম পেমেন্ট (পড়া delivery_orders.view; না থাকলে ০)
        supabase.from('delivery_payments').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
      ]);

      const ov = ordersOverview || {};
      const liveOrders = (ov.live_open || 0) + (ov.live_confirmed || 0) + (ov.live_delivered || 0) + (ov.disputed || 0);
      const noOfferCount = ov.no_offer || 0;
      // মডারেটরের জন্য delivery_requests সরাসরি পড়া যায় না, তাই RPC এর কাউন্ট নেওয়া হয়
      const disputeCount = ov.disputed ?? disputePendingCount;

      const statUsers = document.getElementById('statUsers');
      const statListings = document.getElementById('statListings');
      const statOrders = document.getElementById('statOrders');
      if (statUsers) statUsers.textContent = userCount ?? '0';
      if (statListings) statListings.textContent = listingCount ?? '0';
      const lr = lrOverview || {};
      const lrLive = (Number(lr.live_open) || 0) + (Number(lr.live_confirmed) || 0);
      if (statOrders) statOrders.textContent = liveOrders + lrLive;

      setBadge('riderPendingBadge', riderPendingCount);
      setBadge('localDriverPendingBadge', Number(lr.pending_drivers) || 0);
      setBadge('localRideReportBadge', Number(lr.open_reports) || 0);
      setBadge('botChatPendingBadge', botChatPendingCount);
      setBadge('disputePendingBadge', disputeCount);
      setBadge('ordersLiveBadge', liveOrders);
      setBadge('doctorPendingBadge', doctorPendingCount);
      setBadge('withdrawPendingBadge', withdrawPendingCount);
      setBadge('errorOpenBadge', isAdmin ? errorOpenCount : 0);
      setBadge('scratchPendingBadge', scratchPendingCount || 0);
      setBadge('quickDeliveryBadge', (advancePendingCount || 0) + (disputeCount || 0));

      afterStats();
    }

    document.getElementById('adminSearch')?.addEventListener('input', applyVisibility);
    document.getElementById('adminSearchClear')?.addEventListener('click', () => {
      const i = document.getElementById('adminSearch');
      if (i) { i.value = ''; i.focus(); }
      applyVisibility();
    });

    window.addEventListener('smartfeni:admin-ready', (e) => {
      const { role, access: guardAccess } = e.detail;
      access = guardAccess || null;
      isAdmin = role === 'admin';

      const roleBadge = document.getElementById('roleBadge');
      if (roleBadge) roleBadge.textContent = isAdmin ? 'অ্যাডমিন' : (access && access.isStaff && access.roleName ? access.roleName : 'মডারেটর');

      applyVisibility();
      renderShortcuts();
      loadStats();
    });

    initAdminGuard();
  </script>
</BaseLayout>
