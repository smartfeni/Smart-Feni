---
// ============================================================
// পেজ: অ্যাডমিন ড্যাশবোর্ড (/admin)
// শুধু admin/moderator role অ্যাক্সেস করতে পারবে — adminGuard.js দিয়ে
// ক্লায়েন্ট-সাইডে চেক হয়, আসল নিরাপত্তা Supabase RLS policy-তে
// আপডেট: নেভিগেশন গ্রিডে "অ্যানালিটিক্স", "আইনি অনুরোধ" ও
//         "স্বাস্থ্য অনুরোধ" কার্ড যোগ করা হয়েছে
// আপডেট ২: "ফিচার্ড ফটো" কার্ড → "ছবি ম্যানেজমেন্ট" কার্ডে বদলানো
//           হলো (/admin/images)
// আপডেট ৩: "শপ ম্যানেজমেন্ট" কার্ড পুনরায় যোগ করা হলো (/admin/shops)
// আপডেট ৪: "ক্লাব ম্যানেজমেন্ট" কার্ড যোগ করা হলো (/admin/clubs)
// আপডেট ৫: ক্লাব কার্ড এখন শুধু admin role দেখতে পাবে
// আপডেট ৬: "ডেলিভারি হিরো ভেরিফিকেশন" কার্ড যোগ করা হলো
// আপডেট ৭: "Bot Chats" কার্ড যোগ করা হলো
//           (/admin/bot-chats) — pending চ্যাট রিকোয়েস্টের কাউন্ট
//           ব্যাজ সহ (rider badge এর মতোই লজিক)
// আপডেট ৮ (এই সেশন): "ডাক্তার ম্যানেজমেন্ট" কার্ড যোগ করা হলো
//           (/admin/doctors) — admin ও moderator দুজনেই দেখতে পাবে।
//           'pending' (রিভিউয়ের অপেক্ষায়) ডাক্তারের কাউন্ট ব্যাজ সহ
// আপডেট ৯: "ক্লিনিক ও প্রতিনিধি" কার্ড যোগ (/admin/clinics) — শুধু admin।
//           (পরে বদল: প্রতিনিধির যোগ/এডিটে অ্যাডমিন রিভিউ লাগে না, তাই ডাক্তার
//           কার্ডের ব্যাজ শুধু status='pending' গোনে)
// আপডেট ১০: "রেফার & রিওয়ার্ড" কার্ড যোগ (/admin/referrals) — শুধু admin।
//           পেন্ডিং উইথড্র আবেদনের কাউন্ট ব্যাজ সহ (withdraw_requests, status='pending')
// আপডেট ১১ (রিডিজাইন): গ্রুপ করা কার্ড (কনটেন্ট / ইউজার ও টিম / মার্কেটপ্লেস / ডেলিভারি /
//           স্বাস্থ্য ও আইন / গ্রোথ ও টাকা), "এখনই দেখুন" পেন্ডিং-স্ট্রিপ, পেজ খুঁজুন সার্চ।
//           সব কার্ড আইডি, ব্যাজ আইডি ও loadStats() কোয়েরি আগের মতোই; শুধু-admin কার্ডগুলো
//           data-admin-only দিয়ে চিহ্নিত।
// আপডেট ১২: "জরুরি নাম্বার" কার্ড যোগ (/admin/emergency-contacts) — "কনটেন্ট" গ্রুপে।
//           admin ও moderator দুজনেই দেখতে পাবে। ব্যাজ/স্ট্রিপ নেই (পেন্ডিং ধারণা নেই)।
// আপডেট ১৩: "ডেলিভারি ও রাইড অর্ডার" কার্ড যোগ (/admin/delivery-orders) —
//           চলমান অর্ডারের কাউন্ট ব্যাজ (admin_orders_overview RPC, মডারেটরও পায়),
//           "এখনই দেখুন" স্ট্রিপে "অফারহীন অর্ডার" চিপ। ডিসপিউট ব্যাজ এখন RPC থেকেও
//           আসে, তাই মডারেটরের ক্ষেত্রেও কাউন্ট ঠিক দেখায়।
// আপডেট ১৪ (এরর মনিটরিং, ধাপ ৫): নতুন "সিস্টেম" গ্রুপে "এরর লগ" কার্ড (/admin/errors) —
//           শুধু admin। খোলা (status='open') এররের কাউন্ট ব্যাজ সহ, আর "এখনই দেখুন"
//           স্ট্রিপে "খোলা এরর" চিপ (শুধু admin)। loadStats()-এ app_error_logs-এর একটা
//           কাউন্ট কোয়েরি যোগ; বাকি সব আগের মতোই।
// আপডেট ১৫: "ফেসবুক অর্ডার" কার্ড যোগ (/admin/manual-orders) — "ডেলিভারি" গ্রুপে।
//           ফেসবুক মেসেজে আসা ম্যানুয়াল অর্ডার (সিরিয়াল, অ্যাডভান্স/ক্যাশ, রাইডার হিসাব)।
//           admin ও moderator দুজনেই দেখতে পাবে; হিসাব ট্যাব পেজের ভেতরে শুধু admin।
// আপডেট ১৬: উপরের ৩ স্ট্যাট বার এখন ট্যাপযোগ্য লিংক (মোট ইউজার → /admin/users,
//           মোট লিস্টিং → /admin/listings, ডেলিভারি ও রাইড → /admin/delivery-orders,
//           সংখ্যা = চলমান অর্ডার)। "রিভিউ বাকি" বার বাদ (পেন্ডিং লিস্টিং "এখনই দেখুন"
//           স্ট্রিপে আছে)। নিচের ইউজার/লিস্টিং/ডেলিভারি-অর্ডার কার্ড বাদ। স্টাফের
//           পারমিশন না থাকলে বারটা লুকানো থাকে।
// আপডেট ১৭: "কুইক ডেলিভারি" কার্ড (/admin/quick-delivery) — "ডেলিভারি" গ্রুপে। ভেতরে কুইক ডেলিভারির সব
//           অপশন (অর্ডার, অগ্রিম পেমেন্ট, হিসাব, দোকান, ক্যাটাগরি, রাইডার, চার্জ)। ব্যাজ = যাচাই-বাকি অগ্রিম
//           পেমেন্ট + ডিসপিউট; "এখনই দেখুন"-এ "অগ্রিম পেমেন্ট যাচাই" চিপ।
// আপডেট ১৮: "হিসাব" কার্ড (/admin/hisab) — "গ্রোথ ও টাকা" গ্রুপে; সুপার অ্যাডমিন + রোলে hisab.view থাকা স্টাফ।
//           কোম্পানির কাছে জমা টাকার হিসাব (জমা, আয়, খরচ, দৈনিক ব্যালেন্স)। ব্যাজ নেই।
// ============================================================

// আপডেট ১৯ (নেভ রিডিজাইন): সার্চ উপরে; গ্রুপ ভাঁজ করা (সবচেয়ে বেশি পেন্ডিংওয়ালা খোলা); ⭐ প্রিয়;
//           শুধু-আইকন শর্টকাট সারি (প্রিয় → পেন্ডিং → সাম্প্রতিক, ২ সারি); কার্ড/লিস্ট ভিউ। "এখনই দেখুন" স্ট্রিপ বাদ।
//           প্রিয়/সাম্প্রতিক ডিভাইসের localStorage-এ (adminShortcuts.js)। সব কার্ড/ব্যাজ আইডি ও loadStats() কোয়েরি আগের মতোই।
export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="অ্যাডমিন ড্যাশবোর্ড | স্মার্ট ফেনী">
  <div class="admin-page">
    <div class="container">

      <!-- ===== লোডিং স্টেট (গার্ড চেক চলাকালীন) ===== -->
      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <!-- ===== আসল কন্টেন্ট (গার্ড পাস হলে দেখা যাবে) ===== -->
      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <div class="admin-header adm-top">
          <div>
            <h1>অ্যাডমিন ড্যাশবোর্ড</h1>
            <p class="admin-role-badge" id="roleBadge"></p>
          </div>
          <div class="adm-view" role="group" aria-label="দেখার ধরন">
            <button type="button" id="admViewGrid" aria-pressed="true" aria-label="কার্ড ভিউ"><i class="fas fa-table-cells-large" aria-hidden="true"></i></button>
            <button type="button" id="admViewList" aria-pressed="false" aria-label="লিস্ট ভিউ"><i class="fas fa-list" aria-hidden="true"></i></button>
          </div>
        </div>

        <!-- ===== সার্চ ===== -->
        <div class="adm-search">
          <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" id="adminSearch" aria-label="পেজ খুঁজুন" placeholder="পেজ খুঁজুন (যেমন: ডাক্তার, রেফার)" autocomplete="off" />
          <button type="button" id="adminSearchClear" aria-label="সার্চ মুছুন" hidden><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </div>

        <!-- ===== স্ট্যাটস ===== -->
        <div class="adm-stats">
          <a href="/admin/users" data-href="/admin/users" class="adm-stat"><b id="statUsers">—</b><span>মোট ইউজার</span></a>
          <a href="/admin/listings" data-href="/admin/listings" class="adm-stat"><b id="statListings">—</b><span>মোট লিস্টিং</span></a>
          <a href="/admin/delivery-orders" data-href="/admin/delivery-orders" class="adm-stat hl"><b id="statOrders">—</b><span>ডেলিভারি ও রাইড</span></a>
        </div>

        <!-- ===== শর্টকাট (শুধু আইকন, সর্বোচ্চ ২ সারি): প্রিয় → পেন্ডিং → সাম্প্রতিক ===== -->
        <nav class="adm-sc-row" id="adminShortcuts" aria-label="শর্টকাট" hidden></nav>

      <section class="adm-group">
        <div class="adm-h">কনটেন্ট</div>
        <div class="adm-grid">
        <a href="/admin/categories" class="adm-card" style="--c:#8B5CF6;" data-search="ক্যাটাগরি ম্যানেজমেন্ট হোমপেজ সেকশন অর্ডার ও ক্যাটাগরি সিরিয়াল">
          <span class="adm-ic"><i class="fas fa-layer-group"></i></span>
          <b>ক্যাটাগরি ম্যানেজমেন্ট</b>
          <small>হোমপেজ সেকশন অর্ডার ও ক্যাটাগরি সিরিয়াল</small>
        </a>
        <a href="/admin/images" class="adm-card" style="--c:#EC4899;" data-search="ছবি ম্যানেজমেন্ট ফিচার্ড ফটো, হেডার, লোগো">
          <span class="adm-ic"><i class="fas fa-image"></i></span>
          <b>ছবি ম্যানেজমেন্ট</b>
          <small>ফিচার্ড ফটো, হেডার, লোগো</small>
        </a>
        <a href="/admin/notifications" class="adm-card" style="--c:#F59E0B;" data-search="নোটিফিকেশন কাস্টম নোটিফিকেশন ও ক্যাম্পেইন">
          <span class="adm-ic"><i class="fas fa-bell"></i></span>
          <b>নোটিফিকেশন</b>
          <small>কাস্টম নোটিফিকেশন ও ক্যাম্পেইন</small>
        </a>
        <a href="/admin/emergency-contacts" class="adm-card" style="--c:#D92D20;" data-search="জরুরি নাম্বার ইমার্জেন্সি কন্টাক্ট পুলিশ ফায়ার হাসপাতাল ফোন নাম্বার যোগ এডিট ডিলিট">
          <span class="adm-ic"><i class="fas fa-phone-volume"></i></span>
          <b>জরুরি নাম্বার</b>
          <small>পুলিশ, ফায়ার, হাসপাতালের নাম্বার যোগ/এডিট/ডিলিট</small>
        </a>
        <a href="/admin/tutorials" class="adm-card" id="tutorialsNavCard" data-admin-only="1" style="--c:#FF6B35;display:none;" data-search="টিউটোরিয়াল ইনফো বাটন ভিডিও ইউটিউব কীভাবে কাজ করে ব্যাখ্যা">
          <span class="adm-ic"><i class="fas fa-circle-play"></i></span>
          <b>টিউটোরিয়াল ও ইনফো</b>
          <small>ⓘ বাটনের ব্যাখ্যা ও YouTube ভিডিও লিংক</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">ইউজার ও টিম</div>
        <div class="adm-grid">
        <a href="/admin/roles" class="adm-card" id="rolesNavCard" data-admin-only="1" style="--c:#7C3AED;display:none;" data-search="রোল পারমিশন অনুমতি স্টাফ অ্যাডমিন কে কী করতে পারবে">
          <span class="adm-ic"><i class="fas fa-user-lock"></i></span>
          <b>রোল ও পারমিশন</b>
          <small>কে কী করতে পারবে ঠিক করুন, স্টাফ যোগ করুন</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">মার্কেটপ্লেস</div>
        <div class="adm-grid">
        <a href="/admin/shops" class="adm-card" style="--c:#EC4899;" data-search="শপ ম্যানেজমেন্ট শপ তৈরি, active/deactivate ও সিরিয়াল">
          <span class="adm-ic"><i class="fas fa-store"></i></span>
          <b>শপ ম্যানেজমেন্ট</b>
          <small>শপ তৈরি, active/deactivate ও সিরিয়াল</small>
        </a>
        <a href="/admin/shop-orders" class="adm-card" style="--c:#F97316;" data-search="শপ অর্ডার অর্ডার ট্র্যাকিং চলমান সম্পন্ন বাতিল ক্যালেন্ডার">
          <span class="adm-ic"><i class="fas fa-bag-shopping"></i></span>
          <b>শপ অর্ডার</b>
          <small>চলমান, সম্পন্ন, বাতিল (ক্যালেন্ডার সহ)</small>
        </a>
        <a href="/admin/clubs" class="adm-card" id="clubNavCard" data-admin-only="1" style="--c:#0EA5E9;display:none;" data-search="ক্লাব ম্যানেজমেন্ট ক্লাব তৈরি, ভেরিফাই ও active/deactivate">
          <span class="adm-ic"><i class="fas fa-people-group"></i></span>
          <b>ক্লাব ম্যানেজমেন্ট</b>
          <small>ক্লাব তৈরি, ভেরিফাই ও active/deactivate</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">ডেলিভারি</div>
        <div class="adm-grid">
        <a href="/admin/quick-delivery" class="adm-card" style="--c:#16A34A;" data-search="কুইক ডেলিভারি মার্কেট অর্ডার অগ্রিম পেমেন্ট যাচাই বিকাশ নগদ হিসাব দোকান মেনু শপ ক্যাটাগরি চার্জ রাইডার ডিসপিউট">
          <span class="adm-badge" id="quickDeliveryBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-bolt"></i></span>
          <b>কুইক ডেলিভারি</b>
          <small>অর্ডার, অগ্রিম পেমেন্ট যাচাই, হিসাব, দোকান, চার্জ</small>
        </a>
        <a href="/admin/delivery-riders" class="adm-card" style="--c:#FF6B35;" data-search="ডেলিভারি হিরো ভেরিফিকেশন রাইডার আবেদন যাচাই, approve/reject">
          <span class="adm-badge" id="riderPendingBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-motorcycle"></i></span>
          <b>ডেলিভারি হিরো ভেরিফিকেশন</b>
          <small>রাইডার আবেদন যাচাই, approve/reject</small>
        </a>
