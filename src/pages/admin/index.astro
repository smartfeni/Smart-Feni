---
// ============================================================
// পেজ: অ্যাডমিন ড্যাশবোর্ড (/admin)
// শুধু admin/moderator role অ্যাক্সেস করতে পারবে — adminGuard.js দিয়ে
// ক্লায়েন্ট-সাইডে চেক হয়, আসল নিরাপত্তা Supabase RLS policy-তে
// আপডেট: নেভিগেশন গ্রিডে "অ্যানালিটিক্স", "আইনি অনুরোধ" ও
//         "স্বাস্থ্য অনুরোধ" কার্ড যোগ করা হয়েছে
// আপডেট ২: "ফিচার্ড ফটো" কার্ড → "ছবি ম্যানেজমেন্ট" কার্ডে বদলানো
//           হলো (/admin/images)
// আপডেট ৩: "শপ ম্যানেজমেন্ট" কার্ড পুনরায় যোগ করা হলো (/admin/shops)
// আপডেট ৪: "ক্লাব ম্যানেজমেন্ট" কার্ড যোগ করা হলো (/admin/clubs)
// আপডেট ৫: ক্লাব কার্ড এখন শুধু admin role দেখতে পাবে
// আপডেট ৬: "ডেলিভারি হিরো ভেরিফিকেশন" কার্ড যোগ করা হলো
// আপডেট ৭: "Bot Chats" কার্ড যোগ করা হলো
//           (/admin/bot-chats) — pending চ্যাট রিকোয়েস্টের কাউন্ট
//           ব্যাজ সহ (rider badge এর মতোই লজিক)
// আপডেট ৮ (এই সেশন): "ডাক্তার ম্যানেজমেন্ট" কার্ড যোগ করা হলো
//           (/admin/doctors) — admin ও moderator দুজনেই দেখতে পাবে।
//           'pending' (রিভিউয়ের অপেক্ষায়) ডাক্তারের কাউন্ট ব্যাজ সহ
// আপডেট ৯: "ক্লিনিক ও প্রতিনিধি" কার্ড যোগ (/admin/clinics) — শুধু admin।
//           ডাক্তার কার্ডের ব্যাজ এখন pending + প্রতিনিধির যোগ/বদল করা
//           "দেখা হয়নি" (admin_seen = false) ডাক্তারও গোনে
// আপডেট ১০: "রেফার & রিওয়ার্ড" কার্ড যোগ (/admin/referrals) — শুধু admin।
//           পেন্ডিং উইথড্র আবেদনের কাউন্ট ব্যাজ সহ (withdraw_requests, status='pending')
// আপডেট ১১ (রিডিজাইন): গ্রুপ করা কার্ড (কনটেন্ট / ইউজার ও টিম / মার্কেটপ্লেস / ডেলিভারি /
//           স্বাস্থ্য ও আইন / গ্রোথ ও টাকা), "এখনই দেখুন" পেন্ডিং-স্ট্রিপ, পেজ খুঁজুন সার্চ।
//           সব কার্ড আইডি, ব্যাজ আইডি ও loadStats() কোয়েরি আগের মতোই; শুধু-admin কার্ডগুলো
//           data-admin-only দিয়ে চিহ্নিত।
// আপডেট ১২: "জরুরি নাম্বার" কার্ড যোগ (/admin/emergency-contacts) — "কনটেন্ট" গ্রুপে।
//           admin ও moderator দুজনেই দেখতে পাবে। ব্যাজ/স্ট্রিপ নেই (পেন্ডিং ধারণা নেই)।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="অ্যাডমিন ড্যাশবোর্ড | স্মার্ট ফেনী">
  <div class="admin-page">
    <div class="container">

      <!-- ===== লোডিং স্টেট (গার্ড চেক চলাকালীন) ===== -->
      <div id="adminLoadingState" class="admin-loading">
        <div class="admin-spinner"></div>
        <p>যাচাই করা হচ্ছে...</p>
      </div>

      <!-- ===== আসল কন্টেন্ট (গার্ড পাস হলে দেখা যাবে) ===== -->
      <div id="adminGuardedContent" class="admin-content" style="display:none;">

        <div class="admin-header">
          <h1>অ্যাডমিন ড্যাশবোর্ড</h1>
          <p class="admin-role-badge" id="roleBadge"></p>
        </div>

        <!-- ===== স্ট্যাটস ===== -->
        <div class="adm-stats">
          <div class="adm-stat"><b id="statUsers">—</b><span>মোট ইউজার</span></div>
          <div class="adm-stat"><b id="statListings">—</b><span>মোট লিস্টিং</span></div>
          <div class="adm-stat hl"><b id="statPending">—</b><span>রিভিউ বাকি</span></div>
        </div>

        <!-- ===== এখনই দেখুন (শুধু পেন্ডিং > ০) ===== -->
        <div class="adm-h">এখনই দেখুন</div>
        <div class="adm-att" id="attentionStrip"><span class="adm-none">লোড হচ্ছে...</span></div>

        <!-- ===== সার্চ ===== -->
        <div class="adm-h">সব ফিচার</div>
        <label class="adm-search">
          <i class="fas fa-magnifying-glass"></i>
          <input type="search" id="adminSearch" placeholder="পেজ খুঁজুন (যেমন: ডাক্তার, রেফার)" autocomplete="off" />
        </label>

      <section class="adm-group">
        <div class="adm-h">কনটেন্ট</div>
        <div class="adm-grid">
        <a href="/admin/listings" class="adm-card" style="--c:#3B82F6;" data-search="লিস্টিং ম্যানেজমেন্ট সব ক্যাটাগরির লিস্টিং approve/reject/delete">
          <span class="adm-ic"><i class="fas fa-list-check"></i></span>
          <b>লিস্টিং ম্যানেজমেন্ট</b>
          <small>সব ক্যাটাগরির লিস্টিং approve/reject/delete</small>
        </a>
        <a href="/admin/categories" class="adm-card" style="--c:#8B5CF6;" data-search="ক্যাটাগরি ম্যানেজমেন্ট হোমপেজ সেকশন অর্ডার ও ক্যাটাগরি সিরিয়াল">
          <span class="adm-ic"><i class="fas fa-layer-group"></i></span>
          <b>ক্যাটাগরি ম্যানেজমেন্ট</b>
          <small>হোমপেজ সেকশন অর্ডার ও ক্যাটাগরি সিরিয়াল</small>
        </a>
        <a href="/admin/images" class="adm-card" style="--c:#EC4899;" data-search="ছবি ম্যানেজমেন্ট ফিচার্ড ফটো, হেডার, লোগো">
          <span class="adm-ic"><i class="fas fa-image"></i></span>
          <b>ছবি ম্যানেজমেন্ট</b>
          <small>ফিচার্ড ফটো, হেডার, লোগো</small>
        </a>
        <a href="/admin/notifications" class="adm-card" style="--c:#F59E0B;" data-search="নোটিফিকেশন কাস্টম নোটিফিকেশন ও ক্যাম্পেইন">
          <span class="adm-ic"><i class="fas fa-bell"></i></span>
          <b>নোটিফিকেশন</b>
          <small>কাস্টম নোটিফিকেশন ও ক্যাম্পেইন</small>
        </a>
        <a href="/admin/emergency-contacts" class="adm-card" style="--c:#D92D20;" data-search="জরুরি নাম্বার ইমার্জেন্সি কন্টাক্ট পুলিশ ফায়ার হাসপাতাল ফোন নাম্বার যোগ এডিট ডিলিট">
          <span class="adm-ic"><i class="fas fa-phone-volume"></i></span>
          <b>জরুরি নাম্বার</b>
          <small>পুলিশ, ফায়ার, হাসপাতালের নাম্বার যোগ/এডিট/ডিলিট</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">ইউজার ও টিম</div>
        <div class="adm-grid">
        <a href="/admin/users" class="adm-card" style="--c:#0EA5E9;" data-search="ইউজার ম্যানেজমেন্ট প্রোফাইল দেখুন, ব্লক/আনব্লক করুন">
          <span class="adm-ic"><i class="fas fa-users"></i></span>
          <b>ইউজার ম্যানেজমেন্ট</b>
          <small>প্রোফাইল দেখুন, ব্লক/আনব্লক করুন</small>
        </a>
        <a href="/admin/moderators" class="adm-card" id="moderatorNavCard" data-admin-only="1" style="--c:#6366F1;display:none;" data-search="মডারেটর ম্যানেজমেন্ট নতুন মডারেটর যোগ করুন বা সরান">
          <span class="adm-ic"><i class="fas fa-user-shield"></i></span>
          <b>মডারেটর ম্যানেজমেন্ট</b>
          <small>নতুন মডারেটর যোগ করুন বা সরান</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">মার্কেটপ্লেস</div>
        <div class="adm-grid">
        <a href="/admin/shops" class="adm-card" style="--c:#EC4899;" data-search="শপ ম্যানেজমেন্ট শপ তৈরি, active/deactivate ও সিরিয়াল">
          <span class="adm-ic"><i class="fas fa-store"></i></span>
          <b>শপ ম্যানেজমেন্ট</b>
          <small>শপ তৈরি, active/deactivate ও সিরিয়াল</small>
        </a>
        <a href="/admin/clubs" class="adm-card" id="clubNavCard" data-admin-only="1" style="--c:#0EA5E9;display:none;" data-search="ক্লাব ম্যানেজমেন্ট ক্লাব তৈরি, ভেরিফাই ও active/deactivate">
          <span class="adm-ic"><i class="fas fa-people-group"></i></span>
          <b>ক্লাব ম্যানেজমেন্ট</b>
          <small>ক্লাব তৈরি, ভেরিফাই ও active/deactivate</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">ডেলিভারি</div>
        <div class="adm-grid">
        <a href="/admin/delivery-riders" class="adm-card" style="--c:#FF6B35;" data-search="ডেলিভারি হিরো ভেরিফিকেশন রাইডার আবেদন যাচাই, approve/reject">
          <span class="adm-badge" id="riderPendingBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-motorcycle"></i></span>
          <b>ডেলিভারি হিরো ভেরিফিকেশন</b>
          <small>রাইডার আবেদন যাচাই, approve/reject</small>
        </a>
        <a href="/admin/delivery-disputes" class="adm-card" style="--c:#EF4444;" data-search="ডেলিভারি ডিসপিউট রিপোর্ট করা সমস্যা দেখুন ও রিজলভ করুন">
          <span class="adm-badge" id="disputePendingBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-flag"></i></span>
          <b>ডেলিভারি ডিসপিউট</b>
          <small>রিপোর্ট করা সমস্যা দেখুন ও রিজলভ করুন</small>
        </a>
        <a href="/admin/seed-locations" class="adm-card" style="--c:#14B8A6;" data-search="লোকেশন ইম্পোর্ট OSM থেকে Delivery Hero সাজেশন যোগ">
          <span class="adm-ic"><i class="fas fa-map-location-dot"></i></span>
          <b>লোকেশন ইম্পোর্ট</b>
          <small>OSM থেকে Delivery Hero সাজেশন যোগ</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">স্বাস্থ্য ও আইন</div>
        <div class="adm-grid">
        <a href="/admin/doctors" class="adm-card" style="--c:#0D9488;" data-search="ডাক্তার ম্যানেজমেন্ট ডাক্তার, চেম্বার, প্রতিনিধির যোগ করা ডাক্তার, মার্জ">
          <span class="adm-badge" id="doctorPendingBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-user-doctor"></i></span>
          <b>ডাক্তার ম্যানেজমেন্ট</b>
          <small>ডাক্তার, চেম্বার, প্রতিনিধির যোগ করা ডাক্তার, মার্জ</small>
        </a>
        <a href="/admin/clinics" class="adm-card" id="clinicsNavCard" data-admin-only="1" style="--c:#0891B2;display:none;" data-search="ক্লিনিক ও প্রতিনিধি ক্লিনিক যোগ, প্রতিনিধি নিয়োগ">
          <span class="adm-ic"><i class="fas fa-hospital"></i></span>
          <b>ক্লিনিক ও প্রতিনিধি</b>
          <small>ক্লিনিক যোগ, প্রতিনিধি নিয়োগ</small>
        </a>
        <a href="/admin/health-requests" class="adm-card" style="--c:#10B981;" data-search="স্বাস্থ্য অনুরোধ স্বাস্থ্য পরামর্শের রিকোয়েস্ট">
          <span class="adm-ic"><i class="fas fa-stethoscope"></i></span>
          <b>স্বাস্থ্য অনুরোধ</b>
          <small>স্বাস্থ্য পরামর্শের রিকোয়েস্ট</small>
        </a>
        <a href="/admin/legal-requests" class="adm-card" style="--c:#475569;" data-search="আইনি অনুরোধ আইনি পরামর্শের রিকোয়েস্ট">
          <span class="adm-ic"><i class="fas fa-scale-balanced"></i></span>
          <b>আইনি অনুরোধ</b>
          <small>আইনি পরামর্শের রিকোয়েস্ট</small>
        </a>
        </div>
      </section>

      <section class="adm-group">
        <div class="adm-h">গ্রোথ ও টাকা</div>
        <div class="adm-grid">
        <a href="/admin/referrals" class="adm-card" id="referNavCard" data-admin-only="1" style="--c:#FF6B35;display:none;" data-search="রেফার & রিওয়ার্ড উইথড্র যাচাই ও পেমেন্ট, রেফার কাউন্ট, সামারি">
          <span class="adm-badge" id="withdrawPendingBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-coins"></i></span>
          <b>রেফার & রিওয়ার্ড</b>
          <small>উইথড্র যাচাই ও পেমেন্ট, রেফার কাউন্ট, সামারি</small>
        </a>
        <a href="/admin/analytics" class="adm-card" style="--c:#16A34A;" data-search="অ্যানালিটিক্স উপজেলা, ক্যাটাগরি, কল ক্লিক, সাইনআপ">
          <span class="adm-ic"><i class="fas fa-chart-line"></i></span>
          <b>অ্যানালিটিক্স</b>
          <small>উপজেলা, ক্যাটাগরি, কল ক্লিক, সাইনআপ</small>
        </a>
        <a href="/admin/bot-chats" class="adm-card" style="--c:#6366F1;" data-search="Bot Chats Telegram স্ক্রিনশট-ইম্পোর্ট বট ম্যানেজ">
          <span class="adm-badge" id="botChatPendingBadge" style="display:none;">0</span>
          <span class="adm-ic"><i class="fas fa-robot"></i></span>
          <b>Bot Chats</b>
          <small>Telegram স্ক্রিনশট-ইম্পোর্ট বট ম্যানেজ</small>
        </a>
        </div>
      </section>

        <p class="adm-none" id="adminSearchEmpty" style="display:none;">কিছু পাওয়া যায়নি</p>

      </div>
    </div>
  </div>

  <style is:global>
    .admin-page { min-height: 60vh; padding: 36px 0 90px; }

    .admin-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 120px 0; color: #5A6E85; font-weight: 600; }
    .admin-spinner { width: 36px; height: 36px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .admin-header { margin-bottom: 18px; }
    .admin-header h1 { font-size: 1.5rem; font-weight: 800; color: #1B2A4A; margin: 0; }
    .admin-role-badge { display: inline-block; margin-top: 6px; font-size: 0.78rem; font-weight: 800; color: #FF6B35; background: #FFF0EA; padding: 4px 14px; border-radius: 40px; }

    .adm-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .adm-stat { background: #fff; border: 1px solid #E5EAF0; border-radius: 16px; padding: 12px; }
    .adm-stat b { display: block; font-size: 1.3rem; font-weight: 800; color: #1B2A4A; line-height: 1.2; }
    .adm-stat span { font-size: 0.72rem; color: #64748B; font-weight: 600; }
    .adm-stat.hl b { color: #FF6B35; }

    .adm-h { margin: 20px 2px 8px; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.04em; color: #64748B; }

    .adm-att { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
    .adm-att::-webkit-scrollbar { display: none; }
    .adm-chip { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid #E5EAF0; border-left: 4px solid var(--c); border-radius: 14px; padding: 9px 12px; font-size: 0.8rem; font-weight: 700; text-decoration: none; color: #1B2A4A; }
    .adm-chip em { font-style: normal; background: var(--c); color: #fff; border-radius: 99px; min-width: 22px; height: 22px; display: grid; place-items: center; font-size: 0.72rem; padding: 0 6px; }
    .adm-none { font-size: 0.84rem; color: #64748B; padding: 6px 2px; }

    .adm-search { display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #E5EAF0; border-radius: 14px; padding: 0 12px; color: #8FA0BC; margin-bottom: 4px; }
    .adm-search:focus-within { border-color: #FF6B35; }
    .adm-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 0.9rem; color: #1B2A4A; padding: 12px 0; }

    .adm-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    @media (min-width: 700px) { .adm-grid { grid-template-columns: repeat(3, 1fr); } }

    .adm-card { position: relative; display: flex; flex-direction: column; gap: 8px; background: #fff; border: 1px solid #E5EAF0; border-radius: 18px; padding: 12px; text-decoration: none; color: #1B2A4A; transition: transform 0.12s ease, box-shadow 0.12s ease; }
    .adm-card:active { transform: scale(0.97); box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12); }
    @media (hover: hover) { .adm-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1); } }

    .adm-ic { width: 40px; height: 40px; border-radius: 13px; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; color: var(--c); background: #FFF0EA; background: color-mix(in srgb, var(--c) 15%, #fff); }
    .adm-card b { font-size: 0.86rem; line-height: 1.25; }
    .adm-card small { font-size: 0.7rem; color: #64748B; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .adm-badge { position: absolute; top: 10px; right: 10px; background: #D14343; color: #fff; font-size: 0.68rem; font-weight: 800; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 2px #fff; }
  </style>

  <script>
    import { initAdminGuard } from '../../lib/adminGuard.js';
    import { supabase } from '../../lib/supabase.js';

    let isAdmin = false;

    // কার্ড দেখানো/লুকানো: রোল (data-admin-only) + সার্চ — দুটো একসাথে হিসাব করে
    function applyVisibility() {
      const q = (document.getElementById('adminSearch')?.value || '').trim().toLowerCase();
      let total = 0;

      document.querySelectorAll('.adm-group').forEach((group) => {
        let shown = 0;
        group.querySelectorAll('.adm-card').forEach((card) => {
          const roleOk = !card.hasAttribute('data-admin-only') || isAdmin;
          const match = !q || (card.getAttribute('data-search') || '').toLowerCase().includes(q);
          const visible = roleOk && match;
          card.style.display = visible ? '' : 'none';
          if (visible) shown += 1;
        });
        group.style.display = shown > 0 ? '' : 'none';
        total += shown;
      });

      const empty = document.getElementById('adminSearchEmpty');
      if (empty) empty.style.display = total === 0 ? 'block' : 'none';
    }

    function setBadge(id, count) {
      const el = document.getElementById(id);
      if (!el) return;
      if (count && count > 0) {
        el.textContent = count > 99 ? '৯৯+' : String(count);
        el.style.display = 'flex';
      } else {
        el.style.display = 'none';
      }
    }

    // "এখনই দেখুন" স্ট্রিপ — শুধু যেগুলোর কাউন্ট > ০
    function renderAttention(items) {
      const strip = document.getElementById('attentionStrip');
      if (!strip) return;
      strip.innerHTML = '';

      const active = items.filter((i) => i.count && i.count > 0);
      if (!active.length) {
        const none = document.createElement('span');
        none.className = 'adm-none';
        none.textContent = 'কোনো পেন্ডিং কাজ নেই 🎉';
        strip.appendChild(none);
        return;
      }

      active.forEach((i) => {
        const a = document.createElement('a');
        a.className = 'adm-chip';
        a.href = i.href;
        a.setAttribute('style', `--c:${i.color};`);
        const num = document.createElement('em');
        num.textContent = i.count > 99 ? '৯৯+' : String(i.count);
        a.appendChild(num);
        a.appendChild(document.createTextNode(i.label));
        strip.appendChild(a);
      });
    }

    async function loadStats() {
      const [
        { count: userCount },
        { count: listingCount },
        { count: pendingCount },
        { count: riderPendingCount },
        { count: botChatPendingCount },
        { count: disputePendingCount },
        { count: doctorPendingCount },
        { count: withdrawPendingCount },
      ] = await Promise.all([
        supabase.from('profiles').select('*', { count: 'exact', head: true }),
        supabase.from('listings').select('*', { count: 'exact', head: true }),
        supabase.from('listings').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
        supabase.from('delivery_riders').select('*', { count: 'exact', head: true }).eq('verification_status', 'pending'),
        supabase.from('telegram_bot_chats').select('*', { count: 'exact', head: true }).eq('is_active', false),
        supabase.from('delivery_requests').select('*', { count: 'exact', head: true }).eq('status', 'disputed'),
        supabase.from('doctors').select('*', { count: 'exact', head: true }).or('status.eq.pending,admin_seen.eq.false'),
        // শুধু admin দেখতে পায় (RLS) — moderator এর জন্য কাউন্ট null আসে, কার্ডও লুকানো থাকে
        supabase.from('withdraw_requests').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
      ]);

      const statUsers = document.getElementById('statUsers');
      const statListings = document.getElementById('statListings');
      const statPending = document.getElementById('statPending');
      if (statUsers) statUsers.textContent = userCount ?? '0';
      if (statListings) statListings.textContent = listingCount ?? '0';
      if (statPending) statPending.textContent = pendingCount ?? '0';

      setBadge('riderPendingBadge', riderPendingCount);
      setBadge('botChatPendingBadge', botChatPendingCount);
      setBadge('disputePendingBadge', disputePendingCount);
      setBadge('doctorPendingBadge', doctorPendingCount);
      setBadge('withdrawPendingBadge', withdrawPendingCount);

      renderAttention([
        { count: isAdmin ? withdrawPendingCount : 0, label: 'উইথড্র আবেদন', href: '/admin/referrals', color: '#FF6B35' },
        { count: pendingCount, label: 'লিস্টিং রিভিউ বাকি', href: '/admin/listings', color: '#3B82F6' },
        { count: riderPendingCount, label: 'রাইডার আবেদন', href: '/admin/delivery-riders', color: '#FF6B35' },
        { count: disputePendingCount, label: 'ডিসপিউট', href: '/admin/delivery-disputes', color: '#EF4444' },
        { count: doctorPendingCount, label: 'ডাক্তার রিভিউ', href: '/admin/doctors', color: '#0D9488' },
        { count: botChatPendingCount, label: 'Bot Chat', href: '/admin/bot-chats', color: '#6366F1' },
      ]);
    }

    document.getElementById('adminSearch')?.addEventListener('input', applyVisibility);

    window.addEventListener('smartfeni:admin-ready', (e) => {
      const { role } = e.detail;
      isAdmin = role === 'admin';

      const roleBadge = document.getElementById('roleBadge');
      if (roleBadge) roleBadge.textContent = isAdmin ? 'অ্যাডমিন' : 'মডারেটর';

      applyVisibility();
      loadStats();
    });

    initAdminGuard();
  </script>
</BaseLayout>