---
// ============================================================
// পেজ: /become-a-clinic-rep — লগইন করা ইউজার ক্লিনিক প্রতিনিধি হওয়ার
// আবেদন করবে (নিজের নাম, ক্লিনিকের নাম, ঠিকানা, উপজেলা, ফোন)।
// Admin পরে /admin/clinics থেকে Approve করলে বিদ্যমান বা নতুন ক্লিনিকে
// প্রতিনিধি হিসেবে বসবে এবং /my-clinic পাবে (clinic_rep_requests টেবিল)।
// become-a-shop-owner.astro-র একই প্যাটার্ন।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="ক্লিনিক প্রতিনিধি হোন | স্মার্ট ফেনী">
  <div class="request-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <i class="fas fa-lock"></i>
        <h2>লগইন করুন</h2>
        <p>ক্লিনিক প্রতিনিধি হওয়ার আবেদন করতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-btn">হোমপেজে যান</a>
      </div>

      <div id="pendingExists" class="status-box" style="display:none;">
        <i class="fas fa-hourglass-half"></i>
        <h2>আবেদন পর্যালোচনাধীন</h2>
        <p>আপনার আবেদনটি অ্যাডমিন টিম রিভিউ করছে। এপ্রুভ হলে আপনাকে জানানো হবে।</p>
        <a href="/my-clinic" class="primary-btn" id="pendingMyClinicLink" style="display:none;">আমার ক্লিনিক</a>
      </div>

      <div id="existingNotice" class="existing-notice" style="display:none;">
        <span><i class="fas fa-hospital"></i> <span id="existingText"></span></span>
        <a href="/my-clinic">আমার ক্লিনিক</a>
      </div>

      <div id="rejectedNotice" class="rejected-notice" style="display:none;">
        <i class="fas fa-circle-info"></i> আপনার আগের আবেদনটি গ্রহণ করা হয়নি। চাইলে আবার আবেদন করতে পারেন।
      </div>

      <div id="requestForm" class="form-card" style="display:none;">
        <div class="form-header">
          <i class="fas fa-hospital-user"></i>
          <h1 id="formTitle">ক্লিনিক প্রতিনিধি হওয়ার আবেদন করুন</h1>
          <p id="formSubtitle">ফর্মটি পূরণ করুন — অ্যাডমিন টিম রিভিউ করে এপ্রুভ করলে আপনি ক্লিনিকের ডাক্তার, চেম্বার ও সিরিয়াল ম্যানেজ করতে পারবেন</p>
        </div>

        <p class="form-message" id="formMessage"></p>

        <label class="form-label">আপনার নাম<span class="required-mark">*</span></label>
        <input type="text" class="form-input" id="repNameInput" placeholder="আপনার পুরো নাম" required />
        <div class="field-error-msg" data-error-for="repNameInput"><i class="fas fa-circle-exclamation"></i><span>আপনার নাম লিখুন</span></div>

        <label class="form-label">ক্লিনিক / হাসপাতালের নাম<span class="required-mark">*</span></label>
        <input type="text" class="form-input" id="clinicNameInput" placeholder="যেমন: ফেনী জেনারেল হাসপাতাল" required />
        <div class="field-error-msg" data-error-for="clinicNameInput"><i class="fas fa-circle-exclamation"></i><span>ক্লিনিকের নাম লিখুন</span></div>

        <label class="form-label">ক্লিনিকের ঠিকানা<span class="required-mark">*</span></label>
        <input type="text" class="form-input" id="addressInput" placeholder="যেমন: ট্রাঙ্ক রোড, ফেনী" required />
        <div class="field-error-msg" data-error-for="addressInput"><i class="fas fa-circle-exclamation"></i><span>ঠিকানা লিখুন</span></div>

        <label class="form-label">উপজেলা<span class="required-mark">*</span></label>
        <select class="form-input" id="upazilaInput" required>
          <option value="">নির্বাচন করুন</option>
          <option value="feni-sadar">ফেনী সদর</option>
          <option value="chhagalnaiya">ছাগলনাইয়া</option>
          <option value="daganbhuiyan">দাগনভূঞা</option>
          <option value="parshuram">পরশুরাম</option>
          <option value="fulgazi">ফুলগাজী</option>
          <option value="sonagazi">সোনাগাজী</option>
        </select>
        <div class="field-error-msg" data-error-for="upazilaInput"><i class="fas fa-circle-exclamation"></i><span>উপজেলা বেছে নিন</span></div>

        <label class="form-label">যোগাযোগের ফোন নম্বর<span class="required-mark">*</span></label>
        <input type="text" class="form-input" id="phoneInput" placeholder="01xxxxxxxxx" required />
        <div class="field-error-msg" data-error-for="phoneInput"><i class="fas fa-circle-exclamation"></i><span>ফোন নম্বর লিখুন</span></div>

        <label class="form-label">অন্য কিছু জানাতে চাইলে (ঐচ্ছিক)</label>
        <textarea class="form-textarea" id="messageInput" placeholder="যেমন: ক্লিনিকে আপনার দায়িত্ব, কতদিন ধরে আছেন" rows="3"></textarea>

        <button class="submit-btn" id="submitBtn" type="button">
          <i class="fas fa-paper-plane"></i> <span id="submitBtnText">আবেদন জমা দিন</span>
        </button>
      </div>

    </div>
  </div>

  <style>
    .request-page { min-height: 70vh; padding: 50px 0 80px; }
    .loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 120px 0; color: #5A6E85; font-weight: 600; }
    .spinner { width: 36px; height: 36px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .status-box { max-width: 420px; margin: 60px auto; text-align: center; background: #fff; border-radius: 24px; padding: 44px 28px; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06); }
    .status-box i { font-size: 2.4rem; color: #FF6B35; margin-bottom: 16px; }
    .status-box h2 { font-size: 1.2rem; font-weight: 700; color: #1B2A4A; margin-bottom: 8px; }
    .status-box p { color: #5A6E85; font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; }
    .primary-btn { display: inline-flex; align-items: center; gap: 8px; background: #FF6B35; color: #fff; text-decoration: none; padding: 12px 26px; border-radius: 14px; font-weight: 700; font-size: 0.9rem; }
    .existing-notice { max-width: 560px; margin: 0 auto 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #EFF6FF; color: #1D4ED8; padding: 12px 18px; border-radius: 14px; font-size: 0.85rem; font-weight: 600; }
    .existing-notice a { flex-shrink: 0; color: #fff; background: #2563EB; text-decoration: none; padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 700; }
    .rejected-notice { max-width: 560px; margin: 0 auto 20px; background: #FFF0EA; color: #D14343; padding: 12px 18px; border-radius: 14px; font-size: 0.85rem; font-weight: 600; text-align: center; }
    .form-card { max-width: 560px; margin: 0 auto; background: #fff; border-radius: 24px; padding: 32px 26px; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06); }
    .form-header { text-align: center; margin-bottom: 24px; }
    .form-header i { font-size: 2rem; color: #FF6B35; margin-bottom: 10px; }
    .form-header h1 { font-size: 1.3rem; font-weight: 700; color: #1B2A4A; margin-bottom: 8px; }
    .form-header p { color: #5A6E85; font-size: 0.86rem; line-height: 1.6; }
    .form-message { display: none; font-size: 0.85rem; font-weight: 600; padding: 10px 14px; border-radius: 12px; margin-bottom: 12px; text-align: center; }
    .form-message.show-error { display: block; background: #FFF0EA; color: #D14343; }
    .form-message.show-success { display: block; background: #EAFBF0; color: #1B7A3C; }
    .form-label { display: block; font-size: 0.85rem; font-weight: 600; color: #1B2A4A; margin-bottom: 6px; margin-top: 16px; }
    .form-label:first-of-type { margin-top: 0; }
    .form-input, .form-textarea { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1.5px solid #E5EAF0; font-size: 0.9rem; font-family: inherit; color: #1B2A4A; background: #FBFCFE; resize: vertical; }
    .form-input:focus, .form-textarea:focus { outline: none; border-color: #FF6B35; background: #fff; }
    .submit-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; background: #FF6B35; color: #fff; border: none; padding: 14px; border-radius: 14px; font-weight: 700; font-size: 0.92rem; cursor: pointer; margin-top: 22px; }
    .submit-btn:disabled { opacity: 0.65; cursor: not-allowed; }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const pendingExists = document.getElementById('pendingExists');
    const pendingMyClinicLink = document.getElementById('pendingMyClinicLink');
    const existingNotice = document.getElementById('existingNotice');
    const existingText = document.getElementById('existingText');
    const rejectedNotice = document.getElementById('rejectedNotice');
    const requestForm = document.getElementById('requestForm');
    const formTitle = document.getElementById('formTitle');
    const formSubtitle = document.getElementById('formSubtitle');

    const formMessage = document.getElementById('formMessage');
    const repNameInput = document.getElementById('repNameInput');
    const clinicNameInput = document.getElementById('clinicNameInput');
    const addressInput = document.getElementById('addressInput');
    const upazilaInput = document.getElementById('upazilaInput');
    const phoneInput = document.getElementById('phoneInput');
    const messageInput = document.getElementById('messageInput');
    const submitBtn = document.getElementById('submitBtn');
    const submitBtnText = document.getElementById('submitBtnText');

    function showMsg(text, type = 'error') {
      formMessage.textContent = text;
      formMessage.className = `form-message ${type === 'error' ? 'show-error' : 'show-success'}`;
      if (text && typeof window.showToast === 'function') {
        window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
      }
    }

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('full_name, phone')
        .eq('id', session.user.id)
        .single();

      // বর্তমানে কতগুলো ক্লিনিকের সক্রিয় প্রতিনিধি — এরর হলেও ফর্ম আটকায় না
      const { count } = await supabase
        .from('clinic_reps')
        .select('id', { count: 'exact', head: true })
        .eq('user_id', session.user.id)
        .eq('is_active', true);
      const repCount = count || 0;

      const { data: existingRequests } = await supabase
        .from('clinic_rep_requests')
        .select('status')
        .eq('user_id', session.user.id)
        .order('created_at', { ascending: false })
        .limit(1);

      const latestRequest = existingRequests?.[0];

      loadingState.style.display = 'none';

      if (latestRequest?.status === 'pending') {
        if (repCount > 0) pendingMyClinicLink.style.display = 'inline-flex';
        pendingExists.style.display = 'block';
        return;
      }

      if (repCount > 0) {
        existingText.textContent = `আপনি ${repCount.toLocaleString('bn-BD')}টা ক্লিনিকের প্রতিনিধি`;
        existingNotice.style.display = 'flex';
        formTitle.textContent = 'আরেকটা ক্লিনিকের আবেদন করুন';
        formSubtitle.textContent = 'নতুন ক্লিনিকের তথ্য দিন — অ্যাডমিন টিম এপ্রুভ করলে এটা আপনার আগের ক্লিনিকের পাশে যোগ হবে';
      }

      if (latestRequest?.status === 'rejected') {
        rejectedNotice.style.display = 'block';
      }

      if (profile?.full_name) repNameInput.value = profile.full_name;
      if (profile?.phone) phoneInput.value = profile.phone;

      requestForm.style.display = 'block';
    }

    submitBtn?.addEventListener('click', async () => {
      formMessage.className = 'form-message';

      const repName = repNameInput.value.trim();
      const clinicName = clinicNameInput.value.trim();
      const address = addressInput.value.trim();
      const upazila = upazilaInput.value;
      const phone = phoneInput.value.trim();
      const message = messageInput.value.trim();

      if (!window.SFValidateForm(requestForm) || !repName || !clinicName || !address || !upazila || !phone) {
        showMsg('নাম, ক্লিনিকের নাম, ঠিকানা, উপজেলা ও ফোন নম্বর দিন');
        return;
      }

      submitBtnText.textContent = 'জমা হচ্ছে...';
      submitBtn.disabled = true;

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        showMsg('সেশন পাওয়া যায়নি, আবার লগইন করুন');
        submitBtnText.textContent = 'আবেদন জমা দিন';
        submitBtn.disabled = false;
        return;
      }

      const { error } = await supabase.from('clinic_rep_requests').insert({
        user_id: session.user.id,
        rep_name: repName,
        clinic_name: clinicName,
        address,
        upazila,
        phone,
        message: message || null,
        status: 'pending',
      });

      if (error) {
        showMsg(error.code === '23505'
          ? 'আপনার একটা আবেদন আগে থেকেই পর্যালোচনাধীন আছে'
          : 'আবেদন জমা ব্যর্থ: ' + error.message);
        submitBtnText.textContent = 'আবেদন জমা দিন';
        submitBtn.disabled = false;
        return;
      }

      showMsg('আবেদন সফলভাবে জমা হয়েছে ✓ অ্যাডমিন টিম রিভিউ করার পর জানানো হবে', 'success');
      submitBtn.style.display = 'none';
      [repNameInput, clinicNameInput, addressInput, upazilaInput, phoneInput, messageInput].forEach((el) => { el.disabled = true; });
    });

    init();
  </script>
</BaseLayout>
