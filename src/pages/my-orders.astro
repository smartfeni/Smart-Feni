  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { compressImages } from '../lib/imageCompress.js';
    import { submitReview, uploadPaymentProof, cancelRequest, expireRequests, confirmBestPrice, updateAskingPrice } from '../lib/deliveryClient.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const ordersContent = document.getElementById('ordersContent');
    const emptyOrders = document.getElementById('emptyOrders');
    const ordersContainer = document.getElementById('ordersContainer');

    const STEPS = ['pending', 'confirmed', 'delivered'];
    const STEP_LABELS = { pending: 'পেন্ডিং', confirmed: 'কনফার্মড', delivered: 'ডেলিভার্ড' };

    const DELIVERY_STEPS = ['open', 'confirmed', 'picked_up', 'completed'];
    const DELIVERY_STEP_LABELS = { open: 'রিকোয়েস্ট', confirmed: 'কনফার্মড', picked_up: 'পিকআপ সম্পন্ন', completed: 'সম্পন্ন' };

    // ডাক্তারের সিরিয়াল রিকোয়েস্টের ৩ ধাপ
    const SERIAL_STEPS = ['pending', 'processing', 'confirmed'];
    const SERIAL_STEP_LABELS = { pending: 'জমা হয়েছে', processing: 'প্রসেসিং চলছে', confirmed: 'কনফার্মড' };
    const BN_WEEKDAYS = ['রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার', 'শনিবার'];
    const BN_MONTHS = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];

    let currentUserId = null;
    let refreshTimer = null;

    // ট্যাব + ডিপ-লিংক স্টেট
    let activeTab = 'ongoing';
    let deepLinkHandled = false;
    let lastData = null;
    const deepLinkParams = new URLSearchParams(window.location.search);
    const ordersTabs = document.getElementById('ordersTabs');
    const tabCountOngoing = document.getElementById('tabCountOngoing');

    // ============ কনফার্ম বটম শিট ============
    // শিটটা পেজের কার্ড-কনটেইনারের বাইরে, তাই ১৫ সেকেন্ডের রিফ্রেশে বন্ধ হয় না
    const dealSheet = document.getElementById('dealSheet');
    const dealSheetTitle = document.getElementById('dealSheetTitle');
    const dealSheetText = document.getElementById('dealSheetText');
    const dealSheetOk = document.getElementById('dealSheetOk');
    const dealSheetClose = document.getElementById('dealSheetClose');
    let dealResolve = null;

    function toBn(value) {
      return String(value).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
    }

    // ডাটাবেসের লেখা (ঠিকানা ইত্যাদি) নিরাপদে innerHTML এ বসানোর জন্য
    function esc(value) {
      const div = document.createElement('div');
      div.textContent = value ?? '';
      return div.innerHTML;
    }

    function askConfirm({ title, text, okLabel }) {
      return new Promise((resolve) => {
        dealSheetTitle.textContent = title;
        dealSheetText.textContent = text;
        dealSheetOk.textContent = okLabel;
        dealResolve = resolve;
        dealSheet.classList.add('open');
      });
    }

    function closeDealSheet(result) {
      dealSheet.classList.remove('open');
      if (dealResolve) {
        const resolve = dealResolve;
        dealResolve = null;
        resolve(result);
      }
    }

    dealSheetOk.addEventListener('click', () => closeDealSheet(true));
    dealSheetClose.addEventListener('click', () => closeDealSheet(false));
    dealSheet.addEventListener('click', (e) => {
      if (e.target === dealSheet) closeDealSheet(false);
    });

    // কনফার্মের ঠিক আগে ডাটাবেস থেকে হালনাগাদ সেরা (সর্বনিম্ন active) অফার আনা —
    // কার্ডে দেখানো দাম ১৫ সেকেন্ড পর্যন্ত পুরোনো হতে পারে
    async function fetchCurrentBestPrice(req) {
      const { data, error } = await supabase
        .from('delivery_offers')
        .select('offer_price')
        .eq('request_id', req.id)
        .eq('status', 'active')
        .order('offer_price', { ascending: true })
        .limit(1)
        .maybeSingle();
      if (error || !data) return null;
      return Number(data.offer_price);
    }

    // ইউজার কিছু টাইপ করছে বা শিট খোলা থাকলে অটো-রিফ্রেশে কার্ড নতুন করে আঁকা হবে না
    function isUserInteracting() {
      if (dealSheet.classList.contains('open')) return true;
      const fields = ordersContainer.querySelectorAll('input, textarea');
      return Array.from(fields).some((el) => el === document.activeElement || (el.value && el.value.trim() !== ''));
    }

    function formatDate(iso) {
      return new Date(iso).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function formatMinutesLeft(expiresAt) {
      if (!expiresAt) return null;
      const diffMs = new Date(expiresAt).getTime() - Date.now();
      if (diffMs <= 0) return null;
      const mins = Math.ceil(diffMs / 60000);
      if (mins >= 60) return `${Math.ceil(mins / 60)} ঘণ্টা বাকি`;
      return `${mins} মিনিট বাকি`;
    }

    // ============ SHOP ORDER স্টেপার (অপরিবর্তিত) ============
    function renderStepper(status) {
      if (status === 'cancelled') {
        return `<div class="cancelled-note"><i class="fas fa-xmark"></i> অর্ডারটি বাতিল হয়েছে</div>`;
      }
      const currentIndex = STEPS.indexOf(status);
      let dotsHtml = '';
      STEPS.forEach((step, i) => {
        const isDone = i <= currentIndex;
        dotsHtml += `<div class="step-dot ${isDone ? 'done' : ''}"><i class="fas fa-check"></i></div>`;
        if (i < STEPS.length - 1) {
          dotsHtml += `<div class="step-line ${i < currentIndex ? 'done' : ''}"></div>`;
        }
      });
      const labelsHtml = STEPS.map((s) => `<span>${STEP_LABELS[s]}</span>`).join('');
      return `<div class="status-stepper">${dotsHtml}</div><div class="step-label-row">${labelsHtml}</div>`;
    }

    // ============ DELIVERY স্টেপার ============
    function renderDeliveryStepper(req) {
      const status = req.status;
      if (status === 'cancelled') {
        return `<div class="cancelled-note"><i class="fas fa-xmark"></i> রিকোয়েস্টটি বাতিল হয়েছে</div>`;
      }
      if (status === 'disputed') {
        return `<div class="disputed-note"><i class="fas fa-triangle-exclamation"></i> এডমিন পর্যালোচনা করছে</div>`;
      }

      // confirmed অবস্থায় pickup_done_at সেট থাকলে (বা status already delivered/completed
      // হয়ে গেলে, যার মানে পিকআপ তো আগেই হয়ে গেছে) "picked_up" ধাপ দেখাবে
      let mapped = status;
      if (status === 'confirmed' && req.pickup_done_at) mapped = 'picked_up';
      if (status === 'delivered') mapped = 'picked_up';

      // ৪ ধাপের প্রগ্রেস বার: অফারের অপেক্ষা → হিরো আসছে → পথে → সম্পন্ন
      const isRideReq = req.category === 'ride';
      const huLabels = ['অফারের অপেক্ষা', 'হিরো আসছে', isRideReq ? 'যাত্রা চলছে' : 'ডেলিভারি পথে', 'সম্পন্ন'];
      let filled = 1;
      if (mapped === 'confirmed') filled = 2;
      else if (mapped === 'picked_up') filled = 3;
      else if (mapped === 'completed') filled = 4;
      const bars = [1, 2, 3, 4].map((n) => `<i class="${n <= filled ? 'f' : ''}"></i>`).join('');
      return `<p class="hu-steplabel">${huLabels[filled - 1]}</p><div class="hu-progress">${bars}</div>`;
    }

    // ============ SHOP ORDER কার্ড (অপরিবর্তিত) ============
    function renderShopOrderCard(order) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.orderId = order.id;

      const shop = order.shops;
      const itemsHtml = (order.order_items || [])
        .map((it) => `<div class="order-item-line"><span>${it.title || ''} × ${it.quantity}</span><span>৳${it.price || 0}</span></div>`)
        .join('');

      const contactHtml = shop?.phone
        ? `
          <div class="order-contact-row">
            <a href="tel:${shop.phone}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>
            <a href="https://wa.me/${shop.phone.replace(/\D/g, '')}" target="_blank" rel="noopener" class="order-contact-btn order-wa-btn"><i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ</a>
          </div>
        `
        : '';

      card.innerHTML = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge"><i class="fas fa-store"></i></span> ${shop?.name || 'শপ'}</p>
            <p class="order-date">${formatDate(order.created_at)}</p>
          </div>
        </div>
        ${renderStepper(order.status)}
        <div class="order-items-list">${itemsHtml}</div>
        ${contactHtml}
      `;

      return card;
    }

    // ============ ডাক্তারের সিরিয়াল রিকোয়েস্ট ============
    // আজকের তারিখ (ঢাকা), YYYY-MM-DD
    function todayDhaka() {
      return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka' }).format(new Date());
    }

    function dhakaHour() {
      return Number(new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Dhaka', hour: '2-digit', hourCycle: 'h23' }).format(new Date())) % 24;
    }

    function serialDayLabel(dateStr) {
      const [y, m, d] = String(dateStr).split('-').map(Number);
      const wd = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
      return `${BN_WEEKDAYS[wd]}, ${toBn(d)} ${BN_MONTHS[m - 1]}`;
    }

    function renderSerialStepper(status) {
      const currentIndex = SERIAL_STEPS.indexOf(status);
      let dotsHtml = '';
      SERIAL_STEPS.forEach((step, i) => {
        const isDone = i <= currentIndex;
        dotsHtml += `<div class="step-dot ${isDone ? 'done' : ''}"><i class="fas fa-check"></i></div>`;
        if (i < SERIAL_STEPS.length - 1) {
          dotsHtml += `<div class="step-line ${i < currentIndex ? 'done' : ''}"></div>`;
        }
      });
      const labelsHtml = SERIAL_STEPS.map((s) => `<span>${SERIAL_STEP_LABELS[s]}</span>`).join('');
      return `<div class="status-stepper">${dotsHtml}</div><div class="step-label-row">${labelsHtml}</div>`;
    }

    function renderSerialCard(sr) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.serialId = sr.id;

      const hasPersonal = !!sr.patient_name;
      const isOpen = sr.status === 'pending' || sr.status === 'processing';

      let body = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge serial-icon"><i class="fas fa-ticket"></i></span> ডাক্তারের সিরিয়াল রিকোয়েস্ট</p>
            <p class="order-date">${formatDate(sr.created_at)}</p>
          </div>
        </div>
      `;

      // অবস্থা: ধাপ বা নোট
      if (sr.status === 'unreachable') {
        body += `<div class="cancelled-note"><i class="fas fa-phone-slash"></i> প্রতিনিধি ফোনে যোগাযোগ করতে পারেননি</div>`;
      } else if (sr.status === 'cancelled') {
        body += `<div class="cancelled-note"><i class="fas fa-xmark"></i> অনুরোধটি বাতিল হয়েছে</div>`;
      } else if (sr.status === 'expired') {
        body += `<div class="cancelled-note"><i class="fas fa-hourglass-end"></i> মেয়াদ শেষ হয়েছে</div>`;
      } else {
        body += renderSerialStepper(sr.status);
      }

      // ডাক্তার, ক্লিনিক, দিন
      body += `
        <div class="sr-info">
          <p class="sr-doctor">${esc(sr.doctor_name)}</p>
          <p class="sr-meta"><i class="fas fa-hospital"></i> ${esc(sr.clinic_name)}</p>
          <p class="sr-day"><i class="fas fa-calendar-day"></i> ${serialDayLabel(sr.requested_date)}</p>
          ${hasPersonal ? `<p class="sr-patient">রোগী: ${esc(sr.patient_name)}</p>` : ''}
        </div>
      `;

      if (sr.status === 'pending') {
        const night = dhakaHour() < 9 || dhakaHour() >= 21;
        body += `<div class="waiting-note">ক্লিনিকে অনুরোধ পাঠানো হয়েছে। প্রতিনিধি সিরিয়াল নিয়ে আপনাকে কল করে জানাবেন।${night ? ' এখন রাত, সকাল ৯টার পর কল পাবেন।' : ''}</div>`;
      } else if (sr.status === 'processing') {
        body += `<div class="sr-processing-note"><i class="fas fa-spinner fa-spin"></i> আপনার সিরিয়ালের জন্য চেষ্টা চলছে। প্রতিনিধি শীঘ্রই কল করে সিরিয়াল নম্বর জানাবেন, কল এলে ধরুন।</div>`;
      } else if (sr.status === 'confirmed') {
        body += `
          <div class="sr-serial-box">
            <span class="sr-serial-label">আপনার সিরিয়াল নম্বর</span>
            <span class="sr-serial-no">${esc(sr.serial_no || '')}</span>
            <span class="sr-serial-sub">${esc(sr.doctor_name)} · ${serialDayLabel(sr.requested_date)}</span>
            ${sr.rep_note ? `<p class="sr-note-line"><i class="fas fa-circle-info"></i> ${esc(sr.rep_note)}</p>` : ''}
          </div>
        `;
      } else if (sr.status === 'unreachable') {
        body += `<p class="sr-off-note">প্রয়োজনে সরাসরি ক্লিনিকে কল করে সিরিয়াল নিন।</p>`;
      } else if (sr.status === 'cancelled' && sr.rep_note) {
        body += `<p class="sr-off-note">${esc(sr.rep_note)}</p>`;
      }

      if (isOpen) {
        body += `<button class="btn-cancel-request" data-serial-cancel="${sr.id}"><i class="fas fa-ban"></i> অনুরোধ বাতিল করুন</button>`;
      }

      card.innerHTML = body;

      card.querySelector('[data-serial-cancel]')?.addEventListener('click', async (e) => {
        if (!confirm('সিরিয়াল রিকোয়েস্টটি বাতিল করতে চান?')) return;
        const btn = e.currentTarget;
        btn.disabled = true;
        const { error } = await supabase.rpc('serial_patient_cancel', { p_id: sr.id });
        if (error) {
          alert(error.message.includes('invalid_status') ? 'অনুরোধের অবস্থা বদলে গেছে, পেজ রিফ্রেশ হচ্ছে' : 'বাতিল করা যায়নি: ' + error.message);
          btn.disabled = false;
        }
        refreshOrders();
      });

      return card;
    }

    // ============ DELIVERY কার্ড ============
    // পেমেন্ট প্রুফ আপলোড বক্স (confirmed-এ পিকআপের পর, completed-এ ১ ঘণ্টার মধ্যে)
    function paymentProofBoxHtml(reqId) {
      return `
        <div class="payment-proof-box" data-request-id="${reqId}">
          <label>
            <i class="fas fa-camera"></i> পেমেন্ট প্রুফ আপলোড করুন
            <input type="file" accept="image/*" multiple data-proof-input />
          </label>
          <div class="proof-thumbs" data-proof-thumbs></div>
        </div>
      `;
    }

    function renderDeliveryCard(req) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.reqId = req.id;

      const offers = req.delivery_offers || [];
      const acceptedRiderProfile = req.accepted_rider?.profiles;
      const acceptedRiderPhone = acceptedRiderProfile?.phone;

      const lowestOffer = offers.length
        ? Math.min(...offers.map((o) => Number(o.offer_price)))
        : null;
      const askingPrice = Number(req.customer_asking_price ?? req.initial_price);

      const pickupText = req.pickup_address || req.area_detail || '';
      const dropText = req.drop_address || '';

      let bodyHtml = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge ${req.category === 'ride' ? 'ride-icon' : 'delivery-icon'}"><i class="fas ${req.category === 'ride' ? 'fa-route' : 'fa-motorcycle'}"></i></span> ${req.category === 'ride' ? 'রাইড রিকোয়েস্ট' : 'হোম ডেলিভারি রিকোয়েস্ট'}</p>
            <p class="order-date">${formatDate(req.created_at)}</p>
          </div>
        </div>
        ${renderDeliveryStepper(req)}
        <p class="delivery-desc">${req.description || ''}</p>
        <div class="hu-trip">
          <div class="hu-trip-stop">${esc(pickupText) || '—'}<small>পিকআপ</small></div>
          <div class="hu-trip-stop">${esc(dropText) || '—'}<small>${req.category === 'ride' ? 'গন্তব্য' : 'ডেলিভারি'}</small></div>
        </div>
      `;

      if (req.status === 'open' || req.status === 'negotiating') {
        const minutesLeft = formatMinutesLeft(req.expires_at);
        if (minutesLeft) {
          bodyHtml += `<span class="delivery-expiry-note"><i class="fas fa-hourglass-half"></i> ${minutesLeft}, তারপর অটো বাতিল হবে</span>`;
        }

        bodyHtml += `
          <div class="hu-prices">
            <div class="hu-price ${lowestOffer !== null ? 'best' : 'wait'}">
              <small>সেরা হিরো অফার</small>
              <b>${lowestOffer !== null ? `৳${toBn(lowestOffer)}` : 'অপেক্ষায়...'}</b>
            </div>
            <div class="hu-price">
              <small>আপনার প্রস্তাব</small>
              <b>৳${toBn(askingPrice)}</b>
            </div>
          </div>
        `;

        if (offers.length === 0) {
          bodyHtml += `<p class="no-offers-note">এখনো কোনো হিরো সাড়া দেয়নি, একটু অপেক্ষা করো...</p>`;
        }

        bodyHtml += `
          <div class="increase-price-row">
            <div class="inc-chips">
              <button type="button" data-inc="5">+৫</button>
              <button type="button" data-inc="10">+১০</button>
              <button type="button" data-inc="20">+২০</button>
            </div>
            <div class="inc-input-line">
              <input type="number" placeholder="৳${askingPrice + 1} বা বেশি" min="${askingPrice + 1}" />
              <button type="button" data-action="submit-increase"><i class="fas fa-paper-plane"></i> পাঠান</button>
            </div>
          </div>
          <div class="deal-actions">
            <button type="button" class="btn-increase-price" data-action="show-increase">দাম বাড়ান</button>
            <button type="button" class="btn-confirm-best-price" data-action="confirm-best" ${offers.length === 0 ? 'disabled' : ''}><i class="fas fa-check-circle"></i> নিশ্চিত করুন</button>
          </div>
        `;

        bodyHtml += `<button class="btn-cancel-request" data-request-id="${req.id}"><i class="fas fa-ban"></i> রিকোয়েস্ট বাতিল করুন</button>`;
      } else if (req.status === 'confirmed') {
        // লাইভ স্টেজ তথ্য (হিরো সাইডের mark-pickup-done এর উপর ভিত্তি করে) —
        // শুধু তথ্য দেখানোর জন্য, কোনো বাটন/অ্যাকশন নাই, তাই হিরোর
        // .dh-stage-box থেকে আলাদা .customer-stage-box ক্লাস ব্যবহার হলো
        const isPickupDone = !!req.pickup_done_at;
        const isRide = req.category === 'ride';
        const stageStatusText = isPickupDone
          ? (isRide ? 'হিরো আপনাকে নিয়ে গন্তব্যের পথে' : 'হিরো আপনার ডেলিভারি নিয়ে পথে')
          : 'হিরো পিকআপের পথে আসছে';
        const stageTargetLabel = isPickupDone ? (isRide ? 'গন্তব্য' : 'ডেলিভারি লোকেশন') : 'পিকআপ লোকেশন';
        const stageTargetAddress = isPickupDone ? dropText : pickupText;
        const stageTargetInstruction = isPickupDone ? req.drop_instructions : req.pickup_instructions;
        const pickupTimeText = req.pickup_done_at
          ? new Date(req.pickup_done_at).toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' })
          : null;

        bodyHtml += `
          <div class="customer-stage-box ${isPickupDone ? 'stage-dropoff' : 'stage-pickup'}">
            <span class="customer-stage-status"><i class="fas fa-circle"></i> ${stageStatusText}</span>
            <span class="customer-stage-label">${stageTargetLabel}</span>
            <p class="customer-stage-address">${stageTargetAddress || ''}</p>
            ${stageTargetInstruction ? `<p class="customer-stage-instruction"><i class="fas fa-circle-info"></i> ${stageTargetInstruction}</p>` : ''}
            ${pickupTimeText ? `<p class="customer-stage-time"><i class="fas fa-check"></i> পিকআপ হয়েছে: ${pickupTimeText}</p>` : ''}
          </div>
        `;

        bodyHtml += `
          <div class="order-contact-row">
            ${acceptedRiderPhone ? `<a href="tel:${acceptedRiderPhone}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>` : ''}
            <button type="button" class="order-contact-btn order-chat-btn" data-chat-request-id="${req.id}" data-chat-other-name="${acceptedRiderProfile?.full_name || 'হিরো'}"><i class="fas fa-comment-dots"></i> চ্যাট</button>
          </div>
          <div class="waiting-note">${req.category === 'ride' ? 'যাত্রা শেষে হিরো নিজেই সম্পন্ন মার্ক করবেন, আপনাকে নোটিফিকেশন যাবে' : 'ডেলিভারি শেষে হিরো নিজেই সম্পন্ন মার্ক করবেন, আপনাকে নোটিফিকেশন যাবে'}</div>
          ${isPickupDone ? paymentProofBoxHtml(req.id) : ''}
          <button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>
        `;
      } else if (req.status === 'delivered') {
        bodyHtml += `
          <div class="waiting-note">${req.category === 'ride' ? 'রাইড হিরোর কনফার্মেশনের অপেক্ষায়...' : 'রাইডারের কনফার্মেশনের অপেক্ষায়...'}</div>
          <div class="payment-proof-box" data-request-id="${req.id}">
            <label>
              <i class="fas fa-camera"></i> পেমেন্ট প্রুফ আপলোড করুন
              <input type="file" accept="image/*" multiple data-proof-input />
            </label>
            <div class="proof-thumbs" data-proof-thumbs></div>
          </div>
          <button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>
        `;
      }

      if (req.status === 'completed') {
        if (req.__hasReview) {
          bodyHtml += `<p class="review-submitted-note"><i class="fas fa-star"></i> রিভিউ দেওয়া হয়েছে, ধন্যবাদ!</p>`;
        } else {
          bodyHtml += `
            <div class="review-box" data-request-id="${req.id}">
              <div class="review-stars">
                ${[1, 2, 3, 4, 5].map((n) => `<button data-star="${n}"><i class="fas fa-star"></i></button>`).join('')}
              </div>
              <textarea placeholder="মতামত (ঐচ্ছিক)" data-review-comment></textarea>
              <button class="btn-submit-review">রিভিউ জমা দিন</button>
            </div>
          `;
        }

        // সম্পন্ন হওয়ার ১ ঘন্টার মধ্যে ডিসপিউট রেইজ করার সুযোগ (updated_at
        // কে completed_at এর প্রক্সি হিসেবে ব্যবহার করা হচ্ছে — সার্ভার
        // সাইডেও (raise-dispute.js) একই ১ ঘন্টা লিমিট চেক হয়)
        const completedAt = req.updated_at ? new Date(req.updated_at).getTime() : 0;
        const withinDisputeWindow = Date.now() - completedAt <= 60 * 60 * 1000;
        if (withinDisputeWindow) {
          bodyHtml += paymentProofBoxHtml(req.id);
          bodyHtml += `<button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>`;
        }
      }

      card.innerHTML = bodyHtml;
      attachDeliveryCardEvents(card, req);
      return card;
    }

    function attachDeliveryCardEvents(card, req) {
      // বর্তমান সেরা মূল্যে নিশ্চিত করা
      card.querySelector('[data-action="confirm-best"]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        if (btn.disabled) return;

        // ১) হালনাগাদ সেরা দাম আনা
        btn.disabled = true;
        const freshPrice = await fetchCurrentBestPrice(req);
        btn.disabled = false;

        if (freshPrice === null) {
          alert('এখন কোনো হিরোর অফার নেই। একটু অপেক্ষা করুন।');
          refreshOrders();
          return;
        }

        // ২) ভুল চাপ ঠেকাতে আগে জিজ্ঞেস করা
        const ok = await askConfirm({
          title: `৳${toBn(freshPrice)}-এ নিশ্চিত করবেন?`,
          text: 'নিশ্চিত করলে এই হিরোর সাথে দাম ঠিক হয়ে যাবে এবং আর বদলানো যাবে না।',
          okLabel: `হ্যাঁ, ৳${toBn(freshPrice)}-এ নিশ্চিত করুন`,
        });
        if (!ok) return;

        // ৩) নিশ্চিত করা
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> নিশ্চিত করা হচ্ছে...';
        const { error } = await confirmBestPrice({ requestId: req.id });
        if (error) {
          alert(error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check-circle"></i> নিশ্চিত করুন';
          return;
        }
        refreshOrders();
      });

      // প্রস্তাবিত মূল্য বাড়ানো (শুধু বাড়ানো যাবে, কমানো যাবে না)
      const increaseRow = card.querySelector('.increase-price-row');
      card.querySelector('[data-action="show-increase"]')?.addEventListener('click', () => {
        increaseRow.classList.toggle('active');
        if (increaseRow.classList.contains('active')) increaseRow.querySelector('input')?.focus();
      });

      increaseRow?.querySelectorAll('[data-inc]').forEach((chip) => {
        chip.addEventListener('click', () => {
          const base = Number(req.customer_asking_price ?? req.initial_price);
          const input = increaseRow.querySelector('input');
          input.value = String(base + Number(chip.dataset.inc));
          input.focus();
        });
      });

      card.querySelector('[data-action="submit-increase"]')?.addEventListener('click', async () => {
        const input = increaseRow.querySelector('input');
        const newPrice = Number(input.value);
        const currentAsking = Number(req.customer_asking_price ?? req.initial_price);
        if (!newPrice || newPrice <= currentAsking) {
          alert(`বর্তমান দামের (৳${currentAsking}) চেয়ে বেশি দিতে হবে`);
          return;
        }
        const { error } = await updateAskingPrice({ requestId: req.id, newPrice });
        if (error) {
          alert(error);
          return;
        }
        refreshOrders();
      });

      // রিকোয়েস্ট বাতিল
      card.querySelector('.btn-cancel-request')?.addEventListener('click', async (e) => {
        if (!confirm('রিকোয়েস্টটি বাতিল করতে চাও?')) return;
        e.target.disabled = true;
        const { error } = await cancelRequest({ requestId: req.id });
        if (error) {
          alert(error);
          e.target.disabled = false;
          return;
        }
        refreshOrders();
      });

      // পেমেন্ট প্রুফ আপলোড
      const proofInput = card.querySelector('[data-proof-input]');
      proofInput?.addEventListener('change', async (e) => {
        const rawFiles = Array.from(e.target.files || []);
        if (rawFiles.length === 0) return;

        // পেমেন্ট স্ক্রিনশটে টাকার এমাউন্ট/ট্রানজেকশন আইডি টেক্সট থাকে,
        // তাই বেশি কোয়ালিটি রাখা হলো (quality 0.9) যাতে টেক্সট ঝাপসা
        // না হয়ে যায় (JPEG-এ কনভার্ট হবে, কিন্তু উচ্চ কোয়ালিটিতে
        // টেক্সট স্পষ্ট থাকে)
        const files = await compressImages(rawFiles, { maxDimension: 1800, quality: 0.9 });

        const thumbsEl = card.querySelector('[data-proof-thumbs]');
        const imageUrls = [];

        for (const file of files) {
          const fileName = `${req.id}/${Date.now()}-${file.name}`;
          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('delivery-proofs')
            .upload(fileName, file);

          if (uploadError) {
            alert('ছবি আপলোড ব্যর্থ: ' + uploadError.message);
            continue;
          }

          const { data: urlData } = supabase.storage.from('delivery-proofs').getPublicUrl(uploadData.path);
          imageUrls.push(urlData.publicUrl);

          const img = document.createElement('img');
          img.src = urlData.publicUrl;
          thumbsEl.appendChild(img);
        }

        if (imageUrls.length > 0) {
          const { error } = await uploadPaymentProof({ requestId: req.id, imageUrls });
          if (error) alert('সেভ ব্যর্থ: ' + error);
        }
      });

      // ডিসপিউট
      card.querySelector('.dispute-link')?.addEventListener('click', () => {
        window.openDisputeModal({ requestId: req.id, onSuccess: refreshOrders });
      });

      // চ্যাট
      card.querySelector('.order-chat-btn')?.addEventListener('click', (e) => {
        const btn = e.currentTarget;
        window.openChatModal({
          requestId: btn.dataset.chatRequestId,
          otherPartyName: btn.dataset.chatOtherName,
        });
      });

      // রিভিউ
      const reviewBox = card.querySelector('.review-box');
      if (reviewBox) {
        let selectedRating = 0;
        const starButtons = reviewBox.querySelectorAll('[data-star]');
        starButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            selectedRating = Number(btn.dataset.star);
            starButtons.forEach((b) => b.classList.toggle('active', Number(b.dataset.star) <= selectedRating));
          });
        });

        reviewBox.querySelector('.btn-submit-review')?.addEventListener('click', async (e) => {
          if (selectedRating === 0) {
            alert('রেটিং সিলেক্ট করো');
            return;
          }
          e.target.disabled = true;
          const comment = reviewBox.querySelector('[data-review-comment]').value.trim();
          const { error } = await submitReview({ requestId: req.id, rating: selectedRating, comment });
          if (error) {
            alert(error);
            e.target.disabled = false;
            return;
          }
          refreshOrders();
        });
      }
    }

    // ============ মার্জ ও রেন্ডার ============
    function isOngoingItem(item) {
      if (item.__type === 'shop_order') return item.status === 'pending' || item.status === 'confirmed';
      if (item.__type === 'serial') {
        if (item.status === 'pending' || item.status === 'processing') return true;
        // কনফার্ম হওয়া সিরিয়াল ডাক্তারের দিন পার না হওয়া পর্যন্ত "চলমান"-এ থাকে
        if (item.status === 'confirmed') return String(item.requested_date) >= todayDhaka();
        return false;
      }
      return ['open', 'negotiating', 'confirmed', 'delivered', 'disputed'].includes(item.status);
    }

    function syncTabButtons() {
      ordersTabs.querySelectorAll('.mo-tab').forEach((b) => {
        b.classList.toggle('active', b.dataset.tab === activeTab);
      });
    }

    // ?req=<id> / ?order=<id> / ?serial=<id> থেকে আসা কার্ডে স্ক্রল ও হাইলাইট (শুধু প্রথমবার)
    function findDeepLinkTarget(combined) {
      const reqId = deepLinkParams.get('req');
      const orderId = deepLinkParams.get('order');
      const serialId = deepLinkParams.get('serial');
      if (reqId) return combined.find((i) => i.__type === 'delivery' && i.id === reqId) || null;
      if (orderId) return combined.find((i) => i.__type === 'shop_order' && i.id === orderId) || null;
      if (serialId) return combined.find((i) => i.__type === 'serial' && i.id === serialId) || null;
      return null;
    }

    function scrollToDeepLinkCard(target) {
      const selector = target.__type === 'delivery'
        ? `[data-req-id="${target.id}"]`
        : target.__type === 'serial'
          ? `[data-serial-id="${target.id}"]`
          : `[data-order-id="${target.id}"]`;
      const card = ordersContainer.querySelector(selector);
      if (!card) return;
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.add('order-card-highlight');
      setTimeout(() => card.classList.remove('order-card-highlight'), 2600);
    }

    function paint() {
      const { shopOrders, deliveryRequests, serialRequests, reviewedRequestIds } = lastData;
      ordersContainer.innerHTML = '';

      const combined = [
        ...shopOrders.map((o) => ({ ...o, __type: 'shop_order' })),
        ...deliveryRequests.map((d) => ({ ...d, __type: 'delivery', __hasReview: reviewedRequestIds.has(d.id) })),
        ...serialRequests.map((s) => ({ ...s, __type: 'serial' })),
      ].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

      if (combined.length === 0) {
        ordersTabs.style.display = 'none';
        emptyOrders.style.display = 'block';
        return;
      }
      emptyOrders.style.display = 'none';
      ordersTabs.style.display = 'flex';

      let deepTarget = null;
      if (!deepLinkHandled) {
        deepLinkHandled = true;
        deepTarget = findDeepLinkTarget(combined);
        if (deepTarget) activeTab = isOngoingItem(deepTarget) ? 'ongoing' : 'done';
      }

      const ongoingCount = combined.filter(isOngoingItem).length;
      tabCountOngoing.textContent = ongoingCount > 0 ? toBn(ongoingCount) : '';
      syncTabButtons();

      const visible = combined.filter((item) => (activeTab === 'ongoing') === isOngoingItem(item));

      if (visible.length === 0) {
        const msg = activeTab === 'ongoing' ? 'এখন কোনো চলমান অর্ডার বা সিরিয়াল নেই' : 'এখনো কোনো সম্পন্ন অর্ডার বা সিরিয়াল নেই';
        ordersContainer.innerHTML = `<p class="tab-empty">${msg}</p>`;
        return;
      }

      visible.forEach((item) => {
        let card;
        if (item.__type === 'shop_order') card = renderShopOrderCard(item);
        else if (item.__type === 'serial') card = renderSerialCard(item);
        else card = renderDeliveryCard(item);
        ordersContainer.appendChild(card);
      });

      if (deepTarget) setTimeout(() => scrollToDeepLinkCard(deepTarget), 80);
    }

    function renderAll(shopOrders, deliveryRequests, serialRequests, reviewedRequestIds) {
      lastData = { shopOrders, deliveryRequests, serialRequests, reviewedRequestIds };
      paint();
    }

    ordersTabs.addEventListener('click', (e) => {
      const btn = e.target.closest('.mo-tab');
      if (!btn || !lastData) return;
      activeTab = btn.dataset.tab;
      paint();
    });

    async function loadOrders(userId, { silent = false } = {}) {
      const [ordersRes, deliveryRes, reviewsRes, serialRes] = await Promise.all([
        supabase
          .from('orders')
          .select('*, order_items(*), shops(name, slug, phone)')
          .eq('user_id', userId)
          .order('created_at', { ascending: false }),
        supabase
          .from('delivery_requests')
          .select(`
            *,
            delivery_offers(id, offer_price, status),
            accepted_rider:delivery_riders!delivery_requests_accepted_rider_id_fkey(profile_id, vehicle_type, profiles!delivery_riders_profile_id_fkey(full_name, phone))
          `)
          .eq('customer_profile_id', userId)
          .order('created_at', { ascending: false }),
        supabase.from('delivery_reviews').select('request_id').eq('customer_profile_id', userId),
        supabase
          .from('serial_requests')
          .select('id, doctor_name, clinic_name, requested_date, status, serial_no, rep_note, patient_name, created_at')
          .eq('requester_id', userId)
          .order('created_at', { ascending: false })
          .limit(60),
      ]);

      if (!silent) {
        loadingState.style.display = 'none';
        ordersContent.style.display = 'block';
      }

      if (ordersRes.error || deliveryRes.error) {
        if (!silent) {
          console.error('অর্ডার লোড এরর:', ordersRes.error?.message, deliveryRes.error?.message);
          ordersContainer.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${ordersRes.error?.message || deliveryRes.error?.message || ''}</p>`;
        }
        return;
      }

      // সিরিয়াল লোডে সমস্যা হলে বাকি অর্ডার দেখানো আটকাবে না
      if (serialRes.error) console.error('সিরিয়াল লোড এরর:', serialRes.error.message);
      const serialRequests = serialRes.error ? [] : (serialRes.data || []);

      const reviewedRequestIds = new Set((reviewsRes.data || []).map((r) => r.request_id));

      const deliveryRequests = (deliveryRes.data || []).map((req) => ({
        ...req,
        delivery_offers: (req.delivery_offers || []).filter((o) => o.status === 'active'),
      }));

      // ইউজার কিছু টাইপ করছে বা কনফার্ম শিট খোলা থাকলে অটো-রিফ্রেশে কার্ড নতুন করে আঁকব না
      if (silent && isUserInteracting()) return;

      renderAll(ordersRes.data || [], deliveryRequests, serialRequests, reviewedRequestIds);
    }

    function refreshOrders() {
      if (currentUserId) loadOrders(currentUserId);
    }

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;

      await expireRequests();
      await loadOrders(currentUserId);

      refreshTimer = setInterval(() => {
        loadOrders(currentUserId, { silent: true });
      }, 15000);
    }

    window.addEventListener('beforeunload', () => {
      if (refreshTimer) clearInterval(refreshTimer);
    });

    init();
  </script>
</BaseLayout>
