    let refreshTimer = null;

    // ট্যাব + ডিপ-লিংক স্টেট
    let activeTab = 'ongoing';
    // ধরন ফিল্টার (সব / অনলাইন শপ / ডেলিভারি / লোকাল রাইড / ডাক্তার সিরিয়াল / অফলাইন) — পেজ রিফ্রেশেও মনে থাকে
    let activeType = 'all';
    try { activeType = sessionStorage.getItem('mo_type') || 'all'; } catch (_) { /* সেশন স্টোরেজ না থাকলেও চলবে */ }
    let deepLinkHandled = false;
    let lastData = null;
    const deepLinkParams = new URLSearchParams(window.location.search);
    if (deepLinkParams.get('tab') === 'done') activeTab = 'done';
    const ordersTabs = document.getElementById('ordersTabs');
    const tabCountOngoing = document.getElementById('tabCountOngoing');
    const ordersFilter = document.getElementById('ordersFilter');
    const typeFilter = document.getElementById('typeFilter');

    // ============ কনফার্ম বটম শিট ============
    // শিটটা পেজের কার্ড-কনটেইনারের বাইরে, তাই ১৫ সেকেন্ডের রিফ্রেশে বন্ধ হয় না
    const dealSheet = document.getElementById('dealSheet');
    const dealSheetTitle = document.getElementById('dealSheetTitle');
    const dealSheetText = document.getElementById('dealSheetText');
    const dealSheetOk = document.getElementById('dealSheetOk');
    const dealSheetClose = document.getElementById('dealSheetClose');
    let dealResolve = null;

    function toBn(value) {
      return String(value).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
    }

    // ডাটাবেসের লেখা (ঠিকানা ইত্যাদি) নিরাপদে innerHTML এ বসানোর জন্য
    function esc(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function askConfirm({ title, text, okLabel }) {
      return new Promise((resolve) => {
        dealSheetTitle.textContent = title;
        dealSheetText.textContent = text;
        dealSheetOk.textContent = okLabel;
        dealResolve = resolve;
        dealSheet.classList.add('open');
      });
    }

    function closeDealSheet(result) {
      dealSheet.classList.remove('open');
      if (dealResolve) {
        const resolve = dealResolve;
        dealResolve = null;
        resolve(result);
      }
    }

    dealSheetOk.addEventListener('click', () => closeDealSheet(true));
    dealSheetClose.addEventListener('click', () => closeDealSheet(false));
    dealSheet.addEventListener('click', (e) => {
      if (e.target === dealSheet) closeDealSheet(false);
    });

    // কনফার্মের ঠিক আগে ডাটাবেস থেকে হালনাগাদ সেরা (সর্বনিম্ন active) অফার আনা —
    // কার্ডে দেখানো দাম ১৫ সেকেন্ড পর্যন্ত পুরোনো হতে পারে
    async function fetchCurrentBestPrice(req) {
      const { data, error } = await supabase
        .from('delivery_offers')
        .select('offer_price')
        .eq('request_id', req.id)
        .eq('status', 'active')
        .order('offer_price', { ascending: true })
        .limit(1)
        .maybeSingle();
      if (error || !data) return null;
      return Number(data.offer_price);
    }

    // ইউজার কিছু টাইপ করছে বা শিট খোলা থাকলে অটো-রিফ্রেশে কার্ড নতুন করে আঁকা হবে না
    function isUserInteracting() {
      if (dealSheet.classList.contains('open')) return true;
      const fields = ordersContainer.querySelectorAll('input, textarea');
      return Array.from(fields).some((el) => el === document.activeElement || (el.value && el.value.trim() !== ''));
    }

    function formatDate(iso) {
      return new Date(iso).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function formatMinutesLeft(expiresAt) {
      if (!expiresAt) return null;
      const diffMs = new Date(expiresAt).getTime() - Date.now();
      if (diffMs <= 0) return null;
      const mins = Math.ceil(diffMs / 60000);
      if (mins >= 60) return `${Math.ceil(mins / 60)} ঘণ্টা বাকি`;
      return `${mins} মিনিট বাকি`;
    }

    // ============ SHOP ORDER স্টেপার (অপরিবর্তিত) ============
    function renderStepper(status) {
      if (status === 'cancelled') {
        return `<div class="cancelled-note"><i class="fas fa-xmark"></i> অর্ডারটি বাতিল হয়েছে</div>`;
      }
      const currentIndex = STEPS.indexOf(status);
      let dotsHtml = '';
      STEPS.forEach((step, i) => {
        const isDone = i <= currentIndex;
        dotsHtml += `<div class="step-dot ${isDone ? 'done' : ''}"><i class="fas fa-check"></i></div>`;
        if (i < STEPS.length - 1) {
          dotsHtml += `<div class="step-line ${i < currentIndex ? 'done' : ''}"></div>`;
        }
      });
      const labelsHtml = STEPS.map((s) => `<span>${STEP_LABELS[s]}</span>`).join('');
      return `<div class="status-stepper">${dotsHtml}</div><div class="step-label-row">${labelsHtml}</div>`;
    }

    // ============ DELIVERY স্টেপার ============
    function renderDeliveryStepper(req) {
      const status = req.status;
      if (status === 'cancelled') {
        return `<div class="cancelled-note"><i class="fas fa-xmark"></i> রিকোয়েস্টটি বাতিল হয়েছে</div>`;
      }
      if (status === 'disputed') {
        return `<div class="disputed-note"><i class="fas fa-triangle-exclamation"></i> এডমিন পর্যালোচনা করছে</div>`;
      }

      // confirmed অবস্থায় pickup_done_at সেট থাকলে (বা status already delivered/completed
      // হয়ে গেলে, যার মানে পিকআপ তো আগেই হয়ে গেছে) "picked_up" ধাপ দেখাবে
      let mapped = status;
      if (status === 'confirmed' && req.pickup_done_at) mapped = 'picked_up';
      if (status === 'delivered') mapped = 'picked_up';

      // ৪ ধাপের প্রগ্রেস বার: অফারের অপেক্ষা → হিরো আসছে → পথে → সম্পন্ন
      const isRideReq = req.category === 'ride';
      const huLabels = ['অফারের অপেক্ষা', 'হিরো আসছে', isRideReq ? 'যাত্রা চলছে' : 'ডেলিভারি পথে', 'সম্পন্ন'];
      let filled = 1;
      if (mapped === 'confirmed') filled = 2;
      else if (mapped === 'picked_up') filled = 3;
      else if (mapped === 'completed') filled = 4;
      const bars = [1, 2, 3, 4].map((n) => `<i class="${n <= filled ? 'f' : ''}"></i>`).join('');
      return `<p class="hu-steplabel">${huLabels[filled - 1]}</p><div class="hu-progress">${bars}</div>`;
    }

    // ============ ম্যানুয়াল (অফলাইন) অর্ডার কার্ড ============
    function renderManualOrderCard(m) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.manualId = m.id;
      const total = Number(m.product_price || 0) + Number(m.delivery_fee || 0);
      const cod = Number(m.cod_amount || 0);
      const labels = ['অর্ডার নেওয়া হয়েছে', 'রাইডার ঠিক হয়েছে', 'ডেলিভারি পথে', 'ডেলিভারি সম্পন্ন'];
      let filled = 1;
      if (m.status === 'rider_assigned') filled = 2;
      else if (m.status === 'picked_up') filled = 3;
      else if (m.status === 'delivered' || m.status === 'completed') filled = 4;
      const bars = [1, 2, 3, 4].map((n) => `<i class="${n <= filled ? 'f' : ''}"></i>`).join('');
      const progress = m.status === 'cancelled'
        ? `<div class="cancelled-note"><i class="fas fa-xmark"></i> অর্ডারটি বাতিল হয়েছে</div>`
        : `<p class="hu-steplabel">${labels[filled - 1]}</p><div class="hu-progress">${bars}</div>`;
      const riderHtml = m.rider_name
        ? `<div class="order-items-list"><div class="order-item-line"><span>🛵 রাইডার</span><span>${esc(m.rider_name)}</span></div></div>`
        : '';
      const callHtml = m.rider_phone
        ? `<div class="order-contact-row"><a href="tel:${esc(m.rider_phone)}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> রাইডারকে কল করুন</a></div>`
        : '';
      card.innerHTML = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge"><i class="fas fa-motorcycle"></i></span> ডেলিভারি অর্ডার #${esc(m.order_no)}</p>
            <p class="order-date">${formatDate(m.created_at)}</p>
          </div>
        </div>
        ${orderTimeChip({ is_asap: m.is_asap, scheduled_at: m.scheduled_at })}
        ${progress}
        <div class="order-items-list">
          ${m.pickup_name ? `<div class="order-item-line"><span>পিকআপ</span><span>${esc(m.pickup_name)}</span></div>` : ''}
          <div class="order-item-line"><span>ড্রপ</span><span>${esc(m.drop_address || '')}</span></div>
          <div class="order-item-line"><span>অর্ডার</span><span>${esc(m.details || '')}</span></div>
          <div class="order-item-line"><span>মোট</span><span>৳${total}</span></div>
          ${Number(m.advance_amount) > 0 ? `<div class="order-item-line"><span>অ্যাডভান্স দিয়েছেন</span><span>৳${Number(m.advance_amount)}</span></div>` : ''}
          <div class="order-item-line"><span>ডেলিভারিতে দিতে হবে</span><span>৳${cod}</span></div>
        </div>
        ${riderHtml}
        ${callHtml}
      `;
      return card;
    }

    // ============ SHOP ORDER কার্ড (অপরিবর্তিত) ============
    function renderShopOrderCard(order) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.orderId = order.id;

      const shop = order.shops;
      const itemsHtml = (order.order_items || [])
        .map((it) => `<div class="order-item-line"><span>${esc(it.title || '')} × ${esc(it.quantity)}</span><span>৳${Number(it.price) || 0}</span></div>`)
        .join('');

      const contactHtml = shop?.phone
        ? `
          <div class="order-contact-row">
            <a href="tel:${esc(shop.phone)}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>
            <a href="https://wa.me/${shop.phone.replace(/\D/g, '')}" target="_blank" rel="noopener" class="order-contact-btn order-wa-btn"><i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ</a>
          </div>
        `
        : '';

      card.innerHTML = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge"><i class="fas fa-store"></i></span> ${esc(shop?.name || 'শপ')}</p>
            <p class="order-date">${formatDate(order.created_at)}</p>
          </div>
        </div>
        ${renderStepper(order.status)}
        <div class="order-items-list">${itemsHtml}</div>
        ${order.payment_method ? `<p class="order-date" style="margin:8px 0;"><i class="fas fa-wallet"></i> ${order.payment_method === 'bkash' ? (order.payment_status === 'verified' ? 'বিকাশ — পেমেন্ট যাচাই হয়েছে' : 'বিকাশ — পেমেন্ট যাচাইয়ের অপেক্ষায়') : 'ক্যাশ অন ডেলিভারি'}${order.items_total ? ' · মোট ৳' + toBn((Number(order.items_total) || 0) + (Number(order.delivery_fee) || 0)) + ' (ডেলিভারি চার্জ ৳' + toBn(Number(order.delivery_fee) || 0) + ')' : ''}</p>` : ''}
        ${contactHtml}
        ${order.status === 'pending' ? `<button type="button" class="btn-cancel-request" data-shop-cancel="${esc(order.id)}"><i class="fas fa-ban"></i> অর্ডার বাতিল করুন</button>` : ''}
      `;

      card.querySelector('[data-shop-cancel]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const ok = await askConfirm({
          title: 'অর্ডারটি বাতিল করবেন?',
          text: 'দোকান নিশ্চিত করার আগে পর্যন্ত বাতিল করা যায়। বাতিল করলে দোকানকে জানানো হবে।',
          okLabel: 'হ্যাঁ, বাতিল করুন',
        });
        if (!ok) return;
        btn.disabled = true;
        const { error } = await supabase.rpc('customer_cancel_shop_order', { p_order_id: order.id });
        if (error) {
          alert(error.message.includes('invalid_status')
            ? 'দোকান ইতিমধ্যে অর্ডারটি নিশ্চিত করেছে। বাতিল করতে দোকানে কল করুন।'
            : 'বাতিল করা যায়নি: ' + error.message);
          btn.disabled = false;
        }
        refreshOrders();
      });

      return card;
    }

    // ============ ডাক্তারের সিরিয়াল রিকোয়েস্ট ============
    // আজকের তারিখ (ঢাকা), YYYY-MM-DD
    function todayDhaka() {
      return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka' }).format(new Date());
    }

    function dhakaHour() {
      return Number(new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Dhaka', hour: '2-digit', hourCycle: 'h23' }).format(new Date())) % 24;
    }

    function serialDayLabel(dateStr) {
      const [y, m, d] = String(dateStr).split('-').map(Number);
      const wd = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
      return `${BN_WEEKDAYS[wd]}, ${toBn(d)} ${BN_MONTHS[m - 1]}`;
    }

    function renderSerialStepper(status) {
      const currentIndex = SERIAL_STEPS.indexOf(status);
      let dotsHtml = '';
      SERIAL_STEPS.forEach((step, i) => {
        const isDone = i <= currentIndex;
        dotsHtml += `<div class="step-dot ${isDone ? 'done' : ''}"><i class="fas fa-check"></i></div>`;
        if (i < SERIAL_STEPS.length - 1) {
          dotsHtml += `<div class="step-line ${i < currentIndex ? 'done' : ''}"></div>`;
        }
      });
      const labelsHtml = SERIAL_STEPS.map((s) => `<span>${SERIAL_STEP_LABELS[s]}</span>`).join('');
      return `<div class="status-stepper">${dotsHtml}</div><div class="step-label-row">${labelsHtml}</div>`;
    }

    function renderSerialCard(sr) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.serialId = sr.id;

      const hasPersonal = !!sr.patient_name;
      const isOpen = sr.status === 'pending' || sr.status === 'processing';

      let body = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge serial-icon"><i class="fas fa-ticket"></i></span> ডাক্তারের সিরিয়াল রিকোয়েস্ট</p>
            <p class="order-date">${formatDate(sr.created_at)}</p>
          </div>
        </div>
      `;

      // অবস্থা: ধাপ বা নোট
      if (sr.status === 'unreachable') {
        body += `<div class="cancelled-note"><i class="fas fa-phone-slash"></i> প্রতিনিধি ফোনে যোগাযোগ করতে পারেননি</div>`;
      } else if (sr.status === 'cancelled') {
        body += `<div class="cancelled-note"><i class="fas fa-xmark"></i> অনুরোধটি বাতিল হয়েছে</div>`;
      } else if (sr.status === 'expired') {
        body += `<div class="cancelled-note"><i class="fas fa-hourglass-end"></i> মেয়াদ শেষ হয়েছে</div>`;
      } else {
        body += renderSerialStepper(sr.status);
      }

      // ডাক্তার, ক্লিনিক, দিন
      body += `
        <div class="sr-info">
          <p class="sr-doctor">${esc(sr.doctor_name)}</p>
          <p class="sr-meta"><i class="fas fa-hospital"></i> ${esc(sr.clinic_name)}</p>
          <p class="sr-day"><i class="fas fa-calendar-day"></i> ${serialDayLabel(sr.requested_date)}</p>
          ${hasPersonal ? `<p class="sr-patient">রোগী: ${esc(sr.patient_name)}</p>` : ''}
        </div>
      `;

      if (sr.status === 'pending') {
        const night = dhakaHour() < 9 || dhakaHour() >= 21;
        body += `<div class="waiting-note">ক্লিনিকে অনুরোধ পাঠানো হয়েছে। প্রতিনিধি সিরিয়াল নিয়ে আপনাকে কল করে জানাবেন।${night ? ' এখন রাত, সকাল ৯টার পর কল পাবেন।' : ''}</div>`;
      } else if (sr.status === 'processing') {
        body += `<div class="sr-processing-note"><i class="fas fa-spinner fa-spin"></i> আপনার সিরিয়ালের জন্য চেষ্টা চলছে। প্রতিনিধি শীঘ্রই কল করে সিরিয়াল নম্বর জানাবেন, কল এলে ধরুন।</div>`;
      } else if (sr.status === 'confirmed') {
        body += `
          <div class="sr-serial-box">
            <span class="sr-serial-label">আপনার সিরিয়াল নম্বর</span>
            <span class="sr-serial-no">${esc(sr.serial_no || '')}</span>
            <span class="sr-serial-sub">${esc(sr.doctor_name)} · ${serialDayLabel(sr.requested_date)}</span>
            ${sr.rep_note ? `<p class="sr-note-line"><i class="fas fa-circle-info"></i> ${esc(sr.rep_note)}</p>` : ''}
          </div>
        `;
      } else if (sr.status === 'unreachable') {
        body += `<p class="sr-off-note">প্রয়োজনে সরাসরি ক্লিনিকে কল করে সিরিয়াল নিন।</p>`;
      } else if (sr.status === 'cancelled' && sr.rep_note) {
        body += `<p class="sr-off-note">${esc(sr.rep_note)}</p>`;
      }

      if (isOpen) {
        body += `<button class="btn-cancel-request" data-serial-cancel="${sr.id}"><i class="fas fa-ban"></i> অনুরোধ বাতিল করুন</button>`;
      }

      card.innerHTML = body;

      card.querySelector('[data-serial-cancel]')?.addEventListener('click', async (e) => {
        if (!confirm('সিরিয়াল রিকোয়েস্টটি বাতিল করতে চান?')) return;
        const btn = e.currentTarget;
        btn.disabled = true;
        const { error } = await supabase.rpc('serial_patient_cancel', { p_id: sr.id });
        if (error) {
          alert(error.message.includes('invalid_status') ? 'অনুরোধের অবস্থা বদলে গেছে, পেজ রিফ্রেশ হচ্ছে' : 'বাতিল করা যায়নি: ' + error.message);
          btn.disabled = false;
        }
        refreshOrders();
      });

      return card;
    }

    // ============ DELIVERY কার্ড ============
    // পেমেন্ট প্রুফ আপলোড বক্স (confirmed-এ পিকআপের পর, completed-এ ১ ঘণ্টার মধ্যে)
    function paymentProofBoxHtml(reqId) {
      return `
        <div class="payment-proof-box" data-request-id="${reqId}">
          <label>
            <i class="fas fa-camera"></i> পেমেন্ট প্রুফ আপলোড করুন
            <input type="file" accept="image/*" multiple data-proof-input />
          </label>
          <div class="proof-thumbs" data-proof-thumbs></div>
        </div>
      `;
    }

    // অ্যাডমিন ডিল বক্স (পাবলিশের অপেক্ষায়/হোল্ড অর্ডারে) — চ্যাট বাটন + অফার থাকলে নিলাম/নিলাম না
    function dealBlockHtml(req) {
      const price = req.admin_offer_price ? toBn(Number(req.admin_offer_price)) : '';
      const noteStyle = 'margin:0 0 8px;font-weight:800;color:#7C2D12;font-size:0.9rem;';
      const chatBtn = `<button type="button" class="order-contact-btn order-deal-chat-btn" data-chat-request-id="${req.id}"><i class="fas fa-comment-dots"></i> অ্যাডমিনের সাথে কথা বলুন</button>`;
      let inner = '';
      if (req.admin_offer_status === 'offered') {
        inner = `<p style="${noteStyle}">💰 অ্যাডমিনের ডেলিভারি চার্জ প্রস্তাব: ৳${price}</p>
          <div style="display:flex;gap:8px;margin-bottom:8px;">
            <button type="button" data-action="deal-accept" style="flex:1;min-height:44px;border:0;border-radius:12px;background:#16A34A;color:#fff;font-weight:800;font-family:inherit;cursor:pointer;">নিলাম</button>
            <button type="button" data-action="deal-decline" style="flex:1;min-height:44px;border:1.5px solid #E5EAF0;border-radius:12px;background:#fff;color:#B3261E;font-weight:800;font-family:inherit;cursor:pointer;">নিলাম না</button>
          </div>`;
      } else if (req.admin_offer_status === 'accepted') {
        inner = `<p style="${noteStyle}">✅ আপনি ৳${price} মেনে নিয়েছেন। অ্যাডমিন রাইডার ঠিক করছেন।</p>`;
      } else {
        inner = `<p style="${noteStyle}">অ্যাডমিন চার্জ নিয়ে আপনার সাথে কথা বলতে পারেন। আপনিও চাইলে লিখতে পারেন।</p>`;
      }
      return `<div class="deal-box" style="background:#FFF7ED;border:1.5px solid #FED7AA;border-radius:16px;padding:12px;margin:10px 0;">${inner}${chatBtn}</div>`;
    }

    // কুইক ডেলিভারি অর্ডারের ৫ ধাপ (শুরু থেকেই): অর্ডার → রাইডার কনফার্ম → অগ্রিম → কেনা ও দাম → ডেলিভারি
    function marketStepperHtml(req) {
      const labels = ['অর্ডার', 'রাইডার কনফার্ম', 'অগ্রিম', 'কেনা ও দাম', 'ডেলিভারি'];
      let now = 1;
      if (req.status === 'completed') now = 5;
      else if (req.status === 'delivered') now = 4;
      else if (req.status === 'confirmed') {
        const st = req.market_stage || 'awaiting_advance';
        now = st === 'quote_confirmed' ? 4 : (st === 'quote_sent' || st === 'advance_verified') ? 3 : 2;
      }
      const cell = (l, i) => {
        const cls = i < now ? 'background:#1F7A4D;color:#fff;' : i === now ? 'background:#FF6B35;color:#fff;' : 'background:#EEF0F4;color:#5B6B86;';
        const txt = i < now ? '✓' : String(toBn(i + 1));
        return `<div style="flex:1;text-align:center;font-size:10.5px;line-height:1.25;font-weight:600;color:${i <= now ? '#1B2A4A' : '#8793A8'};"><span style="display:block;width:26px;height:26px;line-height:26px;margin:0 auto 4px;border-radius:50%;font-size:12px;${cls}">${txt}</span>${l}</div>`;
      };
      return `<div style="display:flex;gap:4px;margin:10px 0;">${labels.map(cell).join('')}</div>`;
    }

    function renderDeliveryCard(req) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.reqId = req.id;

      const offers = req.delivery_offers || [];
      const acceptedRiderProfile = req.accepted_rider?.profiles;
      const acceptedRiderPhone = acceptedRiderProfile?.phone;

      const lowestOffer = offers.length
        ? Math.min(...offers.map((o) => Number(o.offer_price)))
        : null;
      const askingPrice = Number(req.customer_asking_price ?? req.initial_price);

      const pickupText = req.pickup_address || req.area_detail || '';
      const dropText = req.drop_address || '';

      let bodyHtml = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge ${req.category === 'ride' ? 'ride-icon' : 'delivery-icon'}"><i class="fas ${req.category === 'ride' ? 'fa-route' : 'fa-motorcycle'}"></i></span> ${req.category === 'ride' ? 'রাইড রিকোয়েস্ট' : 'হোম ডেলিভারি রিকোয়েস্ট'}</p>
            <p class="order-date">${req.order_no ? `<b style="color:#1B2A4A;letter-spacing:0.3px;">#${esc(req.order_no)}</b> · ` : ''}${formatDate(req.created_at)}</p>
          </div>
        </div>
        ${req.is_market ? marketStepperHtml(req) : renderDeliveryStepper(req)}
        ${orderTimeChip(req)}
        <p class="delivery-desc">${esc(req.description || '')}</p>
        <div class="hu-trip">
          <div class="hu-trip-stop">${esc(pickupText) || '—'}<small>পিকআপ</small></div>
          <div class="hu-trip-stop">${esc(dropText) || '—'}<small>${req.category === 'ride' ? 'গন্তব্য' : 'ডেলিভারি'}</small></div>
        </div>
      `;

      // কুইক ডেলিভারি অর্ডার: অগ্রিম/দাম কনফার্ম/অবস্থা একই পেজে (/market/order)
      if (req.is_market) {
        const MSTAGE = { awaiting_advance: 'অগ্রিম দিন', advance_submitted: 'অগ্রিম যাচাইয়ের অপেক্ষায়', advance_verified: 'অগ্রিম যাচাই হয়েছে', payment_mismatch: 'অগ্রিমের অঙ্ক মেলেনি', quote_sent: 'রাইডারের পাঠানো দাম কনফার্ম করুন', quote_confirmed: 'দাম কনফার্ম হয়েছে' };
        const stageTxt = req.status === 'confirmed' ? (MSTAGE[req.market_stage || 'awaiting_advance'] || '') : '';
        bodyHtml += `<a href="/market/order?id=${encodeURIComponent(req.id)}" data-mk-order="${esc(req.id)}" class="btn-confirm-best-price" style="display:block;text-align:center;text-decoration:none;margin:10px 0;"><i class="fas fa-wallet"></i> কুইক ডেলিভারি: ${stageTxt ? esc(stageTxt) : 'পেমেন্ট ও অবস্থা দেখুন'}</a>`;
      }

      if ((req.status === 'open' || req.status === 'negotiating') && (req.publish_status === 'pending' || req.publish_status === 'hold')) {
        bodyHtml += dealBlockHtml(req);
      }

      if (req.status === 'open' || req.status === 'negotiating') {
        const minutesLeft = formatMinutesLeft(req.expires_at);
        if (minutesLeft) {
          bodyHtml += `<span class="delivery-expiry-note"><i class="fas fa-hourglass-half"></i> ${minutesLeft}, ${req.is_asap === false ? 'রাইডার না পেলে শিডিউল সময়ে অটো বাতিল হবে' : 'তারপর অটো বাতিল হবে'}</span>`;
        }

        bodyHtml += `
          <div class="hu-prices">
            <div class="hu-price ${lowestOffer !== null ? 'best' : 'wait'}">
              <small>সেরা হিরো অফার</small>
              <b>${lowestOffer !== null ? `৳${toBn(lowestOffer)}` : 'অপেক্ষায়...'}</b>
            </div>
            <div class="hu-price">
              <small>আপনার প্রস্তাব</small>
              <b>৳${toBn(askingPrice)}</b>
            </div>
          </div>
        `;

        if (offers.length === 0) {
          bodyHtml += `<p class="no-offers-note">এখনো কোনো হিরো সাড়া দেয়নি, একটু অপেক্ষা করো...</p>`;
        }

        bodyHtml += `
          <div class="increase-price-row">
            <div class="inc-chips">
              <button type="button" data-inc="5">+৫</button>
              <button type="button" data-inc="10">+১০</button>
              <button type="button" data-inc="20">+২০</button>
            </div>
            <div class="inc-input-line">
              <input type="number" placeholder="৳${askingPrice + 1} বা বেশি" min="${askingPrice + 1}" />
              <button type="button" data-action="submit-increase"><i class="fas fa-paper-plane"></i> পাঠান</button>
            </div>
          </div>
          <div class="deal-actions">
            <button type="button" class="btn-increase-price" data-action="show-increase">দাম বাড়ান</button>
            <button type="button" class="btn-confirm-best-price" data-action="confirm-best" ${offers.length === 0 ? 'disabled' : ''}><i class="fas fa-check-circle"></i> নিশ্চিত করুন</button>
          </div>
        `;

        bodyHtml += `<button class="btn-cancel-request" data-request-id="${req.id}"><i class="fas fa-ban"></i> রিকোয়েস্ট বাতিল করুন</button>`;
      } else if (req.status === 'confirmed') {
        // লাইভ স্টেজ তথ্য (হিরো সাইডের mark-pickup-done এর উপর ভিত্তি করে) —
        // শুধু তথ্য দেখানোর জন্য, কোনো বাটন/অ্যাকশন নাই, তাই হিরোর
        // .dh-stage-box থেকে আলাদা .customer-stage-box ক্লাস ব্যবহার হলো
        const isPickupDone = !!req.pickup_done_at;
        const isRide = req.category === 'ride';
        const hideOldStage = !!req.is_market && !req.advance_verified;
        const stageStatusText = isPickupDone
          ? (isRide ? 'হিরো আপনাকে নিয়ে গন্তব্যের পথে' : 'হিরো আপনার ডেলিভারি নিয়ে পথে')
          : 'হিরো পিকআপের পথে আসছে';
        const stageTargetLabel = isPickupDone ? (isRide ? 'গন্তব্য' : 'ডেলিভারি লোকেশন') : 'পিকআপ লোকেশন';
        const stageTargetAddress = isPickupDone ? dropText : pickupText;
        const stageTargetInstruction = isPickupDone ? req.drop_instructions : req.pickup_instructions;
        const pickupTimeText = req.pickup_done_at
          ? new Date(req.pickup_done_at).toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' })
          : null;

        if (!hideOldStage) bodyHtml += `
          <div class="customer-stage-box ${isPickupDone ? 'stage-dropoff' : 'stage-pickup'}">
            <span class="customer-stage-status"><i class="fas fa-circle"></i> ${stageStatusText}</span>
            <span class="customer-stage-label">${stageTargetLabel}</span>
            <p class="customer-stage-address">${esc(stageTargetAddress || '')}</p>
            ${stageTargetInstruction ? `<p class="customer-stage-instruction"><i class="fas fa-circle-info"></i> ${esc(stageTargetInstruction)}</p>` : ''}
            ${pickupTimeText ? `<p class="customer-stage-time"><i class="fas fa-check"></i> পিকআপ হয়েছে: ${pickupTimeText}</p>` : ''}
          </div>
        `;

        bodyHtml += `
          <div class="order-contact-row">
            ${acceptedRiderPhone ? `<a href="tel:${esc(acceptedRiderPhone)}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>` : ''}
            <button type="button" class="order-contact-btn order-chat-btn" data-chat-request-id="${req.id}" data-chat-other-name="${esc(acceptedRiderProfile?.full_name || 'হিরো')}"><i class="fas fa-comment-dots"></i> চ্যাট</button>
          </div>
          <div class="waiting-note">${req.category === 'ride' ? 'যাত্রা শেষে হিরো নিজেই সম্পন্ন মার্ক করবেন, আপনাকে নোটিফিকেশন যাবে' : 'ডেলিভারি শেষে হিরো নিজেই সম্পন্ন মার্ক করবেন, আপনাকে নোটিফিকেশন যাবে'}</div>
          ${isPickupDone ? paymentProofBoxHtml(req.id) : ''}
          <button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>
        `;
      } else if (req.status === 'delivered') {
        bodyHtml += `
          <div class="waiting-note">${req.category === 'ride' ? 'রাইড হিরোর কনফার্মেশনের অপেক্ষায়...' : 'রাইডারের কনফার্মেশনের অপেক্ষায়...'}</div>
          <div class="payment-proof-box" data-request-id="${req.id}">
            <label>
              <i class="fas fa-camera"></i> পেমেন্ট প্রুফ আপলোড করুন
              <input type="file" accept="image/*" multiple data-proof-input />
            </label>
            <div class="proof-thumbs" data-proof-thumbs></div>
          </div>
          <button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>
        `;
      }

      if (req.status === 'completed') {
        if (req.__hasReview) {
          bodyHtml += `<p class="review-submitted-note"><i class="fas fa-star"></i> রিভিউ দেওয়া হয়েছে, ধন্যবাদ!</p>`;
        } else {
          bodyHtml += `
            <div class="review-box" data-request-id="${req.id}">
              <div class="review-stars">
                ${[1, 2, 3, 4, 5].map((n) => `<button data-star="${n}"><i class="fas fa-star"></i></button>`).join('')}
              </div>
              <textarea placeholder="মতামত (ঐচ্ছিক)" data-review-comment></textarea>
              <button class="btn-submit-review">রিভিউ জমা দিন</button>
            </div>
          `;
        }

        // সম্পন্ন হওয়ার ১ ঘন্টার মধ্যে ডিসপিউট রেইজ করার সুযোগ (updated_at
        // কে completed_at এর প্রক্সি হিসেবে ব্যবহার করা হচ্ছে — সার্ভার
        // সাইডেও (raise-dispute.js) একই ১ ঘন্টা লিমিট চেক হয়)
        const completedAt = req.updated_at ? new Date(req.updated_at).getTime() : 0;
        const withinDisputeWindow = Date.now() - completedAt <= 60 * 60 * 1000;
        if (withinDisputeWindow) {
          bodyHtml += paymentProofBoxHtml(req.id);
          bodyHtml += `<button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>`;
        }
      }

      card.innerHTML = bodyHtml;
      attachDeliveryCardEvents(card, req);
      return card;
    }

    function attachDeliveryCardEvents(card, req) {
      // বর্তমান সেরা মূল্যে নিশ্চিত করা
      card.querySelector('[data-action="confirm-best"]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        if (btn.disabled) return;

        // ১) হালনাগাদ সেরা দাম আনা
        btn.disabled = true;
        const freshPrice = await fetchCurrentBestPrice(req);
        btn.disabled = false;

        if (freshPrice === null) {
          alert('এখন কোনো হিরোর অফার নেই। একটু অপেক্ষা করুন।');
          refreshOrders();
          return;
        }

        // ২) ভুল চাপ ঠেকাতে আগে জিজ্ঞেস করা
        const ok = await askConfirm({
          title: `৳${toBn(freshPrice)}-এ নিশ্চিত করবেন?`,
          text: 'নিশ্চিত করলে এই হিরোর সাথে দাম ঠিক হয়ে যাবে এবং আর বদলানো যাবে না।',
          okLabel: `হ্যাঁ, ৳${toBn(freshPrice)}-এ নিশ্চিত করুন`,
        });
        if (!ok) return;

        // ৩) নিশ্চিত করা
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> নিশ্চিত করা হচ্ছে...';
        const { error } = await confirmBestPrice({ requestId: req.id });
        if (error) {
          alert(error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check-circle"></i> নিশ্চিত করুন';
          return;
        }
        refreshOrders();
        if (req.is_market) openMarketOrderSheet(req.id, () => refreshOrders());
      });

      // প্রস্তাবিত মূল্য বাড়ানো (শুধু বাড়ানো যাবে, কমানো যাবে না)
      const increaseRow = card.querySelector('.increase-price-row');
      card.querySelector('[data-action="show-increase"]')?.addEventListener('click', () => {
        increaseRow.classList.toggle('active');
        if (increaseRow.classList.contains('active')) increaseRow.querySelector('input')?.focus();
      });

      increaseRow?.querySelectorAll('[data-inc]').forEach((chip) => {
        chip.addEventListener('click', () => {
          const base = Number(req.customer_asking_price ?? req.initial_price);
          const input = increaseRow.querySelector('input');
          input.value = String(base + Number(chip.dataset.inc));
          input.focus();
        });
      });

      card.querySelector('[data-action="submit-increase"]')?.addEventListener('click', async () => {
        const input = increaseRow.querySelector('input');
        const newPrice = Number(input.value);
        const currentAsking = Number(req.customer_asking_price ?? req.initial_price);
        if (!newPrice || newPrice <= currentAsking) {
          alert(`বর্তমান দামের (৳${currentAsking}) চেয়ে বেশি দিতে হবে`);
          return;
        }
        const { error } = await updateAskingPrice({ requestId: req.id, newPrice });
        if (error) {
          alert(error);
          return;
        }
        refreshOrders();
      });

      // রিকোয়েস্ট বাতিল
      card.querySelector('.btn-cancel-request')?.addEventListener('click', async (e) => {
        const cancelReasonCode = await askCancelReason();
        if (!cancelReasonCode) return;
        e.target.disabled = true;
        const { error } = await cancelRequest({ requestId: req.id, reasonCode: cancelReasonCode });
        if (error) {
          alert(error);
          e.target.disabled = false;
          return;
        }
        refreshOrders();
      });

      // পেমেন্ট প্রুফ আপলোড
      const proofInput = card.querySelector('[data-proof-input]');
      proofInput?.addEventListener('change', async (e) => {
        const rawFiles = Array.from(e.target.files || []);
        if (rawFiles.length === 0) return;

        // পেমেন্ট স্ক্রিনশটে টাকার এমাউন্ট/ট্রানজেকশন আইডি টেক্সট থাকে,
        // তাই বেশি কোয়ালিটি রাখা হলো (quality 0.9) যাতে টেক্সট ঝাপসা
        // না হয়ে যায় (JPEG-এ কনভার্ট হবে, কিন্তু উচ্চ কোয়ালিটিতে
        // টেক্সট স্পষ্ট থাকে)
        const files = await compressImages(rawFiles, { maxDimension: 1800, quality: 0.9 });

        const thumbsEl = card.querySelector('[data-proof-thumbs]');
        const imageUrls = [];

        for (const file of files) {
          const fileName = `${req.id}/${Date.now()}-${file.name}`;
          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('delivery-proofs')
            .upload(fileName, file);

          if (uploadError) {
            window.SFReportError?.({ kind: 'api_fail', action: 'payment_proof_upload', title: 'পেমেন্ট প্রুফ আপলোড ব্যর্থ', message: uploadError.message });
            alert('ছবি আপলোড ব্যর্থ: ' + uploadError.message);
            continue;
          }

          const { data: urlData } = supabase.storage.from('delivery-proofs').getPublicUrl(uploadData.path);
          imageUrls.push(urlData.publicUrl);

          const img = document.createElement('img');
          // delivery-proofs এখন private bucket, public URL-এ প্রিভিউ চলে না — লোকাল ফাইল থেকে দেখানো হচ্ছে
          img.src = URL.createObjectURL(file);
          img.onload = () => URL.revokeObjectURL(img.src);
          thumbsEl.appendChild(img);
        }

        if (imageUrls.length > 0) {
          const { error } = await uploadPaymentProof({ requestId: req.id, imageUrls });
          if (error) alert('সেভ ব্যর্থ: ' + error);
        }
      });

      // ডিসপিউট
      card.querySelector('.dispute-link')?.addEventListener('click', () => {
        window.openDisputeModal({ requestId: req.id, onSuccess: refreshOrders });
      });

      // অ্যাডমিন ডিল চ্যাট
      card.querySelector('.order-deal-chat-btn')?.addEventListener('click', (e) => {
        window.openChatModal({
          requestId: e.currentTarget.dataset.chatRequestId,
          otherPartyName: 'অ্যাডমিন',
          channel: 'admin',
          deal: 'customer',
        });
      });

      ['deal-accept', 'deal-decline'].forEach((act) => {
        card.querySelector(`[data-action="${act}"]`)?.addEventListener('click', async (e) => {
          const accept = act === 'deal-accept';
          const btn = e.currentTarget;
          if (btn.disabled) return;
          const ok = await askConfirm({
            title: accept ? 'প্রস্তাবে রাজি?' : 'প্রস্তাব নাকচ করবেন?',
            text: accept
              ? 'রাজি হলে অ্যাডমিন একজন রাইডার ঠিক করে দেবেন।'
              : 'নাকচ করলে অর্ডারটি কিছুক্ষণ পর সাধারণ মার্কেটে যাবে, রাইডাররা অফার দিতে পারবে।',
            okLabel: accept ? 'হ্যাঁ, রাজি' : 'হ্যাঁ, নাকচ',
          });
          if (!ok) return;
          btn.disabled = true;
          const { data, error } = await supabase.rpc('customer_respond_admin_offer', {
            p_request_id: req.id,
            p_accept: accept,
          });
          if (error || !data?.ok) {
            alert('এখন সাড়া দেওয়া যায়নি, পেজ রিফ্রেশ হচ্ছে');
          }
          refreshOrders();
        });
      });

      // চ্যাট
      card.querySelector('.order-chat-btn')?.addEventListener('click', (e) => {
        const btn = e.currentTarget;
        window.openChatModal({
          requestId: btn.dataset.chatRequestId,
          otherPartyName: btn.dataset.chatOtherName,
        });
      });

      // রিভিউ
      const reviewBox = card.querySelector('.review-box');
      if (reviewBox) {
        let selectedRating = 0;
        const starButtons = reviewBox.querySelectorAll('[data-star]');
        starButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            selectedRating = Number(btn.dataset.star);
            starButtons.forEach((b) => b.classList.toggle('active', Number(b.dataset.star) <= selectedRating));
          });
        });

        reviewBox.querySelector('.btn-submit-review')?.addEventListener('click', async (e) => {
          if (selectedRating === 0) {
            alert('রেটিং সিলেক্ট করো');
            return;
          }
          e.target.disabled = true;
          const comment = reviewBox.querySelector('[data-review-comment]').value.trim();
          const { error } = await submitReview({ requestId: req.id, rating: selectedRating, comment });
          if (error) {
            alert(error);
            e.target.disabled = false;
            return;
          }
          refreshOrders();
        });
      }
    }

    // ============ লোকাল রাইড কার্ড ============
    const LR_ERR = {
      REQUEST_NOT_AVAILABLE: 'এই রিকোয়েস্ট আর চালু নেই',
      OFFER_NOT_ACTIVE: 'এই অফারটা আর নেই',
      OFFER_NOT_FOUND: 'অফার পাওয়া যায়নি',
      DRIVER_NOT_AVAILABLE: 'ড্রাইভার এখন পাওয়া যাচ্ছে না',
      CANNOT_CANCEL: 'এই রিকোয়েস্ট আর বাতিল করা যাবে না',
      FORBIDDEN: 'এই কাজের অনুমতি নেই',
      AUTH_REQUIRED: 'আবার লগইন করুন',
      NOT_REPORTABLE: 'এই রাইডের রিপোর্ট এখন করা যাবে না',
      REPORT_WINDOW_CLOSED: 'রিপোর্টের সময় (২৪ ঘণ্টা) পার হয়ে গেছে',
      ALREADY_REPORTED: 'এই রাইডের রিপোর্ট আগেই জমা আছে',
      DAILY_LIMIT: 'আজকের জন্য রিপোর্টের সীমা শেষ, কাল আবার চেষ্টা করুন',
      REASON_INVALID: 'কারণ ঠিক নেই, আবার বেছে নিন',
    };
    function lrErrText(error) {
      const m = String((error && error.message) || '');
      const k = Object.keys(LR_ERR).find((key) => m.includes(key));
      return k ? LR_ERR[k] : 'কাজটা করা যায়নি, আবার চেষ্টা করুন';
    }
    function lrToast(msg, type) {
      if (typeof window.showToast === 'function') window.showToast(msg, type || 'error');
    }
    function lrEl(tag, cls, text) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }
    function lrIcon(cls) { const i = document.createElement('i'); i.className = cls; return i; }
    function lrSafeUrl(u) { return /^https:[/][/]/.test(u || '') ? String(u).replace(/["'<>\s]/g, '') : null; }
    function lrSafePhone(p) { return String(p || '').replace(/[^0-9+]/g, ''); }
    function lrLeft(expiresAt) {
      const ms = new Date(expiresAt).getTime() - Date.now();
      if (!(ms > 0)) return '';
      return toBn(Math.max(1, Math.ceil(ms / 60000))) + ' মিনিট বাকি';
    }
    function lrAvatar(url) {
      const av = lrEl('span', 'lo-av');
      const u = lrSafeUrl(url);
      if (u) { const im = document.createElement('img'); im.src = u; im.alt = ''; im.loading = 'lazy'; av.appendChild(im); }
      else av.appendChild(lrIcon('fas fa-user'));
      return av;
    }

    let lrBusy = false;
    async function lrAct(btn, fn, okMsg) {
      if (lrBusy) return;
      lrBusy = true;
      btn.disabled = true;
      const { error } = await fn();
      lrBusy = false;
      if (error) {
        btn.disabled = false;
        lrToast(lrErrText(error));
        if (window.SFReportError && !/REQUEST_NOT_AVAILABLE|OFFER_NOT_|DRIVER_NOT_AVAILABLE|CANNOT_CANCEL|FORBIDDEN|AUTH_REQUIRED|NOT_REPORTABLE|REPORT_WINDOW_CLOSED|ALREADY_REPORTED|DAILY_LIMIT|REASON_INVALID/.test(String(error.message || ''))) {
          window.SFReportError({ kind: 'api_fail', action: 'local_ride_customer_action', title: 'লোকাল রাইড যাত্রীর অ্যাকশন ব্যর্থ', message: String(error.message || '') });
        }
        refreshOrders();
        return;
      }
      lrToast(okMsg, 'success');
      refreshOrders();
    }

    // রিপোর্টের কারণ + ঐচ্ছিক নোট (বটম শিট) — { reason, note } ফেরত দেয়, বাদ দিলে null
    function askLocalRideReport() {
      return new Promise((resolve) => {
        const reasons = [
          ['driver_no_show', 'ড্রাইভার আসেনি'],
          ['fare_dispute', 'ভাড়া নিয়ে সমস্যা'],
          ['unsafe_behavior', 'খারাপ আচরণ / নিরাপত্তা'],
          ['wrong_info', 'ভুল তথ্য'],
          ['other', 'অন্য সমস্যা'],
        ];
        let picked = null;
        const wrap = document.createElement('div');
        wrap.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(27,42,74,.55);display:flex;align-items:flex-end;justify-content:center;';
        const sheet = document.createElement('div');
        sheet.style.cssText = 'background:#fff;width:100%;max-width:480px;max-height:90vh;overflow:auto;border-radius:20px 20px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom,0px));box-shadow:0 -6px 24px rgba(0,0,0,.18);';
        const title = lrEl('div', null, 'কী সমস্যা হয়েছে?');
        title.style.cssText = 'font-size:16px;font-weight:700;color:#1B2A4A;margin-bottom:10px;';
        sheet.appendChild(title);
        const done = (val) => { wrap.remove(); resolve(val); };
        const submit = lrEl('button', null, 'রিপোর্ট পাঠান');
        submit.type = 'button';
        submit.disabled = true;
        submit.style.cssText = 'display:block;width:100%;padding:13px 14px;margin-top:10px;border:none;border-radius:12px;background:#FF6B35;color:#fff;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer;opacity:.6;';
        const btns = [];
        reasons.forEach(([code, label]) => {
          const b = lrEl('button', null, label);
          b.type = 'button';
          b.style.cssText = 'display:block;width:100%;text-align:left;padding:13px 14px;margin-bottom:8px;border:1.5px solid #e2e8f0;border-radius:12px;background:#fff;color:#1B2A4A;font-size:15px;font-family:inherit;cursor:pointer;';
          b.addEventListener('click', () => {
            picked = code;
            btns.forEach((x) => { x.style.borderColor = x === b ? '#FF6B35' : '#e2e8f0'; x.style.background = x === b ? '#FFF6F1' : '#fff'; });
            submit.disabled = false;
            submit.style.opacity = '1';
          });
          btns.push(b);
          sheet.appendChild(b);
        });
        const note = document.createElement('textarea');
        note.maxLength = 500;
        note.rows = 3;
        note.placeholder = 'কী হয়েছে সংক্ষেপে লিখুন (ঐচ্ছিক)';
        note.style.cssText = 'width:100%;box-sizing:border-box;border:1.5px solid #D5DCE8;border-radius:12px;padding:10px 12px;font-size:14.5px;font-family:inherit;color:#1B2A4A;resize:vertical;';
        sheet.appendChild(note);
        submit.addEventListener('click', () => { if (picked) done({ reason: picked, note: note.value.trim() }); });
        sheet.appendChild(submit);
        const cancel = lrEl('button', null, 'না, বাদ দিন');
        cancel.type = 'button';
        cancel.style.cssText = 'display:block;width:100%;padding:12px 14px;margin-top:4px;border:none;background:transparent;color:#6C7A93;font-size:14.5px;font-weight:700;font-family:inherit;cursor:pointer;';
        cancel.addEventListener('click', () => done(null));
        sheet.appendChild(cancel);
        wrap.appendChild(sheet);
        wrap.addEventListener('click', (ev) => { if (ev.target === wrap) done(null); });
        document.body.appendChild(wrap);
      });
    }

    function renderLocalRideCard(r) {
      const card = document.createElement('div');
      card.className = 'order-card';
      card.dataset.lrId = r.id;
      const st = r.status;

      const head = lrEl('div', 'lo-head');
      const ttl = lrEl('span', 'lo-title');
      ttl.appendChild(lrIcon('fas fa-van-shuttle'));
      ttl.appendChild(document.createTextNode('লোকাল রাইড'));
      head.appendChild(ttl);
      const label = st === 'open' ? 'ড্রাইভারের অপেক্ষায়' : st === 'confirmed' ? 'কনফার্ম' : st === 'completed' ? 'সম্পন্ন' : st === 'cancelled' ? 'বাতিল' : 'মেয়াদ শেষ';
      head.appendChild(lrEl('span', 'lo-chip' + (st === 'confirmed' ? ' ok' : st === 'completed' ? ' done' : st === 'open' ? '' : ' off'), label));
      card.appendChild(head);

      const dateLine = lrEl('p', 'order-date');
      if (r.request_no) {
        const b = lrEl('b', null, '#' + r.request_no);
        b.style.cssText = 'color:#1B2A4A;letter-spacing:0.3px;';
        dateLine.appendChild(b);
        dateLine.appendChild(document.createTextNode(' · '));
      }
      dateLine.appendChild(document.createTextNode(formatDate(r.created_at)));
      card.appendChild(dateLine);

      const trip = lrEl('div', 'hu-trip');
      const p = lrEl('div', 'hu-trip-stop');
      p.appendChild(document.createTextNode(r.pickup_text || r.pickup_area || '—'));
      p.appendChild(lrEl('small', null, 'পিকআপ' + (r.pickup_area ? ' · ' + r.pickup_area : '')));
      trip.appendChild(p);
      const d = lrEl('div', 'hu-trip-stop');
      d.appendChild(document.createTextNode(r.drop_text || r.drop_area || 'ম্যাপে দেওয়া গন্তব্য'));
      d.appendChild(lrEl('small', null, 'গন্তব্য' + (r.drop_area ? ' · ' + r.drop_area : '')));
      trip.appendChild(d);
      card.appendChild(trip);

      const meta = lrEl('div', 'lo-meta');
      (r.vehicle_types || []).forEach((v) => meta.appendChild(lrEl('span', 'lo-tag', v)));
      meta.appendChild(lrEl('span', 'lo-tag', toBn(r.passengers) + ' জন'));
      card.appendChild(meta);

      const fareRow = lrEl('div');
      const price = (st === 'confirmed' || st === 'completed') && r.final_price != null ? r.final_price : r.fare;
      fareRow.appendChild(lrEl('span', 'lo-fare', '৳' + toBn(Math.round(Number(price)))));
      if (st === 'open') { const lt = lrLeft(r.expires_at); if (lt) fareRow.appendChild(lrEl('span', 'lo-left', lt)); }
      card.appendChild(fareRow);

      if (r.note) card.appendChild(lrEl('p', 'lo-note', r.note));

      if (st === 'open') {
        const offers = r.offers || [];
        if (offers.length) {
          card.appendChild(lrEl('p', 'lo-sec', 'ড্রাইভারের অফার (' + toBn(offers.length) + ')'));
          offers.forEach((o) => {
            const row = lrEl('div', 'lo-offer');
            row.appendChild(lrAvatar(o.driver_photo));
            const who = lrEl('div', 'lo-who');
            who.appendChild(lrEl('b', null, o.driver_name || 'ড্রাইভার'));
            who.appendChild(lrEl('small', null, [o.vehicle_type, o.vehicle_number].filter(Boolean).join(' · ')));
            row.appendChild(who);
            row.appendChild(lrEl('span', 'lo-price', '৳' + toBn(Math.round(Number(o.price)))));
            const b = lrEl('button', 'lo-btn ok', 'গ্রহণ');
            b.type = 'button';
            b.addEventListener('click', async () => {
              const ok = await askConfirm({
                title: '৳' + toBn(Math.round(Number(o.price))) + '-এ কনফার্ম করবেন?',
                text: 'কনফার্ম করলে এই ড্রাইভারের সাথে ট্রিপ ঠিক হয়ে যাবে।',
                okLabel: 'হ্যাঁ, কনফার্ম করুন',
              });
              if (!ok) return;
              lrAct(b, () => supabase.rpc('local_ride_customer_accept_offer', { p_offer_id: o.id }), 'ট্রিপ কনফার্ম হয়েছে ✓');
            });
            row.appendChild(b);
            card.appendChild(row);
          });
        } else {
          card.appendChild(lrEl('p', 'lo-wait', 'এলাকার ড্রাইভাররা রিকোয়েস্ট দেখছে। কেউ রাজি হলে এখানেই জানা যাবে।'));
        }
        const actions = lrEl('div', 'lo-actions');
        const c = lrEl('button', 'lo-btn danger', 'রিকোয়েস্ট বাতিল');
        c.type = 'button';
        c.addEventListener('click', async () => {
          const ok = await askConfirm({
            title: 'রিকোয়েস্ট বাতিল করবেন?',
            text: 'বাতিল করলে ড্রাইভাররা আর এই রিকোয়েস্ট দেখবে না।',
            okLabel: 'হ্যাঁ, বাতিল করুন',
          });
          if (!ok) return;
          lrAct(c, () => supabase.rpc('local_ride_cancel', { p_request_id: r.id }), 'রিকোয়েস্ট বাতিল করা হয়েছে');
        });
        actions.appendChild(c);
        card.appendChild(actions);
      }

      if ((st === 'confirmed' || st === 'completed') && r.driver) {
        const dr = lrEl('div', 'lo-driver');
        dr.appendChild(lrAvatar(r.driver.photo));
        const who = lrEl('div', 'lo-who');
        who.appendChild(lrEl('b', null, r.driver.name || 'ড্রাইভার'));
        who.appendChild(lrEl('small', null, [r.driver.vehicle_type, r.driver.vehicle_number].filter(Boolean).join(' · ')));
        dr.appendChild(who);
        card.appendChild(dr);
        const ph = lrSafePhone(r.driver.phone);
        if (ph && st === 'confirmed') {
          const call = lrEl('a', 'lo-btn pri', '');
          call.href = 'tel:' + ph;
          call.appendChild(lrIcon('fas fa-phone'));
          call.appendChild(document.createTextNode(' কল করুন ' + (r.driver.phone || '')));
          const row = lrEl('div', 'lo-actions');
          row.appendChild(call);
          card.appendChild(row);
        }
      }

      // রিপোর্ট: কনফার্ম থাকলে, বা সম্পন্ন হওয়ার ২৪ ঘণ্টার মধ্যে
      const completedMs = r.completed_at ? new Date(r.completed_at).getTime() : 0;
      const canReport = st === 'confirmed' || (st === 'completed' && Date.now() - completedMs <= 24 * 60 * 60 * 1000);
      if (canReport) {
        if (r.has_open_report) {
          card.appendChild(lrEl('p', 'lo-reported', 'আপনার রিপোর্ট জমা আছে, অ্যাডমিন দেখছেন।'));
        } else {
          const rb = lrEl('button', 'dispute-link', 'সমস্যা হয়েছে? রিপোর্ট করুন');
          rb.type = 'button';
          rb.addEventListener('click', async () => {
            const res = await askLocalRideReport();
            if (!res) return;
            lrAct(rb, () => supabase.rpc('local_ride_report_create', { p_request_id: r.id, p_reason: res.reason, p_note: res.note || null }), 'রিপোর্ট জমা হয়েছে, অ্যাডমিন দেখবেন');
          });
          card.appendChild(rb);
        }
      }
      return card;
    }

    // ============ ধরন ফিল্টার ============
    const TYPE_ORDER = ['shop_order', 'delivery', 'local_ride', 'serial', 'manual_order'];
    const TYPE_LABELS = {
      all: 'সব ধরন',
      shop_order: 'অনলাইন শপ',
      delivery: 'ডেলিভারি',
      local_ride: 'লোকাল রাইড',
      serial: 'ডাক্তার সিরিয়াল',
      manual_order: 'অফলাইন অর্ডার',
    };
    // পুরনো Ride Hero রিকোয়েস্ট (category='ride') "লোকাল রাইড" ধরনের সাথে একসাথে দেখায়
    function typeKey(item) {
      if (item.__type === 'delivery' && item.category === 'ride') return 'local_ride';
      return item.__type;
    }
    let lastFilterSig = '';
    function renderTypeFilter(tabItems) {
      const counts = {};
      tabItems.forEach((it) => { const k = typeKey(it); counts[k] = (counts[k] || 0) + 1; });
      const sig = activeType + '|' + tabItems.length + '|' + TYPE_ORDER.map((k) => counts[k] || 0).join(',');
      if (sig === lastFilterSig) return;
      lastFilterSig = sig;
      typeFilter.textContent = '';
      const all = document.createElement('option');
      all.value = 'all';
      all.textContent = TYPE_LABELS.all + ' (' + toBn(tabItems.length) + ')';
      typeFilter.appendChild(all);
      TYPE_ORDER.forEach((k) => {
        const o = document.createElement('option');
        o.value = k;
        o.textContent = TYPE_LABELS[k] + ' (' + toBn(counts[k] || 0) + ')';
        typeFilter.appendChild(o);
      });
      typeFilter.value = activeType;
    }
    typeFilter.addEventListener('change', () => {
      activeType = typeFilter.value || 'all';
      try { sessionStorage.setItem('mo_type', activeType); } catch (_) { /* ঠিক আছে */ }
      lastFilterSig = '';
      if (lastData) paint();
    });

    // ============ মার্জ ও রেন্ডার ============
    function isOngoingItem(item) {
      if (item.__type === 'local_ride') return item.status === 'open' || item.status === 'confirmed';
      if (item.__type === 'manual_order') return ['new', 'rider_assigned', 'picked_up'].includes(item.status);
      if (item.__type === 'shop_order') return item.status === 'pending' || item.status === 'confirmed';
      if (item.__type === 'serial') {
        if (item.status === 'pending' || item.status === 'processing') return true;
        // কনফার্ম হওয়া সিরিয়াল ডাক্তারের দিন পার না হওয়া পর্যন্ত "চলমান"-এ থাকে
        if (item.status === 'confirmed') return String(item.requested_date) >= todayDhaka();
        return false;
      }
      return ['open', 'negotiating', 'confirmed', 'delivered', 'disputed'].includes(item.status);
    }

    function syncTabButtons() {
      ordersTabs.querySelectorAll('.mo-tab').forEach((b) => {
        b.classList.toggle('active', b.dataset.tab === activeTab);
      });
    }

    // ?req=<id> / ?order=<id> / ?serial=<id> থেকে আসা কার্ডে স্ক্রল ও হাইলাইট (শুধু প্রথমবার)
    function findDeepLinkTarget(combined) {
      const reqId = deepLinkParams.get('req');
      const orderId = deepLinkParams.get('order');
      const serialId = deepLinkParams.get('serial');
      const lrId = deepLinkParams.get('lr');
      if (lrId) return combined.find((i) => i.__type === 'local_ride' && i.id === lrId) || null;
      if (reqId) return combined.find((i) => i.__type === 'delivery' && i.id === reqId) || null;
      if (orderId) return combined.find((i) => i.__type === 'shop_order' && i.id === orderId) || null;
      if (serialId) return combined.find((i) => i.__type === 'serial' && i.id === serialId) || null;
      return null;
    }

    function scrollToDeepLinkCard(target) {
      const selector = target.__type === 'local_ride'
        ? `[data-lr-id="${target.id}"]`
        : target.__type === 'delivery'
        ? `[data-req-id="${target.id}"]`
        : target.__type === 'serial'
          ? `[data-serial-id="${target.id}"]`
          : `[data-order-id="${target.id}"]`;
      const card = ordersContainer.querySelector(selector);
      if (!card) return;
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.add('order-card-highlight');
      setTimeout(() => card.classList.remove('order-card-highlight'), 2600);
    }

    function paint() {
      const { shopOrders, deliveryRequests, serialRequests, reviewedRequestIds } = lastData;
      ordersContainer.innerHTML = '';

      const combined = [
        ...shopOrders.map((o) => ({ ...o, __type: 'shop_order' })),
        ...deliveryRequests.map((d) => ({ ...d, __type: 'delivery', __hasReview: reviewedRequestIds.has(d.id) })),
        ...serialRequests.map((s) => ({ ...s, __type: 'serial' })),
        ...(lastData.manualOrders || []).map((m) => ({ ...m, __type: 'manual_order' })),
        ...(lastData.localRides || []).map((l) => ({ ...l, __type: 'local_ride' })),
      ].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

      if (combined.length === 0) {
        ordersTabs.style.display = 'none';
        ordersFilter.style.display = 'none';
        emptyOrders.style.display = 'block';
        return;
      }
      emptyOrders.style.display = 'none';
      ordersTabs.style.display = 'flex';
      ordersFilter.style.display = 'flex';

      let deepTarget = null;
      if (!deepLinkHandled) {
        deepLinkHandled = true;
        deepTarget = findDeepLinkTarget(combined);
        if (deepTarget) {
          activeTab = isOngoingItem(deepTarget) ? 'ongoing' : 'done';
          activeType = 'all';
          lastFilterSig = '';
        }
      }

      const ongoingCount = combined.filter(isOngoingItem).length;
      tabCountOngoing.textContent = ongoingCount > 0 ? toBn(ongoingCount) : '';
      syncTabButtons();

      const tabItems = combined.filter((item) => (activeTab === 'ongoing') === isOngoingItem(item));
      renderTypeFilter(tabItems);
      const visible = activeType === 'all' ? tabItems : tabItems.filter((item) => typeKey(item) === activeType);

      if (visible.length === 0) {
        const msg = activeType !== 'all'
          ? 'এই ধরনের কোনো ' + (activeTab === 'ongoing' ? 'চলমান' : 'সম্পন্ন') + ' অর্ডার নেই'
          : (activeTab === 'ongoing' ? 'এখন কোনো চলমান অর্ডার বা সিরিয়াল নেই' : 'এখনো কোনো সম্পন্ন অর্ডার বা সিরিয়াল নেই');
        ordersContainer.innerHTML = `<p class="tab-empty">${msg}</p>`;
        return;
      }

      visible.forEach((item) => {
        let card;
        if (item.__type === 'shop_order') card = renderShopOrderCard(item);
        else if (item.__type === 'manual_order') card = renderManualOrderCard(item);
        else if (item.__type === 'local_ride') card = renderLocalRideCard(item);
        else if (item.__type === 'serial') card = renderSerialCard(item);
        else card = renderDeliveryCard(item);
        ordersContainer.appendChild(card);
      });

      if (deepTarget) setTimeout(() => scrollToDeepLinkCard(deepTarget), 80);
    }

    function renderAll(shopOrders, deliveryRequests, serialRequests, reviewedRequestIds, manualOrders = [], localRides = []) {
      lastData = { shopOrders, deliveryRequests, serialRequests, reviewedRequestIds, manualOrders, localRides };
      paint();
    }

    ordersTabs.addEventListener('click', (e) => {
      const btn = e.target.closest('.mo-tab');
      if (!btn || !lastData) return;
      activeTab = btn.dataset.tab;
      paint();
    });

    async function loadOrders(userId, { silent = false } = {}) {
      const [ordersRes, deliveryRes, reviewsRes, serialRes] = await Promise.all([
        supabase
          .from('orders')
          .select('*, order_items(*), shops(name, slug, phone)')
          .eq('user_id', userId)
          .order('created_at', { ascending: false }),
        supabase
          .from('delivery_requests')
          .select(`
            *,
            delivery_offers(id, offer_price, status),
            accepted_rider:delivery_riders!delivery_requests_accepted_rider_id_fkey(profile_id, vehicle_type, profiles!delivery_riders_profile_id_fkey(full_name, phone))
          `)
          .eq('customer_profile_id', userId)
          .order('created_at', { ascending: false }),
        supabase.from('delivery_reviews').select('request_id').eq('customer_profile_id', userId),
        supabase
          .from('serial_requests')
          .select('id, doctor_name, clinic_name, requested_date, status, serial_no, rep_note, patient_name, created_at')
          .eq('requester_id', userId)
          .order('created_at', { ascending: false })
          .limit(60),
      ]);

      if (!silent) {
        loadingState.style.display = 'none';
        ordersContent.style.display = 'block';
      }

      if (ordersRes.error || deliveryRes.error) {
        if (!silent) {
          console.error('অর্ডার লোড এরর:', ordersRes.error?.message, deliveryRes.error?.message);
          ordersContainer.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${esc(ordersRes.error?.message || deliveryRes.error?.message || '')}</p>`;
        }
        return;
      }

      // সিরিয়াল লোডে সমস্যা হলে বাকি অর্ডার দেখানো আটকাবে না
      if (serialRes.error) console.error('সিরিয়াল লোড এরর:', serialRes.error.message);
      const serialRequests = serialRes.error ? [] : (serialRes.data || []);

      // ম্যানুয়াল (অফলাইন) অর্ডার: কাস্টমার ফোন রেজিস্টার্ড ইউজারের সাথে মিললে এখানে ট্র্যাক হয়
      let manualOrders = [];
      try {
        const mo = await supabase.rpc('my_manual_orders');
        if (!mo.error && Array.isArray(mo.data)) manualOrders = mo.data;
      } catch (_) { /* ম্যানুয়াল অর্ডার লোড না হলেও বাকি অর্ডার দেখাবে */ }

      // লোকাল রাইড রিকোয়েস্ট (অফার, ড্রাইভার, রিপোর্ট অবস্থাসহ)
      let localRides = [];
      try {
        const lr = await supabase.rpc('local_ride_my_requests');
        if (!lr.error && Array.isArray(lr.data)) localRides = lr.data;
      } catch (_) { /* লোকাল রাইড লোড না হলেও বাকি অর্ডার দেখাবে */ }

      const reviewedRequestIds = new Set((reviewsRes.data || []).map((r) => r.request_id));

      const deliveryRequests = (deliveryRes.data || []).map((req) => ({
        ...req,
        delivery_offers: (req.delivery_offers || []).filter((o) => o.status === 'active'),
      }));

      // ইউজার কিছু টাইপ করছে বা কনফার্ম শিট খোলা থাকলে অটো-রিফ্রেশে কার্ড নতুন করে আঁকব না
      if (silent && isUserInteracting()) return;

      renderAll(ordersRes.data || [], deliveryRequests, serialRequests, reviewedRequestIds, manualOrders, localRides);
    }

    function refreshOrders() {
      if (currentUserId) loadOrders(currentUserId);
    }

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;

      await expireRequests();
      await loadOrders(currentUserId);

      // নোটিফিকেশন ডিপলিংক: /my-orders?req=<id> → অ্যাডমিন ডিল চ্যাট খুলে দেয়
      try {
        const reqParam = new URLSearchParams(location.search).get('req');
        if (reqParam) {
          const dealBtn = document.querySelector(`.order-deal-chat-btn[data-chat-request-id="${CSS.escape(reqParam)}"]`);
          if (dealBtn) {
            dealBtn.scrollIntoView({ block: 'center' });
            dealBtn.click();
          }
        }
      } catch (_) { /* ডিপলিংক ব্যর্থ হলে চুপচাপ ইগনোর */ }

      refreshTimer = setInterval(() => {
        loadOrders(currentUserId, { silent: true });
      }, 15000);
    }

    window.addEventListener('beforeunload', () => {
      if (refreshTimer) clearInterval(refreshTimer);
    });

    init();
  </script>
</BaseLayout>