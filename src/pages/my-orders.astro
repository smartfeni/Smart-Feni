---
// ============================================================
// পেজ: /my-orders — কাস্টমারের নিজের অর্ডার ও সিরিয়াল রিকোয়েস্ট
// হিস্ট্রি ও স্ট্যাটাস ট্র্যাকিং
//
// বার্গেনিং মডেল: "সেরা মূল্য" (anonymous reverse-auction) —
// কাস্টমার শুধু বর্তমান সেরা মূল্য দেখে (সব active হিরো অফারের
// সর্বনিম্ন বনাম নিজের asking price, যেটা কম), হিরোদের পরিচয়
// গোপন থাকে। "নিশ্চিত করুন" চাপলে confirm-best-price.js এন্ডপয়েন্ট
// (confirm_customer_deal RPC) কল হয় — এটা হিরোর নিজস্ব
// accept-best-price.js এন্ডপয়েন্ট থেকে আলাদা।
//
// আপডেট (নতুন UI — প্রথম ধাপ):
// - "দাম বাড়ান" ও "নিশ্চিত করুন" এখন পাশাপাশি দুটো বড় (৫৪px) বাটন;
//   বাড়ানোর জন্য +৫/+১০/+২০ দ্রুত বাটন
// - "নিশ্চিত করুন" চাপলে সরাসরি কনফার্ম হয় না — আগে বটম শিটে হালনাগাদ সেরা
//   দাম দেখিয়ে জিজ্ঞেস করে ("৳X-এ নিশ্চিত করবেন? পরে বদলানো যাবে না"),
//   ভুল চাপে ডিল ঠিক হয়ে যাওয়া আটকাতে। দাম ডাটাবেস থেকে নতুন করে আনা হয়
//   (১৫ সেকেন্ডের পুরোনো রেন্ডারের দাম নয়)
// - "চলমান / সম্পন্ন" দুটো ট্যাব
// - ?req=<delivery_request_id> বা ?order=<shop_order_id> দিয়ে এলে (ফ্লোটিং
//   অ্যাক্টিভিটি বার থেকে) সংশ্লিষ্ট কার্ডের ট্যাব খুলে স্ক্রল ও হাইলাইট
// - ১৫ সেকেন্ডের অটো-রিফ্রেশ এখন বন্ধ থাকে যখন ইউজার কিছু টাইপ করছে বা
//   কনফার্ম শিট খোলা (আগে রিফ্রেশে টাইপ করা দাম মুছে যেত)
//
// আপডেট (নতুন ফ্লো): কাস্টমারের শেষ "রিসিভড / যাত্রা সম্পন্ন" বাটন বাদ।
// অর্ডারের পর একসেপ্ট, পিকআপ ও সম্পন্ন — সব হিরো করে; কাস্টমার শুধু সমস্যা
// হলে "রিপোর্ট করুন" চাপে (সম্পন্ন হওয়ার ১ ঘণ্টা পর্যন্ত)। পেমেন্ট প্রুফ
// আপলোডের বক্স এখন পিকআপের পর (confirmed) আর সম্পন্ন হওয়ার ১ ঘণ্টার মধ্যে
// (completed) দেখায়; পুরোনো 'delivered' রিকোয়েস্টে আগের মতোই থাকে।
//
// আপডেট (নতুন UI — কার্ডের চেহারা): রুট (পিকআপ → ড্রপ) ডটেড লাইনে, "সেরা হিরো
// অফার / আপনার প্রস্তাব" দুই বক্স, ৪ ধাপের প্রগ্রেস বার। স্টাইল src/styles/
// hero-ui.css এ (শেয়ার্ড)। লজিক/বাটন/শিট/ট্যাব অপরিবর্তিত।
//
// আপডেট (ডাক্তারের সিরিয়াল রিকোয়েস্ট): শপ অর্ডার ও ডেলিভারির পাশে তৃতীয়
// ধরনের কার্ড হিসেবে serial_requests (RLS: শুধু নিজের) এখানেই দেখায় —
// আলাদা পেজ বা মেনু নেই।
// - ৩ ধাপ: জমা হয়েছে → প্রসেসিং চলছে → কনফার্মড (বড় করে সিরিয়াল নম্বর)
// - অপেক্ষায়/প্রসেসিংয়ে "অনুরোধ বাতিল করুন" (serial_patient_cancel RPC)
// - ফোন ধরেনি / বাতিল / মেয়াদ শেষ হলে ধূসর-লাল নোটসহ "সম্পন্ন" ট্যাবে
// - কনফার্ম হওয়া সিরিয়াল ডাক্তারের দিন (ঢাকার তারিখ) পার না হওয়া পর্যন্ত "চলমান"
//   ট্যাবে থাকে, যাতে রোগী খুলেই সিরিয়াল নম্বর দেখতে পান
// - ?serial=<id> দিয়ে এলে (নোটিফিকেশন থেকে) সংশ্লিষ্ট কার্ডে স্ক্রল ও হাইলাইট
// - পেজের শিরোনাম: "আমার অর্ডার ও সিরিয়াল"
//
// আপডেট (শপ অর্ডার ক্যান্সেল): দোকান নিশ্চিত করার আগে (status = pending) কাস্টমার
// "অর্ডার বাতিল করুন" চাপতে পারে (customer_cancel_shop_order RPC); দোকান মালিক
// নোটিফিকেশন পায়। confirmed হয়ে গেলে বাটন থাকে না — দোকানে কল করতে হয়।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import '../styles/hero-ui.css';
import DisputeReasonModal from '../components/delivery/DisputeReasonModal.astro';
import ChatModal from '../components/delivery/ChatModal.astro';
import GuideSheet from '../components/delivery/GuideSheet.astro';

// ⓘ গাইড: কাস্টমার অর্ডার তালিকা (ডেলিভারি UI v2)
const ordersGuide = [
  {
    caption: 'চলমান ও সম্পন্ন ট্যাবে অর্ডার দেখুন',
    blocks: [
      { kind: 'tabs', items: ['চলমান', 'সম্পন্ন'], active: 0, tap: true },
      { kind: 'card', title: 'ডেলিভারি অর্ডার', lines: ['কাচ্চি ঘর → ধলিয়া', '৩টি অফার এসেছে'] },
    ],
  },
  {
    caption: 'অফার আসলে পছন্দের রাইডার বেছে নিন',
    blocks: [
      { kind: 'card', title: 'রাইডারের অফার', lines: ['ডেলিভারি হিরো · ৳৮০'] },
      { kind: 'button', text: 'কনফার্ম করুন', primary: true, tap: true },
    ],
  },
  {
    caption: 'রাইডারের সাথে চ্যাটে কথা বলুন',
    blocks: [
      { kind: 'card', title: 'চলমান অর্ডার', lines: ['রাইডার পথে আছে'] },
      { kind: 'button', text: 'চ্যাট', tap: true },
    ],
  },
];
---

<BaseLayout title="আমার অর্ডার ও সিরিয়াল | স্মার্ট ফেনী">
  <div class="my-orders-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-lock"></i></div>
        <h2>লগইন করুন</h2>
        <p>অর্ডার ও সিরিয়াল দেখতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="ordersContent" style="display:none;">
        <h1 class="page-title">
          <i class="fas fa-receipt"></i> আমার অর্ডার ও সিরিয়াল
          <GuideSheet id="customer-orders" title="অর্ডারের নিয়মাবলি" subtitle="আমার অর্ডার" showButton buttonTone="light" steps={ordersGuide} />
        </h1>

        <DisputeReasonModal />
        <ChatModal />

        <div id="emptyOrders" class="status-box" style="display:none;">
          <div class="status-icon-badge"><i class="fas fa-inbox"></i></div>
          <h2>কোনো অর্ডার নেই</h2>
          <p>এখনো কোনো শপ থেকে অর্ডার, ডেলিভারি রিকোয়েস্ট বা ডাক্তারের সিরিয়াল রিকোয়েস্ট করেননি</p>
          <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
        </div>

        <div id="ordersTabs" class="mo-tabs" style="display:none;">
          <button type="button" class="mo-tab active" data-tab="ongoing">চলমান <span id="tabCountOngoing"></span></button>
          <button type="button" class="mo-tab" data-tab="done">সম্পন্ন</button>
        </div>

        <div id="ordersFilter" class="mo-filter" style="display:none;">
          <label for="typeFilter">ধরন</label>
          <select id="typeFilter" class="mo-filter-select" aria-label="অর্ডারের ধরন অনুযায়ী ফিল্টার"></select>
        </div>

        <div id="ordersContainer" class="orders-list"></div>
      </div>

    </div>
  </div>

  <div class="deal-sheet-overlay" id="dealSheet">
    <div class="deal-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="dealSheetTitle">
      <div class="deal-sheet-grip"></div>
      <h3 id="dealSheetTitle"></h3>
      <p id="dealSheetText"></p>
      <button type="button" class="deal-sheet-ok" id="dealSheetOk"></button>
      <button type="button" class="deal-sheet-cancel" id="dealSheetClose">না, ফিরে যান</button>
    </div>
  </div>

  <style is:global>
    .my-orders-page {
      min-height: 70vh;
      padding: 28px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 50px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-icon-badge {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFF0EA, #FFE3D5);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }

    .status-icon-badge i {
      font-size: 1.7rem;
      color: #FF6B35;
    }

    .status-box h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .primary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 12px 26px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
      transition: all 0.2s ease;
    }

    .primary-link-btn:hover {
      background: #e85a28;
      transform: translateY(-1px);
    }

    .page-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .page-title i {
      color: #FF6B35;
    }

    .page-title .sfg-info-btn {
      margin-left: auto;
      flex: none;
    }

    .orders-list {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .order-card {
      background: #fff;
      border-radius: 20px;
      padding: 16px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
      border: 1px solid #F0F3F8;
    }

    .order-top-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4px;
      padding-bottom: 12px;
      border-bottom: 1px dashed #E5EAF0;
    }

    .order-shop-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .order-shop-name .shop-icon-badge {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      flex-shrink: 0;
    }

    .shop-icon-badge.delivery-icon {
      background: #EAF2FF;
      color: #2563EB;
    }

    .shop-icon-badge.ride-icon {
      background: #E9ECF5;
      color: #1B2A4A;
    }

    .shop-icon-badge.serial-icon {
      background: #E8F6EC;
      color: #1B7A3C;
    }

    .order-date {
      font-size: 0.72rem;
      color: #9AA8BC;
      margin-top: 4px;
      margin-left: 36px;
    }

    .status-stepper {
      display: flex;
      align-items: center;
      gap: 4px;
      margin: 16px 0 6px;
    }

    .step-dot {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #F0F3F8;
      color: #B0BCCB;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .step-dot.done {
      background: #FF6B35;
      color: #fff;
      box-shadow: 0 4px 10px rgba(255, 107, 53, 0.35);
    }

    .step-line {
      flex: 1;
      height: 3px;
      background: #F0F3F8;
      border-radius: 2px;
    }

    .step-line.done {
      background: #FF6B35;
    }

    .step-label-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.68rem;
      color: #9AA8BC;
      font-weight: 600;
      margin-bottom: 14px;
    }

    .cancelled-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      font-size: 0.82rem;
      font-weight: 700;
      color: #D14343;
      background: #FFF0EA;
      padding: 10px;
      border-radius: 12px;
      margin: 14px 0;
    }

    .disputed-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      font-size: 0.82rem;
      font-weight: 700;
      color: #B8860B;
      background: #FFF4E0;
      padding: 10px;
      border-radius: 12px;
      margin: 14px 0;
    }

    .order-items-list {
      background: #F8FAFC;
      border-radius: 14px;
      padding: 10px 14px;
      margin: 4px 0 12px;
    }

    .order-item-line {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      font-size: 0.8rem;
      color: #3A4A60;
      padding: 4px 0;
    }

    .order-item-line > span:last-child {
      flex-shrink: 0;
      white-space: nowrap;
    }

    .customer-stage-box {
      border-radius: 14px;
      padding: 12px 14px;
      margin: 4px 0 12px;
    }

    .customer-stage-box.stage-pickup {
      background: #FFF0EA;
      border: 1.5px solid #FF6B35;
    }

    .customer-stage-box.stage-dropoff {
      background: #E8F6EC;
      border: 1.5px solid #1B7A3C;
    }

    .customer-stage-status {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.76rem;
      font-weight: 700;
      color: #FF6B35;
      margin-bottom: 8px;
    }

    .stage-dropoff .customer-stage-status {
      color: #1B7A3C;
    }

    .customer-stage-status i {
      font-size: 0.5rem;
    }

    .customer-stage-label {
      font-size: 0.7rem;
      font-weight: 700;
      color: #5A6E85;
      display: block;
      margin-bottom: 2px;
    }

    .customer-stage-address {
      font-size: 0.82rem;
      color: #1B2A4A;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .customer-stage-instruction {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      font-size: 0.74rem;
      color: #1B2A4A;
      font-weight: 600;
      line-height: 1.4;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 8px;
      padding: 6px 9px;
      margin-bottom: 6px;
    }

    .customer-stage-instruction i {
      margin-top: 2px;
      flex-shrink: 0;
    }

    .customer-stage-time {
      font-size: 0.72rem;
      color: #1B7A3C;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .order-contact-row {
      display: flex;
      gap: 10px;
    }

    .order-contact-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px;
      border-radius: 12px;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 700;
      transition: all 0.15s ease;
      border: none;
      cursor: pointer;
      font-family: inherit;
    }

    .order-call-btn {
      background: #EAF2FF;
      color: #2563EB;
    }

    .order-call-btn:hover {
      background: #2563EB;
      color: #fff;
    }

    .order-wa-btn {
      background: #E9F9EF;
      color: #1EA952;
    }

    .order-wa-btn:hover {
