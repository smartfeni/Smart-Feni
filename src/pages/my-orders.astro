---
// ============================================================
// পেজ: /my-orders — কাস্টমারের নিজের অর্ডার হিস্ট্রি ও স্ট্যাটাস
// ট্র্যাকিং
//
// আপডেট (এই সেশন):
//   - offer-thread এ এখন last_actor অনুযায়ী UI বদলায় — রাইডার
//     সর্বশেষ অফার/কাউন্টার দিলে "Accept" বাটন দেখাবে + pulsing
//     dot দিয়ে "নতুন" ইঙ্গিত, কাস্টমার নিজে কাউন্টার দিলে Accept
//     বাটন সরে গিয়ে "রাইডারের উত্তরের অপেক্ষায়" দেখাবে (ব্যাকএন্ডে
//     customer-respond.js এ যোগ হওয়া গার্ডের সাথে UI মিলিয়ে)
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="আমার অর্ডার | স্মার্ট ফেনী">
  <div class="my-orders-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-lock"></i></div>
        <h2>লগইন করুন</h2>
        <p>অর্ডার দেখতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="ordersContent" style="display:none;">
        <h1 class="page-title"><i class="fas fa-receipt"></i> আমার অর্ডার</h1>

        <div id="emptyOrders" class="status-box" style="display:none;">
          <div class="status-icon-badge"><i class="fas fa-inbox"></i></div>
          <h2>কোনো অর্ডার নেই</h2>
          <p>এখনো কোনো শপ থেকে অর্ডার বা ডেলিভারি রিকোয়েস্ট করেননি</p>
          <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
        </div>

        <div id="ordersContainer" class="orders-list"></div>
      </div>

    </div>
  </div>

  <style is:global>
    .my-orders-page {
      min-height: 70vh;
      padding: 28px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 50px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-icon-badge {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFF0EA, #FFE3D5);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }

    .status-icon-badge i {
      font-size: 1.7rem;
      color: #FF6B35;
    }

    .status-box h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .primary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 12px 26px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
      transition: all 0.2s ease;
    }

    .primary-link-btn:hover {
      background: #e85a28;
      transform: translateY(-1px);
    }

    .page-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .page-title i {
      color: #FF6B35;
    }

    .orders-list {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .order-card {
      background: #fff;
      border-radius: 20px;
      padding: 16px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
      border: 1px solid #F0F3F8;
    }

    .order-top-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4px;
      padding-bottom: 12px;
      border-bottom: 1px dashed #E5EAF0;
    }

    .order-shop-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .order-shop-name .shop-icon-badge {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      flex-shrink: 0;
    }

    .shop-icon-badge.delivery-icon {
      background: #EAF2FF;
      color: #2563EB;
    }

    .order-date {
      font-size: 0.72rem;
      color: #9AA8BC;
      margin-top: 4px;
      margin-left: 36px;
    }

    .status-stepper {
      display: flex;
      align-items: center;
      gap: 4px;
      margin: 16px 0 6px;
    }

    .step-dot {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #F0F3F8;
      color: #B0BCCB;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .step-dot.done {
      background: #FF6B35;
      color: #fff;
      box-shadow: 0 4px 10px rgba(255, 107, 53, 0.35);
    }

    .step-line {
      flex: 1;
      height: 3px;
      background: #F0F3F8;
      border-radius: 2px;
    }

    .step-line.done {
      background: #FF6B35;
    }

    .step-label-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.68rem;
      color: #9AA8BC;
      font-weight: 600;
      margin-bottom: 14px;
    }

    .cancelled-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      font-size: 0.82rem;
      font-weight: 700;
      color: #D14343;
      background: #FFF0EA;
      padding: 10px;
      border-radius: 12px;
      margin: 14px 0;
    }

    .disputed-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      font-size: 0.82rem;
      font-weight: 700;
      color: #B8860B;
      background: #FFF4E0;
      padding: 10px;
      border-radius: 12px;
      margin: 14px 0;
    }

    .order-items-list {
      background: #F8FAFC;
      border-radius: 14px;
      padding: 10px 14px;
      margin: 4px 0 12px;
    }

    .order-item-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: #3A4A60;
      padding: 4px 0;
    }

    .order-contact-row {
      display: flex;
      gap: 10px;
    }

    .order-contact-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px;
      border-radius: 12px;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 700;
      transition: all 0.15s ease;
      border: none;
      cursor: pointer;
      font-family: inherit;
    }

    .order-call-btn {
      background: #EAF2FF;
      color: #2563EB;
    }

    .order-call-btn:hover {
      background: #2563EB;
      color: #fff;
    }

    .order-wa-btn {
      background: #E9F9EF;
      color: #1EA952;
    }

    .order-wa-btn:hover {
      background: #1EA952;
      color: #fff;
    }

    /* ===== Delivery Hero স্পেসিফিক ===== */

    .delivery-desc {
      font-size: 0.82rem;
      color: #5A6E85;
      margin: 8px 0 12px;
      line-height: 1.5;
    }

    .delivery-area {
      font-size: 0.76rem;
      color: #9AA8BC;
      margin-bottom: 12px;
    }

    .delivery-area i {
      color: #FF6B35;
      margin-right: 4px;
    }

    .delivery-expiry-note {
      font-size: 0.7rem;
      color: #B8860B;
      background: #FFF4E0;
      padding: 6px 10px;
      border-radius: 10px;
      margin-bottom: 10px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .asking-price-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #FFF0EA;
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 12px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #FF6B35;
    }

    .offer-threads {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 10px;
    }

    .offer-thread {
      background: #F8FAFC;
      border: 1px solid #EEF3F9;
      border-radius: 14px;
      padding: 12px;
      position: relative;
    }

    .offer-thread.turn-rider {
      border-color: #FFD3BC;
      background: #FFFAF7;
    }

    .offer-thread-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .offer-rider-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .offer-price-tag {
      font-size: 0.9rem;
      font-weight: 800;
      color: #FF6B35;
    }

    /* ===== "নতুন" পালস ডট — রাইডার সর্বশেষ মুভ দিলে ===== */
    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #FF6B35;
      flex-shrink: 0;
      position: relative;
    }

    .pulse-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #FF6B35;
      animation: pulseDot 1.4s ease-out infinite;
    }

    @keyframes pulseDot {
      0% { transform: scale(1); opacity: 0.7; }
      100% { transform: scale(2.8); opacity: 0; }
    }

    /* ===== "পালা" ইন্ডিকেটর লাইন ===== */
    .turn-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .turn-indicator.turn-rider-text {
      color: #FF6B35;
    }

    .turn-indicator.turn-waiting-text {
      color: #9AA8BC;
    }

    .turn-indicator i {
      font-size: 0.66rem;
    }

    .offer-actions {
      display: flex;
      gap: 8px;
    }

    .offer-actions button {
      flex: 1;
      border: none;
      padding: 9px;
      border-radius: 10px;
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s ease;
    }

    .btn-accept-offer {
      background: #1B7A3C;
      color: #fff;
    }

    .btn-accept-offer:hover {
      background: #156530;
    }

    .btn-counter-offer {
      background: #EAF2FF;
      color: #2563EB;
    }

    .btn-counter-offer:hover {
      background: #2563EB;
      color: #fff;
    }

    .btn-counter-offer.full-width {
      flex: 1;
    }

    .counter-input-row {
      display: none;
      gap: 8px;
      margin-top: 8px;
    }

    .counter-input-row.active {
      display: flex;
    }

    .counter-input-row input {
      flex: 1;
      border: 1px solid #E5EAF0;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 0.82rem;
      font-family: inherit;
      outline: none;
    }

    .counter-input-row button {
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .no-offers-note {
      text-align: center;
      color: #9AA8BC;
      font-size: 0.78rem;
      padding: 12px 0;
    }

    .btn-cancel-request {
      width: 100%;
      background: #FFF0EA;
      color: #D14343;
      border: none;
      padding: 11px;
      border-radius: 12px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-cancel-request:hover {
      background: #D14343;
      color: #fff;
    }

    .btn-received {
      width: 100%;
      background: #1B7A3C;
      color: #fff;
      border: none;
      padding: 12px;
      border-radius: 12px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-received:hover {
      background: #156530;
    }

    .payment-proof-box {
      margin-top: 12px;
      border: 1.5px dashed #E5EAF0;
      border-radius: 12px;
      padding: 12px;
      text-align: center;
    }

    .payment-proof-box label {
      font-size: 0.78rem;
      color: #5A6E85;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .payment-proof-box input[type="file"] {
      display: none;
    }

    .proof-thumbs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 8px;
      justify-content: center;
    }

    .proof-thumbs img {
      width: 44px;
      height: 44px;
      object-fit: cover;
      border-radius: 8px;
    }

    .waiting-note {
      text-align: center;
      font-size: 0.8rem;
      color: #B8860B;
      background: #FFF4E0;
      padding: 10px;
      border-radius: 12px;
      margin-top: 10px;
    }

    .dispute-link {
      display: block;
      text-align: center;
      font-size: 0.74rem;
      color: #D14343;
      margin-top: 8px;
      cursor: pointer;
      text-decoration: underline;
      background: none;
      border: none;
      font-family: inherit;
      width: 100%;
    }

    .review-box {
      margin-top: 12px;
      border-top: 1px dashed #E5EAF0;
      padding-top: 12px;
    }

    .review-stars {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-bottom: 8px;
    }

    .review-stars button {
      background: none;
      border: none;
      font-size: 1.3rem;
      color: #E5EAF0;
      cursor: pointer;
      padding: 2px;
    }

    .review-stars button.active {
      color: #FFB020;
    }

    .review-box textarea {
      width: 100%;
      border: 1px solid #E5EAF0;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 0.8rem;
      font-family: inherit;
      resize: vertical;
      min-height: 50px;
      margin-bottom: 8px;
      outline: none;
    }

    .btn-submit-review {
      width: 100%;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 10px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .review-submitted-note {
      text-align: center;
      font-size: 0.78rem;
      color: #1B7A3C;
      margin-top: 10px;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { compressImages } from '../lib/imageCompress.js';
    import { customerRespond, markReceived, submitReview, uploadPaymentProof, raiseDispute, cancelRequest, expireRequests } from '../lib/deliveryClient.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const ordersContent = document.getElementById('ordersContent');
    const emptyOrders = document.getElementById('emptyOrders');
    const ordersContainer = document.getElementById('ordersContainer');

    const STEPS = ['pending', 'confirmed', 'delivered'];
    const STEP_LABELS = { pending: 'পেন্ডিং', confirmed: 'কনফার্মড', delivered: 'ডেলিভার্ড' };

    const DELIVERY_STEPS = ['open', 'confirmed', 'completed'];
    const DELIVERY_STEP_LABELS = { open: 'রিকোয়েস্ট', confirmed: 'কনফার্মড', completed: 'সম্পন্ন' };

    let currentUserId = null;
    let refreshTimer = null;

    function formatDate(iso) {
      return new Date(iso).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function formatMinutesLeft(expiresAt) {
      if (!expiresAt) return null;
      const diffMs = new Date(expiresAt).getTime() - Date.now();
      if (diffMs <= 0) return null;
      const mins = Math.ceil(diffMs / 60000);
      if (mins >= 60) return `${Math.ceil(mins / 60)} ঘণ্টা বাকি`;
      return `${mins} মিনিট বাকি`;
    }

    // ============ SHOP ORDER স্টেপার (অপরিবর্তিত) ============
    function renderStepper(status) {
      if (status === 'cancelled') {
        return `<div class="cancelled-note"><i class="fas fa-xmark"></i> অর্ডারটি বাতিল হয়েছে</div>`;
      }
      const currentIndex = STEPS.indexOf(status);
      let dotsHtml = '';
      STEPS.forEach((step, i) => {
        const isDone = i <= currentIndex;
        dotsHtml += `<div class="step-dot ${isDone ? 'done' : ''}"><i class="fas fa-check"></i></div>`;
        if (i < STEPS.length - 1) {
          dotsHtml += `<div class="step-line ${i < currentIndex ? 'done' : ''}"></div>`;
        }
      });
      const labelsHtml = STEPS.map((s) => `<span>${STEP_LABELS[s]}</span>`).join('');
      return `<div class="status-stepper">${dotsHtml}</div><div class="step-label-row">${labelsHtml}</div>`;
    }

    // ============ DELIVERY স্টেপার ============
    function renderDeliveryStepper(status) {
      if (status === 'cancelled') {
        return `<div class="cancelled-note"><i class="fas fa-xmark"></i> রিকোয়েস্টটি বাতিল হয়েছে</div>`;
      }
      if (status === 'disputed') {
        return `<div class="disputed-note"><i class="fas fa-triangle-exclamation"></i> এডমিন পর্যালোচনা করছে</div>`;
      }
      let mapped = status;
      if (status === 'delivered') mapped = 'confirmed';
      const currentIndex = DELIVERY_STEPS.indexOf(mapped === 'open' ? 'open' : mapped);
      let dotsHtml = '';
      DELIVERY_STEPS.forEach((step, i) => {
        const isDone = i <= currentIndex;
        dotsHtml += `<div class="step-dot ${isDone ? 'done' : ''}"><i class="fas fa-check"></i></div>`;
        if (i < DELIVERY_STEPS.length - 1) {
          dotsHtml += `<div class="step-line ${i < currentIndex ? 'done' : ''}"></div>`;
        }
      });
      const labelsHtml = DELIVERY_STEPS.map((s) => `<span>${DELIVERY_STEP_LABELS[s]}</span>`).join('');
      return `<div class="status-stepper">${dotsHtml}</div><div class="step-label-row">${labelsHtml}</div>`;
    }

    // ============ SHOP ORDER কার্ড (অপরিবর্তিত) ============
    function renderShopOrderCard(order) {
      const card = document.createElement('div');
      card.className = 'order-card';

      const shop = order.shops;
      const itemsHtml = (order.order_items || [])
        .map((it) => `<div class="order-item-line"><span>${it.title || ''} × ${it.quantity}</span><span>৳${it.price || 0}</span></div>`)
        .join('');

      const contactHtml = shop?.phone
        ? `
          <div class="order-contact-row">
            <a href="tel:${shop.phone}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>
            <a href="https://wa.me/${shop.phone.replace(/\D/g, '')}" target="_blank" rel="noopener" class="order-contact-btn order-wa-btn"><i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ</a>
          </div>
        `
        : '';

      card.innerHTML = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge"><i class="fas fa-store"></i></span> ${shop?.name || 'শপ'}</p>
            <p class="order-date">${formatDate(order.created_at)}</p>
          </div>
        </div>
        ${renderStepper(order.status)}
        <div class="order-items-list">${itemsHtml}</div>
        ${contactHtml}
      `;

      return card;
    }

    // ============ DELIVERY কার্ড ============
    function renderDeliveryCard(req) {
      const card = document.createElement('div');
      card.className = 'order-card';

      const offers = req.delivery_offers || [];
      const acceptedRiderProfile = req.accepted_rider?.profiles;
      const acceptedRiderPhone = acceptedRiderProfile?.phone;

      let bodyHtml = `
        <div class="order-top-row">
          <div>
            <p class="order-shop-name"><span class="shop-icon-badge delivery-icon"><i class="fas fa-motorcycle"></i></span> হোম ডেলিভারি রিকোয়েস্ট</p>
            <p class="order-date">${formatDate(req.created_at)}</p>
          </div>
        </div>
        ${renderDeliveryStepper(req.status)}
        <p class="delivery-desc">${req.description || ''}</p>
        <p class="delivery-area"><i class="fas fa-location-dot"></i> ${req.upazila || ''} — ${req.area_detail || ''}</p>
      `;

      if (req.status === 'open' || req.status === 'negotiating') {
        const minutesLeft = formatMinutesLeft(req.expires_at);
        if (minutesLeft) {
          bodyHtml += `<span class="delivery-expiry-note"><i class="fas fa-hourglass-half"></i> ${minutesLeft}, তারপর অটো বাতিল হবে</span>`;
        }
        bodyHtml += `<div class="asking-price-box"><span>বর্তমান আস্কিং প্রাইস</span><span>৳${req.current_price}</span></div>`;

        if (offers.length === 0) {
          bodyHtml += `<p class="no-offers-note">এখনো কোনো রাইডার সাড়া দেয়নি, একটু অপেক্ষা করো...</p>`;
        } else {
          bodyHtml += `<div class="offer-threads">`;
          offers.forEach((offer) => {
            const riderName = offer.delivery_riders?.profiles?.full_name || 'রাইডার';
            const ridersTurn = offer.last_actor === 'rider';

            const turnIndicatorHtml = ridersTurn
              ? `<div class="turn-indicator turn-rider-text"><span class="pulse-dot"></span> রাইডার নতুন দাম দিয়েছে</div>`
              : `<div class="turn-indicator turn-waiting-text"><i class="fas fa-clock"></i> রাইডারের উত্তরের অপেক্ষায়</div>`;

            const actionsHtml = ridersTurn
              ? `
                <div class="offer-actions">
                  <button class="btn-accept-offer" data-action="accept">গ্রহণ করুন</button>
                  <button class="btn-counter-offer" data-action="show-counter">দাম পরিবর্তন</button>
                </div>
              `
              : `
                <div class="offer-actions">
                  <button class="btn-counter-offer full-width" data-action="show-counter">আবার দাম পরিবর্তন করুন</button>
                </div>
              `;

            bodyHtml += `
              <div class="offer-thread ${ridersTurn ? 'turn-rider' : ''}" data-offer-request="${req.id}" data-offer-rider="${offer.rider_profile_id}">
                <div class="offer-thread-top">
                  <span class="offer-rider-name">
                    <i class="fas fa-user"></i> ${riderName}
                  </span>
                  <span class="offer-price-tag">৳${offer.offer_price}</span>
                </div>
                ${turnIndicatorHtml}
                ${actionsHtml}
                <div class="counter-input-row">
                  <input type="number" placeholder="নতুন দাম" min="1" />
                  <button data-action="submit-counter">পাঠান</button>
                </div>
              </div>
            `;
          });
          bodyHtml += `</div>`;
        }

        bodyHtml += `<button class="btn-cancel-request" data-request-id="${req.id}"><i class="fas fa-ban"></i> রিকোয়েস্ট বাতিল করুন</button>`;
      } else if (req.status === 'confirmed') {
        bodyHtml += `
          <div class="order-contact-row">
            ${acceptedRiderPhone ? `
              <a href="tel:${acceptedRiderPhone}" class="order-contact-btn order-call-btn"><i class="fas fa-phone"></i> কল করুন</a>
              <a href="https://wa.me/${acceptedRiderPhone.replace(/\D/g, '')}" target="_blank" rel="noopener" class="order-contact-btn order-wa-btn"><i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ</a>
            ` : ''}
          </div>
          <button class="btn-received" data-request-id="${req.id}"><i class="fas fa-check-circle"></i> পণ্য রিসিভড</button>
        `;
      } else if (req.status === 'delivered') {
        bodyHtml += `
          <div class="waiting-note">রাইডারের কনফার্মেশনের অপেক্ষায়...</div>
          <div class="payment-proof-box" data-request-id="${req.id}">
            <label>
              <i class="fas fa-camera"></i> পেমেন্ট প্রুফ আপলোড করুন
              <input type="file" accept="image/*" multiple data-proof-input />
            </label>
            <div class="proof-thumbs" data-proof-thumbs></div>
          </div>
          <button class="dispute-link" data-request-id="${req.id}">সমস্যা হয়েছে? রিপোর্ট করুন</button>
        `;
      }

      if (req.status === 'completed') {
        if (req.__hasReview) {
          bodyHtml += `<p class="review-submitted-note"><i class="fas fa-star"></i> রিভিউ দেওয়া হয়েছে, ধন্যবাদ!</p>`;
        } else {
          bodyHtml += `
            <div class="review-box" data-request-id="${req.id}">
              <div class="review-stars">
                ${[1, 2, 3, 4, 5].map((n) => `<button data-star="${n}"><i class="fas fa-star"></i></button>`).join('')}
              </div>
              <textarea placeholder="মতামত (ঐচ্ছিক)" data-review-comment></textarea>
              <button class="btn-submit-review">রিভিউ জমা দিন</button>
            </div>
          `;
        }
      }

      card.innerHTML = bodyHtml;
      attachDeliveryCardEvents(card, req);
      return card;
    }

    function attachDeliveryCardEvents(card, req) {
      // Accept/Counter থ্রেড বাটন
      card.querySelectorAll('.offer-thread').forEach((thread) => {
        const riderProfileId = thread.dataset.offerRider;
        const requestId = thread.dataset.offerRequest;
        const counterRow = thread.querySelector('.counter-input-row');

        thread.querySelector('[data-action="accept"]')?.addEventListener('click', async (e) => {
          e.target.disabled = true;
          const { error } = await customerRespond({ requestId, riderProfileId, action: 'accept' });
          if (error) {
            alert(error);
            e.target.disabled = false;
            return;
          }
          refreshOrders();
        });

        thread.querySelector('[data-action="show-counter"]')?.addEventListener('click', () => {
          counterRow.classList.toggle('active');
        });

        thread.querySelector('[data-action="submit-counter"]')?.addEventListener('click', async () => {
          const input = counterRow.querySelector('input');
          const price = Number(input.value);
          if (!price || price <= 0) {
            alert('সঠিক দাম দাও');
            return;
          }
          const { error } = await customerRespond({ requestId, riderProfileId, action: 'counter', offerPrice: price });
          if (error) {
            alert(error);
            return;
          }
          refreshOrders();
        });
      });

      // রিকোয়েস্ট বাতিল
      card.querySelector('.btn-cancel-request')?.addEventListener('click', async (e) => {
        if (!confirm('রিকোয়েস্টটি বাতিল করতে চাও?')) return;
        e.target.disabled = true;
        const { error } = await cancelRequest({ requestId: req.id });
        if (error) {
          alert(error);
          e.target.disabled = false;
          return;
        }
        refreshOrders();
      });

      // রিসিভড বাটন
      card.querySelector('.btn-received')?.addEventListener('click', async (e) => {
        e.target.disabled = true;
        const { error } = await markReceived({ requestId: req.id });
        if (error) {
          alert(error);
          e.target.disabled = false;
          return;
        }
        refreshOrders();
      });

      // পেমেন্ট প্রুফ আপলোড
      const proofInput = card.querySelector('[data-proof-input]');
      proofInput?.addEventListener('change', async (e) => {
        const rawFiles = Array.from(e.target.files || []);
        if (rawFiles.length === 0) return;

        // পেমেন্ট স্ক্রিনশটে টাকার এমাউন্ট/ট্রানজেকশন আইডি টেক্সট থাকে,
        // তাই বেশি কোয়ালিটি রাখা হলো (quality 0.9) যাতে টেক্সট ঝাপসা
        // না হয়ে যায় (JPEG-এ কনভার্ট হবে, কিন্তু উচ্চ কোয়ালিটিতে
        // টেক্সট স্পষ্ট থাকে)
        const files = await compressImages(rawFiles, { maxDimension: 1800, quality: 0.9 });

        const thumbsEl = card.querySelector('[data-proof-thumbs]');
        const imageUrls = [];

        for (const file of files) {
          const fileName = `${req.id}/${Date.now()}-${file.name}`;
          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('delivery-proofs')
            .upload(fileName, file);

          if (uploadError) {
            alert('ছবি আপলোড ব্যর্থ: ' + uploadError.message);
            continue;
          }

          const { data: urlData } = supabase.storage.from('delivery-proofs').getPublicUrl(uploadData.path);
          imageUrls.push(urlData.publicUrl);

          const img = document.createElement('img');
          img.src = urlData.publicUrl;
          thumbsEl.appendChild(img);
        }

        if (imageUrls.length > 0) {
          const { error } = await uploadPaymentProof({ requestId: req.id, imageUrls });
          if (error) alert('সেভ ব্যর্থ: ' + error);
        }
      });

      // ডিসপিউট
      card.querySelector('.dispute-link')?.addEventListener('click', async () => {
        const reason = prompt('কী সমস্যা হয়েছে বিস্তারিত লিখো:');
        if (!reason) return;
        const { error } = await raiseDispute({ requestId: req.id, reason });
        if (error) {
          alert(error);
          return;
        }
        refreshOrders();
      });

      // রিভিউ
      const reviewBox = card.querySelector('.review-box');
      if (reviewBox) {
        let selectedRating = 0;
        const starButtons = reviewBox.querySelectorAll('[data-star]');
        starButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            selectedRating = Number(btn.dataset.star);
            starButtons.forEach((b) => b.classList.toggle('active', Number(b.dataset.star) <= selectedRating));
          });
        });

        reviewBox.querySelector('.btn-submit-review')?.addEventListener('click', async (e) => {
          if (selectedRating === 0) {
            alert('রেটিং সিলেক্ট করো');
            return;
          }
          e.target.disabled = true;
          const comment = reviewBox.querySelector('[data-review-comment]').value.trim();
          const { error } = await submitReview({ requestId: req.id, rating: selectedRating, comment });
          if (error) {
            alert(error);
            e.target.disabled = false;
            return;
          }
          refreshOrders();
        });
      }
    }

    // ============ মার্জ ও রেন্ডার ============
    function renderAll(shopOrders, deliveryRequests, reviewedRequestIds) {
      ordersContainer.innerHTML = '';

      const combined = [
        ...shopOrders.map((o) => ({ ...o, __type: 'shop_order' })),
        ...deliveryRequests.map((d) => ({ ...d, __type: 'delivery', __hasReview: reviewedRequestIds.has(d.id) })),
      ].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

      if (combined.length === 0) {
        emptyOrders.style.display = 'block';
        return;
      }
      emptyOrders.style.display = 'none';

      combined.forEach((item) => {
        const card = item.__type === 'shop_order' ? renderShopOrderCard(item) : renderDeliveryCard(item);
        ordersContainer.appendChild(card);
      });
    }

    async function loadOrders(userId, { silent = false } = {}) {
      const [ordersRes, deliveryRes, reviewsRes] = await Promise.all([
        supabase
          .from('orders')
          .select('*, order_items(*), shops(name, slug, phone)')
          .eq('user_id', userId)
          .order('created_at', { ascending: false }),
        supabase
          .from('delivery_requests')
          .select(`
            *,
            delivery_offers(
              id, rider_profile_id, offer_price, last_actor, status,
              delivery_riders(profile_id, vehicle_type, profiles!delivery_riders_profile_id_fkey(full_name, phone))
            ),
            accepted_rider:delivery_riders!delivery_requests_accepted_rider_id_fkey(profile_id, vehicle_type, profiles!delivery_riders_profile_id_fkey(full_name, phone))
          `)
          .eq('customer_profile_id', userId)
          .order('created_at', { ascending: false }),
        supabase.from('delivery_reviews').select('request_id').eq('customer_profile_id', userId),
      ]);

      if (!silent) {
        loadingState.style.display = 'none';
        ordersContent.style.display = 'block';
      }

      if (ordersRes.error || deliveryRes.error) {
        if (!silent) {
          console.error('অর্ডার লোড এরর:', ordersRes.error?.message, deliveryRes.error?.message);
          ordersContainer.innerHTML = `<p style="text-align:center;color:#D14343;padding:40px 0;">লোড করা যায়নি: ${ordersRes.error?.message || deliveryRes.error?.message || ''}</p>`;
        }
        return;
      }

      const reviewedRequestIds = new Set((reviewsRes.data || []).map((r) => r.request_id));

      const deliveryRequests = (deliveryRes.data || []).map((req) => ({
        ...req,
        delivery_offers: (req.delivery_offers || []).filter((o) => ['pending', 'negotiating'].includes(o.status)),
      }));

      renderAll(ordersRes.data || [], deliveryRequests, reviewedRequestIds);
    }

    function refreshOrders() {
      if (currentUserId) loadOrders(currentUserId);
    }

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;

      await expireRequests();
      await loadOrders(currentUserId);

      refreshTimer = setInterval(() => {
        loadOrders(currentUserId, { silent: true });
      }, 15000);
    }

    window.addEventListener('beforeunload', () => {
      if (refreshTimer) clearInterval(refreshTimer);
    });

    init();
  </script>
</BaseLayout>