---
// ============================================================
// পেজ: /shop/[id] — পুরনো URL প্যাটার্ন (profile id দিয়ে)
// এখন slug-based top-level রুটে (/{slug}) সরে গেছে। এই পেজটা
// শুধু পুরনো লিংক/বুকমার্ক কাজ করানোর জন্য redirect হিসেবে থাকবে —
// profiles.id (পুরনো owner id) দিয়ে shops টেবিলে owner_id মিলিয়ে
// আসল slug বের করে সেখানে পাঠিয়ে দেয়।
// ============================================================

export const prerender = false;

import { supabase } from '../../lib/supabase.js';

const { id } = Astro.params;
// পুরনো অনলাইন শপ → কুইক ডেলিভারির দোকান (নভে ২০২৬)
{
  const { data: ds } = /^[0-9a-f-]{36}$/i.test(String(id || ''))
    ? await supabase.from('delivery_shops').select('id').eq('legacy_shop_id', id).maybeSingle()
    : { data: null };
  return Astro.redirect(ds ? '/market/shop?id=' + ds.id : '/market', 301);
}

const { data: shop } = await supabase
  .from('shops')
  .select('slug')
  .eq('owner_id', id)
  .maybeSingle();

if (shop) {
  return Astro.redirect(`/${shop.slug}`, 301);
}

return Astro.redirect('/shop', 301);
---