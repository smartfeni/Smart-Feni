---
// ============================================================
// পেজ: /shop/[id] — পুরনো URL প্যাটার্ন (profile id দিয়ে)
// এখন slug-based top-level রুটে (/{slug}) সরে গেছে। এই পেজটা
// শুধু পুরনো লিংক/বুকমার্ক কাজ করানোর জন্য redirect হিসেবে থাকবে —
// profiles.id (পুরনো owner id) দিয়ে shops টেবিলে owner_id মিলিয়ে
// আসল slug বের করে সেখানে পাঠিয়ে দেয়।
// ============================================================

export const prerender = false;

import { supabase } from '../../lib/supabase.js';

const { id } = Astro.params;

const { data: shop } = await supabase
  .from('shops')
  .select('slug')
  .eq('owner_id', id)
  .maybeSingle();

if (shop) {
  return Astro.redirect(`/${shop.slug}`, 301);
}

return Astro.redirect('/shop', 301);
---