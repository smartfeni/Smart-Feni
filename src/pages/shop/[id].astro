---
// path: src/pages/shop/[id].astro
// পুরনো অনলাইন শপ বন্ধ (নভে ২০২৬) — পুরনো শপ আইডি থেকে কুইক ডেলিভারির দোকানে রিডাইরেক্ট
export const prerender = false;
import { supabase } from '../../lib/supabase.js';
const { id } = Astro.params;
const { data: ds } = /^[0-9a-f-]{36}$/i.test(String(id || ''))
  ? await supabase.from('delivery_shops').select('id').eq('legacy_shop_id', id).maybeSingle()
  : { data: null };
return Astro.redirect(ds ? '/market/shop?id=' + ds.id : '/market', 301);
---
