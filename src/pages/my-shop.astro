---
// ============================================================
// পেজ: আমার শপ (/my-shop) — ট্যাব-ভিত্তিক ড্যাশবোর্ড
// (my-club.astro এর প্যাটার্নে রিফ্যাক্টর করা)
// তিনটা ট্যাব কম্পোনেন্টে ভাগ করা:
//   ProfileEditTab — শপের প্রোফাইল (নাম/লোগো/কভার/ট্যাগলাইন/ঠিকানা ইত্যাদি)
//   ProductsTab — প্রোডাক্ট Add/Edit/Delete
//   OrdersTab — অর্ডার হিস্ট্রি ও স্ট্যাটাস ট্র্যাকিং (v2: এখন যোগ করা হলো)
// profiles.shop_id দিয়ে shops টেবিলের সাথে লিংক
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import ProfileEditTab from '../components/shop-dashboard/ProfileEditTab.astro';
import ProductsTab from '../components/shop-dashboard/ProductsTab.astro';
import OrdersTab from '../components/shop-dashboard/OrdersTab.astro';
---

<BaseLayout title="আমার শপ | স্মার্ট ফেনী">
  <div class="myshop-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="guardedContent" class="myshop-content" style="display:none;">

        <div class="myshop-header">
          <h1><i class="fas fa-store"></i> <span id="shopHeaderName"></span></h1>
        </div>

        <div class="myshop-tabs" id="myshopTabs">
          <button class="myshop-tab active" data-tab="profile"><i class="fas fa-id-card"></i> প্রোফাইল</button>
          <button class="myshop-tab" data-tab="products"><i class="fas fa-box"></i> প্রোডাক্ট</button>
          <button class="myshop-tab" data-tab="orders"><i class="fas fa-receipt"></i> অর্ডার</button>
        </div>

        <div class="myshop-panel" data-panel="profile">
          <ProfileEditTab />
        </div>
        <div class="myshop-panel" data-panel="products" style="display:none;">
          <ProductsTab />
        </div>
        <div class="myshop-panel" data-panel="orders" style="display:none;">
          <OrdersTab />
        </div>

      </div>
    </div>
  </div>

  <style>
    .myshop-page {
      min-height: 70vh;
      padding: 32px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .myshop-content {
      max-width: 720px;
      margin: 0 auto;
    }

    .myshop-header h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
    }

    .myshop-header h1 i {
      color: #FF6B35;
    }

    .myshop-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 10px;
      margin-bottom: 20px;
      scrollbar-width: none;
    }

    .myshop-tabs::-webkit-scrollbar {
      display: none;
    }

    .myshop-tab {
      flex-shrink: 0;
      background: #fff;
      border: 1.5px solid #E5EAF0;
      color: #5A6E85;
      padding: 10px 16px;
      border-radius: 40px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .myshop-tab.active {
      background: #FF6B35;
      border-color: #FF6B35;
      color: #fff;
    }

  </style>

  <!-- ============================================================
       is:global জরুরি এখানে — ProfileEditTab, ProductsTab, OrdersTab
       আলাদা কম্পোনেন্ট, তাদের এলিমেন্টে my-shop.astro এর scoped CSS
       পৌঁছায় না। তাই শেয়ার্ড ফর্ম/কার্ড ক্লাসগুলো এখানে global করে
       দেওয়া হলো।
  ============================================================ -->
  <style is:global>
    /* ===== কমন ফর্ম/কার্ড স্টাইল — সবগুলো ট্যাব কম্পোনেন্টই এগুলো ব্যবহার করে ===== */
    .dash-card {
      background: #fff;
      border-radius: 20px;
      padding: 22px 20px;
      margin-bottom: 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .dash-card h3 {
      font-size: 0.98rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dash-card h3 i {
      color: #FF6B35;
    }

    .form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-msg.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .form-input:disabled {
      background: #F4F7FC;
      color: #9AA8BC;
      cursor: not-allowed;
    }

    .form-hint {
      font-size: 0.74rem;
      color: #9AA8BC;
      margin-top: 4px;
    }

    .primary-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-top: 16px;
    }

    .primary-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .secondary-btn {
      background: #F4F7FC;
      color: #1B2A4A;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .photo-upload-circle {
      position: relative;
      width: 80px;
      height: 80px;
      border-radius: 18px;
      background: #FFF0EA;
      border: 2px dashed #FFD3BC;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      margin: 0 auto 16px;
    }

    .photo-upload-circle img {
      display: none;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .photo-upload-circle.has-photo img {
      display: block;
    }

    .photo-upload-circle.has-photo i {
      display: none;
    }

    .photo-upload-circle i {
      color: #FF6B35;
      font-size: 1.4rem;
    }

    .empty-note {
      font-size: 0.84rem;
      color: #B0BCCB;
      text-align: center;
      padding: 20px 0;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const guardedContent = document.getElementById('guardedContent');
    const tabsBar = document.getElementById('myshopTabs');

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('is_shop_owner, shop_id')
        .eq('id', session.user.id)
        .single();

      if (!profile?.is_shop_owner || !profile?.shop_id) {
        window.location.href = '/';
        return;
      }

      const { data: shop } = await supabase
        .from('shops')
        .select('*')
        .eq('id', profile.shop_id)
        .single();

      if (!shop) {
        window.location.href = '/';
        return;
      }

      document.getElementById('shopHeaderName').textContent = shop.name;

      loadingState.style.display = 'none';
      guardedContent.style.display = 'block';

      window.dispatchEvent(new CustomEvent('smartfeni:shop-ready', { detail: { shopId: shop.id, shop } }));
    }

    tabsBar?.addEventListener('click', (e) => {
      const btn = e.target.closest('.myshop-tab');
      if (!btn) return;

      document.querySelectorAll('.myshop-tab').forEach((t) => t.classList.remove('active'));
      btn.classList.add('active');

      const target = btn.dataset.tab;
      document.querySelectorAll('.myshop-panel').forEach((p) => {
        p.style.display = p.dataset.panel === target ? 'block' : 'none';
      });
    });

    init();
  </script>
</BaseLayout>
