---
// ============================================================
// পেজ: আমার শপ (/my-shop) — ট্যাব-ভিত্তিক ড্যাশবোর্ড
// ট্যাব কম্পোনেন্ট: ProfileEditTab, ProductsTab, OrdersTab, ModeratorsTab
//
// ✅ আপডেট (একাধিক শপ):
// - এক ইউজার একাধিক শপের ওউনার হতে পারে (shops.owner_id দিয়ে খোঁজা হয়,
//   profiles.shop_id এখন শুধু ফলব্যাক)। মডারেটর হিসেবে যোগ করা শপও তালিকায় আসে।
// - /my-shop → শপ ১টা হলে সরাসরি ড্যাশবোর্ড; একাধিক হলে আগে "শপ সিলেক্ট"
//   তালিকা (প্রতিটা কার্ডে নতুন/পেন্ডিং অর্ডারের সংখ্যা ব্যাজ)।
// - /my-shop?shop=<id> → সেই শপের ড্যাশবোর্ড। ?tab= আগের মতোই কাজ করে।
// - একাধিক শপ থাকলে হেডারে "সব শপ" বাটন; "অর্ডার" ট্যাবেও পেন্ডিং সংখ্যা।
// - মডারেটর পারমিশন এখন শপ-ভিত্তিক (যে শপ খোলা, তার পারমিশন)।
// - ইভেন্ট smartfeni:shop-ready আগের মতোই (shopId, shop, isOwner, permissions)।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import ProfileEditTab from '../components/shop-dashboard/ProfileEditTab.astro';
import ProductsTab from '../components/shop-dashboard/ProductsTab.astro';
import OrdersTab from '../components/shop-dashboard/OrdersTab.astro';
import ModeratorsTab from '../components/shop-dashboard/ModeratorsTab.astro';
---

<BaseLayout title="আমার শপ | স্মার্ট ফেনী">
  <div class="myshop-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <!-- ===== শপ সিলেক্টর (একাধিক শপ থাকলে) ===== -->
      <div id="shopPicker" class="myshop-content" style="display:none;">
        <div class="picker-head">
          <h1><i class="fas fa-store"></i> আমার শপ</h1>
          <p>কোন শপে যাবেন সিলেক্ট করুন</p>
        </div>
        <div id="shopPickerList" class="picker-list"></div>
      </div>

      <div id="guardedContent" class="myshop-content" style="display:none;">

        <div class="myshop-header">
          <h1><i class="fas fa-store"></i> <span id="shopHeaderName"></span></h1>
          <div class="header-actions">
            <a href="/my-shop?all=1" class="all-shops-link" id="allShopsLink" style="display:none;">
              <i class="fas fa-repeat"></i> সব শপ
            </a>
            <button type="button" class="profile-edit-link" id="profileEditLink">
              <i class="fas fa-pen"></i> প্রোফাইল এডিট
            </button>
          </div>
        </div>

        <div class="shop-overview" id="shopOverview">
          <div class="ov-stats">
            <div class="ov-stat"><b id="ovPending">–</b><span>নতুন অর্ডার</span></div>
            <div class="ov-stat"><b id="ovToday">–</b><span>আজকের অর্ডার</span></div>
            <div class="ov-stat"><b id="ovProducts">–</b><span>প্রোডাক্ট</span></div>
          </div>
          <div class="ov-status">
            <span class="ov-dot" id="ovDot"></span>
            <span class="ov-status-text" id="ovStatusText">শপের অবস্থা দেখা হচ্ছে...</span>
            <label class="ov-pause" id="ovPauseWrap">
              <span>সাময়িক বন্ধ</span>
              <span class="ov-switch"><input type="checkbox" id="ovPause" /><i></i></span>
            </label>
          </div>
        </div>

        <div class="myshop-tabs" id="myshopTabs">
          <button class="myshop-tab" data-tab="products"><i class="fas fa-box"></i> প্রোডাক্ট</button>
          <button class="myshop-tab active" data-tab="orders">
            <i class="fas fa-receipt"></i> অর্ডার
            <span class="tab-badge" id="ordersTabBadge" style="display:none;"></span>
          </button>
          <button class="myshop-tab" data-tab="moderators" id="moderatorsTabBtn"><i class="fas fa-users-gear"></i> মডারেটর</button>
        </div>

        <div class="myshop-panel" data-panel="profile" style="display:none;">
          <ProfileEditTab />
        </div>
        <div class="myshop-panel" data-panel="products" style="display:none;">
          <ProductsTab />
        </div>
        <div class="myshop-panel" data-panel="orders">
          <OrdersTab />
        </div>
        <div class="myshop-panel" data-panel="moderators" style="display:none;">
          <ModeratorsTab />
        </div>

      </div>
    </div>
  </div>

  <style>
    .myshop-page {
      min-height: 70vh;
      padding: 32px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .myshop-content {
      max-width: 720px;
      margin: 0 auto;
    }

    .picker-head {
      margin-bottom: 18px;
    }

    .picker-head h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .picker-head h1 i {
      color: #FF6B35;
    }

    .picker-head p {
      font-size: 0.86rem;
      color: #5A6E85;
    }

    .myshop-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 18px;
    }

    .myshop-header h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 0;
      min-width: 0;
    }

    .myshop-header h1 i {
      color: #FF6B35;
    }

    .myshop-header h1 span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .header-actions {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .all-shops-link {
      flex-shrink: 0;
      color: #FF6B35;
      font-size: 0.78rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 5px;
      text-decoration: none;
      padding: 6px 8px;
      background: #FFF0EA;
      border-radius: 20px;
    }

    .profile-edit-link {
      flex-shrink: 0;
      background: none;
      border: none;
      color: #9AA8BC;
      font-size: 0.78rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      padding: 6px 4px;
    }

    .profile-edit-link:hover {
      color: #5A6E85;
    }

    .profile-edit-link.active {
      color: #FF6B35;
    }

    .myshop-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 10px;
      margin-bottom: 20px;
      scrollbar-width: none;
    }

    .myshop-tabs::-webkit-scrollbar {
      display: none;
    }

    .myshop-tab {
      flex-shrink: 0;
      background: #fff;
      border: 1.5px solid #E5EAF0;
      color: #5A6E85;
      padding: 10px 16px;
      border-radius: 40px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .myshop-tab.active {
      background: #FF6B35;
      border-color: #FF6B35;
      color: #fff;
    }

    .tab-badge {
      min-width: 20px;
      height: 20px;
      padding: 0 6px;
      border-radius: 10px;
      background: #D92D20;
      color: #fff;
      font-size: 0.72rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    .myshop-tab.active .tab-badge {
      background: #fff;
      color: #D92D20;
    }

    /* ওভারভিউ স্ট্রিপ */
    .shop-overview {
      background: #fff;
      border-radius: 20px;
      padding: 14px;
      margin-bottom: 16px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .ov-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .ov-stat {
      background: #F8FAFC;
      border-radius: 14px;
      padding: 10px 6px;
      text-align: center;
    }

    .ov-stat b {
      display: block;
      font-size: 1.3rem;
      font-weight: 800;
      color: #1B2A4A;
      line-height: 1.2;
    }

    .ov-stat span {
      font-size: 0.7rem;
      font-weight: 600;
      color: #8FA0BC;
    }

    .ov-status {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px dashed #E5EAF0;
    }

    .ov-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #C5CFDD;
      flex-shrink: 0;
    }

    .ov-dot.live {
      background: #22A559;
      box-shadow: 0 0 0 4px rgba(34, 165, 89, 0.18);
    }

    .ov-dot.hidden-now {
      background: #D14343;
      box-shadow: 0 0 0 4px rgba(209, 67, 67, 0.15);
    }

    .ov-status-text {
      flex: 1;
      min-width: 0;
      font-size: 0.78rem;
      font-weight: 600;
      color: #3A4A60;
      line-height: 1.4;
    }

    .ov-pause {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
      font-size: 0.74rem;
      font-weight: 700;
      color: #5A6E85;
      cursor: pointer;
    }

    .ov-switch {
      position: relative;
      width: 42px;
      height: 24px;
    }

    .ov-switch input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      opacity: 0;
      cursor: pointer;
      z-index: 2;
    }

    .ov-switch i {
      position: absolute;
      inset: 0;
      border-radius: 24px;
      background: #D7E0EC;
      transition: background 0.2s ease;
    }

    .ov-switch i::after {
      content: '';
      position: absolute;
      top: 3px;
      left: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.25);
      transition: transform 0.2s ease;
    }

    .ov-switch input:checked + i {
      background: #D14343;
    }

    .ov-switch input:checked + i::after {
      transform: translateX(18px);
    }

    body.mod-no-settings .ov-pause {
      display: none;
    }
  </style>

  <!-- ============================================================
       is:global জরুরি — ট্যাব কম্পোনেন্ট ও JS দিয়ে বানানো শপ কার্ডে
       scoped CSS পৌঁছায় না, তাই শেয়ার্ড ক্লাস (dash-card, form-*, shop-pick-*)
       এখানে global।
  ============================================================ -->
  <style is:global>
    .dash-card {
      background: #fff;
      border-radius: 20px;
      padding: 22px 20px;
      margin-bottom: 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .dash-card h3 {
      font-size: 0.98rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dash-card h3 i {
      color: #FF6B35;
    }

    .form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-msg.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .form-input:disabled {
      background: #F4F7FC;
      color: #9AA8BC;
      cursor: not-allowed;
    }

    .form-hint {
      font-size: 0.74rem;
      color: #9AA8BC;
      margin-top: 4px;
    }

    .primary-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-top: 16px;
    }

    .primary-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .secondary-btn {
      background: #F4F7FC;
      color: #1B2A4A;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .photo-upload-circle {
      position: relative;
      width: 80px;
      height: 80px;
      border-radius: 18px;
      background: #FFF0EA;
      border: 2px dashed #FFD3BC;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      margin: 0 auto 16px;
    }

    .photo-upload-circle img {
      display: none;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .photo-upload-circle.has-photo img {
      display: block;
    }

    .photo-upload-circle.has-photo i {
      display: none;
    }

    .photo-upload-circle i {
      color: #FF6B35;
      font-size: 1.4rem;
    }

    .empty-note {
      font-size: 0.84rem;
      color: #B0BCCB;
      text-align: center;
      padding: 20px 0;
    }

    /* ===== শপ সিলেক্টর কার্ড (JS দিয়ে বানানো) ===== */
    .picker-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .shop-pick-card {
      position: relative;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      background: #fff;
      border: 1px solid #E5EAF0;
      border-radius: 20px;
      text-decoration: none;
      color: #1B2A4A;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .shop-pick-card:active {
      transform: scale(0.98);
    }

    .shop-pick-logo {
      width: 56px;
      height: 56px;
      flex: 0 0 56px;
      border-radius: 16px;
      background: #FFF0EA;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      color: #FF6B35;
      font-size: 1.4rem;
    }

    .shop-pick-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .shop-pick-info {
      min-width: 0;
      flex: 1;
    }

    .shop-pick-name {
      display: block;
      font-size: 1rem;
      font-weight: 800;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .shop-pick-sub {
      display: block;
      font-size: 0.78rem;
      color: #8FA0BC;
      font-weight: 600;
      margin-top: 3px;
    }

    .shop-pick-sub.has-orders {
      color: #D92D20;
      font-weight: 700;
    }

    .shop-pick-badge {
      min-width: 26px;
      height: 26px;
      padding: 0 8px;
      border-radius: 13px;
      background: #D92D20;
      color: #fff;
      font-size: 0.8rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .shop-pick-arrow {
      color: #B6C2D3;
      font-size: 0.8rem;
      flex-shrink: 0;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const guardedContent = document.getElementById('guardedContent');
    const shopPicker = document.getElementById('shopPicker');
    const shopPickerList = document.getElementById('shopPickerList');
    const tabsBar = document.getElementById('myshopTabs');
    const moderatorsTabBtn = document.getElementById('moderatorsTabBtn');
    const allShopsLink = document.getElementById('allShopsLink');
    const ordersTabBadge = document.getElementById('ordersTabBadge');

    const bn = (n) => Number(n).toLocaleString('bn-BD');

    // শপ সিলেক্টর কার্ডে ট্যাব প্যারামিটার সাথে নিয়ে যাওয়া (ডিপলিংক হারাবে না)
    function shopUrl(shopId) {
      const params = new URLSearchParams();
      params.set('shop', shopId);
      const tab = new URLSearchParams(window.location.search).get('tab');
      if (tab) params.set('tab', tab);
      return `/my-shop?${params.toString()}`;
    }

    // শপ id → পেন্ডিং অর্ডার সংখ্যা। RLS/এরর হলে খালি ম্যাপ (ব্যাজ দেখাবে না)
    async function loadPendingCounts(shopIds) {
      const counts = {};
      if (!shopIds.length) return counts;
      const { data, error } = await supabase
        .from('orders')
        .select('shop_id')
        .in('shop_id', shopIds)
        .eq('status', 'pending');
      if (error || !data) return counts;
      data.forEach((o) => {
        counts[o.shop_id] = (counts[o.shop_id] || 0) + 1;
      });
      return counts;
    }

    function buildPicker(shops, counts) {
      shopPickerList.innerHTML = '';
      shops.forEach((shop) => {
        const pending = counts[shop.id] || 0;

        const card = document.createElement('a');
        card.className = 'shop-pick-card';
        card.href = shopUrl(shop.id);

        const logo = document.createElement('span');
        logo.className = 'shop-pick-logo';
        if (shop.logo_image) {
          const img = document.createElement('img');
          img.src = shop.logo_image;
          img.alt = shop.name || 'শপ';
          logo.appendChild(img);
        } else {
          logo.innerHTML = '<i class="fas fa-store"></i>';
        }

        const info = document.createElement('span');
        info.className = 'shop-pick-info';
        const name = document.createElement('span');
        name.className = 'shop-pick-name';
        name.textContent = shop.name || 'শপ';
        const sub = document.createElement('span');
        sub.className = 'shop-pick-sub' + (pending > 0 ? ' has-orders' : '');
        sub.textContent = pending > 0
          ? `${bn(pending)}টা নতুন অর্ডার`
          : (shop._isOwner ? 'ওউনার' : 'মডারেটর');
        info.appendChild(name);
        info.appendChild(sub);

        card.appendChild(logo);
        card.appendChild(info);

        if (pending > 0) {
          const badge = document.createElement('span');
          badge.className = 'shop-pick-badge';
          badge.textContent = bn(pending);
          card.appendChild(badge);
        }

        const arrow = document.createElement('i');
        arrow.className = 'fas fa-chevron-right shop-pick-arrow';
        card.appendChild(arrow);

        shopPickerList.appendChild(card);
      });
    }

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/';
        return;
      }
      const uid = session.user.id;

      // ============ ইউজারের সব শপ জোগাড় (ওউনার + মডারেটর) ============
      const { data: profile } = await supabase
        .from('profiles')
        .select('is_shop_owner, shop_id')
        .eq('id', uid)
        .single();

      const { data: ownedShops } = await supabase
        .from('shops')
        .select('*')
        .eq('owner_id', uid);

      const { data: modRows } = await supabase
        .from('moderators')
        .select('entity_id, can_edit_listings, can_delete_listings, can_manage_orders, can_edit_settings')
        .eq('entity_type', 'shop')
        .eq('profile_id', uid);

      const shopMap = new Map();
      (ownedShops || []).forEach((s) => shopMap.set(s.id, { ...s, _isOwner: true, _perms: null }));

      // ফলব্যাক: owner_id খালি থাকলেও profiles.shop_id দিয়ে আসল ওউনারের শপ ধরা
      if (profile?.is_shop_owner && profile?.shop_id && !shopMap.has(profile.shop_id)) {
        const { data: legacyShop } = await supabase
          .from('shops')
          .select('*')
          .eq('id', profile.shop_id)
          .maybeSingle();
        if (legacyShop) shopMap.set(legacyShop.id, { ...legacyShop, _isOwner: true, _perms: null });
      }

      // মডারেটর শপ (যেগুলো ওউনার হিসেবে আগেই নেই)
      const modIdsToFetch = (modRows || [])
        .map((m) => m.entity_id)
        .filter((id) => id && !shopMap.has(id));
      if (modIdsToFetch.length) {
        const { data: modShops } = await supabase
          .from('shops')
          .select('*')
          .in('id', modIdsToFetch);
        (modShops || []).forEach((s) => {
          const perm = modRows.find((m) => m.entity_id === s.id) || null;
          shopMap.set(s.id, { ...s, _isOwner: false, _perms: perm });
        });
      }

      const shops = Array.from(shopMap.values())
        .sort((a, b) => new Date(a.created_at || 0) - new Date(b.created_at || 0));

      if (!shops.length) {
        // না ওউনার, না মডারেটর — এই পেজে ঢোকার অনুমতি নেই
        window.location.href = '/';
        return;
      }

      const params = new URLSearchParams(window.location.search);
      const wantedShopId = params.get('shop');
      const showAll = params.get('all') === '1';

      let chosen = null;
      if (wantedShopId) {
        chosen = shops.find((s) => s.id === wantedShopId) || null;
      }
      if (!chosen && shops.length === 1) {
        chosen = shops[0];
      }

      // ============ একাধিক শপ, কোনোটা সিলেক্ট করা নেই → সিলেক্টর ============
      if (!chosen || (showAll && shops.length > 1)) {
        const counts = await loadPendingCounts(shops.map((s) => s.id));
        buildPicker(shops, counts);
        loadingState.style.display = 'none';
        shopPicker.style.display = 'block';
        return;
      }

      // ============ ড্যাশবোর্ড ============
      const shop = chosen;
      const isOwner = shop._isOwner;
      const modPerms = shop._perms;

      document.getElementById('shopHeaderName').textContent = shop.name;

      if (shops.length > 1) {
        allShopsLink.style.display = 'flex';
      }

      // মডারেটর হলে UI পারমিশন অনুযায়ী রেস্ট্রিক্ট
      document.body.classList.remove('mod-no-edit-listings', 'mod-no-delete', 'mod-no-orders', 'mod-no-settings');
      if (!isOwner) {
        // মডারেটর ট্যাব শুধু আসল ওউনারের জন্য (RLS: owner_manage_moderators)
        moderatorsTabBtn?.remove();

        if (!modPerms?.can_edit_listings) document.body.classList.add('mod-no-edit-listings');
        if (!modPerms?.can_delete_listings) document.body.classList.add('mod-no-delete');
        if (!modPerms?.can_manage_orders) document.body.classList.add('mod-no-orders');
        if (!modPerms?.can_edit_settings) document.body.classList.add('mod-no-settings');
      }

      applyTabFromUrl();

      loadingState.style.display = 'none';
      guardedContent.style.display = 'block';

      // _isOwner/_perms সাহায্যকারী ফিল্ড বাদ দিয়ে আসল শপ অবজেক্ট পাঠানো
      const { _isOwner, _perms, ...cleanShop } = shop;

      window.dispatchEvent(new CustomEvent('smartfeni:shop-ready', {
        detail: { shopId: cleanShop.id, shop: cleanShop, isOwner, permissions: modPerms },
      }));

      // অর্ডার ট্যাবে পেন্ডিং সংখ্যা (ব্যাকগ্রাউন্ডে, পেজ আটকায় না)
      const counts = await loadPendingCounts([cleanShop.id]);
      const pending = counts[cleanShop.id] || 0;
      if (pending > 0 && ordersTabBadge) {
        ordersTabBadge.textContent = bn(pending);
        ordersTabBadge.style.display = 'inline-flex';
      }

      loadOverview(cleanShop, pending);
    }

    // ============================================================
    // ট্যাব: "প্রোফাইল" হেডারের ছোট লিংক, বাকিগুলো ট্যাব বার। ডিফল্ট "অর্ডার"।
    // ============================================================
    const profileEditLink = document.getElementById('profileEditLink');

    function activateTab(target) {
      document.querySelectorAll('.myshop-tab').forEach((t) => t.classList.remove('active'));
      document.querySelector(`.myshop-tab[data-tab="${target}"]`)?.classList.add('active');
      profileEditLink?.classList.toggle('active', target === 'profile');

      document.querySelectorAll('.myshop-panel').forEach((p) => {
        p.style.display = p.dataset.panel === target ? 'block' : 'none';
      });
    }

    function applyTabFromUrl() {
      const wanted = new URLSearchParams(window.location.search).get('tab');
      if (!wanted) return;
      const exists = wanted === 'profile' || document.querySelector(`.myshop-tab[data-tab="${wanted}"]`);
      if (exists) activateTab(wanted);
    }

    tabsBar?.addEventListener('click', (e) => {
      const btn = e.target.closest('.myshop-tab');
      if (!btn) return;
      activateTab(btn.dataset.tab);
    });

    profileEditLink?.addEventListener('click', () => activateTab('profile'));

    // ============================================================
    // ওভারভিউ স্ট্রিপ: সংখ্যা + শপ এখন ক্রেতাদের তালিকায় দেখা যাচ্ছে কিনা
    // (শুধু ওনার দেখে; ক্রেতারা কোনো খোলা/বন্ধ লেবেল দেখে না)
    // ============================================================
    const ovPending = document.getElementById('ovPending');
    const ovToday = document.getElementById('ovToday');
    const ovProducts = document.getElementById('ovProducts');
    const ovDot = document.getElementById('ovDot');
    const ovStatusText = document.getElementById('ovStatusText');
    const ovPause = document.getElementById('ovPause');
    const ov = { shopId: null, hours: null, paused: false };

    async function refreshLiveStatus() {
      const { data, error } = await supabase.rpc('shop_is_open_now', {
        p_hours: ov.hours,
        p_paused: ov.paused,
      });
      if (error || typeof data !== 'boolean') {
        ovStatusText.textContent = 'শপের অবস্থা দেখা যাচ্ছে না';
        ovDot.className = 'ov-dot';
        return;
      }
      if (data) {
        ovDot.className = 'ov-dot live';
        ovStatusText.textContent = 'আপনার শপ এখন ক্রেতাদের তালিকায় দেখা যাচ্ছে';
      } else {
        ovDot.className = 'ov-dot hidden-now';
        ovStatusText.textContent = ov.paused
          ? 'সাময়িক বন্ধ চালু আছে, ক্রেতাদের তালিকায় শপ লুকানো'
          : 'এখন খোলার সময়ের বাইরে, ক্রেতাদের তালিকায় শপ লুকানো';
      }
    }

    async function loadOverview(shop, pending) {
      ov.shopId = shop.id;
      ov.hours = shop.opening_hours || null;
      ov.paused = !!shop.temporarily_closed;

      ovPending.textContent = bn(pending);
      ovPause.checked = ov.paused;

      // আজকের শুরু (বাংলাদেশ সময় UTC+6)
      const DHAKA = 6 * 3600 * 1000;
      const dayStart = new Date(Math.floor((Date.now() + DHAKA) / 86400000) * 86400000 - DHAKA).toISOString();

      const [prod, today] = await Promise.all([
        supabase.from('listings').select('id', { count: 'exact', head: true })
          .eq('category', 'online-shop').eq('shop_id', shop.id).eq('status', 'active'),
        supabase.from('orders').select('id', { count: 'exact', head: true })
          .eq('shop_id', shop.id).gte('created_at', dayStart),
      ]);

      ovProducts.textContent = prod.error ? '–' : bn(prod.count || 0);
      ovToday.textContent = today.error ? '–' : bn(today.count || 0);

      refreshLiveStatus();
    }

    ovPause?.addEventListener('change', async () => {
      if (!ov.shopId) return;
      const next = ovPause.checked;
      ovPause.disabled = true;
      const { error } = await supabase.from('shops').update({ temporarily_closed: next }).eq('id', ov.shopId);
      ovPause.disabled = false;

      if (error) {
        ovPause.checked = !next;
        window.showToast?.('বদলানো যায়নি: ' + error.message, 'error', 3500);
        return;
      }

      ov.paused = next;
      window.dispatchEvent(new CustomEvent('smartfeni:shop-hours-changed', {
        detail: { opening_hours: ov.hours, temporarily_closed: next, from: 'overview' },
      }));
      window.showToast?.(next ? 'শপ সাময়িক বন্ধ, তালিকা থেকে লুকানো হলো' : 'শপ আবার চালু হলো ✓', 'success');
      refreshLiveStatus();
    });

    // খোলার সময় কার্ড থেকে সেভ করলে স্ট্রিপও আপডেট
    window.addEventListener('smartfeni:shop-hours-changed', (e) => {
      if (e.detail?.from === 'overview') return;
      ov.hours = e.detail?.opening_hours ?? null;
      ov.paused = !!e.detail?.temporarily_closed;
      if (ovPause) ovPause.checked = ov.paused;
      refreshLiveStatus();
    });

    init();
  </script>
</BaseLayout>
