<!-- path: src/pages/my-shop.astro -->
---
// ============================================================
// পেজ: আমার শপ (/my-shop) — ট্যাব-ভিত্তিক ড্যাশবোর্ড
// (my-club.astro এর প্যাটার্নে রিফ্যাক্টর করা)
// ট্যাব কম্পোনেন্টে ভাগ করা:
//   ProfileEditTab — শপের প্রোফাইল
//   ProductsTab — প্রোডাক্ট Add/Edit/Delete
//   OrdersTab — অর্ডার হিস্ট্রি ও স্ট্যাটাস ট্র্যাকিং
//   ModeratorsTab — মডারেটর ম্যানেজমেন্ট
// profiles.shop_id দিয়ে shops টেবিলের সাথে লিংক (ওউনারের ক্ষেত্রে)
//
// ✅ ফিক্স করা হলো: এখন শপ ওউনার (is_shop_owner+shop_id) ছাড়াও
// moderators টেবিলে entity_type='shop' + profile_id=user হিসেবে
// যোগ করা মডারেটররাও এই পেজে ঢুকতে পারবে। মডারেটর হলে:
//   - "মডারেটর" ট্যাব হাইড থাকবে (শুধু ওউনার মডারেটর ম্যানেজ করতে পারবে,
//     RLS policy owner_manage_moderators অনুযায়ী)
//   - can_edit_listings / can_delete_listings false হলে body তে
//     mod-no-edit-listings / mod-no-delete ক্লাস বসবে (ProductsTab.astro
//     এর CSS আগে থেকেই এই ক্লাসগুলো হ্যান্ডেল করার জন্য রেডি আছে)
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import ProfileEditTab from '../components/shop-dashboard/ProfileEditTab.astro';
import ProductsTab from '../components/shop-dashboard/ProductsTab.astro';
import OrdersTab from '../components/shop-dashboard/OrdersTab.astro';
import ModeratorsTab from '../components/shop-dashboard/ModeratorsTab.astro';
---

<BaseLayout title="আমার শপ | স্মার্ট ফেনী">
  <div class="myshop-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="guardedContent" class="myshop-content" style="display:none;">

        <div class="myshop-header">
          <h1><i class="fas fa-store"></i> <span id="shopHeaderName"></span></h1>
          <button type="button" class="profile-edit-link" id="profileEditLink">
            <i class="fas fa-pen"></i> প্রোফাইল এডিট
          </button>
        </div>

        <div class="myshop-tabs" id="myshopTabs">
          <button class="myshop-tab" data-tab="products"><i class="fas fa-box"></i> প্রোডাক্ট</button>
          <button class="myshop-tab active" data-tab="orders"><i class="fas fa-receipt"></i> অর্ডার</button>
          <button class="myshop-tab" data-tab="moderators" id="moderatorsTabBtn"><i class="fas fa-users-gear"></i> মডারেটর</button>
        </div>

        <div class="myshop-panel" data-panel="profile" style="display:none;">
          <ProfileEditTab />
        </div>
        <div class="myshop-panel" data-panel="products" style="display:none;">
          <ProductsTab />
        </div>
        <div class="myshop-panel" data-panel="orders">
          <OrdersTab />
        </div>
        <div class="myshop-panel" data-panel="moderators" style="display:none;">
          <ModeratorsTab />
        </div>

      </div>
    </div>
  </div>

  <style>
    .myshop-page {
      min-height: 70vh;
      padding: 32px 0 80px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .myshop-content {
      max-width: 720px;
      margin: 0 auto;
    }

    .myshop-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 18px;
    }

    .myshop-header h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 0;
    }

    .myshop-header h1 i {
      color: #FF6B35;
    }

    .profile-edit-link {
      flex-shrink: 0;
      background: none;
      border: none;
      color: #9AA8BC;
      font-size: 0.78rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      padding: 6px 4px;
    }

    .profile-edit-link:hover {
      color: #5A6E85;
    }

    .profile-edit-link.active {
      color: #FF6B35;
    }

    .myshop-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 10px;
      margin-bottom: 20px;
      scrollbar-width: none;
    }

    .myshop-tabs::-webkit-scrollbar {
      display: none;
    }

    .myshop-tab {
      flex-shrink: 0;
      background: #fff;
      border: 1.5px solid #E5EAF0;
      color: #5A6E85;
      padding: 10px 16px;
      border-radius: 40px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .myshop-tab.active {
      background: #FF6B35;
      border-color: #FF6B35;
      color: #fff;
    }

  </style>

  <!-- ============================================================
       is:global জরুরি এখানে — ProfileEditTab, ProductsTab, OrdersTab,
       ModeratorsTab আলাদা কম্পোনেন্ট, তাদের এলিমেন্টে my-shop.astro
       এর scoped CSS পৌঁছায় না। তাই শেয়ার্ড ফর্ম/কার্ড ক্লাসগুলো এখানে
       global করে দেওয়া হলো।
  ============================================================ -->
  <style is:global>
    .dash-card {
      background: #fff;
      border-radius: 20px;
      padding: 22px 20px;
      margin-bottom: 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .dash-card h3 {
      font-size: 0.98rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dash-card h3 i {
      color: #FF6B35;
    }

    .form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-msg.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .form-input:disabled {
      background: #F4F7FC;
      color: #9AA8BC;
      cursor: not-allowed;
    }

    .form-hint {
      font-size: 0.74rem;
      color: #9AA8BC;
      margin-top: 4px;
    }

    .primary-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-top: 16px;
    }

    .primary-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .secondary-btn {
      background: #F4F7FC;
      color: #1B2A4A;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .photo-upload-circle {
      position: relative;
      width: 80px;
      height: 80px;
      border-radius: 18px;
      background: #FFF0EA;
      border: 2px dashed #FFD3BC;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      margin: 0 auto 16px;
    }

    .photo-upload-circle img {
      display: none;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .photo-upload-circle.has-photo img {
      display: block;
    }

    .photo-upload-circle.has-photo i {
      display: none;
    }

    .photo-upload-circle i {
      color: #FF6B35;
      font-size: 1.4rem;
    }

    .empty-note {
      font-size: 0.84rem;
      color: #B0BCCB;
      text-align: center;
      padding: 20px 0;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const guardedContent = document.getElementById('guardedContent');
    const tabsBar = document.getElementById('myshopTabs');
    const moderatorsTabBtn = document.getElementById('moderatorsTabBtn');

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('is_shop_owner, shop_id')
        .eq('id', session.user.id)
        .single();

      let shopId = null;
      let isOwner = false;
      let modPerms = null; // owner হলে null থাকবে (সব পারমিশন আছে ধরে নেওয়া হবে)

      if (profile?.is_shop_owner && profile?.shop_id) {
        // ============ কেস ১: শপ ওউনার ============
        shopId = profile.shop_id;
        isOwner = true;
      } else {
        // ============ কেস ২: মডারেটর কিনা চেক ============
        const { data: modRow } = await supabase
          .from('moderators')
          .select('entity_id, can_edit_listings, can_delete_listings, can_manage_orders, can_edit_settings')
          .eq('entity_type', 'shop')
          .eq('profile_id', session.user.id)
          .maybeSingle();

        if (modRow?.entity_id) {
          shopId = modRow.entity_id;
          isOwner = false;
          modPerms = modRow;
        }
      }

      if (!shopId) {
        // না ওউনার, না মডারেটর — এই পেজে ঢোকার অনুমতি নেই
        window.location.href = '/';
        return;
      }

      const { data: shop } = await supabase
        .from('shops')
        .select('*')
        .eq('id', shopId)
        .single();

      if (!shop) {
        window.location.href = '/';
        return;
      }

      document.getElementById('shopHeaderName').textContent = shop.name;

      // ============ মডারেটর হলে UI পারমিশন অনুযায়ী রেস্ট্রিক্ট করা ============
      if (!isOwner) {
        // মডারেটর ট্যাব শুধু আসল ওউনারের জন্য — RLS policy
        // owner_manage_moderators অনুযায়ী মডারেটর ম্যানেজ করার
        // অনুমতি শুধু ওউনারের আছে
        moderatorsTabBtn?.remove();

        if (!modPerms?.can_edit_listings) {
          document.body.classList.add('mod-no-edit-listings');
        }
        if (!modPerms?.can_delete_listings) {
          document.body.classList.add('mod-no-delete');
        }
        if (!modPerms?.can_manage_orders) {
          document.body.classList.add('mod-no-orders');
        }
        if (!modPerms?.can_edit_settings) {
          document.body.classList.add('mod-no-settings');
        }
      }

      loadingState.style.display = 'none';
      guardedContent.style.display = 'block';

      window.dispatchEvent(new CustomEvent('smartfeni:shop-ready', {
        detail: { shopId: shop.id, shop, isOwner, permissions: modPerms },
      }));
    }

    // ============================================================
    // আপডেট (UI পুনর্বিন্যাস): "প্রোফাইল" ট্যাব বার থেকে সরিয়ে
    // হেডারে শপের নামের পাশে ছোট "প্রোফাইল এডিট" লিংক করা হলো, যাতে
    // মেইন ট্যাব বারে বেশি প্রধান্য না পেয়ে ভুলে ক্লিক করে কিছু বদলে
    // না যায়। activateTab() ফাংশন দুই জায়গা থেকেই (ট্যাব বার +
    // প্রোফাইল এডিট লিংক) কল হয়। ডিফল্ট ট্যাব এখন "অর্ডার" (আগে
    // "প্রোফাইল" ডিফল্ট ছিল)।
    // ============================================================
    const profileEditLink = document.getElementById('profileEditLink');

    function activateTab(target) {
      document.querySelectorAll('.myshop-tab').forEach((t) => t.classList.remove('active'));
      document.querySelector(`.myshop-tab[data-tab="${target}"]`)?.classList.add('active');
      profileEditLink?.classList.toggle('active', target === 'profile');

      document.querySelectorAll('.myshop-panel').forEach((p) => {
        p.style.display = p.dataset.panel === target ? 'block' : 'none';
      });
    }

    tabsBar?.addEventListener('click', (e) => {
      const btn = e.target.closest('.myshop-tab');
      if (!btn) return;
      activateTab(btn.dataset.tab);
    });

    profileEditLink?.addEventListener('click', () => activateTab('profile'));

    init();
  </script>
</BaseLayout>
