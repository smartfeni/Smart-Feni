---
// ============================================================
// পেজ: Smart Feni Pro ডাউনলোড (/pro-app) — পাবলিক, ব্রাউজারে খোলার জন্য
// কে: দোকান/রাইডার/ক্লাব/ক্লিনিক মালিকদের পাঠানো লিংক
// কী: সর্বশেষ রিলিজ (ডাটাবেসের app_releases, RPC get_latest_app_release('pro')),
//     "কী নতুন", ডাউনলোড বাটন (বাইরের লিংক), বাংলা ইনস্টল গাইড
// রিলিজ সারি না থাকলে "শীঘ্রই আসছে" দেখায়। লেখা শুধু textContent।
// ============================================================
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import ProGuide from '../components/pro/ProGuide.astro';
---

<BaseLayout title="Smart Feni Pro ডাউনলোড | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="pa-page">
    <div class="pa-top">
      <img src="/pro-logo.png" alt="Smart Feni Pro" class="pa-logo" />
      <div class="pa-brand">Smart Feni <span>Pro</span></div>
      <p class="pa-tag">দোকান, রাইডার, ক্লাব ও ক্লিনিক ম্যানেজারদের জন্য</p>
    </div>

    <div class="pa-sheet">
      <div class="pa-grip"></div>

      <section class="pa-card" id="paRelease" aria-live="polite">
        <div class="pa-ver" id="paVer">লোড হচ্ছে…</div>
        <div class="pa-date" id="paDate"></div>
        <div class="pa-notes" id="paNotes" style="display:none;"></div>
        <a class="pa-cta" id="paDl" href="#" target="_blank" rel="noopener" style="display:none;">
          <i class="fas fa-download"></i><span>ডাউনলোড করুন (Android)</span>
        </a>
        <p class="pa-soon" id="paSoon" style="display:none;">ডাউনলোড লিংক এখনো প্রস্তুত নয়, একটু পরে আবার দেখুন।</p>
      </section>

      <section class="pa-card">
        <h2 class="pa-h2">ইনস্টল করবেন যেভাবে</h2>
        <ol class="pa-steps">
          <li><b>ডাউনলোড</b> বাটনে চাপুন। নতুন পেজ খুললে সেখানে ডাউনলোডে চাপুন।</li>
          <li>ফাইলটা নামলে সেটা খুলুন এবং <b>ইনস্টল</b> চাপুন।</li>
          <li>"অজানা উৎস থেকে ইনস্টল" এর অনুমতি চাইলে <b>সেটিংস</b>-এ গিয়ে আপনার ব্রাউজারের জন্য অনুমতি দিন, তারপর ফিরে এসে আবার ইনস্টল চাপুন।</li>
          <li>Play Protect সতর্কতা আসলে <b>"আরও বিস্তারিত"</b> চেপে <b>"তবুও ইনস্টল করুন"</b> নিন। অ্যাপটা আমরা নিজেরা বানিয়েছি, তাই এখনো Play Store-এ নেই।</li>
          <li>অ্যাপ খুলে আপনার ফোন নম্বর বা ইমেইল ও পাসওয়ার্ড দিয়ে লগইন করুন।</li>
        </ol>
      </section>

      <ProGuide />

      <section class="pa-card pa-note">
        <i class="fas fa-circle-info"></i>
        <div>
          <b>আপডেট করতে:</b> নতুন ভার্সন এলে অ্যাপের ভেতরেই জানানো হবে। ডাউনলোড করে পুরোনোর উপরেই ইনস্টল করুন, কোনো কিছু মুছবে না।<br />
          Pro অ্যাকাউন্ট না থাকলে বা লগইনে সমস্যা হলে স্মার্ট ফেনী অ্যাডমিনের সাথে যোগাযোগ করুন।
        </div>
      </section>
    </div>
  </div>

  <style is:global>
    /* এই পেজে সাধারণ হেডার ও বটম নেভ লুকানো */
    .navbar, .bottom-nav, .psh-nav { display: none !important; }
    body { padding-bottom: 0 !important; background: #1B2A4A; }

    .pa-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; min-height: 100vh; background: #1B2A4A; display: flex; flex-direction: column; max-width: 520px; margin: 0 auto; }
    .pa-top { padding: 36px 20px 40px; text-align: center; color: #fff; }
    .pa-logo { width: 64px; height: 64px; border-radius: 18px; background: #fff; object-fit: contain; padding: 6px; }
    .pa-brand { font-size: 26px; font-weight: 700; margin-top: 12px; }
    .pa-brand span { color: #FF6B35; }
    .pa-tag { margin: 4px 0 0; font-size: 14px; color: #B7C2D8; }

    .pa-sheet { flex: 1; background: #F8FAFC; border-radius: 28px 28px 0 0; padding: 10px 16px 32px; }
    .pa-grip { width: 44px; height: 5px; border-radius: 3px; background: #D5DCE8; margin: 2px auto 14px; }
    .pa-card { background: #fff; border-radius: 20px; padding: 18px; margin-bottom: 14px; box-shadow: 0 2px 10px rgba(27, 42, 74, 0.06); }
    .pa-ver { font-size: 20px; font-weight: 700; }
    .pa-date { font-size: 13px; color: #5B6B86; margin-top: 2px; }
    .pa-notes { white-space: pre-line; background: #F8FAFC; border-radius: 14px; padding: 12px 14px; margin-top: 12px; font-size: 15px; line-height: 1.55; }
    .pa-cta { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; margin-top: 16px; border-radius: 16px; background: #FF6B35; color: #fff; font-size: 17px; font-weight: 700; text-decoration: none; }
    .pa-soon { margin: 14px 0 0; color: #5B6B86; font-size: 14px; }
    .pa-h2 { margin: 0 0 10px; font-size: 18px; font-weight: 700; }
    .pa-steps { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.55; }
    .pa-note { display: flex; gap: 12px; font-size: 14px; line-height: 1.6; color: #1B2A4A; background: #FFF6F1; }
    .pa-note i { color: #FF6B35; margin-top: 3px; }
  </style>

  <script>
    import { fetchLatestRelease } from '../lib/proUpdate.js';

    const $ = (id) => document.getElementById(id);

    function safeHttpsUrl(u) {
      try {
        const x = new URL(String(u));
        return x.protocol === 'https:' ? x.href : null;
      } catch (_) {
        return null;
      }
    }

    async function init() {
      const rel = await fetchLatestRelease('pro');
      const url = rel ? safeHttpsUrl(rel.download_url) : null;

      if (!rel || !url) {
        $('paVer').textContent = 'Smart Feni Pro';
        $('paSoon').style.display = 'block';
        return;
      }

      $('paVer').textContent = 'সর্বশেষ ভার্সন: ' + String(rel.version_name || rel.version_code);
      try {
        const d = new Date(rel.created_at);
        if (!isNaN(d.getTime())) $('paDate').textContent = d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' });
      } catch (_) { /* তারিখ না দেখালেও চলবে */ }

      if (rel.notes) {
        const n = $('paNotes');
        n.textContent = String(rel.notes);
        n.style.display = 'block';
      }

      const dl = $('paDl');
      dl.href = url;
      dl.style.display = 'flex';
    }

    init();
  </script>
</BaseLayout>
