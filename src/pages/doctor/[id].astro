  <script is:inline type="application/json" id="schedData" set:html={schedJson}></script>

  <script>
    import { supabase } from '../../lib/supabase.js';

    const dataEl = document.getElementById('schedData');
    const sched = dataEl ? JSON.parse(dataEl.textContent || '{}') : { chambers: [] };

    const WEEKDAY_FULL = { 0: 'রবিবার', 1: 'সোমবার', 2: 'মঙ্গলবার', 3: 'বুধবার', 4: 'বৃহস্পতিবার', 5: 'শুক্রবার', 6: 'শনিবার' };
    const BN_DIGITS = '০১২৩৪৫৬৭৮৯';
    const toBn = (n) => String(n).replace(/\d/g, (d) => BN_DIGITS[d]);
    const toMin = (t) => { const [h, m] = String(t).split(':').map(Number); return h * 60 + m; };
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function fmtTime(t) {
      const [h, m] = String(t).split(':').map(Number);
      let period = 'রাত';
      if (h >= 4 && h < 6) period = 'ভোর';
      else if (h >= 6 && h < 12) period = 'সকাল';
      else if (h >= 12 && h < 15) period = 'দুপুর';
      else if (h >= 15 && h < 18) period = 'বিকাল';
      else if (h >= 18 && h < 20) period = 'সন্ধ্যা';
      return `${period} ${toBn(h % 12 || 12)}:${toBn(String(m).padStart(2, '0'))}`;
    }

    // ঢাকার বর্তমান বার ও মিনিট
    function dhakaNow() {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Dhaka', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (t) => parts.find((p) => p.type === t)?.value;
      const weekday = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 }[get('weekday')];
      return { weekday, minutes: (Number(get('hour')) % 24) * 60 + Number(get('minute')) };
    }

    function dayLabel(i, wd) {
      return i === 0 ? 'আজ' : i === 1 ? 'আগামীকাল' : i === 2 ? 'পরশু' : WEEKDAY_FULL[wd];
    }

    function render() {
      const now = dhakaNow();

      // প্রতিটা চেম্বারের আজকের ব্যাজ
      sched.chambers.forEach((c) => {
        const el = document.querySelector(`[data-badge="${c.id}"]`);
        if (!el) return;
        const today = c.slots.filter((s) => s.weekday === now.weekday);
        const sitting = today.some((s) => toMin(s.start) <= now.minutes && now.minutes < toMin(s.end));
        const later = today.some((s) => toMin(s.start) > now.minutes);
        if (sitting) {
          el.className = 'dd-badge now';
          el.innerHTML = '<span class="dd-dot"></span> এখন বসছেন';
          el.style.display = 'inline-flex';
        } else if (later) {
          el.className = 'dd-badge today';
          el.textContent = 'আজ বসছেন';
          el.style.display = 'inline-flex';
        } else {
          el.style.display = 'none';
        }
      });

      // আগামী ৭ দিনের সূচি
      const week = document.getElementById('ddWeek');
      if (!week) return;
      let html = '';
      for (let i = 0; i < 7; i++) {
        const wd = (now.weekday + i) % 7;
        const items = [];
        sched.chambers.forEach((c) => {
          c.slots
            .filter((s) => s.weekday === wd)
            .sort((a, b) => toMin(a.start) - toMin(b.start))
            .forEach((s) => items.push({ name: c.name, start: s.start, end: s.end }));
        });
        items.sort((a, b) => toMin(a.start) - toMin(b.start));
        const body = items.length
          ? items.map((x) => `<div class="dd-wk-item"><strong>${esc(x.name)}</strong> <span>· ${fmtTime(x.start)} – ${fmtTime(x.end)}</span></div>`).join('')
          : '<span class="dd-wk-none">বসেন না</span>';
        html += `<div class="dd-wk-row${i === 0 ? ' today' : ''}">
          <div class="dd-wk-day"><strong>${dayLabel(i, wd)}</strong>${i < 3 ? `<small>${WEEKDAY_FULL[wd]}</small>` : ''}</div>
          <div class="dd-wk-body">${body}</div>
        </div>`;
      }
      week.innerHTML = html;
    }

    render();
    setInterval(render, 60000);

    // ছবিতে ট্যাপ → লাইটবক্স
    const photo = document.getElementById('ddPhoto');
    if (photo && photo.dataset.photo) {
      photo.addEventListener('click', () => {
        if (window.openImageLightbox) window.openImageLightbox(photo.dataset.photo);
      });
    }

    // শেয়ার
    const shareBtn = document.getElementById('ddShare');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const url = window.location.href;
        const title = document.title;
        if (navigator.share) {
          try { await navigator.share({ title, url }); } catch (_) { /* ইউজার বাতিল করেছে */ }
          return;
        }
        try {
          await navigator.clipboard.writeText(url);
          window.showToast('লিংক কপি হয়েছে ✓', 'success');
        } catch (_) {
          window.showToast('লিংক কপি করা যায়নি', 'error');
        }
      });
    }

    // ============================================================
    // সিরিয়াল রিকোয়েস্ট ফর্ম (বটম শিট)
    // ============================================================
    const ddmOverlay = document.getElementById('ddSerialOverlay');
    if (ddmOverlay) {
      const MONTHS = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];
      const g = (id) => document.getElementById(id);
      const sheet = g('ddSerialSheet');
      const dateSel = g('ddmDate');
      const nameIn = g('ddmName');
      const phoneIn = g('ddmPhone');
      const problemIn = g('ddmProblem');
      const errorEl = g('ddmError');
      const urgentBox = g('ddmUrgentBox');
      const submitBtn = g('ddmSubmit');
      const submitText = g('ddmSubmitText');

      const URGENT = [
        /বুক(ে|ের)?\s*(খুব\s*|প্রচণ্ড\s*)?(ব্যথা|ব্যাথা|চাপ|যন্ত্রণা)/, /হার্ট\s*(অ্যাটাক|এটাক)/,
        /শ্বাস(\s*নিতে)?\s*(কষ্ট|পারছ|বন্ধ)|শ্বাসকষ্ট|দম\s*(বন্ধ|আটকে)/, /অজ্ঞান|বেহুঁশ|জ্ঞান\s*(নেই|হারা)/,
        /(প্রচণ্ড|প্রচুর|অনেক)\s*রক্ত|রক্তক্ষরণ|রক্ত\s*বমি/, /বিষ\s*(খেয়ে|পান)|বিষক্রিয়া/, /সাপ(ে|ের)?\s*(কামড়|কেটে)/,
        /খিঁ?চুনি|তড়কা/, /স্ট্রোক|মুখ\s*(বেঁকে|বাঁকা)|কথা\s*জড়িয়ে/, /প্রসব\s*(ব্যথা|বেদনা)|পানি\s*ভে?ঙে/,
        /chest\s*pain|can'?t\s*breathe|unconscious|seizure|stroke|poison|snake\s*bite/i,
      ];
      const isUrgent = (t) => {
        const s = String(t || '').normalize('NFC').toLowerCase();
        return URGENT.some((re) => re.test(s));
      };

      let currentChamber = null;
      let urgentAck = false;
      let submitting = false;
      let hasDates = false;

      function dhakaParts() {
        const p = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Dhaka', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
        }).formatToParts(new Date());
        const n = (t) => Number(p.find((x) => x.type === t)?.value);
        const hour = n('hour') % 24;
        return { y: n('year'), m: n('month'), d: n('day'), hour, minutes: hour * 60 + n('minute') };
      }

      // ডাক্তার যে যে দিন এই চেম্বারে বসেন (আজ থেকে ১৪ দিনের মধ্যে, সর্বোচ্চ ৮টি)
      function buildDateOptions(chamber) {
        const now = dhakaParts();
        const base = Date.UTC(now.y, now.m - 1, now.d);
        const opts = [];
        for (let i = 0; i < 14 && opts.length < 8; i++) {
          const dt = new Date(base + i * 86400000);
          const wd = dt.getUTCDay();
          const daySlots = chamber.slots.filter((s) => s.weekday === wd);
          if (!daySlots.length) continue;
          if (i === 0 && !daySlots.some((s) => toMin(s.end) > now.minutes)) continue;
          const rel = i === 0 ? 'আজ · ' : i === 1 ? 'আগামীকাল · ' : i === 2 ? 'পরশু · ' : '';
          opts.push({ value: dt.toISOString().slice(0, 10), text: `${rel}${WEEKDAY_FULL[wd]}, ${toBn(dt.getUTCDate())} ${MONTHS[dt.getUTCMonth()]}` });
        }
        return opts;
      }

      function normalizePhone(v) {
        let s = String(v || '').replace(/[০-৯]/g, (d) => String('০১২৩৪৫৬৭৮৯'.indexOf(d))).replace(/[\s\-]/g, '');
        s = s.replace(/^\+?88/, '');
        return /^01[3-9]\d{8}$/.test(s) ? s : null;
      }

      function showError(msg) {
        errorEl.textContent = msg || '';
        errorEl.style.display = msg ? 'block' : 'none';
      }

      function updateCount() {
        g('ddmCount').textContent = `${toBn(problemIn.value.length)} / ${toBn(300)}`;
      }

      function resetForm() {
        showError('');
        urgentBox.style.display = 'none';
        urgentAck = false;
        submitting = false;
        submitBtn.disabled = false;
        submitText.textContent = 'অনুরোধ পাঠান';
        problemIn.value = '';
        updateCount();
        g('ddmForm').style.display = 'block';
        g('ddmDone').style.display = 'none';
      }

      async function openSerial(chamberId) {
        const ch = sched.chambers.find((c) => c.id === chamberId);
        if (!ch) return;

        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          window.showToast('সিরিয়াল রিকোয়েস্ট করতে আগে লগইন করুন', 'error');
          window.openAuthModal?.('login');
          return;
        }

        currentChamber = ch;
        resetForm();
        g('ddmSub').textContent = `${sched.doctorName} · ${ch.name}`;

        const opts = buildDateOptions(ch);
        hasDates = opts.length > 0;
        dateSel.innerHTML = opts.map((o) => `<option value="${o.value}">${o.text}</option>`).join('');
        dateSel.style.display = hasDates ? 'block' : 'none';
        g('ddmNoDate').style.display = hasDates ? 'none' : 'block';
        submitBtn.disabled = !hasDates;

        ddmOverlay.classList.add('open');
        ddmOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        // নাম/ফোন আগে থেকে ভরে দেওয়া (সম্পাদনযোগ্য, ফাঁকা থাকলেই)
        if (!nameIn.value || !phoneIn.value) {
          const { data: prof } = await supabase.from('profiles').select('full_name, phone').eq('id', session.user.id).maybeSingle();
          if (prof) {
            if (!nameIn.value && prof.full_name) nameIn.value = prof.full_name;
            if (!phoneIn.value && prof.phone && normalizePhone(prof.phone)) phoneIn.value = normalizePhone(prof.phone);
          }
        }
      }

      function closeSerial() {
        ddmOverlay.classList.remove('open');
        ddmOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      const ERRORS = {
        login_required: 'আগে লগইন করুন',
        blocked: 'আপনার অ্যাকাউন্টে এই সুবিধা বন্ধ আছে',
        serial_not_available: 'এই চেম্বারে এখন অনলাইনে সিরিয়াল রিকোয়েস্ট নেওয়া হচ্ছে না। সরাসরি কল করে সিরিয়াল নিন।',
        invalid_name: 'রোগীর নাম ২ থেকে ৮০ অক্ষরের মধ্যে লিখুন',
        invalid_phone: 'সঠিক মোবাইল নম্বর দিন (যেমন: 01711XXXXXX)',
        invalid_problem: 'সমস্যা কমপক্ষে ৩ অক্ষর লিখুন',
        invalid_date: 'সঠিক দিন বেছে নিন',
        doctor_not_sitting: 'ওই দিন ডাক্তার এখানে বসেন না — অন্য দিন বেছে নিন',
        time_over: 'আজকের জন্য ডাক্তারের বসার সময় শেষ হয়ে গেছে — অন্য দিন বেছে নিন',
        daily_limit: 'আজ আপনি ৩টি সিরিয়াল রিকোয়েস্ট করে ফেলেছেন। কাল আবার চেষ্টা করুন বা সরাসরি কল করুন।',
        phone_limit: 'এই নম্বর থেকে আজ অনেক অনুরোধ হয়েছে। সরাসরি কল করুন।',
        duplicate_request: 'এই দিনের জন্য আপনার অনুরোধ আগেই জমা আছে — "আমার অর্ডার" পেজে অবস্থা দেখুন',
      };

      async function submitSerial() {
        if (submitting || !currentChamber) return;
        showError('');

        const name = nameIn.value.trim();
        const phone = normalizePhone(phoneIn.value);
        const problem = problemIn.value.trim();
        if (!hasDates || !dateSel.value) { showError('ডাক্তারের বসার দিন পাওয়া যায়নি'); return; }
        if (name.length < 2) { showError('রোগীর নাম লিখুন'); nameIn.focus(); return; }
        if (!phone) { showError('সঠিক মোবাইল নম্বর দিন (যেমন: 01711XXXXXX)'); phoneIn.focus(); return; }
        if (problem.length < 3) { showError('সমস্যা কমপক্ষে ৩ অক্ষর লিখুন'); problemIn.focus(); return; }

        // জরুরি লক্ষণ থাকলে আগে ৯৯৯ সতর্কতা; ইউজার চাইলে তবুও পাঠাতে পারবে
        if (isUrgent(problem) && !urgentAck) {
          urgentBox.style.display = 'block';
          urgentAck = true;
          submitText.textContent = 'তবুও অনুরোধ পাঠান';
          urgentBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        submitting = true;
        submitBtn.disabled = true;
        submitText.textContent = 'পাঠানো হচ্ছে...';

        const { data, error } = await supabase.rpc('submit_serial_request', {
          p_chamber: currentChamber.id,
          p_date: dateSel.value,
          p_name: name,
          p_phone: phone,
          p_problem: problem,
        });

        submitting = false;
        if (error) {
          const key = Object.keys(ERRORS).find((k) => (error.message || '').includes(k));
          showError(key ? ERRORS[key] : 'পাঠানো যায়নি, একটু পরে আবার চেষ্টা করুন');
          submitBtn.disabled = false;
          submitText.textContent = urgentAck ? 'তবুও অনুরোধ পাঠান' : 'অনুরোধ পাঠান';
          if (key === 'login_required') window.openAuthModal?.('login');
          return;
        }

        const hour = dhakaParts().hour;
        const offHours = hour < 9 || hour >= 21;
        g('ddmDoneText').textContent =
          `${sched.doctorName}-এর জন্য আপনার অনুরোধ ক্লিনিকে পাঠানো হয়েছে। প্রতিনিধি সিরিয়াল নিয়ে আপনাকে কল করে নম্বর জানাবেন।` +
          (offHours ? ' এখন রাত, তাই সকাল ৯টার পর কল পাবেন।' : '');
        g('ddmDoneLink').setAttribute('href', data ? `/my-orders?serial=${data}` : '/my-orders');
        g('ddmForm').style.display = 'none';
        g('ddmDone').style.display = 'block';
      }

      document.querySelectorAll('[data-serial-chamber]').forEach((btn) => {
        btn.addEventListener('click', () => openSerial(btn.dataset.serialChamber));
      });
      problemIn.addEventListener('input', () => { updateCount(); if (urgentAck) { urgentAck = false; urgentBox.style.display = 'none'; submitText.textContent = 'অনুরোধ পাঠান'; } });
      submitBtn.addEventListener('click', submitSerial);
      g('ddmClose').addEventListener('click', closeSerial);
      g('ddmDoneClose').addEventListener('click', closeSerial);
      ddmOverlay.addEventListener('click', (e) => { if (e.target === ddmOverlay) closeSerial(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && ddmOverlay.classList.contains('open')) closeSerial(); });

      // মোবাইলে কীবোর্ড খুললে শিটের উচ্চতা ঠিক রাখা
      if (window.visualViewport) {
        const vv = window.visualViewport;
        const sync = () => sheet.style.setProperty('--ddm-vh', vv.height + 'px');
        vv.addEventListener('resize', sync);
        sync();
      }
    }
  </script>
</BaseLayout>
