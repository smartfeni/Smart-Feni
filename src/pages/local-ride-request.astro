---
// path: src/pages/local-ride-request.astro
// ============================================================
// পেজ: /local-ride-request — যাত্রীর লোকাল রাইড রিকোয়েস্ট (Ride Hero স্টাইল, hero-ui)
//
// ফর্ম: পিকআপ (ম্যাপ বা লিখে) + পিকআপ এলাকা (উপজেলা + ইউনিয়ন, ম্যাপ থেকে অটো বসে — বাধ্যতামূলক),
//       গন্তব্য, গাড়ির ধরন (দুই গ্রুপ: ইউনিয়নভিত্তিক / উপজেলাভিত্তিক; একাধিক টিক, কমপক্ষে ১),
//       যাত্রী সংখ্যা, ভাড়া (+/− ও +৫/+১০/+২০; সাজেস্টেড শুধু ডিফল্ট), নোট (ঐচ্ছিক)।
// সতর্কতা: পিকআপ এলাকা + গাড়ির ধরনে এখন কোনো ড্রাইভার অনলাইন না থাকলে নোটিশ দেখায়, সাবমিট আটকায় না
//          (RPC local_ride_availability)।
// সাবমিট: RPC local_ride_create (সার্ভারে auth.uid(), ৩০ মিনিটে এক্সপায়ার, সর্বোচ্চ ২টা চালু)।
// সফল হলে /my-orders-এ যায় (চলমান ট্যাবে অফার/কনফার্ম দেখা যায়)।
// ইউজার/ডিবির টেক্সট সব textContent দিয়ে বসানো (innerHTML নয়)।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import GuideSheet from '../components/delivery/GuideSheet.astro';
import LocationPicker from '../components/delivery/LocationPicker.astro';
import '../styles/hero-ui.css';

const guideSteps = [
  {
    caption: 'কোথা থেকে উঠবেন আর কোথায় যাবেন দিন',
    blocks: [
      { kind: 'field', text: 'পিকআপ: ধলিয়া বাজার', tap: '১' },
      { kind: 'field', text: 'গন্তব্য: ফেনী কলেজ', tap: '২' },
      { kind: 'notice', text: 'পিকআপের এলাকার ড্রাইভাররাই রিকোয়েস্ট দেখবে।' },
    ],
  },
  {
    caption: 'গাড়ির ধরন (একাধিক বাছতে পারবেন), যাত্রী আর ভাড়া দিন',
    blocks: [
      { kind: 'button', text: 'সিএনজি', primary: true, tap: true },
      { kind: 'button', text: 'অটোরিক্সা' },
      { kind: 'field', text: 'ভাড়া ৳১২০' },
    ],
  },
  {
    caption: 'রিকোয়েস্ট পাঠান, ড্রাইভার রাজি হলে ট্রিপ কনফার্ম',
    blocks: [
      { kind: 'spacer' },
      { kind: 'cta', text: 'রিকোয়েস্ট পাঠান', tap: true },
      { kind: 'notice', text: '৩০ মিনিটে কেউ রাজি না হলে রিকোয়েস্ট বাতিল হয়ে যাবে।' },
    ],
  },
];
---

<BaseLayout title="রাইড চাই | স্মার্ট ফেনী">
  <div class="lq-top-bar">
    <div class="container lq-top-bar-inner">
      <a href="/services/local-ride" class="lq-back-link" aria-label="পেছনে যান"><i class="fas fa-arrow-left"></i></a>
      <div class="lq-top-right">
        <a href="/my-orders" class="lq-orders-btn"><i class="fas fa-receipt"></i> আমার অর্ডার</a>
        <GuideSheet id="local-ride-request" title="রাইড কীভাবে চাইবেন" subtitle="লোকাল রাইড" showButton buttonTone="light" steps={guideSteps} />
      </div>
    </div>
  </div>

  <section class="hu-form-section">
    <div class="container">

      <div id="lqLoading" class="lq-state">
        <div class="lq-spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="lqLogin" class="hu-formcard lq-state-card" style="display:none;">
        <div class="hu-formhead">
          <span class="hu-formicon"><i class="fas fa-lock"></i></span>
          <h2 class="hu-title">লগইন করুন</h2>
        </div>
        <p class="hu-sub">রাইড চাইতে আগে লগইন করতে হবে</p>
        <button type="button" class="hu-submit" id="lqLoginBtn">লগইন করুন</button>
      </div>

      <div class="hu-formcard" id="lqCard" style="display:none;">
        <div class="hu-formhead">
          <span class="hu-formicon"><i class="fas fa-van-shuttle"></i></span>
          <h2 class="hu-title">লোকাল রাইড</h2>
        </div>
        <p class="hu-sub">দাম বলুন, এলাকার ড্রাইভাররা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

        <div class="lq-warn" id="lqWarn" style="display:none;" role="status">
          <i class="fas fa-triangle-exclamation"></i>
          <span>এই মুহূর্তে এই এলাকায় এই গাড়ির কোনো ড্রাইভার অনলাইনে নেই। রিকোয়েস্ট পাঠাতে পারবেন, ড্রাইভার অনলাইনে এলে জানতে পারবেন।</span>
        </div>

        <form id="lqForm" class="hu-form" novalidate>

          <div class="hu-route">
            <div class="hu-route-card">
              <LocationPicker id="lrpickup" label="পিকআপ লোকেশন (আপনি কোথায় আছেন)" allowAutoLocate={true} placeholder="যেমন: ধলিয়া বাজার" />
            </div>
            <div class="hu-route-card drop">
              <LocationPicker id="lrdrop" label="কোথায় যেতে চান (গন্তব্য)" allowAutoLocate={false} placeholder="যেমন: ফেনী কলেজ" />
              <p class="lq-hint lq-drop-area" id="lqDropArea" style="display:none;"></p>
            </div>
          </div>

          <div class="hu-field">
            <label for="lqPUpazila">পিকআপ এলাকা<span class="required-mark">*</span></label>
            <p class="lq-hint" id="lqPickupHint">ম্যাপে পিন বসালে এলাকা নিজে বসে যাবে, না হলে নিচ থেকে বেছে নিন।</p>
            <div class="lq-two">
              <select id="lqPUpazila" aria-label="পিকআপ উপজেলা">
                <option value="">উপজেলা</option>
              </select>
              <select id="lqPUnion" aria-label="পিকআপ ইউনিয়ন">
                <option value="">ইউনিয়ন</option>
              </select>
            </div>
            <div class="field-error-msg" data-error-for="lqPUnion"><i class="fas fa-circle-exclamation"></i><span>পিকআপের উপজেলা ও ইউনিয়ন বেছে নিন</span></div>
          </div>

          <div class="hu-field">
            <label>গাড়ির ধরন<span class="required-mark">*</span> <span class="lq-sub-l">(একাধিক বাছতে পারবেন)</span></label>
            <div id="lqTypes" role="group" aria-label="গাড়ির ধরন"></div>
            <div class="field-error-msg" data-error-for="lqTypes"><i class="fas fa-circle-exclamation"></i><span>কমপক্ষে ১টা গাড়ির ধরন বেছে নিন</span></div>
          </div>

          <div class="hu-field">
            <label>যাত্রী সংখ্যা</label>
            <div class="hu-stepper">
              <button type="button" id="lqMinus" aria-label="কমান">−</button>
              <span class="lq-paxval" id="lqPax" aria-live="polite">১</span>
              <button type="button" id="lqPlus" aria-label="বাড়ান">+</button>
            </div>
          </div>

          <div class="hu-field">
            <label for="lqFare">আপনার প্রস্তাবিত ভাড়া<span class="required-mark">*</span></label>
            <div class="hu-stepper">
              <button type="button" data-fare-step="-10" aria-label="১০ টাকা কমান">−</button>
              <span class="hu-cur">৳</span>
              <input type="number" id="lqFare" inputmode="numeric" min="1" max="100000" placeholder="যেমন: ১২০" required />
              <button type="button" data-fare-step="10" aria-label="১০ টাকা বাড়ান">+</button>
            </div>
            <div class="hu-quick">
              <button type="button" data-fare-step="5">+৫</button>
              <button type="button" data-fare-step="10">+১০</button>
              <button type="button" data-fare-step="20">+২০</button>
            </div>
            <div class="field-error-msg" data-error-for="lqFare"><i class="fas fa-circle-exclamation"></i><span>ভাড়া লিখুন</span></div>
            <div id="lqSuggest" class="lq-suggest" style="display:none;">
              <span id="lqSuggestTxt"></span>
              <button type="button" class="lq-use" id="lqSuggestUse">এটা ব্যবহার করুন</button>
            </div>
            <p class="lq-hint">আপনার ভাড়ায় যে ড্রাইভার রাজি হবে, ট্রিপ তার সাথেই কনফার্ম। কেউ অন্য দামও বলতে পারে।</p>
          </div>

          <div class="hu-field">
            <label for="lqNote">অতিরিক্ত মন্তব্য <span>(ঐচ্ছিক)</span></label>
            <input id="lqNote" maxlength="200" placeholder="যেমন: সাথে ২টা ব্যাগ আছে" autocomplete="off" />
          </div>

          <button type="submit" class="hu-submit" id="lqSubmit"><i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান</button>
        </form>
      </div>

    </div>
  </section>

  <style is:global>
    .lq-top-bar { background: #fff; padding: 14px 0 4px; }
    .lq-top-bar-inner { display: flex; align-items: center; justify-content: space-between; }
    .lq-top-right { display: flex; align-items: center; gap: 8px; }
    .lq-back-link { color: #5A6E85; font-size: 1.1rem; text-decoration: none; }
    .lq-orders-btn { display: inline-flex; align-items: center; gap: 6px; background: #F8FAFC; border: 1px solid #EEF3F9; color: #5A6E85; padding: 6px 14px; border-radius: 40px; font-size: 0.72rem; font-weight: 700; text-decoration: none; }
    .lq-state { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 70px 10px; text-align: center; color: #5B6B86; font-weight: 600; }
    .lq-spinner { width: 36px; height: 36px; border: 3px solid #E3E8F0; border-top-color: #FF6B35; border-radius: 50%; animation: lqSpin .8s linear infinite; }
    @keyframes lqSpin { to { transform: rotate(360deg); } }
    .lq-hint { margin: 2px 0 8px; font-size: 12.5px; line-height: 1.5; color: #5B6B86; }
    .lq-sub-l { font-weight: 500; color: #8696AE; }
    .lq-two { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .lq-paxval { flex: 1; text-align: center; font-size: 1.25rem; font-weight: 800; color: #1B2A4A; }
    .lq-group { margin: 0 0 12px; }
    .lq-group-title { display: block; margin: 0 0 6px; font-size: 12.5px; font-weight: 700; color: #5B6B86; }
    .lq-group-title small { font-weight: 500; color: #8696AE; }
    .lq-warn { display: flex; gap: 10px; align-items: flex-start; background: #FFF4E5; border: 1px solid #FFD8A8; color: #5E3000; border-radius: 14px; padding: 10px 12px; margin: 0 0 12px; font-size: 13px; line-height: 1.5; font-weight: 600; }
    .lq-warn i { margin-top: 3px; color: #D9822B; }
    .lq-suggest { margin-top: 8px; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #FFF6F1; border-radius: 14px; padding: 8px 12px; font-size: 13.5px; font-weight: 600; }
    .lq-use { min-height: 40px; border: 0; border-radius: 12px; background: #FF6B35; color: #fff; font-weight: 700; font-size: 13px; padding: 0 12px; cursor: pointer; font-family: inherit; flex: none; }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { fetchDeliveryFare } from '../lib/fareCalc.js';

    const $ = (id) => document.getElementById(id);
    const BN = '০১২৩৪৫৬৭৮৯';
    const bn = (n) => String(n).replace(/\d/g, (d) => BN[d]);

    let types = [];
    let areas = [];
    let pickedTypes = [];
    let pax = 1;
    // লোকেশন স্টেট (পিকার ইভেন্ট থেকে)
    const loc = {
      lrpickup: { lat: null, lng: null, source: 'manual', union: '', upazila: '' },
      lrdrop: { lat: null, lng: null, source: 'manual', union: '', upazila: '' },
    };
    let suggestFare = null;
    let suggestTimer = null;
    let availTimer = null;
    let availSeq = 0;
    let submitting = false;

    function toast(msg, type) {
      if (typeof window.showToast === 'function') window.showToast(msg, type || 'error');
    }
    function el(tag, cls, text) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }
    function setErr(forId, on) {
      const m = document.querySelector('[data-error-for="' + forId + '"]');
      if (m) m.classList.toggle('show', !!on);
    }
    function show(id) {
      $('lqLoading').style.display = id === 'lqLoading' ? '' : 'none';
      $('lqLogin').style.display = id === 'lqLogin' ? '' : 'none';
      $('lqCard').style.display = id === 'lqForm' ? '' : 'none';
    }
    function wrapOf(id) { return document.querySelector('[data-lp-id="' + id + '"]'); }
    function addrText(id) {
      const w = wrapOf(id);
      const v = w && w.querySelector('.lp-address-input');
      return v ? String(v.value || '').trim() : '';
    }
    function instrText(id) {
      const w = wrapOf(id);
      const v = w && w.querySelector('.lp-instructions-input');
      return v ? String(v.value || '').trim() : '';
    }
    function findArea(upazila, union) {
      if (!union) return null;
      return areas.find((a) => a.name_bn === union && (!upazila || a.upazila === upazila)) || areas.find((a) => a.name_bn === union) || null;
    }

    const ERR = {
      AUTH_REQUIRED: 'আগে লগইন করুন',
      PICKUP_AREA_REQUIRED: 'পিকআপের ইউনিয়ন বেছে নিন',
      DROP_AREA_INVALID: 'গন্তব্যের এলাকা ঠিক নেই, আবার বসান',
      DROP_REQUIRED: 'গন্তব্য দিন (ম্যাপে বা লিখে)',
      VEHICLE_TYPE_REQUIRED: 'কমপক্ষে ১টা গাড়ির ধরন বেছে নিন',
      FARE_INVALID: 'ভাড়া ঠিকভাবে লিখুন',
      PASSENGERS_INVALID: 'যাত্রী সংখ্যা ঠিক নেই',
      TOO_MANY_OPEN: 'আপনার ২টা রিকোয়েস্ট এখনো চালু আছে, আগে সেগুলো শেষ করুন বা বাতিল করুন',
      SERVICE_PAUSED: 'লোকাল রাইড এখন সাময়িক বন্ধ আছে, একটু পরে চেষ্টা করুন',
    };
    function errText(error) {
      const m = String((error && error.message) || '');
      const k = Object.keys(ERR).find((key) => m.includes(key));
      return k ? ERR[k] : 'রিকোয়েস্ট পাঠানো যায়নি, আবার চেষ্টা করুন';
    }

    // ===== পিকআপ ইউনিয়ন সিলেক্ট =====
    function fillUpazilas() {
      const sel = $('lqPUpazila');
      const seen = [];
      areas.forEach((a) => { if (a.upazila && !seen.includes(a.upazila)) seen.push(a.upazila); });
      seen.forEach((u) => { const o = document.createElement('option'); o.value = u; o.textContent = u; sel.appendChild(o); });
    }
    function fillUnions(upazila, selectedId) {
      const sel = $('lqPUnion');
      sel.textContent = '';
      const first = document.createElement('option');
      first.value = '';
      first.textContent = 'ইউনিয়ন';
      sel.appendChild(first);
      areas.filter((a) => a.upazila === upazila).forEach((a) => {
        const o = document.createElement('option');
        o.value = a.id;
        o.textContent = a.name_bn;
        if (a.id === selectedId) o.selected = true;
        sel.appendChild(o);
      });
    }

    // ===== গাড়ির ধরন (দুই গ্রুপ) =====
    function renderGroup(box, list, title, sub) {
      if (!list.length) return;
      const g = el('div', 'lq-group');
      const t = el('span', 'lq-group-title', title + ' ');
      t.appendChild(el('small', null, sub));
      g.appendChild(t);
      const chips = el('div', 'hu-chips');
      list.forEach((ty) => {
        const on = pickedTypes.includes(ty.id);
        const b = el('button', 'hu-chip' + (on ? ' active' : ''), ty.name_bn);
        b.type = 'button';
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.addEventListener('click', () => {
          const i = pickedTypes.indexOf(ty.id);
          if (i >= 0) pickedTypes.splice(i, 1); else pickedTypes.push(ty.id);
          setErr('lqTypes', false);
          renderTypes();
          scheduleAvail();
        });
        chips.appendChild(b);
      });
      g.appendChild(chips);
      box.appendChild(g);
    }
    function renderTypes() {
      const box = $('lqTypes');
      box.textContent = '';
      renderGroup(box, types.filter((t) => t.area_scope !== 'upazila'), 'নিজের ইউনিয়নের গাড়ি', '(পিকআপের ইউনিয়নের ড্রাইভার)');
      renderGroup(box, types.filter((t) => t.area_scope === 'upazila'), 'উপজেলাভিত্তিক গাড়ি', '(পুরো উপজেলার ড্রাইভার)');
    }

    // ===== ড্রাইভার অনলাইন আছে কিনা (শুধু সতর্কতা, আটকায় না) =====
    function scheduleAvail() {
      clearTimeout(availTimer);
      availTimer = setTimeout(runAvail, 400);
    }
    async function runAvail() {
      const warn = $('lqWarn');
      const areaId = $('lqPUnion').value;
      if (!areaId || !pickedTypes.length) { warn.style.display = 'none'; return; }
      const seq = ++availSeq;
      try {
        const { data, error } = await supabase.rpc('local_ride_availability', { p_pickup_area_id: areaId, p_vehicle_type_ids: pickedTypes });
        if (seq !== availSeq) return;
        warn.style.display = (!error && data && data.online === false) ? '' : 'none';
      } catch (_) {
        if (seq === availSeq) warn.style.display = 'none';
      }
    }

    // ===== সাজেস্টেড ভাড়া (ডেলিভারি fare settings, শুধু ডিফল্ট) =====
    function scheduleSuggest() {
      clearTimeout(suggestTimer);
      suggestTimer = setTimeout(runSuggest, 500);
    }
    async function runSuggest() {
      const p = loc.lrpickup, d = loc.lrdrop;
      const box = $('lqSuggest');
      if (p.lat == null || p.lng == null || d.lat == null || d.lng == null) { box.style.display = 'none'; suggestFare = null; return; }
      const r = await fetchDeliveryFare({ pickup: { lat: p.lat, lng: p.lng }, drop: { lat: d.lat, lng: d.lng }, dropUnion: d.union || null });
      if (!r || !r.enabled || !r.fare) { box.style.display = 'none'; suggestFare = null; return; }
      suggestFare = Math.round(r.fare);
      $('lqSuggestTxt').textContent = 'প্রস্তাবিত ভাড়া ৳' + bn(suggestFare) + (r.km ? ' · প্রায় ' + bn(Math.round(r.km * 10) / 10) + ' কিমি' : '');
      box.style.display = '';
      const f = $('lqFare');
      if (!f.value) f.value = String(suggestFare);
    }

    // ===== পিকার ইভেন্ট =====
    document.addEventListener('lp:location-changed', (e) => {
      const d = (e && e.detail) || {};
      if (d.id !== 'lrpickup' && d.id !== 'lrdrop') return;
      const s = loc[d.id];
      if (d.cleared) {
        s.lat = null; s.lng = null; s.source = 'manual'; s.union = ''; s.upazila = '';
      } else {
        const ok = typeof d.lat === 'number' && typeof d.lng === 'number' && !isNaN(d.lat) && !isNaN(d.lng);
        s.lat = ok ? d.lat : null;
        s.lng = ok ? d.lng : null;
        s.source = ok ? 'map' : 'manual';
        s.union = d.union || '';
        s.upazila = d.upazila || '';
      }
      if (d.id === 'lrpickup') {
        const a = findArea(s.upazila, s.union);
        if (a) {
          $('lqPUpazila').value = a.upazila;
          fillUnions(a.upazila, a.id);
          setErr('lqPUnion', false);
          $('lqPickupHint').textContent = 'পিন থেকে পাওয়া এলাকা: ' + a.name_bn + ' (' + a.upazila + ')। ভুল হলে নিচ থেকে বদলান।';
          scheduleAvail();
        }
      } else {
        const a = findArea(s.upazila, s.union);
        const line = $('lqDropArea');
        if (a) { line.textContent = 'গন্তব্যের এলাকা: ' + a.name_bn + ' (' + a.upazila + ')'; line.style.display = ''; }
        else { line.style.display = 'none'; }
      }
      scheduleSuggest();
    });

    // ===== সাবমিট =====
    async function submitForm(e) {
      e.preventDefault();
      if (submitting) return;
      const form = $('lqForm');
      let ok = typeof window.SFValidateForm === 'function' ? window.SFValidateForm(form) : true;

      const pickupAreaId = $('lqPUnion').value;
      if (!pickupAreaId) { setErr('lqPUnion', true); ok = false; }
      if (!pickedTypes.length) { setErr('lqTypes', true); ok = false; }
      const fare = Math.round(Number($('lqFare').value));
      if (!fare || fare < 1 || fare > 100000) { setErr('lqFare', true); ok = false; }

      const p = loc.lrpickup, d = loc.lrdrop;
      const pickupText = addrText('lrpickup');
      const dropText = addrText('lrdrop');
      if (!pickupText && p.lat == null) ok = false;
      if (!dropText && d.lat == null) ok = false;
      if (!ok) { toast('সব তথ্য ঠিকভাবে দিন'); return; }

      const dropArea = findArea(d.upazila, d.union);
      const extra = [];
      const pi = instrText('lrpickup');
      const di = instrText('lrdrop');
      if (pi) extra.push('পিকআপ: ' + pi);
      if (di) extra.push('ড্রপ: ' + di);
      const userNote = $('lqNote').value.trim();
      if (userNote) extra.push(userNote);

      const btn = $('lqSubmit');
      submitting = true;
      btn.disabled = true;
      btn.textContent = 'পাঠানো হচ্ছে...';
      try {
        const { error } = await supabase.rpc('local_ride_create', {
          p_pickup_area_id: pickupAreaId,
          p_pickup_text: pickupText || null,
          p_pickup_lat: p.lat,
          p_pickup_lng: p.lng,
          p_pickup_loc_source: p.lat != null ? 'map' : 'manual',
          p_drop_area_id: dropArea ? dropArea.id : null,
          p_drop_text: dropText || null,
          p_drop_lat: d.lat,
          p_drop_lng: d.lng,
          p_drop_loc_source: d.lat != null ? 'map' : 'manual',
          p_vehicle_type_ids: pickedTypes,
          p_passengers: pax,
          p_fare: fare,
          p_note: extra.length ? extra.join(' | ') : null,
        });
        if (error) {
          toast(errText(error));
          if (String(error.message || '').includes('TOO_MANY_OPEN')) setTimeout(() => { window.location.href = '/my-orders'; }, 1800);
          else if (window.SFReportError && !/PICKUP_AREA|DROP_|VEHICLE_|FARE_|PASSENGERS_|AUTH_|SERVICE_PAUSED/.test(String(error.message || ''))) {
            window.SFReportError({ kind: 'api_fail', action: 'local_ride_create', title: 'লোকাল রাইড রিকোয়েস্ট ব্যর্থ', message: String(error.message || '') });
          }
          return;
        }
        toast('রিকোয়েস্ট পাঠানো হয়েছে ✓', 'success');
        window.location.href = '/my-orders';
      } catch (_) {
        toast('সমস্যা হয়েছে, আবার চেষ্টা করুন');
      } finally {
        submitting = false;
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';
      }
    }

    // ===== শুরু =====
    async function init() {
      show('lqLoading');
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { show('lqLogin'); return; }
      const [t, a] = await Promise.all([
        supabase.from('local_ride_vehicle_types').select('id, name_bn, area_scope').eq('is_active', true).order('sort_order'),
        supabase.from('local_areas').select('id, name_bn, upazila').eq('is_active', true).order('sort_order'),
      ]);
      if (t.error || a.error) { toast('তথ্য লোড করা যায়নি, আবার চেষ্টা করুন'); show('lqLogin'); return; }
      types = t.data || [];
      areas = a.data || [];
      fillUpazilas();
      renderTypes();
      show('lqForm');
    }

    $('lqLoginBtn').addEventListener('click', () => { if (window.openAuthModal) window.openAuthModal('login'); });
    $('lqPUpazila').addEventListener('change', () => { fillUnions($('lqPUpazila').value, null); setErr('lqPUnion', false); scheduleAvail(); });
    $('lqPUnion').addEventListener('change', () => { setErr('lqPUnion', false); scheduleAvail(); });
    $('lqFare').addEventListener('input', () => setErr('lqFare', false));
    $('lqMinus').addEventListener('click', () => { if (pax > 1) { pax--; $('lqPax').textContent = bn(pax); } });
    $('lqPlus').addEventListener('click', () => { if (pax < 20) { pax++; $('lqPax').textContent = bn(pax); } });
    document.querySelectorAll('[data-fare-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cur = Number($('lqFare').value) || 0;
        $('lqFare').value = String(Math.max(1, cur + Number(btn.dataset.fareStep)));
        setErr('lqFare', false);
      });
    });
    $('lqSuggestUse').addEventListener('click', () => { if (suggestFare) { $('lqFare').value = String(suggestFare); setErr('lqFare', false); } });
    $('lqForm').addEventListener('submit', submitForm);
    init();
  </script>
</BaseLayout>
