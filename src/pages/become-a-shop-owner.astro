    function stepPay(body) {
      body.appendChild(head(4, 'যোগাযোগ ও টাকা পাওয়ার নম্বর'));
      const c = mk('section', 'sa-card');
      const ph = inp('tel', 'phone', '01XXXXXXXXX', 14); ph.inputMode = 'tel';
      c.appendChild(field('দোকানের মোবাইল নম্বর', ph, true, 'কাস্টমার ও রাইডার এই নম্বরে কল করবে'));
      const seg = mk('div', 'sa-seg');
      [['bkash', 'বিকাশ'], ['nagad', 'নগদ']].forEach(([v, l]) => {
        const b = mk('button', ''); b.type = 'button'; b.setAttribute('aria-pressed', String(f.payout_method === v));
        const im = mk('img'); im.src = '/market/pay/' + v + '.webp'; im.alt = ''; im.setAttribute('aria-hidden', 'true'); b.appendChild(im);
        b.appendChild(document.createTextNode(l));
        b.addEventListener('click', () => { f.payout_method = v; seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); });
        seg.appendChild(b);
      });
      c.appendChild(field('পাওনা নেওয়ার মাধ্যম', seg, true));
      const pn = inp('tel', 'payout_number', '01XXXXXXXXX', 14); pn.inputMode = 'tel';
      c.appendChild(field('বিকাশ/নগদ নম্বর', pn, true, 'কুইক ডেলিভারির অর্ডারের পণ্যের টাকা স্মার্ট ফেনী এই নম্বরে পাঠাবে'));
      body.appendChild(c);
      const c2 = mk('section', 'sa-card');
      const t = mk('div', 'sa-terms');
      t.appendChild(mk('b', '', 'শর্ত'));
      const ul = mk('ul');
      ['মেনুর দাম দোকানের দামের সমান বা কম রাখবেন।', 'অর্ডার এলে দ্রুত সাড়া দেবেন; না পারলে দোকান "বন্ধ" করে রাখবেন।', 'রাইডার দিয়ে যাওয়া অর্ডারের পণ্যের টাকা স্মার্ট ফেনী হিসাব করে পরিশোধ করবে; প্রযোজ্য হলে কমিশন কাটা হবে।', 'ভুল তথ্য বা বারবার অর্ডার বাতিলে দোকান বন্ধ করা হতে পারে।'].forEach((x) => ul.appendChild(mk('li', '', x)));
      t.appendChild(ul);
      c2.appendChild(t);
      const ck = mk('label', 'sa-check');
      const cb = mk('input'); cb.type = 'checkbox'; cb.checked = !!f.agreed; cb.addEventListener('change', () => { f.agreed = cb.checked; });
      ck.appendChild(cb); ck.appendChild(mk('span', '', 'আমি শর্তগুলো পড়েছি এবং রাজি'));
      c2.appendChild(ck);
      body.appendChild(c2);
    }

    function payload() {
      return { ...f, lat: f.lat === '' ? null : f.lat, lng: f.lng === '' ? null : f.lng, items: f.items.filter((x) => String(x.name || '').trim()) };
    }

    async function save(submit) {
      const { data, error } = await supabase.rpc('market_shop_app_save', { p: payload(), p_submit: !!submit });
      if (error) { toast('সেভ হয়নি, ইন্টারনেট দেখে আবার চেষ্টা করুন', 'error'); return null; }
      return data;
    }

    function showErr(reason) {
      if (reason === 'pending') { showPending(); return; }
      const e = ERR[reason] || ['কিছু তথ্য বাকি আছে', step];
      step = e[1]; render();
      const box = mk('div', 'sa-err', '⚠️ ' + e[0]);
      // বডি ফাঁকা থাকলে firstChild null — আগে এখানে ক্র্যাশ হতো (null.nextSibling)
      const sb = $('saBody');
      sb.insertBefore(box, sb.firstChild ? sb.firstChild.nextSibling : null);
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // প্রতি ধাপে বাধ্যতামূলক ঘর যাচাই (শেষ ধাপে গিয়ে ফেরত পাঠানোর বদলে এখানেই আটকানো)
    const BDP = /^01[3-9][0-9]{8}$/;
    function cleanPhone(v) { let d = String(v || '').replace(/[০-৯]/g, (x) => '০১২৩৪৫৬৭৮৯'.indexOf(x)).replace(/[^0-9]/g, ''); if (d.indexOf('880') === 0) d = d.slice(2); return d; }
    function stepErr(n) {
      if (n === 0) {
        if (String(f.name || '').trim().length < 3) return 'দোকানের নাম দিন (৩ অক্ষরের বেশি)';
        if (!f.logo_url) return 'লোগো ছবি দিন';
        if (!f.suggested_category_ids.length) return 'কী বিক্রি করেন — অন্তত ১টা ক্যাটাগরি বাছুন';
      }
      if (n === 1) {
        if (f.lat === null || f.lat === '' || f.lng === null || f.lng === '') return 'ম্যাপে দোকানের পিন বসান';
        if (!f.upazila) return 'ম্যাপে পিন বসান (উপজেলা পাওয়া যায়নি)';
        if (String(f.address || '').trim().length < 3) return 'লিখিত ঠিকানা দিন';
      }
      if (n === 2) {
        if (!f.opens_at || !f.closes_at) return 'দোকান খোলা ও বন্ধের সময় দিন';
      }
      if (n === 3) {
        const ok = f.items.filter((x) => String(x.name || '').trim() && Number(x.price) > 0).length;
        if (ok < 3) return 'নাম ও দামসহ অন্তত ৩টা পণ্য দিন (এখন ' + BN(ok) + 'টা)';
      }
      if (n === 4) {
        if (!BDP.test(cleanPhone(f.phone))) return 'দোকানের সঠিক মোবাইল নম্বর দিন (01XXXXXXXXX)';
        if (!BDP.test(cleanPhone(f.payout_number))) return 'পাওনা নেওয়ার সঠিক বিকাশ/নগদ নম্বর দিন';
        if (!f.agreed) return 'শর্তে সম্মতি দিন';
      }
      return '';
    }
    function stepBlock(msg) {
      const old = $('saStepErr'); if (old) old.remove();
      const box = mk('div', 'sa-err', '⚠️ ' + msg); box.id = 'saStepErr'; box.setAttribute('role', 'alert');
      const body = $('saBody');
      body.insertBefore(box, body.firstChild ? body.firstChild.nextSibling : null);
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function renderProg(n) {
      const p = $('saProg'); p.textContent = '';
      for (let i = 0; i < STEPS.length; i++) p.appendChild(mk('i', i <= n ? 'on' : ''));
    }

    function render() {
      const body = $('saBody');
      body.textContent = '';
      renderProg(step);
      [stepShop, stepLocation, stepDelivery, stepMenu, stepPay][step](body);
      $('saFoot').hidden = false;
      $('saPrev').style.visibility = step === 0 ? 'hidden' : '';
      $('saNext').textContent = busy ? 'সেভ হচ্ছে…' : step === STEPS.length - 1 ? 'আবেদন জমা দিন' : 'পরের ধাপ';
      $('saNext').disabled = busy;
    }

    function stateCard(img, title, text, btn) {
      $('saFoot').hidden = true;
      renderProg(STEPS.length - 1);
      const body = $('saBody'); body.textContent = '';
      const c = mk('section', 'sa-state');
      const im = mk('img'); im.src = IC + img + '.webp'; im.alt = ''; im.setAttribute('aria-hidden', 'true'); c.appendChild(im);
      c.appendChild(mk('h2', '', title)); c.appendChild(mk('p', '', text));
      if (btn) { const a = mk(btn.href ? 'a' : 'button', 'sa-btn' + (btn.ghost ? ' ghost' : ''), btn.t); if (btn.href) a.href = btn.href; else { a.type = 'button'; a.addEventListener('click', btn.fn); } c.appendChild(a); }
      body.appendChild(c);
    }

    function showPending() {
      stateCard('bags', 'আবেদন পর্যালোচনাধীন', '"' + ((app && app.name) || f.name || '') + '" — স্মার্ট ফেনী টিম দেখছে। অনুমোদন হলে নোটিফিকেশন পাবেন।', { t: 'হোমে যান', href: '/', ghost: true });
    }

    function welcome() {
      $('saFoot').hidden = true;
      const body = $('saBody'); body.textContent = '';
      const c = mk('section', 'sa-state');
      const im = mk('img'); im.src = IC + 'scooter.webp'; im.alt = ''; im.setAttribute('aria-hidden', 'true'); c.appendChild(im);
      c.appendChild(mk('h2', '', 'ফেনীর হাজারো কাস্টমারের কাছে পৌঁছান'));
      c.appendChild(mk('p', '', '৫টা ছোট ধাপে আবেদন করুন। অনুমোদন হলেই আপনার দোকান কুইক ডেলিভারিতে লাইভ, অর্ডার আসবে Smart Feni Pro অ্যাপে।'));
      body.appendChild(c);
      const perks = mk('div', 'sa-perks');
      [['scooter', 'রাইডার আমাদের'], ['bags', 'অর্ডার ম্যানেজ সহজ'], ['grocery', 'সব ক্যাটাগরি']].forEach(([i, t]) => {
        const p = mk('div', 'sa-perk'); const x = mk('img'); x.src = IC + i + '.webp'; x.alt = ''; x.setAttribute('aria-hidden', 'true'); p.appendChild(x); p.appendChild(document.createTextNode(t)); perks.appendChild(p);
      });
      body.appendChild(perks);
      const go = mk('button', 'sa-btn', 'আবেদন শুরু করুন'); go.type = 'button'; go.style.minHeight = '54px';
      go.addEventListener('click', () => { step = 0; render(); });
      body.appendChild(go);
    }

    $('saPrev').addEventListener('click', async () => { if (busy || step === 0) return; busy = true; render(); const sv = await save(false); busy = false; if (sv && sv.ok === false && sv.reason === 'pending') { showPending(); return; } step--; render(); window.scrollTo(0, 0); });
    $('saNext').addEventListener('click', async () => {
      if (busy) return;
      const se = stepErr(step);
      if (se) { stepBlock(se); return; }
      busy = true; render();
      if (step < STEPS.length - 1) {
        const sv = await save(false);
        busy = false;
        if (sv && sv.ok === false && sv.reason === 'pending') { showPending(); return; }
        step++; render(); window.scrollTo(0, 0);
        return;
      }
      const out = await save(true);
      busy = false;
      if (!out) { render(); return; }
      if (!out.ok) { showErr(out.reason); return; }
      stateCard('bags', 'আবেদন জমা হয়েছে! 🎉', 'স্মার্ট ফেনী টিম আপনার আবেদন দেখছে। অনুমোদন হলেই নোটিফিকেশন পাবেন, আর দোকান কুইক ডেলিভারিতে লাইভ হবে।', { t: 'হোমে যান', href: '/' });
    });

    async function init() {
      if (window.SFLoader) $('saBody').innerHTML = window.SFLoader.block('লোড হচ্ছে…');
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        stateCard('bags', 'আগে লগইন করুন', 'দোকান খোলার আবেদন করতে আপনার অ্যাকাউন্টে লগইন করুন।', { t: 'লগইন করুন', fn: () => { if (window.openAuthModal) window.openAuthModal(); } });
        return;
      }
      uid = session.user.id;
      const [c, a, p] = await Promise.all([
        supabase.from('delivery_market_categories').select('id, slug, name, icon, sort_order, is_active').eq('is_active', true).order('sort_order'),
        supabase.from('market_shop_applications').select('*').eq('applicant_id', uid).order('updated_at', { ascending: false }).limit(10),
        supabase.from('profiles').select('phone').eq('id', uid).maybeSingle(),
      ]);
      cats = (c.data || []);
      // খোলা আবেদন (pending → draft/rejected) আগে, নইলে সর্বশেষটা
      const rows = a.data || [];
      app = rows.find((x) => x.status === 'pending') || rows.find((x) => x.status === 'draft' || x.status === 'rejected') || rows[0];
      if (p.data && p.data.phone && !f.phone) f.phone = p.data.phone;
      if (app && app.status === 'pending') { showPending(); return; }
      if (app && app.status === 'approved') {
        stateCard('scooter', 'আপনার দোকান লাইভ! 🎉', '"' + (app.name || '') + '" কুইক ডেলিভারিতে চলছে। অর্ডার ও মেনু Smart Feni Pro অ্যাপে। আরেকটা দোকানের জন্য নতুন আবেদন করতে পারেন।', { t: 'নতুন দোকানের আবেদন', fn: () => { app = null; step = 0; render(); } });
        return;
      }
      if (app) {
        fromRow(app);
        while (f.items.length < 3) f.items.push({ name: '', price: '', unit: '', image_url: '' });
        if (app.status === 'rejected') {
          step = 0; render();
          const box = mk('div', 'sa-err', '⚠️ আবেদন ফেরত এসেছে: ' + (app.reject_reason || '') + ' — ঠিক করে আবার জমা দিন।');
          $('saBody').insertBefore(box, $('saBody').firstChild);
          return;
        }
        step = 0; render();
        return;
      }
      welcome();
    }
    init();
    // অ্যাপ/ব্রাউজারের ব্যাক-ক্যাশ থেকে পুরনো উইজার্ড ফিরে এলে আসল অবস্থা আবার লোড
    window.addEventListener('pageshow', (e) => { if (e.persisted) { busy = false; init(); } });
  </script>
</BaseLayout>
