---
// ============================================================
// পেজ: /become-a-shop-owner — লগইন করা ইউজার শপ ওউনার হওয়ার জন্য
// আবেদন করবে এখান থেকে। Admin পরে /admin/shops থেকে Approve করলে
// dashboard access পাবে (shop_requests টেবিল ব্যবহার করে)।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="শপ ওউনার হোন | স্মার্ট ফেনী">
  <div class="request-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <!-- ===== লগইন লাগবে ===== -->
      <div id="loginRequired" class="status-box" style="display:none;">
        <i class="fas fa-lock"></i>
        <h2>লগইন করুন</h2>
        <p>শপ ওউনার হওয়ার আবেদন করতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-btn">হোমপেজে যান</a>
      </div>

      <!-- ===== ইতিমধ্যে শপ ওউনার ===== -->
      <div id="alreadyOwner" class="status-box" style="display:none;">
        <i class="fas fa-store"></i>
        <h2>আপনি ইতিমধ্যে একজন শপ ওউনার</h2>
        <p>আপনার শপ ড্যাশবোর্ড থেকে ম্যানেজ করুন</p>
        <a href="/my-shop" class="primary-btn">আমার শপ ড্যাশবোর্ড</a>
      </div>

      <!-- ===== পেন্ডিং আবেদন আগে থেকেই আছে ===== -->
      <div id="pendingExists" class="status-box" style="display:none;">
        <i class="fas fa-hourglass-half"></i>
        <h2>আবেদন পর্যালোচনাধীন</h2>
        <p>আপনার আবেদনটি অ্যাডমিন টিম রিভিউ করছে। এপ্রুভ হলে আপনাকে জানানো হবে।</p>
      </div>

      <!-- ===== আবেদন বাতিল হয়েছিল — আবার আবেদনের সুযোগ ===== -->
      <div id="rejectedNotice" class="rejected-notice" style="display:none;">
        <i class="fas fa-circle-info"></i> আপনার আগের আবেদনটি গ্রহণ করা হয়নি। চাইলে আবার আবেদন করতে পারেন।
      </div>

      <!-- ===== আবেদন ফর্ম ===== -->
      <div id="requestForm" class="form-card" style="display:none;">
        <div class="form-header">
          <i class="fas fa-store"></i>
          <h1>শপ ওউনার হওয়ার আবেদন করুন</h1>
          <p>ফর্মটি পূরণ করুন — অ্যাডমিন টিম রিভিউ করে এপ্রুভ করলে আপনি একটা নিজস্ব শপ পেজ ও ড্যাশবোর্ড পাবেন</p>
        </div>

        <p class="form-message" id="formMessage"></p>

        <label class="form-label">শপের নাম</label>
        <input type="text" class="form-input" id="shopNameInput" placeholder="যেমন: রহিম'স ক্লথিং শপ" />

        <label class="form-label">যোগাযোগের ফোন নম্বর</label>
        <input type="text" class="form-input" id="phoneInput" placeholder="01xxxxxxxxx" />

        <label class="form-label">সংক্ষেপে বলুন আপনি কী বিক্রি করবেন (ঐচ্ছিক)</label>
        <textarea class="form-textarea" id="messageInput" placeholder="যেমন: হোম মেড কেক, ড্রেস, ইলেকট্রনিক্স ইত্যাদি" rows="3"></textarea>

        <button class="submit-btn" id="submitBtn" type="button">
          <i class="fas fa-paper-plane"></i> <span id="submitBtnText">আবেদন জমা দিন</span>
        </button>
      </div>

    </div>
  </div>

  <style>
    .request-page {
      min-height: 70vh;
      padding: 50px 0 80px;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 60px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-box i {
      font-size: 2.4rem;
      color: #FF6B35;
      margin-bottom: 16px;
    }

    .status-box h2 {
      font-size: 1.2rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .primary-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 12px 26px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
    }

    .rejected-notice {
      max-width: 560px;
      margin: 0 auto 20px;
      background: #FFF0EA;
      color: #D14343;
      padding: 12px 18px;
      border-radius: 14px;
      font-size: 0.85rem;
      font-weight: 600;
      text-align: center;
    }

    .form-card {
      max-width: 560px;
      margin: 0 auto;
      background: #fff;
      border-radius: 24px;
      padding: 32px 26px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .form-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .form-header i {
      font-size: 2rem;
      color: #FF6B35;
      margin-bottom: 10px;
    }

    .form-header h1 {
      font-size: 1.3rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .form-header p {
      color: #5A6E85;
      font-size: 0.86rem;
      line-height: 1.6;
    }

    .form-message {
      display: none;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-message.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-message.show-success {
      display: block;
      background: #EAFBF0;
      color: #1B7A3C;
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 16px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input, .form-textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .form-input:focus, .form-textarea:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .submit-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      margin-top: 22px;
    }

    .submit-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const alreadyOwner = document.getElementById('alreadyOwner');
    const pendingExists = document.getElementById('pendingExists');
    const rejectedNotice = document.getElementById('rejectedNotice');
    const requestForm = document.getElementById('requestForm');

    const formMessage = document.getElementById('formMessage');
    const shopNameInput = document.getElementById('shopNameInput');
    const phoneInput = document.getElementById('phoneInput');
    const messageInput = document.getElementById('messageInput');
    const submitBtn = document.getElementById('submitBtn');
    const submitBtnText = document.getElementById('submitBtnText');

    function showMsg(text, type = 'error') {
      formMessage.textContent = text;
      formMessage.className = `form-message ${type === 'error' ? 'show-error' : 'show-success'}`;
    }

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('is_shop_owner, phone')
        .eq('id', session.user.id)
        .single();

      if (profile?.is_shop_owner) {
        loadingState.style.display = 'none';
        alreadyOwner.style.display = 'block';
        return;
      }

      // আগের আবেদনের status চেক (সর্বশেষটা)
      const { data: existingRequests } = await supabase
        .from('shop_requests')
        .select('*')
        .eq('user_id', session.user.id)
        .order('created_at', { ascending: false })
        .limit(1);

      const latestRequest = existingRequests?.[0];

      loadingState.style.display = 'none';

      if (latestRequest?.status === 'pending') {
        pendingExists.style.display = 'block';
        return;
      }

      if (latestRequest?.status === 'rejected') {
        rejectedNotice.style.display = 'block';
      }

      if (profile?.phone) {
        phoneInput.value = profile.phone;
      }

      requestForm.style.display = 'block';
    }

    submitBtn?.addEventListener('click', async () => {
      formMessage.className = 'form-message';

      const shopName = shopNameInput.value.trim();
      const phone = phoneInput.value.trim();
      const message = messageInput.value.trim();

      if (!shopName || !phone) {
        showMsg('শপের নাম ও ফোন নম্বর দিন');
        return;
      }

      submitBtnText.textContent = 'জমা হচ্ছে...';
      submitBtn.disabled = true;

      const { data: { session } } = await supabase.auth.getSession();

      const { error } = await supabase.from('shop_requests').insert({
        user_id: session.user.id,
        shop_name: shopName,
        phone,
        message: message || null,
        status: 'pending',
      });

      if (error) {
        showMsg('আবেদন জমা ব্যর্থ: ' + error.message);
        submitBtnText.textContent = 'আবেদন জমা দিন';
        submitBtn.disabled = false;
        return;
      }

      showMsg('আবেদন সফলভাবে জমা হয়েছে ✓ অ্যাডমিন টিম রিভিউ করার পর জানানো হবে', 'success');
      submitBtn.style.display = 'none';
      shopNameInput.disabled = true;
      phoneInput.disabled = true;
      messageInput.disabled = true;
    });

    init();
  </script>
</BaseLayout>