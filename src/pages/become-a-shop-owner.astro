          x.addEventListener('click', () => { f.items.splice(idx, 1); render(); });
          row.appendChild(x);
        }
        c.appendChild(row);
      });
      if (f.items.length < 30) {
        const add = mk('button', 'sa-add', '+ আরো পণ্য'); add.type = 'button';
        add.addEventListener('click', () => { f.items.push({ name: '', price: '', unit: '', image_url: '' }); render(); });
        c.appendChild(add);
