      DAYS.forEach((d, i) => { const o = mk('option', '', d); o.value = String(i); off.appendChild(o); });
      off.value = f.weekly_off; off.addEventListener('change', () => { f.weekly_off = off.value; });
      const two2 = mk('div', 'sa-two');
      two2.appendChild(field('সাপ্তাহিক ছুটি', off, false));
      const pm = inp('number', 'prep_minutes'); pm.min = '5'; pm.max = '240'; pm.inputMode = 'numeric';
      two2.appendChild(field('রেডি করতে (মিনিট)', pm, false));
      c2.appendChild(two2);
      body.appendChild(c2);
    }

    function stepMenu(body) {
      body.appendChild(head(3, 'দামসহ অন্তত ৩টা পণ্য — পরে Pro অ্যাপ থেকে আরো যোগ করবেন'));
      const c = mk('section', 'sa-card');
      f.items.forEach((it, idx) => {
        const row = mk('div', 'sa-item');
        row.appendChild(picker('item', it.image_url, 'ছবি', (u) => { it.image_url = u; }));
        const fx = mk('div', 'sa-item-f');
        const n = mk('input'); n.type = 'text'; n.maxLength = 120; n.placeholder = 'পণ্যের নাম'; n.value = it.name || ''; n.setAttribute('aria-label', 'পণ্য ' + BN(idx + 1) + ' নাম');
        n.addEventListener('input', () => { it.name = n.value; });
        const r = mk('div', 'sa-item-row');
        const pr = mk('input'); pr.type = 'number'; pr.min = '1'; pr.inputMode = 'decimal'; pr.placeholder = 'দাম ৳'; pr.value = it.price === null || it.price === undefined ? '' : it.price; pr.setAttribute('aria-label', 'পণ্য ' + BN(idx + 1) + ' দাম');
        pr.addEventListener('input', () => { it.price = pr.value; });
        const un = mk('input'); un.type = 'text'; un.maxLength = 20; un.placeholder = 'একক'; un.value = it.unit || ''; un.setAttribute('aria-label', 'একক (পিস/কেজি)');
        un.addEventListener('input', () => { it.unit = un.value; });
