      [['instant', 'scooter', 'এখনই ডেলিভারি', 'অর্ডার এলে আপনি রেডি করবেন, স্মার্ট ফেনী রাইডার ৩০–৬০ মিনিটে কাস্টমারের কাছে পৌঁছে দেবে। খাবার, গ্রোসারি, ফার্মেসির জন্য।'],
       ['preorder', 'bags', 'প্রি-অর্ডার', 'অর্ডার সরাসরি আপনার কাছে আসবে। কাস্টমারকে কল করে কনফার্ম করবেন, তারপর নিজে বা আমাদের রাইডার দিয়ে পাঠাবেন। কেক, হোমমেড, ফ্যাশনের জন্য।']].forEach(([v, img, t, s]) => {
        const b = mk('button', 'sa-kopt'); b.type = 'button';
        b.setAttribute('aria-pressed', String(f.delivery_kind === v));
        const im = mk('img'); im.src = IC + img + '.webp'; im.alt = ''; im.setAttribute('aria-hidden', 'true'); b.appendChild(im);
        const tx = mk('div'); tx.appendChild(mk('b', '', t)); tx.appendChild(mk('small', '', s)); b.appendChild(tx);
        b.addEventListener('click', () => { f.delivery_kind = v; k.querySelectorAll('.sa-kopt').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); });
        k.appendChild(b);
      });
      c.appendChild(k);
      body.appendChild(c);
      const c2 = mk('section', 'sa-card');
      const two = mk('div', 'sa-two');
