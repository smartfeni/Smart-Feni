---
// path: src/pages/become-a-shop-owner.astro
// ============================================================
// পেজ: কুইক ডেলিভারিতে দোকান খোলার আবেদন (/become-a-shop-owner)
// ৫ ধাপের উইজার্ড: দোকান → লোকেশন → ডেলিভারি ও সময় → মেনু (৩+ পণ্য) → পেমেন্ট ও শর্ত।
// প্রতি ধাপে ড্রাফট সেভ (RPC market_shop_app_save, p_submit=false); শেষে জমা (true, সার্ভারে যাচাই)।
// অ্যাডমিন /admin/delivery-shop-applications থেকে ক্যাটাগরি বেছে অনুমোদন দিলেই দোকান লাইভ।
// ছবি: delivery-shop-images/applications/<uid>/... (কমপ্রেস করে)। ম্যাপ: MarketLocationSheet (pick মোড)।
// ============================================================
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import MarketLocationSheet from '../components/market/MarketLocationSheet.astro';
---

<BaseLayout title="কুইক ডেলিভারিতে দোকান খুলুন | স্মার্ট ফেনী">
  <MarketLocationSheet />
  <div class="sa">
    <header class="sa-hero">
      <div class="sa-hero-in">
        <a href="/" class="sa-round" aria-label="হোমে ফিরুন"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg></a>
        <div class="sa-hero-t">
          <small>কুইক ডেলিভারি · পার্টনার</small>
          <h1>আপনার দোকান খুলুন</h1>
        </div>
        <img src="/market/icons/bags.webp" alt="" aria-hidden="true" class="sa-hero-ic" />
      </div>
      <div class="sa-prog" id="saProg" aria-hidden="true"></div>
    </header>
    <main class="sa-body" id="saBody" aria-live="polite"></main>
    <footer class="sa-foot" id="saFoot" hidden>
      <button type="button" class="sa-back" id="saPrev">আগের ধাপ</button>
      <button type="button" class="sa-next" id="saNext">পরের ধাপ</button>
    </footer>
  </div>

  <style is:global>
    #siteNavbar { display: none !important; }
    .sa { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 100vh; padding-bottom: 190px; }
    .sa-hero { background: radial-gradient(130% 140% at 100% 0%, #FF9A6B 0%, #FF6B35 38%, #E2531F 62%, #1B2A4A 100%); color: #fff; padding-bottom: 14px; box-shadow: 0 10px 26px rgba(226,83,31,.22); }
    .sa-hero-in { max-width: 560px; margin: 0 auto; padding: 14px 16px 6px; display: flex; align-items: center; gap: 12px; }
    .sa-round { width: 44px; height: 44px; border-radius: 22px; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; flex: none; }
    .sa-round svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
    .sa-hero-t { flex: 1; }
    .sa-hero-t small { font-size: 13px; font-weight: 600; opacity: .9; }
    .sa-hero-t h1 { margin: 0; font-size: 22px; color: #fff; }
    .sa-hero-ic { width: 56px; height: 56px; filter: drop-shadow(0 6px 10px rgba(0,0,0,.2)); }
    .sa-prog { max-width: 560px; margin: 8px auto 0; padding: 0 16px; display: flex; gap: 6px; }
    .sa-prog i { flex: 1; height: 6px; border-radius: 3px; background: rgba(255,255,255,.28); }
    .sa-prog i.on { background: #fff; }
    .sa-body { max-width: 560px; margin: 0 auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 14px; }
    .sa-step-h { display: flex; align-items: center; gap: 10px; }
    .sa-step-h span { width: 34px; height: 34px; border-radius: 12px; background: #1B2A4A; color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; flex: none; }
    .sa-step-h h2 { margin: 0; font-size: 19px; }
    .sa-step-h p { margin: 0; font-size: 13px; color: #5B6B86; font-weight: 600; }
    .sa-card { background: #fff; border-radius: 20px; padding: 16px; box-shadow: 0 2px 12px rgba(27,42,74,.06); display: flex; flex-direction: column; gap: 12px; }
    .sa-f { display: flex; flex-direction: column; gap: 6px; }
    .sa-f > span { font-size: 14px; font-weight: 700; }
    .sa-f > span .required-mark { color: #D7372B; margin-left: 2px; }
    .sa-f small { font-size: 12.5px; color: #5B6B86; }
    .sa-f input, .sa-f textarea, .sa-f select { min-height: 48px; border: 1.5px solid #E2E8F0; border-radius: 14px; padding: 10px 12px; font: inherit; font-size: 16px; color: #1B2A4A; background: #fff; width: 100%; box-sizing: border-box; }
    .sa-f textarea { min-height: 84px; resize: vertical; }
    .sa-f input:focus, .sa-f textarea:focus, .sa-f select:focus { outline: 0; border-color: #FF6B35; box-shadow: 0 0 0 3px rgba(255,107,53,.15); }
    .sa-two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .sa-imgs { display: flex; gap: 12px; align-items: flex-start; }
    .sa-pick { position: relative; border: 2px dashed #F4C7AE; background: #FFF8F3 center/cover no-repeat; border-radius: 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #C2410C; font-weight: 700; font-size: 13px; cursor: pointer; text-align: center; overflow: hidden; }
    .sa-pick.has { border-style: solid; border-color: #fff; box-shadow: 0 4px 14px rgba(27,42,74,.12); color: transparent; }
    .sa-pick.logo { width: 104px; height: 104px; flex: none; }
    .sa-pick.cover { flex: 1; height: 104px; }
    .sa-pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .sa-pick svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2; }
    .sa-cats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .sa-cat { border: 1.5px solid #E2E8F0; border-radius: 16px; background: #fff; padding: 10px 6px; display: flex; flex-direction: column; align-items: center; gap: 4px; font: inherit; font-size: 13px; font-weight: 700; color: #1B2A4A; cursor: pointer; min-height: 88px; }
    .sa-cat img { width: 40px; height: 40px; }
    .sa-cat[aria-pressed='true'] { border-color: #FF6B35; background: #FFF4EC; box-shadow: 0 0 0 2px #FF6B35 inset; }
    .sa-map { border-radius: 16px; background: #F4F6FA; padding: 14px; display: flex; align-items: center; gap: 12px; }
    .sa-map-ic { width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg,#FF8A5B,#FF6B35); display: flex; align-items: center; justify-content: center; flex: none; }
    .sa-map-ic svg { width: 24px; height: 24px; fill: #fff; }
    .sa-map b { display: block; font-size: 15px; }
    .sa-map small { display: block; font-size: 13px; color: #5B6B86; }
    .sa-btn { min-height: 46px; border-radius: 14px; border: 0; background: #1B2A4A; color: #fff; font: inherit; font-weight: 700; padding: 0 16px; cursor: pointer; }
    .sa-btn.ghost { background: #fff; color: #1B2A4A; border: 1.5px solid #1B2A4A; }
    .sa-kind { display: flex; flex-direction: column; gap: 10px; }
    .sa-kopt { display: flex; gap: 12px; align-items: flex-start; text-align: left; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 14px; background: #fff; font: inherit; color: #1B2A4A; cursor: pointer; }
    .sa-kopt[aria-pressed='true'] { border-color: #FF6B35; background: #FFF6F0; box-shadow: 0 0 0 2px #FF6B35 inset; }
    .sa-kopt img { width: 46px; height: 46px; flex: none; }
    .sa-kopt b { display: block; font-size: 16px; }
    .sa-kopt small { display: block; font-size: 13px; color: #5B6B86; line-height: 1.5; margin-top: 2px; }
    .sa-item { border: 1.5px solid #EDF0F5; border-radius: 18px; padding: 12px; display: grid; grid-template-columns: 78px 1fr; gap: 10px; position: relative; }
    .sa-item .sa-pick { width: 78px; height: 78px; font-size: 11px; }
    .sa-item-f { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .sa-item-f input { min-height: 42px; border: 1.5px solid #E2E8F0; border-radius: 12px; padding: 6px 10px; font: inherit; font-size: 15px; width: 100%; box-sizing: border-box; }
    .sa-item-row { display: grid; grid-template-columns: 1fr 96px; gap: 8px; }
    .sa-item-x { position: absolute; top: 6px; right: 6px; width: 32px; height: 32px; border-radius: 16px; border: 0; background: #FDECEA; color: #B3261E; font-weight: 700; cursor: pointer; }
    .sa-add { min-height: 48px; border-radius: 14px; border: 1.5px dashed #FF6B35; background: #FFF8F3; color: #E2531F; font: inherit; font-weight: 700; cursor: pointer; }
    .sa-seg { display: flex; background: #F4F6FA; border-radius: 14px; padding: 4px; gap: 4px; }
    .sa-seg button { flex: 1; min-height: 44px; border: 0; border-radius: 11px; background: none; font: inherit; font-weight: 700; color: #5B6B86; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; }
    .sa-seg button img { width: 22px; height: 22px; object-fit: contain; }
    .sa-seg button[aria-pressed='true'] { background: #fff; color: #1B2A4A; box-shadow: 0 2px 8px rgba(27,42,74,.12); }
    .sa-terms { background: #F4F6FA; border-radius: 16px; padding: 12px 14px; font-size: 14px; line-height: 1.6; }
    .sa-terms ul { margin: 6px 0 0; padding-left: 18px; }
    .sa-check { display: flex; gap: 10px; align-items: flex-start; font-weight: 700; font-size: 14.5px; }
    .sa-check input { width: 22px; height: 22px; margin-top: 2px; accent-color: #FF6B35; flex: none; }
    .sa-err { background: #FDECEA; color: #A3261B; border-radius: 14px; padding: 11px 13px; font-weight: 700; font-size: 14px; }
    .sa-foot { position: fixed; left: 0; right: 0; bottom: calc(66px + env(safe-area-inset-bottom)); z-index: 997; background: rgba(255,255,255,.97); backdrop-filter: blur(8px); border-top: 1px solid #F1E2D7; box-shadow: 0 -8px 24px rgba(27,42,74,.08); padding: 10px 14px; display: flex; gap: 10px; justify-content: center; }
    .sa-foot button { min-height: 52px; border-radius: 16px; font: inherit; font-weight: 700; font-size: 16px; cursor: pointer; }
    .sa-back { flex: 0 0 34%; max-width: 190px; background: #fff; border: 1.5px solid #E2E8F0; color: #1B2A4A; }
    .sa-next { flex: 1; max-width: 360px; border: 0; color: #fff; background: linear-gradient(135deg,#FF8A5B,#FF6B35); box-shadow: 0 8px 20px rgba(255,107,53,.3); }
    .sa-next:disabled { opacity: .55; }
    .sa-state { background: #fff; border-radius: 24px; padding: 26px 18px; text-align: center; box-shadow: 0 2px 12px rgba(27,42,74,.06); display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .sa-state img { width: 84px; height: 84px; }
    .sa-state h2 { margin: 0; font-size: 21px; }
    .sa-state p { margin: 0; color: #4A5568; line-height: 1.6; }
    .sa-state .sa-btn { width: 100%; max-width: 320px; display: flex; align-items: center; justify-content: center; text-decoration: none; }
    .sa-perks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .sa-perk { background: #fff; border-radius: 16px; padding: 12px 8px; text-align: center; font-size: 12.5px; font-weight: 700; box-shadow: 0 2px 10px rgba(27,42,74,.05); }
    .sa-perk img { width: 36px; height: 36px; display: block; margin: 0 auto 4px; }
    .sa-cat:focus-visible, .sa-kopt:focus-visible, .sa-btn:focus-visible, .sa-foot button:focus-visible, .sa-seg button:focus-visible, .sa-add:focus-visible, .sa-pick:focus-within { outline: 3px solid #FF6B35; outline-offset: 2px; }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { compressImage } from '../lib/imageCompress.js';
    import { menuWord } from '../lib/marketFood.js';

    const $ = (id) => document.getElementById(id);
    const BN = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[d]);
    const toast = (m, t) => { if (window.showToast) window.showToast(m, t || 'info'); };
    function mk(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined && text !== null) e.textContent = text; return e; }
    const IC = '/market/icons/';
    const CAT_IMG = { food: 'food', grocery: 'grocery', pharmacy: 'pharmacy', flower: 'flower', flowers: 'flower', beauty: 'beauty', gadget: 'gadget', fashion: 'fashion', home: 'home', bakery: 'bakery', organic: 'organic', books: 'books', baby: 'baby', other: 'bags' };
    const DAYS = ['রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার', 'শনিবার'];
    const STEPS = ['দোকান', 'লোকেশন', 'ডেলিভারি ও সময়', 'মেনু', 'পেমেন্ট ও শর্ত'];
    const ERR = { name: ['দোকানের নাম দিন (৩ অক্ষরের বেশি)', 0], logo: ['লোগো ছবি দিন', 0], category: ['অন্তত ১টা ক্যাটাগরি বাছুন', 0], pin: ['ম্যাপে দোকানের পিন বসান', 1], address: ['উপজেলা ও ঠিকানা দিন', 1], hours: ['খোলা ও বন্ধের সময় দিন', 2], phone: ['সঠিক মোবাইল নম্বর দিন', 4], payout: ['পাওনা নেওয়ার বিকাশ/নগদ নম্বর দিন', 4], items: ['দামসহ অন্তত ৩টা পণ্য দিন', 3], agree: ['শর্তে সম্মতি দিন', 4], pending: ['আবেদন পর্যালোচনাধীন আছে', 0], login: ['লগইন করুন', 0] };

    let uid = null;
    let cats = [];
    let step = 0;
    let busy = false;
    let app = null; // সার্ভারের সারি
    const f = { name: '', logo_url: '', cover_url: '', description: '', sells: '', suggested_category_ids: [], lat: null, lng: null, upazila: '', union_name: '', address: '', delivery_kind: 'instant', opens_at: '10:00', closes_at: '22:00', weekly_off: '', prep_minutes: 15, phone: '', payout_method: 'bkash', payout_number: '', items: [], agreed: false };

    function fromRow(r) {
      Object.keys(f).forEach((k) => { if (r[k] !== undefined && r[k] !== null) f[k] = r[k]; });
      if (f.opens_at) f.opens_at = String(f.opens_at).slice(0, 5);
      if (f.closes_at) f.closes_at = String(f.closes_at).slice(0, 5);
      if (f.weekly_off === null || f.weekly_off === undefined) f.weekly_off = '';
      f.weekly_off = String(f.weekly_off);
      if (!Array.isArray(f.items)) f.items = [];
      if (!Array.isArray(f.suggested_category_ids)) f.suggested_category_ids = [];
    }
    while (f.items.length < 3) f.items.push({ name: '', price: '', unit: '', image_url: '' });

    async function upload(file, kind) {
      const blob = await compressImage(file, { maxDimension: kind === 'cover' ? 1400 : 900, quality: 0.8 });
      const path = 'applications/' + uid + '/' + kind + '-' + crypto.randomUUID() + '.jpg';
      const { error } = await supabase.storage.from('delivery-shop-images').upload(path, blob, { contentType: 'image/jpeg', cacheControl: '31536000', upsert: false });
      if (error) throw error;
      return supabase.storage.from('delivery-shop-images').getPublicUrl(path).data.publicUrl;
    }

    function picker(cls, url, label, onFile) {
      const p = mk('label', 'sa-pick ' + cls + (url ? ' has' : ''));
      if (url) p.style.backgroundImage = 'url("' + encodeURI(url) + '")';
      p.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>';
      p.appendChild(mk('span', '', label));
      const inp = mk('input'); inp.type = 'file'; inp.accept = 'image/*'; inp.setAttribute('aria-label', label);
      inp.addEventListener('change', async () => {
        const file = inp.files && inp.files[0];
        if (!file) return;
        p.classList.add('has'); p.style.opacity = '.6';
        try {
          const u = await upload(file, cls.split(' ')[0] || 'img');
          p.style.backgroundImage = 'url("' + encodeURI(u) + '")'; onFile(u);
        } catch (e) { toast('ছবি আপলোড হয়নি, আবার চেষ্টা করুন', 'error'); p.classList.remove('has'); if (window.SFReportError) { try { window.SFReportError(e, 'shop-app-upload'); } catch (_) {} } }
        p.style.opacity = '';
      });
      p.appendChild(inp);
      return p;
    }

    function field(label, input, req, hint) {
      const l = mk('label', 'sa-f');
      const s = mk('span', '', label);
      if (req) { const r = mk('span', 'required-mark', '*'); s.appendChild(r); }
      l.appendChild(s); l.appendChild(input);
      if (hint) l.appendChild(mk('small', '', hint));
      return l;
    }
    function inp(type, key, ph, max) {
      const i = mk(type === 'textarea' ? 'textarea' : 'input');
      if (type !== 'textarea') i.type = type;
      if (ph) i.placeholder = ph;
      if (max) i.maxLength = max;
      i.value = f[key] === null || f[key] === undefined ? '' : String(f[key]);
      i.addEventListener('input', () => { f[key] = i.value; });
      return i;
    }

    function head(n, sub) {
      const h = mk('div', 'sa-step-h');
      h.appendChild(mk('span', '', BN(n + 1)));
      const t = mk('div'); t.appendChild(mk('h2', '', n === 3 ? menuWord(f.suggested_category_ids) : STEPS[n])); if (sub) t.appendChild(mk('p', '', sub));
      h.appendChild(t);
      return h;
    }

    function stepShop(body) {
      body.appendChild(head(0, 'কাস্টমার প্রথমে এগুলোই দেখবে'));
      const c = mk('section', 'sa-card');
      const imgs = mk('div', 'sa-imgs');
      imgs.appendChild(picker('logo', f.logo_url, 'লোগো *', (u) => { f.logo_url = u; }));
      imgs.appendChild(picker('cover', f.cover_url, 'কভার ছবি (দোকান/পণ্য)', (u) => { f.cover_url = u; }));
      c.appendChild(imgs);
      c.appendChild(field('দোকানের নাম', inp('text', 'name', 'যেমন: রহিম স্টোর', 80), true));
      c.appendChild(field('ছোট বিবরণ', inp('textarea', 'description', 'আপনার দোকান সম্পর্কে ১–২ লাইন', 300), false));
      body.appendChild(c);
      const c2 = mk('section', 'sa-card');
      c2.appendChild(mk('div', 'sa-f')).appendChild(mk('span', '', 'কী বিক্রি করেন? (১–৩টা বাছুন)'));
      const g = mk('div', 'sa-cats');
      cats.forEach((cat) => {
        const b = mk('button', 'sa-cat'); b.type = 'button';
        const on = f.suggested_category_ids.indexOf(cat.id) !== -1;
        b.setAttribute('aria-pressed', String(on));
        const k = CAT_IMG[cat.icon] || CAT_IMG[cat.slug] || 'bags';
        const im = mk('img'); im.src = IC + k + '.webp'; im.alt = ''; im.setAttribute('aria-hidden', 'true');
        b.appendChild(im); b.appendChild(mk('span', '', cat.name));
        b.addEventListener('click', () => {
          const i = f.suggested_category_ids.indexOf(cat.id);
          if (i !== -1) f.suggested_category_ids.splice(i, 1);
          else { if (f.suggested_category_ids.length >= 3) { toast('সর্বোচ্চ ৩টা', 'warning'); return; } f.suggested_category_ids.push(cat.id); }
          b.setAttribute('aria-pressed', String(f.suggested_category_ids.indexOf(cat.id) !== -1));
        });
        g.appendChild(b);
      });
      c2.appendChild(g);
      c2.appendChild(field('আরো বিস্তারিত (ঐচ্ছিক)', inp('text', 'sells', 'যেমন: হোমমেড কেক, জন্মদিনের কেক', 200), false));
      body.appendChild(c2);
    }

    function stepLocation(body) {
      body.appendChild(head(1, 'রাইডার এই পিনেই আসবে, চার্জও এখান থেকে হিসাব হবে'));
      const c = mk('section', 'sa-card');
      const m = mk('div', 'sa-map');
      const ic = mk('div', 'sa-map-ic');
      ic.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>';
      m.appendChild(ic);
      const t = mk('div'); t.style.flex = '1';
