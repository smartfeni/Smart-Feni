---
// path: src/pages/pro/hero/index.astro
// ============================================================
// পেজ: Pro হিরো (/pro/hero) — রাউটার
// লগইন না থাকলে Pro লগইনে; রাইডার না হলে বার্তা;
// নইলে শেষ খোলা ট্যাব (না থাকলে প্রথম ট্যাব)-এ যায়।
// ট্যাব: delivery (ডিরেক্ট অর্ডার) | offline (অফলাইন অর্ডার) | ride (রাইড)
// ============================================================
export const prerender = false;

import BaseLayout from '../../../components/layout/BaseLayout.astro';
---

<BaseLayout title="হিরো | Smart Feni Pro">
  <div class="ph-page">
    <div id="phLoading" class="ph-state"><div class="ph-spinner"></div><p>লোড হচ্ছে...</p></div>
    <div id="phNone" class="ph-state" style="display:none;">
      <i class="fas fa-motorcycle" style="font-size:2rem;color:#B7C2D8;"></i>
      <p>এই অ্যাকাউন্টে রাইডার (হিরো) প্রোফাইল নেই।</p>
      <a href="/pro?pick=1" class="ph-btn">অন্য ভূমিকায় যান</a>
    </div>
    <div id="phErr" class="ph-state" style="display:none;"><p id="phErrText"></p><button type="button" class="ph-btn" id="phRetry">আবার চেষ্টা করুন</button></div>
  </div>

  <style is:global>
    .ph-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #F8FAFC; min-height: 70vh; padding: 20px 14px 90px; max-width: 520px; margin: 0 auto; }
    .ph-state { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 90px 10px; text-align: center; color: #5B6B86; font-weight: 600; }
    .ph-spinner { width: 36px; height: 36px; border: 3px solid #E3E8F0; border-top-color: #FF6B35; border-radius: 50%; animation: phSpin .8s linear infinite; }
    @keyframes phSpin { to { transform: rotate(360deg); } }
    .ph-btn { height: 46px; border: 0; border-radius: 14px; background: #FF6B35; color: #1B2A4A; font-weight: 700; font-size: 15px; padding: 0 20px; display: inline-flex; align-items: center; text-decoration: none; cursor: pointer; font-family: inherit; }
  </style>

  <script>
    import { getHeroTabs, HERO_TABS, lastHeroTab } from '../../../lib/proHero.js';
    import { proLoginUrl } from '../../../lib/proRoles.js';

    const $ = (id) => document.getElementById(id);
    function show(id) { ['phLoading', 'phNone', 'phErr'].forEach((x) => { $(x).style.display = x === id ? '' : 'none'; }); }

    async function init() {
      show('phLoading');
      let res;
      try { res = await getHeroTabs(); } catch (e) { res = { loggedIn: true, hasRider: false, tabs: [], error: (e && e.message) || 'সমস্যা হয়েছে' }; }
      if (!res.loggedIn) { window.location.replace(proLoginUrl('/pro/hero')); return; }
      if (res.error) { $('phErrText').textContent = 'লোড করা যায়নি: ' + res.error; show('phErr'); return; }
      if (!res.hasRider || !res.tabs.length) { show('phNone'); return; }
      const last = lastHeroTab();
      const pick = res.tabs.indexOf(last) !== -1 ? last : res.tabs[0];
      window.location.replace(HERO_TABS[pick].href);
    }

    $('phRetry').addEventListener('click', init);
    init();
  </script>
</BaseLayout>
