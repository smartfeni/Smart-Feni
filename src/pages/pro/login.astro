---
// ============================================================
// পেজ: Smart Feni Pro — লগইন (/pro/login)
// কে: দোকান/রাইডার/ক্লাব/ক্লিনিকের Pro ইউজার (সাইনআপ নেই — অ্যাকাউন্ট না থাকলে অ্যাডমিনের সাথে যোগাযোগ)
// লজিক: src/lib/proLogin.js (AuthModal-এর একই নিয়ম, একই supabase সিঙ্গলটন)
// ?next=/pro/... — লগইনের পর সেখানে ফেরা (শুধু /pro দিয়ে শুরু হলে, safeNext)
// আগে থেকেই লগইন থাকলে সরাসরি next/ /pro-তে।
// এই পেজে সাধারণ হেডার ও নিচের নেভ লুকানো (শুধু এই পেজে, is:global)।
// ইউজারের লেখা সব textContent।
// ============================================================
export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="Pro লগইন | Smart Feni Pro">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="pl-page">
    <div class="pl-top">
      <img src="/logo.png" alt="স্মার্ট ফেনী" class="pl-logo" />
      <div class="pl-brand">Smart Feni <span>Pro</span></div>
      <p class="pl-tag">দোকান, রাইডার ও ম্যানেজারদের জন্য</p>
    </div>

    <div class="pl-sheet">
      <div class="pl-grip"></div>

      <!-- লগইন -->
      <form id="plLoginForm" class="pl-pane" novalidate>
        <h1 class="pl-h1">লগইন করুন</h1>

        <label class="pl-lbl" for="plId">ফোন নম্বর / ইমেইল <span class="required-mark pl-req">*</span></label>
        <input class="pl-in" id="plId" type="text" autocomplete="username" autocapitalize="none" placeholder="01xxxxxxxxx অথবা ইমেইল" required />

        <label class="pl-lbl" for="plPw">পাসওয়ার্ড <span class="required-mark pl-req">*</span></label>
        <div class="pl-pwwrap">
          <input class="pl-in" id="plPw" type="password" autocomplete="current-password" placeholder="পাসওয়ার্ড" required />
          <button type="button" class="pl-eye" id="plEye" aria-label="পাসওয়ার্ড দেখান"><i class="fas fa-eye"></i></button>
        </div>

        <p class="pl-err" id="plErr" role="alert" style="display:none;"></p>

        <button type="submit" class="pl-cta" id="plGo"><span id="plGoTxt">লগইন</span></button>
        <button type="button" class="pl-link" id="plForgotOpen">পাসওয়ার্ড ভুলে গেছেন?</button>

        <div class="pl-help">
          <i class="fas fa-circle-info"></i>
          <span>Pro অ্যাকাউন্ট না থাকলে বা লগইনে সমস্যা হলে স্মার্ট ফেনী অ্যাডমিনের সাথে যোগাযোগ করুন।</span>
        </div>
      </form>

      <!-- পাসওয়ার্ড ভুলে গেছেন -->
      <form id="plForgotForm" class="pl-pane" style="display:none;" novalidate>
        <h1 class="pl-h1">পাসওয়ার্ড রিসেট</h1>
        <p class="pl-sub">ফোন নম্বর দিন। রিকভারি ইমেইল সেট থাকলে সেখানে রিসেট লিংক যাবে।</p>

        <label class="pl-lbl" for="plFPhone">ফোন নম্বর <span class="required-mark pl-req">*</span></label>
        <input class="pl-in" id="plFPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="01xxxxxxxxx" required />

        <p class="pl-err" id="plFErr" role="alert" style="display:none;"></p>
        <p class="pl-ok" id="plFOk" style="display:none;"></p>

        <button type="submit" class="pl-cta" id="plFGo"><span id="plFGoTxt">রিসেট লিংক পাঠান</span></button>
        <button type="button" class="pl-link" id="plForgotBack">← লগইনে ফিরুন</button>
      </form>
    </div>
  </div>

  <style is:global>
    /* এই পেজে সাধারণ হেডার ও বটম নেভ লুকানো */
    .navbar, .bottom-nav { display: none !important; }
    body { padding-bottom: 0 !important; background: #1B2A4A; }

    .pl-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; min-height: 100vh; background: #1B2A4A; display: flex; flex-direction: column; max-width: 520px; margin: 0 auto; }
    .pl-top { padding: 36px 20px 40px; text-align: center; color: #fff; }
    .pl-logo { width: 64px; height: 64px; border-radius: 18px; background: #fff; object-fit: contain; padding: 6px; }
    .pl-brand { font-size: 26px; font-weight: 700; margin-top: 12px; }
    .pl-brand span { color: #FF6B35; }
    .pl-tag { margin: 4px 0 0; font-size: 14px; color: #B7C2D8; }

    .pl-sheet { flex: 1; background: #F8FAFC; border-radius: 28px 28px 0 0; padding: 12px 20px calc(28px + env(safe-area-inset-bottom)); box-shadow: 0 -6px 24px rgba(27,42,74,.12); }
    .pl-grip { width: 44px; height: 5px; border-radius: 3px; background: #D5DCE8; margin: 0 auto 14px; }
    .pl-pane { display: flex; flex-direction: column; gap: 4px; }
    .pl-h1 { font-size: 21px; font-weight: 700; margin: 0 0 10px; }
    .pl-sub { font-size: 14px; color: #5B6B86; margin: 0 0 8px; }
    .pl-lbl { font-size: 12.5px; font-weight: 600; color: #5B6B86; margin: 8px 0 2px; }
    .pl-req { color: #B3261E; }
    .pl-in { width: 100%; box-sizing: border-box; border: 1.5px solid #D5DCE8; border-radius: 14px; background: #fff; padding: 10px 14px; font-size: 16px; min-height: 52px; font-family: inherit; color: #1B2A4A; }
    .pl-in:focus { outline: none; border-color: #FF6B35; }
    .pl-in.pl-bad { border-color: #B3261E; }
    .pl-pwwrap { position: relative; }
    .pl-pwwrap .pl-in { padding-right: 56px; }
    .pl-eye { position: absolute; right: 4px; top: 4px; width: 44px; height: 44px; border: 0; background: transparent; color: #5B6B86; font-size: 17px; cursor: pointer; }
    .pl-err { background: #FDECEA; color: #B3261E; border-radius: 12px; padding: 10px 14px; font-size: 14px; font-weight: 600; margin: 10px 0 0; white-space: pre-line; }
    .pl-ok { background: #E8F7EE; color: #14693A; border-radius: 12px; padding: 10px 14px; font-size: 14px; font-weight: 600; margin: 10px 0 0; }
    .pl-cta { height: 52px; border: 0; border-radius: 16px; background: #FF6B35; color: #1B2A4A; font-weight: 700; font-size: 17px; width: 100%; margin-top: 16px; cursor: pointer; font-family: inherit; }
    .pl-cta:disabled { opacity: .6; cursor: default; }
    .pl-link { background: none; border: 0; min-height: 44px; color: #1B2A4A; font-weight: 600; font-size: 15px; text-decoration: underline; cursor: pointer; font-family: inherit; margin-top: 4px; }
    .pl-help { display: flex; gap: 10px; align-items: flex-start; background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(27,42,74,.08); padding: 12px 14px; margin-top: 14px; font-size: 13.5px; color: #5B6B86; }
    .pl-help i { color: #FF6B35; margin-top: 3px; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { loginWithIdentifier, sendResetLink, safeNext } from '../../lib/proLogin.js';

    const $ = (id) => document.getElementById(id);
    const next = safeNext(new URLSearchParams(window.location.search).get('next'));

    function showErr(el, msg) { el.textContent = msg; el.style.display = ''; }
    function hide(el) { el.style.display = 'none'; el.textContent = ''; }
    function busy(btn, txtEl, on, label) { btn.disabled = on; if (label) txtEl.textContent = label; }

    // আগে থেকেই লগইন থাকলে সরাসরি পাঠানো
    (async () => {
      try {
        const { data } = await supabase.auth.getSession();
        if (data && data.session) window.location.replace(next);
      } catch (_) { /* উপেক্ষা */ }
    })();

    // পাসওয়ার্ড দেখান/লুকান
    $('plEye').addEventListener('click', () => {
      const pw = $('plPw');
      const show = pw.type === 'password';
      pw.type = show ? 'text' : 'password';
      $('plEye').setAttribute('aria-label', show ? 'পাসওয়ার্ড লুকান' : 'পাসওয়ার্ড দেখান');
      $('plEye').firstElementChild.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
    });

    // লগইন
    $('plLoginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      hide($('plErr'));
      const id = $('plId').value.trim();
      const pw = $('plPw').value;
      $('plId').classList.toggle('pl-bad', !id);
      $('plPw').classList.toggle('pl-bad', !pw);
      if (!id || !pw) { showErr($('plErr'), 'ফোন নম্বর/ইমেইল ও পাসওয়ার্ড দিন'); return; }

      busy($('plGo'), $('plGoTxt'), true, 'লগইন হচ্ছে...');
      let res;
      try { res = await loginWithIdentifier(id, pw); } catch (_) { res = { ok: false, error: 'নেটওয়ার্ক সমস্যা, আবার চেষ্টা করুন' }; }
      if (!res.ok) { busy($('plGo'), $('plGoTxt'), false, 'লগইন'); showErr($('plErr'), res.error); return; }
      window.location.replace(next);
    });

    // পাসওয়ার্ড ভুলে গেছেন
    function showPane(forgot) {
      $('plLoginForm').style.display = forgot ? 'none' : '';
      $('plForgotForm').style.display = forgot ? '' : 'none';
      hide($('plErr')); hide($('plFErr')); hide($('plFOk'));
    }
    $('plForgotOpen').addEventListener('click', () => {
      const id = $('plId').value.trim();
      if (id && id.indexOf('@') === -1) $('plFPhone').value = id;
      showPane(true);
    });
    $('plForgotBack').addEventListener('click', () => showPane(false));

    $('plForgotForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      hide($('plFErr')); hide($('plFOk'));
      const phone = $('plFPhone').value.trim();
      $('plFPhone').classList.toggle('pl-bad', !phone);
      if (!phone) { showErr($('plFErr'), 'ফোন নম্বর দিন'); return; }
      busy($('plFGo'), $('plFGoTxt'), true, 'পাঠানো হচ্ছে...');
      const res = await sendResetLink(phone);
      busy($('plFGo'), $('plFGoTxt'), false, 'রিসেট লিংক পাঠান');
      if (!res.ok) { showErr($('plFErr'), res.error); return; }
      $('plFOk').textContent = res.message;
      $('plFOk').style.display = '';
    });
  </script>
</BaseLayout>
