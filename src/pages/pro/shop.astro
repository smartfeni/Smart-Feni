      $('psPfImgDel').style.display = src ? '' : 'none';
    }

    function pfFillUp() {
      const sel = $('psPfUp');
      sel.textContent = '';
      const o0 = document.createElement('option');
      o0.value = '';
      o0.textContent = 'উপজেলা বাছুন';
