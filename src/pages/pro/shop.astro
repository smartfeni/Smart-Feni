    function openProfile() {
      if (!shop) return;
      pf.file = null; pf.remove = false; pf.objUrl = null;
      pfErr('');
      $('psPfName').value = shop.name || '';
      pfFillUp();
      $('psPfUp').value = shop.upazila || '';
      pfFillUn(shop.upazila || '', shop.union_name || '');
      pf.lat = shop.lat !== null && shop.lat !== undefined ? Number(shop.lat) : null;
      pf.lng = shop.lng !== null && shop.lng !== undefined ? Number(shop.lng) : null;
      pfSetPicker(shop.address || '', pf.lat, pf.lng, shop.upazila || '', shop.union_name || '');
      pfHint();
      pfPaintImg();
      $('psPfOv').classList.add('active');
    }
    function closeProfile() { $('psPfOv').classList.remove('active'); }

    async function saveProfile() {
      if (pf.busy || !shop) return;
      pfErr('');
      const name = $('psPfName').value.trim();
      if (!name) { pfErr('দোকানের নাম লিখুন।'); $('psPfName').focus(); return; }
      const w = pfPicker();
      const ai = w ? w.querySelector('.lp-address-input') : null;
      const address = ai ? ai.value.trim() : '';
      if (address.length > 300) { pfErr('ঠিকানা ৩০০ অক্ষরের মধ্যে রাখুন।'); return; }
      let lat = pf.lat;
      let lng = pf.lng;
      if ((lat === null || lng === null) && w) {
        const hl = parseFloat((w.querySelector('.lp-out-lat') || {}).value);
        const hg = parseFloat((w.querySelector('.lp-out-lng') || {}).value);
        if (!isNaN(hl) && !isNaN(hg)) { lat = hl; lng = hg; }
      }
      if (lat === null || lng === null || isNaN(lat) || isNaN(lng)) { lat = null; lng = null; }

      pf.busy = true;
      $('psPfSave').disabled = true;
      let uploaded = null;
      try {
        let url = shop.image_url || null;
        if (pf.file) {
          const path = 'logos/' + shop.id + '/' + (window.crypto && crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2)) + '.jpg';
          const up = await supabase.storage.from(BUCKET).upload(path, pf.file, { contentType: 'image/jpeg', cacheControl: '31536000' });
          if (up.error) throw new Error('upload');
          uploaded = path;
          url = supabase.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
        } else if (pf.remove) {
          url = null;
        }
        const { data, error } = await supabase.rpc('shop_update_profile', {
          p_shop_id: shop.id,
          p_name: name,
          p_image_url: url,
          p_upazila: $('psPfUp').value || null,
          p_union: $('psPfUn').value || null,
          p_address: address || null,
          p_lat: lat,
          p_lng: lng,
        });
        if (error || !data || !data.ok) {
          if (uploaded) { try { await supabase.storage.from(BUCKET).remove([uploaded]); } catch (_) { /* উপেক্ষা */ } }
          const rs = { name_required: 'দোকানের নাম লিখুন।', bad_location: 'লোকেশন ঠিক নেই, আবার পিন বসান।', bad_image: 'লোগোটি ঠিক নেই, আবার বাছুন।' };
          pfErr((data && rs[data.reason]) || 'সেভ হয়নি, আবার চেষ্টা করুন');
          return;
        }
        const oldPath = storagePathOf(data.old_image);
        if (oldPath && oldPath.indexOf('logos/' + shop.id + '/') === 0) {
          try { await supabase.storage.from(BUCKET).remove([oldPath]); } catch (_) { /* উপেক্ষা */ }
        }
        shop.name = name;
        shop.image_url = url;
        shop.upazila = $('psPfUp').value || null;
        shop.union_name = $('psPfUn').value || null;
        shop.address = address || null;
        shop.lat = lat;
        shop.lng = lng;
        $('psShopName').textContent = name;
        const s0 = shops.find((x) => x.id === shop.id);
        if (s0) s0.name = name;
        const sel = $('psShopSel');
        if (sel) Array.prototype.forEach.call(sel.options, (o) => { if (o.value === shop.id) o.textContent = name; });
        toast('দোকানের তথ্য আপডেট হয়েছে ✓', 'success');
        closeProfile();
      } catch (e) {
        if (uploaded) { try { await supabase.storage.from(BUCKET).remove([uploaded]); } catch (_) { /* উপেক্ষা */ } }
        pfErr('সেভ হয়নি, আবার চেষ্টা করুন');
      } finally {
        pf.busy = false;
        $('psPfSave').disabled = false;
      }
    }

    $('psShopEdit').addEventListener('click', openProfile);
    $('psPfClose').addEventListener('click', closeProfile);
    $('psPfOv').addEventListener('click', (e) => { if (e.target === $('psPfOv')) closeProfile(); });
    $('psPfSave').addEventListener('click', saveProfile);
    $('psPfUp').addEventListener('change', () => pfFillUn($('psPfUp').value));
    $('psPfPick').addEventListener('click', () => $('psPfFile').click());
    $('psPfImgDel').addEventListener('click', () => { pf.file = null; pf.remove = true; $('psPfFile').value = ''; pfPaintImg(); });
    $('psPfFile').addEventListener('change', async () => {
      const f = $('psPfFile').files && $('psPfFile').files[0];
      if (!f) return;
      if (!/^image\//.test(f.type)) { pfErr('শুধু ছবি বাছুন।'); return; }
      try {
        const b = await compressImage(f);
        if (b.size > MAX_BYTES) { pfErr('ছবি অনেক বড়, ছোট ছবি বাছুন।'); return; }
        pf.file = b; pf.remove = false; pf.objUrl = URL.createObjectURL(b);
        pfErr('');
        pfPaintImg();
      } catch (e) { pfErr('ছবি প্রসেস হয়নি, আবার চেষ্টা করুন'); }
    });

    // ---------- ট্যাব ও দোকান ----------
    $('psTabs').addEventListener('click', (e) => {
      const b = e.target.closest('.ps-tab');
      if (!b) return;
      tab = b.dataset.tab;
      document.querySelectorAll('.ps-tab').forEach((x) => x.classList.toggle('active', x === b));
      $('psPane').innerHTML = '';
      refresh();
    });

    async function pickShop(id) {
      const { data, error } = await supabase.from('delivery_shops').select('id, name, is_open, busy_until, image_url, upazila, union_name, address, lat, lng, owner_id').eq('id', id).single();
      if (error || !data) { toast('দোকান লোড হয়নি', 'error'); return; }
      shop = data;
      $('psShopName').textContent = shop.name;
      paintShopEdit();
      paintOpen();
      orders = []; knownNew = new Set();
      await refresh();
    }

    // ---------- রোল/দোকান বদল ----------
    function swRow(tag, icon, title, sub, cur, chipKey) {
      const el = h(tag, 'ps-opt' + (cur ? ' cur' : ''));
      if (tag === 'button') el.type = 'button';
      const ic = h('span', 'ps-swic');
      ic.appendChild(h('i', 'fas ' + icon));
      const tx = h('span', 'ps-swtx');
      tx.appendChild(h('b', '', title));
      tx.appendChild(h('span', '', sub));
      el.appendChild(ic);
      el.appendChild(tx);
      if (chipKey) {
        const box = h('span', 'pbg');
        box.dataset.chip = chipKey;
        el.appendChild(box);
      }
      if (cur) el.appendChild(h('i', 'fas fa-check ps-swck'));
      return el;
    }

    function closeSwitch() { $('psSwOv').classList.remove('active'); }

    function openSwitch() {
      const list = $('psSwList');
      list.textContent = '';
      proRolesList.forEach((r) => {
        const m = ROLE_META[r.role];
        if (!m) return;
        if (r.role === 'instant_shop') {
          list.appendChild(h('div', 'ps-swgrp', 'ইনস্ট্যান্ট শপ'));
          (r.shops || []).forEach((s) => {
            const cur = !!(shop && shop.id === s.id);
            const row = swRow('button', 'fa-utensils', s.name, cur ? 'এখন এখানে আছেন' : 'এই দোকানে যান', cur, 'instant_shop:' + s.id);
            row.addEventListener('click', async () => {
              closeSwitch();
              if (cur) return;
              const sel = $('psShopSel');
              if (sel) sel.value = s.id;
              await pickShop(s.id);
            });
            list.appendChild(row);
          });
        } else {
          const row = swRow('a', m.icon, m.label, m.sub, false, r.role);
          row.href = m.href;
          row.addEventListener('click', () => rememberRole(r.role));
          list.appendChild(row);
        }
      });
      $('psSwOv').classList.add('active');
      getProBadges().then((b) => {
        list.querySelectorAll('[data-chip]').forEach((box) => {
          const k = box.dataset.chip;
          let c = null;
          if (b && b.roles) {
            if (k.indexOf('instant_shop:') === 0) {
              const sh = b.roles.instant_shop && b.roles.instant_shop.shops;
              c = sh ? sh[k.slice(13)] || null : null;
            } else {
              c = b.roles[k] || null;
            }
          }
          paintChips(box, c);
        });
      });
    }

    $('psSwBtn').addEventListener('click', openSwitch);
    $('psSwClose').addEventListener('click', closeSwitch);
    $('psSwOv').addEventListener('click', (e) => { if (e.target === $('psSwOv')) closeSwitch(); });

    async function init() {
      let res;
      try { res = await getMyProRoles(); } catch (_) { res = { loggedIn: true, roles: [] }; }
      if (!res.loggedIn) { window.location.replace(proLoginUrl(window.location.pathname + window.location.search)); return; }
      const role = res.roles.find((r) => r.role === 'instant_shop');
      $('psLoading').style.display = 'none';
      if (!role || !role.shops || !role.shops.length) { $('psNoAccess').style.display = 'flex'; return; }
      rememberRole('instant_shop');
      shops = role.shops;
      proRolesList = res.roles;
      if (res.roles.length > 1 || shops.length > 1) $('psSwBtn').style.display = '';
      $('psMain').style.display = '';
      if (shops.length > 1) {
        const sel = $('psShopSel');
        sel.style.display = '';
        shops.forEach((s) => { const o = document.createElement('option'); o.value = s.id; o.textContent = s.name; sel.appendChild(o); });
        sel.addEventListener('change', () => pickShop(sel.value));
      }
      const wanted = new URLSearchParams(window.location.search).get('shop');
      const start = shops.find((s) => s.id === wanted) || shops[0];
      if (shops.length > 1) $('psShopSel').value = start.id;
      await pickShop(start.id);
      pollTimer = setInterval(() => refresh(true), POLL_MS);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
    }

    init();
  </script>
</BaseLayout>
