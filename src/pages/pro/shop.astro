    function pfErr(m) { const e = $('psPfErr'); e.textContent = m || ''; e.style.display = m ? 'block' : 'none'; }
    function pfPicker() { return document.querySelector('[data-lp-id="shopprofile"]'); }
    function pfHint() {
      $('psPfHint').textContent = (pf.lat !== null && pf.lng !== null) ? 'ম্যাপ পিন সেভ আছে ✓' : 'ম্যাপে পিন বসালে রাইডার সরাসরি নেভিগেট করতে পারবে।';
