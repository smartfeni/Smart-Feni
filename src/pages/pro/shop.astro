    function pfSetPicker(address, lat, lng, up, un) {
      const w = pfPicker();
      if (!w) return;
      const set = (sel, v) => { const e = w.querySelector(sel); if (e) e.value = (v === null || v === undefined) ? '' : String(v); };
      set('.lp-address-input', address);
      set('.lp-out-address', address);
      set('.lp-out-lat', lat);
      set('.lp-out-lng', lng);
      set('.lp-out-upazila', up);
      set('.lp-out-union', un);
    }

    document.addEventListener('lp:location-changed', (e) => {
      const d = (e && e.detail) || {};
      if (d.id !== 'shopprofile') return;
      if (d.cleared) { pf.lat = null; pf.lng = null; pfHint(); return; }
      if (typeof d.lat === 'number' && typeof d.lng === 'number' && !isNaN(d.lat) && !isNaN(d.lng)) { pf.lat = d.lat; pf.lng = d.lng; }
      if (d.upazila && UPAZILAS.some((u) => u.name === d.upazila)) {
        $('psPfUp').value = d.upazila;
        pfFillUn(d.upazila);
        if (d.union) {
          const list = getUnionsOfUpazilaName(d.upazila);
          const bnU = getUnionBn(d.union);
          const hit = list.indexOf(d.union) !== -1 ? d.union : (list.indexOf(bnU) !== -1 ? bnU : null);
          if (hit) $('psPfUn').value = hit;
        }
      }
      pfHint();
