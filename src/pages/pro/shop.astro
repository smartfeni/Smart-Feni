      UPAZILAS.forEach((u) => { const o = document.createElement('option'); o.value = u.name; o.textContent = u.name; sel.appendChild(o); });
    }

    function pfFillUn(up, selected) {
      const sel = $('psPfUn');
      sel.textContent = '';
      const o0 = document.createElement('option');
      o0.value = '';
      o0.textContent = 'ইউনিয়ন বাছুন';
