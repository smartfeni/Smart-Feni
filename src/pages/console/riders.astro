---
// ============================================================
// /console/riders — ডেলিভারি হিরোর তালিকা (নতুন অ্যাপ, ধাপ ৬.১)
// ডাটা: delivery_riders + profiles (RLS: admin বা riders.view/delivery_orders.view/disputes.view)
// ট্যাব: যাচাইয়ের অপেক্ষায় / চালু (approved) / বাতিল। খোঁজা: নাম, ফোন, উপজেলা।
// ফিল্টার: এখন অনলাইন, নিজস্ব রাইডার।
// রাইড হিরো বাদ (SF, ২৬ নভে): রাইড অনলাইন/রাইড দেন এখানে দেখানো হয় না।
// কার্ডে চাপলে /console/rider?id=...
// ============================================================
export const prerender = false;
import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="ডেলিভারি হিরো" active="menu">
  <div class="cs-pad cm-page rd-page">
    <div>
      <h1 class="cs-h cm-title">ডেলিভারি হিরো</h1>
      <p class="cs-muted rd-sub" id="rdSub">রাইডারের যাচাই, অনলাইন অবস্থা ও কাজ</p>
    </div>
    <div class="rd-deny" id="rdDeny" hidden>এই পেজ দেখার অনুমতি নেই।</div>
    <div class="rd-main" id="rdMain" hidden>
      <div class="rd-tabs" id="rdTabs" role="tablist" aria-label="রাইডারের অবস্থা"></div>
      <input type="search" class="rd-q" id="rdQ" placeholder="নাম, ফোন বা উপজেলা" aria-label="রাইডার খুঁজুন" />
      <div class="rd-chips" id="rdChips" role="group" aria-label="ফিল্টার"></div>
      <div class="rd-list" id="rdList"></div>
    </div>
  </div>
</ConsoleShell>

<style is:global>
  .rd-sub { margin: 2px 0 0; }
  .rd-main { display: flex; flex-direction: column; gap: 10px; }
  .rd-tabs { display: grid; grid-template-columns: repeat(3, 1fr); background: #EFEBE5; border-radius: 14px; padding: 4px; gap: 4px; }
  .rd-tabs button { height: 42px; border: 0; border-radius: 11px; background: transparent; font: inherit; font-size: 13.5px; font-weight: 600; color: #3D4A60; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 5px; }
  .rd-tabs button[aria-selected="true"] { background: #fff; color: #1B2A4A; box-shadow: 0 1px 2px rgba(27,42,74,.12); }
  .rd-tabs i { font-style: normal; font-size: 12px; min-width: 20px; height: 20px; line-height: 20px; border-radius: 999px; background: #DCD6CD; padding: 0 6px; box-sizing: border-box; }
  .rd-tabs i.hot { background: #C2410C; color: #fff; }
  .rd-q { width: 100%; box-sizing: border-box; height: 44px; border-radius: 12px; border: 1px solid #E7E2DA; background: #fff; padding: 0 14px; font: inherit; font-size: 15px; color: #1B2A4A; }
  .rd-chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .rd-chips[hidden] { display: none; }
  .rd-chips button { flex-shrink: 0; height: 34px; padding: 0 13px; border-radius: 999px; border: 1px solid #E7E2DA; background: #fff; color: #1B2A4A; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; }
  .rd-chips button[aria-pressed="true"] { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
  .rd-chips i { font-style: normal; font-size: 11.5px; opacity: .7; }
  .rd-list { display: flex; flex-direction: column; gap: 8px; }
  .rd-card { display: flex; gap: 12px; align-items: center; background: #fff; border: 1px solid #E7E2DA; border-radius: 16px; padding: 11px 13px; color: #1B2A4A; text-decoration: none; }
  .rd-pic { position: relative; width: 52px; height: 52px; flex: none; border-radius: 50%; background: #EFEBE5 center/cover no-repeat; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 19px; color: #5F6B7E; }
  .rd-dot { position: absolute; right: 1px; bottom: 1px; width: 13px; height: 13px; border-radius: 50%; border: 2px solid #fff; background: #9AA3B2; }
  .rd-dot.on { background: #17A34A; }
  .rd-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .rd-name { font-weight: 700; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rd-line { font-size: 12.5px; color: #5F6B7E; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rd-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .rd-tag { font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 6px; background: #EEF1F5; color: #3D4A60; }
  .rd-tag.on { background: #E6F6EE; color: #17663F; }
  .rd-tag.own { background: #FFF4E0; color: #8A4B00; }
  .rd-tag.warn { background: #FDECEA; color: #B3261E; }
  .rd-empty, .rd-deny { padding: 30px 16px; text-align: center; background: #fff; border: 1px solid #E7E2DA; border-radius: 16px; color: #5F6B7E; }
  .rd-deny { font-weight: 600; color: #1B2A4A; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { onConsoleReady, canOpenAdminPath, bn, agoLabel } from '../../lib/consoleApp.js';
  import { VEHICLE_BN } from '../../lib/consoleRiders.js';

  const $ = (id) => document.getElementById(id);
  const TABS = [['pending', 'অপেক্ষায়'], ['approved', 'চালু'], ['rejected', 'বাতিল']];
  const FILTERS = [['all', 'সব', () => true], ['online', 'এখন অনলাইন', (r) => r.delivery_online], ['offline', 'অফলাইন', (r) => !r.delivery_online], ['own', 'নিজস্ব রাইডার', (r) => r.is_own]];
  const params = new URLSearchParams(location.search);
  const st = { tab: TABS.some(([k]) => k === params.get('tab')) ? params.get('tab') : 'approved', f: 'all', q: '' };
  let riders = [];

  function el(tag, cls, text) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }
  const qMatch = (r) => !st.q || [r.profiles && r.profiles.full_name, r.profiles && r.profiles.phone, r.upazila].some((v) => String(v || '').toLowerCase().includes(st.q));
  const inTab = (r) => r.verification_status === st.tab;

  function renderTabs() {
    const box = $('rdTabs');
    box.textContent = '';
    TABS.forEach(([k, name]) => {
      const b = el('button');
      b.type = 'button';
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(k === st.tab));
      b.appendChild(document.createTextNode(name));
      const n = riders.filter((r) => r.verification_status === k).length;
      if (n) b.appendChild(el('i', k === 'pending' ? 'hot' : null, bn(n)));
      b.addEventListener('click', () => { st.tab = k; st.f = 'all'; render(); });
      box.appendChild(b);
    });
  }

  function renderChips() {
    const box = $('rdChips');
    box.hidden = st.tab !== 'approved';
    box.textContent = '';
    FILTERS.forEach(([k, name, fn]) => {
      const b = el('button');
      b.type = 'button';
      b.setAttribute('aria-pressed', String(st.f === k));
      b.appendChild(document.createTextNode(name));
      b.appendChild(el('i', null, bn(riders.filter((r) => inTab(r) && qMatch(r) && fn(r)).length)));
      b.addEventListener('click', () => { st.f = k; render(); });
      box.appendChild(b);
    });
  }

  function card(r) {
    const p = r.profiles || {};
    const a = el('a', 'rd-card');
    a.href = '/console/rider?id=' + encodeURIComponent(r.id);
    const pic = el('span', 'rd-pic');
    if (r.photo_url && /^https:\/\//.test(r.photo_url)) pic.style.backgroundImage = 'url("' + encodeURI(r.photo_url) + '")';
    else pic.textContent = String(p.full_name || '?').trim().charAt(0);
    if (r.verification_status === 'approved') pic.appendChild(el('span', 'rd-dot' + (r.delivery_online ? ' on' : '')));
    a.appendChild(pic);
    const t = el('span', 'rd-t');
    t.appendChild(el('span', 'rd-name', p.full_name || 'নাম নেই'));
    t.appendChild(el('span', 'rd-line', [p.phone, VEHICLE_BN[r.vehicle_type] || r.vehicle_type, r.upazila].filter(Boolean).join(' · ')));
    const tags = el('span', 'rd-tags');
    if (r.verification_status === 'approved') {
      tags.appendChild(el('span', 'rd-tag' + (r.delivery_online ? ' on' : ''), r.delivery_online ? 'অনলাইন' : 'অফলাইন'));
      tags.appendChild(el('span', 'rd-tag', bn(r.total_completed || 0) + 'টা সম্পন্ন'));
      if (Number(r.avg_rating) > 0) tags.appendChild(el('span', 'rd-tag', '★ ' + bn(Number(r.avg_rating).toFixed(1))));
      if (r.is_own) tags.appendChild(el('span', 'rd-tag own', 'নিজস্ব'));
      if (!r.offers_delivery) tags.appendChild(el('span', 'rd-tag warn', 'ডেলিভারি নেন না'));
    } else if (r.verification_status === 'pending') {
      tags.appendChild(el('span', 'rd-tag warn', 'আবেদন ' + agoLabel(r.created_at)));
    } else if (r.rejection_reason) {
      tags.appendChild(el('span', 'rd-tag', 'কারণ: ' + String(r.rejection_reason).slice(0, 40)));
    }
    t.appendChild(tags);
    a.appendChild(t);
    return a;
  }

  function render() {
    renderTabs();
    renderChips();
    const fn = FILTERS.find(([k]) => k === st.f)[2];
    const list = riders.filter((r) => inTab(r) && qMatch(r) && (st.tab !== 'approved' || fn(r)));
    const box = $('rdList');
    box.textContent = '';
    if (!list.length) { box.appendChild(el('div', 'rd-empty', st.q ? 'কাউকে পাওয়া যায়নি।' : st.tab === 'pending' ? 'যাচাইয়ের অপেক্ষায় কেউ নেই।' : 'এখানে কেউ নেই।')); return; }
    list.forEach((r) => box.appendChild(card(r)));
  }

  async function load() {
    $('rdList').innerHTML = window.SFSkeleton ? window.SFSkeleton.html('row', 6) : '';
    const { data, error } = await supabase.from('delivery_riders')
      .select('id, vehicle_type, offers_delivery, delivery_online, is_own, photo_url, verification_status, rejection_reason, created_at, upazila, total_completed, avg_rating, profiles!delivery_riders_profile_id_fkey(full_name, phone)')
      .order('created_at', { ascending: false });
    if (error) { $('rdList').textContent = ''; $('rdList').appendChild(el('div', 'rd-empty', 'লোড করা যায়নি। একটু পরে আবার চেষ্টা করুন।')); return; }
    riders = data || [];
    // চালু ট্যাবে অনলাইনরা আগে, তারপর বেশি কাজ করা
    riders.sort((a, b) => (b.delivery_online - a.delivery_online) || ((b.total_completed || 0) - (a.total_completed || 0)));
    const ok = riders.filter((r) => r.verification_status === 'approved');
    $('rdSub').textContent = bn(ok.length) + ' জন চালু · ' + bn(ok.filter((r) => r.delivery_online).length) + ' জন এখন অনলাইন';
    if (!params.get('tab') && riders.some((r) => r.verification_status === 'pending')) st.tab = 'pending';
    render();
  }

  onConsoleReady((ctx) => {
    if (!canOpenAdminPath('/admin/delivery-riders', ctx)) { $('rdDeny').hidden = false; return; }
    $('rdMain').hidden = false;
    let t = 0;
    $('rdQ').addEventListener('input', (e) => { clearTimeout(t); t = setTimeout(() => { st.q = String(e.target.value || '').trim().toLowerCase(); render(); }, 200); });
    load();
  });
</script>
