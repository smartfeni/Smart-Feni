---
// ============================================================
// /console/search — মেনুর সব অপশন ও করণীয় এক জায়গায় খোঁজা
// ============================================================
export const prerender = false;
import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="খুঁজুন" active="search">
  <div class="cs-pad cm-page">
    <h1 class="cs-h cm-title">খুঁজুন</h1>
    <label class="cm-input">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span class="cs-sr">অপশন খুঁজুন</span>
      <input type="search" id="csQ" placeholder="যেমন: কমিশন, রাইডার, ডাক্তার, বিকাশ…" autocomplete="off" enterkeyhint="search" />
    </label>
    <div id="csRes" class="cm-tree"></div>
    <p id="csNone" class="cs-muted" hidden>এই নামে কোনো অপশন পাওয়া যায়নি</p>
  </div>
</ConsoleShell>

<script>
  import { MENU, TODO_ITEMS, visibleItem, itemEl } from '../../lib/consoleMenu.js';
  import { onConsoleReady, canOpenAdminPath } from '../../lib/consoleApp.js';

  const res = document.getElementById('csRes');
  const none = document.getElementById('csNone');
  const input = document.getElementById('csQ');

  onConsoleReady((data) => {
    const groups = [{ name: 'করণীয়', items: TODO_ITEMS }].concat(MENU.filter((m) => m.id !== 'todo'))
      .map((g) => ({ name: g.name, items: g.items.filter((it) => visibleItem(it, data, canOpenAdminPath)) }))
      .filter((g) => g.items.length);

    function render() {
      const q = input.value.trim().toLowerCase();
      res.textContent = '';
      let n = 0;
      groups.forEach((g) => {
        const hits = g.items.filter((it) => !q || (g.name + ' ' + it.name + ' ' + it.desc + ' ' + (it.keys || '')).toLowerCase().includes(q));
        if (!hits.length) return;
        const sec = document.createElement('section');
        sec.className = 'cm-sec';
        const h = document.createElement('h2');
        h.className = 'cm-group';
        h.textContent = g.name;
        const body = document.createElement('div');
        body.className = 'cm-body';
        hits.forEach((it) => body.appendChild(itemEl(it)));
        sec.append(h, body);
        res.appendChild(sec);
        n += hits.length;
      });
      none.hidden = n > 0;
    }

    input.addEventListener('input', render);
    render();
    input.focus();
  });
</script>
