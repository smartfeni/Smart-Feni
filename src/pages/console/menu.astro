---
// ============================================================
// /console/menu — মেনু-ট্রি (কাজের ধরন অনুযায়ী বিভাগ, src/lib/consoleMenu.js)
// বিভাগগুলো ডিফল্টে ভাঁজ করা; খোলা/বন্ধ ফোনে মনে রাখে। #বিভাগ-id দিয়ে সরাসরি খোলে।
// স্টাফ শুধু নিজের অনুমতির অপশন দেখে; খালি বিভাগ লুকানো।
// ============================================================
export const prerender = false;
import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="মেনু" active="menu">
  <div class="cs-pad cm-page">
    <h1 class="cs-h cm-title">মেনু</h1>
    <p class="cs-muted cm-hint"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg> চিহ্ন = এখনো পুরনো প্যানেলে খোলে</p>
    <div id="cmTree" class="cm-tree"></div>
  </div>
</ConsoleShell>

<script>
  import { MENU, visibleItem, itemEl } from '../../lib/consoleMenu.js';
  import { onConsoleReady, canOpenAdminPath, bn } from '../../lib/consoleApp.js';

  const KEY = 'sf_console_menu_open';
  const tree = document.getElementById('cmTree');

  function readOpen() {
    try { return JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch (_) { return []; }
  }
  function saveOpen(ids) {
    try { localStorage.setItem(KEY, JSON.stringify(ids)); } catch (_) { /* উপেক্ষা */ }
  }

  onConsoleReady((data) => {
    const open = new Set(readOpen());
    const hash = location.hash.replace('#', '');
    if (hash) open.add(hash);

    MENU.forEach((sec) => {
      const items = sec.items.filter((it) => visibleItem(it, data, canOpenAdminPath));
      if (!items.length) return;

      const box = document.createElement('section');
      box.className = 'cm-sec';
      box.id = sec.id;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cm-head';
      btn.setAttribute('aria-controls', 'cmb-' + sec.id);
      const ic = document.createElement('span');
      ic.className = 'cm-ic';
      ic.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' + sec.icon + '</svg>';
      const txt = document.createElement('span');
      txt.className = 'cm-head-t';
      const b = document.createElement('b');
      b.textContent = sec.name;
      const s = document.createElement('small');
      s.textContent = sec.desc;
      txt.appendChild(b);
      txt.appendChild(s);
      const count = document.createElement('span');
      count.className = 'cm-count';
      count.textContent = bn(items.length);
      const chev = document.createElement('span');
      chev.className = 'cm-chev';
      chev.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
      btn.append(ic, txt, count, chev);

      const body = document.createElement('div');
      body.className = 'cm-body';
      body.id = 'cmb-' + sec.id;
      items.forEach((it) => body.appendChild(itemEl(it)));

      const set = (on) => { btn.setAttribute('aria-expanded', String(on)); body.hidden = !on; };
      set(open.has(sec.id));
      btn.addEventListener('click', () => {
        const on = btn.getAttribute('aria-expanded') !== 'true';
        set(on);
        if (on) open.add(sec.id); else open.delete(sec.id);
        saveOpen([...open]);
      });

      box.append(btn, body);
      tree.appendChild(box);
    });

    if (hash) document.getElementById(hash)?.scrollIntoView({ block: 'start' });
  });
</script>
