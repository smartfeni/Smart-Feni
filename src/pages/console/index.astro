---
// ============================================================
// /console — নতুন অ্যাডমিন অ্যাপের হোম
// ডাটা: admin_dashboard_summary() (এক কলে KPI, করণীয়, ৭ দিনের চার্ট; শুধু অ্যাডমিন/মডারেটর)।
// প্রতিটা সেকশন ভাঁজ করা যায় (হেডারে ট্যাপ); কোনটা ভাঁজ করা, ফোনে মনে রাখে (localStorage)।
// স্টাফ শুধু নিজের অনুমতির কার্ড দেখে; সাম্প্রতিক কাজ শুধু সুপার অ্যাডমিন।
// ৬০ সেকেন্ড পরপর (পেজ খোলা থাকলে) নিজে রিফ্রেশ।
// ============================================================
export const prerender = false;
import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="হোম" active="home">
  <div class="cs-pad hm-page">
    <div class="hm-head">
      <span class="cs-muted" id="hmDate"></span>
      <h1 class="cs-h">আজকের অবস্থা</h1>
    </div>

    <section class="hm-sec" data-fold="kpi">
      <button type="button" class="hm-fold" aria-expanded="true" aria-controls="hmKpiBody">
        <h2 class="cs-h">মূল সংখ্যা</h2>
        <svg class="hm-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div id="hmKpiBody" class="hm-body"><div class="hm-kpis cs-card" id="hmKpis"></div></div>
    </section>

    <section class="hm-sec" data-fold="todo" id="hmTodoSec">
      <button type="button" class="hm-fold" aria-expanded="true" aria-controls="hmTodoBody">
        <h2 class="cs-h">করণীয়</h2>
        <span class="cs-muted hm-fold-note" id="hmTodoNote"></span>
        <svg class="hm-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div id="hmTodoBody" class="hm-body"><div class="cs-card" id="hmTodo"></div></div>
    </section>

    <div class="hm-charts">
      <section class="hm-sec" data-fold="users" id="hmUsersSec">
        <button type="button" class="hm-fold" aria-expanded="true" aria-controls="hmUsersBody">
          <h2 class="cs-h">নতুন ইউজার</h2>
          <span class="cs-muted hm-fold-note" id="hmUsersNote"></span>
          <svg class="hm-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="hmUsersBody" class="hm-body"><div class="cs-card hm-chart" id="hmUsersChart"></div></div>
      </section>

      <section class="hm-sec" data-fold="deliveries" id="hmDelivSec">
        <button type="button" class="hm-fold" aria-expanded="true" aria-controls="hmDelivBody">
          <h2 class="cs-h">ডেলিভারি অর্ডার</h2>
          <span class="cs-muted hm-fold-note" id="hmDelivNote"></span>
          <svg class="hm-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="hmDelivBody" class="hm-body"><div class="cs-card hm-chart" id="hmDelivChart"></div></div>
      </section>
    </div>

    <section class="hm-sec" data-fold="recent" id="hmRecentSec" hidden>
      <button type="button" class="hm-fold" aria-expanded="true" aria-controls="hmRecentBody">
        <h2 class="cs-h">সাম্প্রতিক কাজ</h2>
        <span class="cs-muted hm-fold-note hm-lock"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>শুধু সুপার অ্যাডমিন</span>
        <svg class="hm-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div id="hmRecentBody" class="hm-body">
        <div class="cs-card" id="hmRecent"></div>
        <a href="/console/activity" class="hm-link hm-all">সব কাজ দেখুন</a>
      </div>
    </section>

    <section class="hm-sec" data-fold="quick">
      <button type="button" class="hm-fold" aria-expanded="true" aria-controls="hmQuickBody">
        <h2 class="cs-h">দ্রুত যান</h2>
        <svg class="hm-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div id="hmQuickBody" class="hm-body">
        <div class="hm-quick" id="hmQuick"></div>
        <a href="/console/menu" class="hm-link hm-all">পুরো মেনু</a>
      </div>
    </section>
  </div>
</ConsoleShell>

<style is:global>
  .hm-page { display: flex; flex-direction: column; gap: 22px; }
  .hm-head { display: flex; flex-direction: column; gap: 2px; margin-top: 6px; }
  .hm-head h1 { margin: 0; font-size: 26px; }

  .hm-sec { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .hm-fold { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 0; border: 0; background: transparent; font: inherit; color: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .hm-fold h2 { margin: 0; font-size: 19px; }
  .hm-fold-note { margin-left: auto; font-size: 13px; }
  .hm-chev { width: 18px !important; height: 18px !important; color: #7A8597; transition: transform .2s; }
  .hm-fold-note + .hm-chev { margin-left: 0; }
  .hm-fold > h2 + .hm-chev { margin-left: auto; }
  .hm-fold[aria-expanded="false"] .hm-chev { transform: rotate(-90deg); }
  .hm-lock { display: flex; align-items: center; gap: 4px; font-size: 12px; }
  .hm-lock svg { width: 12px !important; height: 12px !important; }
  .hm-body { display: flex; flex-direction: column; gap: 10px; }
  .hm-link { font-size: 13px; color: #C2410C !important; font-weight: 600; padding: 4px 0; }
  .hm-all { align-self: flex-start; }

  .hm-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px, 45%), 1fr)); overflow: hidden; }
  .hm-kpi { padding: 16px; display: flex; flex-direction: column; gap: 6px; border-right: 1px solid #EFEBE5; border-bottom: 1px solid #EFEBE5; margin: 0 -1px -1px 0; }
  .hm-kpi .l { font-size: 13px; color: #5F6B7E; }
  .hm-kpi .v { font-size: 34px; line-height: 1; display: flex; align-items: baseline; gap: 8px; }
  .hm-kpi .s { font-size: 12px; color: #5F6B7E; }
  .hm-dot { width: 8px; height: 8px; border-radius: 50%; background: #1F9254; display: inline-block; }

  .hm-todo { display: flex; align-items: center; gap: 14px; padding: 14px 16px; min-height: 48px; }
  .hm-todo + .hm-todo { border-top: 1px solid #EFEBE5; }
  .hm-todo-ic { width: 38px; height: 38px; border-radius: 11px; background: #F1F3F6; color: #5F6B7E; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .hm-todo-ic svg { width: 19px !important; height: 19px !important; }
  .hm-todo.hot .hm-todo-ic { background: #FDEEE6; color: #C2410C; }
  .hm-todo-t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
  .hm-todo-t b { font-weight: 600; font-size: 15px; }
  .hm-todo-t small { font-size: 12.5px; color: #5F6B7E; }
  .hm-todo-n { font-size: 20px; color: #9AA3B2; }
  .hm-todo.hot .hm-todo-n { color: #C2410C; }

  .hm-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 22px; align-items: start; }
  .hm-chart { padding: 18px 16px 12px; display: flex; flex-direction: column; gap: 8px; }
  .hm-bars { height: 150px; display: flex; align-items: flex-end; gap: 10px; border-bottom: 1px solid #EFEBE5; }
  .hm-bar { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 5px; }
  .hm-bar span { font-size: 11.5px; color: #5F6B7E; font-weight: 500; }
  .hm-bar div { width: 100%; max-width: 48px; border-radius: 6px 6px 2px 2px; background: #1B2A4A; min-height: 3px; }
  .hm-bar.today div { background: #E8541C; }
  .hm-days { display: flex; gap: 10px; }
  .hm-days span { flex: 1; text-align: center; font-size: 12px; color: #5F6B7E; }

  .hm-quick { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(150px, 46%), 1fr)); gap: 10px; }
  .hm-q { background: #fff; border: 1px solid #E7E2DA; border-radius: 16px; padding: 14px; min-height: 84px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
  .hm-q:hover { border-color: #D8D1C6; }
  .hm-q i { color: #3D4A60; font-size: 17px; }
  .hm-q span { font-weight: 600; font-size: 14.5px; }

  .hm-r { display: flex; gap: 12px; padding: 13px 16px; }
  .hm-r + .hm-r { border-top: 1px solid #EFEBE5; }
  .hm-ini { width: 32px; height: 32px; border-radius: 50%; background: #EEF1F5; font-weight: 600; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .hm-r-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .hm-r-text > span:first-child { font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; }
  .hm-r-text b { font-weight: 600; }
  .hm-r-sub { font-size: 12.5px; color: #5F6B7E; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hm-empty { padding: 22px 16px; text-align: center; color: #5F6B7E; font-size: 14px; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { ADMIN_PAGES } from '../../lib/adminPages.js';
  import { onConsoleReady, canOpenAdminPath, agoLabel, bn, ENTITY_BN, ACTION_META } from '../../lib/consoleApp.js';

  const $ = (id) => document.getElementById(id);
  const FOLD_KEY = 'sf_console_fold';
  const QUICK = ['/admin/delivery-orders', '/admin/manual-orders', '/admin/listings', '/admin/users',
    '/admin/delivery-shops', '/admin/doctors', '/admin/notifications', '/admin/errors'];
  const DAY_BN = ['রবি', 'সোম', 'মঙ্গল', 'বুধ', 'বৃহ', 'শুক্র', 'শনি'];
  const ICONS = {
    error: '<path d="M12 3 2.5 20h19L12 3z"/><path d="M12 10v4M12 17h.01"/>',
    listing: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
    shop: '<path d="M4 9h16l-1.5-5h-13z"/><path d="M5 9v11h14V9"/><path d="M10 20v-6h4v6"/>',
  };

  let ctx = null;

  function el(tag, cls, text) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  // ---------- ভাঁজ ----------
  function readFold() {
    try { return JSON.parse(localStorage.getItem(FOLD_KEY) || '{}') || {}; } catch (_) { return {}; }
  }
  function initFolds() {
    const saved = readFold();
    document.querySelectorAll('.hm-sec[data-fold]').forEach((sec) => {
      const key = sec.dataset.fold;
      const btn = sec.querySelector('.hm-fold');
      const body = document.getElementById(btn.getAttribute('aria-controls'));
      const set = (open) => {
        btn.setAttribute('aria-expanded', String(open));
        body.hidden = !open;
      };
      set(saved[key] !== false);
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        set(open);
        const s = readFold();
        s[key] = open;
        try { localStorage.setItem(FOLD_KEY, JSON.stringify(s)); } catch (_) { /* উপেক্ষা */ }
      });
    });
  }

  // ---------- KPI ----------
  function kpi(label, value, sub, dot) {
    const c = el('div', 'hm-kpi');
    c.appendChild(el('span', 'l', label));
    const v = el('span', 'v cs-num', value);
    if (dot) v.appendChild(el('span', 'hm-dot'));
    c.appendChild(v);
    c.appendChild(el('span', 's', sub));
    return c;
  }

  function compare(now, prev) {
    if (now === prev) return 'গতকালের সমান';
    const d = now - prev;
    return 'গতকাল ' + bn(prev) + ' · ' + (d > 0 ? '+' : '−') + bn(Math.abs(d));
  }

  function sum(a) { return (a || []).reduce((x, y) => x + (Number(y) || 0), 0); }

  function renderKpis(s) {
    const box = $('hmKpis');
    box.textContent = '';
    const can = (h) => canOpenAdminPath(h, ctx);
    if (can('/admin/users')) {
      box.appendChild(kpi('নতুন ইউজার · ২৪ ঘণ্টা', bn(s.users_24h), compare(s.users_24h, s.users_prev_24h)));
    }
    if (can('/admin/delivery-riders')) {
      box.appendChild(kpi('অনলাইন রাইডার', bn(s.riders_online), 'এখন সক্রিয়', true));
    }
    if (can('/admin/delivery-orders')) {
      box.appendChild(kpi('ডেলিভারি অর্ডার · ২৪ ঘণ্টা', bn(s.deliveries_24h), compare(s.deliveries_24h, s.deliveries_prev_24h)));
    }
    if (can('/admin/users')) {
      box.appendChild(kpi('মোট ইউজার', bn(Number(s.users_total).toLocaleString('en-US')), '৭ দিনে +' + bn(sum(s.users_7d))));
    }
    if (!box.children.length) box.closest('.hm-sec').hidden = true;
  }

  // ---------- করণীয় ----------
  function todoRow(href, icon, title, sub, n) {
    const a = el('a', 'hm-todo' + (n > 0 ? ' hot' : ''));
    a.href = href;
    const ic = el('span', 'hm-todo-ic');
    ic.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' + ICONS[icon] + '</svg>';
    a.appendChild(ic);
    const t = el('span', 'hm-todo-t');
    t.appendChild(el('b', null, title));
    t.appendChild(el('small', null, n > 0 ? sub : 'সব দেখা হয়েছে'));
    a.appendChild(t);
    a.appendChild(el('span', 'hm-todo-n cs-num', bn(n)));
    return a;
  }

  function renderTodo(s) {
    const box = $('hmTodo');
    box.textContent = '';
    const items = [];
    if (canOpenAdminPath('/admin/errors', ctx, true)) items.push(['/admin/errors', 'error', 'অমীমাংসিত এরর', 'অ্যাপ ও সার্ভারের সমস্যা', s.errors_open]);
    if (canOpenAdminPath('/admin/listings', ctx)) items.push(['/admin/listings', 'listing', 'লিস্টিং অনুমোদন', 'অনুমোদনের অপেক্ষায়', s.listings_pending]);
    if (canOpenAdminPath('/admin/delivery-shop-applications', ctx)) items.push(['/admin/delivery-shop-applications', 'shop', 'শপ আবেদন', 'নতুন আবেদন', s.shop_apps_pending]);
    if (!items.length) { $('hmTodoSec').hidden = true; return; }
    items.forEach((i) => box.appendChild(todoRow(...i)));
    const left = items.filter((i) => i[4] > 0).length;
    $('hmTodoNote').textContent = left ? bn(left) + 'টা কাজ বাকি' : 'সব শেষ';
  }

  // ---------- চার্ট ----------
  function renderBars(boxId, values, days, label) {
    const box = $(boxId);
    box.textContent = '';
    const vals = (values || []).map((v) => Number(v) || 0);
    const max = Math.max(1, ...vals);
    const bars = el('div', 'hm-bars');
    bars.setAttribute('role', 'img');
    bars.setAttribute('aria-label', label + ': ' + vals.map(bn).join(', '));
    const dayRow = el('div', 'hm-days');
    vals.forEach((v, i) => {
      const b = el('div', 'hm-bar' + (i === vals.length - 1 ? ' today' : ''));
      b.appendChild(el('span', null, bn(v)));
      const bar = el('div');
      bar.style.height = Math.round((v / max) * 104) + 'px';
      b.appendChild(bar);
      bars.appendChild(b);
      const d = days && days[i] ? new Date(days[i] + 'T00:00:00') : null;
      dayRow.appendChild(el('span', null, i === vals.length - 1 ? 'আজ' : (d ? DAY_BN[d.getDay()] : '')));
    });
    box.appendChild(bars);
    box.appendChild(dayRow);
  }

  function renderCharts(s) {
    if (canOpenAdminPath('/admin/users', ctx)) {
      renderBars('hmUsersChart', s.users_7d, s.days, 'গত ৭ দিনে প্রতিদিনের নতুন ইউজার');
      $('hmUsersNote').textContent = 'গত ৭ দিন · মোট ' + bn(sum(s.users_7d));
    } else $('hmUsersSec').hidden = true;
    if (canOpenAdminPath('/admin/delivery-orders', ctx)) {
      renderBars('hmDelivChart', s.deliveries_7d, s.days, 'গত ৭ দিনে প্রতিদিনের ডেলিভারি অর্ডার');
      $('hmDelivNote').textContent = 'গত ৭ দিন · মোট ' + bn(sum(s.deliveries_7d));
    } else $('hmDelivSec').hidden = true;
  }

  async function loadSummary(first) {
    if (first) {
      ['hmKpis', 'hmTodo'].forEach((id) => { $(id).innerHTML = window.SFSkeleton ? window.SFSkeleton.html('row', 2) : ''; });
    }
    const { data, error } = await supabase.rpc('admin_dashboard_summary');
    if (error || !data) {
      if (first) {
        $('hmKpis').textContent = '';
        $('hmKpis').appendChild(el('div', 'hm-empty', 'সংখ্যা লোড করা যায়নি — একটু পরে আবার চেষ্টা করুন'));
        $('hmTodo').textContent = '';
      }
      return;
    }
    renderKpis(data);
    renderTodo(data);
    renderCharts(data);
  }

  // ---------- সাম্প্রতিক কাজ ----------
  async function renderRecent() {
    $('hmRecentSec').hidden = false;
    const box = $('hmRecent');
    if (!box.children.length) box.innerHTML = window.SFSkeleton ? window.SFSkeleton.html('row', 3) : '';
    const { data, error } = await supabase
      .from('admin_audit_log')
      .select('id, created_at, actor_name, action, entity, entity_label')
      .order('created_at', { ascending: false })
      .limit(5);
    box.textContent = '';
    if (error || !data || !data.length) {
      box.appendChild(el('div', 'hm-empty', error ? 'লোড করা যায়নি' : 'এখনো কোনো কাজ লগ হয়নি'));
      return;
    }
    data.forEach((r) => {
      const meta = ACTION_META[r.action] || ACTION_META.other;
      const row = el('div', 'hm-r');
      row.appendChild(el('span', 'hm-ini', (r.actor_name || '?').trim().charAt(0)));
      const t = el('div', 'hm-r-text');
      const line = el('span');
      line.appendChild(el('b', null, r.actor_name || 'অজানা'));
      line.appendChild(document.createTextNode(' ' + (ENTITY_BN[r.entity] || r.entity) + ' ' + meta.verb));
      t.appendChild(line);
      t.appendChild(el('span', 'hm-r-sub', [r.entity_label, agoLabel(r.created_at)].filter(Boolean).join(' · ')));
      row.appendChild(t);
      const tag = el('span', 'cs-tag', meta.tag);
      tag.style.background = meta.bg;
      tag.style.color = meta.fg;
      row.appendChild(tag);
      box.appendChild(row);
    });
  }

  function renderQuick() {
    const box = $('hmQuick');
    QUICK.map((h) => ADMIN_PAGES.find((p) => p.href === h))
      .filter((p) => p && canOpenAdminPath(p.href, ctx, p.adminOnly))
      .forEach((p) => {
        const a = el('a', 'hm-q');
        a.href = p.href;
        const i = el('i', 'fas ' + p.icon);
        i.setAttribute('aria-hidden', 'true');
        a.appendChild(i);
        a.appendChild(el('span', null, p.short || p.name));
        box.appendChild(a);
      });
  }

  $('hmDate').textContent = new Date().toLocaleDateString('bn-BD', { weekday: 'long', day: 'numeric', month: 'long' });
  initFolds();

  onConsoleReady((data) => {
    ctx = data;
    renderQuick();
    loadSummary(true);
    if (data.isSuper) renderRecent();
    setInterval(() => {
      if (document.visibilityState !== 'visible') return;
      loadSummary(false);
      if (data.isSuper) renderRecent();
    }, 60000);
  });
</script>
