---
// ============================================================
// /console/shop-commission — দোকানপ্রতি কমিশন (নতুন অ্যাপ, ধাপ ১৩)
// পুরনো /admin/delivery-shop-settings থেকে তৈরি; একই টেবিল/RPC/API, DB বদল নেই। অনুমতি পুরনো পেজের একই।
// ============================================================
export const prerender = false;

import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="দোকানপ্রতি কমিশন" active="menu">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="dss">
    <div id="cxDeny" class="cx-deny" hidden>এই পেজ দেখার অনুমতি নেই।</div>

    <div id="adminGuardedContent" hidden>
      <div class="dss-head">
        <div class="dss-head-in">
          <a href="/console/shops" class="dss-round" aria-label="দোকানের তালিকায় ফিরুন">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </a>
          <div class="dss-title">
            <h1>দোকানের কমিশন</h1>
            <span>কুইক ডেলিভারি · কমিশন ও ডেলিভারির ধরন</span>
          </div>
          <img src="/market/icons/bags.webp" alt="" aria-hidden="true" class="dss-hic" />
        </div>
      </div>

      <div class="dss-body">
        <section class="dss-bulk" aria-label="সব দোকানে একসাথে কমিশন">
          <div>
            <b>সব দোকানে একসাথে</b>
            <small>বাছাই করা তালিকার সব দোকানে একই কমিশন বসবে</small>
          </div>
          <label class="dss-pct"><input type="number" id="dssBulk" min="0" max="100" step="0.5" inputmode="decimal" aria-label="সবার কমিশন %" placeholder="০" /><span>%</span></label>
          <button type="button" class="dss-btn" id="dssBulkGo">বসান</button>
        </section>

        <label class="dss-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input type="search" id="dssQ" placeholder="দোকানের নাম খুঁজুন" aria-label="দোকান খুঁজুন" />
        </label>

        <div class="dss-tabs" role="tablist" aria-label="দোকানের ধরন">
          <button type="button" role="tab" class="dss-tab" data-t="all" aria-selected="true">সব <b id="cAll">০</b></button>
          <button type="button" role="tab" class="dss-tab" data-t="instant" aria-selected="false">এখনই <b id="cInstant">০</b></button>
          <button type="button" role="tab" class="dss-tab" data-t="preorder" aria-selected="false">প্রি-অর্ডার <b id="cPre">০</b></button>
        </div>

        <div id="dssList" class="dss-list" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <style is:global>
    .dss { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #F4F6FA; min-height: 70vh; padding-bottom: 100px; overflow-x: hidden; }
    #adminGuardedContent[hidden], .cx-deny[hidden] { display: none !important; }
    .cx-deny { padding: 40px 16px; text-align: center; color: #64748B; font-weight: 600; }
    .dss-loading { padding: 80px 16px; text-align: center; color: #5B6B86; }
    .dss-head { position: relative; left: 50%; width: 100vw; margin-left: -50vw; background: linear-gradient(135deg, #1B2A4A, #2C4372); color: #fff; }
    .dss-head-in { max-width: 640px; margin: 0 auto; padding: 14px 16px; display: flex; align-items: center; gap: 12px; min-height: 76px; }
    .dss-round { width: 44px; height: 44px; border-radius: 22px; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; flex: none; }
    .dss-round svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
    .dss-title { flex: 1; min-width: 0; }
    .dss-title h1 { margin: 0; font-size: 20px; color: #fff; }
    .dss-title span { font-size: 13px; opacity: .85; }
    .dss-hic { width: 46px; height: 46px; }
    .dss-body { max-width: 640px; margin: 0 auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 12px; }
    .dss-bulk { display: flex; align-items: center; gap: 10px; background: linear-gradient(135deg, #FFF4EC, #FFE6D6); border: 1.5px solid #FFD3BF; border-radius: 18px; padding: 12px 14px; }
    .dss-bulk > div { flex: 1; min-width: 0; }
    .dss-bulk b { display: block; font-size: 15px; }
    .dss-bulk small { display: block; font-size: 12.5px; color: #6B4A33; }
    .dss-pct { display: inline-flex; align-items: center; gap: 4px; background: #fff; border: 1.5px solid #E2E8F0; border-radius: 12px; padding: 0 10px; height: 44px; }
    .dss-pct input { width: 52px; border: 0; outline: 0; font: inherit; font-size: 16px; font-weight: 700; color: #1B2A4A; text-align: right; background: none; }
    .dss-pct span { font-weight: 700; color: #5B6B86; }
    .dss-btn { min-height: 44px; padding: 0 16px; border: 0; border-radius: 12px; background: #FF6B35; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
    .dss-btn:disabled { opacity: .5; }
    .dss-search { display: flex; align-items: center; gap: 10px; height: 50px; padding: 0 14px; background: #fff; border: 1.5px solid #E2E8F0; border-radius: 16px; }
    .dss-search svg { width: 20px; height: 20px; fill: none; stroke: #5B6B86; stroke-width: 2.2; stroke-linecap: round; flex: none; }
    .dss-search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; background: none; color: #1B2A4A; }
    .dss-tabs { display: flex; gap: 8px; }
    .dss-tab { flex: 1; min-height: 44px; border-radius: 14px; border: 1.5px solid #E2E8F0; background: #fff; font: inherit; font-weight: 700; color: #1B2A4A; cursor: pointer; }
    .dss-tab b { margin-left: 4px; font-size: 12px; background: #EEF2F8; border-radius: 8px; padding: 1px 7px; }
    .dss-tab[aria-selected='true'] { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
    .dss-tab[aria-selected='true'] b { background: rgba(255,255,255,.18); }
    .dss-list { display: flex; flex-direction: column; gap: 10px; }
    .dss-card { background: #fff; border-radius: 18px; padding: 12px 14px; box-shadow: 0 2px 10px rgba(27,42,74,.06); display: flex; flex-direction: column; gap: 10px; }
    .dss-top { display: flex; align-items: center; gap: 12px; }
    .dss-img { width: 48px; height: 48px; border-radius: 14px; background: #FFF1E8 center/cover no-repeat; flex: none; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #E2531F; font-size: 20px; }
    .dss-name { flex: 1; min-width: 0; }
    .dss-name b { display: block; font-size: 15.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dss-tags { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 3px; }
    .dss-tag { font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: #EEF2F8; color: #3B4B6B; }
    .dss-tag.on { background: #E6F6EE; color: #17663F; }
    .dss-tag.off { background: #FDECEA; color: #A3261B; }
    .dss-tag.old { background: #FFF1E8; color: #C2410C; }
    .dss-row { display: flex; align-items: center; gap: 8px; }
    .dss-seg { display: flex; flex: 1; background: #F4F6FA; border-radius: 12px; padding: 3px; gap: 3px; }
    .dss-seg button { flex: 1; min-height: 38px; border: 0; border-radius: 10px; background: none; font: inherit; font-weight: 700; font-size: 13.5px; color: #5B6B86; cursor: pointer; }
    .dss-seg button[aria-pressed='true'] { background: #fff; color: #1B2A4A; box-shadow: 0 2px 6px rgba(27,42,74,.12); }
    .dss-save { min-height: 44px; padding: 0 14px; border: 1.5px solid #1B2A4A; border-radius: 12px; background: #fff; color: #1B2A4A; font: inherit; font-weight: 700; cursor: pointer; }
    .dss-save.dirty { background: #1B2A4A; color: #fff; }
    .dss-empty { text-align: center; padding: 30px 10px; color: #5B6B86; background: #fff; border-radius: 18px; }
    .dss-tab:focus-visible, .dss-btn:focus-visible, .dss-save:focus-visible, .dss-seg button:focus-visible { outline: 3px solid #FF6B35; outline-offset: 2px; }
  </style>

  <script>
    import { onConsoleReady, canOpenAdminPath } from '../../lib/consoleApp.js';
    import { supabase } from '../../lib/supabase.js';

    const $ = (id) => document.getElementById(id);
    const bn = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[d]);
    const toast = (m, t) => { if (window.showToast) window.showToast(m, t || 'info'); };
    function mk(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined && text !== null) e.textContent = text; return e; }

    let shops = [];
    let tab = 'all';
    let q = '';

    function visible() {
      const n = q.toLowerCase();
      return shops.filter((s) => (tab === 'all' || s.delivery_kind === tab) && (!n || String(s.name || '').toLowerCase().includes(n)));
    }

    function card(s) {
      const c = mk('div', 'dss-card');
      const top = mk('div', 'dss-top');
      const img = mk('div', 'dss-img');
      const pic = s.logo_url || s.image_url;
      if (pic) img.style.backgroundImage = 'url("' + encodeURI(pic) + '")'; else img.textContent = String(s.name || '?').trim().charAt(0);
      top.appendChild(img);
      const nm = mk('div', 'dss-name');
      nm.appendChild(mk('b', '', s.name));
      const tags = mk('div', 'dss-tags');
      const shown = s.is_active ? ['on', 'দেখাচ্ছে'] : s.is_test ? ['', 'শুধু স্টাফ'] : ['off', 'লুকানো'];
      tags.appendChild(mk('span', 'dss-tag ' + shown[0], shown[1]));
      if (s.legacy_shop_id) tags.appendChild(mk('span', 'dss-tag old', 'অনলাইন শপ থেকে'));
      if (s.upazila) tags.appendChild(mk('span', 'dss-tag', s.upazila));
      nm.appendChild(tags);
      top.appendChild(nm);
      c.appendChild(top);

      let kind = s.delivery_kind;
      const row = mk('div', 'dss-row');
      const seg = mk('div', 'dss-seg');
      seg.setAttribute('role', 'group');
      seg.setAttribute('aria-label', 'ডেলিভারির ধরন');
      const pct = mk('label', 'dss-pct');
      const inp = mk('input');
      inp.type = 'number'; inp.min = '0'; inp.max = '100'; inp.step = '0.5'; inp.inputMode = 'decimal';
      inp.value = String(Number(s.commission_pct || 0));
      inp.setAttribute('aria-label', s.name + ' কমিশন %');
      pct.appendChild(inp); pct.appendChild(mk('span', '', '%'));
      const save = mk('button', 'dss-save', 'সেভ');
      save.type = 'button';
      const markDirty = () => save.classList.toggle('dirty', kind !== s.delivery_kind || Number(inp.value) !== Number(s.commission_pct || 0));
      [['instant', 'এখনই'], ['preorder', 'প্রি-অর্ডার']].forEach(([k, l]) => {
        const b = mk('button', '', l); b.type = 'button';
        b.setAttribute('aria-pressed', String(kind === k));
        b.addEventListener('click', () => { kind = k; seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); markDirty(); });
        seg.appendChild(b);
      });
      inp.addEventListener('input', markDirty);
      save.addEventListener('click', async () => {
        const v = Number(inp.value);
        if (!Number.isFinite(v) || v < 0 || v > 100) { toast('কমিশন ০ থেকে ১০০-এর মধ্যে দিন', 'warning'); return; }
        save.disabled = true;
        const { data, error } = await supabase.rpc('admin_set_shop_market_opts', { p_shop_id: s.id, p_commission: v, p_kind: kind });
        save.disabled = false;
        if (error || !data || !data.ok) { toast('সেভ হয়নি' + (error ? ': ' + error.message : ''), 'error'); return; }
        s.commission_pct = v; s.delivery_kind = kind; markDirty();
        toast(s.name + ' — সেভ হয়েছে', 'success');
        counts();
      });
      row.appendChild(seg); row.appendChild(pct); row.appendChild(save);
      c.appendChild(row);
      return c;
    }

    function counts() {
      $('cAll').textContent = bn(shops.length);
      $('cInstant').textContent = bn(shops.filter((s) => s.delivery_kind === 'instant').length);
      $('cPre').textContent = bn(shops.filter((s) => s.delivery_kind === 'preorder').length);
    }

    function render() {
      counts();
      const box = $('dssList');
      box.textContent = '';
      const list = visible();
      if (!list.length) { box.appendChild(mk('div', 'dss-empty', 'কোনো দোকান পাওয়া যায়নি।')); return; }
      list.forEach((s) => box.appendChild(card(s)));
    }

    async function load() {
      const box = $('dssList');
      if ((window.SFSkeleton || window.SFLoader)) box.innerHTML = window.SFSkeleton ? window.SFSkeleton.html('row', 4) : window.SFLoader.block('লোড হচ্ছে…');
      const { data, error } = await supabase
        .from('delivery_shops')
        .select('id, name, image_url, logo_url, upazila, is_active, is_test, legacy_shop_id, delivery_kind, commission_pct, sort_order')
        .order('is_active', { ascending: false })
        .order('sort_order', { ascending: true })
        .order('name', { ascending: true });
      if (error) { box.textContent = ''; box.appendChild(mk('div', 'dss-empty', 'লোড করা যায়নি: ' + error.message)); return; }
      shops = data || [];
      render();
    }

    document.querySelectorAll('.dss-tab').forEach((b) => b.addEventListener('click', () => {
      tab = b.dataset.t;
      document.querySelectorAll('.dss-tab').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      render();
    }));
    let t = null;
    $('dssQ').addEventListener('input', (e) => { clearTimeout(t); t = setTimeout(() => { q = e.target.value.trim(); render(); }, 150); });

    $('dssBulkGo').addEventListener('click', async () => {
      const v = Number($('dssBulk').value);
      if ($('dssBulk').value === '' || !Number.isFinite(v) || v < 0 || v > 100) { toast('কমিশন ০ থেকে ১০০-এর মধ্যে দিন', 'warning'); return; }
      const list = visible();
      if (!list.length) return;
      if (!confirm(bn(list.length) + 'টি দোকানে কমিশন ' + bn(v) + '% বসবে। নিশ্চিত?')) return;
      const btn = $('dssBulkGo');
      btn.disabled = true;
      let fail = 0;
      for (const s of list) {
        const { data, error } = await supabase.rpc('admin_set_shop_market_opts', { p_shop_id: s.id, p_commission: v, p_kind: null });
        if (error || !data || !data.ok) fail++; else s.commission_pct = v;
      }
      btn.disabled = false;
      render();
      toast(fail ? bn(fail) + 'টি দোকানে সেভ হয়নি' : 'সব দোকানে কমিশন বসেছে', fail ? 'error' : 'success');
    });

    let started = false;
    onConsoleReady((ctx) => {
      if (started) return;
      started = true;
      if (!canOpenAdminPath('/admin/delivery-shop-settings', ctx)) { document.getElementById('cxDeny').hidden = false; return; }
      document.getElementById('adminGuardedContent').hidden = false;
      load();
    });
  </script>
</ConsoleShell>
