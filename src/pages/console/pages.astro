---
// ============================================================
// /console/pages — সব অ্যাডমিন পেজ (খোঁজ + গ্রুপ)
// তালিকা: src/lib/adminPages.js (পুরনো প্যানেলের দ্রুত মেনুর একই তালিকা)।
// যে পেজ এখনো /console-এ নতুন করে বানানো হয়নি, সেটা পুরনো /admin-এ খোলে।
// স্টাফ শুধু নিজের অনুমতির পেজ দেখে (consoleApp.canOpenAdminPath)।
// ============================================================
export const prerender = false;
import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="সব পেজ" active="pages">
  <div class="cs-pad pg-page">
    <h1 class="cs-h pg-title">সব পেজ</h1>
    <label class="pg-input">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span class="al-sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">পেজ খুঁজুন</span>
      <input type="search" id="pgQ" placeholder="পেজ খুঁজুন: অর্ডার, ডাক্তার, হিসাব…" autocomplete="off" />
    </label>
    <div id="pgList" class="pg-list"></div>
    <p id="pgNone" class="cs-muted" hidden>এই নামে কোনো পেজ নেই</p>
  </div>
</ConsoleShell>

<style is:global>
  .pg-page { display: flex; flex-direction: column; gap: 14px; }
  .pg-title { margin: 6px 0 0; font-size: 26px; }
  .pg-input { display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 14px; background: #fff; border: 1px solid #E7E2DA; border-radius: 12px; max-width: 560px; }
  .pg-input svg { width: 18px; height: 18px; color: #5F6B7E; }
  .pg-input input { border: 0; outline: 0; background: transparent; flex: 1; min-width: 0; font: inherit; font-size: 14.5px; color: inherit; }
  .pg-list { display: flex; flex-direction: column; gap: 18px; }
  .pg-group h2 { margin: 0 0 8px; font-size: 13px; font-weight: 600; color: #5F6B7E; }
  .pg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); background: #fff; border: 1px solid #E7E2DA; border-radius: 18px; overflow: hidden; }
  .pg-item { display: flex; align-items: center; gap: 12px; padding: 13px 16px; min-height: 48px; box-sizing: border-box; border-bottom: 1px solid #EFEBE5; }
  .pg-item:hover { background: #FBFAF8; }
  .pg-ic { width: 36px; height: 36px; border-radius: 10px; background: #F1F3F6; color: #3D4A60; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 15px; }
  .pg-item span:last-child { font-weight: 600; font-size: 14.5px; }
</style>

<script>
  import { ADMIN_PAGES, ADMIN_GROUPS } from '../../lib/adminPages.js';
  import { onConsoleReady, canOpenAdminPath } from '../../lib/consoleApp.js';

  const list = document.getElementById('pgList');
  const none = document.getElementById('pgNone');
  const input = document.getElementById('pgQ');

  function render(pages, q) {
    list.textContent = '';
    const needle = q.trim().toLowerCase();
    let shown = 0;
    ADMIN_GROUPS.forEach((g) => {
      const items = pages.filter((p) => p.group === g.id && (!needle || p.search.includes(needle)));
      if (!items.length) return;
      const sec = document.createElement('section');
      sec.className = 'pg-group';
      const h = document.createElement('h2');
      h.textContent = g.name;
      sec.appendChild(h);
      const grid = document.createElement('div');
      grid.className = 'pg-grid';
      items.forEach((p) => {
        const a = document.createElement('a');
        a.className = 'pg-item';
        a.href = p.href;
        const ic = document.createElement('span');
        ic.className = 'pg-ic';
        const i = document.createElement('i');
        i.className = 'fas ' + p.icon;
        i.setAttribute('aria-hidden', 'true');
        ic.appendChild(i);
        const t = document.createElement('span');
        t.textContent = p.name;
        a.appendChild(ic);
        a.appendChild(t);
        grid.appendChild(a);
        shown++;
      });
      sec.appendChild(grid);
      list.appendChild(sec);
    });
    none.hidden = shown > 0;
  }

  onConsoleReady((data) => {
    const pages = ADMIN_PAGES.filter((p) => canOpenAdminPath(p.href, data, p.adminOnly));
    render(pages, '');
    input.addEventListener('input', () => render(pages, input.value));
    if (new URLSearchParams(location.search).get('q')) input.focus();
  });
</script>
