---
// ============================================================
// /console/todo — করণীয়: সব অনুমোদন/যাচাই/অভিযোগ/পেমেন্ট এক তালিকায়
// এই ধাপে: তালিকা ও লিংক (পুরনো প্যানেলে খোলে)। পরের ধাপে সংখ্যা ও একটানা তালিকা।
// ============================================================
export const prerender = false;
import ConsoleShell from '../../components/console/ConsoleShell.astro';
---

<ConsoleShell title="করণীয়" active="todo">
  <div class="cs-pad cm-page">
    <h1 class="cs-h cm-title">করণীয়</h1>
    <p class="cs-muted" style="margin:0">অপেক্ষায় থাকা অনুমোদন, যাচাই, অভিযোগ ও পেমেন্ট</p>
    <div class="cm-body cs-card" id="tdList"></div>
  </div>
</ConsoleShell>

<script>
  import { TODO_ITEMS, visibleItem, itemEl } from '../../lib/consoleMenu.js';
  import { onConsoleReady, canOpenAdminPath } from '../../lib/consoleApp.js';

  onConsoleReady((data) => {
    const box = document.getElementById('tdList');
    TODO_ITEMS.filter((it) => visibleItem(it, data, canOpenAdminPath)).forEach((it) => box.appendChild(itemEl(it)));
  });
</script>
