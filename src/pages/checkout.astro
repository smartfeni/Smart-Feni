---
// ============================================================
// পেজ: /checkout — কার্টের প্রোডাক্ট চেকআউট
// প্রতিটা শপের জন্য আলাদা order + order_items তৈরি হয় (এক কার্টে
// একাধিক শপ থাকলে একসাথে একাধিক অর্ডার যাবে)। পেমেন্ট নেই —
// শুধু কাস্টমার তথ্য জমা হয়, শপ ওউনার কল করে কনফার্ম করবে।
// সফল হলে product_events এ 'checkout' ইভেন্ট লগ হয় ও কার্ট খালি হয়।
// প্রতিটা শপের নিজস্ব নাম্বার দিয়ে কল/হোয়াটসঅ্যাপ বাটন দেখায়
// (কোনো প্ল্যাটফর্ম-লেভেল নাম্বার হার্ডকোড না)।
//
// PHASE G: প্রতিটা অর্ডার তৈরি হওয়ার পর /api/shop-telegram-notify কল
// হয় (fire-and-forget) — শপ ওউনার Telegram কানেক্ট করা থাকলে সাথে
// সাথে নোটিফিকেশন পাবে। ব্যর্থ হলেও চেকআউট ফ্লো আটকাবে না।
//
// আপডেট: WhatsApp লিংক এখন toWhatsAppNumber() হেল্পার দিয়ে কান্ট্রি
// কোডসহ (88) বসানো হচ্ছে — প্রবাস থেকে ক্লিক করলে আগে নম্বর খুঁজে
// পেত না, এখন ঠিকভাবে কাজ করবে।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="চেকআউট | স্মার্ট ফেনী">
  <div class="checkout-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-lock"></i></div>
        <h2>লগইন করুন</h2>
        <p>চেকআউট করতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="emptyCartNotice" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-cart-arrow-down"></i></div>
        <h2>কার্ট খালি</h2>
        <p>চেকআউট করার আগে কার্টে প্রোডাক্ট যোগ করুন</p>
        <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
      </div>

      <div id="checkoutContent" style="display:none;">
        <h1 class="checkout-title"><i class="fas fa-bag-shopping"></i> চেকআউট</h1>

        <div class="order-summary" id="orderSummary"></div>

        <div class="delivery-note-banner">
          <i class="fas fa-truck-fast"></i>
          <span>হোম ডেলিভারির জন্য দূরত্ব অনুযায়ী অতিরিক্ত চার্জ প্রযোজ্য হতে পারে</span>
        </div>

        <div class="checkout-form-card">
          <h3><span class="form-icon-badge"><i class="fas fa-user"></i></span> ডেলিভারি তথ্য</h3>

          <p class="form-msg" id="checkoutMsg"></p>

          <label class="form-label">আপনার নাম</label>
          <input type="text" class="form-input" id="customerNameInput" placeholder="আপনার সম্পূর্ণ নাম" />

          <label class="form-label">ফোন নম্বর</label>
          <input type="text" class="form-input" id="customerPhoneInput" placeholder="01xxxxxxxxx" />

          <label class="form-label">ঠিকানা</label>
          <textarea class="form-input" id="customerAddressInput" rows="3" placeholder="ডেলিভারির সম্পূর্ণ ঠিকানা"></textarea>

          <p class="cod-note"><i class="fas fa-circle-info"></i> কোনো অনলাইন পেমেন্ট নেই — অর্ডার জমা দেওয়ার পর শপ ওউনার আপনাকে কল করে অর্ডার কনফার্ম করবেন</p>
        </div>

        <div id="checkoutFooterSpacer"></div>
      </div>

      <div id="successState" class="status-box success-box" style="display:none;">
        <div class="success-check-badge"><i class="fas fa-check"></i></div>
        <h2>অর্ডার সফল হয়েছে</h2>
        <p>শীঘ্রই শপ ওউনার আপনাকে কল করে অর্ডার কনফার্ম করবেন। জরুরি প্রয়োজনে নিচের শপের নাম্বারে সরাসরি যোগাযোগ করতে পারেন</p>

        <div id="shopContactList" class="shop-contact-list"></div>

        <div class="success-links">
          <a href="/my-orders" class="primary-link-btn">আমার অর্ডার দেখুন</a>
          <a href="/shop" class="secondary-link-btn">আরও কেনাকাটা করুন</a>
        </div>
      </div>

    </div>

    <div id="checkoutFooter" class="checkout-footer" style="display:none;">
      <div class="container">
        <button class="place-order-btn" id="placeOrderBtn" type="button">
          <i class="fas fa-check"></i> <span id="placeOrderBtnText">অর্ডার করুন</span>
        </button>
      </div>
    </div>
  </div>

  <style is:global>
    .checkout-page {
      min-height: 70vh;
      padding: 28px 0 40px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 50px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-icon-badge {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFF0EA, #FFE3D5);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }

    .status-icon-badge i {
      font-size: 1.7rem;
      color: #FF6B35;
    }

    .status-box h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .primary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 12px 26px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
      transition: all 0.2s ease;
    }

    .primary-link-btn:hover {
      background: #e85a28;
      transform: translateY(-1px);
    }

    .secondary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #F4F7FC;
      color: #1B2A4A;
      text-decoration: none;
      padding: 12px 26px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.88rem;
      transition: all 0.2s ease;
    }

    .secondary-link-btn:hover {
      background: #EAF0F8;
    }

    .success-box {
      max-width: 460px;
    }

    .success-check-badge {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: linear-gradient(135deg, #E9F9EF, #D3F3DF);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
      box-shadow: 0 8px 20px rgba(27, 122, 60, 0.18);
    }

    .success-check-badge i {
      font-size: 2rem;
      color: #1B7A3C;
    }

    .success-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
    }

    .shop-contact-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 22px;
      text-align: left;
    }

    .shop-contact-row {
      background: #F8FAFC;
      border: 1px solid #F0F3F8;
      border-radius: 16px;
      padding: 14px;
    }

    .shop-contact-row .contact-shop-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .shop-contact-row .contact-shop-name .shop-icon-badge {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      flex-shrink: 0;
    }

    .support-btn-row {
      display: flex;
      gap: 10px;
    }

    .support-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.8rem;
      transition: all 0.15s ease;
    }

    .call-btn {
      background: #EAF2FF;
      color: #2563EB;
    }

    .call-btn:hover {
      background: #2563EB;
      color: #fff;
    }

    .wa-btn {
      background: #E9F9EF;
      color: #1EA952;
    }

    .wa-btn:hover {
      background: #1EA952;
      color: #fff;
    }

    .checkout-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    .checkout-title i {
      color: #FF6B35;
    }

    .order-summary {
      max-width: 560px;
      margin: 0 auto 14px;
      background: #fff;
      border-radius: 20px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .summary-shop-block + .summary-shop-block {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px dashed #E5EAF0;
    }

    .summary-shop-name {
      font-size: 0.87rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .summary-shop-name .shop-icon-badge {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      flex-shrink: 0;
    }

    .summary-item-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: #5A6E85;
      padding: 3px 0;
    }

    .summary-subtotal-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-top: 8px;
    }

    .summary-grand-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.98rem;
      font-weight: 800;
      color: #1B2A4A;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1.5px dashed #E5EAF0;
    }

    .delivery-note-banner {
      max-width: 560px;
      margin: 0 auto 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: #FFF7EC;
      border: 1px solid #FFE4BE;
      color: #A6660A;
      padding: 12px 14px;
      border-radius: 14px;
      font-size: 0.8rem;
      font-weight: 600;
      line-height: 1.4;
    }

    .delivery-note-banner i {
      font-size: 1rem;
      color: #E8930C;
      flex-shrink: 0;
    }

    .checkout-form-card {
      max-width: 560px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      padding: 22px 20px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .checkout-form-card h3 {
      font-size: 1rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .form-icon-badge {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      flex-shrink: 0;
    }

    .form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input {
      width: 100%;
      padding: 13px 15px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
      box-sizing: border-box;
      transition: all 0.15s ease;
    }

    .form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
      box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1);
    }

    .cod-note {
      font-size: 0.78rem;
      color: #8FA0BC;
      background: #F8FAFC;
      padding: 12px 14px;
      border-radius: 12px;
      margin-top: 18px;
      line-height: 1.5;
    }

    #checkoutFooterSpacer {
      height: 158px;
    }

    .checkout-footer {
      position: fixed;
      left: 0;
      right: 0;
      bottom: calc(70px + env(safe-area-inset-bottom));
      background: #fff;
      box-shadow: 0 -6px 24px rgba(15, 23, 42, 0.08);
      padding: 14px 0;
      z-index: 999;
      border-top: 1px solid #F0F3F8;
    }

    .checkout-footer .container {
      max-width: 560px;
    }

    .place-order-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 15px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.94rem;
      cursor: pointer;
      box-shadow: 0 10px 22px rgba(255, 107, 53, 0.32);
      transition: all 0.2s ease;
    }

    .place-order-btn:hover {
      background: #e85a28;
    }

    .place-order-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
      transform: none;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { toWhatsAppNumber } from '../lib/whatsapp.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const emptyCartNotice = document.getElementById('emptyCartNotice');
    const checkoutContent = document.getElementById('checkoutContent');
    const checkoutFooter = document.getElementById('checkoutFooter');
    const successState = document.getElementById('successState');
    const orderSummary = document.getElementById('orderSummary');
    const shopContactList = document.getElementById('shopContactList');

    const checkoutMsg = document.getElementById('checkoutMsg');
    const nameInput = document.getElementById('customerNameInput');
    const phoneInput = document.getElementById('customerPhoneInput');
    const addressInput = document.getElementById('customerAddressInput');
    const placeOrderBtn = document.getElementById('placeOrderBtn');
    const placeOrderBtnText = document.getElementById('placeOrderBtnText');

    let currentUserId = null;
    let shopGroups = {};

    function convertBanglaDigits(str) {
      const banglaDigits = '০১২৩৪৫৬৭৮৯';
      return String(str).replace(/[০-৯]/g, (d) => banglaDigits.indexOf(d));
    }

    function priceNum(p) {
      if (p === null || p === undefined) return 0;
      let str = convertBanglaDigits(String(p));
      str = str.replace(/,/g, '');
      const match = str.match(/[0-9]+(\.[0-9]+)?/);
      if (!match) return 0;
      const n = parseFloat(match[0]);
      return isNaN(n) ? 0 : n;
    }

    function showMsg(text) {
      checkoutMsg.textContent = text;
      checkoutMsg.className = 'form-msg show-error';
    }

    async function loadCartForCheckout() {
      const { data: cartItems, error } = await supabase
        .from('cart_items')
        .select('id, quantity, listing_id, listings(id, title, price, images, user_id)')
        .eq('user_id', currentUserId);

      if (error) {
        console.error('চেকআউট লোড এরর:', error.message);
        return;
      }

      const items = (cartItems || []).filter((c) => c.listings);

      loadingState.style.display = 'none';

      if (items.length === 0) {
        emptyCartNotice.style.display = 'block';
        return;
      }

      const ownerIds = [...new Set(items.map((i) => i.listings.user_id))];
      const { data: shops } = await supabase.from('shops').select('*').in('owner_id', ownerIds);
      const shopByOwner = {};
      (shops || []).forEach((s) => { shopByOwner[s.owner_id] = s; });

      shopGroups = {};
      items.forEach((item) => {
        const ownerId = item.listings.user_id;
        if (!shopGroups[ownerId]) {
          shopGroups[ownerId] = { shop: shopByOwner[ownerId], items: [] };
        }
        shopGroups[ownerId].items.push(item);
      });

      renderSummary();
      checkoutContent.style.display = 'block';
      checkoutFooter.style.display = 'block';
    }

    function renderSummary() {
      orderSummary.innerHTML = '';
      let grand = 0;

      Object.values(shopGroups).forEach((group) => {
        const shopName = group.shop?.name || 'অজানা শপ';
        const block = document.createElement('div');
        block.className = 'summary-shop-block';

        let subtotal = 0;
        const linesHtml = group.items.map((item) => {
          const listing = item.listings;
          const unitPrice = priceNum(listing.price);
          const lineTotal = unitPrice * item.quantity;
          subtotal += lineTotal;
          return `<div class="summary-item-line"><span>${listing.title || ''} × ${item.quantity}</span><span>৳${lineTotal}</span></div>`;
        }).join('');

        block.innerHTML = `
          <div class="summary-shop-name"><span class="shop-icon-badge"><i class="fas fa-store"></i></span> ${shopName}</div>
          ${linesHtml}
          <div class="summary-subtotal-line"><span>সাবটোটাল</span><span>৳${subtotal}</span></div>
        `;

        grand += subtotal;
        orderSummary.appendChild(block);
      });

      const grandEl = document.createElement('div');
      grandEl.className = 'summary-grand-line';
      grandEl.innerHTML = `<span>সর্বমোট</span><span>৳${grand}</span>`;
      orderSummary.appendChild(grandEl);
    }

    function renderShopContacts() {
      shopContactList.innerHTML = '';

      Object.values(shopGroups).forEach((group) => {
        const shop = group.shop;
        if (!shop?.phone) return;

        const row = document.createElement('div');
        row.className = 'shop-contact-row';
        row.innerHTML = `
          <div class="contact-shop-name"><span class="shop-icon-badge"><i class="fas fa-store"></i></span> ${shop.name || 'শপ'}</div>
          <div class="support-btn-row">
            <a href="tel:${shop.phone}" class="support-btn call-btn"><i class="fas fa-phone"></i> কল করুন</a>
            <a href="https://wa.me/${toWhatsAppNumber(shop.phone)}" target="_blank" rel="noopener" class="support-btn wa-btn"><i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ</a>
          </div>
        `;
        shopContactList.appendChild(row);
      });
    }

    placeOrderBtn?.addEventListener('click', async () => {
      checkoutMsg.className = 'form-msg';

      const customerName = nameInput.value.trim();
      const customerPhone = phoneInput.value.trim();
      const customerAddress = addressInput.value.trim();

      if (!customerName || !customerPhone) {
        showMsg('নাম ও ফোন নম্বর দিন');
        return;
      }

      placeOrderBtnText.textContent = 'অর্ডার হচ্ছে...';
      placeOrderBtn.disabled = true;

      try {
        for (const group of Object.values(shopGroups)) {
          const { data: order, error: orderError } = await supabase
            .from('orders')
            .insert({
              shop_id: group.shop?.id || null,
              user_id: currentUserId,
              customer_name: customerName,
              customer_phone: customerPhone,
              customer_address: customerAddress,
              status: 'pending',
            })
            .select()
            .single();

          if (orderError) throw orderError;

          const orderItemsPayload = group.items.map((item) => ({
            order_id: order.id,
            listing_id: item.listings.id,
            title: item.listings.title,
            price: item.listings.price,
            quantity: item.quantity,
          }));

          const { error: itemsError } = await supabase.from('order_items').insert(orderItemsPayload);
          if (itemsError) throw itemsError;

          // Telegram নোটিফিকেশন — fire-and-forget, ব্যর্থ হলেও checkout আটকাবে না
          fetch('/api/shop-telegram-notify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: order.id }),
          }).catch(() => {});

          const checkoutEvents = group.items.map((item) => ({
            event_type: 'checkout',
            shop_id: group.shop?.id || null,
            listing_id: item.listings.id,
            user_id: currentUserId,
          }));
          await supabase.from('product_events').insert(checkoutEvents);
        }

        await supabase.from('cart_items').delete().eq('user_id', currentUserId);

        renderShopContacts();
        checkoutContent.style.display = 'none';
        checkoutFooter.style.display = 'none';
        successState.style.display = 'block';
      } catch (err) {
        showMsg('অর্ডার ব্যর্থ: ' + err.message);
        placeOrderBtnText.textContent = 'অর্ডার করুন';
        placeOrderBtn.disabled = false;
      }
    });

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;

      const { data: profile } = await supabase
        .from('profiles')
        .select('full_name, phone')
        .eq('id', currentUserId)
        .single();

      if (profile?.full_name) nameInput.value = profile.full_name;
      if (profile?.phone) phoneInput.value = profile.phone;

      await loadCartForCheckout();
    }

    init();
  </script>
</BaseLayout>