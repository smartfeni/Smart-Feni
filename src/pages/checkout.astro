---
// ============================================================
// পেজ: /checkout — কার্টের প্রোডাক্ট চেকআউট
// প্রতিটা শপের জন্য আলাদা order + order_items তৈরি হয় (এক কার্টে
// একাধিক শপ থাকলে একসাথে একাধিক অর্ডার যাবে)। পেমেন্ট নেই —
// শুধু কাস্টমার তথ্য জমা হয়, শপ ওউনার কল করে কনফার্ম করবে।
// সফল হলে product_events এ 'checkout' ইভেন্ট লগ হয় ও কার্ট খালি হয়।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="চেকআউট | স্মার্ট ফেনী">
  <div class="checkout-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <i class="fas fa-lock"></i>
        <h2>লগইন করুন</h2>
        <p>চেকআউট করতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="emptyCartNotice" class="status-box" style="display:none;">
        <i class="fas fa-cart-arrow-down"></i>
        <h2>কার্ট খালি</h2>
        <p>চেকআউট করার আগে কার্টে প্রোডাক্ট যোগ করুন</p>
        <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
      </div>

      <div id="checkoutContent" style="display:none;">
        <h1 class="checkout-title"><i class="fas fa-bag-shopping"></i> চেকআউট</h1>

        <div class="order-summary" id="orderSummary"></div>

        <div class="checkout-form-card">
          <h3><i class="fas fa-user"></i> ডেলিভারি তথ্য</h3>

          <p class="form-msg" id="checkoutMsg"></p>

          <label class="form-label">আপনার নাম</label>
          <input type="text" class="form-input" id="customerNameInput" placeholder="আপনার সম্পূর্ণ নাম" />

          <label class="form-label">ফোন নম্বর</label>
          <input type="text" class="form-input" id="customerPhoneInput" placeholder="01xxxxxxxxx" />

          <label class="form-label">ঠিকানা</label>
          <textarea class="form-input" id="customerAddressInput" rows="3" placeholder="ডেলিভারির সম্পূর্ণ ঠিকানা"></textarea>

          <p class="cod-note"><i class="fas fa-circle-info"></i> কোনো অনলাইন পেমেন্ট নেই — অর্ডার জমা দেওয়ার পর শপ ওউনার আপনাকে কল করে অর্ডার কনফার্ম করবেন</p>

          <button class="place-order-btn" id="placeOrderBtn" type="button">
            <i class="fas fa-check"></i> <span id="placeOrderBtnText">অর্ডার করুন</span>
          </button>
        </div>
      </div>

      <div id="successState" class="status-box" style="display:none;">
        <i class="fas fa-circle-check" style="color:#1B7A3C;"></i>
        <h2>অর্ডার সফল হয়েছে ✓</h2>
        <p>শীঘ্রই শপ ওউনার আপনাকে কল করে অর্ডার কনফার্ম করবেন</p>
        <a href="/shop" class="primary-link-btn">আরও কেনাকাটা করুন</a>
      </div>

    </div>
  </div>

  <style>
    .checkout-page {
      min-height: 70vh;
      padding: 32px 0 100px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 60px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-box i {
      font-size: 2.4rem;
      color: #FF6B35;
      margin-bottom: 16px;
    }

    .status-box h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-bottom: 18px;
    }

    .primary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 11px 24px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.88rem;
    }

    .checkout-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    .checkout-title i {
      color: #FF6B35;
    }

    .order-summary {
      max-width: 560px;
      margin: 0 auto 18px;
      background: #fff;
      border-radius: 20px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .summary-shop-block + .summary-shop-block {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid #F0F3F8;
    }

    .summary-shop-name {
      font-size: 0.86rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .summary-shop-name i {
      color: #FF6B35;
    }

    .summary-item-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: #5A6E85;
      padding: 3px 0;
    }

    .summary-subtotal-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-top: 6px;
    }

    .summary-grand-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.95rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1.5px solid #F0F3F8;
    }

    .checkout-form-card {
      max-width: 560px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      padding: 22px 20px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .checkout-form-card h3 {
      font-size: 0.98rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .checkout-form-card h3 i {
      color: #FF6B35;
    }

    .form-msg {
      display: none;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 10px 14px;
      border-radius: 12px;
      margin-bottom: 12px;
      text-align: center;
    }

    .form-msg.show-error {
      display: block;
      background: #FFF0EA;
      color: #D14343;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1B2A4A;
      margin-bottom: 6px;
      margin-top: 14px;
    }

    .form-label:first-of-type {
      margin-top: 0;
    }

    .form-input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #E5EAF0;
      font-size: 0.9rem;
      font-family: inherit;
      color: #1B2A4A;
      background: #FBFCFE;
      resize: vertical;
    }

    .form-input:focus {
      outline: none;
      border-color: #FF6B35;
      background: #fff;
    }

    .cod-note {
      font-size: 0.78rem;
      color: #8FA0BC;
      background: #F8FAFC;
      padding: 10px 12px;
      border-radius: 12px;
      margin-top: 16px;
      line-height: 1.5;
    }

    .place-order-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      margin-top: 18px;
    }

    .place-order-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const emptyCartNotice = document.getElementById('emptyCartNotice');
    const checkoutContent = document.getElementById('checkoutContent');
    const successState = document.getElementById('successState');
    const orderSummary = document.getElementById('orderSummary');

    const checkoutMsg = document.getElementById('checkoutMsg');
    const nameInput = document.getElementById('customerNameInput');
    const phoneInput = document.getElementById('customerPhoneInput');
    const addressInput = document.getElementById('customerAddressInput');
    const placeOrderBtn = document.getElementById('placeOrderBtn');
    const placeOrderBtnText = document.getElementById('placeOrderBtnText');

    let currentUserId = null;
    let shopGroups = {};

    function priceNum(p) {
      const n = parseFloat(String(p).replace(/[^0-9.]/g, ''));
      return isNaN(n) ? 0 : n;
    }

    function showMsg(text) {
      checkoutMsg.textContent = text;
      checkoutMsg.className = 'form-msg show-error';
    }

    async function loadCartForCheckout() {
      const { data: cartItems, error } = await supabase
        .from('cart_items')
        .select('id, quantity, listing_id, listings(id, title, price, images, user_id)')
        .eq('user_id', currentUserId);

      if (error) {
        console.error('চেকআউট লোড এরর:', error.message);
        return;
      }

      const items = (cartItems || []).filter((c) => c.listings);

      loadingState.style.display = 'none';

      if (items.length === 0) {
        emptyCartNotice.style.display = 'block';
        return;
      }

      const ownerIds = [...new Set(items.map((i) => i.listings.user_id))];
      const { data: shops } = await supabase.from('shops').select('*').in('owner_id', ownerIds);
      const shopByOwner = {};
      (shops || []).forEach((s) => { shopByOwner[s.owner_id] = s; });

      shopGroups = {};
      items.forEach((item) => {
        const ownerId = item.listings.user_id;
        if (!shopGroups[ownerId]) {
          shopGroups[ownerId] = { shop: shopByOwner[ownerId], items: [] };
        }
        shopGroups[ownerId].items.push(item);
      });

      renderSummary();
      checkoutContent.style.display = 'block';
    }

    function renderSummary() {
      orderSummary.innerHTML = '';
      let grand = 0;

      Object.values(shopGroups).forEach((group) => {
        const shopName = group.shop?.name || 'অজানা শপ';
        const block = document.createElement('div');
        block.className = 'summary-shop-block';

        let subtotal = 0;
        const linesHtml = group.items.map((item) => {
          const listing = item.listings;
          const lineTotal = priceNum(listing.price) * item.quantity;
          subtotal += lineTotal;
          return `<div class="summary-item-line"><span>${listing.title || ''} × ${item.quantity}</span><span>৳${lineTotal}</span></div>`;
        }).join('');

        block.innerHTML = `
          <div class="summary-shop-name"><i class="fas fa-store"></i> ${shopName}</div>
          ${linesHtml}
          <div class="summary-subtotal-line"><span>সাবটোটাল</span><span>৳${subtotal}</span></div>
        `;

        grand += subtotal;
        orderSummary.appendChild(block);
      });

      const grandEl = document.createElement('div');
      grandEl.className = 'summary-grand-line';
      grandEl.innerHTML = `<span>সর্বমোট</span><span>৳${grand}</span>`;
      orderSummary.appendChild(grandEl);
    }

    placeOrderBtn?.addEventListener('click', async () => {
      checkoutMsg.className = 'form-msg';

      const customerName = nameInput.value.trim();
      const customerPhone = phoneInput.value.trim();
      const customerAddress = addressInput.value.trim();

      if (!customerName || !customerPhone) {
        showMsg('নাম ও ফোন নম্বর দিন');
        return;
      }

      placeOrderBtnText.textContent = 'অর্ডার হচ্ছে...';
      placeOrderBtn.disabled = true;

      try {
        for (const group of Object.values(shopGroups)) {
          const { data: order, error: orderError } = await supabase
            .from('orders')
            .insert({
              shop_id: group.shop?.id || null,
              user_id: currentUserId,
              customer_name: customerName,
              customer_phone: customerPhone,
              customer_address: customerAddress,
              status: 'pending',
            })
            .select()
            .single();

          if (orderError) throw orderError;

          const orderItemsPayload = group.items.map((item) => ({
            order_id: order.id,
            listing_id: item.listings.id,
            title: item.listings.title,
            price: item.listings.price,
            quantity: item.quantity,
          }));

          const { error: itemsError } = await supabase.from('order_items').insert(orderItemsPayload);
          if (itemsError) throw itemsError;

          const checkoutEvents = group.items.map((item) => ({
            event_type: 'checkout',
            shop_id: group.shop?.id || null,
            listing_id: item.listings.id,
            user_id: currentUserId,
          }));
          await supabase.from('product_events').insert(checkoutEvents);
        }

        await supabase.from('cart_items').delete().eq('user_id', currentUserId);

        checkoutContent.style.display = 'none';
        successState.style.display = 'block';
      } catch (err) {
        showMsg('অর্ডার ব্যর্থ: ' + err.message);
        placeOrderBtnText.textContent = 'অর্ডার করুন';
        placeOrderBtn.disabled = false;
      }
    });

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;

      const { data: profile } = await supabase
        .from('profiles')
        .select('full_name, phone')
        .eq('id', currentUserId)
        .single();

      if (profile?.full_name) nameInput.value = profile.full_name;
      if (profile?.phone) phoneInput.value = profile.phone;

      await loadCartForCheckout();
    }

    init();
  </script>
</BaseLayout>