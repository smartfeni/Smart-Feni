---
// ============================================================
// পেজ: প্রোফাইল এডিট
// ব্র্যান্ড: স্মার্ট ফেনী
// (আগের সব হিস্ট্রি/কমেন্ট অপরিবর্তিত)
//
// আপডেট (নতুন): "ডেলিভারি হিরো" পুরো সেকশন সরিয়ে আলাদা /delivery-hero
// পেজে নেওয়া হয়েছে। car-rental কার্ড, প্রোফাইল ভিউ, পাসওয়ার্ড —
// অপরিবর্তিত।
//
// আপডেট (আগের সেশন): ব্লাড ডোনার টগলের নিচে ঐচ্ছিক "সংগঠন" সিলেক্ট
// ড্রপডাউন যোগ করা হলো — registered ক্লাব লিস্ট থেকে বেছে নিলে
// profiles.club_id সেট হয় (ইনস্ট্যান্ট সেভ, ডোনার টগলের মতোই)।
// কিছু না বাছলে "কোনো সংগঠন না" ডিফল্ট থাকে — সম্পূর্ণ ঐচ্ছিক।
//
// আপডেট (এই সেশন — Notification Preferences, Phase 6): প্রোফাইল
// কার্ডের নিচে নতুন "নোটিফিকেশন সেটিংস" কার্ড যোগ হলো — প্রতিটা
// ক্যাটাগরির (লিস্টিং স্ট্যাটাস, ডেলিভারি হিরো, ব্লাড রিকোয়েস্ট,
// অফার, মেসেজ) জন্য আলাদা টগল সুইচ, ইনস্ট্যান্ট সেভ। বিদ্যমান
// donor-toggle-row/donor-toggle-switch স্টাইল রিইউজ করা হয়েছে,
// নতুন CSS লাগেনি। notification_preferences টেবিলে upsert হয়
// (রো না থাকলে তৈরি, থাকলে আপডেট)। System ক্যাটাগরি টগলযোগ্য না
// (জরুরি তথ্য, সবসময় চালু থাকবে) তাই এখানে দেখানো হয়নি।
//
// আপডেট (নোটিফিকেশন চ্যানেল): ওই ৫টা টগল সরানো হয়েছে — পুশ পাঠানোর সময়
// এখন আর এগুলো যাচাই হয় না। অ্যাপে প্রতিটা ধরনের নোটিফিকেশন ফোনের
// Settings → Apps → Smart Feni → Notifications এ আলাদা চ্যানেল হিসেবে
// নিয়ন্ত্রণ করা যায়। কার্ডে এখন নোটিফিকেশনের অবস্থা (চালু/বন্ধ), "চালু করুন"
// বাটন ও সেটিংসের নির্দেশনা দেখায়। notification_preferences টেবিল অক্ষুণ্ণ।
//
// আপডেট (N17): পাসওয়ার্ড সফলভাবে বদলালে নিজেকে নিরাপত্তা সতর্কতা
// (security ক্যাটাগরি) পাঠানো হয় notify_security_event() RPC দিয়ে।
//
// আপডেট (ব্লাড ডোনার + নোটিফিকেশন): ডোনার চালু করার সময় অ্যাপে অনুমতি না
// থাকলে Android এর ডায়ালগ চাওয়া হয় (smartfeni:ask-push ইভেন্ট), আর ডোনার
// চালু থাকা অবস্থায় ফোনে নোটিফিকেশন বন্ধ থাকলে ডোনার কার্ডের নিচে সতর্কবার্তা
// দেখায় (রক্তের জরুরি অনুরোধ না পৌঁছানোর ঝুঁকি)।
//
// আপডেট (এরর মনিটরিং, ধাপ ৬): সেভ/লোড ফেইল (প্রোফাইল, সংগঠন, ডোনার টগল,
// গাড়ি, ছবি আপলোড, ফোন/পাসওয়ার্ড বদলের সার্ভার এরর) এখন errorReporter.js দিয়ে
// অ্যাডমিন এরর লগে (/admin/errors) যায়। ইউজারের ভুল (খালি নাম, ভুল পাসওয়ার্ড,
// ডুপ্লিকেট ইমেইল ইত্যাদি) রিপোর্ট হয় না। UI/মেসেজ/আচরণ অপরিবর্তিত।
//
// আপডেট (NOT_DONOR): সাইনআপে ব্লাড গ্রুপ বাধ্যতামূলক হওয়ায় "ডোনার হতে চাই না"
// অপশন যোগ হয়েছে (profiles.blood_group = 'NOT_DONOR')। এখানে: এডিট ড্রপডাউনে
// ওই অপশন সবার আগে; ভিউ ব্যাজে "ডোনার নন" দেখায়; ডোনার টগল চালু করা যায় না
// (ব্লাড গ্রুপ বদলাতে বলা হয়); সেভের সময় NOT_DONOR হলে is_blood_donor বন্ধ হয়।
//
// আপডেট (ছবি আপলোড): ছবি ফেইল হলে ইউজারকে কারণ + সমাধান দেখায়; বাকি তথ্য সেভ হয়,
// ফর্ম খোলা থাকে ও ছবি রাখা থাকে (আবার সেভ চাপা যায়)।
//
// আপডেট (একাধিক গাড়ি): একজন ইউজারের একাধিক car-rental লিস্টিং থাকতে পারে (আগে
// .maybeSingle() ২+ রো পেলে PGRST116 দিত, কার্ড লুকিয়ে যেত)। এখন প্রতিটা গাড়ির আলাদা
// ভাঁজ-করা কার্ড (ক্লিক করলে খোলে; একটাই থাকলে খোলা), শিরোনামে লিস্টিংয়ের title।
// প্রতিটার গাড়ির ধরন (price) ও বিবরণ নিজের id ধরে সেভ হয়। অনলাইন/অফলাইন টগল সরানো
// হয়েছে — গাড়ির লিস্টিং এখন সাধারণ লিস্টিংয়ের মতো।
//
// আপডেট (গাড়ি → আমার পোস্ট): গাড়ির লিস্টিং কার্ড ও কোড এই পেজ থেকে সরানো হয়েছে —
// সব গাড়ি এখন /my-listings (আমার পোস্ট)-এ ক্যাটাগরি গ্রুপে দেখা ও এডিট করা যায়
// (এডিট অন্য লিস্টিংয়ের মতোই রিভিউয়ে যায়)।
//
// আপডেট (ডোনার টগল → গ্রুপ পিকার): সাইনআপে ডোনার টগল অফ থাকে। যার ব্লাড গ্রুপ আছে সে
// সরাসরি টগল অন/অফ করে। যার গ্রুপ নেই (সাইনআপে "ডোনার হতে চাই না" টিক দিয়েছিল বা ফাঁকা)
// সে টগল অন করতে চাইলে টগলের নিচে ব্লাড গ্রুপের ড্রপডাউন খোলে — গ্রুপ বেছে "চালু করুন"
// চাপলে blood_group ও is_blood_donor একসাথে সেভ হয়।
//
// আপডেট (ডিলিট বাটন সরানো): "ডেঞ্জার জোন" (অ্যাকাউন্ট ডিলিট) পেজের নিচের আলাদা কার্ড
// থেকে সরিয়ে এডিট ফর্মের ভেতরে ("তথ্য সেভ করুন"-এর নিচে) নেওয়া হয়েছে। ভিউ মোডে আর
// দেখা যায় না; "এডিট করুন" চাপলে আসে। ডিলিট মোডাল ও JS অপরিবর্তিত।
// ============================================================

import BaseLayout from '../../components/layout/BaseLayout.astro';

// profiles.blood_group-এ যারা ডোনার হতে চান না তাদের মান
const NOT_DONOR_VALUE = 'NOT_DONOR';

const bloodGroups = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];

const upazilas = [
  'ফেনী সদর',
  'ছাগলনাইয়া',
  'দাগনভূঞা',
  'পরশুরাম',
  'ফুলগাজী',
  'সোনাগাজী',
];
---

<BaseLayout title="প্রোফাইল এডিট | স্মার্ট ফেনী">
  <section class="edit-section">
    <div class="container edit-container">
      <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> হোমে ফিরুন</a>

      <div id="authGate" class="auth-gate" style="display:none;">
        <i class="fas fa-lock"></i>
        <p>এই পেজ দেখতে হলে আগে লগইন করুন</p>
      </div>

      <div id="editContent">
        <!-- ===== প্রোফাইল কার্ড (ভিউ মোড + এডিট মোড একই কার্ডে) ===== -->
        <div class="edit-card profile-card">

          <!-- ----- ভিউ মোড (ডিফল্ট) ----- -->
          <div class="profile-view" id="profileView">
            <button class="profile-edit-trigger" id="openEditBtn" type="button">
              <i class="fas fa-pen"></i> এডিট করুন
            </button>

            <div class="profile-view-avatar-wrap">
              <img id="viewAvatarImg" src="" alt="প্রোফাইল ছবি" class="profile-view-avatar" style="display:none;" />
              <div class="profile-view-avatar-placeholder" id="viewAvatarPlaceholder">
                <i class="fas fa-user"></i>
              </div>
            </div>

            <h1 class="profile-view-name" id="viewName">লোড হচ্ছে...</h1>

            <div class="profile-view-badges">
              <span class="profile-badge" id="viewBloodBadge" style="display:none;">
                <i class="fas fa-droplet"></i> <span id="viewBloodBadgeText"></span>
              </span>
              <span class="profile-badge" id="viewUpazilaBadge" style="display:none;">
                <i class="fas fa-location-dot"></i> <span id="viewUpazilaBadgeText"></span>
              </span>
            </div>

            <div class="profile-view-divider"></div>

            <div class="profile-view-contact">
              <div class="profile-view-contact-row">
                <i class="fas fa-phone"></i> <span id="viewPhone">—</span>
              </div>
              <div class="profile-view-contact-row">
                <i class="fas fa-envelope"></i> <span id="viewEmail">যোগ করা হয়নি</span>
              </div>
            </div>

            <!-- ===== ব্লাড ডোনার টগল — ভিউ কার্ডেই, ইনস্ট্যান্ট সেভ ===== -->
            <div class="donor-toggle-row">
              <div class="donor-toggle-text">
                <span class="donor-toggle-label">ব্লাড ডোনার লিস্টে আমাকে দেখাও</span>
                <span class="donor-toggle-hint" id="donorToggleHint">চালু করলে ব্লাড গ্রুপ বেছে নিতে হবে</span>
              </div>
              <button type="button" class="donor-toggle-switch" id="donorToggleBtn" role="switch" aria-checked="false">
                <span class="donor-toggle-knob"></span>
              </button>
            </div>

            <!-- ===== ব্লাড গ্রুপ পিকার — গ্রুপ নেই এমন ইউজার টগল অন করতে চাইলে খোলে ===== -->
            <div class="donor-group-picker" id="donorGroupPicker" style="display:none;">
              <span class="donor-toggle-label">আপনার ব্লাড গ্রুপ বেছে নিন</span>
              <div class="edit-select-wrap">
                <i class="fas fa-droplet edit-input-icon"></i>
                <select class="edit-input edit-select" id="donorGroupSelect">
                  <option value="" disabled selected>নির্বাচন করুন</option>
                  {bloodGroups.map((bg) => <option value={bg}>{bg}</option>)}
                </select>
              </div>
              <p class="edit-message" id="donorGroupMessage"></p>
              <div class="donor-group-actions">
                <button class="edit-submit-outline" id="donorGroupCancel" type="button">বাতিল</button>
                <button class="edit-submit" id="donorGroupConfirm" type="button">
                  <i class="fas fa-check"></i> <span>ডোনার হিসেবে চালু করুন</span>
                </button>
              </div>
            </div>

            <!-- ===== সংগঠন (ঐচ্ছিক) — ইনস্ট্যান্ট সেভ, ডোনার টগলের ঠিক নিচে ===== -->
            <div class="club-select-row">
              <div class="donor-toggle-text">
                <span class="donor-toggle-label">আমার সংগঠন (ঐচ্ছিক)</span>
                <span class="donor-toggle-hint">নির্দিষ্ট কোনো সংগঠনের সাথে যুক্ত থাকলে বেছে নিন — ব্লাড সার্চে খুঁজে পেতে সহজ হবে</span>
              </div>
              <div class="edit-select-wrap club-select-wrap">
                <i class="fas fa-users edit-input-icon"></i>
                <select class="edit-input edit-select" id="clubSelect">
                  <option value="">— কোনো সংগঠন না —</option>
                </select>
              </div>
              <p class="edit-message" id="clubSelectMessage"></p>
            </div>

            <!-- ===== শর্টকাট (আমার অর্ডার/অ্যাডমিন/লাকি ড্র/শপ/ক্লাব) ও
                 লগ আউট বাটন এখান থেকে সরানো হয়েছে — এই সব নন-প্রোফাইল
                 নেভিগেশন এখন bottom nav "প্রোফাইল" থেকে HamburgerMenu.astro
                 তে কেন্দ্রীভূত। এই পেজে শুধু প্রোফাইলের নিজস্ব ডেটা/সেটিংস
                 (ছবি, নাম, ফোন, ব্লাড গ্রুপ, উপজেলা, ডোনার টগল, সংগঠন,
                 ডেলিভারি হিরো ড্যাশবোর্ড, পাসওয়ার্ড) থাকবে। ===== -->
          </div>

          <!-- ----- এডিট মোড (ডিফল্টে হিডেন) ----- -->
          <div class="profile-edit-form" id="profileEditForm" style="display:none;">
            <div class="profile-edit-form-header">
              <h2 class="edit-subtitle-title"><i class="fas fa-pen"></i> প্রোফাইল এডিট</h2>
              <button class="profile-edit-cancel" id="cancelEditBtn" type="button" aria-label="বাতিল">
                <i class="fas fa-xmark"></i>
              </button>
            </div>

            <p class="edit-message" id="profileMessage"></p>

            <div class="edit-photo-upload">
              <label for="profileEditPhotoInput" class="edit-photo-circle" id="profileEditPhotoCircle">
                <img id="profileEditPhotoImg" src="" alt="প্রোফাইল ছবি" />
                <i class="fas fa-camera" id="profileEditPhotoPlaceholderIcon"></i>
                <span class="edit-photo-edit"><i class="fas fa-pen"></i></span>
              </label>
              <input type="file" id="profileEditPhotoInput" accept="image/*" style="display:none;" />
            </div>

            <label class="edit-label">পূর্ণ নাম<span class="required-mark">*</span></label>
            <div class="edit-input-wrap">
              <i class="fas fa-id-card edit-input-icon"></i>
              <input type="text" class="edit-input" id="editName" placeholder="আপনার পূর্ণ নাম" required />
              <div class="field-error-msg" data-error-for="editName"><i class="fas fa-circle-exclamation"></i><span>নাম লিখুন</span></div>
            </div>

            <label class="edit-label">ফোন নম্বর</label>
            <div class="edit-input-wrap">
              <i class="fas fa-phone edit-input-icon"></i>
              <input type="text" class="edit-input" id="editPhone" disabled />
            </div>

            <!-- ফোন নম্বর পরিবর্তন — accordion -->
            <div class="accordion-item">
              <button type="button" class="accordion-header" id="phoneChangeToggle">
                <span><i class="fas fa-pen"></i> নম্বর পরিবর্তন করুন</span>
                <i class="fas fa-chevron-down accordion-chevron"></i>
              </button>
              <div class="accordion-body" id="phoneChangePanel">
                <div class="accordion-body-inner">
                  <p class="edit-message" id="phoneMessage"></p>

                  <label class="edit-label">নতুন ফোন নম্বর</label>
                  <div class="edit-input-wrap">
                    <i class="fas fa-phone edit-input-icon"></i>
                    <input type="text" class="edit-input" id="newPhoneInput" placeholder="01xxxxxxxxx" />
                  </div>

                  <label class="edit-label">বর্তমান পাসওয়ার্ড (যাচাইয়ের জন্য)</label>
                  <div class="edit-input-wrap">
                    <i class="fas fa-lock edit-input-icon"></i>
                    <input type="password" class="edit-input" id="phoneChangePassword" placeholder="••••••••" />
                  </div>

                  <button class="edit-submit edit-submit-secondary" id="savePhoneBtn" type="button">
                    <i class="fas fa-check"></i> <span>নম্বর বদলান</span>
                  </button>
                </div>
              </div>
            </div>

            <label class="edit-label">ইমেইল</label>
            <div class="edit-input-wrap">
              <i class="fas fa-envelope edit-input-icon"></i>
              <input type="email" class="edit-input" id="editEmail" placeholder="পাসওয়ার্ড রিকভারির জন্য" />
            </div>
            <p class="edit-field-hint">ফোন নাম্বার অথবা এই ইমেইল — যেকোনো একটা দিয়ে লগইন করা যাবে</p>

            <div class="edit-field-row">
              <div class="edit-field-col">
                <label class="edit-label">ব্লাড গ্রুপ</label>
                <div class="edit-select-wrap">
                  <i class="fas fa-droplet edit-input-icon"></i>
                  <select class="edit-input edit-select" id="editBloodGroup">
                    <option value="">নির্বাচন করুন</option>
                    <option value={NOT_DONOR_VALUE}>ডোনার হতে চাই না</option>
                    {bloodGroups.map((bg) => <option value={bg}>{bg}</option>)}
                  </select>
                </div>
              </div>

              <div class="edit-field-col">
                <label class="edit-label">উপজেলা</label>
                <div class="edit-select-wrap">
                  <i class="fas fa-location-dot edit-input-icon"></i>
                  <select class="edit-input edit-select" id="editUpazila">
                    <option value="">নির্বাচন করুন</option>
                    {upazilas.map((u) => <option value={u}>{u}</option>)}
                  </select>
                </div>
              </div>
            </div>

            <div class="profile-edit-actions">
              <button class="edit-submit-outline" id="cancelEditBtn2" type="button">বাতিল</button>
              <button class="edit-submit" id="saveProfileBtn" type="button">
                <i class="fas fa-check"></i> <span>তথ্য সেভ করুন</span>
              </button>
            </div>

            <!-- ===== ডেঞ্জার জোন — অ্যাকাউন্ট ডিলিট (৭ দিনের গ্রেস পিরিয়ড) ===== -->
            <div class="danger-section">
              <h2 class="danger-title"><i class="fas fa-triangle-exclamation"></i> ডেঞ্জার জোন</h2>
              <p class="danger-text">
                অ্যাকাউন্ট ডিলিটের অনুরোধ দিলে ৭ দিন পর আপনার সব তথ্য স্থায়ীভাবে মুছে যাবে।
                এই ৭ দিনের মধ্যে আবার লগইন করলে অ্যাকাউন্ট ফিরিয়ে আনা যাবে।
              </p>
              <button class="danger-btn" id="openDeleteModal" type="button">
                <i class="fas fa-trash"></i> অ্যাকাউন্ট ডিলিট করুন
              </button>
            </div>
          </div>
        </div>

        <!-- ===== নোটিফিকেশন সেটিংস কার্ড (নতুন — Phase 6) — Accordion/ড্রপডাউন স্টাইল, পাসওয়ার্ড কার্ডের প্যাটার্ন রিইউজ করা হয়েছে ===== -->
        <div class="edit-card accordion-card">
          <div class="accordion-item accordion-item-standalone">
            <button type="button" class="accordion-header accordion-header-standalone" id="notifPrefAccordionHeader">
              <span><i class="fas fa-bell"></i> নোটিফিকেশন সেটিংস</span>
              <i class="fas fa-chevron-down accordion-chevron"></i>
            </button>
            <div class="accordion-body" id="notifPrefAccordionBody">
              <div class="accordion-body-inner">
                <p class="edit-message" id="notifPrefMessage"></p>

                <!-- অ্যাপে: ফোনের নোটিফিকেশন অবস্থা + সেটিংসের নির্দেশনা -->
                <div id="notifNativeBox" style="display:none;">
                  <p class="notif-status" id="notifStatusText"></p>
                  <button class="edit-submit edit-submit-secondary" id="notifEnableBtn" type="button" style="display:none;">
                    <i class="fas fa-bell"></i> <span>নোটিফিকেশন চালু করুন</span>
                  </button>
                  <p class="notif-guide">
                    প্রতিটা ধরনের নোটিফিকেশন আলাদাভাবে বন্ধ/চালু করতে এবং শব্দ ঠিক করতে ফোনের
                    <strong>Settings → Apps → Smart Feni → Notifications</strong> এ যান:
                  </p>
                  <ul class="notif-channel-list">
                    <li>🩸 জরুরি রক্ত</li>
                    <li>🚴 হিরো রিকোয়েস্ট</li>
                    <li>📦 ডেলিভারি আপডেট</li>
                    <li>🛍️ অর্ডার</li>
                    <li>💬 মেসেজ</li>
                    <li>📋 লিস্টিং ও আবেদন আপডেট</li>
                    <li>🎁 অফার</li>
                  </ul>
                </div>

                <!-- ওয়েবে (ব্রাউজার) -->
                <p class="notif-guide" id="notifWebNote" style="display:none;">
                  ব্রাউজারের নোটিফিকেশন আপনার ব্রাউজারের সাইট সেটিংস থেকে নিয়ন্ত্রণ করুন।
                  ধরন অনুযায়ী আলাদা নিয়ন্ত্রণ পেতে Smart Feni অ্যান্ড্রয়েড অ্যাপ ব্যবহার করুন।
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== ডেলিভারি হিরো সেকশন এখান থেকে সরানো হয়েছে —
             পুরো ড্যাশবোর্ড (স্ট্যাটাস কার্ড, অনলাইন/অফলাইন টগল,
             স্ট্যাটস, চলমান ডেলিভারি, ওপেন রিকোয়েস্ট/বারগেইন) এখন
             আলাদা /delivery-hero পেজে। ===== -->

        <!-- ===== পাসওয়ার্ড বদলান — accordion কার্ড ===== -->
        <div class="edit-card accordion-card">
          <div class="accordion-item accordion-item-standalone">
            <button type="button" class="accordion-header accordion-header-standalone" id="passwordAccordionHeader">
              <span><i class="fas fa-lock"></i> পাসওয়ার্ড বদলান</span>
              <i class="fas fa-chevron-down accordion-chevron"></i>
            </button>
            <div class="accordion-body" id="passwordAccordionBody">
              <div class="accordion-body-inner">
                <p class="edit-message" id="passwordMessage"></p>

                <label class="edit-label">বর্তমান পাসওয়ার্ড</label>
                <div class="edit-input-wrap">
                  <i class="fas fa-lock edit-input-icon"></i>
                  <input type="password" class="edit-input" id="currentPassword" placeholder="••••••••" />
                </div>

                <label class="edit-label">নতুন পাসওয়ার্ড</label>
                <div class="edit-input-wrap">
                  <i class="fas fa-lock edit-input-icon"></i>
                  <input type="password" class="edit-input" id="newPassword" placeholder="কমপক্ষে ৬ অক্ষর" />
                </div>

                <label class="edit-label">নতুন পাসওয়ার্ড আবার লিখুন</label>
                <div class="edit-input-wrap">
                  <i class="fas fa-lock edit-input-icon"></i>
                  <input type="password" class="edit-input" id="confirmPassword" placeholder="••••••••" />
                </div>

                <button class="edit-submit edit-submit-secondary" id="changePasswordBtn" type="button">
                  <i class="fas fa-key"></i> <span>পাসওয়ার্ড বদলান</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== ডিলিট কনফার্ম মোডাল (বাটন এখন এডিট ফর্মের ভেতরে) ===== -->
        <div class="del-overlay" id="delOverlay">
          <div class="del-modal" role="dialog" aria-modal="true" aria-labelledby="delTitle">
            <h3 class="del-title" id="delTitle">অ্যাকাউন্ট ডিলিট করবেন?</h3>
            <p class="del-sub">ডিলিটের অনুরোধ দিলে:</p>
            <ul class="del-list">
              <li>আপনার সব পোস্ট/লিস্টিং সাথে সাথে লুকিয়ে যাবে</li>
              <li>ব্লাড ডোনার তালিকা থেকে বাদ যাবেন, সব ডিভাইস থেকে লগআউট হবে</li>
              <li>৭ দিন পর প্রোফাইল, পোস্ট, ছবি ও রেফার পয়েন্ট স্থায়ীভাবে মুছে যাবে</li>
              <li>৭ দিনের মধ্যে লগইন করলে ফিরিয়ে আনতে পারবেন</li>
            </ul>

            <label class="edit-label" for="delReason">ডিলিটের কারণ (ঐচ্ছিক)</label>
            <select class="del-select" id="delReason">
              <option value="">নির্বাচন করুন</option>
              <option value="not_using">আর ব্যবহার করি না</option>
              <option value="privacy">প্রাইভেসি নিয়ে চিন্তা</option>
              <option value="notifications">বেশি নোটিফিকেশন আসে</option>
              <option value="found_alternative">অন্য সার্ভিস পেয়েছি</option>
              <option value="other">অন্য কারণ</option>
            </select>

            <label class="edit-label" for="delConfirmInput">নিশ্চিত করতে <strong>DELETE</strong> লিখুন</label>
            <input type="text" class="del-select" id="delConfirmInput" autocomplete="off" autocapitalize="characters" placeholder="DELETE" />

            <p class="edit-message" id="delMessage"></p>

            <div class="del-actions">
              <button type="button" class="del-cancel" id="delCancel">বাতিল</button>
              <button type="button" class="danger-btn" id="delConfirm" disabled>ডিলিট করুন</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

