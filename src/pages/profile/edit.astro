<script>
  import { supabase } from '../../lib/supabase.js';
  import { compressImage } from '../../lib/imageCompress.js';
  import { isNativeApp } from '../../lib/native-bridge.js';
  import { subscribeToPush } from '../../lib/push.js';
  import { reportError } from '../../lib/errorReporter.js';

  // profiles.blood_group-এ যারা ডোনার হতে চান না তাদের মান (সাইনআপ মোডালের সাথে একই)
  const NOT_DONOR_VALUE = 'NOT_DONOR';

  // সত্যিকারের ব্লাড গ্রুপ আছে (খালি বা NOT_DONOR নয়)
  function hasRealBloodGroup(profile) {
    return !!profile?.blood_group && profile.blood_group !== NOT_DONOR_VALUE;
  }

  // এরর মনিটরিং: DB ফেইল অ্যাডমিন লগে পাঠায় (fire-and-forget, কখনো throw করে না)
  function reportDbError(action, title, error) {
    reportError({ kind: 'db_block', action, title, message: error?.message, code: error?.code });
  }

  // ===== অ্যাকাউন্ট ডিলিট (৭ দিনের গ্রেস পিরিয়ড) =====
  // request_account_deletion() RPC ব্লক শর্ত নিজেই যাচাই করে (চলমান ডেলিভারি, ক্লাব/শপ ওউনার,
  // pending উইথড্র, স্টাফ)। সফল হলে সব ডিভাইস থেকে লগআউট করে হোমে পাঠানো হয়।
  const DELETE_BLOCK_MESSAGES = {
    active_delivery: 'আপনার একটি ডেলিভারি/রাইড রিকোয়েস্ট চলমান আছে। সেটা শেষ বা বাতিল হলে আবার চেষ্টা করুন।',
    club_owner: 'আপনি একটি ক্লাবের ওউনার। আগে ক্লাবের মালিকানা অন্য কাউকে দিন বা ক্লাব বন্ধ করুন।',
    shop_owner: 'আপনি একটি শপের ওউনার। আগে শপের মালিকানা অন্য কাউকে দিন বা শপ বন্ধ করুন।',
    pending_withdraw: 'আপনার একটি রেফার পয়েন্ট উইথড্র রিকোয়েস্ট চলমান আছে। সেটা শেষ হলে আবার চেষ্টা করুন।',
    staff: 'অ্যাডমিন/মডারেটর অ্যাকাউন্ট এখান থেকে ডিলিট করা যায় না।',
  };

  const delOverlay = document.getElementById('delOverlay');
  const delReason = document.getElementById('delReason');
  const delConfirmInput = document.getElementById('delConfirmInput');
  const delConfirmBtn = document.getElementById('delConfirm');
  const delMessage = document.getElementById('delMessage');

  function setDelMessage(text) {
    if (!delMessage) return;
    delMessage.textContent = text || '';
    delMessage.className = text ? 'edit-message show-error' : 'edit-message';
  }

  function openDelModal() {
    setDelMessage('');
    if (delConfirmInput) delConfirmInput.value = '';
    if (delReason) delReason.value = '';
    if (delConfirmBtn) delConfirmBtn.disabled = true;
    delOverlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDelModal() {
    delOverlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('openDeleteModal')?.addEventListener('click', openDelModal);
  document.getElementById('delCancel')?.addEventListener('click', closeDelModal);
  delOverlay?.addEventListener('click', (e) => {
    if (e.target === delOverlay) closeDelModal();
  });

  delConfirmInput?.addEventListener('input', () => {
    if (delConfirmBtn) delConfirmBtn.disabled = delConfirmInput.value.trim().toUpperCase() !== 'DELETE';
  });

  delConfirmBtn?.addEventListener('click', async () => {
    if (delConfirmInput.value.trim().toUpperCase() !== 'DELETE') return;

    const originalHtml = delConfirmBtn.innerHTML;
    delConfirmBtn.disabled = true;
    delConfirmBtn.textContent = 'অনুরোধ পাঠানো হচ্ছে...';
    setDelMessage('');

    const { data, error } = await supabase.rpc('request_account_deletion', {
      p_reason: delReason.value || null,
    });

    if (error) {
      reportDbError('account_delete_request', 'অ্যাকাউন্ট ডিলিটের অনুরোধ ব্যর্থ', error);
      setDelMessage('কিছু একটা সমস্যা হয়েছে, আবার চেষ্টা করুন');
      delConfirmBtn.disabled = false;
      delConfirmBtn.innerHTML = originalHtml;
      return;
    }

    if (!data?.ok) {
      setDelMessage(DELETE_BLOCK_MESSAGES[data?.error] || 'অনুরোধ করা যায়নি, আবার চেষ্টা করুন');
      delConfirmBtn.disabled = false;
      delConfirmBtn.innerHTML = originalHtml;
      return;
    }

    try {
      await supabase.auth.signOut({ scope: 'global' });
    } catch (e) {
      // লগআউট ব্যর্থ হলেও অনুরোধ হয়ে গেছে; পেজ রিডাইরেক্ট চলবে
    }

    window.showToast('ডিলিটের অনুরোধ হয়েছে। ৭ দিনের মধ্যে লগইন করলে ফিরিয়ে আনতে পারবেন।', 'success');
    setTimeout(() => {
      window.location.href = '/';
    }, 1500);
  });

  const authGate = document.getElementById('authGate');
  const editContent = document.getElementById('editContent');

  // ===== ভিউ মোড এলিমেন্ট =====
  const profileView = document.getElementById('profileView');
  const profileEditForm = document.getElementById('profileEditForm');
  const openEditBtn = document.getElementById('openEditBtn');
  const cancelEditBtn = document.getElementById('cancelEditBtn');
  const cancelEditBtn2 = document.getElementById('cancelEditBtn2');

  const viewAvatarImg = document.getElementById('viewAvatarImg');
  const viewAvatarPlaceholder = document.getElementById('viewAvatarPlaceholder');
  const viewName = document.getElementById('viewName');
  const viewPhone = document.getElementById('viewPhone');
  const viewEmail = document.getElementById('viewEmail');
  const viewBloodBadge = document.getElementById('viewBloodBadge');
  const viewBloodBadgeText = document.getElementById('viewBloodBadgeText');
  const viewUpazilaBadge = document.getElementById('viewUpazilaBadge');
  const viewUpazilaBadgeText = document.getElementById('viewUpazilaBadgeText');

  // ===== এডিট ফর্ম এলিমেন্ট =====
  const nameInput = document.getElementById('editName');
  const phoneInput = document.getElementById('editPhone');
  const emailInput = document.getElementById('editEmail');
  const bloodGroupSelect = document.getElementById('editBloodGroup');
  const upazilaSelect = document.getElementById('editUpazila');
  const profileMessage = document.getElementById('profileMessage');
  const saveProfileBtn = document.getElementById('saveProfileBtn');

  const photoInput = document.getElementById('profileEditPhotoInput');
  const photoCircle = document.getElementById('profileEditPhotoCircle');
  const photoImg = document.getElementById('profileEditPhotoImg');
  let selectedPhotoFile = null;
  let currentUserId = null;
  let currentUserEmail = null;
  let currentAccessToken = null;
  let currentProfile = null;

  // ===== ব্লাড ডোনার টগল =====
  const donorToggleBtn = document.getElementById('donorToggleBtn');
  const donorToggleHint = document.getElementById('donorToggleHint');
  let isDonorOn = false;

  // ===== ব্লাড গ্রুপ পিকার (টগল অন করার সময়, গ্রুপ না থাকলে) =====
  const donorGroupPicker = document.getElementById('donorGroupPicker');
  const donorGroupSelect = document.getElementById('donorGroupSelect');
  const donorGroupMessage = document.getElementById('donorGroupMessage');
  const donorGroupCancel = document.getElementById('donorGroupCancel');
  const donorGroupConfirm = document.getElementById('donorGroupConfirm');

  // ===== সংগঠন (ঐচ্ছিক) সিলেক্ট =====
  const clubSelect = document.getElementById('clubSelect');
  const clubSelectMessage = document.getElementById('clubSelectMessage');

  // ===== নোটিফিকেশন সেটিংস কার্ডের মেসেজ (টগল সরানো হয়েছে — এখন চ্যানেল) =====
  const notifPrefMessage = document.getElementById('notifPrefMessage');

  // ===== ফোন নম্বর পরিবর্তন (accordion) =====
  const phoneChangeToggle = document.getElementById('phoneChangeToggle');
  const phoneChangePanel = document.getElementById('phoneChangePanel');
  const newPhoneInput = document.getElementById('newPhoneInput');
  const phoneChangePasswordInput = document.getElementById('phoneChangePassword');
  const phoneMessage = document.getElementById('phoneMessage');
  const savePhoneBtn = document.getElementById('savePhoneBtn');

  // ===== পাসওয়ার্ড বদলান (accordion) =====
  const passwordAccordionHeader = document.getElementById('passwordAccordionHeader');
  const passwordAccordionBody = document.getElementById('passwordAccordionBody');

  const currentPasswordInput = document.getElementById('currentPassword');
  const newPasswordInput = document.getElementById('newPassword');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const passwordMessage = document.getElementById('passwordMessage');
  const changePasswordBtn = document.getElementById('changePasswordBtn');

  function showMsg(el, text, type = 'error') {
    if (!el) return;
    el.textContent = text;
    el.className = `edit-message ${type === 'error' ? 'show-error' : 'show-success'}`;

    // ইনলাইন মেসেজ কার্ডের ওপরের দিকে থাকে, সেভ বাটন চাপার সময় স্ক্রিনের
    // বাইরে থাকে — তাই একই মেসেজ গ্লোবাল টোস্টেও দেখানো হয় (স্ক্রিনের মাঝখানে,
    // সব কিছুর ওপরে)। টোস্ট না থাকলে (কোনো কারণে) শুধু ইনলাইন মেসেজ থাকবে।
    if (text && typeof window.showToast === 'function') {
      window.showToast(text, type === 'error' ? 'error' : 'success', type === 'error' ? 3500 : 2500);
    }
  }

  function clearMsg(el) {
    if (!el) return;
    el.textContent = '';
    el.className = 'edit-message';
  }

  function setLoading(button, isLoading, loadingText) {
    const textEl = button.querySelector('span');
    if (isLoading) {
      button.dataset.originalText = textEl.textContent;
      textEl.textContent = loadingText;
      button.disabled = true;
    } else {
      textEl.textContent = button.dataset.originalText || textEl.textContent;
      button.disabled = false;
    }
  }

  // ===== রিইউজেবল accordion টগল =====
  function setupAccordion(headerEl, bodyEl) {
    headerEl?.addEventListener('click', () => {
      const isOpen = bodyEl.classList.contains('open');
      bodyEl.classList.toggle('open', !isOpen);
      headerEl.classList.toggle('open', !isOpen);
    });
  }

  setupAccordion(phoneChangeToggle, phoneChangePanel);
  setupAccordion(passwordAccordionHeader, passwordAccordionBody);
  setupAccordion(document.getElementById('notifPrefAccordionHeader'), document.getElementById('notifPrefAccordionBody'));

  // ===== ভিউ কার্ড রেন্ডার =====
  function renderProfileView(profile) {
    if (!profile) return;

    viewName.textContent = profile.full_name || 'ইউজার';
    viewPhone.textContent = profile.phone || '—';
    viewEmail.textContent = profile.recovery_email || 'যোগ করা হয়নি';

    if (profile.avatar_url) {
      viewAvatarImg.src = profile.avatar_url;
      viewAvatarImg.style.display = 'block';
      viewAvatarPlaceholder.style.display = 'none';
    } else {
      viewAvatarImg.style.display = 'none';
      viewAvatarPlaceholder.style.display = 'flex';
    }

    if (profile.blood_group === NOT_DONOR_VALUE) {
      viewBloodBadgeText.textContent = 'ডোনার নন';
      viewBloodBadge.style.display = 'inline-flex';
    } else if (profile.blood_group) {
      viewBloodBadgeText.textContent = profile.blood_group;
      viewBloodBadge.style.display = 'inline-flex';
    } else {
      viewBloodBadge.style.display = 'none';
    }

    if (profile.upazila) {
      viewUpazilaBadgeText.textContent = profile.upazila;
      viewUpazilaBadge.style.display = 'inline-flex';
    } else {
      viewUpazilaBadge.style.display = 'none';
    }

    setDonorToggle(!!profile.is_blood_donor);
    updateDonorNotifWarning();
  }

  function setDonorToggle(on) {
    isDonorOn = on;
    donorToggleBtn?.classList.toggle('on', on);
    donorToggleBtn?.setAttribute('aria-checked', String(on));
  }

  function updateDonorHint() {
    if (!donorToggleHint) return;

    if (hasRealBloodGroup(currentProfile)) {
      donorToggleHint.textContent = 'জরুরি প্রয়োজনে অন্যরা আপনার তথ্য দেখতে পাবে';
    } else {
      donorToggleHint.textContent = 'চালু করলে ব্লাড গ্রুপ বেছে নিতে হবে';
    }
    donorToggleHint.classList.remove('hint-error');
  }

  // ===== ব্লাড গ্রুপ পিকার খোলা/বন্ধ =====
  function openDonorGroupPicker() {
    if (!donorGroupPicker) return;
    clearMsg(donorGroupMessage);
    if (donorGroupSelect) donorGroupSelect.value = '';
    donorGroupPicker.style.display = 'flex';
  }

  function closeDonorGroupPicker() {
    if (!donorGroupPicker) return;
    donorGroupPicker.style.display = 'none';
    clearMsg(donorGroupMessage);
    if (donorGroupSelect) donorGroupSelect.value = '';
  }

  // ===== ডোনারের নোটিফিকেশন সতর্কতা (শুধু অ্যাপে) =====
  // ডোনার চালু কিন্তু ফোনে নোটিফিকেশন বন্ধ — রক্তের জরুরি অনুরোধ পৌঁছাবে না।
  async function getNativePushStatus() {
    if (!isNativeApp()) return null;
    try {
      const { PushNotifications } = await import('@capacitor/push-notifications');
      const perm = await PushNotifications.checkPermissions();
      return perm.receive;
    } catch (err) {
      return null;
    }
  }

  async function updateDonorNotifWarning() {
    updateDonorHint(); // আগে স্বাভাবিক লেখা
    if (!isDonorOn || !hasRealBloodGroup(currentProfile)) return;

    const status = await getNativePushStatus();
    if (status === null || status === 'granted') return; // ওয়েব বা অনুমতি আছে — সতর্কতা নয়

    if (donorToggleHint) {
      donorToggleHint.textContent =
        '⚠️ নোটিফিকেশন বন্ধ আছে — রক্তের জরুরি অনুরোধ পেতে ফোনের Settings → Apps → Smart Feni → Notifications চালু করুন';
      donorToggleHint.classList.add('hint-error');
    }
  }

  // অনুমতির ডায়ালগে উত্তর দেওয়া পর্যন্ত অপেক্ষা (সর্বোচ্চ ~৩০ সেকেন্ড), তারপর সতর্কতা হালনাগাদ
  async function watchPushPermissionThenUpdate() {
    const initial = await getNativePushStatus();
    if (initial === null) return; // ওয়েব — কিছু করার নেই
    if (initial === 'granted' || initial === 'denied') {
      // ডায়ালগ আসবে না — সরাসরি হালনাগাদ
      updateDonorNotifWarning();
      return;
    }

    let tries = 0;
    const timer = setInterval(async () => {
      tries++;
      const status = await getNativePushStatus();
      if (status !== initial || tries >= 30) {
        clearInterval(timer);
        updateDonorNotifWarning();
      }
    }, 1000);
  }

  donorToggleBtn?.addEventListener('click', async () => {
    const newValue = !isDonorOn;

    // ব্লাড গ্রুপ নেই (ফাঁকা বা "ডোনার হতে চাই না") — অন করতে চাইলে গ্রুপের ড্রপডাউন খুলবে
    if (newValue && !hasRealBloodGroup(currentProfile)) {
      if (donorGroupPicker?.style.display === 'flex') {
        closeDonorGroupPicker(); // আবার ট্যাপ করলে বন্ধ
      } else {
        openDonorGroupPicker();
      }
      return;
    }

    setDonorToggle(newValue);

    const { error } = await supabase
      .from('profiles')
      .update({ is_blood_donor: newValue })
      .eq('id', currentUserId);

    if (error) {
      setDonorToggle(!newValue);
      reportDbError('profile_donor_toggle', 'ডোনার টগল সেভ ব্যর্থ', error);
      if (donorToggleHint) {
        donorToggleHint.textContent = 'আপডেট ব্যর্থ, আবার চেষ্টা করুন';
        donorToggleHint.classList.add('hint-error');
      }
      return;
    }

    currentProfile.is_blood_donor = newValue;
    updateDonorHint();

    if (newValue) {
      // ডোনার চালু হলো — অ্যাপে অনুমতি না থাকলে Android এর ডায়ালগ চাওয়া হবে,
      // তারপর ফলাফল দেখে সতর্কতা হালনাগাদ
      window.dispatchEvent(new CustomEvent('smartfeni:ask-push'));
      watchPushPermissionThenUpdate();
    }
  });

  donorGroupCancel?.addEventListener('click', closeDonorGroupPicker);

  // গ্রুপ বেছে "চালু করুন" — blood_group ও is_blood_donor একসাথে সেভ
  donorGroupConfirm?.addEventListener('click', async () => {
    clearMsg(donorGroupMessage);

    const group = donorGroupSelect?.value;
    if (!group) {
      showMsg(donorGroupMessage, 'আগে ব্লাড গ্রুপ বেছে নিন');
      return;
    }

    setLoading(donorGroupConfirm, true, 'চালু হচ্ছে...');

    const { error } = await supabase
      .from('profiles')
      .update({ blood_group: group, is_blood_donor: true })
      .eq('id', currentUserId);

    setLoading(donorGroupConfirm, false);

    if (error) {
      reportDbError('profile_donor_enable', 'ডোনার চালু করা ব্যর্থ', error);
      showMsg(donorGroupMessage, 'আপডেট ব্যর্থ, আবার চেষ্টা করুন');
      return;
    }

    currentProfile = { ...currentProfile, blood_group: group, is_blood_donor: true };
    if (bloodGroupSelect) bloodGroupSelect.value = group; // এডিট ফর্মের ড্রপডাউনও মিলিয়ে রাখা
    closeDonorGroupPicker();
    renderProfileView(currentProfile);

    // ডোনার চালু হলো — অ্যাপে অনুমতি না থাকলে Android এর ডায়ালগ চাওয়া হবে
    window.dispatchEvent(new CustomEvent('smartfeni:ask-push'));
    watchPushPermissionThenUpdate();
  });

  // ===== সংগঠন (ঐচ্ছিক) — ক্লাব লিস্ট লোড ও ইনস্ট্যান্ট সেভ =====
  async function loadClubOptions() {
    const { data: clubs } = await supabase
      .from('clubs')
      .select('id, name')
      .eq('is_active', true)
      .order('name', { ascending: true });

    if (!clubSelect) return;

    (clubs || []).forEach((club) => {
      const opt = document.createElement('option');
      opt.value = club.id;
      opt.textContent = club.name;
      clubSelect.appendChild(opt);
    });

    clubSelect.value = currentProfile?.club_id || '';
  }

  clubSelect?.addEventListener('change', async () => {
    clearMsg(clubSelectMessage);
    const newClubId = clubSelect.value || null;

    const { error } = await supabase
      .from('profiles')
      .update({ club_id: newClubId })
      .eq('id', currentUserId);

    if (error) {
      reportDbError('profile_club_save', 'সংগঠন সেভ ব্যর্থ', error);
      showMsg(clubSelectMessage, 'আপডেট ব্যর্থ: ' + error.message);
      clubSelect.value = currentProfile?.club_id || '';
      return;
    }

    currentProfile.club_id = newClubId;
    showMsg(clubSelectMessage, 'সংগঠন আপডেট হয়েছে ✓', 'success');
    setTimeout(() => clearMsg(clubSelectMessage), 2000);
  });

  // ===== নোটিফিকেশন সেটিংস কার্ড — অ্যাপে অনুমতির অবস্থা, ওয়েবে নোট =====
  async function initNotificationSettingsCard() {
    const nativeBox = document.getElementById('notifNativeBox');
    const webNote = document.getElementById('notifWebNote');
    const statusText = document.getElementById('notifStatusText');
    const enableBtn = document.getElementById('notifEnableBtn');

    if (!isNativeApp()) {
      if (webNote) webNote.style.display = '';
      return;
    }
    if (nativeBox) nativeBox.style.display = '';

    async function refreshStatus() {
      let granted = false;
      try {
        const { PushNotifications } = await import('@capacitor/push-notifications');
        const perm = await PushNotifications.checkPermissions();
        granted = perm.receive === 'granted';
      } catch (err) {
        // প্লাগইন না পেলে "বন্ধ" দেখানো হবে
      }
      if (statusText) {
        statusText.textContent = granted ? '✅ নোটিফিকেশন চালু আছে' : '⚠️ নোটিফিকেশন বন্ধ আছে';
        statusText.className = 'notif-status ' + (granted ? 'on' : 'off');
      }
      if (enableBtn) enableBtn.style.display = granted ? 'none' : '';
    }

    await refreshStatus();

    enableBtn?.addEventListener('click', async () => {
      clearMsg(notifPrefMessage);
      setLoading(enableBtn, true, 'চালু হচ্ছে...');
      const result = await subscribeToPush();
      setLoading(enableBtn, false);

      if (result?.success) {
        showMsg(notifPrefMessage, 'নোটিফিকেশন চালু হয়েছে ✓', 'success');
      } else if (result?.permission === 'denied') {
        showMsg(notifPrefMessage, 'অনুমতি বন্ধ আছে — ফোনের Settings → Apps → Smart Feni → Notifications থেকে চালু করুন');
      } else {
        showMsg(notifPrefMessage, result?.error || 'চালু করা যায়নি, আবার চেষ্টা করুন');
      }
      await refreshStatus();
    });
  }

  function populateEditForm(profile) {
    if (!profile) return;

    if (nameInput) nameInput.value = profile.full_name || '';
    if (phoneInput) phoneInput.value = profile.phone || '';
    if (emailInput) emailInput.value = profile.recovery_email || '';
    if (bloodGroupSelect) bloodGroupSelect.value = profile.blood_group || '';
    if (upazilaSelect) upazilaSelect.value = profile.upazila || '';

    selectedPhotoFile = null;
    if (profile.avatar_url) {
      photoImg.src = profile.avatar_url;
      photoCircle?.classList.add('has-photo');
    } else {
      photoImg.src = '';
      photoCircle?.classList.remove('has-photo');
    }
  }

  function openEditMode() {
    populateEditForm(currentProfile);
    clearMsg(profileMessage);
    closeDonorGroupPicker();
    profileView.style.display = 'none';
    profileEditForm.style.display = 'block';
  }

  function closeEditMode() {
    profileEditForm.style.display = 'none';
    profileView.style.display = 'block';
  }

  openEditBtn?.addEventListener('click', openEditMode);
  cancelEditBtn?.addEventListener('click', closeEditMode);
  cancelEditBtn2?.addEventListener('click', closeEditMode);

  // ===== পেজ লোড হলে সেশন চেক + প্রোফাইল লোড =====
  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      editContent.style.display = 'none';
      authGate.style.display = 'block';
      return;
    }

    currentUserId = session.user.id;
    currentUserEmail = session.user.email;
    currentAccessToken = session.access_token;

    const { data: profile, error: profileLoadError } = await supabase
      .from('profiles')
      .select('full_name, phone, recovery_email, blood_group, upazila, avatar_url, is_blood_donor, club_id, role, is_shop_owner, is_club_owner')
      .eq('id', currentUserId)
      .single();

    if (profileLoadError) reportDbError('profile_load', 'প্রোফাইল লোড ব্যর্থ', profileLoadError);

    if (profile) {
      currentProfile = profile;
      renderProfileView(profile);
      populateEditForm(profile);
      await loadClubOptions();
    }

    initNotificationSettingsCard();
  }

  init();

  photoInput?.addEventListener('change', async () => {
    const file = photoInput.files?.[0];
    if (!file) return;
    selectedPhotoFile = await compressImage(file, { maxDimension: 800 });
    const reader = new FileReader();
    reader.onload = () => {
      photoImg.src = reader.result;
      photoCircle?.classList.add('has-photo');
    };
    reader.readAsDataURL(selectedPhotoFile);
  });

  // ছবি আপলোড ফেইল হলে ইউজারকে কারণ + সমাধান বলার জন্য
  function describeAvatarFailure(status, serverMsg) {
    const msg = String(serverMsg || '');
    if (status === 0) {
      return {
        reason: 'ইন্টারনেট সংযোগ পাওয়া যায়নি বা মাঝপথে ছুটে গেছে',
        fix: 'নেট ঠিক আছে কিনা দেখে আবার "সেভ" চাপুন',
      };
    }
    if (status === 401) {
      return {
        reason: 'লগইন সেশনের মেয়াদ শেষ হয়ে গেছে',
        fix: 'পেজ রিফ্রেশ করুন (দরকার হলে আবার লগইন করুন), তারপর ছবি দিন',
      };
    }
    if (status === 413 || /size|exceed|too large|payload/i.test(msg)) {
      return {
        reason: 'ছবির সাইজ অনেক বড়',
        fix: 'অন্য একটি ছোট ছবি বেছে নিন',
      };
    }
    if (status === 415 || /mime|not supported|unsupported|invalid.*type/i.test(msg)) {
      return {
        reason: 'এই ধরনের ছবি ফাইল সাপোর্ট করে না',
        fix: 'JPG বা PNG ছবি বেছে নিন',
      };
    }
    if (status === 400) {
      return {
        reason: 'ছবিটি সার্ভারে পৌঁছায়নি',
        fix: 'ছবিটি আবার বেছে নিয়ে "সেভ" চাপুন',
      };
    }
    if (status >= 500) {
      return {
        reason: 'সার্ভারে সাময়িক সমস্যা হয়েছে (আমাদের কাছে রিপোর্ট চলে গেছে)',
        fix: 'কিছুক্ষণ পরে আবার "সেভ" চাপুন',
      };
    }
    return {
      reason: 'ছবি আপলোড করা যায়নি',
      fix: 'আবার চেষ্টা করুন, সমস্যা থাকলে অন্য ছবি দিন',
    };
  }

  // রিটার্ন: { url, problem } — সফল হলে problem = null, ব্যর্থ হলে url = null
  async function uploadAvatar(accessToken, file) {
    try {
      const formData = new FormData();
      formData.append('file', file);

      const res = await fetch('/api/upload-avatar', {
        method: 'POST',
        headers: { Authorization: `Bearer ${accessToken}` },
        body: formData,
      });

      // Vercel-এর নিজস্ব এরর (যেমন 413) HTML/টেক্সট হতে পারে — JSON না হলেও যেন না ভাঙে
      let result = null;
      try {
        result = await res.json();
      } catch (_) {
        result = null;
      }

      if (!res.ok) {
        console.error('ছবি আপলোড এরর:', result?.error);
        reportError({
          kind: 'api_fail',
          action: 'avatar_upload',
          title: 'প্রোফাইল ছবি আপলোড ব্যর্থ',
          message: `HTTP ${res.status}: ${result?.error || ''}`,
        });
        return { url: null, problem: describeAvatarFailure(res.status, result?.error) };
      }

      if (!result?.url) {
        reportError({
          kind: 'api_fail',
          action: 'avatar_upload',
          title: 'প্রোফাইল ছবি আপলোড ব্যর্থ',
          message: 'HTTP 200 কিন্তু ছবির URL আসেনি',
        });
        return { url: null, problem: describeAvatarFailure(500, '') };
      }

      return { url: result.url, problem: null };
    } catch (err) {
      console.error('ছবি আপলোড নেটওয়ার্ক এরর:', err);
      reportError({
        kind: 'api_fail',
        action: 'avatar_upload',
        title: 'প্রোফাইল ছবি আপলোড ব্যর্থ',
        message: err?.message || String(err),
      });
      return { url: null, problem: describeAvatarFailure(0, '') };
    }
  }

  saveProfileBtn?.addEventListener('click', async () => {
    clearMsg(profileMessage);

    const name = nameInput?.value?.trim();
    if (!window.SFValidateForm(nameInput?.closest('.edit-card') || nameInput?.parentElement) || !name) {
      showMsg(profileMessage, 'নাম খালি রাখা যাবে না');
      return;
    }

    const newEmail = emailInput?.value?.trim() || null;

    if (newEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
      showMsg(profileMessage, 'সঠিক ইমেইল ঠিকানা দিন');
      return;
    }

    setLoading(saveProfileBtn, true, 'সেভ হচ্ছে...');

    // ইমেইল বদলানো/নতুন যোগ করা হলে অন্য কোনো একাউন্টে একই ইমেইল
    // আগে থেকে যুক্ত আছে কিনা চেক করা হচ্ছে (দুই একাউন্টে একই
    // ইমেইল থাকলে ইমেইল দিয়ে লগইন করার সময় ঘেঁটে যাবে)
    if (newEmail && newEmail.toLowerCase() !== (currentProfile?.recovery_email || '').toLowerCase()) {
      const { data: existingEmailProfiles } = await supabase
        .from('profiles')
        .select('id')
        .ilike('recovery_email', newEmail)
        .neq('id', currentUserId)
        .limit(1);

      if (existingEmailProfiles && existingEmailProfiles.length > 0) {
        setLoading(saveProfileBtn, false);
        showMsg(profileMessage, 'এই ইমেইল অন্য একাউন্টে ব্যবহৃত হচ্ছে');
        return;
      }
    }

    let avatarUrl = null;
    let photoProblem = null;
    if (selectedPhotoFile) {
      if (currentAccessToken) {
        const uploaded = await uploadAvatar(currentAccessToken, selectedPhotoFile);
        avatarUrl = uploaded.url;
        photoProblem = uploaded.problem;
      } else {
        photoProblem = describeAvatarFailure(401, '');
      }
    }

    const updates = {
      full_name: name,
      recovery_email: newEmail,
      blood_group: bloodGroupSelect?.value || null,
      upazila: upazilaSelect?.value || null,
    };
    if (avatarUrl) updates.avatar_url = avatarUrl;

    // ব্লাড গ্রুপ খালি বা "ডোনার হতে চাই না" হলে ডোনার লিস্ট থেকেও সরে যাবে
    if ((!updates.blood_group || updates.blood_group === NOT_DONOR_VALUE) && isDonorOn) {
      updates.is_blood_donor = false;
    }

    const { error } = await supabase.from('profiles').update(updates).eq('id', currentUserId);

    setLoading(saveProfileBtn, false);

    if (error) {
      reportDbError('profile_save', 'প্রোফাইল সেভ ব্যর্থ', error);
      showMsg(profileMessage, 'সেভ করতে সমস্যা হয়েছে: ' + error.message);
      return;
    }

    currentProfile = { ...currentProfile, ...updates };
    renderProfileView(currentProfile);

    if (photoProblem) {
      // বাকি তথ্য সেভ হয়েছে, শুধু ছবি যায়নি — ফর্ম খোলা থাকবে, বেছে নেওয়া ছবিও থাকবে,
      // যাতে ইউজার সমস্যা ঠিক করে আবার "সেভ" চাপতে পারে
      showMsg(
        profileMessage,
        `তথ্য সেভ হয়েছে, কিন্তু ছবি আপলোড হয়নি। কারণ: ${photoProblem.reason}। সমাধান: ${photoProblem.fix}।`
      );
      return;
    }

    if (avatarUrl) selectedPhotoFile = null;
    showMsg(profileMessage, 'তথ্য সেভ হয়েছে ✓', 'success');
    setTimeout(closeEditMode, 900);
  });

  // ===== ফোন নম্বর পরিবর্তন =====
  savePhoneBtn?.addEventListener('click', async () => {
    clearMsg(phoneMessage);

    const newPhone = newPhoneInput?.value?.trim();
    const password = phoneChangePasswordInput?.value;

    if (!newPhone || !password) {
      showMsg(phoneMessage, 'নতুন নম্বর ও বর্তমান পাসওয়ার্ড দিন');
      return;
    }

    setLoading(savePhoneBtn, true, 'যাচাই হচ্ছে...');

    const res = await fetch('/api/change-phone', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accessToken: currentAccessToken, currentPassword: password, newPhone }),
    });
    const result = await res.json();

    setLoading(savePhoneBtn, false);

    if (!res.ok) {
      if (res.status >= 500) {
        reportError({
          kind: 'api_fail',
          action: 'phone_change',
          title: 'ফোন নম্বর বদল ব্যর্থ (সার্ভার)',
          message: `HTTP ${res.status}: ${result?.error || ''}`,
        });
      }
      showMsg(phoneMessage, result.error || 'নম্বর বদলানো যায়নি');
      return;
    }

    showMsg(phoneMessage, 'নম্বর বদলানো হয়েছে ✓ আবার লগইন করতে হবে...', 'success');
    setTimeout(async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    }, 1800);
  });

  // ===== পাসওয়ার্ড বদল =====
  changePasswordBtn?.addEventListener('click', async () => {
    clearMsg(passwordMessage);

    const currentPassword = currentPasswordInput?.value;
    const newPassword = newPasswordInput?.value;
    const confirmPassword = confirmPasswordInput?.value;

    if (!currentPassword || !newPassword || !confirmPassword) {
      showMsg(passwordMessage, 'সব ঘর পূরণ করুন');
      return;
    }
    if (newPassword.length < 6) {
      showMsg(passwordMessage, 'নতুন পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে');
      return;
    }
    if (newPassword !== confirmPassword) {
      showMsg(passwordMessage, 'নতুন পাসওয়ার্ড দুইবার একই হয়নি');
      return;
    }

    setLoading(changePasswordBtn, true, 'যাচাই হচ্ছে...');

    const { error: reauthError } = await supabase.auth.signInWithPassword({
      email: currentUserEmail,
      password: currentPassword,
    });

    if (reauthError) {
      showMsg(passwordMessage, 'বর্তমান পাসওয়ার্ড সঠিক নয়');
      setLoading(changePasswordBtn, false);
      return;
    }

    const { error: updateError } = await supabase.auth.updateUser({ password: newPassword });

    setLoading(changePasswordBtn, false);

    if (updateError) {
      reportError({
        kind: 'api_fail',
        action: 'password_change',
        title: 'পাসওয়ার্ড বদল ব্যর্থ',
        message: updateError.message,
        code: updateError.code || updateError.status,
      });
      showMsg(passwordMessage, 'পাসওয়ার্ড বদলাতে সমস্যা হয়েছে: ' + updateError.message);
      return;
    }

    showMsg(passwordMessage, 'পাসওয়ার্ড বদলানো হয়েছে ✓', 'success');
    currentPasswordInput.value = '';
    newPasswordInput.value = '';
    confirmPasswordInput.value = '';

    // নিজেকে নিরাপত্তা সতর্কতা — RPC ভেতরে auth.uid() ব্যবহার করে, তাই এটা
    // ক্লায়েন্টের পাঠানো কোনো user_id বিশ্বাস করে না
    try {
      const { error: notifyError } = await supabase.rpc('notify_security_event', { event_type: 'password_changed' });
      if (notifyError) console.warn('নিরাপত্তা নোটিফিকেশন পাঠানো যায়নি:', notifyError.message);
    } catch (notifyErr) {
      console.warn('নিরাপত্তা নোটিফিকেশন এরর:', notifyErr);
    }
  });
</script>
