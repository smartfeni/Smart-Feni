  function showMsg(el, text, type = 'error') {
    if (!el) return;
    el.textContent = text;
    el.className = `edit-message ${type === 'error' ? 'show-error' : 'show-success'}`;
  }

  function clearMsg(el) {
    if (!el) return;
    el.textContent = '';
    el.className = 'edit-message';
  }

  function setLoading(button, isLoading, loadingText) {
    const textEl = button.querySelector('span');
    if (isLoading) {
      button.dataset.originalText = textEl.textContent;
      textEl.textContent = loadingText;
      button.disabled = true;
    } else {
      textEl.textContent = button.dataset.originalText || textEl.textContent;
      button.disabled = false;
    }
  }

  function renderStatus(el, isOnline) {
    el.className = `rider-status-text ${isOnline ? 'online' : 'offline'}`;
    el.innerHTML = isOnline
      ? '<i class="fas fa-circle"></i> <span>অনলাইন — কাস্টমাররা আপনাকে দেখতে পাচ্ছেন</span>'
      : '<i class="fas fa-circle"></i> <span>অফলাইন — কাস্টমাররা আপনাকে দেখছেন না</span>';
  }

  // ===== রিইউজেবল accordion টগল =====
  function setupAccordion(headerEl, bodyEl) {
    headerEl?.addEventListener('click', () => {
      const isOpen = bodyEl.classList.contains('open');
      bodyEl.classList.toggle('open', !isOpen);
      headerEl.classList.toggle('open', !isOpen);
    });
  }

  setupAccordion(phoneChangeToggle, phoneChangePanel);
  setupAccordion(passwordAccordionHeader, passwordAccordionBody);

  // ===== ভিউ কার্ড রেন্ডার =====
  function renderProfileView(profile) {
    if (!profile) return;

    viewName.textContent = profile.full_name || 'ইউজার';
    viewPhone.textContent = profile.phone || '—';
    viewEmail.textContent = profile.recovery_email || 'যোগ করা হয়নি';

    if (profile.avatar_url) {
      viewAvatarImg.src = profile.avatar_url;
      viewAvatarImg.style.display = 'block';
      viewAvatarPlaceholder.style.display = 'none';
    } else {
      viewAvatarImg.style.display = 'none';
      viewAvatarPlaceholder.style.display = 'flex';
    }

    if (profile.blood_group) {
      viewBloodBadgeText.textContent = profile.blood_group;
      viewBloodBadge.style.display = 'inline-flex';
    } else {
      viewBloodBadge.style.display = 'none';
    }

    if (profile.upazila) {
      viewUpazilaBadgeText.textContent = profile.upazila;
      viewUpazilaBadge.style.display = 'inline-flex';
    } else {
      viewUpazilaBadge.style.display = 'none';
    }

    setDonorToggle(!!profile.is_blood_donor);
    updateDonorHint();
  }

  function setDonorToggle(on) {
    isDonorOn = on;
    donorToggleBtn?.classList.toggle('on', on);
    donorToggleBtn?.setAttribute('aria-checked', String(on));
  }

  function updateDonorHint() {
    const hasBloodGroup = !!currentProfile?.blood_group;
    if (donorToggleHint) {
      donorToggleHint.textContent = hasBloodGroup
        ? 'জরুরি প্রয়োজনে অন্যরা আপনার তথ্য দেখতে পাবে'
        : 'ব্লাড গ্রুপ যোগ করলে চালু করা যাবে (এডিট করুন থেকে)';
      donorToggleHint.classList.remove('hint-error');
    }
  }

  donorToggleBtn?.addEventListener('click', async () => {
    if (!currentProfile?.blood_group) {
      if (donorToggleHint) {
        donorToggleHint.textContent = 'আগে "এডিট করুন" থেকে ব্লাড গ্রুপ সিলেক্ট করুন';
        donorToggleHint.classList.add('hint-error');
      }
      return;
    }

    const newValue = !isDonorOn;
    setDonorToggle(newValue);

    const { error } = await supabase
      .from('profiles')
      .update({ is_blood_donor: newValue })
      .eq('id', currentUserId);

    if (error) {
      setDonorToggle(!newValue);
      if (donorToggleHint) {
        donorToggleHint.textContent = 'আপডেট ব্যর্থ, আবার চেষ্টা করুন';
        donorToggleHint.classList.add('hint-error');
      }
      return;
    }

    currentProfile.is_blood_donor = newValue;
    updateDonorHint();
  });

  function renderShortcuts(profile) {
    const isAdminOrMod = profile.role === 'admin' || profile.role === 'moderator';
    const isAdmin = profile.role === 'admin';
    const isShopOwner = !!profile.is_shop_owner;
    const isClubOwner = !!profile.is_club_owner;

    shortcutAdmin.style.display = isAdminOrMod ? 'flex' : 'none';
    shortcutLuckyDraw.style.display = isAdmin ? 'flex' : 'none';
    shortcutShop.style.display = isShopOwner ? 'flex' : 'none';
    shortcutClub.style.display = isClubOwner ? 'flex' : 'none';
  }

  profileLogoutBtn?.addEventListener('click', async () => {
    if (!logoutConfirming) {
      logoutConfirming = true;
      profileLogoutBtn.classList.add('confirming');
      if (profileLogoutText) profileLogoutText.textContent = 'নিশ্চিত করুন?';
      return;
    }
    await supabase.auth.signOut();
    window.dispatchEvent(new CustomEvent('smartfeni:logged-out'));
    window.location.href = '/';
  });

  function populateEditForm(profile) {
    if (!profile) return;

    if (nameInput) nameInput.value = profile.full_name || '';
    if (phoneInput) phoneInput.value = profile.phone || '';
    if (emailInput) emailInput.value = profile.recovery_email || '';
    if (bloodGroupSelect) bloodGroupSelect.value = profile.blood_group || '';
    if (upazilaSelect) upazilaSelect.value = profile.upazila || '';

    selectedPhotoFile = null;
    if (profile.avatar_url) {
      photoImg.src = profile.avatar_url;
      photoCircle?.classList.add('has-photo');
    } else {
      photoImg.src = '';
      photoCircle?.classList.remove('has-photo');
    }
  }

  function openEditMode() {
    populateEditForm(currentProfile);
    clearMsg(profileMessage);
    profileView.style.display = 'none';
    profileEditForm.style.display = 'block';
  }

  function closeEditMode() {
    profileEditForm.style.display = 'none';
    profileView.style.display = 'block';
  }

  openEditBtn?.addEventListener('click', openEditMode);
  cancelEditBtn?.addEventListener('click', closeEditMode);
  cancelEditBtn2?.addEventListener('click', closeEditMode);

  // ============================================================
  // ডেলিভারি হিরো — লোড ও রেন্ডার
  // ============================================================
  function hideAllRiderCards() {
    riderPendingCard.style.display = 'none';
    riderRejectedCard.style.display = 'none';
    riderCard.style.display = 'none';
  }

  async function loadRiderSection() {
    const { data: riderRow } = await supabase
      .from('delivery_riders')
      .select('*')
      .eq('profile_id', currentUserId)
      .maybeSingle();

    hideAllRiderCards();

    if (!riderRow) {
      // রেজিস্টার্ড না থাকলে কিছুই দেখাবে না — আবেদন করার পথ এখন
      // bottom-nav "➕পোস্ট" থেকে
      return;
    }

    currentRiderRow = riderRow;

    if (riderRow.verification_status === 'pending') {
      riderPendingCard.style.display = 'block';
      return;
    }

    if (riderRow.verification_status === 'rejected') {
      riderRejectedReason.textContent = riderRow.rejection_reason || 'যাচাই করতে সমস্যা হয়েছে';
      riderRejectedCard.style.display = 'block';
      return;
    }

    // approved
    riderCard.style.display = 'block';
    riderOnlineToggle.checked = riderRow.is_active;
    renderStatus(riderStatusText, riderRow.is_active);
    riderStatCompleted.textContent = riderRow.total_completed || 0;
    riderStatEarned.textContent = `৳${riderRow.total_earned || 0}`;
    riderStatRating.textContent = riderRow.avg_rating ? `${riderRow.avg_rating} ★` : '—';

    await loadActiveDeliveries(riderRow.id);
    await loadOpenRequests(riderRow.vehicle_type);
  }

  // ===== অনলাইন/অফলাইন টগল (is_active, ইনস্ট্যান্ট সেভ) =====
  riderOnlineToggle?.addEventListener('change', async () => {
    const isActive = riderOnlineToggle.checked;
    renderStatus(riderStatusText, isActive);
    clearMsg(riderMessage);

    const { error } = await supabase
      .from('delivery_riders')
      .update({ is_active: isActive })
      .eq('id', currentRiderRow.id);

    if (error) {
      showMsg(riderMessage, 'স্ট্যাটাস আপডেট ব্যর্থ: ' + error.message);
      riderOnlineToggle.checked = !isActive;
      renderStatus(riderStatusText, !isActive);
      return;
    }

    currentRiderRow.is_active = isActive;
  });

  // ===== চলমান ডেলিভারি (confirmed/delivered) =====
  async function loadActiveDeliveries(riderId) {
    const { data: activeRequests } = await supabase
      .from('delivery_requests')
      .select('id, description, upazila, area_detail, final_price, status')
      .eq('accepted_rider_id', riderId)
      .in('status', ['confirmed', 'delivered'])
      .order('created_at', { ascending: false });

    riderActiveDeliveryList.innerHTML = '';

    if (!activeRequests || activeRequests.length === 0) {
      riderActiveDeliverySection.style.display = 'none';
      return;
    }

    riderActiveDeliverySection.style.display = 'block';

    activeRequests.forEach((req) => {
      const card = document.createElement('div');
      card.className = 'rider-active-card';

      const statusLabel = req.status === 'confirmed' ? 'কনফার্মড — ডেলিভারি চলছে' : 'কাস্টমার রিসিভড মার্ক করেছে';

      card.innerHTML = `
        <p class="rider-active-status"><i class="fas fa-circle"></i> ${statusLabel}</p>
        <p class="rider-req-desc">${req.description || ''}</p>
        <p class="rider-req-area"><i class="fas fa-location-dot"></i> ${req.upazila || ''} — ${req.area_detail || ''}</p>
        <p class="rider-req-price">৳${req.final_price || 0}</p>
        ${req.status === 'delivered' ? `<button class="btn-confirm-delivery" data-request-id="${req.id}"><i class="fas fa-check"></i> ডেলিভারি কনফার্ম করুন</button>` : ''}
      `;

      card.querySelector('.btn-confirm-delivery')?.addEventListener('click', async (e) => {
        e.target.disabled = true;
        const { error } = await confirmDelivery({ requestId: req.id });
        if (error) {
          alert(error);
          e.target.disabled = false;
          return;
        }
        loadRiderSection();
      });

      riderActiveDeliveryList.appendChild(card);
    });
  }

  // ===== ওপেন রিকোয়েস্ট লিস্ট =====
  async function loadOpenRequests(vehicleType) {
    const { data: openRequests } = await supabase
      .from('delivery_requests')
      .select('id, description, upazila, area_detail, current_price, vehicle_type')
      .eq('status', 'open')
      .or(`vehicle_type.eq.${vehicleType},vehicle_type.eq.any`)
      .order('created_at', { ascending: false });

    // এই রাইডারের নিজের অফার (থাকলে) একসাথে ফেচ
    const { data: myOffers } = await supabase
      .from('delivery_offers')
      .select('request_id, offer_price, status')
      .eq('rider_profile_id', currentUserId);

    const myOfferMap = new Map((myOffers || []).map((o) => [o.request_id, o]));

    riderOpenRequestsList.innerHTML = '';

    if (!openRequests || openRequests.length === 0) {
      riderOpenRequestsEmpty.style.display = 'block';
      return;
    }
    riderOpenRequestsEmpty.style.display = 'none';

    openRequests.forEach((req) => {
      const myOffer = myOfferMap.get(req.id);
      const card = document.createElement('div');
      card.className = 'rider-req-card';

      const vehicleLabel = req.vehicle_type === 'bike' ? 'বাইক' : req.vehicle_type === 'cycle' ? 'সাইকেল' : 'যেকোনো';

      card.innerHTML = `
        <div class="rider-req-top">
          <span class="rider-req-price">৳${req.current_price}</span>
          <span class="rider-req-vehicle-badge">${vehicleLabel}</span>
        </div>
        <p class="rider-req-desc">${req.description || ''}</p>
        <p class="rider-req-area"><i class="fas fa-location-dot"></i> ${req.upazila || ''} — ${req.area_detail || ''}</p>
        ${myOffer && myOffer.status === 'negotiating' ? `<p class="rider-req-my-offer"><i class="fas fa-check"></i> আপনার অফার: ৳${myOffer.offer_price}</p>` : ''}
        <div class="rider-req-actions">
          <button class="btn-rider-accept" data-action="accept">accept করুন</button>
          <button class="btn-rider-counter" data-action="show-counter">দাম প্রস্তাব</button>
        </div>
        <div class="rider-counter-row">
          <input type="number" placeholder="আপনার দাম" min="1" />
          <button data-action="submit-counter">পাঠান</button>
        </div>
      `;

      const counterRow = card.querySelector('.rider-counter-row');

      card.querySelector('[data-action="accept"]')?.addEventListener('click', async (e) => {
        e.target.disabled = true;
        const { error } = await riderRespond({ requestId: req.id, action: 'accept' });
        if (error) {
          alert(error);
          e.target.disabled = false;
          return;
        }
        loadRiderSection();
      });

      card.querySelector('[data-action="show-counter"]')?.addEventListener('click', () => {
        counterRow.classList.toggle('active');
      });

      card.querySelector('[data-action="submit-counter"]')?.addEventListener('click', async () => {
        const input = counterRow.querySelector('input');
        const price = Number(input.value);
        if (!price || price <= 0) {
          alert('সঠিক দাম দিন');
          return;
        }
        const { error } = await riderRespond({ requestId: req.id, action: 'counter', offerPrice: price });
        if (error) {
          alert(error);
          return;
        }
        loadOpenRequests(vehicleType);
      });

      riderOpenRequestsList.appendChild(card);
    });
  }

  // ===== পেজ লোড হলে সেশন চেক + প্রোফাইল লোড =====
  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      editContent.style.display = 'none';
      authGate.style.display = 'block';
      return;
    }

    currentUserId = session.user.id;
    currentUserEmail = session.user.email;
    currentAccessToken = session.access_token;

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name, phone, recovery_email, blood_group, upazila, avatar_url, is_blood_donor, role, is_shop_owner, is_club_owner')
      .eq('id', currentUserId)
      .single();

    if (profile) {
      currentProfile = profile;
      renderProfileView(profile);
      renderShortcuts(profile);
      populateEditForm(profile);
    }

    await loadRiderSection();

    // অ্যাপ্রুভড car-rental লিস্টিং আছে কিনা চেক
    const { data: carListing } = await supabase
      .from('listings')
      .select('*')
      .eq('user_id', currentUserId)
      .eq('category', 'car-rental')
      .eq('status', 'active')
      .maybeSingle();

    if (carListing) {
      currentCarListing = carListing;
      carCard.style.display = 'block';
      carOnlineToggle.checked = carListing.is_online !== false;
      renderStatus(carStatusText, carOnlineToggle.checked);
      carVehicleInput.value = carListing.price || '';
      carDescriptionInput.value = carListing.description || '';
    }
  }

  init();

  photoInput?.addEventListener('change', () => {
    const file = photoInput.files?.[0];
    if (!file) return;
    selectedPhotoFile = file;
    const reader = new FileReader();
    reader.onload = () => {
      photoImg.src = reader.result;
      photoCircle?.classList.add('has-photo');
    };
    reader.readAsDataURL(file);
  });

  async function uploadAvatar(accessToken, file) {
    try {
      const formData = new FormData();
      formData.append('file', file);

      const res = await fetch('/api/upload-avatar', {
        method: 'POST',
        headers: { Authorization: `Bearer ${accessToken}` },
        body: formData,
      });

      const result = await res.json();

      if (!res.ok) {
        console.error('ছবি আপলোড এরর:', result.error);
        return null;
      }

      return result.url || null;
    } catch (err) {
      console.error('ছবি আপলোড নেটওয়ার্ক এরর:', err);
      return null;
    }
  }

  saveProfileBtn?.addEventListener('click', async () => {
    clearMsg(profileMessage);

    const name = nameInput?.value?.trim();
    if (!name) {
      showMsg(profileMessage, 'নাম খালি রাখা যাবে না');
      return;
    }

    setLoading(saveProfileBtn, true, 'সেভ হচ্ছে...');

    let avatarUrl = null;
    if (selectedPhotoFile && currentAccessToken) {
      avatarUrl = await uploadAvatar(currentAccessToken, selectedPhotoFile);
    }

    const updates = {
      full_name: name,
      recovery_email: emailInput?.value?.trim() || null,
      blood_group: bloodGroupSelect?.value || null,
      upazila: upazilaSelect?.value || null,
    };
    if (avatarUrl) updates.avatar_url = avatarUrl;

    if (!updates.blood_group && isDonorOn) {
      updates.is_blood_donor = false;
    }

    const { error } = await supabase.from('profiles').update(updates).eq('id', currentUserId);

    setLoading(saveProfileBtn, false);

    if (error) {
      showMsg(profileMessage, 'সেভ করতে সমস্যা হয়েছে: ' + error.message);
      return;
    }

    currentProfile = { ...currentProfile, ...updates };
    renderProfileView(currentProfile);
    showMsg(profileMessage, 'তথ্য সেভ হয়েছে ✓', 'success');
    setTimeout(closeEditMode, 900);
  });

  // ===== ফোন নম্বর পরিবর্তন =====
  savePhoneBtn?.addEventListener('click', async () => {
    clearMsg(phoneMessage);

    const newPhone = newPhoneInput?.value?.trim();
    const password = phoneChangePasswordInput?.value;

    if (!newPhone || !password) {
      showMsg(phoneMessage, 'নতুন নম্বর ও বর্তমান পাসওয়ার্ড দিন');
      return;
    }

    setLoading(savePhoneBtn, true, 'যাচাই হচ্ছে...');

    const res = await fetch('/api/change-phone', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accessToken: currentAccessToken, currentPassword: password, newPhone }),
    });
    const result = await res.json();

    setLoading(savePhoneBtn, false);

    if (!res.ok) {
      showMsg(phoneMessage, result.error || 'নম্বর বদলানো যায়নি');
      return;
    }

    showMsg(phoneMessage, 'নম্বর বদলানো হয়েছে ✓ আবার লগইন করতে হবে...', 'success');
    setTimeout(async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    }, 1800);
  });

  // ===== গাড়ি ভাড়া অনলাইন/অফলাইন টগল =====
  carOnlineToggle?.addEventListener('change', async () => {
    const isOnline = carOnlineToggle.checked;
    renderStatus(carStatusText, isOnline);
    clearMsg(carMessage);

    const { error } = await supabase
      .from('listings')
      .update({ is_online: isOnline })
      .eq('id', currentCarListing.id);

    if (error) {
      showMsg(carMessage, 'স্ট্যাটাস আপডেট ব্যর্থ: ' + error.message);
      carOnlineToggle.checked = !isOnline;
      renderStatus(carStatusText, !isOnline);
      return;
    }

    currentCarListing.is_online = isOnline;
  });

  saveCarBtn?.addEventListener('click', async () => {
    clearMsg(carMessage);

    const vehicle = carVehicleInput.value.trim();
    const description = carDescriptionInput.value.trim();

    setLoading(saveCarBtn, true, 'সেভ হচ্ছে...');

    const { error } = await supabase
      .from('listings')
      .update({ price: vehicle, description })
      .eq('id', currentCarListing.id);

    setLoading(saveCarBtn, false);

    if (error) {
      showMsg(carMessage, 'সেভ ব্যর্থ: ' + error.message);
      return;
    }

    showMsg(carMessage, 'গাড়ির তথ্য সেভ হয়েছে ✓', 'success');
    currentCarListing.price = vehicle;
    currentCarListing.description = description;
  });

  // ===== পাসওয়ার্ড বদল =====
  changePasswordBtn?.addEventListener('click', async () => {
    clearMsg(passwordMessage);

    const currentPassword = currentPasswordInput?.value;
    const newPassword = newPasswordInput?.value;
    const confirmPassword = confirmPasswordInput?.value;

    if (!currentPassword || !newPassword || !confirmPassword) {
      showMsg(passwordMessage, 'সব ঘর পূরণ করুন');
      return;
    }
    if (newPassword.length < 6) {
      showMsg(passwordMessage, 'নতুন পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে');
      return;
    }
    if (newPassword !== confirmPassword) {
      showMsg(passwordMessage, 'নতুন পাসওয়ার্ড দুইবার একই হয়নি');
      return;
    }

    setLoading(changePasswordBtn, true, 'যাচাই হচ্ছে...');

    const { error: reauthError } = await supabase.auth.signInWithPassword({
      email: currentUserEmail,
      password: currentPassword,
    });

    if (reauthError) {
      showMsg(passwordMessage, 'বর্তমান পাসওয়ার্ড সঠিক নয়');
      setLoading(changePasswordBtn, false);
      return;
    }

    const { error: updateError } = await supabase.auth.updateUser({ password: newPassword });

    setLoading(changePasswordBtn, false);

    if (updateError) {
      showMsg(passwordMessage, 'পাসওয়ার্ড বদলাতে সমস্যা হয়েছে: ' + updateError.message);
      return;
    }

    showMsg(passwordMessage, 'পাসওয়ার্ড বদলানো হয়েছে ✓', 'success');
    currentPasswordInput.value = '';
    newPasswordInput.value = '';
    confirmPasswordInput.value = '';
  });
</script>