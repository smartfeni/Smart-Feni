---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import FeaturedPhotos from '../components/ui/FeaturedPhotos.astro';
import CategoryGrid from '../components/ui/CategoryGrid.astro';

// ============================================================
// Vercel Edge/CDN যাতে এই পেজের HTML কখনো cache করে না রাখে —
// smartfeni.com (কাস্টম ডোমেইন) এ পুরনো cached HTML সার্ভ হওয়ার
// কারণে hidden ক্যাটাগরি/আপডেট নতুন করে দেখাতে দেরি হচ্ছিল।
// no-store দিলে প্রতি রিকোয়েস্টে ফ্রেশ SSR রেসপন্স যাবে।
// ============================================================
Astro.response.headers.set('Cache-Control', 'no-store, must-revalidate');
---

<BaseLayout title="স্মার্ট ফেনী - আপনার শহরের ডিজিটাল সেবা">
  <Hero />
  <FeaturedPhotos />
  <CategoryGrid />
</BaseLayout>