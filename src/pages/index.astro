---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import ScratchCard from '../components/ui/ScratchCard.astro';
import FeaturedPhotos from '../components/ui/FeaturedPhotos.astro';
import CategoryGrid from '../components/ui/CategoryGrid.astro';
import { supabase } from '../lib/supabase.js';

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600'
);

let sectionOrder = 'photos_first';
try {
  const { data, error } = await supabase
    .from('site_settings')
    .select('value')
    .eq('key', 'homepage_section_order')
    .maybeSingle();
  if (!error && data?.value) {
    if (data.value === 'category_first') sectionOrder = 'photos_last';
    else if (['photos_first', 'photos_middle', 'photos_last'].includes(data.value)) sectionOrder = data.value;
  }
} catch (e) {
  // Homepage remains usable when settings are unavailable.
}
---

<BaseLayout title="স্মার্ট ফেনী - আপনার শহরের ডিজিটাল সেবা" showChatWidget={true} showFooter={true}>
  <main class="sf-home">
    <section class="sf-discovery" aria-labelledby="sf-home-title">
      <div class="sf-intro">
        <span class="sf-location"><span class="sf-location-mark" aria-hidden="true"></span> ফেনী, বাংলাদেশ</span>
        <h1 id="sf-home-title">আপনার শহর, আপনার হাতেই।</h1>
        <p>ফেনীর দৈনন্দিন প্রয়োজনীয় সেবা, এখন এক জায়গায়।</p>
      </div>

      <div class="sf-search">
        <div class="sf-search-label">
          <span class="sf-search-overline">SMART FENI</span>
          <span class="sf-search-title">আজ কী খুঁজছেন?</span>
        </div>
        <Hero />
      </div>
    </section>

    <ScratchCard />

    {sectionOrder === 'photos_first' && (
      <>
        <FeaturedPhotos />
        <CategoryGrid part="popular" />
        <div class="sf-more-heading"><span>আরও যা প্রয়োজন</span><i aria-hidden="true"></i></div>
        <CategoryGrid part="general" />
      </>
    )}
    {sectionOrder === 'photos_middle' && (
      <>
        <CategoryGrid part="popular" />
        <FeaturedPhotos />
        <div class="sf-more-heading"><span>আরও যা প্রয়োজন</span><i aria-hidden="true"></i></div>
        <CategoryGrid part="general" />
      </>
    )}
    {sectionOrder === 'photos_last' && (
      <>
        <CategoryGrid part="popular" />
        <div class="sf-more-heading"><span>আরও যা প্রয়োজন</span><i aria-hidden="true"></i></div>
        <CategoryGrid part="general" />
        <FeaturedPhotos />
      </>
    )}
  </main>
</BaseLayout>

<style is:global>
  html body {
    background: #F5F7F5;
    background-image: none;
  }

  .sf-home {
    --sf-ink: #1B2A4A;
    --sf-green: #07845B;
    --sf-muted: #718078;
    --sf-line: #E7ECE8;
    color: var(--sf-ink);
    padding: 0 0 24px;
    overflow: clip;
  }

  .sf-discovery {
    max-width: 1280px;
    margin: 0 auto;
    padding: 26px 24px 12px;
  }

  .sf-intro {
    padding: 4px 2px 18px;
  }

  .sf-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sf-green);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .15px;
  }

  .sf-location-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sf-green);
    box-shadow: 0 0 0 4px rgba(7,132,91,.10);
  }

  .sf-intro h1 {
    margin: 10px 0 5px;
    color: var(--sf-ink);
    font-size: clamp(25px, 3.4vw, 38px);
    line-height: 1.22;
    letter-spacing: -.65px;
    font-weight: 800;
  }

  .sf-intro p {
    margin: 0;
    color: #718078;
    font-size: 14px;
    line-height: 1.65;
  }

  .sf-search {
    position: relative;
    padding: 17px 18px 7px;
    border: 1px solid rgba(27,42,74,.065);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(27,42,74,.045);
  }

  .sf-search-label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0 5px;
  }

  .sf-search-overline {
    color: #8A9A91;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.45px;
  }

  .sf-search-title {
    color: var(--sf-ink);
    font-size: 16px;
    font-weight: 750;
  }

  .sf-search .hero {
    padding: 8px 0 10px;
  }

  .sf-search .hero .container {
    max-width: none;
    padding: 0;
  }

  .sf-search .hero-search {
    max-width: none;
  }

  .sf-search .search-card {
    border-color: #E5ECE7;
    border-radius: 15px;
    padding: 6px 7px 6px 15px;
    box-shadow: none;
    background: #F8FAF8;
  }

  .sf-search .search-card:focus-within {
    border-color: rgba(7,132,91,.45);
    box-shadow: 0 0 0 3px rgba(7,132,91,.08);
  }

  .sf-search .search-card > i {
    color: var(--sf-green);
  }

  .sf-search .search-card .btn-primary {
    background: var(--sf-green);
    border-radius: 11px;
    padding: 11px 17px;
    box-shadow: none;
  }

  .sf-search .search-card .btn-primary:hover {
    background: #066B4A;
  }

  .sf-search .wipe-mask {
    background: #F8FAF8;
  }

  .sf-search .search-results {
    top: calc(100% + 8px);
    border: 1px solid var(--sf-line);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(27,42,74,.13);
  }

  .sf-home .sc-teaser {
    max-width: 1232px;
    margin: 12px auto 18px;
    padding: 0 24px;
  }

  .sf-home .featured-photo-section {
    padding: 14px 0 26px;
  }

  .sf-home .featured-photo-section .container,
  .sf-home .category-section .container {
    max-width: 1280px;
  }

  .sf-home .photo-card {
    border-radius: 20px;
    box-shadow: 0 10px 28px rgba(27,42,74,.09);
  }

  .sf-home .category-section {
    padding: 12px 0 18px;
  }

  .sf-home .popular-label {
    margin: 0 0 12px 2px;
    color: var(--sf-green);
    font-size: 13px;
    font-weight: 800;
  }

  .sf-home .popular-label i {
    filter: none;
  }

  .sf-home .category-grid {
    gap: 14px;
  }

  .sf-home .category-card,
  .sf-home .category-card-popular {
    border-radius: 17px;
    box-shadow: 0 3px 12px rgba(27,42,74,.045);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  .sf-home .category-card-popular {
    border-color: #DCEBE3;
    background: #fff;
  }

  .sf-home .category-card:hover,
  .sf-home .category-card-popular:hover {
    box-shadow: 0 9px 22px rgba(27,42,74,.09);
  }

  .sf-more-heading {
    max-width: 1232px;
    margin: 18px auto 0;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--sf-ink);
    font-size: 17px;
    font-weight: 800;
  }

  .sf-more-heading i {
    flex: 1;
    height: 1px;
    background: #E2E9E4;
  }

  html body footer {
    background: linear-gradient(160deg, #EAF4EE 0%, #DDECE3 100%);
  }

  @media (min-width: 769px) {
    .sf-discovery {
      padding-top: 34px;
      padding-bottom: 18px;
    }

    .sf-intro {
      padding-bottom: 22px;
    }

    .sf-search {
      max-width: 820px;
      padding: 20px 24px 8px;
    }

    .sf-search .hero {
      padding-top: 10px;
    }

    .sf-home .category-grid {
      gap: 18px;
    }
  }

  @media (max-width: 768px) {
    .sf-discovery {
      padding: 17px 16px 8px;
    }

    .sf-intro {
      padding: 2px 1px 14px;
    }

    .sf-intro h1 {
      margin-top: 8px;
      font-size: clamp(24px, 6.4vw, 30px);
      letter-spacing: -.5px;
    }

    .sf-intro p {
      font-size: 12px;
    }

    .sf-search {
      padding: 13px 11px 5px;
      border-radius: 18px;
    }

    .sf-search-title {
      font-size: 14px;
    }

    .sf-search .hero {
      padding: 6px 0 7px;
    }

    .sf-search .search-card {
      gap: 7px;
      padding-left: 12px;
    }

    .sf-search .search-card .btn-primary {
      padding: 10px 13px;
      font-size: 12px;
    }

    .sf-home .sc-teaser {
      margin: 10px 0 14px;
      padding: 0 16px;
    }

    .sf-home .featured-photo-section {
      padding: 8px 0 14px;
    }

    .sf-home .photo-card {
      border-radius: 15px;
    }

    .sf-home .category-section {
      padding: 5px 0 11px;
    }

    .sf-home .category-grid {
      gap: 9px;
    }

    .sf-home .category-card,
    .sf-home .category-card-popular {
      border-radius: 13px;
    }

    .sf-more-heading {
      margin-top: 14px;
      padding: 0 16px;
      font-size: 15px;
    }
  }

  @media (max-width: 380px) {
    .sf-discovery {
      padding-right: 13px;
      padding-left: 13px;
    }

    .sf-search .search-card {
      padding-left: 10px;
    }

    .sf-search .search-card .btn-primary {
      padding: 10px 11px;
    }

    .sf-home .category-grid {
      gap: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sf-home .category-card,
    .sf-home .category-card-popular {
      transition: none;
    }
  }
</style>
