---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import FeaturedPhotos from '../components/ui/FeaturedPhotos.astro';
import CategoryGrid from '../components/ui/CategoryGrid.astro';
import { supabase } from '../lib/supabase.js';

// ============================================================
// আপডেট: no-store বদলে stale-while-revalidate ব্যবহার করা হলো —
// CDN ৬০ সেকেন্ড পর্যন্ত পেজ cache রাখবে (দ্রুত লোডিং), তারপর
// background-এ ফ্রেশ ভার্সন fetch করবে। ফলে সব ভিজিটর দ্রুত পেজ
// পাবে, আর ক্যাটাগরি/কনটেন্ট আপডেট সর্বোচ্চ ~৬০-৯০ সেকেন্ডে
// রিফ্লেক্ট হবে (আগের no-store এ প্রতিটা ভিজিটে সার্ভার লোড হতো,
// যেটা ট্রাফিক বাড়লে খরচ/স্পিডে প্রভাব ফেলতো)।
// ============================================================
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=30'
);

// আপডেট (হোমপেজ সেকশন অর্ডার): site_settings টেবিলের
// 'homepage_section_order' কী দিয়ে ঠিক হয় Featured Photos আগে না
// Category Grid আগে দেখাবে — অ্যাডমিন প্যানেল /admin/categories
// থেকে নিয়ন্ত্রিত। fetch ব্যর্থ হলে ডিফল্ট 'photos_first' (আগের
// আচরণ) হিসেবে থাকবে, পেজ ভাঙবে না।
let categoryFirst = false;
try {
  const { data, error } = await supabase
    .from('site_settings')
    .select('value')
    .eq('key', 'homepage_section_order')
    .maybeSingle();
  if (!error && data?.value === 'category_first') {
    categoryFirst = true;
  }
} catch (e) {
  // fallback: photos_first
}
---

<BaseLayout title="স্মার্ট ফেনী - আপনার শহরের ডিজিটাল সেবা" showChatWidget={true}>
  <Hero />
  {categoryFirst ? (
    <>
      <CategoryGrid />
      <FeaturedPhotos />
    </>
  ) : (
    <>
      <FeaturedPhotos />
      <CategoryGrid />
    </>
  )}
</BaseLayout>