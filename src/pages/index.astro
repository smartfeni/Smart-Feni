---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import ScratchCard from '../components/ui/ScratchCard.astro';
import FeaturedPhotos from '../components/ui/FeaturedPhotos.astro';
import HomeServices from '../components/home/HomeServices.astro';
import { supabase } from '../lib/supabase.js';

// ============================================================
// আপডেট: no-store বদলে stale-while-revalidate ব্যবহার করা হলো —
// CDN ৬০ সেকেন্ড পর্যন্ত পেজ cache রাখবে (দ্রুত লোডিং), তারপর
// background-এ ফ্রেশ ভার্সন fetch করবে। ফলে সব ভিজিটর দ্রুত পেজ
// পাবে, আর ক্যাটাগরি/কনটেন্ট আপডেট সর্বোচ্চ ~৬০-৯০ সেকেন্ডে
// রিফ্লেক্ট হবে (আগের no-store এ প্রতিটা ভিজিটে সার্ভার লোড হতো,
// যেটা ট্রাফিক বাড়লে খরচ/স্পিডে প্রভাব ফেলতো)।
// ============================================================
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600'
);

// আপডেট (হোমপেজ সেকশন অর্ডার — ৩ অপশন): site_settings টেবিলের
// 'homepage_section_order' কী দিয়ে ঠিক হয় Featured Photos কোথায়
// বসবে — Popular ও General ক্যাটাগরি গ্রিডের উপরে, মাঝখানে, নাকি
// নিচে। Popular সবসময় General-এর আগে থাকে (fix), শুধু Photos-এর
// পজিশন বদলায়। অ্যাডমিন প্যানেল /admin/categories থেকে নিয়ন্ত্রিত।
// fetch ব্যর্থ হলে ডিফল্ট 'photos_first' (আগের আচরণ) হিসেবে থাকবে।
let sectionOrder = 'photos_first';
try {
  const { data, error } = await supabase
    .from('site_settings')
    .select('value')
    .eq('key', 'homepage_section_order')
    .maybeSingle();
  if (!error && data?.value) {
    // পুরনো ২-অপশন ভ্যালু থাকলে নতুন সিস্টেমে ম্যাপ করা হচ্ছে
    if (data.value === 'category_first') {
      sectionOrder = 'photos_last';
    } else if (['photos_first', 'photos_middle', 'photos_last'].includes(data.value)) {
      sectionOrder = data.value;
    }
  }
} catch (e) {
  // fallback: photos_first
}
---

<!-- হোম রিডিজাইন (নভে ২০২৬): দিনের সময়ের সাথে বদলানো হোম।
     উপরের রঙিন অংশ (শুভেচ্ছা + সার্চ + "এখন যা লাগতে পারে") বাংলাদেশ সময় দেখে সকাল/দুপুর/সন্ধ্যা/রাতে বদলায়।
     নিচের হালকা অংশে স্ক্র্যাচ কার্ড, ফিচার্ড ফটো (অ্যাডমিনের sectionOrder: last হলে সবার নিচে) ও সব সেবা। -->
<BaseLayout title="স্মার্ট ফেনী - আপনার শহরের ডিজিটাল সেবা" showChatWidget={true} showFooter={true}>
  <div class="home-t" data-slot="noon">
    <script is:inline>
      (function () {
        var root = document.currentScript && document.currentScript.parentElement;
        function slot() {
          try {
            var h = Number(new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone: 'Asia/Dhaka' }).format(new Date()));
            var s = h >= 5 && h < 12 ? 'morning' : h >= 12 && h < 17 ? 'noon' : h >= 17 && h < 20 ? 'evening' : 'night';
            if (root) root.setAttribute('data-slot', s);
          } catch (e) {}
        }
        slot();
        window.sfHomeSlot = slot;
      })();
    </script>
    <section class="ht-band">
      <div class="container">
        <h1 class="ht-greet">
          <span class="ht-g ht-g-morning">শুভ সকাল</span>
          <span class="ht-g ht-g-noon">শুভ দুপুর</span>
          <span class="ht-g ht-g-evening">শুভ সন্ধ্যা</span>
          <span class="ht-g ht-g-night">শুভ রাত্রি</span>
        </h1>
        <p class="ht-date" data-no-i18n></p>
        <script is:inline>
          // দিন + বঙ্গাব্দ তারিখ + ঘড়ি (ফেনী/বাংলাদেশ সময়), প্রতি মিনিটে আপডেট। English মোডে ইংরেজি তারিখ।
          (function () {
            var el = document.currentScript && document.currentScript.previousElementSibling;
            if (!el) return;
            var BD = '০১২৩৪৫৬৭৮৯';
            var bn = function (n) { return String(n).replace(/\d/g, function (d) { return BD[d]; }); };
            var DAYS = ['রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার', 'শনিবার'];
            var MONTHS = ['বৈশাখ', 'জ্যৈষ্ঠ', 'আষাঢ়', 'শ্রাবণ', 'ভাদ্র', 'আশ্বিন', 'কার্তিক', 'অগ্রহায়ণ', 'পৌষ', 'মাঘ', 'ফাল্গুন', 'চৈত্র'];
            function parts() {
              var o = {};
              new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Dhaka', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: '2-digit', hourCycle: 'h23' })
                .formatToParts(new Date()).forEach(function (p) { o[p.type] = p.value; });
              return { y: +o.year, m: +o.month, d: +o.day, h: +o.hour, min: o.minute };
            }
            // বাংলাদেশের সংশোধিত বঙ্গাব্দ (২০১৯): ১৪ এপ্রিল পহেলা বৈশাখ; প্রথম ৬ মাস ৩১ দিন, কার্তিক–মাঘ ও চৈত্র ৩০, ফাল্গুন ২৯ (অধিবর্ষে ৩০)
            function bangla(y, m, d) {
              var today = Date.UTC(y, m - 1, d);
              var by = (m > 4 || (m === 4 && d >= 14)) ? y : y - 1;
              var idx = Math.round((today - Date.UTC(by, 3, 14)) / 864e5);
              var g = by + 1;
              var leap = (g % 4 === 0 && g % 100 !== 0) || g % 400 === 0;
              var len = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, leap ? 30 : 29, 30];
              var i = 0;
              while (i < 11 && idx >= len[i]) { idx -= len[i]; i++; }
              return bn(idx + 1) + ' ' + MONTHS[i] + ' ' + bn(by - 593);
            }
            function period(h) {
              return h >= 4 && h < 6 ? 'ভোর' : h >= 6 && h < 12 ? 'সকাল' : h >= 12 && h < 15 ? 'দুপুর' : h >= 15 && h < 17 ? 'বিকাল' : h >= 17 && h < 20 ? 'সন্ধ্যা' : 'রাত';
            }
            function render() {
              try {
                var p = parts();
                var h12 = p.h % 12 || 12;
                var en = window.SFLang && window.SFLang.get && window.SFLang.get() === 'en';
                if (en) {
                  el.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date()) +
                    ' · ' + h12 + ':' + p.min + (p.h < 12 ? ' AM' : ' PM');
                } else {
                  var wd = new Date(Date.UTC(p.y, p.m - 1, p.d)).getUTCDay();
                  el.textContent = DAYS[wd] + ', ' + bangla(p.y, p.m, p.d) + ' · ' + period(p.h) + ' ' + bn(h12) + ':' + bn(p.min);
                }
                if (typeof window.sfHomeSlot === 'function') window.sfHomeSlot();
              } catch (e) {}
            }
            render();
            setTimeout(function () { render(); setInterval(render, 60000); }, 60000 - (Date.now() % 60000) + 50);
            document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') render(); });
          })();
        </script>
      </div>
      <Hero />
      <div class="container">
        <HomeServices part="now" />
      </div>
    </section>
    <section class="ht-sheet">
      <ScratchCard />
      {sectionOrder !== 'photos_last' && <FeaturedPhotos />}
      <div class="container">
        <HomeServices part="grid" />
      </div>
      {sectionOrder === 'photos_last' && <FeaturedPhotos />}
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* হোমপেজ-অনলি স্টাইল। Hero/ScratchCard/FeaturedPhotos-এর লজিক অপরিবর্তিত, শুধু চেহারা। */
  html body { background-color: #F5F7F4; background-image: none; }
  html body footer {
    background:
      radial-gradient(circle at 90% 5%, rgba(255, 107, 53, 0.14) 0%, transparent 42%),
      linear-gradient(160deg, #FFE9D8 0%, #F6D3B6 100%);
    background-size: auto;
  }

  /* সময় অনুযায়ী রং (টেক্সট কনট্রাস্ট ৪.৫:১-এর বেশি) */
  .home-t { --hs-bg: #0A662A; --hs-ink: #fff; --hs-sub: #CDEBD6; --hs-row: rgba(255,255,255,0.12); --hs-row-press: rgba(255,255,255,0.2); --hs-btn: #FF6B35; }
  .home-t[data-slot='morning'] { --hs-bg: #FFE2B3; --hs-ink: #13202B; --hs-sub: #5E4416; --hs-row: rgba(255,255,255,0.62); --hs-row-press: rgba(255,255,255,0.85); --hs-btn: #FF6B35; }
  .home-t[data-slot='evening'] { --hs-bg: #B8400F; --hs-ink: #fff; --hs-sub: #FFE1CF; --hs-row: rgba(255,255,255,0.13); --hs-row-press: rgba(255,255,255,0.22); --hs-btn: #13202B; }
  .home-t[data-slot='night'] { --hs-bg: #0E1A2B; --hs-ink: #fff; --hs-sub: #B4C2D6; --hs-row: rgba(255,255,255,0.08); --hs-row-press: rgba(255,255,255,0.16); --hs-btn: #FF6B35; }

  html body .home-t .ht-band { background: var(--hs-bg); color: var(--hs-ink); padding: 22px 0 30px; transition: background-color 0.4s ease; }
  html body .home-t .ht-greet { margin: 0; font-size: 3.1rem; line-height: 1.05; font-weight: 800; letter-spacing: -0.5px; color: var(--hs-ink); }
  html body .home-t .ht-g { display: none; }
  html body .home-t .ht-date { margin: 8px 0 0; min-height: 1.5em; font-size: 1rem; font-weight: 600; line-height: 1.5; color: var(--hs-sub); font-variant-numeric: tabular-nums; }
  html body .home-t[data-slot='morning'] .ht-g-morning,
  html body .home-t[data-slot='noon'] .ht-g-noon,
  html body .home-t[data-slot='evening'] .ht-g-evening,
  html body .home-t[data-slot='night'] .ht-g-night { display: inline; }

  /* সার্চ: সাদা পিল, বাটন সময়ের রঙে */
  html body .home-t .hero { padding: 16px 0 0; }
  html body .home-t .hero-search { margin: 0; }
  html body .home-t .hero .search-card { border-radius: 18px; border: none; padding: 6px 6px 6px 16px; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14); }
  html body .home-t .hero .search-card i { color: #13202B; }
  html body .home-t .hero .search-card .btn-primary { background: var(--hs-btn); border-radius: 13px; }

  /* নিচের শিট */
  html body .home-t .ht-sheet { background: #F5F7F4; border-radius: 32px 32px 0 0; margin-top: -24px; position: relative; padding: 22px 0 28px; }
  html body .home-t .featured-photo-section { padding: 18px 0 18px; }
  html body .home-t .photo-card { border-radius: 22px; }

  /* স্ক্র্যাচ কার্ড: টিকিটের আকারে */
  html body .home-t .sc-teaser { margin: 0 16px; }
  html body .home-t .sc-teaser-btn { position: relative; background: #fff; color: #13202B; padding: 0 12px 0 0; min-height: 74px; box-shadow: 0 4px 14px rgba(19, 32, 43, 0.06); overflow: visible; }
  html body .home-t .sc-teaser-btn::before,
  html body .home-t .sc-teaser-btn::after { content: ''; position: absolute; left: 62px; width: 16px; height: 16px; border-radius: 50%; background: #F5F7F4; }
  html body .home-t .sc-teaser-btn::before { top: -8px; }
  html body .home-t .sc-teaser-btn::after { bottom: -8px; }
  html body .home-t .sc-teaser-ico { font-size: 0; flex: none; width: 70px; align-self: stretch; border-radius: 18px 0 0 18px; background: repeating-linear-gradient(135deg, #F2C14E 0 7px, #E3A928 7px 14px); }
  html body .home-t .sc-teaser-txt { padding: 12px 2px 12px 14px; border-left: 2px dashed #E2E8E4; }
  html body .home-t .sc-teaser-txt small { color: #4F5D57; }
  html body .home-t .sc-teaser-go { background: #13202B; color: #fff; border-radius: 12px; padding: 11px 16px; }

  @media (min-width: 769px) {
    html body .home-t .ht-greet { font-size: 3.8rem; }
    html body .home-t .sc-teaser { max-width: 1232px; margin: 0 auto; padding: 0 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html body .home-t .ht-band { transition: none; }
  }
</style>
