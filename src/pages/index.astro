---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import FeaturedPhotos from '../components/ui/FeaturedPhotos.astro';
import CategoryGrid from '../components/ui/CategoryGrid.astro';

// ============================================================
// আপডেট: no-store বদলে stale-while-revalidate ব্যবহার করা হলো —
// CDN ৬০ সেকেন্ড পর্যন্ত পেজ cache রাখবে (দ্রুত লোডিং), তারপর
// background-এ ফ্রেশ ভার্সন fetch করবে। ফলে সব ভিজিটর দ্রুত পেজ
// পাবে, আর ক্যাটাগরি/কনটেন্ট আপডেট সর্বোচ্চ ~৬০-৯০ সেকেন্ডে
// রিফ্লেক্ট হবে (আগের no-store এ প্রতিটা ভিজিটে সার্ভার লোড হতো,
// যেটা ট্রাফিক বাড়লে খরচ/স্পিডে প্রভাব ফেলতো)।
// ============================================================
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=30'
);
---

<BaseLayout title="স্মার্ট ফেনী - আপনার শহরের ডিজিটাল সেবা" showChatWidget={true}>
  <Hero />
  <FeaturedPhotos />
  <CategoryGrid />
</BaseLayout>