---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import FeaturedPhotos from '../components/ui/FeaturedPhotos.astro';
import CategoryGrid from '../components/ui/CategoryGrid.astro';
import { supabase } from '../lib/supabase.js';

// ============================================================
// আপডেট: no-store বদলে stale-while-revalidate ব্যবহার করা হলো —
// CDN ৬০ সেকেন্ড পর্যন্ত পেজ cache রাখবে (দ্রুত লোডিং), তারপর
// background-এ ফ্রেশ ভার্সন fetch করবে। ফলে সব ভিজিটর দ্রুত পেজ
// পাবে, আর ক্যাটাগরি/কনটেন্ট আপডেট সর্বোচ্চ ~৬০-৯০ সেকেন্ডে
// রিফ্লেক্ট হবে (আগের no-store এ প্রতিটা ভিজিটে সার্ভার লোড হতো,
// যেটা ট্রাফিক বাড়লে খরচ/স্পিডে প্রভাব ফেলতো)।
// ============================================================
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=30'
);

// আপডেট (হোমপেজ সেকশন অর্ডার — ৩ অপশন): site_settings টেবিলের
// 'homepage_section_order' কী দিয়ে ঠিক হয় Featured Photos কোথায়
// বসবে — Popular ও General ক্যাটাগরি গ্রিডের উপরে, মাঝখানে, নাকি
// নিচে। Popular সবসময় General-এর আগে থাকে (fix), শুধু Photos-এর
// পজিশন বদলায়। অ্যাডমিন প্যানেল /admin/categories থেকে নিয়ন্ত্রিত।
// fetch ব্যর্থ হলে ডিফল্ট 'photos_first' (আগের আচরণ) হিসেবে থাকবে।
let sectionOrder = 'photos_first';
try {
  const { data, error } = await supabase
    .from('site_settings')
    .select('value')
    .eq('key', 'homepage_section_order')
    .maybeSingle();
  if (!error && data?.value) {
    // পুরনো ২-অপশন ভ্যালু থাকলে নতুন সিস্টেমে ম্যাপ করা হচ্ছে
    if (data.value === 'category_first') {
      sectionOrder = 'photos_last';
    } else if (['photos_first', 'photos_middle', 'photos_last'].includes(data.value)) {
      sectionOrder = data.value;
    }
  }
} catch (e) {
  // fallback: photos_first
}
---

<BaseLayout title="স্মার্ট ফেনী - আপনার শহরের ডিজিটাল সেবা" showChatWidget={true}>
  <Hero />
  {sectionOrder === 'photos_first' && (
    <>
      <FeaturedPhotos />
      <CategoryGrid part="popular" />
      <CategoryGrid part="general" />
    </>
  )}
  {sectionOrder === 'photos_middle' && (
    <>
      <CategoryGrid part="popular" />
      <FeaturedPhotos />
      <CategoryGrid part="general" />
    </>
  )}
  {sectionOrder === 'photos_last' && (
    <>
      <CategoryGrid part="popular" />
      <CategoryGrid part="general" />
      <FeaturedPhotos />
    </>
  )}
</BaseLayout>