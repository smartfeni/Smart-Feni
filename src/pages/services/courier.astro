---
// ============================================================
// পেজ: হোম ডেলিভারি (Delivery Hero) — ফাইনাল সরলীকৃত ভার্সন
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — ➕পোস্ট ফ্লো): URL এ ?openRiderRegister=1 থাকলে
// পেজ লোড হওয়া মাত্র RiderRegisterModal অটোমেটিক খুলে যাবে
// (PostFlowDrawer-এর "সার্ভিস দিন" ট্যাব → "ডেলিভারি হিরো" থেকে
// redirect হয়ে এখানে আসে)
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import DeliveryHeroCard from '../../components/delivery/DeliveryHeroCard.astro';
import OnlineRidersPanel from '../../components/delivery/OnlineRidersPanel.astro';
import RiderRegisterModal from '../../components/delivery/RiderRegisterModal.astro';
import { supabase } from '../../lib/supabase.js';

const { data: riderRows } = await supabase
  .from('delivery_riders')
  .select('id, vehicle_type, photo_url, profile_id, profiles(full_name)')
  .eq('verification_status', 'approved')
  .eq('is_active', true)
  .eq('offers_delivery', true);

const riders = (riderRows || []).map((r) => ({
  id: r.id,
  title: r.profiles?.full_name || 'রাইডার',
  images: r.photo_url ? [r.photo_url] : [],
  upazila: '',
}));
---

<BaseLayout title="হোম ডেলিভারি | স্মার্ট ফেনী">
  <div class="cr-top-bar">
    <div class="container cr-top-bar-inner">
      <a href="/" class="cr-back-link"><i class="fas fa-arrow-left"></i></a>
      <button class="cr-online-riders-btn" id="openOnlineRidersBtn" type="button">
        <i class="fas fa-circle cr-online-dot"></i> অনলাইন রাইডার
      </button>
    </div>
  </div>

  <DeliveryHeroCard />

  <div class="cr-become-rider-footer">
    <button id="becomeRiderLink" type="button">
      <i class="fas fa-motorcycle"></i> ডেলিভারি হিরো হতে চান?
    </button>
  </div>

  <OnlineRidersPanel />
  <RiderRegisterModal />

  <script type="application/json" id="listingsData" set:html={JSON.stringify(riders)} />
</BaseLayout>

<style>
  .cr-top-bar {
    background: #fff;
    padding: 14px 0 4px;
  }

  .cr-top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cr-back-link {
    color: #5A6E85;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .cr-online-riders-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #F8FAFC;
    border: 1px solid #EEF3F9;
    color: #5A6E85;
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  .cr-online-dot {
    color: #22C55E;
    font-size: 0.5rem;
  }

  .cr-become-rider-footer {
    text-align: center;
    padding: 18px 0 60px;
  }

  .cr-become-rider-footer button {
    background: none;
    border: none;
    color: #9AA8BC;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
  }
</style>

<script>
  document.getElementById('openOnlineRidersBtn')?.addEventListener('click', () => {
    window.openOnlineRidersPanel?.();
  });

  document.getElementById('becomeRiderLink')?.addEventListener('click', () => {
    window.openRiderRegisterModal?.();
  });

  // ============================================================
  // নতুন — ➕পোস্ট ফ্লো: URL এ ?openRiderRegister=1 থাকলে অটোমেটিক
  // RiderRegisterModal খুলবে (PostFlowDrawer থেকে redirect হলে)
  // ============================================================
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('openRiderRegister') === '1') {
    setTimeout(() => {
      window.openRiderRegisterModal?.();
      window.history.replaceState({}, '', window.location.pathname);
    }, 150);
  }
</script>