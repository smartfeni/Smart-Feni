// ============================================================
// পেজ: রিপেয়ার সার্ভিস
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — ➕পোস্ট ফ্লো): ইনলাইন CTA বাটন সরিয়ে শুধু
// তথ্যমূলক ইন্সট্রাকশন লাইন — এখন সব পোস্ট bottom nav-এর
// "➕পোস্ট" থেকে কেন্দ্রীভূত। URL এ ?openListing=1 থাকলে
// অটোমেটিক মোডাল খুলবে।
//
// আপডেট (নতুন — ক্যাটাগরি সিম্প্লিফাই): আগে ৭টা নির্দিষ্ট পেশা
// (ইলেকট্রিশিয়ান, প্লাম্বিং, এসি/ফ্রিজ, মোবাইল/কম্পিউটার, ফার্নিচার,
// গৃহস্থালি যন্ত্রপাতি, গ্যাসের চুলা) আলাদা ছিল। এখন ৫টা কমন
// ক্যাটাগরি + "অন্যান্য" — রঙ মিস্ত্রি/থাই গ্লাস/রাজমিস্ত্রি/টাইলস/
// ওয়েল্ডিং ইত্যাদি নির্দিষ্ট পেশার নাম এখন থেকে ইউজার নিজে টাইটেলে
// লিখবে, অথবা "অন্যান্য" সিলেক্ট করে AddListingModal-এর কাস্টম-টাইপ
// ইনপুটে লিখবে (সেই টেক্সটটাই সরাসরি `type` কলামে সেভ হয়)।
// সার্চ ইনডেক্সেও এখন উপজেলা/লোকেশন যোগ করা হলো (আগে মিসিং ছিল) —
// এখন টাইটেল + বিবরণ + ক্যাটাগরি + লোকেশন সব দিয়েই সার্চ ম্যাচ করবে।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import AddListingModal from '../../components/ui/AddListingModal.astro';
import { supabase } from '../../lib/supabase.js';

const typeOptions = [
  { id: 'electrician', label: 'ইলেকট্রিশিয়ান' },
  { id: 'plumbing', label: 'প্লাম্বিং' },
  { id: 'appliance', label: 'এসি/ফ্রিজ/গৃহস্থালি যন্ত্রপাতি' },
  { id: 'mistri', label: 'মিস্ত্রি সার্ভিস (রাজ/রঙ/টাইলস/থাই গ্লাস/ওয়েল্ডিং)' },
  { id: 'mobile-computer', label: 'মোবাইল/কম্পিউটার/ইলেকট্রনিক্স' },
  { id: 'other', label: 'অন্যান্য' },
];

const typeNameMap = Object.fromEntries(typeOptions.map((t) => [t.id, t.label]));

const typeIcons = {
  electrician: 'fa-bolt',
  plumbing: 'fa-faucet',
  appliance: 'fa-blender',
  mistri: 'fa-hammer',
  'mobile-computer': 'fa-mobile-screen',
  other: 'fa-ellipsis',
};

const { data: technicians } = await supabase
  .from('listings')
  .select('*')
  .eq('category', 'repair')
  .eq('status', 'active')
  .order('created_at', { ascending: false });

const listings = technicians || [];

const typeCounts = {};
typeOptions.forEach((opt) => {
  typeCounts[opt.id] = listings.filter((item) => (item.type || 'other') === opt.id).length;
});
const totalCount = listings.length;
---

<BaseLayout title="রিপেয়ার সার্ভিস | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <h1>ফেনীর নির্ভরযোগ্য <span class="accent">রিপেয়ার সার্ভিস</span></h1>
      <p>ইলেকট্রিশিয়ান, প্লাম্বিং, মিস্ত্রি, ইলেকট্রনিক্স ও আরও অনেক সার্ভিস — অভিজ্ঞ টেকনিশিয়ানদের কাছ থেকে</p>
      <button type="button" class="page-cta-link" id="pageCtaBtn">
        <i class="fas fa-circle-info"></i> আপনি টেকনিশিয়ান হলে নিচের <strong>"পোস্ট"</strong> বাটনে ট্যাপ করে লিস্টিং যোগ করুন
      </button>
    </div>
  </section>

  <section class="repair-section">
    <div class="container">
      <div class="search-box">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="ইলেকট্রিশিয়ান, প্লাম্বার বা যেকোনো সার্ভিস খুঁজুন..." />
      </div>

      {listings.length > 0 && (

        <div class="filter-row" id="filterRow">

          <button class="filter-pill active" data-type="all" type="button">

            সব <span class="pill-count">({totalCount})</span>

          </button>

          {typeOptions.map((opt) => (

            <button class="filter-pill" data-type={opt.id} type="button">

              {opt.label} <span class="pill-count">({typeCounts[opt.id]})</span>

            </button>

          ))}

        </div>

      )}


      {listings.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-toolbox"></i>
          <p>এখনো কোনো টেকনিশিয়ান লিস্টিং যোগ হয়নি</p>
          <span>প্রথম লিস্টিং যোগ করুন উপরের "পোস্ট" বাটনে ট্যাপ করে</span>
        </div>
      ) : (
        <>
          <div class="repair-grid" id="repairGrid">
            {listings.map((item) => (
              <a
                href={`/listing/${item.id}`}
                class="repair-card"
                data-target-id={item.id}
                data-type={item.type || 'other'}
                data-upazila-name={item.upazila || ''}
                data-search={`${item.title || ''} ${item.description || ''} ${typeNameMap[item.type] || item.type || ''} ${item.upazila || ''}`.toLowerCase()}
              >
                <button class="like-btn-preview" type="button" data-like-btn aria-label="লাইক করুন" style="display:none;">
                  <i class="fas fa-heart"></i>
                  <span data-like-count>0</span>
                </button>
                <span class="like-count-preview-view" data-like-count-view>
                  <i class="fas fa-heart"></i>
                  <span data-like-count>0</span>
                </span>

                {item.images && item.images.length > 0 ? (
                  <img src={item.images[0]} alt={item.title} class="repair-photo" />
                ) : (
                  <div class="repair-icon">
                    <i class={`fas ${typeIcons[item.type] || 'fa-screwdriver-wrench'}`}></i>
                  </div>
                )}

                <div class="repair-card-body">
                  <span class="type-badge">{typeNameMap[item.type] || item.type}</span>
                  <h3 class="repair-title">{item.title}</h3>
                  {item.price && <p class="repair-price">৳{item.price}</p>}
                  <p class="location-tag"><i class="fas fa-location-dot"></i> {item.upazila}</p>
                </div>
              </a>
            ))}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </section>

  <AddListingModal category="repair" typeOptions={typeOptions} />
</BaseLayout>

<style>
  .page-header {
    padding: 44px 0 20px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header .accent {
    color: #0984E3;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .page-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #0984E3;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 4px 0;
    font-family: inherit;
    cursor: pointer;
  }

  .page-cta-link:hover {
    opacity: 0.8;
  }

  .page-cta-link strong {
    font-weight: 800;
  }

  .repair-section {
    padding: 18px 0 70px;
    background: #F8FAFC;
  }

  .search-box {
    max-width: 480px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    border-radius: 40px;
    padding: 12px 20px;
  }

  .search-box i {
    color: #A0AFC0;
  }

  .search-box input {
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.9rem;
    font-family: inherit;
    background: transparent;
    color: #1B2A4A;
  }

  .filter-row {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 8px;
    margin-bottom: 28px;
    padding: 2px 4px 10px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .filter-row::-webkit-scrollbar {
    display: none;
  }

  .filter-pill {
    flex-shrink: 0;
    white-space: nowrap;
    background: #fff;
    border: 1.5px solid #EEF3F9;
    color: #5A6E85;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 30px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    border-color: #FFD3BC;
    color: #FF6B35;
  }

  .filter-pill.active {
    background: #FF6B35;
    border-color: #FF6B35;
    color: #fff;
  }

  .pill-count {
    font-size: 0.78rem;
    opacity: 0.75;
    margin-left: 2px;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .empty-state span {
    color: #8FA0BC;
    font-size: 0.85rem;
  }

  .repair-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  .repair-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    padding: 0;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    font-family: inherit;
    text-decoration: none;
    display: block;
    position: relative;
  }

  .repair-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .repair-card.hidden {
    display: none;
  }

  .like-btn-preview,
  .like-count-preview-view {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    color: #8FA0BC;
  }

  .like-btn-preview {
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .like-btn-preview.liked {
    color: #FF6B35;
  }

  .like-btn-preview.liked i {
    color: #FF6B35;
  }

  .repair-icon {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }

  .repair-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .repair-card-body {
    padding: 14px;
  }

  .type-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 6px;
    background: #F4F7FC;
    color: #5A6E85;
  }

  .repair-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .repair-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FF6B35;
    margin-bottom: 4px;
  }

  .location-tag {
    font-size: 0.72rem;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .no-results {
    text-align: center;
    color: #A0AFC0;
    font-size: 0.95rem;
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.7rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { reorderByUserLocation } from '../../lib/locationSort.js';
  import { fetchLikeData, toggleLike, isLoggedIn } from '../../lib/contentEngagement.js';

  const grid = document.getElementById('repairGrid');
  const cards = document.querySelectorAll('.repair-card');
  const searchInput = document.getElementById('searchInput');
  const noResults = document.getElementById('noResults');
  const filterPills = document.querySelectorAll('.filter-pill');

  let activeType = 'all';

  function applyFilters() {
    const keyword = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesType = activeType === 'all' || card.dataset.type === activeType;
      const matchesSearch = keyword === '' || (card.dataset.search || '').includes(keyword);
      const matches = matchesType && matchesSearch;

      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', applyFilters);

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      activeType = pill.dataset.type;
      applyFilters();
    });
  });

  reorderByUserLocation(grid, 'upazilaName', 'latest');

  // ============================================================
  // সোয়াইপ-টু-নেক্সট-লিস্টিং — বর্তমান সর্ট+ফিল্টার অর্ডারের আইডি-লিস্ট
  // sessionStorage-এ সেভ, /listing/[id].astro এটা পড়ে সোয়াইপে দ্রুত
  // পরের/আগের লিস্টিং দেখায় (পেজ রিলোড ছাড়াই)
  // ============================================================
  grid?.addEventListener('click', (e) => {
    const card = e.target.closest('.repair-card');
    if (!card) return;

    const ids = Array.from(grid.children)
      .filter((c) => c.classList.contains('repair-card') && !c.classList.contains('hidden'))
      .map((c) => c.dataset.targetId)
      .filter(Boolean);

    sessionStorage.setItem('smartfeni_swipe_queue', JSON.stringify({ category: 'repair', ids }));
  });

  // ============================================================
  // ➕পোস্ট ফ্লো — শেয়ার্ড ফাংশন: লগইন থাকলে সরাসরি লিস্টিং মোডাল
  // খুলবে, না থাকলে লগইন মোডাল। ২ জায়গা থেকে কল হয়:
  // ১) URL এ ?openListing=1 থাকলে (PostFlowDrawer থেকে redirect)
  // ২) হেডারের নতুন ইনলাইন CTA লাইনে সরাসরি ক্লিক করলে
  // ============================================================
  async function triggerOpenListing() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.openListingModal?.();
    } else {
      window.openAuthModal?.('login');
    }
  }

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('openListing') === '1') {
    setTimeout(async () => {
      await triggerOpenListing();
      window.history.replaceState({}, '', window.location.pathname);
    }, 150);
  }

  document.getElementById('pageCtaBtn')?.addEventListener('click', () => {
    triggerOpenListing();
  });

  // ============================================================
  // প্রিভিউ কার্ডে লাইক (লগইন-গেটেড, ভিউ-অনলি/ইন্টারঅ্যাকটিভ)
  // ============================================================
  let boundLikeButtons = new WeakSet();

  async function renderPreviewLikes() {
    const loggedIn = await isLoggedIn();
    const ids = Array.from(cards).map((c) => c.dataset.targetId).filter(Boolean);
    const { counts, likedByMe } = await fetchLikeData('listing', ids);

    cards.forEach((card) => {
      const id = card.dataset.targetId;
      if (!id) return;

      const count = counts[id] || 0;
      const liked = likedByMe.has(id);

      const viewEl = card.querySelector('[data-like-count-view]');
      const btnEl = card.querySelector('[data-like-btn]');

      viewEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = count));
      btnEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = count));
      btnEl.classList.toggle('liked', liked);

      if (loggedIn) {
        viewEl.style.display = 'none';
        btnEl.style.display = 'flex';

        if (!boundLikeButtons.has(btnEl)) {
          boundLikeButtons.add(btnEl);

          btnEl.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            btnEl.disabled = true;
            const result = await toggleLike('listing', id);
            btnEl.disabled = false;
            if (result.error) return;
            const currentCount = parseInt(btnEl.querySelector('[data-like-count]').textContent, 10) || 0;
            const newCount = result.liked ? currentCount + 1 : Math.max(currentCount - 1, 0);
            btnEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = newCount));
            viewEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = newCount));
            btnEl.classList.toggle('liked', result.liked);
          });
        }
      } else {
        viewEl.style.display = 'flex';
        btnEl.style.display = 'none';
      }
    });
  }

  renderPreviewLikes();
  window.addEventListener('smartfeni:auth-changed', () => {
    renderPreviewLikes();
  });
</script>