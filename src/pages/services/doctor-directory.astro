<!-- path: src/pages/services/doctor-directory.astro -->
---
// ============================================================
// পেজ: পাবলিক ডাক্তার ডিরেক্টরি (/services/doctor-directory)
//
// v2 — ভিজিটিং-কার্ড ডিজাইন + দিনভিত্তিক ফিল্টার
//
// কী আছে:
//   • সবার উপরে "AI সহকারী" বাটন — smartfeni:open-doctor-chat ইভেন্ট ছোঁড়ে;
//     <DoctorChat /> (নিচে বসানো) সেটা শুনে চ্যাট প্যানেল খোলে।
//     চ্যাট থেকে স্পেশালিটি কার্ডে ট্যাপ করলে smartfeni:doctor-chat-pick
//     ইভেন্টে এই পেজ রিলোড ছাড়াই ড্রপডাউন বদলে ফিল্টার করে
//   • ডাক্তার | হসপিটাল ট্যাব বার — হসপিটাল (১খ) যোগ না হওয়া পর্যন্ত
//     লুকানো (#dirTabs)। চালু করতে শুধু style="display:none" সরান
//   • সার্চ (নাম/ডিগ্রি/স্পেশালিটি/চেম্বারের নাম) + স্পেশালিটি + উপজেলা
//   • দিনভিত্তিক ফিল্টার: সব দিন | আজ | আগামীকাল | পরশু + "অন্য বার" ড্রপডাউন
//     (মানুষ ১-২ দিন আগে সিরিয়াল দেয় বলে)
//   • কার্ড: ভিজিটিং-কার্ড স্টাইল — নাম, স্পেশালিটি, ডিগ্রি,
//     BMDC, উপজেলা, চেম্বার সংখ্যা + ছবির কোণে "কবে বসছেন" ব্যাজ।
//     চেম্বারের সময়/নম্বর/কল বাটন কার্ডে নেই — সব /doctor/[id] পেজের ভেতরে
//   • ডাটা: শুধু published ডাক্তার + published চেম্বার (RLS-এও আটকানো)
//   • URL প্যারামিটার: ?spec=<slug> বা ?q=<লেখা>
//
// ⚠️ [slug].astro-র customPageSlugs-এ 'doctor-directory' থাকতে হবে
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import DoctorChat from '../../components/doctor/DoctorChat.astro';
---

<BaseLayout title="ডাক্তার ও হাসপাতাল ডিরেক্টরি | স্মার্ট ফেনী">
  <div class="dir-page">
    <div class="container">

      <div class="page-header">
        <h1><i class="fas fa-user-doctor"></i> ডাক্তার ও হাসপাতাল</h1>
        <p>ফেনীর ডাক্তারদের চেম্বার, বসার সময় ও সিরিয়ালের নম্বর এক জায়গায়</p>
      </div>

      <!-- ===== AI সহকারী বাটন ===== -->
      <button type="button" class="ai-btn" id="aiBtn">
        <span class="ai-btn-icon"><i class="fas fa-robot"></i></span>
        <span class="ai-btn-text">
          <strong>AI সহকারী</strong>
          <small>সমস্যা লিখুন, কোন ডাক্তার দেখাবেন জানুন</small>
        </span>
        <i class="fas fa-chevron-right ai-btn-arrow"></i>
      </button>

      <!-- ===== ট্যাব (হসপিটাল যোগ হলে চালু হবে) ===== -->
      <div class="dir-tabs" id="dirTabs" style="display:none;">
        <button type="button" class="dir-tab active" id="tabDoctors">ডাক্তার</button>
        <button type="button" class="dir-tab" id="tabHospitals">হসপিটাল</button>
      </div>

      <!-- ===== ডাক্তার প্যানেল ===== -->
      <div id="panelDoctors">

        <div class="dir-search" id="dirSearchBox">
          <i class="fas fa-search"></i>
          <input type="text" id="dirSearchInput" placeholder="ডাক্তার, স্পেশালিটি বা হাসপাতালের নাম লিখুন..." autocomplete="off" />
        </div>

        <div class="dir-filters">
          <select id="specFilter" aria-label="স্পেশালিটি">
            <option value="">সব স্পেশালিটি</option>
          </select>
          <select id="upazilaFilter" aria-label="উপজেলা">
            <option value="">সব উপজেলা</option>
            <option value="feni-sadar">ফেনী সদর</option>
            <option value="chhagalnaiya">ছাগলনাইয়া</option>
            <option value="daganbhuiyan">দাগনভূঞা</option>
            <option value="parshuram">পরশুরাম</option>
            <option value="fulgazi">ফুলগাজী</option>
            <option value="sonagazi">সোনাগাজী</option>
          </select>
        </div>

        <!-- ===== দিন বেছে নেওয়া ===== -->
        <p class="day-label"><i class="fas fa-calendar-day"></i> কবে দেখাতে চান?</p>
        <div class="day-row" id="dayRow">
          <button type="button" class="day-chip active" data-offset="all">সব দিন</button>
          <button type="button" class="day-chip" data-offset="0">আজ<small id="dayName0"></small></button>
          <button type="button" class="day-chip" data-offset="1">আগামীকাল<small id="dayName1"></small></button>
          <button type="button" class="day-chip" data-offset="2">পরশু<small id="dayName2"></small></button>
        </div>
        <select id="dayOther" class="day-other" aria-label="অন্য বার">
          <option value="">অন্য বার বেছে নিন</option>
          <option value="6">শনিবার</option>
          <option value="0">রবিবার</option>
          <option value="1">সোমবার</option>
          <option value="2">মঙ্গলবার</option>
          <option value="3">বুধবার</option>
          <option value="4">বৃহস্পতিবার</option>
          <option value="5">শুক্রবার</option>
        </select>

        <p class="result-count" id="resultCount"></p>

        <div id="doctorList" class="doctor-list"></div>

        <div id="loadingState" class="state-msg">
          <div class="spinner"></div>
          <p>লোড হচ্ছে...</p>
        </div>

        <div id="emptyState" class="state-msg" style="display:none;">
          <i class="fas fa-user-doctor"></i>
          <p id="emptyText">কোনো ডাক্তার পাওয়া যায়নি</p>
        </div>

        <button type="button" class="more-btn" id="moreBtn" style="display:none;">আরও দেখান</button>

        <p class="dir-disclaimer">
          <i class="fas fa-circle-info"></i>
          বসার সময় বদলাতে পারে। যাওয়ার আগে সিরিয়ালের নম্বরে ফোন করে নিশ্চিত হয়ে নিন।
        </p>
      </div>

    </div>
  </div>

  <DoctorChat />

  <style>
    .dir-page { min-height: 70vh; padding: 40px 0 80px; }
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 1.8rem; font-weight: 700; color: #1B2A4A; display: flex; align-items: center; gap: 10px; }
    .page-header h1 i { color: #FF6B35; }
    .page-header p { font-size: 0.95rem; color: #5A6E85; margin-top: 6px; }

    .ai-btn { width: 100%; display: flex; align-items: center; gap: 14px; text-align: left; background: #FF6B35; color: #fff; border: none; border-radius: 20px; padding: 16px 18px; cursor: pointer; font-family: inherit; box-shadow: 0 8px 22px rgba(255, 107, 53, 0.28); margin-bottom: 20px; transition: transform 0.15s ease; }
    .ai-btn:active { transform: scale(0.99); }
    .ai-btn-icon { width: 46px; height: 46px; border-radius: 14px; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }
    .ai-btn-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .ai-btn-text strong { font-size: 1.02rem; font-weight: 700; }
    .ai-btn-text small { font-size: 0.8rem; opacity: 0.92; }
    .ai-btn-arrow { opacity: 0.85; }

    .dir-tabs { display: flex; gap: 8px; background: #fff; border-radius: 40px; padding: 5px; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06); margin-bottom: 18px; }
    .dir-tab { flex: 1; border: none; background: transparent; padding: 11px; border-radius: 40px; font-weight: 700; font-size: 0.9rem; color: #5A6E85; cursor: pointer; font-family: inherit; }
    .dir-tab.active { background: #FF6B35; color: #fff; }

    .dir-search { position: relative; margin-bottom: 12px; scroll-margin-top: 96px; }
    .dir-search i { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #B0BCCB; font-size: 0.95rem; }
    .dir-search input { width: 100%; padding: 14px 18px 14px 46px; border-radius: 40px; border: 1.5px solid #E5EAF0; background: #fff; font-size: 0.92rem; font-family: inherit; color: #1B2A4A; transition: all 0.2s ease; }
    .dir-search input:focus { outline: none; border-color: #FF6B35; box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1); }

    .dir-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
    .dir-filters select, .day-other { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1.5px solid #E5EAF0; background: #fff; font-size: 0.88rem; font-family: inherit; color: #1B2A4A; }
    .dir-filters select:focus, .day-other:focus { outline: none; border-color: #FF6B35; }

    .day-label { font-size: 0.84rem; font-weight: 700; color: #1B2A4A; margin: 4px 2px 8px; display: flex; align-items: center; gap: 6px; }
    .day-label i { color: #FF6B35; }
    .day-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 10px; }
    .day-chip { border: 1.5px solid #E5EAF0; background: #fff; color: #5A6E85; border-radius: 14px; padding: 9px 4px; font-weight: 700; font-size: 0.8rem; cursor: pointer; font-family: inherit; display: flex; flex-direction: column; align-items: center; gap: 2px; line-height: 1.25; }
    .day-chip small { font-size: 0.68rem; font-weight: 600; opacity: 0.85; min-height: 0.9em; }
    .day-chip.active { background: #FF6B35; border-color: #FF6B35; color: #fff; }

    .result-count { font-size: 0.82rem; color: #8FA0BC; font-weight: 600; margin: 12px 2px 14px; min-height: 1.2em; }
    .doctor-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 16px; }

    .state-msg { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 50px 0; color: #B0BCCB; text-align: center; }
    .state-msg i { font-size: 2.2rem; }
    .state-msg p { font-size: 0.92rem; color: #8FA0BC; }
    .spinner { width: 32px; height: 32px; border: 3px solid #E5EAF0; border-top-color: #FF6B35; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .more-btn { display: block; width: 100%; margin-top: 16px; padding: 13px; border-radius: 14px; border: 1.5px solid #FFD3BC; background: #FFF0EA; color: #FF6B35; font-weight: 700; font-size: 0.9rem; cursor: pointer; font-family: inherit; }
    .dir-disclaimer { margin-top: 26px; font-size: 0.78rem; color: #8FA0BC; line-height: 1.6; display: flex; gap: 8px; }
    .dir-disclaimer i { margin-top: 3px; }
  </style>

  <!-- ডাইনামিক কার্ডের স্টাইল (scoped CSS ডাইনামিক HTML-এ কাজ করে না, তাই global) -->
  <style is:global>
    .sfd-card { position: relative; display: block; background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06); text-decoration: none; color: #1B2A4A; transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .sfd-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1); }
    .sfd-body { position: relative; display: flex; min-height: 204px; }
    .sfd-text { position: relative; z-index: 2; width: 62%; flex: none; padding: 16px 6px 14px 16px; }
    .sfd-name { font-size: 1.1rem; font-weight: 700; line-height: 1.35; color: #1B2A4A; }
    .sfd-spec { font-size: 0.86rem; font-weight: 700; color: #FF6B35; margin-top: 2px; }
    .sfd-degrees { font-size: 0.78rem; color: #5A6E85; margin-top: 3px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .sfd-rows { border-top: 1px solid #E5EAF0; margin-top: 10px; padding-top: 3px; }
    .sfd-row { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: #44506B; margin-top: 7px; }
    .sfd-ico { width: 22px; height: 22px; border-radius: 50%; background: #FFF0EA; color: #FF6B35; display: flex; align-items: center; justify-content: center; font-size: 0.68rem; flex-shrink: 0; }

    .sfd-photo { position: absolute; top: 0; right: 0; bottom: 0; width: 42%; }
    .sfd-l1, .sfd-l2, .sfd-l3 { position: absolute; inset: 0; }
    .sfd-l1 { background: #FF6B35; clip-path: polygon(30% 0, 100% 0, 100% 100%, 2% 100%); }
    .sfd-l2 { background: #1B2A4A; clip-path: polygon(35% 0, 100% 0, 100% 100%, 7% 100%); }
    .sfd-l3 { background: #FFE3D6; clip-path: polygon(39% 0, 100% 0, 100% 100%, 11% 100%); overflow: hidden; display: flex; align-items: center; justify-content: center; padding-left: 28%; color: #FF6B35; font-size: 3.2rem; }
    .sfd-l3 img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    .sfd-badge { position: absolute; top: 10px; right: 10px; z-index: 3; display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; background: #fff; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12); }
    .sfd-badge.now { background: #EAFBF0; color: #1B7A3C; }
    .sfd-badge.today { background: #EAFBF0; color: #1B7A3C; }
    .sfd-badge.soon { background: #FFF4D6; color: #9A6412; }
    .sfd-badge.off { background: #F1F4F9; color: #44506B; }
    .sfd-dot { width: 7px; height: 7px; border-radius: 50%; background: #1FB35A; }

    .sfd-foot { display: flex; justify-content: space-between; align-items: center; background: #FFF0EA; color: #C2491B; font-size: 0.8rem; font-weight: 700; padding: 10px 16px; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';

    // ===== কনস্ট্যান্ট =====
    const UPAZILA_LABELS = {
      'feni-sadar': 'ফেনী সদর', 'chhagalnaiya': 'ছাগলনাইয়া', 'daganbhuiyan': 'দাগনভূঞা',
      'parshuram': 'পরশুরাম', 'fulgazi': 'ফুলগাজী', 'sonagazi': 'সোনাগাজী',
    };
    const WEEKDAY_FULL = { 0: 'রবিবার', 1: 'সোমবার', 2: 'মঙ্গলবার', 3: 'বুধবার', 4: 'বৃহস্পতিবার', 5: 'শুক্রবার', 6: 'শনিবার' };
    const PAGE_SIZE = 20;

    // <<PURE (এই অংশের ফাংশনগুলো DOM ছাড়া — আলাদা টেস্ট করা যায়)
    const BN_DIGITS = '০১২৩৪৫৬৭৮৯';
    const toBn = (n) => String(n).replace(/\d/g, (d) => BN_DIGITS[d]);
    const toMin = (t) => { const [h, m] = String(t).split(':').map(Number); return h * 60 + m; };

    function dayLabel(offset, weekday) {
      if (offset === 0) return 'আজ';
      if (offset === 1) return 'আগামীকাল';
      if (offset === 2) return 'পরশু';
      return WEEKDAY_FULL[weekday];
    }

    function flattenSlots(d) {
      const out = [];
      (d.doctor_chambers || []).forEach((c) => (c.chamber_slots || []).forEach((s) => out.push(s)));
      return out;
    }

    // dayFilter: null = সব দিন, নয়তো 0..6 (বার)। ফেরত: { kind, label, sortKey } বা { kind:'none' }
    function statusFor(d, now, dayFilter) {
      const slots = flattenSlots(d);
      if (slots.length === 0) return dayFilter != null ? { kind: 'none' } : { kind: 'nosched', sortKey: 9999 };

      if (dayFilter != null) {
        const ds = slots.filter((s) => s.weekday === dayFilter);
        if (ds.length === 0) return { kind: 'none' };
        const offset = (dayFilter - now.weekday + 7) % 7;
        if (offset === 0) {
          const sitting = ds.some((s) => toMin(s.start_time) <= now.minutes && now.minutes < toMin(s.end_time));
          if (sitting) return { kind: 'now', label: 'এখন বসছেন', sortKey: 0 };
          const later = ds.filter((s) => toMin(s.start_time) > now.minutes);
          if (later.length === 0) return { kind: 'none' };
          return { kind: 'today', label: 'আজ বসছেন', sortKey: Math.min(...later.map((s) => toMin(s.start_time))) };
        }
        return { kind: offset <= 2 ? 'soon' : 'off', label: `${dayLabel(offset, dayFilter)} বসছেন`, sortKey: Math.min(...ds.map((s) => toMin(s.start_time))) };
      }

      const today = slots.filter((s) => s.weekday === now.weekday);
      if (today.some((s) => toMin(s.start_time) <= now.minutes && now.minutes < toMin(s.end_time))) {
        return { kind: 'now', label: 'এখন বসছেন', sortKey: 0 };
      }
      if (today.some((s) => toMin(s.start_time) > now.minutes)) {
        return { kind: 'today', label: 'আজ বসছেন', sortKey: 1 };
      }
      for (let i = 1; i <= 7; i++) {
        const wd = (now.weekday + i) % 7;
        if (slots.some((s) => s.weekday === wd)) {
          const label = i === 7 ? `আগামী ${WEEKDAY_FULL[wd]}` : dayLabel(i, wd);
          return { kind: i <= 2 ? 'soon' : 'off', label: `${label} বসছেন`, sortKey: 1 + i };
        }
      }
      return { kind: 'nosched', sortKey: 9999 };
    }
    // PURE>>

    // ===== স্টেট =====
    let allDoctors = [];
    let specMap = {};
    let shown = PAGE_SIZE;
    let dayFilter = null;
    let savedUpazila = null;

    // ===== DOM =====
    const $ = (id) => document.getElementById(id);
    const listEl = $('doctorList');
    const searchInput = $('dirSearchInput');
    const specFilter = $('specFilter');
    const upazilaFilter = $('upazilaFilter');
    const dayOther = $('dayOther');

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function norm(s) {
      return String(s || '').toLowerCase()
        .replace(/^\s*(ডাঃ|ডা\.|ডা\s|ডাক্তার|অধ্যাপক|প্রফেসর)\s*/i, '')
        .replace(/^\s*(dr|prof|professor)(\.\s*|\s+)/i, '')
        .trim();
    }

    function resolveUpazilaSlug(v) {
      if (!v) return null;
      if (UPAZILA_LABELS[v]) return v;
      return Object.entries(UPAZILA_LABELS).find(([, label]) => label === v)?.[0] || null;
    }

    // ঢাকার বর্তমান বার ও মিনিট (ইউজারের ফোনের টাইমজোন যা-ই হোক)
    function dhakaNow() {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Dhaka', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (t) => parts.find((p) => p.type === t)?.value;
      const weekday = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 }[get('weekday')];
      return { weekday, minutes: (Number(get('hour')) % 24) * 60 + Number(get('minute')) };
    }

    const specNames = (slugs) => (slugs || []).map((s) => specMap[s]?.name_bn || s);

    function updateDayChipNames(now) {
      for (let i = 0; i < 3; i++) {
        const el = $('dayName' + i);
        if (el) el.textContent = WEEKDAY_FULL[(now.weekday + i) % 7];
      }
    }

    // ============================================================
    // ফিল্টার + সর্টিং + রেন্ডার
    // ============================================================
    function matchesQuery(d, q, raw) {
      if (!q && !raw) return true;
      const hay = [
        d.name_bn, d.name_en, d.degrees,
        ...specNames(d.specialties),
        ...(d.doctor_chambers || []).map((c) => c.place_name),
      ].filter(Boolean).join(' ').toLowerCase();
      return (q && hay.includes(q)) || (raw && hay.includes(raw));
    }

    function doctorUpazilas(d) {
      return [d.upazila, ...(d.doctor_chambers || []).map((c) => c.upazila)].filter(Boolean);
    }

    function render() {
      const now = dhakaNow();
      updateDayChipNames(now);

      const raw = searchInput.value.trim().toLowerCase();
      const q = norm(searchInput.value);
      const sp = specFilter.value;
      const up = upazilaFilter.value;

      const rows = [];
      allDoctors.forEach((d) => {
        if (sp && !(d.specialties || []).includes(sp)) return;
        if (up && !doctorUpazilas(d).includes(up)) return;
        if (!matchesQuery(d, q, raw)) return;
        const st = statusFor(d, now, dayFilter);
        if (st.kind === 'none') return;
        rows.push({ d, st });
      });

      rows.sort((a, b) => {
        if (a.st.sortKey !== b.st.sortKey) return a.st.sortKey - b.st.sortKey;
        const aLocal = savedUpazila && doctorUpazilas(a.d).includes(savedUpazila) ? 0 : 1;
        const bLocal = savedUpazila && doctorUpazilas(b.d).includes(savedUpazila) ? 0 : 1;
        if (aLocal !== bLocal) return aLocal - bLocal;
        return (a.d.name_bn || '').localeCompare(b.d.name_bn || '', 'bn');
      });

      $('resultCount').textContent = allDoctors.length ? `${toBn(rows.length)} জন ডাক্তার পাওয়া গেছে` : '';
      listEl.innerHTML = '';

      const empty = $('emptyState');
      if (rows.length === 0) {
        let msg = 'এই ফিল্টারে কোনো ডাক্তার পাওয়া যায়নি';
        if (allDoctors.length === 0) msg = 'ডাক্তারের তালিকা শীঘ্রই যুক্ত হচ্ছে';
        else if (dayFilter != null) msg = `${dayLabel((dayFilter - now.weekday + 7) % 7, dayFilter)} বসছেন এমন কোনো ডাক্তার পাওয়া যায়নি`;
        $('emptyText').textContent = msg;
        empty.style.display = 'flex';
        $('moreBtn').style.display = 'none';
        return;
      }
      empty.style.display = 'none';

      rows.slice(0, shown).forEach(({ d, st }) => listEl.appendChild(renderCard(d, st)));
      $('moreBtn').style.display = rows.length > shown ? 'block' : 'none';
    }

    function renderCard(d, st) {
      const card = document.createElement('a');
      card.className = 'sfd-card';
      card.href = `/doctor/${encodeURIComponent(d.id)}`;

      const photoInner = d.photo_url
        ? `<img src="${esc(d.photo_url)}" alt="${esc(d.name_bn)}" loading="lazy" decoding="async" />`
        : '<i class="fas fa-user-doctor"></i>';

      let badge = '';
      if (st.label) {
        const dot = st.kind === 'now' ? '<span class="sfd-dot"></span>' : '';
        badge = `<span class="sfd-badge ${esc(st.kind)}">${dot}${esc(st.label)}</span>`;
      } else if (st.kind === 'nosched') {
        badge = '<span class="sfd-badge off">সময় জানা নেই</span>';
      }

      const specs = specNames(d.specialties).slice(0, 2).join(' · ');
      const pubChambers = (d.doctor_chambers || []).length;
      const upLabel = d.upazila ? (UPAZILA_LABELS[d.upazila] || d.upazila) : '';

      const rowHtml = (icon, text) => `<div class="sfd-row"><span class="sfd-ico"><i class="fas ${icon}"></i></span><span>${text}</span></div>`;
      const rows = [
        d.bmdc_no ? rowHtml('fa-id-card', `BMDC: ${esc(d.bmdc_no)}`) : '',
        upLabel ? rowHtml('fa-location-dot', esc(upLabel)) : '',
        pubChambers ? rowHtml('fa-hospital', `${toBn(pubChambers)}টি চেম্বারে বসেন`) : '',
      ].join('');

      card.innerHTML = `
        <div class="sfd-body">
          <div class="sfd-photo">
            <div class="sfd-l1"></div>
            <div class="sfd-l2"></div>
            <div class="sfd-l3">${photoInner}</div>
            ${badge}
          </div>
          <div class="sfd-text">
            <p class="sfd-name">${esc(d.name_bn)}</p>
            ${specs ? `<p class="sfd-spec">${esc(specs)}</p>` : ''}
            ${d.degrees ? `<p class="sfd-degrees">${esc(d.degrees)}</p>` : ''}
            ${rows ? `<div class="sfd-rows">${rows}</div>` : ''}
          </div>
        </div>
        <div class="sfd-foot"><span>চেম্বার, সময় ও সিরিয়ালের নম্বর</span><i class="fas fa-arrow-right"></i></div>`;
      return card;
    }

    // ============================================================
    // ডাটা লোড
    // ============================================================
    function buildSpecFilter(preselect) {
      const counts = {};
      allDoctors.forEach((d) => (d.specialties || []).forEach((s) => { counts[s] = (counts[s] || 0) + 1; }));
      const slugs = Object.keys(specMap).filter((s) => counts[s] || s === preselect);
      specFilter.innerHTML = '<option value="">সব স্পেশালিটি</option>' + slugs
        .map((s) => `<option value="${esc(s)}">${esc(specMap[s].name_bn)} (${toBn(counts[s])})</option>`).join('');
      if (preselect && specMap[preselect]) specFilter.value = preselect;
    }

    async function load() {
      const params = new URLSearchParams(window.location.search);
      const preSpec = params.get('spec');
      const preQ = params.get('q');
      if (preQ) searchInput.value = preQ;

      const [docRes, specRes] = await Promise.all([
        supabase
          .from('doctors')
          .select('id, name_bn, name_en, photo_url, specialties, degrees, bmdc_no, upazila, doctor_chambers(id, place_name, upazila, status, chamber_slots(weekday, start_time, end_time))')
          .eq('status', 'published')
          .eq('doctor_chambers.status', 'published')
          .order('name_bn'),
        supabase.from('specialties').select('slug, name_bn, sort_order').eq('is_active', true).order('sort_order'),
      ]);

      $('loadingState').style.display = 'none';

      if (docRes.error) {
        $('emptyText').textContent = 'তালিকা লোড করা যায়নি, একটু পরে আবার চেষ্টা করুন';
        $('emptyState').style.display = 'flex';
        return;
      }

      specMap = {};
      (specRes.data || []).forEach((s) => { specMap[s.slug] = s; });
      allDoctors = docRes.data || [];
      buildSpecFilter(preSpec);
      render();
    }

    // ============================================================
    // ইভেন্ট
    // ============================================================
    $('aiBtn').addEventListener('click', () => {
      if (window.__sfDoctorChatReady) {
        window.dispatchEvent(new CustomEvent('smartfeni:open-doctor-chat'));
      } else {
        window.showToast('AI সহকারী শীঘ্রই চালু হচ্ছে', 'success');
      }
    });

    let searchTimer = null;
    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => { shown = PAGE_SIZE; render(); }, 150);
    });
    // মোবাইল কীবোর্ড খুললে সার্চ বক্স স্টিকি হেডারের নিচে নিয়ে আসা (clubs পেজের মতো)
    searchInput.addEventListener('focus', () => {
      setTimeout(() => $('dirSearchBox').scrollIntoView({ behavior: 'smooth', block: 'start' }), 250);
    });

    specFilter.addEventListener('change', () => { shown = PAGE_SIZE; render(); });
    upazilaFilter.addEventListener('change', () => { shown = PAGE_SIZE; render(); });

    // দিন চিপ
    document.querySelectorAll('.day-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.day-chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        dayOther.value = '';
        const off = chip.dataset.offset;
        dayFilter = off === 'all' ? null : (dhakaNow().weekday + Number(off)) % 7;
        shown = PAGE_SIZE;
        render();
      });
    });

    // অন্য বার ড্রপডাউন
    dayOther.addEventListener('change', () => {
      document.querySelectorAll('.day-chip').forEach((c) => c.classList.remove('active'));
      if (dayOther.value === '') {
        document.querySelector('.day-chip[data-offset="all"]').classList.add('active');
        dayFilter = null;
      } else {
        dayFilter = Number(dayOther.value);
      }
      shown = PAGE_SIZE;
      render();
    });

    $('moreBtn').addEventListener('click', () => { shown += PAGE_SIZE; render(); });

    // AI চ্যাটের স্পেশালিটি কার্ডে ট্যাপ → রিলোড ছাড়াই ফিল্টার
    function selectSpec(slug) {
      if (!specMap[slug]) return false;     // তালিকা এখনো লোড হয়নি — সাধারণ লিংকে যাবে
      if (![...specFilter.options].some((o) => o.value === slug)) {
        const opt = document.createElement('option');
        opt.value = slug;
        opt.textContent = `${specMap[slug].name_bn} (${toBn(0)})`;
        specFilter.appendChild(opt);
      }
      specFilter.value = slug;
      searchInput.value = '';
      shown = PAGE_SIZE;
      render();
      $('dirSearchBox').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return true;
    }
    window.addEventListener('smartfeni:doctor-chat-pick', (e) => {
      if (selectSpec(e.detail?.spec)) e.preventDefault();
    });

    // হেডারে উপজেলা বদলালে সর্টিং আপডেট (ফিল্টার নয়, শুধু আগে দেখানো)
    window.addEventListener('smartfeni:upazila-changed', (e) => {
      savedUpazila = resolveUpazilaSlug(e.detail?.upazila);
      render();
    });

    // "এখন বসছেন" ব্যাজ ঠিক রাখতে প্রতি মিনিটে রিফ্রেশ
    setInterval(() => { if (allDoctors.length) render(); }, 60000);

    savedUpazila = resolveUpazilaSlug(localStorage.getItem('smartfeni_upazila'));
    updateDayChipNames(dhakaNow());
    load();
  </script>
</BaseLayout>
