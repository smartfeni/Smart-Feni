---
// ============================================================
// পেজ: রাইড হিরো — courier.astro এর একই প্যাটার্নে,
// কিন্তু আলাদা স্বতন্ত্র ক্যাটাগরি (Ride Hero, Delivery Hero-র
// সাথে "Smart Hero" নামে কোনো শেয়ার্ড ব্র্যান্ডিং নাই)
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import RideHeroCard from '../../components/delivery/RideHeroCard.astro';
import OnlineRidersPanel from '../../components/delivery/OnlineRidersPanel.astro';
import RiderRegisterModal from '../../components/delivery/RiderRegisterModal.astro';
import { supabase } from '../../lib/supabase.js';

const { data: riderRows } = await supabase
  .from('delivery_riders')
  .select('id, vehicle_type, photo_url, profile_id, profiles(full_name)')
  .eq('verification_status', 'approved')
  .eq('is_active', true)
  .eq('offers_ride', true);

const riders = (riderRows || []).map((r) => ({
  id: r.id,
  title: r.profiles?.full_name || 'রাইড হিরো',
  images: r.photo_url ? [r.photo_url] : [],
  upazila: '',
}));
---

<BaseLayout title="রাইড হিরো | স্মার্ট ফেনী">
  <div class="rd-top-bar">
    <div class="container rd-top-bar-inner">
      <a href="/" class="rd-back-link"><i class="fas fa-arrow-left"></i></a>
      <button class="rd-online-riders-btn" id="openOnlineRidersBtn" type="button">
        <i class="fas fa-circle rd-online-dot"></i> অনলাইন রাইড হিরো
      </button>
    </div>
  </div>

  <RideHeroCard />

  <div class="rd-become-rider-footer">
    <button id="becomeRiderLink" type="button">
      <i class="fas fa-motorcycle"></i> রাইড হিরো হতে চান?
    </button>
  </div>

  <OnlineRidersPanel />
  <RiderRegisterModal />

  <script type="application/json" id="listingsData" set:html={JSON.stringify(riders)} />
</BaseLayout>

<style>
  .rd-top-bar {
    background: #fff;
    padding: 14px 0 4px;
  }

  .rd-top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rd-back-link {
    color: #5A6E85;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .rd-online-riders-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #F8FAFC;
    border: 1px solid #EEF3F9;
    color: #5A6E85;
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  .rd-online-dot {
    color: #22C55E;
    font-size: 0.5rem;
  }

  .rd-become-rider-footer {
    text-align: center;
    padding: 18px 0 60px;
  }

  .rd-become-rider-footer button {
    background: none;
    border: none;
    color: #9AA8BC;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
  }
</style>

<script>
  document.getElementById('openOnlineRidersBtn')?.addEventListener('click', () => {
    window.openOnlineRidersPanel?.();
  });

  document.getElementById('becomeRiderLink')?.addEventListener('click', () => {
    window.openRiderRegisterModal?.();
  });

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('openRiderRegister') === '1') {
    setTimeout(() => {
      window.openRiderRegisterModal?.();
      window.history.replaceState({}, '', window.location.pathname);
    }, 150);
  }
</script>