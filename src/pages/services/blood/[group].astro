---
// path: src/pages/services/blood/[group].astro
// ============================================================
// পেজ: নির্দিষ্ট ব্লাড গ্রুপের ডোনার লিস্ট (শুধু অ্যাডমিন/মডারেটর, শুধু দেখার জন্য)
// URL: /services/blood/{slug} (যেমন /services/blood/a-positive)
//
// গোপনীয়তা (অক্টো ২০২৬): ডোনারের নাম্বার পাবলিকের জন্য খোলা থাকবে না।
//   - এই পেজ সার্ভারে ডোনার লোড করে না। শেল রেন্ডার হয়, তারপর ক্লায়েন্টে
//     profiles.role যাচাই হয় (admin/moderator)। অন্য কেউ হলে /services/blood এ রিডাইরেক্ট।
//   - ডেটা আসে সরাসরি Supabase থেকে ইউজারের সেশনে, তাই RLS-ই আসল তালা
//     (manual_blood_donors পাবলিক পড়ার policy বন্ধ হবে)।
//   - আগের লাইক, ফ্ল্যাগ/রিপোর্ট সরানো হয়েছে (লিস্ট রিড-অনলি)।
// ফিল্টার: উপজেলা (ড্রপডাউন) + সংগঠনের নাম (সার্চ বক্স), বাংলা সার্চে NFC normalize।
// সর্টিং: শেয়ারড locationSort.js — initLocationReorder()
// ইউজারের লেখা সব টেক্সট textContent দিয়ে বসে (innerHTML নয়)।
// SSR পেজ — prerender = false আবশ্যক।
// ============================================================

export const prerender = false;

import BaseLayout from '../../../components/layout/BaseLayout.astro';

const slugToGroup = {
  'a-positive': 'A+',
  'a-negative': 'A-',
  'b-positive': 'B+',
  'b-negative': 'B-',
  'ab-positive': 'AB+',
  'ab-negative': 'AB-',
  'o-positive': 'O+',
  'o-negative': 'O-',
};

const { group: groupSlug } = Astro.params;
const bloodGroup = slugToGroup[groupSlug];

if (!bloodGroup) {
  return Astro.redirect('/services/blood');
}

const upazilas = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];
---

<BaseLayout title={`${bloodGroup} রক্তদাতা | স্মার্ট ফেনী`}>
  <section class="page-header">
    <div class="header-decor" aria-hidden="true"></div>
    <div class="container">
      <a href="/services/blood" class="back-link">
        <i class="fas fa-arrow-left"></i> সব গ্রুপ
      </a>
      <h1><i class="fas fa-droplet drop-icon"></i> <span class="accent">{bloodGroup}</span> রক্তদাতা</h1>
      <p>অ্যাডমিন/মডারেটর ভিউ — ফেনীর {bloodGroup} গ্রুপের রক্তদাতাদের তালিকা</p>
    </div>
  </section>

  <section class="donor-section" id="donorSection" data-group={bloodGroup}>
    <div class="container">
      <p class="gate-state" id="gateState">যাচাই করা হচ্ছে...</p>

      <div id="staffContent" style="display:none;">
        <div class="filters-row" id="filtersRow" style="display:none;">
          <div class="dropdown-wrap">
            <button class="dropdown-btn" id="upazilaBtn" type="button">
              <span id="upazilaLabel">উপজেলা</span>
              <i class="fas fa-chevron-down"></i>
            </button>
            <div class="dropdown-panel" id="upazilaPanel">
              <button class="dropdown-option active" data-value="all" type="button">সব উপজেলা</button>
              {upazilas.map((u) => (
                <button class="dropdown-option" data-value={u} type="button">{u}</button>
              ))}
            </div>
          </div>

          <div class="club-search-wrap">
            <i class="fas fa-magnifying-glass"></i>
            <input
              type="text"
              id="clubSearchInput"
              placeholder="সংগঠনের নাম দিয়ে খুঁজুন..."
              autocomplete="off"
            />
          </div>
        </div>

        <p class="count-line" id="countLine" style="display:none;"></p>

        <div class="empty-state" id="emptyState" style="display:none;">
          <i class="fas fa-droplet"></i>
          <p>{bloodGroup} গ্রুপে এখনো কোনো রক্তদাতা তালিকাভুক্ত হননি</p>
          <span>অন্য গ্রুপ দেখতে চাইলে ফিরে যান</span>
          <a href="/services/blood" class="btn-back-outline">
            <i class="fas fa-arrow-left"></i> সব গ্রুপে ফিরে যান
          </a>
        </div>

        <div class="donor-grid" id="donorGrid"></div>

        <p class="no-match-state" id="noMatchState" style="display:none;">
          এই ফিল্টারে কোনো রক্তদাতা পাওয়া যায়নি
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .page-header {
    position: relative;
    padding: 14px 0 22px;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF7F4 100%);
    text-align: center;
    overflow: hidden;
  }

  .header-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120px 120px at 92% 10%, rgba(209, 67, 67, 0.10), transparent 70%),
      radial-gradient(160px 160px at 6% 90%, rgba(255, 107, 53, 0.08), transparent 70%);
  }

  .back-link {
    position: absolute;
    top: 12px;
    left: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 1px solid #EEF3F9;
    color: #5A6E85;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 8px 14px 8px 12px;
    border-radius: 40px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.07);
    transition: all 0.2s ease;
  }

  .back-link:hover {
    color: #FF6B35;
    border-color: #FFD9C7;
  }

  .container {
    position: relative;
  }

  .page-header h1 {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 1.9rem;
    font-weight: 800;
    margin: 0 0 6px;
    padding-top: 2px;
  }

  .drop-icon {
    color: #D14343;
    font-size: 1.5rem;
    filter: drop-shadow(0 4px 8px rgba(209, 67, 67, 0.25));
  }

  .page-header .accent {
    color: #D14343;
  }

  .page-header p {
    position: relative;
    z-index: 2;
    color: #5A6E85;
    font-size: 0.95rem;
    max-width: 520px;
    margin: 0 auto;
  }

  .donor-section {
    padding: 22px 0 70px;
    background: #F8FAFC;
  }

  .gate-state {
    text-align: center;
    color: #8FA0BC;
    font-size: 0.9rem;
    padding: 30px 0;
  }

  .count-line {
    color: #5A6E85;
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 14px;
  }

  .no-match-state {
    text-align: center;
    color: #8FA0BC;
    font-size: 0.9rem;
    padding: 24px 0;
  }

  .filters-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .dropdown-wrap {
    position: relative;
    flex: 0 0 auto;
  }

  .dropdown-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    color: #1B2A4A;
    padding: 12px 20px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .dropdown-btn:hover {
    border-color: #FF6B35;
  }

  .dropdown-btn.has-value {
    background: #FFF0EA;
    border-color: #FF6B35;
    color: #FF6B35;
  }

  .dropdown-btn i {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .dropdown-wrap.open .dropdown-btn i {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.14);
    padding: 8px;
    min-width: 180px;
    max-height: 280px;
    overflow-y: auto;
    z-index: 50;
  }

  .dropdown-wrap.open .dropdown-panel {
    display: block;
  }

  .dropdown-option {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: #1B2A4A;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .dropdown-option:hover {
    background: #F4F7FC;
  }

  .dropdown-option.active {
    background: #FFF0EA;
    color: #FF6B35;
    font-weight: 700;
  }

  .club-search-wrap {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .club-search-wrap i {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #B0BCCB;
    font-size: 0.85rem;
  }

  .club-search-wrap input {
    width: 100%;
    padding: 12px 16px 12px 42px;
    border-radius: 40px;
    border: 1px solid #EEF3F9;
    background: #fff;
    font-size: 0.9rem;
    font-family: inherit;
    color: #1B2A4A;
    box-sizing: border-box;
  }

  .club-search-wrap input:focus {
    outline: none;
    border-color: #FF6B35;
  }

  .club-search-wrap input::placeholder {
    color: #B0BCCB;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .empty-state span {
    color: #8FA0BC;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 20px;
  }

  .btn-back-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #FF6B35;
    border: 1.5px solid #FF6B35;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .btn-back-outline:hover {
    background: #FF6B35;
    color: #fff;
  }

  .donor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .donor-card {
    background: #fff;
    border-radius: 18px;
    padding: 14px;
    border: 1px solid #EEF3F9;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .donor-card.hidden {
    display: none;
  }

  .donor-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .donor-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FFF0EA;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .donor-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .donor-avatar i {
    color: #D14343;
    font-size: 1.25rem;
  }

  .blood-badge {
    background: #FFF0EA;
    color: #D14343;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 5px 12px;
    border-radius: 12px;
    white-space: nowrap;
  }

  .donor-name {
    font-size: 0.98rem;
    font-weight: 700;
    color: #1B2A4A;
    margin: 0 0 4px;
  }

  .donor-location {
    color: #5A6E85;
    font-size: 0.8rem;
    margin: 0 0 6px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .donor-location i {
    color: #FF6B35;
    font-size: 0.72rem;
  }

  /* ক্লাব ব্যাজ: লোগো float:left, টেক্সট এর ২য় লাইন লোগোর নিচ থেকেই শুরু হয় */
  .club-badge {
    color: #1D6FE0;
    font-size: 0.7rem;
    line-height: 1.35;
    font-weight: 700;
    margin: 0 0 10px;
    background: #E8F2FF;
    padding: 5px 8px;
    border-radius: 10px;
    max-height: calc(0.7rem * 1.35 * 2 + 2px);
    overflow: hidden;
  }

  .club-badge-logo {
    float: left;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    object-fit: cover;
    margin: 1px 5px 0 0;
  }

  .club-badge-icon {
    float: left;
    font-size: 0.7rem;
    margin: 2px 5px 0 0;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 8px;
  }

  /* ফোন নম্বর দেখানো কল বাটন (শুধু অ্যাডমিন/মডারেটর দেখে) */
  .btn-contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 44px;
    border-radius: 14px;
    background: #16A34A;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 0 8px 18px rgba(22, 163, 74, 0.28);
    transition: all 0.2s ease;
  }

  .btn-contact-icon:hover {
    background: #15803D;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .donor-grid {
      grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
      gap: 12px;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .drop-icon {
      font-size: 1.2rem;
    }

    .dropdown-btn {
      padding: 10px 14px;
      font-size: 0.82rem;
    }

    .back-link {
      font-size: 0.72rem;
      padding: 7px 12px 7px 10px;
    }

    .btn-contact-icon {
      height: 42px;
      font-size: 0.82rem;
    }
  }
</style>

<script>
  import { supabase } from '../../../lib/supabase.js';
  import { initLocationReorder } from '../../../lib/locationSort.js';

  const section = document.getElementById('donorSection');
  const bloodGroup = section?.dataset.group || '';

  const gateState = document.getElementById('gateState');
  const staffContent = document.getElementById('staffContent');
  const filtersRow = document.getElementById('filtersRow');
  const countLine = document.getElementById('countLine');
  const emptyState = document.getElementById('emptyState');
  const grid = document.getElementById('donorGrid');
  const noMatchState = document.getElementById('noMatchState');

  function mk(tag, cls, text) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined && text !== null) node.textContent = String(text);
    return node;
  }

  function safeImageUrl(url) {
    return typeof url === 'string' && /^https?:\/\//i.test(url) ? url : '';
  }

  // অ্যাডমিন বা মডারেটর কিনা (প্রকৃত তালা RLS; এটা শুধু UI গেট)
  async function isStaff() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return false;
      const { data: me } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();
      return me?.role === 'admin' || me?.role === 'moderator';
    } catch (err) {
      return false;
    }
  }

  function normalize(donor) {
    return donor;
  }

  async function loadDonors() {
    const [profileRes, manualRes] = await Promise.all([
      supabase
        .from('profiles')
        .select('id, full_name, phone, blood_group, upazila, avatar_url, club_id, clubs(name, logo_image)')
        .eq('is_blood_donor', true)
        .eq('donor_disabled', false)
        .eq('blood_group', bloodGroup)
        .order('created_at', { ascending: false }),
      supabase
        .from('manual_blood_donors')
        .select('id, name, phone, blood_group, upazila, club_name_raw, club_id, clubs(name, logo_image)')
        .eq('status', 'active')
        .eq('blood_group', bloodGroup)
        .order('created_at', { ascending: false }),
    ]);

    const profileDonors = (profileRes.data || []).map((d) => normalize({
      id: d.id,
      full_name: d.full_name,
      phone: d.phone,
      blood_group: d.blood_group,
      upazila: d.upazila,
      avatar_url: d.avatar_url,
      clubDisplayName: d.clubs?.name || null,
      clubLogo: d.clubs?.logo_image || null,
      isClubSourced: Boolean(d.clubs),
      clubNameRaw: null,
    }));

    const manualDonors = (manualRes.data || []).map((d) => normalize({
      id: d.id,
      full_name: d.name,
      phone: d.phone,
      blood_group: d.blood_group,
      upazila: d.upazila,
      avatar_url: null,
      clubDisplayName: d.clubs?.name || d.club_name_raw || null,
      clubLogo: d.clubs?.logo_image || null,
      isClubSourced: Boolean(d.clubs || d.club_name_raw),
      // রও ইমপোর্ট নাম আলাদা রাখা হয়, যাতে লিংক হওয়ার পরও সার্চে পাওয়া যায়
      clubNameRaw: d.club_name_raw || null,
    }));

    return [...profileDonors, ...manualDonors];
  }

  function renderCard(donor) {
    const card = mk('div', 'donor-card');
    card.dataset.upazilaName = donor.upazila || '';
    card.dataset.clubName = `${donor.clubDisplayName || ''} ${donor.clubNameRaw || ''}`
      .toLowerCase()
      .trim()
      .normalize('NFC');

    const top = mk('div', 'donor-card-top');
    const avatar = mk('span', 'donor-avatar');
    const avatarUrl = safeImageUrl(donor.avatar_url);
    if (avatarUrl) {
      const img = document.createElement('img');
      img.src = avatarUrl;
      img.alt = donor.full_name || '';
      avatar.appendChild(img);
    } else {
      avatar.appendChild(mk('i', 'fas fa-droplet'));
    }
    top.appendChild(avatar);
    top.appendChild(mk('span', 'blood-badge', donor.blood_group || '—'));
    card.appendChild(top);

    card.appendChild(mk('h3', 'donor-name', donor.full_name || ''));

    if (donor.upazila) {
      const loc = mk('p', 'donor-location');
      loc.appendChild(mk('i', 'fas fa-location-dot'));
      loc.appendChild(document.createTextNode(' ' + donor.upazila));
      card.appendChild(loc);
    }

    if (donor.isClubSourced && donor.clubDisplayName) {
      const badge = mk('p', 'club-badge');
      const logoUrl = safeImageUrl(donor.clubLogo);
      if (logoUrl) {
        const logo = document.createElement('img');
        logo.src = logoUrl;
        logo.alt = donor.clubDisplayName;
        logo.className = 'club-badge-logo';
        badge.appendChild(logo);
      } else {
        badge.appendChild(mk('i', 'fas fa-users club-badge-icon'));
      }
      badge.appendChild(document.createTextNode(donor.clubDisplayName));
      card.appendChild(badge);
    }

    const footer = mk('div', 'card-footer');
    const phoneText = String(donor.phone || '');
    const phoneDigits = phoneText.replace(/[^0-9+]/g, '');
    if (phoneDigits) {
      const call = document.createElement('a');
      call.className = 'btn-contact-icon';
      call.href = 'tel:' + phoneDigits;
      call.setAttribute('aria-label', 'ফোন করুন');
      call.appendChild(mk('i', 'fas fa-phone'));
      call.appendChild(mk('span', '', phoneText));
      footer.appendChild(call);
    }
    card.appendChild(footer);

    return card;
  }

  let activeUpazila = 'all';
  let clubSearchTerm = '';

  function applyFilters() {
    const cards = grid.querySelectorAll('.donor-card');
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesUpazila = activeUpazila === 'all' || card.dataset.upazilaName === activeUpazila;
      const clubName = (card.dataset.clubName || '').normalize('NFC');
      const matchesClub = clubSearchTerm === '' || clubName.includes(clubSearchTerm);

      if (matchesUpazila && matchesClub) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    noMatchState.style.display = visibleCount === 0 ? 'block' : 'none';
    countLine.textContent = visibleCount + ' জন রক্তদাতা';
  }

  function setupFilters() {
    const dropdownWraps = document.querySelectorAll('.dropdown-wrap');

    dropdownWraps.forEach((wrap) => {
      const btn = wrap.querySelector('.dropdown-btn');
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = wrap.classList.contains('open');
        dropdownWraps.forEach((w) => w.classList.remove('open'));
        if (!isOpen) wrap.classList.add('open');
      });
    });

    document.addEventListener('click', () => {
      dropdownWraps.forEach((w) => w.classList.remove('open'));
    });

    const panel = document.getElementById('upazilaPanel');
    const btn = document.getElementById('upazilaBtn');
    const label = document.getElementById('upazilaLabel');

    panel.querySelectorAll('.dropdown-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        panel.querySelectorAll('.dropdown-option').forEach((o) => o.classList.remove('active'));
        opt.classList.add('active');

        const value = opt.dataset.value;
        activeUpazila = value;

        if (value === 'all') {
          label.textContent = 'উপজেলা';
          btn.classList.remove('has-value');
        } else {
          label.textContent = value;
          btn.classList.add('has-value');
        }

        btn.closest('.dropdown-wrap').classList.remove('open');
        applyFilters();
      });
    });

    const clubSearchInput = document.getElementById('clubSearchInput');
    clubSearchInput.addEventListener('input', (e) => {
      clubSearchTerm = e.target.value.trim().toLowerCase().normalize('NFC');
      applyFilters();
    });
  }

  async function init() {
    if (!(await isStaff())) {
      window.location.replace('/services/blood');
      return;
    }

    const donors = await loadDonors();

    gateState.style.display = 'none';
    staffContent.style.display = 'block';

    if (donors.length === 0) {
      emptyState.style.display = 'block';
      return;
    }

    donors.forEach((d) => grid.appendChild(renderCard(d)));
    filtersRow.style.display = 'flex';
    countLine.style.display = 'block';
    setupFilters();
    initLocationReorder(grid, 'upazilaName');
    applyFilters();
  }

  init();
</script>
