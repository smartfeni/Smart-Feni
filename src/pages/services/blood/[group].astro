---
// ============================================================
// পেজ: নির্দিষ্ট ব্লাড গ্রুপের ডোনার লিস্ট
// URL: /services/blood/{slug} (যেমন /services/blood/a-positive)
// দুই সোর্স মার্জ করে দেখানো হয়:
//   ১. profiles (is_blood_donor=true, donor_disabled=false)
//   ২. manual_blood_donors (status='active') — club_id লিংকড থাকলে
//      clubs টেবিল থেকে নাম+লোগো এমবেড হয়ে আসে (Supabase FK join),
//      না থাকলে club_name_raw টেক্সট ফলব্যাক হিসেবে ব্যবহৃত হয়
// ফিল্টার: উপজেলা (ড্রপডাউন) + সংগঠনের নাম (সার্চ বক্স) — একই রো
// সর্টিং: শেয়ারড locationSort.js — initLocationReorder()
// লাইক + রিপোর্ট সিস্টেম অপরিবর্তিত (contentEngagement.js, reportModal.js)
// SSR পেজ — prerender = false আবশ্যক।
//
// UI REDESIGN (v2):
// - ব্যাক লিংক এখন absolute floating pill (টপ-লেফট কর্নার), H1 হেডারের
//   একদম নিচ থেকে শুরু হয়
// - ফিল্টার রো: উপজেলা বাটন আগের সাইজে (auto-width), সার্চ বার flex:1
// - ক্লাব ব্যাজ: লোগো float:left, টেক্সট wrap করে লোগোর নিচ থেকেই
//   (দ্বিতীয় লাইনে কোনো ফাঁকা স্পেস নেই), max 2 লাইন ক্লাম্পড
// - কন্টাক্ট বাটন: টেক্সটবিহীন ছোট সবুজ গোল আইকন বাটন
// - কার্ড কমপ্যাক্ট (padding/gap কমানো)
// ============================================================

export const prerender = false;

import BaseLayout from '../../../components/layout/BaseLayout.astro';
import ReportModal from '../../../components/shared/ReportModal.astro';
import { supabase } from '../../../lib/supabase.js';

const slugToGroup = {
  'a-positive': 'A+',
  'a-negative': 'A-',
  'b-positive': 'B+',
  'b-negative': 'B-',
  'ab-positive': 'AB+',
  'ab-negative': 'AB-',
  'o-positive': 'O+',
  'o-negative': 'O-',
};

const { group: groupSlug } = Astro.params;
const bloodGroup = slugToGroup[groupSlug];

if (!bloodGroup) {
  return Astro.redirect('/services/blood');
}

const upazilas = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];

const [{ data: profileDonors }, { data: manualDonors }] = await Promise.all([
  supabase
    .from('profiles')
    .select('id, full_name, phone, blood_group, upazila, avatar_url')
    .eq('is_blood_donor', true)
    .eq('donor_disabled', false)
    .eq('blood_group', bloodGroup)
    .order('created_at', { ascending: false }),
  supabase
    .from('manual_blood_donors')
    .select('id, name, phone, blood_group, upazila, club_name_raw, club_id, clubs(name, logo_image)')
    .eq('status', 'active')
    .eq('blood_group', bloodGroup)
    .order('created_at', { ascending: false }),
]);

const normalizedProfileDonors = (profileDonors || []).map((d) => ({
  id: d.id,
  targetType: 'blood_profile',
  full_name: d.full_name,
  phone: d.phone,
  blood_group: d.blood_group,
  upazila: d.upazila,
  avatar_url: d.avatar_url,
  clubDisplayName: null,
  clubLogo: null,
  isClubSourced: false,
}));

const normalizedManualDonors = (manualDonors || []).map((d) => ({
  id: d.id,
  targetType: 'blood_manual',
  full_name: d.name,
  phone: d.phone,
  blood_group: d.blood_group,
  upazila: d.upazila,
  avatar_url: null,
  // ক্লাব লিংকড থাকলে clubs.name/logo_image প্রাধান্য পায়,
  // না থাকলে স্ক্রিনশট থেকে আসা raw টেক্সট ফলব্যাক
  clubDisplayName: d.clubs?.name || d.club_name_raw || null,
  clubLogo: d.clubs?.logo_image || null,
  isClubSourced: Boolean(d.club_name_raw || d.club_id),
}));

const donors = [...normalizedProfileDonors, ...normalizedManualDonors];
const hasDonors = donors.length > 0;
---

<BaseLayout title={`${bloodGroup} রক্তদাতা | স্মার্ট ফেনী`}>
  <section class="page-header">
    <div class="header-decor" aria-hidden="true"></div>
    <div class="container">
      <a href="/services/blood" class="back-link">
        <i class="fas fa-arrow-left"></i> সব গ্রুপ
      </a>
      <h1><i class="fas fa-droplet drop-icon"></i> <span class="accent">{bloodGroup}</span> রক্তদাতা</h1>
      <p>ফেনীর {bloodGroup} গ্রুপের স্বেচ্ছাসেবী রক্তদাতাদের সাথে সরাসরি যোগাযোগ করুন</p>
    </div>
  </section>

  <section class="donor-section">
    <div class="container">
      {hasDonors && (
        <div class="filters-row">
          <div class="dropdown-wrap">
            <button class="dropdown-btn" id="upazilaBtn" type="button">
              <span id="upazilaLabel">উপজেলা</span>
              <i class="fas fa-chevron-down"></i>
            </button>
            <div class="dropdown-panel" id="upazilaPanel">
              <button class="dropdown-option active" data-value="all">সব উপজেলা</button>
              {upazilas.map((u) => (
                <button class="dropdown-option" data-value={u}>{u}</button>
              ))}
            </div>
          </div>

          <div class="club-search-wrap">
            <i class="fas fa-magnifying-glass"></i>
            <input
              type="text"
              id="clubSearchInput"
              placeholder="সংগঠনের নাম দিয়ে খুঁজুন..."
              autocomplete="off"
            />
          </div>
        </div>
      )}

      {donors.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-droplet"></i>
          <p>{bloodGroup} গ্রুপে এখনো কোনো রক্তদাতা তালিকাভুক্ত হননি</p>
          <span>অন্য গ্রুপ দেখতে চাইলে ফিরে যান</span>
          <a href="/services/blood" class="btn-back-outline">
            <i class="fas fa-arrow-left"></i> সব গ্রুপে ফিরে যান
          </a>
        </div>
      ) : (
        <>
          <div class="donor-grid" id="donorGrid">
            {donors.map((donor) => (
              <div
                class="donor-card"
                data-upazila-name={donor.upazila || ''}
                data-club-name={(donor.clubDisplayName || '').toLowerCase()}
                data-target-type={donor.targetType}
                data-target-id={donor.id}
              >
                <div class="donor-card-top">
                  <span class="donor-avatar">
                    {donor.avatar_url ? (
                      <img src={donor.avatar_url} alt={donor.full_name} />
                    ) : (
                      <i class="fas fa-droplet"></i>
                    )}
                  </span>
                  <span class="blood-badge">{donor.blood_group || '—'}</span>
                </div>

                <div class="engagement-row" data-engagement-row>
                  <span class="like-count-view" data-like-count-view>
                    <i class="fas fa-heart"></i>
                    <span data-like-count>0</span>
                  </span>
                  <button class="like-btn" type="button" data-like-btn aria-label="লাইক করুন" style="display:none;">
                    <i class="fas fa-heart"></i>
                    <span class="like-count" data-like-count>0</span>
                  </button>
                  <button class="flag-btn" type="button" data-flag-btn aria-label="অভিযোগ করুন" style="display:none;">
                    <i class="fas fa-flag"></i>
                  </button>
                </div>

                <h3 class="donor-name">{donor.full_name}</h3>

                {donor.upazila && (
                  <p class="donor-location"><i class="fas fa-location-dot"></i> {donor.upazila}</p>
                )}

                {donor.isClubSourced && donor.clubDisplayName && (
                  <p class="club-badge">
                    {donor.clubLogo ? (
                      <img src={donor.clubLogo} alt={donor.clubDisplayName} class="club-badge-logo" />
                    ) : (
                      <i class="fas fa-users club-badge-icon"></i>
                    )}
                    {donor.clubDisplayName}
                  </p>
                )}

                <div class="card-footer">
                  <a href={`tel:${donor.phone}`} class="btn-contact-icon" aria-label="ফোন করুন">
                    <i class="fas fa-phone"></i>
                  </a>
                </div>
              </div>
            ))}
          </div>

          <p class="no-match-state" id="noMatchState" style="display:none;">
            এই ফিল্টারে কোনো রক্তদাতা পাওয়া যায়নি
          </p>
        </>
      )}
    </div>
  </section>

  <ReportModal />
</BaseLayout>

