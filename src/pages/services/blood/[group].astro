<script>
  import { initLocationReorder } from '../../../lib/locationSort.js';
  import { fetchLikeData, toggleLike, isLoggedIn } from '../../../lib/contentEngagement.js';
  import { initReportModal } from '../../../lib/reportModal.js';

  const grid = document.getElementById('donorGrid');
  const noMatchState = document.getElementById('noMatchState');
  const cards = document.querySelectorAll('.donor-card');

  // ===== ড্রপডাউন ওপেন/ক্লোজ হ্যান্ডলিং =====
  const dropdownWraps = document.querySelectorAll('.dropdown-wrap');

  dropdownWraps.forEach((wrap) => {
    const btn = wrap.querySelector('.dropdown-btn');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = wrap.classList.contains('open');
      dropdownWraps.forEach((w) => w.classList.remove('open'));
      if (!isOpen) wrap.classList.add('open');
    });
  });

  document.addEventListener('click', () => {
    dropdownWraps.forEach((w) => w.classList.remove('open'));
  });

  // ===== ফিল্টার স্টেট (শুধু উপজেলা + ক্লাব সার্চ, ব্লাড গ্রুপ URL এ ফিক্সড) =====
  let activeUpazila = 'all';
  let clubSearchTerm = '';

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesUpazila = activeUpazila === 'all' || card.dataset.upazilaName === activeUpazila;
      const matchesClub = clubSearchTerm === '' || (card.dataset.clubName || '').includes(clubSearchTerm);

      if (matchesUpazila && matchesClub) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noMatchState) {
      noMatchState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  function setupDropdown(panelId, btnId, labelId, defaultLabel, onSelect) {
    const panel = document.getElementById(panelId);
    const btn = document.getElementById(btnId);
    const label = document.getElementById(labelId);
    if (!panel || !btn || !label) return;

    panel.querySelectorAll('.dropdown-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        panel.querySelectorAll('.dropdown-option').forEach((o) => o.classList.remove('active'));
        opt.classList.add('active');

        const value = opt.dataset.value;
        onSelect(value);

        if (value === 'all') {
          label.textContent = defaultLabel;
          btn.classList.remove('has-value');
        } else {
          label.textContent = value;
          btn.classList.add('has-value');
        }

        btn.closest('.dropdown-wrap').classList.remove('open');
        applyFilters();
      });
    });
  }

  setupDropdown('upazilaPanel', 'upazilaBtn', 'upazilaLabel', 'উপজেলা', (v) => {
    activeUpazila = v;
  });

  const clubSearchInput = document.getElementById('clubSearchInput');
  if (clubSearchInput) {
    clubSearchInput.addEventListener('input', (e) => {
      clubSearchTerm = e.target.value.trim().toLowerCase();
      applyFilters();
    });
  }

  // ===== লোকেশন-ভিত্তিক re-order =====
  if (grid) initLocationReorder(grid, 'upazilaName');

  // ============================================================
  // লাইক + রিপোর্ট (অভিযোগ) সিস্টেম — লগইন-গেটেড
  // ============================================================
  const report = initReportModal({
    reasons: [
      { value: 'unavailable', label: 'এভেইলেবল না / প্রবাসে' },
      { value: 'behavior', label: 'আচরণ খারাপ' },
      { value: 'wrong_info', label: 'ভুল তথ্য (গ্রুপ/নাম্বার ভুল)' },
      { value: 'other', label: 'অন্যান্য' },
    ],
  });

  function updateLikeDisplay(card, liked, count) {
    card.querySelectorAll('[data-like-count]').forEach((el) => {
      el.textContent = count;
    });
    const likeBtn = card.querySelector('[data-like-btn]');
    if (likeBtn) likeBtn.classList.toggle('liked', liked);
  }

  let boundCards = new WeakSet();

  async function renderEngagement() {
    const loggedIn = await isLoggedIn();

    const profileIds = [];
    const manualIds = [];
    cards.forEach((card) => {
      const type = card.dataset.targetType;
      const id = card.dataset.targetId;
      if (type === 'blood_profile') profileIds.push(id);
      else if (type === 'blood_manual') manualIds.push(id);
    });

    const [profileLikes, manualLikes] = await Promise.all([
      fetchLikeData('blood_profile', profileIds),
      fetchLikeData('blood_manual', manualIds),
    ]);

    cards.forEach((card) => {
      const type = card.dataset.targetType;
      const id = card.dataset.targetId;
      const likeData = type === 'blood_profile' ? profileLikes : manualLikes;
      const count = likeData.counts[id] || 0;
      const liked = likeData.likedByMe.has(id);

      const viewOnly = card.querySelector('[data-like-count-view]');
      const likeBtn = card.querySelector('[data-like-btn]');
      const flagBtn = card.querySelector('[data-flag-btn]');

      updateLikeDisplay(card, liked, count);

      if (loggedIn) {
        // ইন্টারঅ্যাকটিভ মোড: বাটন দেখাও, ভিউ-অনলি স্প্যান লুকাও
        viewOnly.style.display = 'none';
        likeBtn.style.display = 'flex';
        flagBtn.style.display = 'flex';

        if (!boundCards.has(card)) {
          boundCards.add(card);

          likeBtn.addEventListener('click', async () => {
            likeBtn.disabled = true;
            const result = await toggleLike(type, id);
            likeBtn.disabled = false;
            if (result.error) return;
            const currentCount = parseInt(likeBtn.querySelector('[data-like-count]').textContent, 10) || 0;
            const newCount = result.liked ? currentCount + 1 : Math.max(currentCount - 1, 0);
            updateLikeDisplay(card, result.liked, newCount);
          });

          flagBtn.addEventListener('click', () => {
            report.open(type, id);
          });
        }
      } else {
        // ভিউ-অনলি মোড: শুধু কাউন্ট দেখাও, বাটন/ফ্ল্যাগ লুকাও
        viewOnly.style.display = 'flex';
        likeBtn.style.display = 'none';
        flagBtn.style.display = 'none';
      }
    });
  }

  renderEngagement();

  // AuthModal থেকে লগইন হলে এই ইভেন্ট আসে — রিফ্রেশ ছাড়াই বাটন আনলক
  window.addEventListener('smartfeni:auth-changed', () => {
    renderEngagement();
  });
</script>