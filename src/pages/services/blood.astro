    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 18px;
    max-width: 900px;
    margin: 0 auto;
  }

  .group-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: #fff;
