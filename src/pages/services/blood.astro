<!-- path: src/pages/services/blood.astro -->
---
// ============================================================
// পেজ: ব্লাড ডোনার লিস্ট
// ব্র্যান্ড: স্মার্ট ফেনী
// ফিল্টার: ব্লাড গ্রুপ + উপজেলা — দুইটা আলাদা ড্রপডাউন, কম্বাইন্ড
//          ফিল্টারিং, কোনো আলাদা সার্চ বাটন নাই (সিলেক্ট করা মাত্র
//          instantly ফিল্টার হয়)
// সর্টিং: শেয়ারড locationSort.js ইউটিলিটি — initLocationReorder()
//         ব্যবহার করা হচ্ছে (আগে reorderByUserLocation ছিল), যাতে
//         উপজেলা-ম্যাচ অগ্রাধিকার + প্রতি গ্রুপে shuffle (fairness)
//         + পেজের ভেতরে উপজেলা বদলালে লাইভ re-sort — তিনটাই পাওয়া যায়
// SSR পেজ — prerender = false আবশ্যক।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import { supabase } from '../../lib/supabase.js';

const bloodGroups = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
const upazilas = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];

const { data: donorData } = await supabase
  .from('profiles')
  .select('full_name, phone, blood_group, upazila, avatar_url')
  .eq('is_blood_donor', true)
  .order('created_at', { ascending: false });

const donors = donorData || [];
const hasDonors = donors.length > 0;
---

<BaseLayout title="ব্লাড ডোনার | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <h1>ফেনীর <span class="accent">রক্তদাতা</span> খুঁজুন</h1>
      <p>জরুরি প্রয়োজনে ফেনীর স্বেচ্ছাসেবী রক্তদাতাদের সাথে সরাসরি যোগাযোগ করুন</p>

      {!hasDonors && (
        <a href="/profile/edit" class="btn-register">
          <i class="fas fa-droplet"></i> রক্তদাতা হিসেবে রেজিস্ট্রেশন করুন
        </a>
      )}
    </div>
  </section>

  <section class="donor-section">
    <div class="container">
      <div class="filter-dropdowns">
        <div class="dropdown-wrap">
          <button class="dropdown-btn" id="bloodGroupBtn" type="button">
            <span id="bloodGroupLabel">ব্লাড গ্রুপ</span>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="dropdown-panel" id="bloodGroupPanel">
            <button class="dropdown-option active" data-value="all">সব গ্রুপ</button>
            {bloodGroups.map((bg) => (
              <button class="dropdown-option" data-value={bg}>{bg}</button>
            ))}
          </div>
        </div>

        <div class="dropdown-wrap">
          <button class="dropdown-btn" id="upazilaBtn" type="button">
            <span id="upazilaLabel">উপজেলা</span>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="dropdown-panel" id="upazilaPanel">
            <button class="dropdown-option active" data-value="all">সব উপজেলা</button>
            {upazilas.map((u) => (
              <button class="dropdown-option" data-value={u}>{u}</button>
            ))}
          </div>
        </div>
      </div>

      {donors.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-droplet"></i>
          <p>এখনো কোনো রক্তদাতা তালিকাভুক্ত হননি</p>
          <span>প্রোফাইল থেকে "ব্লাড ডোনার লিস্টে দেখাও" অন করে প্রথম রক্তদাতা হোন</span>
          <a href="/profile/edit" class="btn-register-outline">
            <i class="fas fa-plus"></i> এখনই নিবন্ধন করুন
          </a>
        </div>
      ) : (
        <>
          <div class="donor-grid" id="donorGrid">
            {donors.map((donor) => (
              <div class="donor-card" data-blood-group={donor.blood_group || ''} data-upazila-name={donor.upazila || ''}>
                <div class="donor-card-top">
                  <span class="donor-avatar">
                    {donor.avatar_url ? (
                      <img src={donor.avatar_url} alt={donor.full_name} />
                    ) : (
                      <i class="fas fa-circle-user"></i>
                    )}
                  </span>
                  <span class="blood-badge">{donor.blood_group || '—'}</span>
                </div>

                <h3 class="donor-name">{donor.full_name}</h3>

                {donor.upazila && (
                  <p class="donor-location"><i class="fas fa-location-dot"></i> {donor.upazila}</p>
                )}

                <a href={`tel:${donor.phone}`} class="btn-contact">
                  <i class="fas fa-phone"></i> যোগাযোগ করুন
                </a>
              </div>
            ))}
          </div>

          <p class="no-match-state" id="noMatchState" style="display:none;">
            এই ফিল্টারে কোনো রক্তদাতা পাওয়া যায়নি
          </p>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: 60px 0 30px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header .accent {
    color: #FF6B35;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    max-width: 560px;
    margin: 0 auto 24px;
  }

  .btn-register {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .btn-register:hover {
    background: #e85a28;
    transform: translateY(-2px);
  }

  .donor-section {
    padding: 30px 0 70px;
    background: #F8FAFC;
  }

  /* ===== ড্রপডাউন ফিল্টার ===== */
  .filter-dropdowns {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .dropdown-wrap {
    position: relative;
  }

  .dropdown-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    color: #1B2A4A;
    padding: 12px 20px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dropdown-btn:hover {
    border-color: #FF6B35;
  }

  .dropdown-btn.has-value {
    background: #FFF0EA;
    border-color: #FF6B35;
    color: #FF6B35;
  }

  .dropdown-btn i {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .dropdown-wrap.open .dropdown-btn i {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.14);
    padding: 8px;
    min-width: 180px;
    max-height: 280px;
    overflow-y: auto;
    z-index: 50;
  }

  .dropdown-wrap.open .dropdown-panel {
    display: block;
  }

  .dropdown-option {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: #1B2A4A;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .dropdown-option:hover {
    background: #F4F7FC;
  }

  .dropdown-option.active {
    background: #FFF0EA;
    color: #FF6B35;
    font-weight: 700;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .empty-state span {
    color: #8FA0BC;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 20px;
  }

  .btn-register-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #FF6B35;
    border: 1.5px solid #FF6B35;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .btn-register-outline:hover {
    background: #FF6B35;
    color: #fff;
  }

  .no-match-state {
    text-align: center;
    color: #8FA0BC;
    font-weight: 600;
    padding: 40px 0;
  }

  .donor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .donor-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    border: 1px solid #EEF3F9;
    transition: all 0.25s ease;
  }

  .donor-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .donor-card.hidden {
    display: none;
  }

  .donor-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .donor-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #F4F7FC;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .donor-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .donor-avatar i {
    color: #B0BCCB;
    font-size: 1.7rem;
  }

  .blood-badge {
    background: #FFF0EA;
    color: #D14343;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 6px 14px;
    border-radius: 12px;
    white-space: nowrap;
  }

  .donor-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 6px;
  }

  .donor-location {
    color: #5A6E85;
    font-size: 0.85rem;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .donor-location i {
    color: #FF6B35;
    font-size: 0.75rem;
  }

  .btn-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: #1B2A4A;
    color: #fff;
    text-decoration: none;
    padding: 12px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.2s ease;
  }

  .btn-contact:hover {
    background: #FF6B35;
  }

  @media (max-width: 768px) {
    .donor-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }

    .page-header h1 {
      font-size: 1.7rem;
    }

    .dropdown-btn {
      padding: 10px 16px;
      font-size: 0.85rem;
    }
  }
</style>

<script>
  import { initLocationReorder } from '../../lib/locationSort.js';

  const grid = document.getElementById('donorGrid');
  const noMatchState = document.getElementById('noMatchState');
  const cards = document.querySelectorAll('.donor-card');

  // ===== ড্রপডাউন ওপেন/ক্লোজ হ্যান্ডলিং =====
  const dropdownWraps = document.querySelectorAll('.dropdown-wrap');

  dropdownWraps.forEach((wrap) => {
    const btn = wrap.querySelector('.dropdown-btn');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = wrap.classList.contains('open');
      dropdownWraps.forEach((w) => w.classList.remove('open'));
      if (!isOpen) wrap.classList.add('open');
    });
  });

  document.addEventListener('click', () => {
    dropdownWraps.forEach((w) => w.classList.remove('open'));
  });

  // ===== ফিল্টার স্টেট =====
  let activeBloodGroup = 'all';
  let activeUpazila = 'all';

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesBlood = activeBloodGroup === 'all' || card.dataset.bloodGroup === activeBloodGroup;
      const matchesUpazila = activeUpazila === 'all' || card.dataset.upazilaName === activeUpazila;

      if (matchesBlood && matchesUpazila) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noMatchState) {
      noMatchState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  function setupDropdown(panelId, btnId, labelId, defaultLabel, onSelect) {
    const panel = document.getElementById(panelId);
    const btn = document.getElementById(btnId);
    const label = document.getElementById(labelId);
    if (!panel || !btn || !label) return;

    panel.querySelectorAll('.dropdown-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        panel.querySelectorAll('.dropdown-option').forEach((o) => o.classList.remove('active'));
        opt.classList.add('active');

        const value = opt.dataset.value;
        onSelect(value);

        if (value === 'all') {
          label.textContent = defaultLabel;
          btn.classList.remove('has-value');
        } else {
          label.textContent = value;
          btn.classList.add('has-value');
        }

        btn.closest('.dropdown-wrap').classList.remove('open');
        applyFilters();
      });
    });
  }

  setupDropdown('bloodGroupPanel', 'bloodGroupBtn', 'bloodGroupLabel', 'ব্লাড গ্রুপ', (v) => {
    activeBloodGroup = v;
  });

  setupDropdown('upazilaPanel', 'upazilaBtn', 'upazilaLabel', 'উপজেলা', (v) => {
    activeUpazila = v;
  });

  // ===== লোকেশন-ভিত্তিক re-order (fairness shuffle + লাইভ আপডেট) =====
  initLocationReorder(grid, 'upazilaName');
</script>