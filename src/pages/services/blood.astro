// ============================================================
// পেজ: ব্লাড গ্রুপ সিলেক্টর (ল্যান্ডিং)
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত — কাউন্ট কোয়েরি, CTA হাইড)
//
// আপডেট (Blood Request ফিচার, ২-ট্যাব মোডাল): "ব্লাড রিকোয়েস্ট"
// বাটন যোগ হলো — ক্লিক করলে ২-ট্যাব মোডাল খুলবে:
//   ট্যাব ১ "নতুন রিকোয়েস্ট" — ফর্ম, সাবমিট করলে blood_requests এ
//     insert হয়, DB ট্রিগার অটো ম্যাচিং ডোনারদের push পাঠায়
//   ট্যাব ২ "বর্তমান রিকোয়েস্ট" — ইউজারের নিজের active/fulfilled
//     রিকোয়েস্ট(গুলো) + প্রতিটার আগ্রহী ডোনারদের লাইভ লিস্ট +
//     "ব্লাড ম্যানেজ হয়ে গেছে" বাটন
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import { supabase } from '../../lib/supabase.js';

const bloodGroupSlugs = [
  { group: 'A+', slug: 'a-positive' },
  { group: 'A-', slug: 'a-negative' },
  { group: 'B+', slug: 'b-positive' },
  { group: 'B-', slug: 'b-negative' },
  { group: 'AB+', slug: 'ab-positive' },
  { group: 'AB-', slug: 'ab-negative' },
  { group: 'O+', slug: 'o-positive' },
  { group: 'O-', slug: 'o-negative' },
];

const upazilas = ['ফেনী সদর', 'ছাগলনাইয়া', 'দাগনভূঞা', 'পরশুরাম', 'ফুলগাজী', 'সোনাগাজী'];

const [{ data: profileGroups }, { data: manualGroups }] = await Promise.all([
  supabase
    .from('profiles')
    .select('blood_group')
    .eq('is_blood_donor', true)
    .eq('donor_disabled', false),
  supabase
    .from('manual_blood_donors')
    .select('blood_group')
    .eq('status', 'active'),
]);

const countMap = {};
[...(profileGroups || []), ...(manualGroups || [])].forEach((row) => {
  if (!row.blood_group) return;
  countMap[row.blood_group] = (countMap[row.blood_group] || 0) + 1;
});

const totalDonors = Object.values(countMap).reduce((sum, c) => sum + c, 0);

const groupsWithCount = bloodGroupSlugs.map((g) => ({
  ...g,
  count: countMap[g.group] || 0,
}));
---

<BaseLayout title="ব্লাড ডোনার | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <h1>ফেনীর <span class="accent">রক্তদাতা</span> খুঁজুন</h1>
      <p>
        ফেনীর সবচেয়ে বড় অনলাইন ব্লাড ডিরেক্টরি —
        <strong>{totalDonors} জন</strong> রক্তদাতার মধ্য থেকে খুঁজে নিন আপনার প্রয়োজনীয় রক্তদাতা
      </p>

      <div class="header-actions">
        <a href="/profile/edit" class="btn-register" data-donor-cta>
          <i class="fas fa-droplet"></i> রক্তদাতা হিসেবে রেজিস্ট্রেশন করুন
        </a>
        <button type="button" id="openBloodRequestBtn" class="btn-request">
          <i class="fas fa-triangle-exclamation"></i> ব্লাড রিকোয়েস্ট
        </button>
      </div>
    </div>
  </section>

  <section class="group-section">
    <div class="container">
      {totalDonors === 0 ? (
        <div class="empty-state">
          <i class="fas fa-droplet"></i>
          <p>এখনো কোনো রক্তদাতা তালিকাভুক্ত হননি</p>
          <span>প্রোফাইল থেকে "ব্লাড ডোনার লিস্টে দেখাও" অন করে প্রথম রক্তদাতা হোন</span>
          <a href="/profile/edit" class="btn-register-outline" data-donor-cta>
            <i class="fas fa-plus"></i> এখনই নিবন্ধন করুন
          </a>
        </div>
      ) : (
        <div class="group-grid">
          {groupsWithCount.map((g) => (
            <a
              href={`/services/blood/${g.slug}`}
              class={`group-tile ${g.count === 0 ? 'is-empty' : ''}`}
            >
              <span class="group-badge">{g.group}</span>
              <span class="group-count">
                {g.count > 0 ? `${g.count} জন ডোনার` : 'এখনো কেউ নেই'}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ==========================================================
       Blood Request মোডাল — ২ ট্যাব
  =========================================================== -->
  <div class="br-overlay" id="brOverlay">
    <div class="br-modal">
      <button type="button" class="br-close" id="brCloseBtn" aria-label="বন্ধ করুন">
        <i class="fas fa-xmark"></i>
      </button>

      <h3>🩸 ব্লাড রিকোয়েস্ট</h3>

      <div class="br-tabs">
        <button type="button" class="br-tab active" data-tab="new">নতুন রিকোয়েস্ট</button>
        <button type="button" class="br-tab" data-tab="current">বর্তমান রিকোয়েস্ট</button>
      </div>

      <!-- ===== ট্যাব ১: নতুন রিকোয়েস্ট ===== -->
      <div class="br-tab-panel active" id="tabNew">
        <p class="br-sub">ফর্মটি পূরণ করুন — আপনার গ্রুপ ও উপজেলার সব রেজিস্টার্ড ডোনারের কাছে সাথে সাথে নোটিফিকেশন যাবে।</p>

        <div id="brLoginNotice" class="br-login-notice" style="display:none;">
          <p>রিকোয়েস্ট পোস্ট করতে আগে লগইন করুন</p>
        </div>

        <form id="bloodRequestForm" class="br-form">
          <label>
            আপনার নাম *
            <input type="text" id="requesterName" required />
          </label>

          <label>
            ফোন নম্বর *
            <input type="tel" id="requesterPhone" required placeholder="01XXXXXXXXX" />
          </label>

          <div class="br-form-row">
            <label>
              ব্লাড গ্রুপ *
              <select id="bloodGroup" required>
                <option value="" disabled selected>সিলেক্ট করুন</option>
                {bloodGroupSlugs.map((g) => <option value={g.group}>{g.group}</option>)}
              </select>
            </label>

            <label>
              উপজেলা *
              <select id="upazila" required>
                <option value="" disabled selected>সিলেক্ট করুন</option>
                {upazilas.map((u) => <option value={u}>{u}</option>)}
              </select>
            </label>
          </div>

          <label>
            বিস্তারিত (হাসপাতাল, কত ব্যাগ লাগবে ইত্যাদি)
            <textarea id="details" rows="3" placeholder="যেমন: ফেনী জেনারেল হাসপাতাল, ২ ব্যাগ, আজকের মধ্যে"></textarea>
          </label>

          <p class="br-feedback" id="brFeedback"></p>

          <button type="submit" id="brSubmitBtn" class="btn-submit-request">
            <i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান
          </button>
        </form>
      </div>

      <!-- ===== ট্যাব ২: বর্তমান রিকোয়েস্ট ===== -->
      <div class="br-tab-panel" id="tabCurrent">
        <div id="currentRequestsLoading" class="br-loading">লোড হচ্ছে...</div>
        <div id="currentRequestsEmpty" class="br-empty" style="display:none;">
          <i class="fas fa-inbox"></i>
          <p>আপনার কোনো রিকোয়েস্ট নেই</p>
        </div>
        <div id="currentRequestsList" class="br-requests-list"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase.js';

  async function hideCtaIfAlreadyDonor() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const { data: profile } = await supabase
      .from('profiles')
      .select('is_blood_donor, donor_disabled')
      .eq('id', session.user.id)
      .single();

    if (profile?.is_blood_donor && !profile?.donor_disabled) {
      document.querySelectorAll('[data-donor-cta]').forEach((el) => {
        (el as HTMLElement).style.display = 'none';
      });
    }
  }
  hideCtaIfAlreadyDonor();

  // ============================================================
  // মোডাল খোলা/বন্ধ + ট্যাব সুইচিং
  // ============================================================
  const overlay = document.getElementById('brOverlay');
  const openBtn = document.getElementById('openBloodRequestBtn');
  const closeBtn = document.getElementById('brCloseBtn');
  const loginNotice = document.getElementById('brLoginNotice');
  const form = document.getElementById('bloodRequestForm') as HTMLFormElement;

  const tabButtons = document.querySelectorAll('.br-tab');
  const tabPanels = {
    new: document.getElementById('tabNew'),
    current: document.getElementById('tabCurrent'),
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      Object.entries(tabPanels).forEach(([key, panel]) => {
        panel?.classList.toggle('active', key === target);
      });
      if (target === 'current') loadCurrentRequests();
    });
  });

  async function openModal() {
    overlay?.classList.add('open');

    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      form.style.display = 'none';
      loginNotice.style.display = 'block';
      return;
    }

    form.style.display = 'flex';
    loginNotice.style.display = 'none';

    const nameInput = document.getElementById('requesterName') as HTMLInputElement;
    if (nameInput && !nameInput.value) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('full_name, phone')
        .eq('id', session.user.id)
        .single();

      if (profile) {
        const phoneInput = document.getElementById('requesterPhone') as HTMLInputElement;
        if (profile.full_name) nameInput.value = profile.full_name;
        if (phoneInput && profile.phone) phoneInput.value = profile.phone;
      }
    }
  }

  function closeModal() {
    overlay?.classList.remove('open');
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });

  // ============================================================
  // ট্যাব ১: নতুন রিকোয়েস্ট সাবমিট
  // ============================================================
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const submitBtn = document.getElementById('brSubmitBtn') as HTMLButtonElement;
    const feedback = document.getElementById('brFeedback');

    const requesterName = (document.getElementById('requesterName') as HTMLInputElement).value.trim();
    const requesterPhone = (document.getElementById('requesterPhone') as HTMLInputElement).value.trim();
    const bloodGroup = (document.getElementById('bloodGroup') as HTMLSelectElement).value;
    const upazila = (document.getElementById('upazila') as HTMLSelectElement).value;
    const details = (document.getElementById('details') as HTMLTextAreaElement).value.trim();

    if (!requesterName || !requesterPhone || !bloodGroup || !upazila) {
      feedback.className = 'br-feedback error';
      feedback.textContent = 'সব আবশ্যক ফিল্ড পূরণ করুন';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'পাঠানো হচ্ছে...';

    const { error } = await supabase.from('blood_requests').insert({
      requester_user_id: session.user.id,
      requester_name: requesterName,
      requester_phone: requesterPhone,
      blood_group: bloodGroup,
      upazila,
      details: details || null,
    });

    if (error) {
      feedback.className = 'br-feedback error';
      feedback.textContent = 'কিছু ভুল হয়েছে, আবার চেষ্টা করুন';
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';
      return;
    }

    feedback.className = 'br-feedback success';
    feedback.textContent = 'রিকোয়েস্ট পোস্ট হয়েছে ✅ ডোনারদের নোটিফিকেশন পাঠানো হচ্ছে...';

    setTimeout(() => {
      form.reset();
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> রিকোয়েস্ট পাঠান';
      feedback.textContent = '';
      feedback.className = 'br-feedback';
      (document.querySelector('.br-tab[data-tab="current"]') as HTMLElement)?.click();
    }, 1500);
  });

  // ============================================================
  // ট্যাব ২: বর্তমান রিকোয়েস্ট লোড করা + রেন্ডার
  // ============================================================
  function formatTimeAgo(dateStr) {
    const diffMs = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diffMs / 60000);
    if (mins < 1) return 'এইমাত্র';
    if (mins < 60) return `${mins} মিনিট আগে`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs} ঘণ্টা আগে`;
    return `${Math.floor(hrs / 24)} দিন আগে`;
  }

  async function loadCurrentRequests() {
    const loading = document.getElementById('currentRequestsLoading');
    const empty = document.getElementById('currentRequestsEmpty');
    const list = document.getElementById('currentRequestsList');

    loading.style.display = 'block';
    empty.style.display = 'none';
    list.innerHTML = '';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      loading.style.display = 'none';
      empty.style.display = 'block';
      return;
    }

    const { data: requests } = await supabase
      .from('blood_requests')
      .select('id, blood_group, upazila, details, status, created_at')
      .eq('requester_user_id', session.user.id)
      .order('created_at', { ascending: false });

    loading.style.display = 'none';

    if (!requests || requests.length === 0) {
      empty.style.display = 'block';
      return;
    }

    for (const req of requests) {
      const { data: responses } = await supabase
        .from('blood_request_responses')
        .select('donor_name, donor_phone, created_at')
        .eq('blood_request_id', req.id)
        .order('created_at', { ascending: false });

      const card = document.createElement('div');
      card.className = 'req-card';

      const statusLabel =
        req.status === 'fulfilled' ? '✅ ম্যানেজ হয়ে গেছে' :
        req.status === 'expired' ? '⏱️ মেয়াদ শেষ' :
        req.status === 'cancelled' ? '❌ বাতিল' : '🩸 চলমান';

      const responseListHtml = (responses && responses.length > 0)
        ? responses.map((r) => `
            <div class="donor-row">
              <span class="donor-name">${r.donor_name}</span>
              <a href="tel:${r.donor_phone}" class="donor-phone">${r.donor_phone}</a>
            </div>
          `).join('')
        : `<p class="no-responses">এখনো কেউ আগ্রহ দেখায়নি</p>`;

      card.innerHTML = `
        <div class="req-card-header">
          <span class="req-group">${req.blood_group}</span>
          <span class="req-status status-${req.status}">${statusLabel}</span>
        </div>
        <p class="req-meta">${req.upazila} · ${formatTimeAgo(req.created_at)}</p>
        ${req.details ? `<p class="req-details">${req.details}</p>` : ''}
        <div class="donor-list">
          <p class="donor-list-title">আগ্রহী ডোনার (${responses?.length || 0})</p>
          ${responseListHtml}
        </div>
        ${req.status === 'active' ? `<button class="btn-fulfill" data-request-id="${req.id}"><i class="fas fa-check"></i> ব্লাড ম্যানেজ হয়ে গেছে</button>` : ''}
      `;

      list.appendChild(card);
    }

    list.querySelectorAll('.btn-fulfill').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const requestId = btn.getAttribute('data-request-id');
        (btn as HTMLButtonElement).disabled = true;
        btn.textContent = 'আপডেট হচ্ছে...';

        const { data, error } = await supabase.rpc('mark_blood_request_fulfilled', {
          p_blood_request_id: requestId,
        });

        if (error || !data?.success) {
          alert('আপডেট করতে সমস্যা হয়েছে, আবার চেষ্টা করুন');
          (btn as HTMLButtonElement).disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> ব্লাড ম্যানেজ হয়ে গেছে';
          return;
        }

        loadCurrentRequests();
      });
    });
  }
</script>

<style is:global>
  .page-header {
    padding: 44px 0 20px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header .accent {
    color: #FF6B35;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    max-width: 560px;
    margin: 0 auto 20px;
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .btn-register {
