---
// ============================================================
// পেজ: ব্লাড গ্রুপ সিলেক্টর (ল্যান্ডিং)
// আগে এই পেজেই সব ডোনার একসাথে লোড হতো — ডোনার সংখ্যা বাড়ায়
// লোড টাইম বেড়ে যাচ্ছিল। এখন এই পেজ শুধু ৮টা ব্লাড গ্রুপ টাইল
// দেখায় (প্রতিটায় কতজন ডোনার আছে তার কাউন্ট), আসল ডোনার লিস্ট
// লোড হয় /services/blood/[group].astro তে, গ্রুপ সিলেক্ট করার পর।
//
// কাউন্ট কোয়েরি হালকা রাখা হয়েছে — pull করা হচ্ছে শুধু
// blood_group কলাম (পুরো ডোনার অবজেক্ট না), ক্লায়েন্ট-সাইডে গোনা হয়।
//
// সোর্স: profiles (is_blood_donor=true, donor_disabled=false) +
//        manual_blood_donors (status='active', স্ক্রিনশট বাল্ক-আপলোড
//        ও ক্লাব-এন্ট্রি দুটোই এখানে, club_name_raw দিয়ে আলাদা করা যায়)
// SSR পেজ — prerender = false আবশ্যক।
//
// আপডেট (নতুন — গ্যাপ ক্লিনআপ + লাইভ কাউন্ট ডেসক্রিপশন): header
// প্যাডিং টাইট করা হলো, ডেসক্রিপশনে totalDonors লাইভ কাউন্ট বসানো
// হলো। এছাড়া ইউজার আগে থেকেই রেজিস্টার্ড ব্লাড ডোনার হলে
// "রেজিস্ট্রেশন করুন" CTA (উভয় ভার্সন) ক্লায়েন্ট-সাইডে হাইড হয়ে
// যাবে — data-donor-cta অ্যাট্রিবিউট দিয়ে টার্গেট করা।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import { supabase } from '../../lib/supabase.js';

// গ্রুপ → URL-safe স্লাগ ম্যাপিং ('+' ক্যারেক্টার URL এ সমস্যা করে)
const bloodGroupSlugs = [
  { group: 'A+', slug: 'a-positive' },
  { group: 'A-', slug: 'a-negative' },
  { group: 'B+', slug: 'b-positive' },
  { group: 'B-', slug: 'b-negative' },
  { group: 'AB+', slug: 'ab-positive' },
  { group: 'AB-', slug: 'ab-negative' },
  { group: 'O+', slug: 'o-positive' },
  { group: 'O-', slug: 'o-negative' },
];

const [{ data: profileGroups }, { data: manualGroups }] = await Promise.all([
  supabase
    .from('profiles')
    .select('blood_group')
    .eq('is_blood_donor', true)
    .eq('donor_disabled', false),
  supabase
    .from('manual_blood_donors')
    .select('blood_group')
    .eq('status', 'active'),
]);

// প্রতি গ্রুপের কাউন্ট বসানো হচ্ছে
const countMap = {};
[...(profileGroups || []), ...(manualGroups || [])].forEach((row) => {
  if (!row.blood_group) return;
  countMap[row.blood_group] = (countMap[row.blood_group] || 0) + 1;
});

const totalDonors = Object.values(countMap).reduce((sum, c) => sum + c, 0);

const groupsWithCount = bloodGroupSlugs.map((g) => ({
  ...g,
  count: countMap[g.group] || 0,
}));
---

<BaseLayout title="ব্লাড ডোনার | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <h1>ফেনীর <span class="accent">রক্তদাতা</span> খুঁজুন</h1>
      <p>
        ফেনীর সবচেয়ে বড় অনলাইন ব্লাড ডিরেক্টরি — <strong>{totalDonors} জন</strong> রক্তদাতার মধ্য থেকে খুঁজে নিন আপনার প্রয়োজনীয় রক্তদাতা
      </p>

      <a href="/profile/edit" class="btn-register" data-donor-cta>
        <i class="fas fa-droplet"></i> রক্তদাতা হিসেবে রেজিস্ট্রেশন করুন
      </a>
    </div>
  </section>

  <section class="group-section">
    <div class="container">
      {totalDonors === 0 ? (
        <div class="empty-state">
          <i class="fas fa-droplet"></i>
          <p>এখনো কোনো রক্তদাতা তালিকাভুক্ত হননি</p>
          <span>প্রোফাইল থেকে "ব্লাড ডোনার লিস্টে দেখাও" অন করে প্রথম রক্তদাতা হোন</span>
          <a href="/profile/edit" class="btn-register-outline" data-donor-cta>
            <i class="fas fa-plus"></i> এখনই নিবন্ধন করুন
          </a>
        </div>
      ) : (
        <div class="group-grid">
          {groupsWithCount.map((g) => (
            <a
              href={`/services/blood/${g.slug}`}
              class={`group-tile ${g.count === 0 ? 'is-empty' : ''}`}
            >
              <span class="group-badge">{g.group}</span>
              <span class="group-count">
                {g.count > 0 ? `${g.count} জন ডোনার` : 'এখনো কেউ নেই'}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // ============================================================
  // নতুন — ডোনার হিসেবে already রেজিস্টার্ড থাকলে "রেজিস্ট্রেশন করুন"
  // CTA বাটন (উভয় ভার্সন — হিরোর মূল বাটন + খালি-স্টেটের আউটলাইন
  // বাটন) হাইড হয়ে যাবে, যেহেতু আর দরকার নাই।
  // ============================================================
  import { supabase } from '../../lib/supabase.js';

  async function hideCtaIfAlreadyDonor() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const { data: profile } = await supabase
      .from('profiles')
      .select('is_blood_donor, donor_disabled')
      .eq('id', session.user.id)
      .single();

    if (profile?.is_blood_donor && !profile?.donor_disabled) {
      document.querySelectorAll('[data-donor-cta]').forEach((el) => {
        (el as HTMLElement).style.display = 'none';
      });
    }
  }

  hideCtaIfAlreadyDonor();
</script>

<style>
