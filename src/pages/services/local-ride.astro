---
// path: src/pages/services/local-ride.astro
// ============================================================
// পেজ: /services/local-ride — লোকাল রাইড (Ride Hero স্টাইল, hero-ui)
// সাদা hu-formcard: "রাইড চাই" (→ /local-ride-request) ও "আমার অর্ডার" (→ /my-orders)।
// নিচে Delivery Hero-র মতো এক লাইনের CTA: "লোকাল ড্রাইভার হতে চান?" (→ /become-a-local-driver);
// লগইন করা ড্রাইভারের আবেদনের অবস্থা অনুযায়ী লেখা বদলায়।
// "গাড়ি ভাড়া" অপশন (→ /services/car-rental): দিনের/ট্রিপের গাড়ি ভাড়ার লিস্টিং, এখন লোকাল রাইডের ভেতরে।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import GuideSheet from '../../components/delivery/GuideSheet.astro';
import '../../styles/hero-ui.css';

const guideSteps = [
  {
    caption: 'পিকআপ, গন্তব্য আর আপনার ভাড়া দিয়ে রিকোয়েস্ট পাঠান',
    blocks: [
      { kind: 'card', title: 'ধলিয়া থেকে ফেনী', lines: ['সিএনজি · ২ জন', 'ভাড়া ৳১২০'], badge: 'নতুন' },
      { kind: 'notice', text: 'রওনা হওয়ার এলাকার ড্রাইভাররা রিকোয়েস্ট দেখে।' },
    ],
  },
  {
    caption: 'ড্রাইভার রাজি হলে "আমার অর্ডার"-এ জানতে পারবেন',
    blocks: [
      { kind: 'button', text: 'আমার অর্ডার', primary: true, tap: true },
      { kind: 'notice', text: 'কনফার্ম হলে ড্রাইভারের ফোন নম্বর দেখা যাবে।' },
    ],
  },
];
---

<BaseLayout title="লোকাল রাইড | স্মার্ট ফেনী">
  <div class="lr-top-bar">
    <div class="container lr-top-bar-inner">
      <a href="/" class="lr-back-link" aria-label="পেছনে যান"><i class="fas fa-arrow-left"></i></a>
      <GuideSheet id="local-ride-home" title="লোকাল রাইড কীভাবে কাজ করে" subtitle="লোকাল রাইড" showButton buttonTone="light" steps={guideSteps} />
    </div>
  </div>

  <section class="hu-form-section">
    <div class="container">
      <div class="hu-formcard">
        <div class="hu-formhead">
          <span class="hu-formicon"><i class="fas fa-van-shuttle"></i></span>
          <h2 class="hu-title">লোকাল রাইড</h2>
        </div>
        <p class="hu-sub">দাম বলুন, এলাকার ড্রাইভাররা অফার দিবে — সবচেয়ে ভালোটা বেছে নিন</p>

        <a href="/local-ride-request" class="hu-submit lr-link-btn"><i class="fas fa-location-dot"></i> রাইড চাই</a>
        <a href="/services/car-rental" class="lr-rent-link">
          <span class="lr-rent-icon"><i class="fas fa-car"></i></span>
          <span class="lr-rent-text"><strong>গাড়ি ভাড়া</strong><small>দিনের বা ট্রিপের জন্য গাড়ি নিন, অথবা নিজের গাড়ি ভাড়া দিন</small></span>
          <i class="fas fa-chevron-right lr-rent-arrow"></i>
        </a>
        <a href="/my-orders" class="lr-orders-link"><i class="fas fa-receipt"></i> আমার অর্ডার দেখুন</a>

        <ul class="lr-points">
          <li><i class="fas fa-circle-check"></i> সিএনজি, অটো, ইজি বাইক ও মোটরসাইকেল: নিজের ইউনিয়নের ড্রাইভার</li>
          <li><i class="fas fa-circle-check"></i> প্রাইভেট কার, মাইক্রো ও পিকআপ: পুরো উপজেলার ড্রাইভার</li>
          <li><i class="fas fa-circle-check"></i> গাড়ি ভাড়া: মালিকের সাথে সরাসরি কথা বলে ভাড়া ঠিক করুন</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="lr-become-footer">
    <a href="/become-a-local-driver" id="lrBecomeLink"><i class="fas fa-van-shuttle"></i> <span id="lrBecomeText">লোকাল ড্রাইভার হতে চান?</span></a>
  </div>
</BaseLayout>

<style is:global>
  .lr-top-bar { background: #fff; padding: 14px 0 4px; }
  .lr-top-bar-inner { display: flex; align-items: center; justify-content: space-between; }
  .lr-back-link { color: #5A6E85; font-size: 1.1rem; text-decoration: none; }
  .lr-link-btn { display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; margin-top: 6px; }
  .lr-orders-link { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; margin-top: 10px; border: 1.5px solid #E3E8F0; border-radius: 14px; color: #1B2A4A; font-weight: 700; font-size: 0.92rem; text-decoration: none; background: #fff; }
  .lr-rent-link { display: flex; align-items: center; gap: 12px; margin-top: 10px; padding: 12px 14px; border: 1.5px solid #FFD9C7; border-radius: 14px; background: #FFF8F3; text-decoration: none; color: #1B2A4A; }
  .lr-rent-icon { width: 38px; height: 38px; flex: none; border-radius: 12px; background: #FF6B35; color: #fff; display: flex; align-items: center; justify-content: center; }
  .lr-rent-text { flex: 1; display: flex; flex-direction: column; gap: 2px; text-align: left; }
  .lr-rent-text strong { font-size: 0.92rem; font-weight: 800; }
  .lr-rent-text small { font-size: 0.74rem; line-height: 1.4; color: #5B6B86; font-weight: 600; }
  .lr-rent-arrow { color: #9AA8BC; font-size: 0.8rem; }
  .lr-points { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .lr-points li { font-size: 0.8rem; line-height: 1.5; color: #5B6B86; font-weight: 600; display: flex; gap: 8px; }
  .lr-points i { color: #FF6B35; margin-top: 3px; }
  .lr-become-footer { text-align: center; padding: 18px 0 60px; }
  .lr-become-footer a { color: #9AA8BC; font-size: 0.78rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; text-decoration: underline; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  // লগইন করা ড্রাইভার আবেদন করে থাকলে এক লাইনের লেখা বদলায়
  const TEXTS = {
    pending: 'ড্রাইভার আবেদন পর্যালোচনাধীন',
    approved: 'আপনার ড্রাইভার প্রোফাইল',
    rejected: 'আবার ড্রাইভার আবেদন করুন',
  };

  async function showDriverStatus() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      const { data } = await supabase
        .from('local_ride_drivers')
        .select('status')
        .eq('user_id', session.user.id)
        .maybeSingle();
      if (!data || !TEXTS[data.status]) return;
      const t = document.getElementById('lrBecomeText');
      if (t) t.textContent = TEXTS[data.status];
    } catch (_) { /* না দেখালেও পেজ চলবে */ }
  }

  showDriverStatus();
</script>
