---
// path: src/pages/services/local-ride.astro
// ============================================================
// পেজ: /services/local-ride — লোকাল রাইড সেকশন (মেইন অ্যাপ)
// নিজের এলাকার সিএনজি/অটো/অন্য গাড়ির ড্রাইভার ও যাত্রীর রিকোয়েস্ট সিস্টেম।
// এই ধাপে: পরিচিতি + "ড্রাইভার হিসেবে যোগ দিন" (→ /become-a-local-driver) + লগইন করা ড্রাইভারের
// আবেদনের অবস্থা। "রাইড চাই" (যাত্রীর রিকোয়েস্ট ফ্লো) পরের ধাপে যোগ হবে, আপাতত "শীঘ্রই"।
// সার্ভিস কার্ড services.js-এ আপাতত hidden: true; যাত্রীর ফ্লো তৈরি হলে চালু হবে।
// ডিজাইন: delivery v2 টোকেন (#FF6B35, #1B2A4A, #F8FAFC), ট্যাপ ≥ ৪৪px, GuideSheet ⓘ।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import GuideSheet from '../../components/delivery/GuideSheet.astro';

const guideSteps = [
  {
    caption: 'লোকাল রাইডে নিজের এলাকার ড্রাইভাররা যাত্রীর রিকোয়েস্ট পায়',
    blocks: [
      { kind: 'card', title: 'ধলিয়া থেকে ফেনী', lines: ['সিএনজি · ২ জন', 'ভাড়া ৳১২০'], badge: 'নতুন' },
      { kind: 'notice', text: 'যে এলাকা থেকে রওনা, সেই এলাকার ড্রাইভাররা রিকোয়েস্ট দেখে।' },
    ],
  },
  {
    caption: 'ড্রাইভার হতে চাইলে "ড্রাইভার হিসেবে যোগ দিন" চাপুন',
    blocks: [
      { kind: 'button', text: 'ড্রাইভার হিসেবে যোগ দিন', primary: true, tap: true },
      { kind: 'notice', text: 'অ্যাডমিন যাচাই করে অনুমোদন করলে রিকোয়েস্ট পাবেন।' },
    ],
  },
];
---

<BaseLayout title="লোকাল রাইড | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="lr-page">
    <div class="lr-wrap">

      <div class="lr-top">
        <a href="/" class="lr-round" aria-label="হোমে যান"><i class="fas fa-arrow-left"></i></a>
        <h1 class="lr-title">লোকাল রাইড</h1>
        <GuideSheet id="local-ride-home" title="লোকাল রাইড কীভাবে কাজ করে" subtitle="লোকাল রাইড" showButton buttonTone="light" steps={guideSteps} />
      </div>

      <div class="lr-hero">
        <span class="lr-hero-ic"><i class="fas fa-van-shuttle"></i></span>
        <h2>নিজের এলাকার সিএনজি, অটো ও গাড়ি</h2>
        <p>যাত্রী রওনা হওয়ার এলাকার রেজিস্টার্ড ড্রাইভাররা সরাসরি রিকোয়েস্ট পায়। যাত্রীর দেওয়া ভাড়ায় রাজি হলেই ট্রিপ ঠিক।</p>
      </div>

      <a href="/become-a-local-driver" class="lr-card" id="lrDriverCard">
        <span class="lr-ic"><i class="fas fa-id-card-clip"></i></span>
        <span class="lr-txt">
          <b id="lrDriverTitle">ড্রাইভার হিসেবে যোগ দিন</b>
          <small id="lrDriverSub">নিজের এলাকার যাত্রীর রিকোয়েস্ট পান</small>
        </span>
        <span class="lr-chip" id="lrStatus" style="display:none;"></span>
      </a>

      <div class="lr-card lr-soon" aria-disabled="true">
        <span class="lr-ic lr-ic-grey"><i class="fas fa-location-dot"></i></span>
        <span class="lr-txt">
          <b>রাইড চাই</b>
          <small>যাত্রীর রিকোয়েস্ট খুব শীঘ্রই চালু হচ্ছে</small>
        </span>
        <span class="lr-chip lr-chip-grey">শীঘ্রই</span>
      </div>

    </div>
  </div>

  <style is:global>
    .lr-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #F8FAFC; min-height: 70vh; padding: 16px 14px 90px; }
    .lr-wrap { max-width: 520px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
    .lr-top { display: flex; align-items: center; gap: 10px; }
    .lr-round { width: 44px; height: 44px; border-radius: 22px; background: #fff; box-shadow: 0 2px 10px rgba(27,42,74,.18); color: #1B2A4A; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; flex: none; }
    .lr-title { flex: 1; font-size: 19px; font-weight: 700; margin: 0; }
    .lr-hero { background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(27,42,74,.08); padding: 20px 18px; text-align: center; }
    .lr-hero-ic { width: 56px; height: 56px; border-radius: 16px; background: #FFF6F1; color: #FF6B35; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; }
    .lr-hero h2 { margin: 10px 0 6px; font-size: 19px; font-weight: 700; }
    .lr-hero p { margin: 0; font-size: 14.5px; line-height: 1.6; color: #5B6B86; font-weight: 500; }
    .lr-card { display: flex; align-items: center; gap: 14px; background: #fff; border-radius: 20px; box-shadow: 0 2px 12px rgba(27,42,74,.08); padding: 14px 16px; min-height: 68px; color: #1B2A4A; text-decoration: none; }
    .lr-ic { width: 48px; height: 48px; border-radius: 14px; background: #FFF6F1; color: #FF6B35; display: flex; align-items: center; justify-content: center; font-size: 20px; flex: none; }
    .lr-ic-grey { background: #F1F5F9; color: #5B6B86; }
    .lr-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .lr-txt b { font-size: 16.5px; }
    .lr-txt small { font-size: 13px; color: #5B6B86; line-height: 1.4; }
    .lr-chip { border-radius: 999px; padding: 3px 10px; font-size: 12.5px; font-weight: 600; background: #FFF1C9; color: #6B4A00; flex: none; }
    .lr-chip-ok { background: #E8F7EE; color: #14693A; }
    .lr-chip-warn { background: #FFF4E5; color: #7A3E00; }
    .lr-chip-grey { background: #F1F5F9; color: #5B6B86; }
    .lr-soon { opacity: .75; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';

    // লগইন করা ইউজার আগে আবেদন করে থাকলে কার্ডে অবস্থা দেখানো
    const LABELS = {
      pending: { text: 'পর্যালোচনাধীন', cls: 'lr-chip' },
      approved: { text: 'অনুমোদিত', cls: 'lr-chip lr-chip-ok' },
      rejected: { text: 'গ্রহণ হয়নি', cls: 'lr-chip lr-chip-warn' },
    };

    async function showDriverStatus() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;
        const { data } = await supabase
          .from('local_ride_drivers')
          .select('status')
          .eq('user_id', session.user.id)
          .maybeSingle();
        if (!data || !LABELS[data.status]) return;
        const chip = document.getElementById('lrStatus');
        chip.textContent = LABELS[data.status].text;
        chip.className = LABELS[data.status].cls;
        chip.style.display = '';
        if (data.status === 'approved') {
          document.getElementById('lrDriverTitle').textContent = 'আপনার ড্রাইভার প্রোফাইল';
          document.getElementById('lrDriverSub').textContent = 'এরিয়া ও আবেদনের তথ্য দেখুন';
        }
      } catch (_) { /* অবস্থা না দেখালেও পেজ চলবে */ }
    }

    showDriverStatus();
  </script>
</BaseLayout>
