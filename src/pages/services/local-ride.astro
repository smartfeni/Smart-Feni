---
// path: src/pages/services/local-ride.astro
// ============================================================
// পেজ: /services/local-ride — রাইড ও গাড়ি ভাড়া (নতুন ডিজাইন, নভে ২০২৬; Claude Design ক্যানভাস "লোকাল রাইডের প্রথম পেজ")
// দুটো কার্ড (SF সিদ্ধান্ত):
//   • লোকাল রাইড → /ride (আশেপাশের একটিভ চালকদের কাছে রিকোয়েস্ট যায়); চিপে অনলাইন চালকের সংখ্যা
//     (RPC local_ride_online_count — শুধু সংখ্যা)
//   • গাড়ি ভাড়া → /services/car-rental (চালকের নম্বর নিয়ে সরাসরি কল)
// নিচে "কিভাবে কাজ করে" ও "লোকাল ড্রাইভার হতে চান?" (→ /become-a-local-driver; আবেদনের অবস্থায় লেখা বদলায়)।
// "আমার রাইড" কার্ড নেই (SF)। পুরনো /local-ride-request পেজ চালু আছে, এখান থেকে লিংক নেই।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="লোকাল রাইড ও গাড়ি ভাড়া | স্মার্ট ফেনী" description="ফেনীর সিএনজি, অটো, বাইক ও গাড়ি: আশেপাশের চালকদের কাছে রাইড রিকোয়েস্ট পাঠান, অথবা চালকের নম্বর নিয়ে গাড়ি ভাড়া করুন।">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="lrh">
    <div class="lrh-hero">
      <svg class="lrh-hero-bg" viewBox="0 0 390 190" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M-20 150 C 80 110, 160 170, 260 120 S 380 80, 420 110" stroke="#FF6B35" stroke-width="10" fill="none" />
        <path d="M-20 60 L 420 30" stroke="#fff" stroke-width="5" />
        <path d="M250 -10 L 300 200" stroke="#fff" stroke-width="5" />
      </svg>
      <div class="lrh-wrap">
        <h1>রাইড ও গাড়ি ভাড়া</h1>
        <p>ফেনীর সিএনজি, অটো, বাইক আর গাড়ি, এক জায়গায়</p>
      </div>
    </div>

    <div class="lrh-wrap lrh-body">
      <a href="/ride" class="lrh-ride">
        <span class="lrh-ride-top">
          <span>
            <b>লোকাল রাইড</b>
            <small>আশেপাশের একটিভ গাড়ি চালকদের কাছে রিকোয়েস্ট যাবে</small>
          </span>
          <span class="lrh-go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
        </span>
        <span class="lrh-ride-bot">
          <span class="lrh-icons">
            <span><svg viewBox="0 0 34 26" aria-hidden="true"><path d="M5 18V9a6 6 0 0 1 6-6h10l6 7v8H5z" /><path d="M13 3v7h14" /><circle cx="10" cy="20" r="3" /><circle cx="25" cy="20" r="3" /></svg></span>
            <span><svg viewBox="0 0 34 26" aria-hidden="true"><path d="M6 18V8h16l6 6v4H6z" /><path d="M6 8l3-5h10" /><circle cx="11" cy="20" r="3" /><circle cx="24" cy="20" r="3" /></svg></span>
            <span><svg viewBox="0 0 34 26" aria-hidden="true"><circle cx="8" cy="19" r="4" /><circle cx="26" cy="19" r="4" /><path d="M8 19l6-9h7l5 9M14 10l-2-4h-3M21 10l2-4h3" /></svg></span>
          </span>
          <span class="lrh-online" id="lrhOnline" hidden><i></i><span id="lrhOnlineT"></span></span>
        </span>
      </a>

      <a href="/services/car-rental" class="lrh-rent">
        <span class="lrh-rent-ic"><svg viewBox="0 0 34 26" aria-hidden="true"><path d="M3 18V5h20l7 6v7H3z" /><path d="M23 5v6h7M9 5v6M16 5v6" /><circle cx="9" cy="20" r="3" /><circle cx="25" cy="20" r="3" /></svg></span>
        <span class="lrh-rent-t">
          <b>গাড়ি ভাড়া</b>
          <small>গাড়ি চালকের নম্বর নিয়ে সরাসরি কল করুন</small>
          <em>মাইক্রো · কার · পিকআপ · সারাদিন বা দূরের ট্রিপ</em>
        </span>
        <svg class="lrh-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </a>

      <div class="lrh-how">
        <h2>কিভাবে কাজ করে</h2>
        <ol>
          <li><span>১</span>পিকআপ আর গন্তব্য দিন</li>
          <li><span>২</span>ড্রাইভারের অফার বাছুন</li>
          <li><span class="o">৩</span>ড্রাইভার এসে নিয়ে যাবেন</li>
        </ol>
      </div>

      <a href="/become-a-local-driver" class="lrh-driver">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1-4 4-6 8-6s7 2 8 6" /></svg>
        <span>
          <b id="lrBecomeText">লোকাল ড্রাইভার হতে চান?</b>
          <small>নিজের গাড়ি নিয়ে যুক্ত হন, নিজের সময়ে আয় করুন</small>
        </span>
        <em>আবেদন</em>
      </a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .lrh { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 80vh; padding-bottom: 90px; }
  .lrh [hidden] { display: none !important; }
  .lrh-wrap { max-width: 560px; margin: 0 auto; padding: 0 16px; box-sizing: border-box; }
  .lrh-hero { position: relative; overflow: hidden; background: #1B2A4A; color: #fff; padding: 26px 0 70px; }
  .lrh-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .14; }
  .lrh-hero h1 { position: relative; margin: 0 0 4px; font-size: 30px; font-weight: 700; line-height: 1.2; }
  .lrh-hero p { position: relative; margin: 0; font-size: 15px; color: #C9D3E6; }
  .lrh-body { margin-top: -48px; position: relative; display: flex; flex-direction: column; gap: 12px; }
  .lrh-ride { display: flex; flex-direction: column; gap: 14px; background: #FF6B35; color: #fff; border-radius: 24px; padding: 18px; text-decoration: none; box-shadow: 0 10px 26px rgba(255,107,53,.32); }
  .lrh-ride:active, .lrh-rent:active { transform: scale(.985); }
  .lrh-ride-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .lrh-ride-top b { display: block; font-size: 23px; line-height: 1.2; }
  .lrh-ride-top small { display: block; font-size: 14px; color: #FFE6D9; margin-top: 2px; }
  .lrh-go { width: 44px; height: 44px; border-radius: 22px; background: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .lrh-go svg { width: 20px; height: 20px; fill: none; stroke: #FF6B35; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .lrh-ride-bot { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .lrh-icons { display: flex; gap: 8px; }
  .lrh-icons > span { width: 48px; height: 40px; border-radius: 12px; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; }
  .lrh-icons svg { width: 30px; height: 23px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lrh-icons circle { fill: #FF6B35; }
  .lrh-online { display: inline-flex; align-items: center; gap: 6px; background: #fff; color: #17663F; font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 999px; }
  .lrh-online i { width: 8px; height: 8px; border-radius: 4px; background: #16A34A; }
  .lrh-rent { display: flex; align-items: center; gap: 14px; background: #fff; border-radius: 24px; padding: 16px 18px; text-decoration: none; color: #1B2A4A; box-shadow: 0 4px 18px rgba(27,42,74,.07); }
  .lrh-rent-ic { width: 56px; height: 56px; border-radius: 16px; background: #EAF0FA; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .lrh-rent-ic svg { width: 34px; height: 26px; fill: none; stroke: #1B2A4A; stroke-width: 2; stroke-linejoin: round; }
  .lrh-rent-ic svg path:first-child { fill: #D5E0F2; }
  .lrh-rent-ic circle { fill: #fff; }
  .lrh-rent-t { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .lrh-rent-t b { font-size: 19px; }
  .lrh-rent-t small { font-size: 13px; color: #5A6E85; }
  .lrh-rent-t em { font-style: normal; font-size: 12px; font-weight: 700; color: #8FA0BC; margin-top: 2px; }
  .lrh-chev { width: 20px; height: 20px; fill: none; stroke: #8FA0BC; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .lrh-how { background: #fff; border-radius: 20px; padding: 14px 16px; box-shadow: 0 4px 18px rgba(27,42,74,.07); }
  .lrh-how h2 { margin: 0 0 10px; font-size: 14px; font-weight: 700; }
  .lrh-how ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; text-align: center; }
  .lrh-how li { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 12px; color: #5A6E85; line-height: 1.35; }
  .lrh-how li span { width: 34px; height: 34px; border-radius: 17px; background: #1B2A4A; color: #fff; font-weight: 700; font-size: 15px; display: flex; align-items: center; justify-content: center; }
  .lrh-how li span.o { background: #FF6B35; }
  .lrh-driver { display: flex; align-items: center; gap: 12px; margin-top: 8px; border: 1.5px dashed #FFB48F; border-radius: 18px; padding: 12px 16px; text-decoration: none; color: #1B2A4A; background: rgba(255,255,255,.6); }
  .lrh-driver > svg { width: 26px; height: 26px; fill: none; stroke: #FF6B35; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .lrh-driver > span { flex: 1; display: flex; flex-direction: column; }
  .lrh-driver b { font-size: 15px; }
  .lrh-driver small { font-size: 12px; color: #5A6E85; }
  .lrh-driver em { font-style: normal; font-size: 14px; font-weight: 700; color: #FF6B35; }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const BN = '০১২৩৪৫৬৭৮৯';
  const bn = (n) => String(n).replace(/\d/g, (d) => BN[d]);

  // অনলাইন চালকের সংখ্যা (০ হলে চিপ দেখায় না)
  async function showOnline() {
    try {
      const { data, error } = await supabase.rpc('local_ride_online_count');
      const n = Number(data);
      if (error || !n) return;
      document.getElementById('lrhOnlineT').textContent = bn(n) + ' জন অনলাইন';
      document.getElementById('lrhOnline').hidden = false;
    } catch (_) { /* না দেখালেও চলবে */ }
  }

  // লগইন করা ড্রাইভার আবেদন করে থাকলে লেখা বদলায়
  const TEXTS = {
    pending: 'ড্রাইভার আবেদন পর্যালোচনাধীন',
    approved: 'আপনার ড্রাইভার প্রোফাইল',
    rejected: 'আবার ড্রাইভার আবেদন করুন',
  };
  async function showDriverStatus() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      const { data } = await supabase.from('local_ride_drivers').select('status').eq('user_id', session.user.id).maybeSingle();
      if (!data || !TEXTS[data.status]) return;
      const t = document.getElementById('lrBecomeText');
      if (t) t.textContent = TEXTS[data.status];
    } catch (_) { /* না দেখালেও পেজ চলবে */ }
  }

  showOnline();
  showDriverStatus();
</script>
