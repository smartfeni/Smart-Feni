---
// ============================================================
// পেজ: টিউশন সার্ভিস
// ব্র্যান্ড: স্মার্ট ফেনী
// আপডেট: কার্ডে ট্যাপ করলে এখন আর মডাল খোলে না — সরাসরি শেয়ারেবল
// ফুল-পেজে (/listing/[id]) নিয়ে যায়। ListingDetailModal সরানো হলো।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import AddListingModal from '../../components/ui/AddListingModal.astro';
import { supabase } from '../../lib/supabase.js';

const typeOptions = [
  { id: 'tutor', label: 'টিউটর সার্ভিস দিচ্ছি' },
  { id: 'student', label: 'টিউটর প্রয়োজন' },
];

const typeNameMap = Object.fromEntries(typeOptions.map((t) => [t.id, t.label]));

const typeIcons = {
  tutor: 'fa-chalkboard-user',
  student: 'fa-graduation-cap',
};

const { data: tuitionListings } = await supabase
  .from('listings')
  .select('*')
  .eq('category', 'tuition')
  .eq('status', 'active')
  .order('created_at', { ascending: false });

const listings = tuitionListings || [];
---

<BaseLayout title="টিউশন খুঁজুন | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <span class="section-tag"><i class="fas fa-book-open"></i> টিউশন সার্ভিস</span>
      <h1>ফেনীতে <span class="accent">টিউশন</span> খুঁজুন</h1>
      <p>নিজে পড়াতে চান, নাকি সন্তানের জন্য টিউটর খুঁজছেন? দুটোই এক জায়গায়</p>

      <div class="cta-row">
        <button class="cta-box" id="openTutorCta" type="button">
          <i class="fas fa-chalkboard-user"></i> আমি পড়াতে চাই
        </button>
        <button class="cta-box cta-box-alt" id="openStudentCta" type="button">
          <i class="fas fa-graduation-cap"></i> আমার টিউটর দরকার
        </button>
      </div>
    </div>
  </section>

  <section class="tuition-section">
    <div class="container">
      <div class="search-box">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="বিষয়, ক্লাস বা এলাকা খুঁজুন..." />
      </div>

      {listings.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-book"></i>
          <p>এখনো কোনো টিউশন লিস্টিং যোগ হয়নি</p>
          <span>প্রথম লিস্টিং যোগ করুন উপরের বাটনে ক্লিক করে</span>
        </div>
      ) : (
        <>
          <div class="tuition-grid" id="tuitionGrid">
            {listings.map((item) => (
              <a
                href={`/listing/${item.id}`}
                class="tuition-card"
                data-upazila-name={item.upazila || ''}
                data-search={`${item.title || ''} ${item.description || ''} ${typeNameMap[item.type] || ''}`.toLowerCase()}
              >
                {item.images && item.images.length > 0 ? (
                  <img src={item.images[0]} alt={item.title} class="tuition-photo" />
                ) : (
                  <div class={`tuition-icon icon-${item.type}`}>
                    <i class={`fas ${typeIcons[item.type] || 'fa-book'}`}></i>
                  </div>
                )}

                <div class="tuition-card-body">
                  <span class={`type-badge type-${item.type}`}>{typeNameMap[item.type] || item.type}</span>
                  <h3 class="tuition-title">{item.title}</h3>
                  {item.price && <p class="tuition-price">{item.price}</p>}
                  <p class="location-tag"><i class="fas fa-location-dot"></i> {item.upazila}</p>
                </div>
              </a>
            ))}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </section>

  <AddListingModal
    category="tuition"
    typeOptions={typeOptions}
    titleLabel="বিষয় ও ক্লাস (যেমন: গণিত, ক্লাস ৯-১০)"
    priceLabel="রেট / বাজেট (মাসিক)"
  />
</BaseLayout>

<style>
  .page-header {
    padding: 60px 0 30px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 12px 0 8px;
  }

  .page-header .accent {
    color: #FF6B35;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    margin-bottom: 24px;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFF0EA;
    border: 1.5px solid #FFD3BC;
    color: #FF6B35;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 26px;
    border-radius: 40px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cta-box:hover {
    background: #FF6B35;
    color: #fff;
    border-color: #FF6B35;
    transform: translateY(-2px);
  }

  .cta-box-alt {
    background: #F3EBFF;
    border-color: #DCC5FA;
    color: #7C3AED;
  }

  .cta-box-alt:hover {
    background: #7C3AED;
    color: #fff;
    border-color: #7C3AED;
  }

  .tuition-section {
    padding: 30px 0 70px;
    background: #F8FAFC;
  }

  .search-box {
    max-width: 480px;
    margin: 0 auto 32px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    border-radius: 40px;
    padding: 12px 20px;
  }

  .search-box i {
    color: #A0AFC0;
  }

  .search-box input {
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.9rem;
    font-family: inherit;
    background: transparent;
    color: #1B2A4A;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .empty-state span {
    color: #8FA0BC;
    font-size: 0.85rem;
  }

  .tuition-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  .tuition-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    padding: 0;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    font-family: inherit;
    text-decoration: none;
    display: block;
  }

  .tuition-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .tuition-card.hidden {
    display: none;
  }

  .tuition-icon {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }

  .tuition-icon.icon-student {
    background: #F3EBFF;
    color: #7C3AED;
  }

  .tuition-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .tuition-card-body {
    padding: 14px;
  }

  .type-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 6px;
    background: #F4F7FC;
    color: #5A6E85;
  }

  .type-tutor {
    background: rgba(255, 107, 53, 0.12);
    color: #FF6B35;
  }

  .type-student {
    background: rgba(124, 58, 237, 0.12);
    color: #7C3AED;
  }

  .tuition-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tuition-price {
    font-size: 0.88rem;
    font-weight: 700;
    color: #FF6B35;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location-tag {
    font-size: 0.72rem;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .no-results {
    text-align: center;
    color: #A0AFC0;
    font-size: 0.95rem;
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.7rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { reorderByUserLocation } from '../../lib/locationSort.js';

  const grid = document.getElementById('tuitionGrid');
  const cards = document.querySelectorAll('.tuition-card');
  const searchInput = document.getElementById('searchInput');
  const noResults = document.getElementById('noResults');

  searchInput?.addEventListener('input', () => {
    const keyword = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = keyword === '' || (card.dataset.search || '').includes(keyword);
      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  });

  reorderByUserLocation(grid, 'upazilaName');

  // ২টা CTA: লগইন থাকলে সরাসরি লিস্টিং মোডাল (প্রিসেট টাইপসহ), না থাকলে লগইন মোডাল
  async function openWithPreset(presetType) {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.openListingModal?.(presetType);
    } else {
      window.openAuthModal?.('login');
    }
  }

  document.getElementById('openTutorCta')?.addEventListener('click', () => openWithPreset('tutor'));
  document.getElementById('openStudentCta')?.addEventListener('click', () => openWithPreset('student'));
</script>