---
// ============================================================
// পেজ: টিউশন সার্ভিস
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — CTA ক্লিনআপ + গ্যাপ ফিক্স): section-tag badge
// রিমুভ, dashed CTA বক্সের বদলে সিম্পল ক্লিকযোগ্য ইনলাইন টেক্সট
// লাইন (ক্যাটাগরি কালার সায়ান #00B8D9) — ক্লিক করলে সরাসরি
// AddListingModal খুলবে। header/section প্যাডিং টাইট করা হলো।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import AddListingModal from '../../components/ui/AddListingModal.astro';
import { supabase } from '../../lib/supabase.js';

const typeOptions = [
  { id: 'tutor', label: 'টিউটর সার্ভিস দিচ্ছি' },
  { id: 'student', label: 'টিউটর প্রয়োজন' },
];

const typeNameMap = Object.fromEntries(typeOptions.map((t) => [t.id, t.label]));

const typeIcons = {
  tutor: 'fa-chalkboard-user',
  student: 'fa-graduation-cap',
};

const { data: tuitionListings } = await supabase
  .from('listings')
  .select('*')
  .eq('category', 'tuition')
  .eq('status', 'active')
  .order('created_at', { ascending: false });

const listings = tuitionListings || [];
---

<BaseLayout title="টিউশন খুঁজুন | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <h1>ফেনীতে <span class="accent">টিউশন</span> খুঁজুন</h1>
      <p>নিজে পড়াতে চান, নাকি সন্তানের জন্য টিউটর খুঁজছেন? দুটোই এক জায়গায়</p>

      <button type="button" class="page-cta-link" id="pageCtaBtn">
        <i class="fas fa-circle-info"></i> পড়াতে চাইলে বা টিউটর দরকার হলে নিচের <strong>"পোস্ট"</strong> বাটনে ট্যাপ করুন
      </button>
    </div>
  </section>

  <section class="tuition-section">
    <div class="container">
      <div class="search-box">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="বিষয়, ক্লাস বা এলাকা খুঁজুন..." />
      </div>

      {listings.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-book"></i>
          <p>এখনো কোনো টিউশন লিস্টিং যোগ হয়নি</p>
          <span>প্রথম লিস্টিং যোগ করুন "পোস্ট" বাটনে ট্যাপ করে</span>
        </div>
      ) : (
        <>
          <div class="tuition-grid" id="tuitionGrid">
            {listings.map((item) => (
              <a
                href={`/listing/${item.id}`}
                class="tuition-card"
                data-upazila-name={item.upazila || ''}
                data-search={`${item.title || ''} ${item.description || ''} ${typeNameMap[item.type] || ''}`.toLowerCase()}
              >
                {item.images && item.images.length > 0 ? (
                  <img src={item.images[0]} alt={item.title} class="tuition-photo" />
                ) : (
                  <div class={`tuition-icon icon-${item.type}`}>
                    <i class={`fas ${typeIcons[item.type] || 'fa-book'}`}></i>
                  </div>
                )}

                <div class="tuition-card-body">
                  <span class={`type-badge type-${item.type}`}>{typeNameMap[item.type] || item.type}</span>
                  <h3 class="tuition-title">{item.title}</h3>
                  {item.price && <p class="tuition-price">{item.price}</p>}
                  <p class="location-tag"><i class="fas fa-location-dot"></i> {item.upazila}</p>
                </div>
              </a>
            ))}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </section>

  <AddListingModal
    category="tuition"
    typeOptions={typeOptions}
    titleLabel="বিষয় ও ক্লাস (যেমন: গণিত, ক্লাস ৯-১০)"
    priceLabel="রেট / বাজেট (মাসিক)"
  />
</BaseLayout>

<style>
  .page-header {
    padding: 44px 0 20px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header .accent {
    color: #00B8D9;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .page-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #00B8D9;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 4px 0;
    font-family: inherit;
    cursor: pointer;
  }

  .page-cta-link:hover {
    opacity: 0.8;
  }

  .page-cta-link strong {
    font-weight: 800;
  }

  .tuition-section {
    padding: 18px 0 70px;
    background: #F8FAFC;
  }

  .search-box {
    max-width: 480px;
    margin: 0 auto 32px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    border-radius: 40px;
    padding: 12px 20px;
  }

  .search-box i {
    color: #A0AFC0;
  }

  .search-box input {
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.9rem;
    font-family: inherit;
    background: transparent;
    color: #1B2A4A;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .empty-state span {
    color: #8FA0BC;
    font-size: 0.85rem;
  }

  .tuition-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  .tuition-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    padding: 0;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    font-family: inherit;
    text-decoration: none;
    display: block;
  }

  .tuition-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .tuition-card.hidden {
    display: none;
  }

  .tuition-icon {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }

  .tuition-icon.icon-student {
    background: #F3EBFF;
    color: #7C3AED;
  }

  .tuition-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .tuition-card-body {
    padding: 14px;
  }

  .type-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 6px;
    background: #F4F7FC;
    color: #5A6E85;
  }

  .type-tutor {
    background: rgba(255, 107, 53, 0.12);
    color: #FF6B35;
  }

  .type-student {
    background: rgba(124, 58, 237, 0.12);
    color: #7C3AED;
  }

  .tuition-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tuition-price {
    font-size: 0.88rem;
    font-weight: 700;
    color: #FF6B35;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location-tag {
    font-size: 0.72rem;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .no-results {
    text-align: center;
    color: #A0AFC0;
    font-size: 0.95rem;
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.7rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { reorderByUserLocation } from '../../lib/locationSort.js';

  const grid = document.getElementById('tuitionGrid');
  const cards = document.querySelectorAll('.tuition-card');
  const searchInput = document.getElementById('searchInput');
  const noResults = document.getElementById('noResults');

  searchInput?.addEventListener('input', () => {
    const keyword = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = keyword === '' || (card.dataset.search || '').includes(keyword);
      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  });

  reorderByUserLocation(grid, 'upazilaName');

  // ============================================================
  // ➕পোস্ট ফ্লো — শেয়ার্ড ফাংশন: লগইন থাকলে সরাসরি লিস্টিং মোডাল
  // খুলবে (আগের ২টা প্রিসেট CTA বাটন সরানো হয়েছে — ইউজার এখন
  // মোডালের ভেতরের ড্রপডাউন থেকে "টিউটর সার্ভিস দিচ্ছি" নাকি
  // "টিউটর প্রয়োজন" নিজে বেছে নেবে)। ২ জায়গা থেকে কল হয়: URL এ
  // ?openListing=1 থাকলে, অথবা হেডারের ইনলাইন CTA লাইনে ক্লিক করলে
  // ============================================================
  async function triggerOpenListing() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.openListingModal?.();
    } else {
      window.openAuthModal?.('login');
    }
  }

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('openListing') === '1') {
    setTimeout(async () => {
      await triggerOpenListing();
      window.history.replaceState({}, '', window.location.pathname);
    }, 150);
  }

  document.getElementById('pageCtaBtn')?.addEventListener('click', () => {
    triggerOpenListing();
  });
</script>