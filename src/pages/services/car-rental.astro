---
// ============================================================
// পেজ: গাড়ি ভাড়া সার্ভিস
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — CTA ক্লিনআপ + গ্যাপ ফিক্স): section-tag badge
// রিমুভ, dashed CTA বক্সের বদলে সিম্পল ক্লিকযোগ্য ইনলাইন টেক্সট
// লাইন — ক্লিক করলে সরাসরি AddListingModal খুলবে। header/section
// প্যাডিং টাইট করা হলো, লম্বা description-এর max-width রাখা হলো।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import ServiceSeoBlock from '../../components/shared/ServiceSeoBlock.astro';
import AddListingModal from '../../components/ui/AddListingModal.astro';
import { UPAZILAS, getUnionsOfUpazilaName } from '../../data/feniAreas.js';
import { supabase } from '../../lib/supabase.js';
import Pagination from '../../components/shared/Pagination.astro';
import { readListingParams, fetchListingPage, fetchTypeCounts } from '../../lib/listingQuery.js';

const typeOptions = [
  { id: 'cng', label: 'সিএনজি' },
  { id: 'auto-rickshaw', label: 'অটো রিক্সা' },
  { id: 'ambulance', label: 'অ্যাম্বুলেন্স' },
  { id: 'pickup', label: 'পিকআপ ভ্যান' },
  { id: 'car', label: 'কার' },
  { id: 'microbus', label: 'মাইক্রোবাস' },
  { id: 'truck', label: 'ট্রাক' },
  { id: 'other', label: 'অন্যান্য' },
];

const typeDefaultImages = {
  // ছোট WebP (~১৪KB; আগে ~৭৮০KB PNG) — ধীর নেটে কার্ড লোড দ্রুত। ছবি না থাকা ধরনগুলোর জন্য ছোট জেনেরিক SVG।
  cng: '/images/car-types/cng-default.webp',
  car: '/images/car-types/car.svg',
  pickup: '/images/car-types/pickup.svg',
  truck: '/images/car-types/truck.svg',
  microbus: '/images/car-types/microbus.svg',
  'auto-rickshaw': '/images/car-types/auto-rickshaw-default.webp',
  ambulance: '/images/car-types/ambulance.svg',
  other: '/images/car-types/other.svg',
};

// এই ধরনগুলোর কার্ডে আসল ছবির বদলে ছোট SVG আইকন (পেজ হালকা, egress কম)।
// সিএনজি ও অটো রিক্সা আগের মতো (লিস্টিং ছবি/ডিফল্ট ছবি)। আসল ছবি লিস্টিং পেজে দেখা যায়।
const iconTypes = new Set(['ambulance', 'pickup', 'car', 'microbus', 'truck', 'other']);

// পেজিনেশন (২০টা করে) — src/lib/listingQuery.js
// সার্চ, ধরন, উপজেলা, ইউনিয়ন এখন URL প্যারামিটারে (?q= ?type= ?upazila= ?union= ?page=)
const params = readListingParams(Astro);
const sp = Astro.url.searchParams;
const validUpazila = UPAZILAS.some((u) => u.name === sp.get('upazila')) ? sp.get('upazila') : '';
const unionOptions = validUpazila ? getUnionsOfUpazilaName(validUpazila) : [];
const validUnion = unionOptions.includes(sp.get('union') || '') ? sp.get('union') : '';
const knownTypes = typeOptions.map((t) => t.id);
const [result, counts] = await Promise.all([
  fetchListingPage(supabase, {
    category: 'car-rental',
    columns: 'id,title,type,price,upazila,union_name,images,description,created_at',
    knownTypes,
    eq: { upazila: validUpazila, union_name: validUnion },
    searchCols: ['title', 'description', 'upazila', 'union_name'],
    ...params,
  }),
  fetchTypeCounts(supabase, 'car-rental', knownTypes),
]);

const listings = result.rows;
const activeType = params.type || 'all';
const hasFilter = !!(params.q || params.type || validUpazila);
function filterHref(type) {
  const u = new URLSearchParams();
  if (type && type !== 'all') u.set('type', type);
  if (params.q) u.set('q', params.q);
  if (validUpazila) u.set('upazila', validUpazila);
  if (validUnion) u.set('union', validUnion);
  return `?${u.toString()}#listings`;
}

function getAreaName(description) {
  if (!description) return '';
  return description.split(',')[0].trim();
}

function toBanglaDigits(num) {
  const banglaDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
  return String(num).split('').map((d) => banglaDigits[d] ?? d).join('');
}

const typeCounts = {};
typeOptions.forEach((opt) => {
  typeCounts[opt.id] = counts.byType[opt.id] || 0;
});
const totalCount = counts.all;
---

<BaseLayout
  title="ফেনীতে গাড়ি ভাড়া — মাইক্রোবাস, কার, পিকআপ, সিএনজি | স্মার্ট ফেনী"
  description="ফেনীতে সিএনজি, কার, মাইক্রোবাস, পিকআপ, ট্রাক ও অ্যাম্বুলেন্স ভাড়া। উপজেলা অনুযায়ী ড্রাইভার খুঁজুন, সরাসরি ফোনে ভাড়া ঠিক করুন।"
>
  <section class="page-header">
    <div class="container">
      <a href="/services/local-ride" class="back-to-ride"><i class="fas fa-arrow-left"></i> লোকাল রাইড</a>
      <h1>ফেনীর <span class="accent">গাড়ি ভাড়া</span> সার্ভিস</h1>
      <p>সিএনজি, কার, পিকআপ ভ্যান, ট্রাক, অটো রিক্সা, অ্যাম্বুলেন্স — যেকোনো ধরনের গাড়ি সার্ভিস এক জায়গায়। সরাসরি ড্রাইভারের সাথে কল করে ভাড়া ঠিক করুন।</p>
      <button type="button" class="page-cta-link" id="pageCtaBtn">
        <i class="fas fa-circle-info"></i> আপনি ড্রাইভার/গাড়ি মালিক হলে নিচের <strong>"পোস্ট"</strong> বাটনে ট্যাপ করে লিস্টিং দিন
      </button>
    </div>
  </section>

  <section class="car-section" id="listings">
    <div class="container">
      <form id="carFilterForm" method="get" action="#listings" role="search">
        <div class="search-box">
          <i class="fas fa-magnifying-glass"></i>
          <input type="search" name="q" id="searchInput" value={params.q} enterkeyhint="search" placeholder="আপনার এলাকার নাম লিখে ড্রাইভার খুঁজুন..." />
        </div>
        {params.type && <input type="hidden" name="type" value={params.type} />}

        <div class="loc-filter-row">
          <select id="upazilaFilter" name="upazila" class="loc-select" aria-label="উপজেলা">
            <option value="">সব উপজেলা</option>
            {UPAZILAS.map((u) => (
              <option value={u.name} selected={u.name === validUpazila}>{u.name}</option>
            ))}
          </select>
          <select id="unionFilter" name="union" class="loc-select" aria-label="ইউনিয়ন" disabled={!validUpazila}>
            <option value="">সব ইউনিয়ন</option>
            {unionOptions.map((n) => (
              <option value={n} selected={n === validUnion}>{n}</option>
            ))}
          </select>
        </div>
      </form>

      <div class="filter-row" id="filterRow">
        <a class={`filter-pill${activeType === 'all' ? ' active' : ''}`} href={filterHref('all')} style="text-decoration:none;">
          সব <span class="pill-count">({toBanglaDigits(totalCount)})</span>
        </a>
        {typeOptions.map((opt) => (
          <a class={`filter-pill${activeType === opt.id ? ' active' : ''}`} href={filterHref(opt.id)} style="text-decoration:none;">
            {opt.label} <span class="pill-count">({toBanglaDigits(typeCounts[opt.id])})</span>
          </a>
        ))}
      </div>

      {listings.length === 0 && hasFilter ? (
        <p class="no-results" id="noResults">কোনো ফলাফল পাওয়া যায়নি</p>
      ) : listings.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-car-side"></i>
          <p>এখনো কোনো গাড়ি ভাড়া লিস্টিং যোগ হয়নি</p>
          <span>প্রথম লিস্টিং যোগ করুন "পোস্ট" বাটনে ট্যাপ করে</span>
        </div>
      ) : (
        <>
          <div class="car-grid" id="carGrid">
            {listings.map((item) => {
              const useIcon = !item.type || iconTypes.has(item.type);
              const hasImage = !useIcon && item.images && item.images.length > 0;
              const fallbackSrc = typeDefaultImages[item.type] || typeDefaultImages.other;
              const areaName = getAreaName(item.description);
              return (
                <a
                  href={`/listing/${item.id}`}
                  class="car-card"
                  data-type={item.type || 'other'}
                  data-target-id={item.id}
                  data-upazila-name={item.upazila || ''}
                  data-union-name={item.union_name || ''}
                >
                  <button class="like-btn-preview" type="button" data-like-btn aria-label="লাইক করুন" style="display:none;">
                    <i class="fas fa-heart"></i>
                    <span data-like-count>0</span>
                  </button>
                  <span class="like-count-preview-view" data-like-count-view>
                    <i class="fas fa-heart"></i>
                    <span data-like-count>0</span>
                  </span>

                  <img
                    src={hasImage ? item.images[0] : fallbackSrc}
                    alt={item.title}
                    class={hasImage ? 'car-photo' : 'car-photo car-photo-default'}
                    loading="lazy"
                  />

                  <div class="car-card-body">
                    <h3 class="car-title">{item.title}</h3>
                    {areaName && <p class="car-area">{areaName}</p>}
                    {item.price && <p class="car-price">{item.price}</p>}
                    <p class="location-tag"><i class="fas fa-location-dot"></i> {item.upazila}{item.union_name ? `, ${item.union_name}` : ''}</p>
                  </div>
                </a>
              );
            })}
          </div>

          <Pagination page={result.page} pages={result.pages} anchor="listings" />
        </>
      )}
    </div>
  </section>

  <AddListingModal
    category="car-rental"
    showUnion={true}
    typeOptions={typeOptions}
    titleLabel="আপনার নাম / গাড়ির নাম"
    priceLabel="গাড়ির ধরন/মডেল"
  />
  <ServiceSeoBlock slug="car-rental" />
</BaseLayout>

