---
// ============================================================
// পেজ: গাড়ি ভাড়া সার্ভিস
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — ➕পোস্ট ফ্লো): URL এ ?openListing=1 থাকলে পেজ লোড
// হওয়া মাত্র AddListingModal অটোমেটিক খুলে যাবে
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import AddListingModal from '../../components/ui/AddListingModal.astro';
import { supabase } from '../../lib/supabase.js';

const typeOptions = [
  { id: 'cng', label: 'সিএনজি' },
  { id: 'auto-rickshaw', label: 'অটো রিক্সা' },
  { id: 'ambulance', label: 'অ্যাম্বুলেন্স' },
  { id: 'pickup', label: 'পিকআপ ভ্যান' },
  { id: 'car', label: 'কার' },
  { id: 'microbus', label: 'মাইক্রোবাস' },
  { id: 'truck', label: 'ট্রাক' },
  { id: 'other', label: 'অন্যান্য' },
];

const typeDefaultImages = {
  cng: '/images/car-types/cng-default.png',
  car: '/images/car-types/car-default.png',
  pickup: '/images/car-types/pickup-default.png',
  truck: '/images/car-types/truck-default.png',
  microbus: '/images/car-types/microbus-default.png',
  'auto-rickshaw': '/images/car-types/auto-rickshaw-default.png',
  ambulance: '/images/car-types/ambulance-default.png',
  other: '/images/car-types/other-default.png',
};

const { data: carListings } = await supabase
  .from('listings')
  .select('*')
  .eq('category', 'car-rental')
  .eq('status', 'active')
  .order('created_at', { ascending: false });

const listings = carListings || [];

function getAreaName(description) {
  if (!description) return '';
  return description.split(',')[0].trim();
}

function toBanglaDigits(num) {
  const banglaDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
  return String(num).split('').map((d) => banglaDigits[d] ?? d).join('');
}

const typeCounts = {};
typeOptions.forEach((opt) => {
  typeCounts[opt.id] = listings.filter((item) => (item.type || 'other') === opt.id).length;
});
const totalCount = listings.length;
---

<BaseLayout title="গাড়ি ভাড়া সার্ভিস | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <span class="section-tag"><i class="fas fa-car"></i> গাড়ি ভাড়া সার্ভিস</span>
      <h1>ফেনীর <span class="accent">গাড়ি ভাড়া</span> সার্ভিস</h1>
      <p>সিএনজি, কার, পিকআপ ভ্যান, ট্রাক, অটো রিক্সা, অ্যাম্বুলেন্স — যেকোনো ধরনের গাড়ি সার্ভিস এক জায়গায়। সরাসরি ড্রাইভারের সাথে কল করে ভাড়া ঠিক করুন।</p>
      <button class="cta-box" id="openCarCta" type="button">
        <i class="fas fa-plus"></i> আমি ড্রাইভার/গাড়ি মালিক, লিস্টিং দিতে চাই
      </button>
    </div>
  </section>

  <section class="car-section">
    <div class="container">
      <div class="search-box">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="আপনার এলাকার নাম লিখে ড্রাইভার খুঁজুন..." />
      </div>

      <div class="filter-row" id="filterRow">
        <button class="filter-pill active" data-type="all" type="button">
          সব <span class="pill-count">({toBanglaDigits(totalCount)})</span>
        </button>
        {typeOptions.map((opt) => (
          <button class="filter-pill" data-type={opt.id} type="button">
            {opt.label} <span class="pill-count">({toBanglaDigits(typeCounts[opt.id])})</span>
          </button>
        ))}
      </div>

      {listings.length === 0 ? (
        <div class="empty-state">
          <i class="fas fa-car-side"></i>
          <p>এখনো কোনো গাড়ি ভাড়া লিস্টিং যোগ হয়নি</p>
          <span>প্রথম লিস্টিং যোগ করুন উপরের বাটনে ক্লিক করে</span>
        </div>
      ) : (
        <>
          <div class="car-grid" id="carGrid">
            {listings.map((item) => {
              const hasImage = item.images && item.images.length > 0;
              const fallbackSrc = typeDefaultImages[item.type] || typeDefaultImages.other;
              const areaName = getAreaName(item.description);
              return (
                <a
                  href={`/listing/${item.id}`}
                  class="car-card"
                  data-type={item.type || 'other'}
                  data-target-id={item.id}
                  data-upazila-name={item.upazila || ''}
                  data-search={`${item.title || ''} ${item.description || ''} ${item.upazila || ''}`.toLowerCase()}
                >
                  <button class="like-btn-preview" type="button" data-like-btn aria-label="লাইক করুন" style="display:none;">
                    <i class="fas fa-heart"></i>
                    <span data-like-count>0</span>
                  </button>
                  <span class="like-count-preview-view" data-like-count-view>
                    <i class="fas fa-heart"></i>
                    <span data-like-count>0</span>
                  </span>

                  <img
                    src={hasImage ? item.images[0] : fallbackSrc}
                    alt={item.title}
                    class={hasImage ? 'car-photo' : 'car-photo car-photo-default'}
                    loading="lazy"
                  />

                  <div class="car-card-body">
                    <h3 class="car-title">{item.title}</h3>
                    {areaName && <p class="car-area">{areaName}</p>}
                    {item.price && <p class="car-price">{item.price}</p>}
                    <p class="location-tag"><i class="fas fa-location-dot"></i> {item.upazila}</p>
                  </div>
                </a>
              );
            })}
          </div>

          <p class="no-results" id="noResults" style="display:none;">কোনো ফলাফল পাওয়া যায়নি</p>
        </>
      )}
    </div>
  </section>

  <AddListingModal
    category="car-rental"
    typeOptions={typeOptions}
    titleLabel="আপনার নাম / গাড়ির নাম"
    priceLabel="গাড়ির ধরন/মডেল"
  />
</BaseLayout>

<style>
  .page-header {
    padding: 60px 0 30px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 12px 0 8px;
  }

  .page-header .accent {
    color: #FF6B35;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto 20px;
  }

  .cta-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFF0EA;
    border: 1.5px solid #FFD3BC;
    color: #FF6B35;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 26px;
    border-radius: 40px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cta-box:hover {
    background: #FF6B35;
    color: #fff;
    border-color: #FF6B35;
    transform: translateY(-2px);
  }

  .car-section {
    padding: 30px 0 70px;
    background: #F8FAFC;
  }

  .search-box {
    max-width: 480px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #EEF3F9;
    border-radius: 40px;
    padding: 12px 20px;
  }

  .search-box i {
    color: #A0AFC0;
  }

  .search-box input {
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.9rem;
    font-family: inherit;
    background: transparent;
    color: #1B2A4A;
  }

  .filter-row {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 8px;
    margin-bottom: 28px;
    padding: 2px 4px 10px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .filter-row::-webkit-scrollbar {
    display: none;
  }

  .filter-pill {
    flex-shrink: 0;
    white-space: nowrap;
    background: #fff;
    border: 1.5px solid #EEF3F9;
    color: #5A6E85;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 30px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    border-color: #FFD3BC;
    color: #FF6B35;
  }

  .filter-pill.active {
    background: #FF6B35;
    border-color: #FF6B35;
    color: #fff;
  }

  .pill-count {
    font-size: 0.78rem;
    opacity: 0.75;
    margin-left: 2px;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 4px;
  }

  .empty-state span {
    color: #8FA0BC;
    font-size: 0.85rem;
  }

  .car-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  .car-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #EEF3F9;
    padding: 0;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
    font-family: inherit;
    text-decoration: none;
    display: block;
    position: relative;
  }

  .car-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .car-card.hidden {
    display: none;
  }

  .like-btn-preview,
  .like-count-preview-view {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    color: #8FA0BC;
  }

  .like-btn-preview {
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .like-btn-preview.liked {
    color: #FF6B35;
  }

  .like-btn-preview.liked i {
    color: #FF6B35;
  }

  .car-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
    background: #F4F7FC;
  }

  .car-photo-default {
    object-fit: contain;
    padding: 16px;
  }

  .car-card-body {
    padding: 14px;
  }

  .car-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .car-area {
    font-size: 0.78rem;
    font-weight: 600;
    color: #FF6B35;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .car-price {
    font-size: 0.85rem;
    font-weight: 600;
    color: #FF6B35;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .location-tag {
    font-size: 0.72rem;
    color: #8FA0BC;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .no-results {
    text-align: center;
    color: #A0AFC0;
    font-size: 0.95rem;
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.7rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { reorderByUserLocation } from '../../lib/locationSort.js';
  import { fetchLikeData, toggleLike, isLoggedIn } from '../../lib/contentEngagement.js';

  const grid = document.getElementById('carGrid');
  const cards = document.querySelectorAll('.car-card');
  const searchInput = document.getElementById('searchInput');
  const noResults = document.getElementById('noResults');
  const filterPills = document.querySelectorAll('.filter-pill');

  let activeType = 'all';

  function applyFilters() {
    const keyword = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesType = activeType === 'all' || card.dataset.type === activeType;
      const matchesSearch = keyword === '' || (card.dataset.search || '').includes(keyword);
      const matches = matchesType && matchesSearch;

      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', applyFilters);

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      activeType = pill.dataset.type;
      applyFilters();
    });
  });

  reorderByUserLocation(grid, 'upazilaName');

  // ============================================================
  // প্রিভিউ কার্ডে লাইক (লগইন-গেটেড, ভিউ-অনলি/ইন্টারঅ্যাকটিভ)
  // ============================================================
  let boundLikeButtons = new WeakSet();

  async function renderPreviewLikes() {
    const loggedIn = await isLoggedIn();
    const ids = Array.from(cards).map((c) => c.dataset.targetId).filter(Boolean);
    const { counts, likedByMe } = await fetchLikeData('listing', ids);

    cards.forEach((card) => {
      const id = card.dataset.targetId;
      if (!id) return;

      const count = counts[id] || 0;
      const liked = likedByMe.has(id);

      const viewEl = card.querySelector('[data-like-count-view]');
      const btnEl = card.querySelector('[data-like-btn]');

      viewEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = count));
      btnEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = count));
      btnEl.classList.toggle('liked', liked);

      if (loggedIn) {
        viewEl.style.display = 'none';
        btnEl.style.display = 'flex';

        if (!boundLikeButtons.has(btnEl)) {
          boundLikeButtons.add(btnEl);

          btnEl.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            btnEl.disabled = true;
            const result = await toggleLike('listing', id);
            btnEl.disabled = false;
            if (result.error) return;
            const currentCount = parseInt(btnEl.querySelector('[data-like-count]').textContent, 10) || 0;
            const newCount = result.liked ? currentCount + 1 : Math.max(currentCount - 1, 0);
            btnEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = newCount));
            viewEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = newCount));
            btnEl.classList.toggle('liked', result.liked);
          });
        }
      } else {
        viewEl.style.display = 'flex';
        btnEl.style.display = 'none';
      }
    });
  }

  renderPreviewLikes();
  window.addEventListener('smartfeni:auth-changed', () => {
    renderPreviewLikes();
  });

  // CTA: লগইন থাকলে লিস্টিং মোডাল, না থাকলে আগে লগইন মোডাল
  document.getElementById('openCarCta')?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.openListingModal?.();
    } else {
      window.openAuthModal?.('login');
    }
  });

  // ============================================================
  // নতুন — ➕পোস্ট ফ্লো: URL এ ?openListing=1 থাকলে অটোমেটিক মোডাল খুলবে
  // ============================================================
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('openListing') === '1') {
    setTimeout(async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        window.openListingModal?.();
      } else {
        window.openAuthModal?.('login');
      }
      window.history.replaceState({}, '', window.location.pathname);
    }, 150);
  }
</script>