---
// ============================================================
// পেজ: হারানো-পাওয়া সেবা
// (আগের সব কমেন্ট/হিস্ট্রি অপরিবর্তিত)
//
// আপডেট (নতুন — CTA ক্লিনআপ + CSS ইনকনসিস্টেন্সি ফিক্স + গ্যাপ):
// section-tag রিমুভ, dashed CTA বক্স → ক্লিকযোগ্য ইনলাইন টেক্সট
// (কালার #D9822B — অ্যাম্বার ফ্যামিলি, তবে সাদা ব্যাকগ্রাউন্ডে
// ভালো কনট্রাস্টের জন্য একটু গাঢ় করা হয়েছে হালকা #FDCB6E এর বদলে)।
// আগে এই ফাইলের page-header CSS বাকি ক্যাটাগরি পেজ থেকে আলাদা
// ছিল (padding, h1 ফন্ট-সাইজ, মোবাইল রেসপন্সিভ রুল মিসিং) —
// এখন স্ট্যান্ডার্ড প্যাটার্নে মিলিয়ে দেওয়া হলো।
//
// আপডেট (মাইগ্রেশন): ListingDetailModal বাদ দিয়ে বাকি ৯টা ক্যাটাগরির
// মতোই এখন /listing/[id].astro ডেডিকেটেড পেজে যায় (housing.astro এর
// প্যাটার্ন অনুসরণ করে) — কার্ড এখন <a href="/listing/{id}">, সোয়াইপ-
// কিউ (lostGrid/foundGrid আলাদা, একে অপরের সাথে না মিশে) সেভ হয়।
// রিপোর্ট/ফ্ল্যাগ এখন ডিটেইল পেজেই হয়, তাই এখানে ReportModal আর
// দরকার নেই। প্রিভিউ কার্ডের লাইক (গ্রিডে দেখানো) এটা আলাদা ফিচার,
// অপরিবর্তিত আছে।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import AddListingModal from '../../components/ui/AddListingModal.astro';
import { supabase } from '../../lib/supabase.js';

const typeOptions = [
  { id: 'lost', label: 'হারিয়ে গিয়েছে' },
  { id: 'found', label: 'পাওয়া গিয়েছে' },
];

const { data: lfListings } = await supabase
  .from('listings')
  .select('*')
  .eq('category', 'lost-found')
  .eq('status', 'active')
  .order('created_at', { ascending: false });

const listings = lfListings || [];
const lostItems = listings.filter((i) => i.type === 'lost');
const foundItems = listings.filter((i) => i.type === 'found');
---

<BaseLayout title="হারানো-পাওয়া সেবা | স্মার্ট ফেনী">
  <section class="page-header">
    <div class="container">
      <h1>কিছু <span class="accent">হারিয়েছে</span> বা <span class="accent">পেয়েছেন</span>?</h1>
      <p>ফেনী জেলার মানুষদের একে অপরকে সাহায্য করার সহজ মাধ্যম</p>
      <button type="button" class="page-cta-link" id="pageCtaBtn">
        <i class="fas fa-circle-info"></i> বিজ্ঞপ্তি দিতে নিচের <strong>"পোস্ট"</strong> বাটনে ট্যাপ করুন
      </button>
    </div>
  </section>

  <section class="lf-section">
    <div class="container">
      <div class="tabs" id="tabs">
        <button class="tab active" data-tab="lost">হারানো বিজ্ঞপ্তি</button>
        <button class="tab" data-tab="found">পাওয়া গিয়েছে</button>
      </div>

      <!-- হারানো ট্যাব -->
      <div class="tab-panel active" id="panel-lost">
        {lostItems.length === 0 ? (
          <div class="empty-state">
            <i class="fas fa-magnifying-glass"></i>
            <p>এখনো কোনো হারানো বিজ্ঞপ্তি নেই</p>
          </div>
        ) : (
          <div class="item-grid" id="lostGrid">
            {lostItems.map((item) => (
              <a
                href={`/listing/${item.id}`}
                class="item-card lost-card"
                data-target-id={item.id}
                data-upazila-name={item.upazila || ''}
              >
                <button class="like-btn-preview" type="button" data-like-btn aria-label="লাইক করুন" style="display:none;">
                  <i class="fas fa-heart"></i>
                  <span data-like-count>0</span>
                </button>
                <span class="like-count-preview-view" data-like-count-view>
                  <i class="fas fa-heart"></i>
                  <span data-like-count>0</span>
                </span>

                <span class="status-badge lost-badge">হারানো</span>
                <h3>{item.title}</h3>
                {item.description && <p class="item-desc">{item.description}</p>}
                <div class="item-meta">
                  <span><i class="fas fa-location-dot"></i> {item.upazila}</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- পাওয়া ট্যাব -->
      <div class="tab-panel" id="panel-found">
        {foundItems.length === 0 ? (
          <div class="empty-state">
            <i class="fas fa-hand-holding-heart"></i>
            <p>এখনো কোনো পাওয়ার বিজ্ঞপ্তি নেই</p>
          </div>
        ) : (
          <div class="item-grid" id="foundGrid">
            {foundItems.map((item) => (
              <a
                href={`/listing/${item.id}`}
                class="item-card found-card"
                data-target-id={item.id}
                data-upazila-name={item.upazila || ''}
              >
                <button class="like-btn-preview" type="button" data-like-btn aria-label="লাইক করুন" style="display:none;">
                  <i class="fas fa-heart"></i>
                  <span data-like-count>0</span>
                </button>
                <span class="like-count-preview-view" data-like-count-view>
                  <i class="fas fa-heart"></i>
                  <span data-like-count>0</span>
                </span>

                <span class="status-badge found-badge">পাওয়া গিয়েছে</span>
                <h3>{item.title}</h3>
                {item.description && <p class="item-desc">{item.description}</p>}
                <div class="item-meta">
                  <span><i class="fas fa-location-dot"></i> {item.upazila}</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <AddListingModal category="lost-found" typeOptions={typeOptions} titleLabel="আইটেমের নাম" priceLabel="" />
</BaseLayout>

<style>
  .page-header {
    padding: 44px 0 20px;
    background: #fff;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .page-header .accent {
    color: #D9822B;
  }

  .page-header p {
    color: #5A6E85;
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .page-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #D9822B;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 4px 0;
    font-family: inherit;
    cursor: pointer;
  }

  .page-cta-link:hover {
    opacity: 0.8;
  }

  .page-cta-link strong {
    font-weight: 800;
  }

  .lf-section {
    padding: 14px 0 60px;
    background: #F8FAFC;
  }

  .tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .tab {
    background: #fff;
    border: 1px solid #EEF3F9;
    color: #1B2A4A;
    padding: 12px 28px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab.active {
    background: #FF6B35;
    color: #fff;
    border-color: #FF6B35;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  .empty-state {
    text-align: center;
    background: #fff;
    border-radius: 20px;
    padding: 50px 24px;
    border: 1px dashed #E5EAF0;
  }

  .empty-state i {
    font-size: 2rem;
    color: #D7E0EC;
    margin-bottom: 12px;
  }

  .empty-state p {
    font-weight: 700;
    color: #1B2A4A;
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
  }

  .item-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    border: 1px solid #EEF3F9;
    position: relative;
    transition: all 0.25s ease;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    width: 100%;
    text-decoration: none;
    display: block;
  }

  .item-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  /* ===== প্রিভিউ কার্ডে লাইক (টপ-রাইট) ===== */
  .like-btn-preview,
  .like-count-preview-view {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    background: #F4F7FC;
    color: #8FA0BC;
  }

  .like-btn-preview {
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .like-btn-preview.liked {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .like-btn-preview.liked i {
    color: #FF6B35;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  .lost-badge {
    background: rgba(214, 48, 49, 0.1);
    color: #D63031;
  }

  .found-badge {
    background: rgba(0, 184, 148, 0.12);
    color: #00B894;
  }

  .item-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 8px;
    padding-right: 70px;
  }

  .item-desc {
    font-size: 0.88rem;
    color: #5A6E85;
    margin-bottom: 14px;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .item-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: #7A8EA5;
    flex-wrap: wrap;
    gap: 6px;
  }

  .item-meta i {
    color: #FF6B35;
    margin-right: 4px;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.7rem;
    }
  }

  @media (max-width: 480px) {
    .item-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .tabs {
      gap: 6px;
    }

    .tab {
      padding: 10px 16px;
      font-size: 0.85rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { reorderByUserLocation } from '../../lib/locationSort.js';
  import { fetchLikeData, toggleLike, isLoggedIn } from '../../lib/contentEngagement.js';

  // ট্যাব সুইচ
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.tab-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      panels.forEach((panel) => {
        panel.classList.toggle('active', panel.id === `panel-${target}`);
      });
    });
  });

  // দুইটা গ্রিড আলাদাভাবে লোকেশন-সর্ট
  const lostGrid = document.getElementById('lostGrid');
  const foundGrid = document.getElementById('foundGrid');
  reorderByUserLocation(lostGrid, 'upazilaName');
  reorderByUserLocation(foundGrid, 'upazilaName');

  // ============================================================
  // সোয়াইপ-কিউ সেভ — /listing/[id].astro পেজে সোয়াইপ-টু-নেক্সট
  // কাজ করার জন্য ক্লিকের সময় sessionStorage এ বর্তমান গ্রিডের
  // আইডি-লিস্ট সেভ হয়। lostGrid আর foundGrid সম্পূর্ণ আলাদা রাখা
  // হয়েছে যাতে "হারানো" থেকে সোয়াইপ করলে "পাওয়া" আইটেমের সাথে
  // মিশে না যায় (দুটোরই category='lost-found', কিন্তু কিউ আলাদা
  // তালিকা থেকে বানানো হয়)।
  // ============================================================
  function saveSwipeQueue(grid) {
    if (!grid) return;
    const ids = Array.from(grid.querySelectorAll('.item-card'))
      .map((c) => c.dataset.targetId)
      .filter(Boolean);
    sessionStorage.setItem('smartfeni_swipe_queue', JSON.stringify({ category: 'lost-found', ids }));
  }

  lostGrid?.addEventListener('click', () => saveSwipeQueue(lostGrid));
  foundGrid?.addEventListener('click', () => saveSwipeQueue(foundGrid));

  // ============================================================
  // ➕পোস্ট ফ্লো — শেয়ার্ড ফাংশন: লগইন থাকলে সরাসরি লিস্টিং মোডাল
  // খুলবে (আগের ২টা প্রিসেট CTA বাটন সরানো হয়েছে — ইউজার এখন
  // মোডালের ভেতরের ড্রপডাউন থেকে "হারিয়ে গিয়েছে" নাকি "পাওয়া
  // গিয়েছে" নিজে বেছে নেবে)। ২ জায়গা থেকে কল হয়: URL এ
  // ?openListing=1 থাকলে, অথবা হেডারের ইনলাইন CTA লাইনে ক্লিক করলে
  // ============================================================
  async function triggerOpenListing() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      window.openListingModal?.();
    } else {
      window.openAuthModal?.('login');
    }
  }

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('openListing') === '1') {
    setTimeout(async () => {
      await triggerOpenListing();
      window.history.replaceState({}, '', window.location.pathname);
    }, 150);
  }

  document.getElementById('pageCtaBtn')?.addEventListener('click', () => {
    triggerOpenListing();
  });

  // ============================================================
  // প্রিভিউ কার্ডে লাইক (দুই গ্রিড একসাথে, লগইন-গেটেড)
  // কার্ড এখন <a> ট্যাগ, তাই লাইক বাটনে ক্লিকে preventDefault +
  // stopPropagation — নাহলে ক্লিক করলে ডিটেইল পেজে চলে যাবে এবং/
  // অথবা সোয়াইপ-কিউ ওভাররাইট হয়ে যাবে।
  // ============================================================
  const allCards = document.querySelectorAll('.item-card');
  let boundLikeButtons = new WeakSet();

  async function renderPreviewLikes() {
    const loggedIn = await isLoggedIn();
    const ids = Array.from(allCards).map((c) => c.dataset.targetId).filter(Boolean);
    const { counts, likedByMe } = await fetchLikeData('listing', ids);

    allCards.forEach((card) => {
      const id = card.dataset.targetId;
      if (!id) return;

      const count = counts[id] || 0;
      const liked = likedByMe.has(id);

      const viewEl = card.querySelector('[data-like-count-view]');
      const btnEl = card.querySelector('[data-like-btn]');

      viewEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = count));
      btnEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = count));
      btnEl.classList.toggle('liked', liked);

      if (loggedIn) {
        viewEl.style.display = 'none';
        btnEl.style.display = 'flex';

        if (!boundLikeButtons.has(btnEl)) {
          boundLikeButtons.add(btnEl);

          btnEl.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            btnEl.disabled = true;
            const result = await toggleLike('listing', id);
            btnEl.disabled = false;
            if (result.error) return;
            const currentCount = parseInt(btnEl.querySelector('[data-like-count]').textContent, 10) || 0;
            const newCount = result.liked ? currentCount + 1 : Math.max(currentCount - 1, 0);
            btnEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = newCount));
            viewEl.querySelectorAll('[data-like-count]').forEach((el) => (el.textContent = newCount));
            btnEl.classList.toggle('liked', result.liked);
          });
        }
      } else {
        viewEl.style.display = 'flex';
        btnEl.style.display = 'none';
      }
    });
  }

  renderPreviewLikes();
  window.addEventListener('smartfeni:auth-changed', () => {
    renderPreviewLikes();
  });
</script>
