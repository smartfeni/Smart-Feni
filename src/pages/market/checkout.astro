---
// path: src/pages/market/checkout.astro
// ============================================================
// মার্কেটপ্লেস (ব্রান্চ: marketplace) — কার্ট দেখা ও অর্ডার দেওয়া: /market/checkout
// - কার্ট (marketCart.js), ড্রপ লোকেশন (শিট), পিকআপ = দোকানের পিন (সার্ভারেও বসে),
//   ডেলিভারি চার্জ = calc_delivery_fare (অটো), কখন লাগবে (OrderTimePicker), নোট।
// - অর্ডার যায় বিদ্যমান /api/delivery/create-request দিয়ে (isMarket=true);
//   তাই অ্যাডমিন গেট, রাইডার অফার, শপ নোটিফিকেশন (রাইডার কনফার্মের পর) সব আগের মতো।
// - এখানে অগ্রিম নেই: রাইডার কনফার্মের পর /market/order-এ অগ্রিম দিতে হয়।
// সব টেক্সট textContent দিয়ে (এস্কেপ)।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import MarketLocationSheet from '../../components/market/MarketLocationSheet.astro';
import OrderTimePicker from '../../components/delivery/OrderTimePicker.astro';
---

<BaseLayout title="কার্ট | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="mc-page">
    <header class="mc-top">
      <a class="mc-back" href="/market" aria-label="মার্কেটে ফিরুন"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
      <h1>আপনার কার্ট</h1>
    </header>
    <div id="mcBody"></div>
  </div>

  <MarketLocationSheet />

  <style is:global>
    .mc-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 70vh; padding: 14px 16px 120px; max-width: 560px; margin: 0 auto; }
    .mc-page * { box-sizing: border-box; }
    .mc-page button, .mc-page input, .mc-page textarea { font-family: inherit; }
    .mc-top { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .mc-top h1 { margin: 0; font-size: 20px; font-weight: 700; }
    .mc-back { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #1B2A4A; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.15); text-decoration: none; }
    .mc-card { background: #fff; border-radius: 18px; padding: 14px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.07); }
    .mc-h { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: #5B6B86; }
    .mc-shop { font-size: 17px; font-weight: 700; }
    .mc-row { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; font-size: 14.5px; }
    .mc-row small { color: #5B6B86; }
    .mc-row.tot { border-top: 1.5px dashed #EADBCF; margin-top: 6px; padding-top: 10px; font-weight: 700; font-size: 16px; }
    .mc-ctl { display: inline-flex; align-items: center; gap: 8px; }
    .mc-ctl button { width: 30px; height: 30px; border-radius: 9px; border: 1.5px solid #EADBCF; background: #fff; color: #1B2A4A; font-size: 15px; cursor: pointer; }
    .mc-ctl button:focus-visible, .mc-btn:focus-visible, .mc-chg:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .mc-addr { font-size: 14.5px; line-height: 1.5; word-break: break-word; }
    .mc-chg { margin-top: 8px; border: 1.5px solid #1B2A4A; background: #fff; color: #1B2A4A; border-radius: 12px; height: 38px; padding: 0 14px; font-size: 13.5px; font-weight: 700; cursor: pointer; }
    .mc-note textarea, .mc-fare input { width: 100%; border: 1.5px solid #EADBCF; border-radius: 12px; padding: 10px 12px; font-size: 14.5px; color: #1B2A4A; background: #fff; }
    .mc-note textarea { min-height: 70px; resize: vertical; }
    .mc-hint { margin: 8px 0 0; font-size: 12.5px; line-height: 1.5; color: #5B6B86; }
    .mc-err { margin: 10px 0 0; color: #B42318; font-size: 13.5px; font-weight: 600; }
    .mc-btn { width: 100%; height: 54px; border: 0; border-radius: 16px; background: #FF6B35; color: #fff; font-size: 16.5px; font-weight: 700; cursor: pointer; }
    .mc-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .mc-empty { padding: 36px 8px; text-align: center; font-size: 14.5px; line-height: 1.7; color: #5B6B86; }
    .mc-empty a { color: #1B2A4A; font-weight: 700; }
    .mc-ok { text-align: center; padding: 30px 12px; }
    .mc-ok i { font-size: 44px; color: #1F7A4D; }
    .mc-ok h2 { margin: 12px 0 6px; font-size: 20px; }
    .mc-ok p { margin: 0 0 18px; font-size: 14.5px; line-height: 1.6; color: #5B6B86; }
    .mc-ok a { display: inline-block; padding: 12px 20px; border-radius: 14px; background: #1B2A4A; color: #fff; font-weight: 700; text-decoration: none; margin: 4px; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { getCart, addItem, decItem, clearCart, cartTotal, getDrop } from '../../lib/marketCart.js';
    import { fetchShop, shopOpenState, bnNum } from '../../lib/marketApi.js';
    import { fetchDeliveryFare } from '../../lib/fareCalc.js';
    import { createServiceRequest } from '../../lib/deliveryClient.js';

    const $ = (id) => document.getElementById(id);
    let shop = null;
    let fare = null; // { fare, enabled, ... } | null
    let busy = false;

    function mk(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined && text !== null) e.textContent = text;
      return e;
    }
    function taka(n) { return '৳' + bnNum(Math.round(Number(n) || 0)); }
    function toast(m, t) { if (window.showToast) window.showToast(m, t); }

    function emptyMsg(html) {
      const b = $('mcBody');
      b.textContent = '';
      const p = mk('p', 'mc-empty');
      p.appendChild(html);
      b.appendChild(p);
    }

    function link(text, href) {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = text;
      return a;
    }

    function row(label, value, cls) {
      const r = mk('div', 'mc-row' + (cls ? ' ' + cls : ''));
      r.appendChild(mk('span', null, label));
      r.appendChild(mk('span', null, value));
      return r;
    }

    function chargeValue() {
      const inp = $('mcFareInput');
      if (inp) return Number(inp.value) || 0;
      return fare && fare.fare ? Number(fare.fare) : 0;
    }

    function updateTotals() {
      const c = getCart();
      const items = cartTotal(c);
      const ch = chargeValue();
      const t = $('mcTotals');
      if (!t) return;
      t.textContent = '';
      t.appendChild(row('আইটেমের আনুমানিক দাম', taka(items)));
      t.appendChild(row('ডেলিভারি চার্জ', ch > 0 ? taka(ch) : '—'));
      t.appendChild(row('আনুমানিক মোট', taka(items + ch), 'tot'));
    }

    let timeEl = null; // OrderTimePicker-এর স্থায়ী নোড
    let noteVal = '';

    function render() {
      const c = getCart();
      const body = $('mcBody');
      const oldNote = $('mcNote');
      if (oldNote) noteVal = oldNote.value;
      if (timeEl && timeEl.parentNode) timeEl.parentNode.removeChild(timeEl);
      body.textContent = '';
      if (!c.lines.length || !shop) {
        emptyMsg((() => {
          const f = document.createDocumentFragment();
          f.appendChild(document.createTextNode('আপনার কার্ট খালি। '));
          f.appendChild(link('দোকান দেখুন', '/market'));
          return f;
        })());
        return;
      }
      const st = shopOpenState(shop);

      // দোকান + আইটেম
      const a = mk('section', 'mc-card');
      a.appendChild(mk('div', 'mc-h', 'দোকান'));
      a.appendChild(mk('div', 'mc-shop', shop.name));
      if (!st.open) a.appendChild(mk('p', 'mc-err', 'দোকান এখন ' + st.label + '। অর্ডার দেওয়া যাবে না।'));
      c.lines.forEach((l) => {
        const r = mk('div', 'mc-row');
        const left = mk('span');
        left.appendChild(document.createTextNode(l.name + ' '));
        left.appendChild(mk('small', null, '(' + taka(l.price) + ')'));
        const ctl = mk('span', 'mc-ctl');
        const m = mk('button', null, '−');
        m.type = 'button';
        m.setAttribute('aria-label', l.name + ' কমান');
        m.addEventListener('click', () => { decItem(l.id); });
        const q = mk('b', null, bnNum(l.qty));
        const p = mk('button', null, '+');
        p.type = 'button';
        p.setAttribute('aria-label', l.name + ' বাড়ান');
        p.addEventListener('click', () => { addItem({ id: shop.id, name: shop.name }, { id: l.id, name: l.name, price: l.price }); });
        ctl.appendChild(m); ctl.appendChild(q); ctl.appendChild(p);
        r.appendChild(left); r.appendChild(ctl);
        a.appendChild(r);
      });
      body.appendChild(a);

      // ঠিকানা
      const d = getDrop();
      const b = mk('section', 'mc-card');
      b.appendChild(mk('div', 'mc-h', 'ডেলিভারি ঠিকানা'));
      b.appendChild(mk('div', 'mc-addr', d ? d.address : 'ঠিকানা সেট করা হয়নি'));
      if (d && d.instructions) b.appendChild(mk('p', 'mc-hint', 'নির্দেশনা: ' + d.instructions));
      const chg = mk('button', 'mc-chg', d ? 'ঠিকানা বদলান' : 'ঠিকানা দিন');
      chg.type = 'button';
      chg.addEventListener('click', () => window.SFMarketLocation.open());
      b.appendChild(chg);
      body.appendChild(b);

      // কখন লাগবে (বিদ্যমান কম্পোনেন্ট; নিচে ক্লোন করে বসানো হয়)
      const tw = mk('section', 'mc-card');
      tw.id = 'mcTimeHost';
      body.appendChild(tw);
      if (timeEl) tw.appendChild(timeEl); // একই নোড সরানো হয়, তাই বাছাই হারায় না

      // নোট
      const n = mk('section', 'mc-card mc-note');
      n.appendChild(mk('div', 'mc-h', 'দোকান/রাইডারের জন্য নোট (ঐচ্ছিক)'));
      const ta = document.createElement('textarea');
      ta.id = 'mcNote';
      ta.maxLength = 300;
      ta.placeholder = 'যেমন: ঝাল কম, বাসার গেটে এসে ফোন দেবেন';
      ta.setAttribute('aria-label', 'নোট');
      ta.value = noteVal;
      n.appendChild(ta);
      body.appendChild(n);

      // দাম
      const f = mk('section', 'mc-card');
      f.appendChild(mk('div', 'mc-h', 'হিসাব'));
      const tot = mk('div'); tot.id = 'mcTotals';
      f.appendChild(tot);
      if (!fare || !fare.fare) {
        const w = mk('div', 'mc-fare');
        w.appendChild(mk('p', 'mc-hint', 'ডেলিভারি চার্জ অটো হিসাব হয়নি। চার্জ লিখুন:'));
        const inp = document.createElement('input');
        inp.type = 'number'; inp.id = 'mcFareInput'; inp.min = '1'; inp.inputMode = 'numeric'; inp.value = '60';
        inp.setAttribute('aria-label', 'ডেলিভারি চার্জ (টাকা)');
        inp.addEventListener('input', updateTotals);
        w.appendChild(inp);
        f.appendChild(w);
      }
      f.appendChild(mk('p', 'mc-hint', 'দাম আনুমানিক। রাইডার দোকান থেকে কিনে আসল দাম আপনাকে পাঠাবে, আপনি কনফার্ম করলে তবেই কেনা হবে। রাইডার কনফার্ম হওয়ার পর অগ্রিম দিতে হবে।'));
      body.appendChild(f);

      const err = mk('p', 'mc-err'); err.id = 'mcErr'; err.hidden = true;
      body.appendChild(err);
      const btn = mk('button', 'mc-btn', 'অর্ডার পাঠান');
      btn.type = 'button'; btn.id = 'mcSubmit';
      btn.disabled = !st.open;
      btn.addEventListener('click', submit);
      body.appendChild(btn);

      updateTotals();
    }

    function showErr(m) {
      const e = $('mcErr');
      if (!e) return;
      e.textContent = m || '';
      e.hidden = !m;
    }

    async function submit() {
      if (busy) return;
      showErr('');
      const c = getCart();
      const d = getDrop();
      if (!c.lines.length || !shop) return;
      if (!d) { window.SFMarketLocation.open(); return; }
      const st = shopOpenState(shop);
      if (!st.open) { showErr('দোকান এখন ' + st.label + '।'); return; }
      const when = window.SFOrderTime ? window.SFOrderTime.get('mkc') : null;
      if (!when || !when.ok) return;
      const charge = chargeValue();
      if (!(charge > 0)) { showErr('ডেলিভারি চার্জ দিন।'); return; }

      busy = true;
      const btn = $('mcSubmit');
      btn.disabled = true;
      btn.textContent = 'পাঠানো হচ্ছে...';
      const note = ($('mcNote') && $('mcNote').value || '').trim();
      const itemsText = c.lines.map((l) => l.name + ' × ' + l.qty).join(', ');
      const description = 'মার্কেট অর্ডার — ' + shop.name + ': ' + itemsText + (note ? ' | নোট: ' + note : '');
      const src = d.source === 'map' ? 'map' : (d.lat !== null ? 'current' : 'manual');
      const res = await createServiceRequest({
        category: 'delivery',
        upazila: d.upazila || shop.upazila || 'ফেনী সদর',
        pickupAddress: [shop.name, shop.address].filter(Boolean).join(' — '),
        pickupLat: shop.lat,
        pickupLng: shop.lng,
        pickupInstructions: '',
        dropAddress: d.address,
        dropLat: d.lat,
        dropLng: d.lng,
        dropInstructions: d.instructions || '',
        description,
        vehicleType: 'any',
        askingPrice: charge,
        isAsap: when.isAsap,
        scheduledAt: when.scheduledAt,
        dropUnion: d.union || '',
        pickupUpazila: shop.upazila || '',
        pickupUnion: shop.union_name || '',
        dropLocSource: src,
        pickupLocSource: 'map',
        orderItems: c.lines.map((l) => ({ item_id: l.id, qty: l.qty })),
        fareDropLat: d.lat,
        fareDropLng: d.lng,
        farePickupLat: shop.lat,
        farePickupLng: shop.lng,
        isMarket: true,
        orderType: 'shop_order',
      });
      busy = false;
      if (res.error) {
        btn.disabled = false;
        btn.textContent = 'অর্ডার পাঠান';
        if (res.code === 'ITEM_UNAVAILABLE') { clearCart(); toast(res.error); setTimeout(() => history.back(), 800); return; }
        if (res.code === 'FARE_TOO_LOW') { fare = await loadFare(); render(); }
        showErr(res.error);
        return;
      }
      const reqId = res.data && res.data.request && res.data.request.id;
      clearCart();
      const body = $('mcBody');
      body.textContent = '';
      const ok = mk('div', 'mc-ok');
      const ic = document.createElement('i'); ic.className = 'fas fa-circle-check'; ic.setAttribute('aria-hidden', 'true');
      ok.appendChild(ic);
      ok.appendChild(mk('h2', null, 'অর্ডার পেয়েছি'));
      ok.appendChild(mk('p', null, 'যাচাই শেষে রাইডারদের কাছে যাবে। রাইডারের অফার এলে আপনি নোটিফিকেশন পাবেন, রাইডার কনফার্ম করার পর দোকানে অর্ডার যাবে।'));
      ok.appendChild(link('অফার ও অর্ডার দেখুন', '/my-orders'));
      if (reqId) ok.appendChild(link('অর্ডারের অবস্থা', '/market/order?id=' + encodeURIComponent(reqId)));
      body.appendChild(ok);
    }

    async function loadFare() {
      const d = getDrop();
      if (!shop || shop.lat === null) return null;
      return fetchDeliveryFare({
        pickup: { lat: shop.lat, lng: shop.lng },
        drop: d && d.lat !== null ? { lat: d.lat, lng: d.lng } : null,
        dropUnion: d ? d.union : '',
      });
    }

    async function refresh() {
      const c = getCart();
      if (!c.shopId) { shop = null; render(); return; }
      if (!shop || shop.id !== c.shopId) {
        try { shop = await fetchShop(c.shopId); } catch (e) { shop = null; }
      }
      fare = await loadFare();
      render();
    }

    async function init() {
      const hold = $('mcTimeHold');
      timeEl = hold ? hold.firstElementChild : null;
      emptyMsg(document.createTextNode('লোড হচ্ছে...'));
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        emptyMsg((() => {
          const f = document.createDocumentFragment();
          f.appendChild(document.createTextNode('অর্ডার করতে '));
          f.appendChild(link('লগইন করুন', '/login'));
          return f;
        })());
        return;
      }
      await refresh();
      window.addEventListener('smartfeni:market-cart-changed', () => {
        const c = getCart();
        if (!c.lines.length) { render(); return; }
        // কার্ট বদলালে পুরো ফর্ম আবার না আঁকলে নোট/সময় হারায়; তাই শুধু আইটেম অংশ ও হিসাব
        render();
      });
      window.addEventListener('smartfeni:market-drop-changed', async () => { fare = await loadFare(); render(); });
    }

    init();
  </script>

  <div id="mcTimeHold" hidden><OrderTimePicker id="mkc" /></div>
</BaseLayout>
