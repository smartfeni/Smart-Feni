      const show = (m) => { err.textContent = m || ''; err.hidden = !m; };

      const ok = mk('button', 'mo-btn', best !== null ? 'সেরা অফারে (' + taka(best) + ') নিশ্চিত করুন' : 'নিশ্চিত করুন');
      ok.type = 'button'; ok.disabled = best === null;
      let armed = false;
      ok.addEventListener('click', async () => {
        if (!armed) { armed = true; ok.textContent = 'আবার চাপুন — ' + taka(best) + '-এ নিশ্চিত'; setTimeout(() => { armed = false; ok.textContent = 'সেরা অফারে (' + taka(best) + ') নিশ্চিত করুন'; }, 4000); return; }
        ok.disabled = true; show('');
        const { error } = await confirmBestPrice({ requestId: R.id });
        if (error) { ok.disabled = false; show(String(error)); return; }
        toast('রাইডার কনফার্ম হয়েছে', 'success');
        await load();
      });
      c.appendChild(ok);

      c.appendChild(mk('label', 'mo-lbl', 'দাম বাড়াতে চান? (শুধু বাড়ানো যায়)'));
      const chips = mk('div', 'mo-chips');
      const inp = document.createElement('input');
      inp.type = 'number'; inp.className = 'mo-in'; inp.inputMode = 'numeric'; inp.placeholder = '৳' + bnNum(asking + 1) + ' বা বেশি'; inp.min = String(asking + 1);
