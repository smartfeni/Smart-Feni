      const cx = mk('button', 'mo-link', 'রিকোয়েস্ট বাতিল করুন'); cx.type = 'button';
      cx.style.cssText = 'display:block;margin-top:14px;background:none;border:0;padding:0;cursor:pointer;';
      cx.addEventListener('click', () => {
        const box = mk('div', 'mo-chips');
        [['mistake', 'ভুলে অর্ডার দিয়েছি'], ['price', 'দাম বেশি লাগছে'], ['no_offer', 'কেউ অফার দিচ্ছে না / দেরি হচ্ছে'], ['not_needed', 'আর লাগবে না']].forEach(([code, label]) => {
          const b = mk('button', 'mo-chip', label); b.type = 'button';
          b.addEventListener('click', async () => {
            box.querySelectorAll('button').forEach((x) => { x.disabled = true; });
            const { error } = await cancelRequest({ requestId: R.id, reasonCode: code });
            if (error) { show(String(error)); box.querySelectorAll('button').forEach((x) => { x.disabled = false; }); return; }
            toast('বাতিল হয়েছে', 'success');
            await load();
          });
          box.appendChild(b);
        });
        cx.replaceWith(box);
      });
      c.appendChild(cx);
      return c;
    }

    // ---------- নতুন: যোগাযোগ, অবস্থা, রিপোর্ট, রিভিউ, রাইডারের কাজ (সব এই প্যানেলেই) ----------
    function mapsUrl(lat, lng) { return 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(lat + ',' + lng); }
    function safePhone(p) { return String(p || '').replace(/[^0-9+]/g, ''); }
    function withBusy(fn) { return async function () { if (busy) return; busy = true; try { await fn.apply(null, arguments); } finally { busy = false; } }; }
    // ভুল চাপ ঠেকাতে দুইবার চাপ: প্রথম চাপে লেখা বদলায়, ৪ সেকেন্ডের মধ্যে আবার চাপলে কাজ হয়
    function tapTwice(btn, askLabel, run) {
      const orig = btn.textContent;
      let armed = false; let t = null;
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        if (!armed) {
          armed = true; btn.textContent = askLabel;
          t = setTimeout(() => { armed = false; btn.textContent = orig; }, 4000);
          return;
        }
        clearTimeout(t); armed = false; btn.disabled = true;
        run(btn, orig);
      });
    }

    function contactCard(title) {
