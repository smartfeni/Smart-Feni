      const ic = document.createElement('i'); ic.className = 'fas fa-user'; av.appendChild(ic);
      who.appendChild(av);
      const tx = mk('div');
      tx.appendChild(mk('div', 'mo-wn', contact.name));
      if (contact.sub) tx.appendChild(mk('div', 'mo-ws', contact.sub));
      who.appendChild(tx);
      c.appendChild(who);
      const acts = mk('div', 'mo-acts');
