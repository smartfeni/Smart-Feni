      return c;
    }

    // অ্যাডমিন হোল্ড/পাবলিশের আগে: অ্যাডমিনের সাথে কথা ও প্রস্তাব
    function dealCard() {
      const c = mk('section', 'mo-card');
      c.appendChild(mk('div', 'mo-h', 'অ্যাডমিন অর্ডার দেখছেন'));
      if (R.admin_offer_status === 'offered') {
        c.appendChild(mk('p', 'mo-msg', 'অ্যাডমিনের ডেলিভারি চার্জ প্রস্তাব: ' + taka(R.admin_offer_price)));
        const two = mk('div', 'mo-2');
        const ok = mk('button', 'mo-btn', 'নিলাম'); ok.type = 'button';
        const no = mk('button', 'mo-btn alt', 'নিলাম না'); no.type = 'button'; no.style.marginTop = '12px';
        const respond = withBusy(async (accept) => {
          ok.disabled = true; no.disabled = true;
          const { data, error } = await supabase.rpc('customer_respond_admin_offer', { p_request_id: R.id, p_accept: accept });
          if (error || !(data && data.ok)) { toast('এখন সাড়া দেওয়া যায়নি, আবার চেষ্টা করুন', 'error'); report(error || new Error('admin_offer_failed'), 'market_order_deal'); }
          await load();
        });
        ok.addEventListener('click', () => respond(true));
        no.addEventListener('click', () => respond(false));
        two.appendChild(ok); two.appendChild(no);
        c.appendChild(two);
      } else if (R.admin_offer_status === 'accepted') {
        c.appendChild(mk('p', 'mo-msg', 'আপনি প্রস্তাব মেনে নিয়েছেন। অ্যাডমিন রাইডার ঠিক করছেন।'));
      } else {
        c.appendChild(mk('p', 'mo-msg', 'অ্যাডমিন চার্জ নিয়ে আপনার সাথে কথা বলতে পারেন। আপনিও চাইলে লিখতে পারেন।'));
      }
      const ch = mk('button', 'mo-btn alt', 'অ্যাডমিনের সাথে কথা বলুন'); ch.type = 'button';
      ch.addEventListener('click', () => { if (window.openChatModal) window.openChatModal({ requestId: R.id, otherPartyName: 'অ্যাডমিন', channel: 'admin', deal: 'customer' }); });
      c.appendChild(ch);
      return c;
    }

    // সম্পন্ন হলে রিভিউ (কাস্টমার)
    function reviewCard() {
      const c = mk('section', 'mo-card');
      if (reviewed) {
        c.appendChild(mk('p', 'mo-msg', 'রিভিউ দেওয়া হয়েছে, ধন্যবাদ!'));
        return c;
      }
      c.appendChild(mk('div', 'mo-h', 'রাইডারকে রেটিং দিন'));
      let rating = 0;
      const stars = mk('div', 'mo-stars');
      const btns = [];
      for (let n = 1; n <= 5; n++) {
        const b = mk('button', 'mo-star', '★'); b.type = 'button'; b.setAttribute('aria-label', n + ' স্টার');
        b.addEventListener('click', () => { rating = n; btns.forEach((x, i) => x.classList.toggle('on', i < n)); });
        btns.push(b); stars.appendChild(b);
      }
      c.appendChild(stars);
      const ta = mk('textarea', 'mo-in'); ta.rows = 2; ta.placeholder = 'মতামত (ঐচ্ছিক)'; ta.maxLength = 500; ta.setAttribute('aria-label', 'মতামত');
      c.appendChild(ta);
      const er = mk('p', 'mo-err'); er.hidden = true; c.appendChild(er);
      const sb = mk('button', 'mo-btn', 'রিভিউ জমা দিন'); sb.type = 'button';
      sb.addEventListener('click', withBusy(async () => {
        if (!rating) { er.textContent = 'আগে স্টার বেছে নিন।'; er.hidden = false; return; }
        er.hidden = true; sb.disabled = true;
        const { error } = await submitReview({ requestId: R.id, rating, comment: ta.value.trim() });
        if (error) { er.textContent = String(error); er.hidden = false; sb.disabled = false; return; }
        reviewed = true;
        await load();
      }));
      c.appendChild(sb);
      return c;
    }

    // রাইডার: পিকআপ → ডেলিভারি, নেভিগেট, ছাড়ার অনুরোধ
    function riderRunCard() {
      const c = mk('section', 'mo-card');
      const picked = !!R.pickup_done_at;
      const isDel = R.status === 'delivered';
      c.appendChild(mk('div', 'mo-h', isDel ? 'ডেলিভারি সম্পন্নের অপেক্ষা' : (picked ? 'ডেলিভারি লোকেশন' : 'পিকআপ লোকেশন')));
      const addr = picked || isDel ? R.drop_address : (R.pickup_address || '');
      const ins = picked || isDel ? R.drop_instructions : R.pickup_instructions;
      const lat = picked || isDel ? R.drop_lat : R.pickup_lat;
      const lng = picked || isDel ? R.drop_lng : R.pickup_lng;
      c.appendChild(mk('p', 'mo-msg', addr || '—'));
      if (ins) c.appendChild(mk('p', 'mo-note', 'নির্দেশনা: ' + ins));
      if (lat !== null && lat !== undefined && lng !== null && lng !== undefined) {
        const a = document.createElement('a'); a.className = 'mo-link'; a.href = mapsUrl(lat, lng); a.target = '_blank'; a.rel = 'noopener';
        a.textContent = 'ম্যাপে নেভিগেট করুন';
        c.appendChild(a);
      }
      const er = mk('p', 'mo-err'); er.hidden = true; c.appendChild(er);
      const fail = (m) => { er.textContent = m; er.hidden = false; };
      if (!picked && !isDel) {
        const b = mk('button', 'mo-btn', contracted ? 'পণ্য নিয়েছি' : 'টাকা মিটিয়েছি, পণ্য নিয়েছি'); b.type = 'button';
        tapTwice(b, 'আবার চাপুন, নিশ্চিত?', withBusy(async (btn, orig) => {
          const { error } = await markPickupDone({ requestId: R.id });
          if (error) { fail(String(error)); btn.disabled = false; btn.textContent = orig; return; }
          await load();
        }));
        c.appendChild(b);
      } else {
        const b = mk('button', 'mo-btn', 'ডেলিভারি সম্পন্ন করুন'); b.type = 'button';
        tapTwice(b, 'আবার চাপুন, নিশ্চিত? বদলানো যাবে না', withBusy(async (btn, orig) => {
          const { error } = await confirmDelivery({ requestId: R.id });
          if (error) { fail(String(error)); btn.disabled = false; btn.textContent = orig; return; }
          await load();
        }));
        c.appendChild(b);
      }
      return c;
    }

    function riderReleaseCard() {
      const c = mk('section', 'mo-card mo-soft');
      if (R.release_requested_at) {
        c.appendChild(mk('p', 'mo-msg', 'ছাড়ার অনুরোধ অ্যাডমিনের কাছে আছে। অনুমোদন না হওয়া পর্যন্ত অর্ডারটা আপনার দায়িত্বে।'));
        const w = mk('button', 'mo-btn alt', 'অনুরোধ তুলে নিন'); w.type = 'button';
        w.addEventListener('click', withBusy(async () => {
          w.disabled = true;
          const { data, error } = await supabase.rpc('rider_withdraw_release_request', { p_request_id: R.id });
          if (error || !(data && data.ok)) toast('এখন তুলে নেওয়া যাচ্ছে না, আবার চেষ্টা করুন', 'error');
          await load();
        }));
        c.appendChild(w);
        return c;
      }
      const open = mk('button', 'mo-btn alt', 'অর্ডার ছাড়ার অনুরোধ করুন'); open.type = 'button'; open.style.marginTop = '0';
      const form = mk('div'); form.hidden = true;
      const ta = mk('textarea', 'mo-in'); ta.rows = 2; ta.maxLength = 300; ta.placeholder = 'কেন ছাড়তে চান? (কমপক্ষে ৩ অক্ষর)'; ta.setAttribute('aria-label', 'ছাড়ার কারণ');
      const er = mk('p', 'mo-err'); er.hidden = true;
      const send = mk('button', 'mo-btn', 'অনুরোধ পাঠান'); send.type = 'button';
      form.appendChild(mk('p', 'mo-note', 'অনুমোদন না হওয়া পর্যন্ত অর্ডারটা আপনার দায়িত্বে থাকবে। পিকআপের পর আর ছাড়া যায় না।'));
      form.appendChild(ta); form.appendChild(er); form.appendChild(send);
      open.addEventListener('click', () => { form.hidden = !form.hidden; if (!form.hidden) ta.focus(); });
      send.addEventListener('click', withBusy(async () => {
        const reason = ta.value.trim().slice(0, 300);
        if (reason.length < 3) { er.textContent = 'কারণ কমপক্ষে ৩ অক্ষর লিখুন।'; er.hidden = false; return; }
        er.hidden = true; send.disabled = true;
        const { data, error } = await supabase.rpc('rider_release_order', { p_request_id: R.id, p_reason: reason });
        if (error || !(data && data.ok)) {
          const msgs = { already_picked_up: 'পিকআপ হয়ে গেছে, এখন আর ছাড়া যাবে না।', not_releasable: 'অর্ডারটি এখন ছাড়ার মতো অবস্থায় নেই।', reason_required: 'কারণ কমপক্ষে ৩ অক্ষর লিখুন।', already_requested: 'আপনার অনুরোধ আগেই অ্যাডমিনের কাছে গেছে।' };
          er.textContent = msgs[data && data.reason] || 'এখন ছাড়া যাচ্ছে না, আবার চেষ্টা করুন।'; er.hidden = false; send.disabled = false;
          return;
        }
        toast('ছাড়ার অনুরোধ অ্যাডমিনের কাছে পাঠানো হয়েছে', 'success');
        await load();
      }));
      c.appendChild(open); c.appendChild(form);
      return c;
    }

    function infoCard(title, text, linkText, href) {
      const c = mk('section', 'mo-card');
      if (title) c.appendChild(mk('div', 'mo-h', title));
      c.appendChild(mk('p', 'mo-msg', text));
      if (linkText) {
        const a = document.createElement('a');
        a.className = 'mo-link'; a.href = href; a.textContent = linkText;
        c.appendChild(a);
      }
      return c;
    }

    async function render() {
      const body = $('moBody');
      // টাইপ করা ফর্ম হারানো এড়াতে: ইনপুট ফোকাসে থাকলে পুনঃআঁকা এড়াও
      const ae = document.activeElement;
      if (ae && body.contains(ae) && /^(INPUT|TEXTAREA)$/.test(ae.tagName)) return;
      const frag = document.createDocumentFragment();
      $('moTitle').textContent = R.order_no ? 'অর্ডার ' + R.order_no : 'অর্ডার';
      frag.appendChild(stepsCard());
      if ((R.status === 'confirmed' || R.status === 'delivered') && contact) frag.appendChild(contactCard(role === 'customer' ? 'আপনার রাইডার' : 'কাস্টমার'));
      const st = R.market_stage || 'awaiting_advance';

      if (R.status === 'cancelled') {
        frag.appendChild(infoCard('বাতিল', 'এই অর্ডার বাতিল হয়েছে।' + (R.cancel_reason ? ' কারণ: ' + R.cancel_reason : '')));
      } else if (R.status === 'completed') {
        const c = infoCard('সম্পন্ন', 'এই অর্ডার সম্পন্ন হয়েছে।');
        if (R.purchase_total) c.appendChild(row('কেনার দাম', taka(R.purchase_total)));
        frag.appendChild(c);
        if (role === 'customer') frag.appendChild(reviewCard());
      } else if (R.status === 'disputed') {
        frag.appendChild(infoCard('সমস্যা', 'এই অর্ডারে সমস্যা জানানো হয়েছে। অ্যাডমিন দেখছে।'));
      } else if (R.status === 'delivered') {
        if (role === 'rider') {
          frag.appendChild(riderRunCard());
          frag.appendChild(reportCard());
        } else {
          frag.appendChild(infoCard('ডেলিভারি হয়েছে', 'রাইডার ডেলিভারি দিয়েছে, সম্পন্ন মার্কের অপেক্ষায় আছে।'));
          frag.appendChild(reportCard());
        }
      } else if (R.status !== 'confirmed' && role === 'customer' && (R.status === 'open' || R.status === 'negotiating') && R.publish_status === 'published') {
        frag.appendChild(await offersCard());
      } else if (R.status !== 'confirmed' && role === 'customer' && (R.publish_status === 'pending' || R.publish_status === 'hold')) {
        frag.appendChild(dealCard());
      } else if (R.status !== 'confirmed') {
        frag.appendChild(infoCard('রাইডারের অপেক্ষা', role === 'customer'
          ? 'অর্ডার যাচাই ও রাইডারের অফারের অপেক্ষায় আছে। অফার এলে এখানেই দেখতে পাবেন, সেখান থেকে রাইডার কনফার্ম করবেন। তারপর অগ্রিম দিতে হবে।'
          : 'এই অর্ডার এখনো কনফার্ম হয়নি।'));
      } else if (role === 'customer') {
        const noPrice = R.order_type === 'anything' && R.purchase_total == null;
        if (!R.advance_verified && (st === 'awaiting_advance' || st === 'payment_mismatch')) {
          if (noPrice) frag.appendChild(infoCard('রাইডার দাম পাঠাবে', 'রাইডার পণ্যের দাম পাঠালে এখানে দেখতে পাবেন, তারপর ডেলিভারি চার্জ বা ফুল পেমেন্ট দেবেন।'));
          else if (local.payOpen) frag.appendChild(advanceCard()); else frag.appendChild(advanceChoiceCard());
          if (R.order_type === 'anything' && !noPrice) frag.appendChild(await quoteCard(true));
        } else if (st === 'advance_submitted') {
          frag.appendChild(infoCard('পেমেন্ট যাচাই চলছে', 'আপনার পেমেন্ট জমা হয়েছে। অ্যাডমিন যাচাই করলে নোটিফিকেশন পাবেন।'));
        } else if (st === 'quote_confirmed') {
          const c = infoCard(R.pickup_done_at ? 'জিনিস নিয়ে পথে আছে' : 'পেমেন্ট যাচাই হয়েছে', R.pickup_done_at ? 'রাইডার জিনিস নিয়ে আপনার ঠিকানার পথে আছে।' : 'রাইডার দোকান থেকে জিনিস নিয়ে আসছে।');
          c.appendChild(row('কেনার দাম', taka(R.purchase_total)));
          c.appendChild(row(Number(R.cod_due) >= 0 ? 'ডেলিভারিতে দিতে হবে (COD)' : 'ডেলিভারিতে ফেরত পাবেন', taka(Math.abs(Number(R.cod_due) || 0)), 'tot'));
          frag.appendChild(c);
        }
        frag.appendChild(reportCard());
      } else if (role === 'rider') {
        if (st === 'advance_submitted') {
          frag.appendChild(infoCard('পেমেন্ট যাচাই চলছে', 'কাস্টমার পেমেন্ট দিয়েছে, অ্যাডমিন যাচাই করছে। যাচাই হলে নোটিফিকেশন পাবেন। তার আগে দোকানে কিছু কিনবেন না।'));
          if (R.purchase_total != null) frag.appendChild(await quoteCard(false));
        } else if (R.order_type === 'anything' && st !== 'quote_confirmed') {
          if (R.purchase_total != null) {
            frag.appendChild(infoCard('কাস্টমারের পেমেন্টের অপেক্ষা', 'পণ্যের দাম পাঠানো হয়েছে। কাস্টমার পেমেন্ট দিলে ও যাচাই হলে নোটিফিকেশন পাবেন। তার আগে দোকানে টাকা মেটাবেন না।'));
            frag.appendChild(await quoteCard(false));
          }
          frag.appendChild(riderQuoteForm());
        } else if (st !== 'quote_confirmed') {
          frag.appendChild(infoCard('কাস্টমারের পেমেন্টের অপেক্ষা', 'কাস্টমার পেমেন্ট দিচ্ছে। যাচাই হলে নোটিফিকেশন পাবেন। তার আগে দোকানে কিছু কিনবেন না।'));
        } else if (st === 'quote_confirmed') {
          const c = mk('section', 'mo-card');
          c.appendChild(mk('div', 'mo-h', 'এখন করণীয়'));
          c.appendChild(mk('p', 'mo-msg', contracted ? 'দোকানে টাকা দিতে হবে না, শুধু পণ্য নিন' : 'দোকানে পুরো টাকা মিটিয়ে পণ্য নিন'));
          c.appendChild(row(contracted ? 'দোকানে দেবেন' : 'দোকানে মেটাবেন', taka(contracted ? 0 : R.purchase_total)));
          c.appendChild(row('কাস্টমার থেকে নেবেন (COD)', taka(Math.max(Number(R.cod_due) || 0, 0)), 'tot'));
          if (Number(R.cod_due) < 0) c.appendChild(row('কাস্টমারকে ফেরত দিতে হবে', taka(Math.abs(Number(R.cod_due)))));
          frag.appendChild(c);
          frag.appendChild(riderRunCard());
          if (!R.pickup_done_at) frag.appendChild(riderReleaseCard());
        }
        frag.appendChild(reportCard());
      }
      const det = detailsCard();
      const softs = frag.querySelectorAll('.mo-soft');
      if (softs.length) softs[softs.length - 1].before(det); else frag.appendChild(det);
      body.textContent = '';
      body.appendChild(frag);
    }

    async function load() {
      const { data, error } = await supabase.from('delivery_requests').select(COLS).eq('id', reqId).maybeSingle();
      if (error || !data || !data.is_market) {
        $('moBody').textContent = '';
        $('moBody').appendChild(mk('p', 'mo-msg soft', 'অর্ডার পাওয়া যায়নি।'));
        return;
      }
      R = data;
      role = R.customer_profile_id === uid ? 'customer' : 'rider';
      if (role === 'rider') {
        const { data: rr } = await supabase.from('delivery_riders').select('id').eq('profile_id', uid).maybeSingle();
        if (!rr || rr.id !== R.accepted_rider_id) {
          $('moBody').textContent = '';
          $('moBody').appendChild(mk('p', 'mo-msg soft', 'এই অর্ডার আপনার নয়।'));
          return;
        }
      }
      const { data: qs } = await supabase.from('delivery_price_quotes').select('id, lines, total, receipt_url, status, created_at').eq('request_id', reqId).order('created_at', { ascending: false }).limit(1);
      quote = qs && qs[0] ? qs[0] : null;
      contact = null;
      if (R.accepted_rider_id && (R.status === 'confirmed' || R.status === 'delivered')) {
        try {
          if (role === 'customer') {
            const { data: cr } = await supabase.from('delivery_requests').select('accepted_rider:delivery_riders!delivery_requests_accepted_rider_id_fkey(vehicle_type, profiles!delivery_riders_profile_id_fkey(full_name, phone))').eq('id', reqId).maybeSingle();
            const p = cr && cr.accepted_rider && cr.accepted_rider.profiles;
            contact = { name: (p && p.full_name) || 'রাইডার', phone: p && p.phone, sub: 'ডেলিভারি হিরো' };
          } else {
            const { data: cr } = await supabase.from('delivery_requests').select('profiles!delivery_requests_customer_profile_id_fkey(full_name, phone)').eq('id', reqId).maybeSingle();
            const p = cr && cr.profiles;
            contact = { name: (p && p.full_name) || 'কাস্টমার', phone: p && p.phone, sub: 'অর্ডারকারী' };
          }
        } catch (e) { report(e, 'market_order_contact'); }
      }
      reviewed = false;
      if (role === 'customer' && R.status === 'completed') {
        const { data: rv } = await supabase.from('delivery_reviews').select('request_id').eq('request_id', reqId).eq('customer_profile_id', uid).maybeSingle();
        reviewed = !!rv;
      }
      contracted = false;
      if (role === 'rider' && R.shop_ids && R.shop_ids.length) {
        const { data: sh } = await supabase.from('delivery_shops').select('owner_id').eq('id', R.shop_ids[0]).maybeSingle();
        contracted = !!(sh && sh.owner_id);
      }
      await render();
    }

    async function init() {
      if (new URLSearchParams(location.search).get('embed') === '1') {
        // শিটের ভেতরে: শুধু প্যানেল (হেডার/ব্যাক/সাইট নেভবার লুকানো)
        const st = document.createElement('style');
        st.textContent = '#siteNavbar, .mo-top, footer, #chatWidget { display: none !important; } .mo-page { padding-top: 10px !important; }';
        document.head.appendChild(st);
      }
      reqId = new URLSearchParams(location.search).get('id') || '';
      const body = $('moBody');
      if (!UUID.test(reqId)) { body.appendChild(mk('p', 'mo-msg soft', 'অর্ডার পাওয়া যায়নি।')); return; }
      body.appendChild(mk('p', 'mo-msg soft', 'লোড হচ্ছে...'));
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        body.textContent = '';
        const p = mk('p', 'mo-msg soft', 'অর্ডার দেখতে ');
        const a = document.createElement('a'); a.href = '/login'; a.textContent = 'লগইন করুন'; a.className = 'mo-link';
        p.appendChild(a);
        body.appendChild(p);
        return;
      }
      uid = session.user.id;
      const { data: st } = await supabase.from('site_settings').select('key, value').in('key', ['market_payment_bkash', 'market_payment_nagad', 'market_payment_note']);
      (st || []).forEach((x) => { settings[x.key] = x.value; });
      await load();
      timer = setInterval(() => { if (!document.hidden && !busy) load(); }, 15000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) load(); });
    }
    init();
  </script>
</BaseLayout>
