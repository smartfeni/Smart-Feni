    async function uploadShot(inputId, prefix) {
      const inp = $(inputId);
      const f = inp && inp.files && inp.files[0];
      if (!f) return null;
      const small = await compressImage(f, { maxDimension: 1800, quality: 0.9 });
      const path = reqId + '/' + prefix + '-' + Date.now() + '.jpg';
      const { error } = await supabase.storage.from('delivery-proofs').upload(path, small);
      if (error) { report(error, 'market-proof-upload'); throw new Error('ছবি আপলোড হয়নি। ছবি ছাড়াই জমা দিতে পারেন।'); }
      return path;
    }

    async function submitPayment() {
      if (busy) return;
      showErr('');
      const amount = Number($('moAmt').value);
      const trx = $('moTrx').value.trim();
      const l4 = $('moL4').value.trim();
      if (!(amount > 0)) { showErr('কত টাকা পাঠিয়েছেন লিখুন।'); return; }
      if (!trx && !l4) { showErr('TrxID অথবা প্রেরক নম্বরের শেষ ৪ ডিজিট দিন।'); return; }
      busy = true;
      try {
        let shot = null;
        try { shot = await uploadShot('moShot', 'pay'); } catch (e) { showErr(e.message); busy = false; return; }
        const { error } = await supabase.rpc('market_submit_payment', {
          p_request: reqId, p_mode: local.mode, p_method: local.method, p_claimed: amount,
          p_trx: trx || null, p_last4: l4 || null, p_screenshot: shot,
        });
        if (error) { showErr(msgOf(error)); report(error, 'market-submit-payment'); return; }
        toast('পেমেন্ট জমা হয়েছে। যাচাইয়ের অপেক্ষা করুন।', 'success');
        await load();
      } finally { busy = false; }
    }

