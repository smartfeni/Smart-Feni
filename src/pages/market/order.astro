      if (ph) {
        const a = document.createElement('a'); a.className = 'mo-act'; a.href = 'tel:' + ph;
        const i = document.createElement('i'); i.className = 'fas fa-phone'; i.setAttribute('aria-hidden', 'true');
        a.appendChild(i); a.appendChild(document.createTextNode(' কল করুন'));
        acts.appendChild(a);
      }
      const ch = mk('button', 'mo-act');
      ch.type = 'button';
