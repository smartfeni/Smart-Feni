    // ---------- পুরো স্ক্রিন ----------
    // রাইডারের অপেক্ষা (open/negotiating): অফার, দাম বাড়ানো, সেরা অফারে নিশ্চিত, বাতিল — সব এই প্যানেলেই
    async function offersCard() {
      const c = mk('section', 'mo-card');
      c.appendChild(mk('div', 'mo-h', 'রাইডারের অফার'));
      const { data: offs } = await supabase.from('delivery_offers').select('offer_price').eq('request_id', R.id).eq('status', 'active').order('offer_price', { ascending: true });
      const best = offs && offs.length ? Number(offs[0].offer_price) : null;
      const asking = Number(R.customer_asking_price ?? R.initial_price) || 0;
      c.appendChild(row('সেরা অফার', best !== null ? taka(best) : 'অপেক্ষায়...'));
      c.appendChild(row('আপনার প্রস্তাব', taka(asking)));
      c.appendChild(mk('p', 'mo-msg soft', best === null ? 'এখনো কোনো রাইডার সাড়া দেয়নি। একটু অপেক্ষা করুন, অথবা দাম বাড়ান।' : 'রাইডার বেছে নিলে পরের ধাপে অগ্রিম দিতে হবে।'));

