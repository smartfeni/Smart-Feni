      ch.appendChild(ci); ch.appendChild(document.createTextNode(' চ্যাট'));
      ch.addEventListener('click', () => { if (window.openChatModal) window.openChatModal({ requestId: R.id, otherPartyName: contact.name }); });
      acts.appendChild(ch);
      c.appendChild(acts);
      return c;
    }

    function reportCard() {
      const c = mk('section', 'mo-card mo-soft');
      const b = mk('button', 'mo-btn alt', 'সমস্যা হয়েছে? রিপোর্ট করুন');
      b.type = 'button';
      b.style.marginTop = '0';
      b.addEventListener('click', () => { if (window.openDisputeModal) window.openDisputeModal({ requestId: R.id, onSuccess: load }); });
