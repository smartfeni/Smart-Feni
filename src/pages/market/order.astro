---
// path: src/pages/market/order.astro
// ============================================================
// মার্কেটপ্লেস (ব্রান্চ: marketplace) — অর্ডারের অবস্থা ও টাকার ধাপ: /market/order?id=<request uuid>
// এক পেজ, ভূমিকা-ভিত্তিক:
//   কাস্টমার: রাইডারের অপেক্ষা → (রাইডার কনফার্ম) → অগ্রিম (শুধু ডেলিভারি চার্জ / ফুল) →
//             অ্যাডমিনের যাচাই → রাইডারের পাঠানো কেনার দাম ইনবক্সে কনফার্ম → ডেলিভারি (COD বাকি)
//   রাইডার:  অগ্রিম যাচাইয়ের পর কেনার দাম (একাধিক এমাউন্ট + ঐচ্ছিক রিসিট) পাঠানো, পরে টাকা মেটানোর নির্দেশ
// রাইডার বাছাই/অফার, চ্যাট, পিকআপ/ডেলিভারি ধাপ বিদ্যমান পেজেই (my-orders, delivery-hero)।
// সব লেখা RPC দিয়ে (market_submit_payment, market_rider_submit_quote);
// সব টেক্সট textContent দিয়ে (এস্কেপ)।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import ChatModal from '../../components/delivery/ChatModal.astro';
import DisputeReasonModal from '../../components/delivery/DisputeReasonModal.astro';
---

<BaseLayout title="অর্ডার | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="mo-page">
    <header class="mo-top">
      <a class="mo-back" href="/market/orders" aria-label="আমার অর্ডার"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
      <h1 id="moTitle">অর্ডার</h1>
    </header>
    <div id="moBody"></div>
  </div>
  <ChatModal />
  <DisputeReasonModal />

  <style is:global>
    .mo-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 70vh; padding: 14px 16px 120px; max-width: 560px; margin: 0 auto; }
    .mo-page * { box-sizing: border-box; }
    .mo-page button, .mo-page input, .mo-page select { font-family: inherit; }
    .mo-top { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .mo-top h1 { margin: 0; font-size: 19px; font-weight: 700; }
    .mo-back { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #1B2A4A; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.15); text-decoration: none; }
    .mo-card { background: #fff; border-radius: 18px; padding: 14px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.07); }
    .mo-h { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: #5B6B86; }
    .mo-steps { display: flex; gap: 4px; margin: 0 0 4px; padding: 0; list-style: none; }
    .mo-step { flex: 1; text-align: center; font-size: 10.5px; line-height: 1.25; color: #8793A8; font-weight: 600; }
    .mo-step i { display: block; width: 26px; height: 26px; line-height: 26px; margin: 0 auto 4px; border-radius: 50%; background: #EEF0F4; font-style: normal; font-size: 12px; }
    .mo-step.done { color: #1F7A4D; }
    .mo-step.done i { background: #1F7A4D; color: #fff; }
    .mo-step.now { color: #1B2A4A; }
    .mo-step.now i { background: #FF6B35; color: #fff; }
    .mo-row { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; font-size: 14.5px; }
    .mo-row small { color: #5B6B86; }
    .mo-row.tot { border-top: 1.5px dashed #EADBCF; margin-top: 6px; padding-top: 10px; font-weight: 700; font-size: 16px; }
    .mo-msg { margin: 0; font-size: 14.5px; line-height: 1.6; }
    .mo-msg.soft { color: #5B6B86; }
    .mo-badge { display: inline-block; font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 9px; background: #FFE9DA; color: #8A3B12; }
    .mo-opts { display: grid; gap: 8px; margin: 6px 0 10px; }
    .mo-opt { text-align: left; border: 1.5px solid #EADBCF; background: #fff; border-radius: 14px; padding: 11px 12px; cursor: pointer; color: #1B2A4A; }
    .mo-opt[aria-pressed='true'] { border-color: #FF6B35; background: #FFF4EC; }
    .mo-opt b { display: block; font-size: 15px; }
    .mo-opt span { font-size: 12.5px; color: #5B6B86; }
    .mo-chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 4px 0 10px; }
    .mo-chip { border: 1.5px solid #EADBCF; background: #fff; color: #1B2A4A; border-radius: 18px; padding: 7px 14px; font-size: 13.5px; font-weight: 600; cursor: pointer; }
    .mo-chip[aria-pressed='true'] { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
    .mo-lbl { display: block; margin: 8px 0 4px; font-size: 13px; font-weight: 700; }
    .mo-in { width: 100%; border: 1.5px solid #EADBCF; border-radius: 12px; padding: 10px 12px; font-size: 15px; color: #1B2A4A; background: #fff; }
    .mo-in:focus { outline: 0; border-color: #1B2A4A; }
    .mo-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .mo-pay { background: #FFF4EC; border-radius: 12px; padding: 10px 12px; font-size: 13.5px; line-height: 1.55; margin: 6px 0; }
    .mo-pay b { font-size: 15px; }
    .mo-btn { width: 100%; height: 50px; margin-top: 12px; border: 0; border-radius: 14px; background: #FF6B35; color: #fff; font-size: 16px; font-weight: 700; cursor: pointer; }
    .mo-btn.alt { background: #fff; color: #1B2A4A; border: 1.5px solid #1B2A4A; margin-top: 8px; }
    .mo-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .mo-btn:focus-visible, .mo-chip:focus-visible, .mo-opt:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .mo-err { margin: 10px 0 0; color: #B42318; font-size: 13.5px; font-weight: 600; }
    .mo-link { display: inline-block; margin-top: 10px; color: #1B2A4A; font-weight: 700; }
    .mo-line { display: grid; grid-template-columns: 1fr 96px 34px; gap: 6px; margin-bottom: 6px; }
    .mo-x { border: 1.5px solid #EADBCF; background: #fff; border-radius: 10px; color: #B42318; cursor: pointer; }
    .mo-add { border: 1.5px dashed #1B2A4A; background: none; color: #1B2A4A; border-radius: 12px; height: 40px; width: 100%; font-weight: 700; cursor: pointer; margin: 2px 0 6px; }
    .mo-thumb { display: block; max-width: 100%; max-height: 220px; border-radius: 12px; margin-top: 8px; }
    .mo-oid { font-size: 12px; font-weight: 600; color: #4A5568; }
    .mo-head { margin: 0 0 8px; font-size: 22px; font-weight: 700; line-height: 1.3; }
    .mo-tl { list-style: none; margin: 0 0 4px; padding: 0; }
    .mo-ti { display: flex; align-items: center; gap: 12px; min-height: 34px; font-size: 14.5px; font-weight: 500; color: #6B7280; }
    .mo-ti.done, .mo-ti.now { color: #1B2A4A; }
    .mo-ti.now { font-weight: 700; }
    .mo-td { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #CBD2DC; box-sizing: border-box; flex: none; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; }
    .mo-ti.done .mo-td { background: #1F7A4D; border-color: #1F7A4D; }
    .mo-ti.now .mo-td { border: 5px solid #FF6B35; }
    .mo-fold { width: 100%; display: flex; justify-content: space-between; align-items: center; border: 0; background: none; padding: 0; font: 700 14px 'Hind Siliguri', system-ui, sans-serif; color: #5B6B86; cursor: pointer; }
    .mo-fold-b { margin-top: 8px; }
    .mo-fold-b[hidden] { display: none; }
    .mo-btn.big { height: 62px; margin-top: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; line-height: 1.3; color: #1B2A4A; }
    .mo-btn.big.navy { background: #1B2A4A; color: #fff; }
    .mo-bt { font-size: 13px; font-weight: 600; }
    .mo-bv { font-size: 18px; font-weight: 700; }
    .mo-hero { background: #1B2A4A; color: #fff; text-align: center; }
    .mo-hero-s { font-size: 12.5px; color: #E6EAF2; }
    .mo-hero-v { font-size: 34px; font-weight: 700; }
    .mo-opt { display: flex; align-items: center; gap: 12px; }
    .mo-opt .mo-ov { font-size: 16px; font-weight: 700; color: #1B2A4A; }
    .mo-pay-s { font-size: 12.5px; color: #4A5568; }
    .mo-pay-r { display: flex; align-items: center; justify-content: space-between; margin: 2px 0 6px; }
    .mo-pay-n { font-size: 21px; font-weight: 700; letter-spacing: 1px; }
    .mo-copy { height: 34px; padding: 0 14px; border: 1.5px solid #1B2A4A; border-radius: 12px; background: #fff; color: #1B2A4A; font-size: 13px; font-weight: 600; cursor: pointer; }
    .mo-or { text-align: center; font-size: 12px; font-weight: 600; color: #4A5568; margin: 8px 0 0; }
    .mo-soft { background: transparent; box-shadow: none; padding: 0 2px; }
    .mo-who { display: flex; align-items: center; gap: 12px; }
    .mo-av { width: 44px; height: 44px; border-radius: 50%; background: #FFE9DA; color: #FF6B35; display: flex; align-items: center; justify-content: center; font-size: 18px; flex: none; }
    .mo-wn { font-size: 16px; font-weight: 700; }
    .mo-ws { font-size: 12.5px; color: #5B6B86; }
    .mo-acts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
    .mo-act { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 46px; border: 1.5px solid #1B2A4A; border-radius: 14px; background: #fff; color: #1B2A4A; font-size: 15px; font-weight: 700; text-decoration: none; cursor: pointer; }
    .mo-stars { display: flex; gap: 6px; margin: 4px 0 10px; }
    .mo-star { border: 0; background: none; font-size: 34px; line-height: 1; color: #D6DAE2; cursor: pointer; padding: 2px; }
    .mo-star.on { color: #F5A623; }
    .mo-note { font-size: 12.5px; color: #5B6B86; line-height: 1.5; margin: 8px 0 0; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { hideHeaderInApp } from '../../lib/marketChrome.js';
    hideHeaderInApp();
    import { bnNum } from '../../lib/marketApi.js';
    import { getSignedUrl } from '../../lib/storageSigned.js';
    import { compressImage } from '../../lib/imageCompress.js';
    import { confirmBestPrice, updateAskingPrice, cancelRequest, confirmDelivery, markPickupDone, submitReview } from '../../lib/deliveryClient.js';

    const $ = (id) => document.getElementById(id);
    const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    const COLS = 'id, order_no, status, is_market, order_type, market_stage, market_advance_mode, advance_verified, advance_verified_amount, purchase_total, cod_due, final_price, items_total, order_items, customer_profile_id, accepted_rider_id, shop_ids, drop_address, pickup_address, description, created_at, publish_status, cancel_reason, customer_asking_price, initial_price, pickup_done_at, pickup_lat, pickup_lng, drop_lat, drop_lng, pickup_instructions, drop_instructions, admin_offer_status, admin_offer_price, release_requested_at';

    let uid = null;
    let reqId = '';
    let R = null;       // delivery_requests রো
    let role = null;    // 'customer' | 'rider'
    let quote = null;   // সর্বশেষ কেনার দাম (pending বা সর্বশেষ)
    let contracted = false;
    let contact = null; // কাস্টমারের চোখে রাইডার, রাইডারের চোখে কাস্টমার {name, phone, vehicle}
    let reviewed = false;
    let settings = {};
    let local = { mode: 'charge', method: 'bkash', payOpen: false };
    let timer = null;
    let busy = false;

    function mk(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined && text !== null) e.textContent = text;
      return e;
    }
    function taka(n) { return '৳' + bnNum(Math.round(Number(n) || 0)); }
    function toast(m, t) { if (window.showToast) window.showToast(m, t); }
    function msgOf(err) {
      const m = (err && err.message) ? String(err.message) : '';
      return m && !/^(PGRST|JWT)/.test(m) ? m : 'কিছু একটা সমস্যা হয়েছে। আবার চেষ্টা করুন।';
    }
    function report(err, where) { if (window.SFReportError) { try { window.SFReportError(err, where); } catch (e) {} } }

    // ---------- ধাপ ----------
    // ৫ ধাপ (দাম নিশ্চিত করার আলাদা ধাপ নেই, SF-এর সিদ্ধান্ত): অর্ডার দিয়েছেন → রাইডার কনফার্ম → পেমেন্ট → কেনা ও ডেলিভারি → পৌঁছেছে
    const STEPS = ['অর্ডার দিয়েছেন', 'রাইডার কনফার্ম হয়েছে', 'পেমেন্ট', 'কেনা ও ডেলিভারি', 'পৌঁছেছে'];
    // এখনকার ধাপ (০-ভিত্তিক); ৫ = সব শেষ; -১ = বাতিল
    function stepState() {
      if (R.status === 'cancelled') return { cur: -1, head: 'অর্ডার বাতিল হয়েছে' };
      if (R.status === 'completed') return { cur: 5, head: 'ডেলিভারি সম্পন্ন হয়েছে' };
      if (R.status === 'disputed') return { cur: 3, head: 'সমস্যা জানানো হয়েছে' };
      if (R.status === 'delivered') return { cur: 4, head: 'ডেলিভারি হয়েছে, সম্পন্নের অপেক্ষা' };
      const cust = role === 'customer';
      if (R.status !== 'confirmed') {
        const offers = cust && (R.status === 'open' || R.status === 'negotiating') && R.publish_status === 'published';
        return { cur: 1, head: offers ? 'অফার দেখে রাইডার কনফার্ম করুন' : 'রাইডারের অপেক্ষা' };
      }
      const st = R.market_stage || 'awaiting_advance';
      const any = R.order_type === 'anything';
      if (st === 'advance_submitted') return { cur: 2, head: cust ? 'পেমেন্ট যাচাই চলছে' : 'পেমেন্ট যাচাই চলছে, কিছু কিনবেন না' };
      if (st === 'payment_mismatch') return { cur: 2, head: 'পেমেন্টের অঙ্ক মেলেনি' };
      if (st === 'quote_confirmed') return { cur: 3, head: R.pickup_done_at ? 'জিনিস নিয়ে পথে আছে' : (cust ? 'রাইডার জিনিস সংগ্রহ করছে' : 'জিনিস কিনে পিকআপ করুন') };
      if (any && R.purchase_total == null) return { cur: 2, head: cust ? 'রাইডার পণ্যের দাম পাঠাবে' : 'পণ্যের দাম পাঠান' };
      return { cur: 2, head: cust ? 'ডেলিভারি চার্জ বা ফুল পেমেন্ট দিন' : 'কাস্টমারের পেমেন্টের অপেক্ষা' };
    }

    function stepsCard() {
      const c = mk('section', 'mo-card');
      const ss = stepState();
      if (R.order_no) c.appendChild(mk('div', 'mo-oid', 'অর্ডার #' + R.order_no));
      const h = mk('h2', 'mo-head', ss.head);
      c.appendChild(h);
      const ol = mk('ol', 'mo-tl');
      STEPS.forEach((t, i) => {
        const cls = ss.cur < 0 ? '' : (i < ss.cur ? 'done' : (i === ss.cur ? 'now' : ''));
        const li = mk('li', 'mo-ti ' + cls);
        const dot = mk('span', 'mo-td');
        dot.setAttribute('aria-hidden', 'true');
        dot.textContent = cls === 'done' ? '✓' : '';
        li.appendChild(dot);
        li.appendChild(document.createTextNode(t));
        if (cls === 'now') li.setAttribute('aria-current', 'step');
        ol.appendChild(li);
      });
      c.appendChild(ol);
      return c;
    }

    function row(l, v, cls) {
      const r = mk('div', 'mo-row' + (cls ? ' ' + cls : ''));
      r.appendChild(mk('span', null, l));
      r.appendChild(mk('span', null, v));
      return r;
    }

    let detailsOpen = false;
    function detailsCard() {
      const c = mk('section', 'mo-card');
      const hd = mk('button', 'mo-fold');
      hd.type = 'button';
      hd.setAttribute('aria-expanded', detailsOpen ? 'true' : 'false');
      hd.appendChild(mk('span', null, 'অর্ডারের বিবরণ'));
      hd.appendChild(mk('span', 'mo-chev', detailsOpen ? '▴' : '▾'));
      const bd = mk('div', 'mo-fold-b');
      bd.hidden = !detailsOpen;
      hd.addEventListener('click', () => {
        detailsOpen = !detailsOpen;
        bd.hidden = !detailsOpen;
        hd.setAttribute('aria-expanded', detailsOpen ? 'true' : 'false');
        hd.lastChild.textContent = detailsOpen ? '▴' : '▾';
      });
      c.appendChild(hd);
      const items = Array.isArray(R.order_items) ? R.order_items : [];
      if (items.length) {
        const sn = items[0] && items[0].shop_name;
        if (sn) bd.appendChild(mk('div', 'mo-msg', sn));
        items.forEach((it) => {
          const r = mk('div', 'mo-row');
          r.appendChild(mk('span', null, String(it.name || 'আইটেম') + ' × ' + bnNum(it.qty || 1)));
          r.appendChild(mk('span', null, taka((Number(it.price) || 0) * (Number(it.qty) || 1))));
          bd.appendChild(r);
        });
        bd.appendChild(row('আইটেমের আনুমানিক দাম', taka(R.items_total)));
      } else {
        bd.appendChild(mk('p', 'mo-msg soft', R.description || ''));
      }
      if (R.final_price) bd.appendChild(row('ডেলিভারি চার্জ', taka(R.final_price)));
      bd.appendChild(mk('p', 'mo-note', 'ঠিকানা: ' + (R.drop_address || '')));
      c.appendChild(bd);
      return c;
    }

    // ---------- কাস্টমার: অগ্রিম (আর্টিফেক্ট: ট্র্যাকিংয়ে দুই বাটন → পেমেন্ট পেজ) ----------
    function advanceAmounts() {
      const charge = Number(R.final_price) || 0;
      const full = charge + (R.order_type === 'anything' ? (Number(R.purchase_total) || 0) : (Number(R.items_total) || 0));
      return { charge, full };
    }
    function advanceChoiceCard() {
      const c = mk('section', 'mo-card');
      c.appendChild(mk('div', 'mo-h', 'কতটা অগ্রিম দেবেন?'));
      if (R.market_stage === 'payment_mismatch') {
        c.appendChild(mk('p', 'mo-err', 'আপনার আগের পেমেন্ট মিলছে না। সঠিক তথ্য দিয়ে আবার জমা দিন।'));
      }
      const am = advanceAmounts();
      const two = mk('div', 'mo-2');
      [['charge', 'শুধু ডেলিভারি চার্জ', am.charge, 'mo-btn big'], ['full', 'ফুল পেমেন্ট', am.full, 'mo-btn big navy']].forEach((o) => {
        const b = mk('button', o[3]);
        b.type = 'button';
        b.appendChild(mk('span', 'mo-bt', o[1]));
        b.appendChild(mk('span', 'mo-bv', taka(o[2])));
        b.addEventListener('click', () => { local.mode = o[0]; local.amt = String(o[2]); local.payOpen = true; render(); });
        two.appendChild(b);
      });
      c.appendChild(two);
      c.appendChild(mk('p', 'mo-note', 'শুধু চার্জ দিলে বাকি সব ডেলিভারিতে (COD)। ফুল পেমেন্টে জিনিসের দামসহ, বাকি মিলিয়ে নেওয়া হবে।'));
      return c;
    }

    function advanceCard() {
      const wrapEl = document.createDocumentFragment();
      const am = advanceAmounts();
