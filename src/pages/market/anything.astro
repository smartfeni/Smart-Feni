---
// path: src/pages/market/anything.astro
// ============================================================
// মার্কেটপ্লেস (ব্রান্চ: marketplace) — "যেকোনো কিছু": /market/anything?type=anything|send|errand
//   anything (অর্ডার এনিথিং): যেকোনো দোকান/আইটেম, রাইডার কিনে আনে (দাম পরে রাইডার পাঠায়, কাস্টমার কনফার্ম করে)
//   send (পাঠান): পিকআপ + প্রাপকের ঠিকানা/ফোন, রাইডার পার্সেল পৌঁছে দেয় (অগ্রিম শুধু চার্জ)
//   errand (এনে দাও): নিজের/অন্য জায়গা থেকে জিনিস এনে দেওয়া
// অর্ডার যায় বিদ্যমান /api/delivery/create-request দিয়ে (isMarket=true, orderType)।
// বিদ্যমান LocationPicker ও OrderTimePicker কম্পোনেন্ট অপরিবর্তিত, শুধু ব্যবহার।
// সব টেক্সট textContent দিয়ে (এস্কেপ)।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import LocationPicker from '../../components/delivery/LocationPicker.astro';
import OrderTimePicker from '../../components/delivery/OrderTimePicker.astro';
import MarketLocationSheet from '../../components/market/MarketLocationSheet.astro';
---

<BaseLayout title="কুইক ডেলিভারি | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="ma-page">
    <header class="ma-top">
      <a class="ma-back" href="/market" aria-label="কুইক ডেলিভারিতে ফিরুন"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
      <h1 id="maTitle">যেকোনো কিছু</h1>
    </header>

    <form id="maForm" novalidate>
      <section class="ma-card" id="maWhatBox">
        <label class="ma-lbl" for="maWhat" id="maWhatLbl">কী লাগবে?</label>
        <textarea class="ma-in" id="maWhat" rows="3" maxlength="400" required></textarea>
        <p class="ma-hint" id="maWhatHint"></p>
      </section>

      <section class="ma-card">
        <div class="ma-h" id="maPickH">কোথা থেকে নেব?</div>
        <LocationPicker id="mapick" label="পিকআপ লোকেশন" allowAutoLocate={true} placeholder="যেমন: দোকানের নাম, বাজার, এলাকা" />
        <div id="maSendFrom" hidden>
          <label class="ma-lbl" for="maFromPhone">পিকআপ জায়গার ফোন নম্বর</label>
          <input class="ma-in" id="maFromPhone" inputmode="tel" maxlength="11" placeholder="01XXXXXXXXX" />
        </div>
      </section>

      <section class="ma-card" id="maDropOwn">
        <div class="ma-h">ডেলিভারি ঠিকানা</div>
        <div class="ma-addr" id="maDropAddr"></div>
        <button type="button" class="ma-chg" id="maDropChg">ঠিকানা বদলান</button>
        <button type="button" class="ma-chg" id="maOther" hidden>অন্য কারও ঠিকানায় পাঠান</button>
      </section>

      <section class="ma-card" id="maDropSend" hidden>
        <div class="ma-h">প্রাপকের ঠিকানা</div>
        <button type="button" class="ma-chg" id="maSelf" style="margin:0 0 10px">নিজের ঠিকানায় ফিরুন</button>
        <LocationPicker id="madrop" label="প্রাপকের ঠিকানা" allowAutoLocate={false} placeholder="যেমন: ফেনী কলেজ রোড" />
        <label class="ma-lbl" for="maToPhone">প্রাপকের ফোন নম্বর</label>
        <input class="ma-in" id="maToPhone" inputmode="tel" maxlength="11" placeholder="01XXXXXXXXX" />
      </section>

      <section class="ma-card"><OrderTimePicker id="mka" /></section>

      <section class="ma-card">
        <div class="ma-h">ডেলিভারি চার্জ</div>
        <p class="ma-hint" id="maFareHint">পিকআপের ম্যাপ পিন দিলে চার্জ অটো হিসাব হবে। না হলে নিজে লিখুন।</p>
        <input class="ma-in" id="maFare" type="number" min="1" inputmode="numeric" placeholder="টাকা" aria-label="ডেলিভারি চার্জ" />
        <p class="ma-hint">রাইডার কনফার্ম হওয়ার পর অগ্রিম দিতে হবে। <span id="maAdvNote"></span></p>
      </section>

      <p class="ma-err" id="maErr" hidden></p>
      <button class="ma-btn" id="maSubmit" type="submit">অর্ডার পাঠান</button>
    </form>

    <div id="maDone" hidden></div>
  </div>

  <MarketLocationSheet />

  <style is:global>
    .ma-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 70vh; padding: 14px 16px 120px; max-width: 560px; margin: 0 auto; }
    .ma-page * { box-sizing: border-box; }
    .ma-page button, .ma-page input, .ma-page textarea { font-family: inherit; }
    .ma-top { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .ma-top h1 { margin: 0; font-size: 20px; font-weight: 700; }
    .ma-back { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #1B2A4A; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.15); text-decoration: none; }
    .ma-card { background: #fff; border-radius: 18px; padding: 14px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.07); }
    .ma-h { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: #5B6B86; }
    .ma-lbl { display: block; margin: 0 0 6px; font-size: 14px; font-weight: 700; }
    .ma-in { width: 100%; border: 1.5px solid #EADBCF; border-radius: 12px; padding: 10px 12px; font-size: 15px; color: #1B2A4A; background: #fff; }
    .ma-in:focus { outline: 0; border-color: #1B2A4A; }
    .ma-hint { margin: 8px 0 0; font-size: 12.5px; line-height: 1.5; color: #5B6B86; }
    .ma-addr { font-size: 14.5px; line-height: 1.5; word-break: break-word; }
    .ma-chg { margin-top: 8px; border: 1.5px solid #1B2A4A; background: #fff; color: #1B2A4A; border-radius: 12px; height: 38px; padding: 0 14px; font-size: 13.5px; font-weight: 700; cursor: pointer; }
    .ma-err { margin: 10px 0 0; color: #B42318; font-size: 13.5px; font-weight: 600; }
    .ma-btn { width: 100%; height: 54px; margin-top: 10px; border: 0; border-radius: 16px; background: #FF6B35; color: #fff; font-size: 16.5px; font-weight: 700; cursor: pointer; }
    .ma-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .ma-btn:focus-visible, .ma-chg:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .ma-done { text-align: center; padding: 30px 12px; }
    .ma-done i { font-size: 44px; color: #1F7A4D; }
    .ma-done h2 { margin: 12px 0 6px; font-size: 20px; }
    .ma-done p { margin: 0 0 18px; font-size: 14.5px; line-height: 1.6; color: #5B6B86; }
    .ma-done a { display: inline-block; padding: 12px 20px; border-radius: 14px; background: #1B2A4A; color: #fff; font-weight: 700; text-decoration: none; margin: 4px; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { hideHeaderInApp } from '../../lib/marketChrome.js';
    hideHeaderInApp();
    import { getDrop } from '../../lib/marketCart.js';
    import { marketEnabledForMe } from '../../lib/marketApi.js';
    import { fetchDeliveryFare } from '../../lib/fareCalc.js';
    import { createServiceRequest } from '../../lib/deliveryClient.js';

    const $ = (id) => document.getElementById(id);
    const TYPES = {
      anything: { title: 'অর্ডার এনিথিং', what: 'কী কিনে আনতে হবে?', hint: 'জিনিসের নাম, পরিমাণ, পছন্দ লিখুন। রাইডার দোকানে গিয়ে আসল দাম পাঠাবে, আপনি কনফার্ম করলে তবেই কিনবে।', pick: 'কোথা থেকে কিনবে? (দোকান/বাজার)', ph: 'যেমন: ২ কেজি চাল, ১ লিটার তেল' },
      send: { title: 'পাঠান / এনে দাও', what: 'কী পাঠাবেন বা আনাবেন?', hint: 'জিনিসের বিবরণ ও সাইজ (ছোট/মাঝারি/বড়) লিখুন। ডিফল্টে আপনার ঠিকানায় আসবে; অন্য কাউকে পাঠাতে চাইলে নিচে ঠিকানা বদলান।', pick: 'কোথা থেকে নেব?', ph: 'যেমন: ছোট প্যাকেট, অফিসে ফেলে আসা চার্জার' },
    };
    let type = new URLSearchParams(location.search).get('type');
    if (type === 'errand') type = 'send';
    if (!TYPES[type]) type = 'anything';
    const T = TYPES[type];
    let busy = false;
    let other = false; // send: অন্য কারও ঠিকানায়?

    function mk(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined && text !== null) e.textContent = text;
      return e;
    }
    function lp(id) { return document.querySelector('[data-lp-id="' + id + '"]'); }
    function lpv(id) {
      const w = lp(id);
      const q = (c) => (w.querySelector(c) || {}).value || '';
      return {
        address: (q('.lp-out-address') || q('.lp-address-input')).trim(),
        lat: parseFloat(q('.lp-out-lat')),
        lng: parseFloat(q('.lp-out-lng')),
        upazila: q('.lp-out-upazila'),
        union: q('.lp-out-union'),
        instructions: q('.lp-out-instructions') || q('.lp-instructions-input'),
        mode: q('.lp-out-mode'),
      };
    }
    function showErr(m) { const e = $('maErr'); e.textContent = m || ''; e.hidden = !m; }
    function showDrop() {
      const d = getDrop();
      $('maDropAddr').textContent = d ? d.address : 'ঠিকানা সেট করা হয়নি';
      $('maDropChg').textContent = d ? 'ঠিকানা বদলান' : 'ঠিকানা দিন';
    }
    const okPhone = (v) => /^01[3-9][0-9]{8}$/.test(String(v || '').trim());

    async function refreshFare() {
      const pk = lpv('mapick');
      let drop = null;
      if (type === 'send' && other) { const d = lpv('madrop'); if (isFinite(d.lat) && isFinite(d.lng)) drop = { lat: d.lat, lng: d.lng }; }
      else { const d = getDrop(); if (d && d.lat !== null) drop = { lat: d.lat, lng: d.lng }; }
      if (!isFinite(pk.lat) || !isFinite(pk.lng) || !drop) return;
      const f = await fetchDeliveryFare({ pickup: { lat: pk.lat, lng: pk.lng }, drop, dropUnion: '' });
      if (f && f.fare) {
        const inp = $('maFare');
        if (!inp.dataset.touched) inp.value = String(f.fare);
        $('maFareHint').textContent = 'অটো হিসাব: ৳' + f.fare + ' (বদলাতে পারেন, তবে সর্বনিম্ন সীমার নিচে নয়)।';
      }
    }

    function setup() {
      $('maTitle').textContent = T.title;
      $('maWhatLbl').textContent = T.what;
      $('maWhat').placeholder = T.ph;
      $('maWhatHint').textContent = T.hint;
      $('maPickH').textContent = T.pick;
      $('maAdvNote').textContent = type === 'anything' ? 'অগ্রিম: শুধু ডেলিভারি চার্জ। কেনার দাম রাইডার পরে পাঠাবে।' : 'অগ্রিম: শুধু ডেলিভারি চার্জ।';
      document.title = T.title + ' | স্মার্ট ফেনী';
      if (type === 'send') {
        $('maSendFrom').hidden = false;
        $('maOther').hidden = false;
        const setOther = (v) => { other = v; $('maDropOwn').hidden = v; $('maDropSend').hidden = !v; refreshFare(); };
        $('maOther').addEventListener('click', () => setOther(true));
        $('maSelf').addEventListener('click', () => setOther(false));
      }
      showDrop();
      $('maDropChg').addEventListener('click', () => window.SFMarketLocation.open());
      window.addEventListener('smartfeni:market-drop-changed', () => { showDrop(); refreshFare(); });
      $('maFare').addEventListener('input', () => { $('maFare').dataset.touched = '1'; });
      ['mapick', 'madrop'].forEach((id) => { const w = lp(id); if (w) w.addEventListener('lp:location-changed', refreshFare); });
      $('maForm').addEventListener('submit', submit);
    }

    async function submit(ev) {
      ev.preventDefault();
      if (busy) return;
      showErr('');
      const what = $('maWhat').value.trim();
      if (!what) { showErr(T.what + ' লিখুন।'); $('maWhat').focus(); return; }
      const pk = lpv('mapick');
      if (!pk.address) { showErr('পিকআপের ঠিকানা দিন বা ম্যাপ থেকে সিলেক্ট করুন।'); return; }
      let drop; let toPhone = ''; let fromPhone = '';
      if (type === 'send') {
        fromPhone = $('maFromPhone').value.trim();
        if (!okPhone(fromPhone)) { showErr('পিকআপ জায়গার সঠিক মোবাইল নম্বর দিন (01XXXXXXXXX)।'); return; }
      }
      if (type === 'send' && other) {
        drop = lpv('madrop');
        if (!drop.address) { showErr('প্রাপকের ঠিকানা দিন।'); return; }
        toPhone = $('maToPhone').value.trim();
        if (!okPhone(toPhone)) { showErr('প্রাপকের সঠিক মোবাইল নম্বর দিন (01XXXXXXXXX)।'); return; }
      } else {
        const d = getDrop();
        if (!d) { window.SFMarketLocation.open(() => submit(ev)); return; }
        drop = { address: d.address, lat: d.lat === null ? NaN : d.lat, lng: d.lng === null ? NaN : d.lng, upazila: d.upazila, union: d.union, instructions: d.instructions };
      }
      const when = window.SFOrderTime ? window.SFOrderTime.get('mka') : null;
      if (!when || !when.ok) return;
      const fare = Number($('maFare').value);
      if (!(fare > 0)) { showErr('ডেলিভারি চার্জ দিন।'); return; }

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.openAuthModal?.('login'); return; }

      busy = true;
      const btn = $('maSubmit'); btn.disabled = true; btn.textContent = 'পাঠানো হচ্ছে...';
      const label = type === 'anything' ? 'অর্ডার এনিথিং' : 'পাঠান/এনে দাও';
      let description = 'কুইক ডেলিভারি (' + label + ') — ' + what;
      if (type === 'send') description += ' | পিকআপ ফোন: ' + fromPhone + (other ? ' | প্রাপকের ফোন: ' + toPhone : '');
      const lat = (v) => (isFinite(v) ? v : null);
      const res = await createServiceRequest({
        category: 'delivery',
        upazila: drop.upazila || pk.upazila || 'ফেনী সদর',
        pickupAddress: pk.address,
        pickupLat: lat(pk.lat),
        pickupLng: lat(pk.lng),
        pickupInstructions: pk.instructions || '',
        dropAddress: drop.address,
        dropLat: lat(drop.lat),
        dropLng: lat(drop.lng),
        dropInstructions: drop.instructions || '',
        description,
        vehicleType: 'any',
        askingPrice: fare,
        isAsap: when.isAsap,
        scheduledAt: when.scheduledAt,
        dropUnion: drop.union || '',
        pickupUpazila: pk.upazila || '',
        pickupUnion: pk.union || '',
        dropLocSource: isFinite(drop.lat) ? 'map' : 'manual',
        pickupLocSource: isFinite(pk.lat) ? 'map' : 'manual',
        fareDropLat: lat(drop.lat),
        fareDropLng: lat(drop.lng),
        farePickupLat: lat(pk.lat),
        farePickupLng: lat(pk.lng),
        isMarket: true,
        orderType: type,
      });
      busy = false;
      if (res.error) { btn.disabled = false; btn.textContent = 'অর্ডার পাঠান'; showErr(res.error); return; }
      const reqId = res.data && res.data.request && res.data.request.id;
      $('maForm').hidden = true;
      const done = $('maDone'); done.hidden = false; done.textContent = '';
      const box = mk('div', 'ma-done');
      const ic = document.createElement('i'); ic.className = 'fas fa-circle-check'; ic.setAttribute('aria-hidden', 'true');
      box.appendChild(ic);
      box.appendChild(mk('h2', null, 'অর্ডার পেয়েছি'));
      box.appendChild(mk('p', null, 'যাচাই শেষে রাইডারদের কাছে যাবে। রাইডারের অফার এলে নোটিফিকেশন পাবেন, কনফার্মের পর এখানে অগ্রিম দিতে হবে।'));
      const a1 = mk('a', null, 'অফার ও অর্ডার দেখুন'); a1.href = '/market/orders'; box.appendChild(a1);
      if (reqId) { const a2 = mk('a', null, 'অর্ডারের অবস্থা'); a2.href = '/market/order?id=' + encodeURIComponent(reqId); box.appendChild(a2); }
      done.appendChild(box);
    }

    async function init() {
      if (!(await marketEnabledForMe())) { location.replace('/market'); return; }
      setup();
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        const p = mk('p', 'ma-hint', 'অর্ডার করতে লগইন লাগবে। ');
        const a = document.createElement('a'); a.href = '/login'; a.textContent = 'লগইন করুন';
        p.appendChild(a); $('maForm').prepend(p);
      }
    }
    init();
  </script>
</BaseLayout>
