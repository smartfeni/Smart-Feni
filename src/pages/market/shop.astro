---
// path: src/pages/market/shop.astro
// ============================================================
// মার্কেটপ্লেস (ব্রান্চ: marketplace) ধাপ ৩-ক — একটা দোকানের পেজ: /market/shop?id=<shop uuid>
// মেনু ক্যাটাগরি চিপ, আইটেম (ছাড় দাম, ট্যাগ), + / − বাটন, ভাসমান কার্ট বার।
// কার্ট ফোনে সংরক্ষিত (src/lib/marketCart.js), এক কার্টে এক দোকান।
// অর্ডার/চেকআউট ধাপ ৩-খ-তে; এখানে "কার্ট দেখুন" বাটন আপাতত টোস্ট দেয়।
// ড্রপ লোকেশন না থাকলে কার্টে যোগের আগে লোকেশন শিট খোলে।
// সব টেক্সট textContent দিয়ে (এস্কেপ)।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import MarketLocationSheet from '../../components/market/MarketLocationSheet.astro';
---

<BaseLayout title="দোকান | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="ms-page">
    <a class="ms-back" href="/market" aria-label="মার্কেটে ফিরুন"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
    <div id="msHead"></div>
    <div class="ms-chips" id="msChips" role="tablist" aria-label="মেনু ক্যাটাগরি"></div>
    <div id="msBody"></div>
  </div>

  <div class="ms-bar" id="msBar" hidden>
    <button type="button" class="ms-bar-btn" id="msBarBtn">
      <span class="ms-bar-n" id="msBarN"></span>
      <span class="ms-bar-t">কার্ট দেখুন</span>
      <span class="ms-bar-p" id="msBarP"></span>
    </button>
  </div>

  <div class="ms-dlg" id="msDlg" hidden>
    <div class="ms-dlg-box" role="alertdialog" aria-modal="true" aria-labelledby="msDlgT">
      <h3 id="msDlgT">নতুন কার্ট শুরু করবেন?</h3>
      <p id="msDlgP"></p>
      <div class="ms-dlg-row">
        <button type="button" class="ms-dlg-no" id="msDlgNo">না</button>
        <button type="button" class="ms-dlg-yes" id="msDlgYes">হ্যাঁ, নতুন কার্ট</button>
      </div>
    </div>
  </div>

  <MarketLocationSheet />

  <style is:global>
    .ms-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 70vh; padding: 0 0 130px; max-width: 560px; margin: 0 auto; position: relative; overflow-x: hidden; }
    .ms-page * { box-sizing: border-box; }
    .ms-page button { font-family: inherit; }
    .ms-back { position: absolute; top: 12px; left: 12px; z-index: 3; width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #1B2A4A; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.2); text-decoration: none; }
    .ms-back:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .ms-cover { height: 170px; background: #FFDCC4; display: flex; align-items: center; justify-content: center; font-size: 56px; font-weight: 700; color: #1B2A4A; overflow: hidden; }
    .ms-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ms-info { margin: -22px 14px 0; position: relative; background: #fff; border-radius: 20px; padding: 14px 16px; box-shadow: 0 2px 10px rgba(27, 42, 74, 0.1); }
    .ms-name { font-size: 20px; font-weight: 700; }
    .ms-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 6px; font-size: 12.5px; color: #5B6B86; }
    .ms-badge { font-weight: 700; padding: 2px 8px; border-radius: 8px; background: #E3F3EA; color: #1F7A4D; }
    .ms-badge.off { background: #EEF0F4; color: #4A5568; }
    .ms-badge.test { background: #FFE9DA; color: #8A3B12; }
    .ms-note { margin: 10px 14px 0; font-size: 12.5px; color: #5B6B86; line-height: 1.5; }
    .ms-closed { margin: 10px 14px 0; padding: 10px 12px; border-radius: 12px; background: #EEF0F4; font-size: 13px; font-weight: 600; }
    .ms-chips { display: flex; gap: 8px; overflow-x: auto; padding: 14px 14px 6px; scrollbar-width: none; position: sticky; top: 0; background: #FFF4EC; z-index: 2; }
    .ms-chips::-webkit-scrollbar { display: none; }
    .ms-chip { flex: none; border: 1.5px solid #EADBCF; background: #fff; color: #1B2A4A; border-radius: 20px; padding: 7px 14px; font-size: 13.5px; font-weight: 600; cursor: pointer; }
    .ms-chip[aria-selected='true'] { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
    .ms-chip:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .ms-sec { margin: 14px 16px 8px; font-size: 16px; font-weight: 700; }
    .ms-item { display: flex; gap: 12px; align-items: center; background: #fff; border-radius: 16px; padding: 10px; margin: 0 14px 10px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.07); }
    .ms-item-img { flex: none; width: 72px; height: 72px; border-radius: 12px; background: #FFDCC4; overflow: hidden; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 24px; }
    .ms-item-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ms-item-info { flex: 1; min-width: 0; }
    .ms-item-name { font-size: 15px; font-weight: 700; }
    .ms-item-desc { font-size: 12.5px; color: #5B6B86; line-height: 1.4; margin-top: 2px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ms-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
    .ms-tag { font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 7px; background: #FFE9DA; color: #8A3B12; }
    .ms-price { margin-top: 4px; font-size: 14.5px; font-weight: 700; }
    .ms-price s { font-weight: 500; color: #8793A8; margin-left: 6px; font-size: 12.5px; }
    .ms-ctl { flex: none; display: flex; align-items: center; gap: 8px; }
    .ms-add { width: 40px; height: 40px; border: 0; border-radius: 12px; background: #FF6B35; color: #fff; font-size: 18px; cursor: pointer; }
    .ms-add:disabled { background: #C9CED8; cursor: not-allowed; }
    .ms-minus { width: 34px; height: 34px; border: 1.5px solid #EADBCF; border-radius: 10px; background: #fff; color: #1B2A4A; font-size: 15px; cursor: pointer; }
    .ms-qty { min-width: 18px; text-align: center; font-weight: 700; font-size: 15px; }
    .ms-add:focus-visible, .ms-minus:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .ms-empty { padding: 28px 16px; text-align: center; font-size: 14px; line-height: 1.6; color: #5B6B86; }
    .ms-empty a { color: #1B2A4A; font-weight: 700; }
    .ms-bar { position: fixed; left: 0; right: 0; bottom: 72px; z-index: 50; padding: 0 14px; max-width: 560px; margin: 0 auto; }
    .ms-bar[hidden] { display: none; }
    .ms-bar-btn { width: 100%; height: 54px; border: 0; border-radius: 16px; background: #1B2A4A; color: #fff; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; font-size: 15.5px; font-weight: 700; cursor: pointer; box-shadow: 0 6px 18px rgba(27, 42, 74, 0.35); }
    .ms-bar-n { min-width: 26px; height: 26px; border-radius: 8px; background: #FF6B35; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; }
    .ms-bar-btn:focus-visible { outline: 3px solid #FF6B35; outline-offset: 2px; }
    .ms-dlg { position: fixed; inset: 0; z-index: 8000; background: rgba(27, 42, 74, 0.5); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .ms-dlg[hidden] { display: none; }
    .ms-dlg-box { background: #fff; border-radius: 20px; padding: 20px; max-width: 360px; width: 100%; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; }
    .ms-dlg-box h3 { margin: 0 0 8px; font-size: 18px; }
    .ms-dlg-box p { margin: 0 0 16px; font-size: 14px; line-height: 1.55; color: #5B6B86; }
    .ms-dlg-row { display: flex; gap: 10px; }
    .ms-dlg-row button { flex: 1; height: 46px; border-radius: 14px; font-family: inherit; font-size: 14.5px; font-weight: 700; cursor: pointer; border: 0; }
    .ms-dlg-no { background: #EEF0F4; color: #1B2A4A; }
    .ms-dlg-yes { background: #FF6B35; color: #fff; }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { fetchShop, fetchShopMenu, shopOpenState, bnNum } from '../../lib/marketApi.js';
    import { getCart, addItem, decItem, cartCount, cartTotal, qtyOf, getDrop } from '../../lib/marketCart.js';

    const $ = (id) => document.getElementById(id);
    const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    let shop = null;
    let menu = { cats: [], items: [] };
    let activeCat = null; // null = সব
    let state = { open: true, label: '' };

    function toast(msg, type) { if (window.showToast) window.showToast(msg, type); }
    function mk(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined && text !== null) e.textContent = text;
      return e;
    }
    function taka(n) { return '৳' + bnNum(Math.round(Number(n) || 0)); }
    function msg(node) {
      const b = $('msBody');
      b.textContent = '';
      const p = mk('p', 'ms-empty');
      p.appendChild(node);
      b.appendChild(p);
    }

    function renderHead() {
      const h = $('msHead');
      h.textContent = '';
      const cover = mk('div', 'ms-cover');
      if (shop.image_url) {
        const im = document.createElement('img');
        im.src = shop.image_url;
        im.alt = shop.name;
        cover.appendChild(im);
      } else {
        cover.textContent = (shop.name || '?').trim().charAt(0);
      }
      h.appendChild(cover);
      const info = mk('div', 'ms-info');
      info.appendChild(mk('div', 'ms-name', shop.name));
      const meta = mk('div', 'ms-meta');
      meta.appendChild(mk('span', 'ms-badge' + (state.open ? '' : ' off'), state.label));
      if (shop.prep_minutes) meta.appendChild(mk('span', null, 'প্রস্তুতি ~' + bnNum(shop.prep_minutes) + ' মিনিট'));
      const place = [shop.union_name, shop.upazila].filter(Boolean).join(', ');
      if (place) meta.appendChild(mk('span', null, place));
      if (shop.is_test) meta.appendChild(mk('span', 'ms-badge test', 'টেস্ট শপ'));
      info.appendChild(meta);
      h.appendChild(info);
      h.appendChild(mk('p', 'ms-note', 'দাম আনুমানিক। রাইডার দোকান থেকে কিনে চূড়ান্ত দাম জানাবে, আপনি কনফার্ম করলে তবেই এগোবে।'));
      if (!state.open) h.appendChild(mk('div', 'ms-closed', 'দোকান এখন ' + state.label + '। কার্টে যোগ করা যাবে না।'));
      document.title = shop.name + ' | স্মার্ট ফেনী';
    }

    function renderChips() {
      const box = $('msChips');
      box.textContent = '';
      const used = menu.cats.filter((c) => menu.items.some((i) => i.category_id === c.id));
      if (used.length < 1) { box.hidden = true; return; }
      box.hidden = false;
      const list = [{ id: null, name: 'সব' }].concat(used);
      list.forEach((c) => {
        const b = mk('button', 'ms-chip', c.name);
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', c.id === activeCat ? 'true' : 'false');
        b.addEventListener('click', () => { activeCat = c.id; renderChips(); renderItems(); });
        box.appendChild(b);
      });
    }

    function itemRow(it) {
      const row = mk('div', 'ms-item');
      const img = mk('div', 'ms-item-img');
      if (it.image_url) {
        const im = document.createElement('img');
        im.src = it.image_url;
        im.alt = it.name;
        im.loading = 'lazy';
        img.appendChild(im);
      } else {
        img.textContent = (it.name || '?').trim().charAt(0);
      }
      const info = mk('div', 'ms-item-info');
      info.appendChild(mk('div', 'ms-item-name', it.name));
      if (it.description) info.appendChild(mk('div', 'ms-item-desc', it.description));
      const tags = Array.isArray(it.tags) ? it.tags.filter(Boolean) : [];
      if (tags.length) {
        const t = mk('div', 'ms-tags');
        tags.slice(0, 3).forEach((x) => t.appendChild(mk('span', 'ms-tag', String(x))));
        info.appendChild(t);
      }
      const pr = mk('div', 'ms-price', taka(it.price));
      if (it.old_price && Number(it.old_price) > Number(it.price)) pr.appendChild(mk('s', null, taka(it.old_price)));
      info.appendChild(pr);

      const ctl = mk('div', 'ms-ctl');
      const n = qtyOf(it.id);
      if (n > 0) {
        const m = mk('button', 'ms-minus', '−');
        m.type = 'button';
        m.setAttribute('aria-label', it.name + ' কমান');
        m.addEventListener('click', () => { decItem(it.id); });
        ctl.appendChild(m);
        ctl.appendChild(mk('span', 'ms-qty', bnNum(n)));
      }
      const a = mk('button', 'ms-add', '+');
      a.type = 'button';
      a.setAttribute('aria-label', it.name + ' কার্টে যোগ করুন');
      a.disabled = !state.open;
      a.addEventListener('click', () => tryAdd(it));
      ctl.appendChild(a);

      row.appendChild(img);
      row.appendChild(info);
      row.appendChild(ctl);
      return row;
    }

    function renderItems() {
      const body = $('msBody');
      body.textContent = '';
      const items = menu.items.filter((i) => activeCat === null || i.category_id === activeCat);
      if (!items.length) {
        body.appendChild(mk('p', 'ms-empty', 'এই দোকানের মেনু এখনো যোগ হয়নি।'));
        return;
      }
      if (activeCat === null && menu.cats.length) {
        // ক্যাটাগরি অনুযায়ী গ্রুপ; ক্যাটাগরিহীন আইটেম শেষে "অন্যান্য"
        const groups = menu.cats.map((c) => ({ name: c.name, list: items.filter((i) => i.category_id === c.id) }));
        groups.push({ name: 'অন্যান্য', list: items.filter((i) => !menu.cats.some((c) => c.id === i.category_id)) });
        groups.forEach((g) => {
          if (!g.list.length) return;
          body.appendChild(mk('h2', 'ms-sec', g.name));
          g.list.forEach((i) => body.appendChild(itemRow(i)));
        });
      } else {
        items.forEach((i) => body.appendChild(itemRow(i)));
      }
    }

    function renderBar() {
      const c = getCart();
      const n = cartCount(c);
      $('msBar').hidden = n === 0;
      $('msBarN').textContent = bnNum(n);
      $('msBarP').textContent = taka(cartTotal(c));
    }

    // ---------- কার্টে যোগ ----------
    function doAdd(it, replace) {
      const r = addItem({ id: shop.id, name: shop.name }, it, { replace });
      if (r === 'max') toast('এর বেশি যোগ করা যাবে না।', 'error');
    }
    function tryAdd(it) {
      if (!getDrop()) {
        // আগে ড্রপ লোকেশন; সেট হলে আইটেম যোগ হবে
        window.SFMarketLocation.open(() => tryAdd(it));
        return;
      }
      const r = addItem({ id: shop.id, name: shop.name }, it);
      if (r === 'other_shop') {
        const c = getCart();
        $('msDlgP').textContent = 'আপনার কার্টে "' + c.shopName + '" থেকে আইটেম আছে। এক অর্ডারে এক দোকান। নতুন কার্ট শুরু করলে আগেরটা মুছে যাবে।';
        $('msDlg').hidden = false;
        $('msDlgYes').onclick = () => { $('msDlg').hidden = true; doAdd(it, true); };
        $('msDlgNo').onclick = () => { $('msDlg').hidden = true; };
        $('msDlgNo').focus();
      } else if (r === 'max') {
        toast('এর বেশি যোগ করা যাবে না।', 'error');
      }
    }

    $('msBarBtn').addEventListener('click', () => { location.href = '/market/checkout'; });
    window.addEventListener('smartfeni:market-cart-changed', () => { renderBar(); if (shop) renderItems(); });

    async function init() {
      const id = new URLSearchParams(location.search).get('id') || '';
      if (!UUID.test(id)) { msg(document.createTextNode('দোকান পাওয়া যায়নি।')); return; }
      msg(document.createTextNode('লোড হচ্ছে...'));
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        const frag = document.createDocumentFragment();
        frag.appendChild(document.createTextNode('দোকান দেখতে '));
        const a = document.createElement('a');
        a.href = '/login';
        a.textContent = 'লগইন করুন';
        frag.appendChild(a);
        msg(frag);
        return;
      }
      try {
        shop = await fetchShop(id);
        if (!shop) { msg(document.createTextNode('দোকান পাওয়া যায়নি।')); return; }
        menu = await fetchShopMenu(id);
      } catch (err) {
        if (window.SFReportError) { try { window.SFReportError(err, 'market-shop-load'); } catch (e) {} }
        msg(document.createTextNode('লোড করতে সমস্যা হয়েছে। একটু পরে আবার চেষ্টা করুন।'));
        return;
      }
      state = shopOpenState(shop);
      renderHead();
      renderChips();
      renderItems();
      renderBar();
    }

    init();
  </script>
</BaseLayout>
