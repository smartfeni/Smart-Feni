---
// ============================================================
// পেজ: /cart — কার্টের প্রোডাক্ট (শপ অনুযায়ী গ্রুপ করে দেখায়,
// কারণ এক কার্টে একাধিক শপের প্রোডাক্ট থাকতে পারে)
// quantity +/-, রিমুভ, এবং /checkout এ যাওয়ার বাটন
//
// UI REDESIGN (v2):
// - ক্লিনার শপ-গ্রুপ কার্ড হেডার, বড় qty stepper পিল
// - মোবাইলে sticky total + checkout bar
// - পলিশড empty/login state
// - priceNum() আপডেট: বাংলা সংখ্যা + "৳/টাকা/কেজি/পিস" ইউনিট-টেক্সট
//   থাকলেও শুধু সংখ্যাটা বের করে হিসাব করে (যেমন "৫০০ টাকা/কেজি" → 500)
//
// FIX (v2.1): <style> কে is:global করা হয়েছে — শপ-গ্রুপ/প্রোডাক্ট রো
// গুলো JS দিয়ে innerHTML এ রানটাইমে তৈরি হয়, তাই Astro-র ডিফল্ট
// scoped CSS ওগুলোতে অ্যাপ্লাই হচ্ছিল না (স্টাইলহীন প্লেইন দেখাচ্ছিল)
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="আমার কার্ট | স্মার্ট ফেনী">
  <div class="cart-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <div class="status-icon-badge"><i class="fas fa-lock"></i></div>
        <h2>লগইন করুন</h2>
        <p>কার্ট দেখতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="cartContent" style="display:none;">
        <h1 class="cart-title"><i class="fas fa-cart-shopping"></i> আমার কার্ট</h1>

        <div id="emptyCart" class="status-box" style="display:none;">
          <div class="status-icon-badge"><i class="fas fa-cart-arrow-down"></i></div>
          <h2>কার্ট খালি</h2>
          <p>কোনো শপ থেকে প্রোডাক্ট কার্টে যোগ করুন</p>
          <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
        </div>

        <div id="shopGroupsContainer"></div>

        <div id="cartFooterSpacer" style="display:none;"></div>
      </div>

    </div>

    <div id="cartFooter" class="cart-footer" style="display:none;">
      <div class="container">
        <div class="cart-footer-inner">
          <div class="grand-total-block">
            <span class="grand-total-label">সর্বমোট</span>
            <span id="grandTotal" class="grand-total-value">৳0</span>
          </div>
          <button class="checkout-btn" id="checkoutBtn" type="button">
            চেকআউট <i class="fas fa-arrow-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    .cart-page {
      min-height: 70vh;
      padding: 28px 0 40px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 50px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-icon-badge {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFF0EA, #FFE3D5);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }

    .status-icon-badge i {
      font-size: 1.7rem;
      color: #FF6B35;
    }

    .status-box h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    .primary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 12px 26px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
      transition: all 0.2s ease;
    }

    .primary-link-btn:hover {
      background: #e85a28;
      transform: translateY(-1px);
    }

    .cart-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .cart-title i {
      color: #FF6B35;
    }

    #shopGroupsContainer {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .shop-group {
      background: #fff;
      border-radius: 20px;
      padding: 16px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
      border: 1px solid #F0F3F8;
    }

    .shop-group-header {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.9rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px dashed #E5EAF0;
    }

    .shop-group-header .shop-icon-badge {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      flex-shrink: 0;
    }

    .cart-item-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
    }

    .cart-item-row + .cart-item-row {
      border-top: 1px solid #F5F7FA;
    }

    .cart-item-photo {
      width: 58px;
      height: 58px;
      border-radius: 14px;
      object-fit: cover;
      background: #F4F7FC;
      flex-shrink: 0;
    }

    .cart-item-icon {
      width: 58px;
      height: 58px;
      border-radius: 14px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 1.1rem;
    }

    .cart-item-info {
      flex: 1;
      min-width: 0;
    }

    .cart-item-title {
      font-size: 0.87rem;
      font-weight: 700;
      color: #1B2A4A;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin-bottom: 3px;
    }

    .cart-item-price {
      font-size: 0.8rem;
      color: #FF6B35;
      font-weight: 700;
    }

    .qty-controls {
      display: flex;
      align-items: center;
      gap: 2px;
      flex-shrink: 0;
      background: #F4F7FC;
      border-radius: 30px;
      padding: 3px;
    }

    .qty-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #fff;
      color: #1B2A4A;
      border: none;
      font-size: 0.72rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
      transition: all 0.15s ease;
    }

    .qty-btn:active {
      transform: scale(0.9);
    }

    .qty-value {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1B2A4A;
      min-width: 24px;
      text-align: center;
    }

    .remove-btn {
      background: #FFF0EA;
      border: none;
      color: #D14343;
      font-size: 0.78rem;
      cursor: pointer;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-left: 4px;
      transition: all 0.15s ease;
    }

    .remove-btn:hover {
      background: #D14343;
      color: #fff;
    }

    .shop-subtotal {
      display: flex;
      justify-content: space-between;
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-top: 10px;
      padding-top: 12px;
      border-top: 1px dashed #E5EAF0;
    }

    #cartFooterSpacer {
      height: 92px;
    }

    .cart-footer {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      background: #fff;
      box-shadow: 0 -6px 24px rgba(15, 23, 42, 0.08);
      padding: 12px 0;
      z-index: 999;
      border-top: 1px solid #F0F3F8;
    }

    .cart-footer-inner {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .grand-total-block {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .grand-total-label {
      font-size: 0.72rem;
      color: #8FA0BC;
      font-weight: 600;
    }

    .grand-total-value {
      font-size: 1.2rem;
      font-weight: 800;
      color: #1B2A4A;
    }

    .checkout-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 15px 30px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      box-shadow: 0 10px 22px rgba(255, 107, 53, 0.32);
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .checkout-btn:hover {
      background: #e85a28;
      transform: translateY(-1px);
    }

    @media (max-width: 480px) {
      .cart-item-photo,
      .cart-item-icon {
        width: 50px;
        height: 50px;
      }

      .checkout-btn {
        padding: 13px 22px;
        font-size: 0.86rem;
      }
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const cartContent = document.getElementById('cartContent');
    const emptyCart = document.getElementById('emptyCart');
    const shopGroupsContainer = document.getElementById('shopGroupsContainer');
    const cartFooter = document.getElementById('cartFooter');
    const cartFooterSpacer = document.getElementById('cartFooterSpacer');
    const grandTotal = document.getElementById('grandTotal');
    const checkoutBtn = document.getElementById('checkoutBtn');

    let currentUserId = null;

    // বাংলা সংখ্যা → ইংরেজি সংখ্যা কনভার্টার
    function convertBanglaDigits(str) {
      const banglaDigits = '০১২৩৪৫৬৭৮৯';
      return String(str).replace(/[০-৯]/g, (d) => banglaDigits.indexOf(d));
    }

    // দাম স্ট্রিং থেকে শুধু সংখ্যাটা বের করে আনে —
    // "৫০০ টাকা/কেজি", "৳৫০০ প্রতি পিস", "৫,৫০০", "৳৫০০/পাউন্ড" — সবই সঠিকভাবে পার্স হয়
    function priceNum(p) {
      if (p === null || p === undefined) return 0;
      let str = convertBanglaDigits(String(p));
      str = str.replace(/,/g, ''); // কমা সরানো (৫,৫০০ → ৫৫০০)
      const match = str.match(/[0-9]+(\.[0-9]+)?/);
      if (!match) return 0;
      const n = parseFloat(match[0]);
      return isNaN(n) ? 0 : n;
    }

    async function loadCart() {
      const { data: cartItems, error } = await supabase
        .from('cart_items')
        .select('id, quantity, listing_id, listings(id, title, price, images, user_id)')
        .eq('user_id', currentUserId);

      if (error) {
        console.error('কার্ট লোড এরর:', error.message);
        return;
      }

      const items = (cartItems || []).filter((c) => c.listings);

      loadingState.style.display = 'none';
      cartContent.style.display = 'block';

      if (items.length === 0) {
        emptyCart.style.display = 'block';
        shopGroupsContainer.innerHTML = '';
        cartFooter.style.display = 'none';
        cartFooterSpacer.style.display = 'none';
        return;
      }

      emptyCart.style.display = 'none';

      const ownerIds = [...new Set(items.map((i) => i.listings.user_id))];
      const { data: shops } = await supabase.from('shops').select('*').in('owner_id', ownerIds);
      const shopByOwner = {};
      (shops || []).forEach((s) => { shopByOwner[s.owner_id] = s; });

      const groups = {};
      items.forEach((item) => {
        const ownerId = item.listings.user_id;
        if (!groups[ownerId]) groups[ownerId] = [];
        groups[ownerId].push(item);
      });

      shopGroupsContainer.innerHTML = '';
      let grand = 0;

      Object.entries(groups).forEach(([ownerId, groupItems]) => {
        const shop = shopByOwner[ownerId];
        const shopName = shop?.name || 'অজানা শপ';

        const groupEl = document.createElement('div');
        groupEl.className = 'shop-group';

        let subtotal = 0;
        const rowsHtml = groupItems.map((item) => {
          const listing = item.listings;
          const unitPrice = priceNum(listing.price);
          const lineTotal = unitPrice * item.quantity;
          subtotal += lineTotal;

          const photoHtml = listing.images && listing.images.length > 0
            ? `<img src="${listing.images[0]}" class="cart-item-photo" alt="${listing.title || ''}" />`
            : `<div class="cart-item-icon"><i class="fas fa-box"></i></div>`;

          return `
            <div class="cart-item-row" data-cart-id="${item.id}">
              ${photoHtml}
              <div class="cart-item-info">
                <p class="cart-item-title">${listing.title || ''}</p>
                <p class="cart-item-price">৳${unitPrice}</p>
              </div>
              <div class="qty-controls">
                <button class="qty-btn qty-minus"><i class="fas fa-minus"></i></button>
                <span class="qty-value">${item.quantity}</span>
                <button class="qty-btn qty-plus"><i class="fas fa-plus"></i></button>
              </div>
              <button class="remove-btn"><i class="fas fa-trash"></i></button>
            </div>
          `;
        }).join('');

        groupEl.innerHTML = `
          <div class="shop-group-header"><span class="shop-icon-badge"><i class="fas fa-store"></i></span> ${shopName}</div>
          ${rowsHtml}
          <div class="shop-subtotal"><span>সাবটোটাল</span><span>৳${subtotal}</span></div>
        `;

        grand += subtotal;
        shopGroupsContainer.appendChild(groupEl);
      });

      grandTotal.textContent = `৳${grand}`;
      cartFooter.style.display = 'block';
      cartFooterSpacer.style.display = 'block';

      attachRowHandlers();
    }

    function attachRowHandlers() {
      document.querySelectorAll('.cart-item-row').forEach((row) => {
        const cartId = row.dataset.cartId;

        row.querySelector('.qty-plus')?.addEventListener('click', async () => {
          const qtyEl = row.querySelector('.qty-value');
          const newQty = parseInt(qtyEl.textContent) + 1;
          await supabase.from('cart_items').update({ quantity: newQty }).eq('id', cartId);
          loadCart();
        });

        row.querySelector('.qty-minus')?.addEventListener('click', async () => {
          const qtyEl = row.querySelector('.qty-value');
          const currentQty = parseInt(qtyEl.textContent);
          if (currentQty <= 1) return;
          await supabase.from('cart_items').update({ quantity: currentQty - 1 }).eq('id', cartId);
          loadCart();
        });

        row.querySelector('.remove-btn')?.addEventListener('click', async () => {
          await supabase.from('cart_items').delete().eq('id', cartId);
          loadCart();
        });
      });
    }

    checkoutBtn?.addEventListener('click', () => {
      window.location.href = '/checkout';
    });

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;
      await loadCart();
    }

    init();
  </script>
</BaseLayout>
