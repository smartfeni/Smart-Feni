---
// ============================================================
// পেজ: /cart — কার্টের প্রোডাক্ট (শপ অনুযায়ী গ্রুপ করে দেখায়,
// কারণ এক কার্টে একাধিক শপের প্রোডাক্ট থাকতে পারে)
// quantity +/-, রিমুভ, এবং /checkout এ যাওয়ার বাটন
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="আমার কার্ট | স্মার্ট ফেনী">
  <div class="cart-page">
    <div class="container">

      <div id="loadingState" class="loading-state">
        <div class="spinner"></div>
        <p>লোড হচ্ছে...</p>
      </div>

      <div id="loginRequired" class="status-box" style="display:none;">
        <i class="fas fa-lock"></i>
        <h2>লগইন করুন</h2>
        <p>কার্ট দেখতে আগে লগইন করতে হবে</p>
        <a href="/" class="primary-link-btn">হোমপেজে যান</a>
      </div>

      <div id="cartContent" style="display:none;">
        <h1 class="cart-title"><i class="fas fa-cart-shopping"></i> আমার কার্ট</h1>

        <div id="emptyCart" class="status-box" style="display:none;">
          <i class="fas fa-cart-arrow-down"></i>
          <h2>কার্ট খালি</h2>
          <p>কোনো শপ থেকে প্রোডাক্ট কার্টে যোগ করুন</p>
          <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
        </div>

        <div id="shopGroupsContainer"></div>

        <div id="cartFooter" class="cart-footer" style="display:none;">
          <div class="grand-total-row">
            <span>সর্বমোট</span>
            <span id="grandTotal">৳0</span>
          </div>
          <button class="checkout-btn" id="checkoutBtn" type="button">
            <i class="fas fa-arrow-right"></i> চেকআউট করুন
          </button>
        </div>
      </div>

    </div>
  </div>

  <style>
    .cart-page {
      min-height: 70vh;
      padding: 32px 0 100px;
      background: #F8FAFC;
    }

    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 120px 0;
      color: #5A6E85;
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #E5EAF0;
      border-top-color: #FF6B35;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .status-box {
      max-width: 420px;
      margin: 60px auto;
      text-align: center;
      background: #fff;
      border-radius: 24px;
      padding: 44px 28px;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    .status-box i {
      font-size: 2.4rem;
      color: #FF6B35;
      margin-bottom: 16px;
    }

    .status-box h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 8px;
    }

    .status-box p {
      color: #5A6E85;
      font-size: 0.88rem;
      margin-bottom: 18px;
    }

    .primary-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      text-decoration: none;
      padding: 11px 24px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.88rem;
    }

    .cart-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #1B2A4A;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .cart-title i {
      color: #FF6B35;
    }

    #shopGroupsContainer {
      max-width: 640px;
      margin: 0 auto;
    }

    .shop-group {
      background: #fff;
      border-radius: 20px;
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .shop-group-header {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.92rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid #F0F3F8;
    }

    .shop-group-header i {
      color: #FF6B35;
    }

    .cart-item-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
    }

    .cart-item-row + .cart-item-row {
      border-top: 1px solid #F5F7FA;
    }

    .cart-item-photo {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      object-fit: cover;
      background: #F4F7FC;
      flex-shrink: 0;
    }

    .cart-item-icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: #FFF0EA;
      color: #FF6B35;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .cart-item-info {
      flex: 1;
      min-width: 0;
    }

    .cart-item-title {
      font-size: 0.86rem;
      font-weight: 700;
      color: #1B2A4A;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cart-item-price {
      font-size: 0.8rem;
      color: #FF6B35;
      font-weight: 700;
      margin-top: 2px;
    }

    .qty-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .qty-btn {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: #F4F7FC;
      color: #1B2A4A;
      border: none;
      font-size: 0.78rem;
      cursor: pointer;
    }

    .qty-value {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1B2A4A;
      min-width: 16px;
      text-align: center;
    }

    .remove-btn {
      background: none;
      border: none;
      color: #D14343;
      font-size: 0.85rem;
      cursor: pointer;
      padding: 4px 6px;
      flex-shrink: 0;
    }

    .shop-subtotal {
      display: flex;
      justify-content: space-between;
      font-size: 0.84rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid #F0F3F8;
    }

    .cart-footer {
      max-width: 640px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .grand-total-row {
      display: flex;
      justify-content: space-between;
      font-size: 1rem;
      font-weight: 700;
      color: #1B2A4A;
      margin-bottom: 14px;
    }

    .checkout-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF6B35;
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';

    const loadingState = document.getElementById('loadingState');
    const loginRequired = document.getElementById('loginRequired');
    const cartContent = document.getElementById('cartContent');
    const emptyCart = document.getElementById('emptyCart');
    const shopGroupsContainer = document.getElementById('shopGroupsContainer');
    const cartFooter = document.getElementById('cartFooter');
    const grandTotal = document.getElementById('grandTotal');
    const checkoutBtn = document.getElementById('checkoutBtn');

    let currentUserId = null;

    function priceNum(p) {
      const n = parseFloat(String(p).replace(/[^0-9.]/g, ''));
      return isNaN(n) ? 0 : n;
    }

    async function loadCart() {
      const { data: cartItems, error } = await supabase
        .from('cart_items')
        .select('id, quantity, listing_id, listings(id, title, price, images, user_id)')
        .eq('user_id', currentUserId);

      if (error) {
        console.error('কার্ট লোড এরর:', error.message);
        return;
      }

      const items = (cartItems || []).filter((c) => c.listings);

      loadingState.style.display = 'none';
      cartContent.style.display = 'block';

      if (items.length === 0) {
        emptyCart.style.display = 'block';
        shopGroupsContainer.innerHTML = '';
        cartFooter.style.display = 'none';
        return;
      }

      emptyCart.style.display = 'none';

      const ownerIds = [...new Set(items.map((i) => i.listings.user_id))];
      const { data: shops } = await supabase.from('shops').select('*').in('owner_id', ownerIds);
      const shopByOwner = {};
      (shops || []).forEach((s) => { shopByOwner[s.owner_id] = s; });

      const groups = {};
      items.forEach((item) => {
        const ownerId = item.listings.user_id;
        if (!groups[ownerId]) groups[ownerId] = [];
        groups[ownerId].push(item);
      });

      shopGroupsContainer.innerHTML = '';
      let grand = 0;

      Object.entries(groups).forEach(([ownerId, groupItems]) => {
        const shop = shopByOwner[ownerId];
        const shopName = shop?.name || 'অজানা শপ';

        const groupEl = document.createElement('div');
        groupEl.className = 'shop-group';

        let subtotal = 0;
        const rowsHtml = groupItems.map((item) => {
          const listing = item.listings;
          const lineTotal = priceNum(listing.price) * item.quantity;
          subtotal += lineTotal;

          const photoHtml = listing.images && listing.images.length > 0
            ? `<img src="${listing.images[0]}" class="cart-item-photo" alt="${listing.title || ''}" />`
            : `<div class="cart-item-icon"><i class="fas fa-box"></i></div>`;

          return `
            <div class="cart-item-row" data-cart-id="${item.id}">
              ${photoHtml}
              <div class="cart-item-info">
                <p class="cart-item-title">${listing.title || ''}</p>
                <p class="cart-item-price">৳${listing.price || 0}</p>
              </div>
              <div class="qty-controls">
                <button class="qty-btn qty-minus"><i class="fas fa-minus"></i></button>
                <span class="qty-value">${item.quantity}</span>
                <button class="qty-btn qty-plus"><i class="fas fa-plus"></i></button>
              </div>
              <button class="remove-btn"><i class="fas fa-trash"></i></button>
            </div>
          `;
        }).join('');

        groupEl.innerHTML = `
          <div class="shop-group-header"><i class="fas fa-store"></i> ${shopName}</div>
          ${rowsHtml}
          <div class="shop-subtotal"><span>সাবটোটাল</span><span>৳${subtotal}</span></div>
        `;

        grand += subtotal;
        shopGroupsContainer.appendChild(groupEl);
      });

      grandTotal.textContent = `৳${grand}`;
      cartFooter.style.display = 'block';

      attachRowHandlers();
    }

    function attachRowHandlers() {
      document.querySelectorAll('.cart-item-row').forEach((row) => {
        const cartId = row.dataset.cartId;

        row.querySelector('.qty-plus')?.addEventListener('click', async () => {
          const qtyEl = row.querySelector('.qty-value');
          const newQty = parseInt(qtyEl.textContent) + 1;
          await supabase.from('cart_items').update({ quantity: newQty }).eq('id', cartId);
          loadCart();
        });

        row.querySelector('.qty-minus')?.addEventListener('click', async () => {
          const qtyEl = row.querySelector('.qty-value');
          const currentQty = parseInt(qtyEl.textContent);
          if (currentQty <= 1) return;
          await supabase.from('cart_items').update({ quantity: currentQty - 1 }).eq('id', cartId);
          loadCart();
        });

        row.querySelector('.remove-btn')?.addEventListener('click', async () => {
          await supabase.from('cart_items').delete().eq('id', cartId);
          loadCart();
        });
      });
    }

    checkoutBtn?.addEventListener('click', () => {
      window.location.href = '/checkout';
    });

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        loadingState.style.display = 'none';
        loginRequired.style.display = 'block';
        return;
      }

      currentUserId = session.user.id;
      await loadCart();
    }

    init();
  </script>
</BaseLayout>