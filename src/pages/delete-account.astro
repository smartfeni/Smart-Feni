---
// path: src/pages/delete-account.astro
// ============================================================
// পেজ: অ্যাকাউন্ট ডিলিট করার নিয়ম (/delete-account) — পাবলিক
// Play Console → Data safety → "Account deletion URL"-এ এই লিংক দিতে হবে:
//   https://smartfeni.com/delete-account
// ইউজার নিজে profile/edit থেকে ডিলিট করে; ৭ দিনের গ্রেস পিরিয়ড আছে।
// লগইন করতে না পারলে ইমেইলে অনুরোধ করা যায় (info@smartfeni.com)।
// ============================================================
import Layout from '../components/layout/BaseLayout.astro';
const lastUpdated = '১৮ অক্টোবর, ২০২৬';
---

<Layout title="অ্যাকাউন্ট ডিলিট | স্মার্ট ফেনী">
  <main style="max-width: 800px; margin: 0 auto; padding: 40px 20px; color: #1B2A4A; line-height: 1.8;">
    <h1 style="font-size: 28px; margin-bottom: 8px;">অ্যাকাউন্ট ডিলিট করুন</h1>
    <p style="color: #64748B; margin-bottom: 32px;">সর্বশেষ আপডেট: {lastUpdated}</p>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">কীভাবে ডিলিট করবেন</h2>
      <ol style="padding-left: 20px;">
        <li>স্মার্ট ফেনী অ্যাপে বা <strong>smartfeni.com</strong>-এ আপনার অ্যাকাউন্টে লগইন করুন</li>
        <li>মেনু থেকে <strong>প্রোফাইল</strong>-এ যান</li>
        <li>প্রোফাইল পেজে <strong>"এডিট করুন"</strong> চাপুন</li>
        <li>এডিট ফর্মের একদম নিচে <strong>"ডেঞ্জার জোন"</strong>-এ <strong>"অ্যাকাউন্ট ডিলিট করুন"</strong> চাপুন</li>
        <li>নিশ্চিত করতে <strong>DELETE</strong> লিখে কনফার্ম করুন</li>
      </ol>
      <p style="margin-top: 16px;">
        <a href="/profile/edit" style="display: inline-block; background: #FF6B35; color: #fff; text-decoration: none; font-weight: 700; padding: 12px 22px; border-radius: 12px;">
          প্রোফাইলে যান
        </a>
      </p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">৭ দিনের অপেক্ষা (ফিরিয়ে আনার সুযোগ)</h2>
      <p>ডিলিটের অনুরোধ দেওয়ার পর আপনার অ্যাকাউন্ট সাথে সাথে মুছে যায় না। ৭ দিন অপেক্ষায় থাকে:</p>
      <ul style="margin-top: 10px; padding-left: 20px;">
        <li>আপনার পোস্ট/লিস্টিং সাথে সাথে সবার কাছ থেকে লুকিয়ে যায়</li>
        <li>ব্লাড ডোনার তালিকা থেকে সরে যান এবং সব ডিভাইস থেকে লগআউট হয়ে যান, নোটিফিকেশন বন্ধ হয়</li>
        <li>এই ৭ দিনের মধ্যে আবার লগইন করলে <strong>"অ্যাকাউন্ট ফিরিয়ে আনুন"</strong> অপশন আসবে, এক ট্যাপে সব আগের মতো চালু হবে</li>
        <li>৭ দিন পার হলে স্বয়ংক্রিয়ভাবে স্থায়ীভাবে ডিলিট হয়, তখন আর ফেরানো যায় না</li>
      </ul>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">স্থায়ী ডিলিটে কী মুছে যায়</h2>
      <ul style="padding-left: 20px;">
        <li>প্রোফাইল (নাম, ফোন নম্বর, ইমেইল, উপজেলা, ব্লাড গ্রুপ, প্রোফাইল ছবি)</li>
        <li>আপনার সব লিস্টিং ও সেগুলোর ছবি</li>
        <li>ব্লাড ডোনার তথ্য, ডেলিভারি/রাইড রিকোয়েস্ট ও চ্যাট</li>
        <li>রাইডার হলে রাইডার প্রোফাইল ও ভেরিফিকেশন ডকুমেন্ট (NID ছবি সহ)</li>
        <li>রেফার পয়েন্ট ও রেফার সংক্রান্ত তথ্য (বাতিল হয়ে যায়)</li>
        <li>পুশ নোটিফিকেশন ডিভাইস রেজিস্ট্রেশন</li>
      </ul>
      <p style="margin-top: 12px;">
        শপ থেকে করা অর্ডারের লেনদেন-রেকর্ড আপনার অ্যাকাউন্টের সাথে সংযোগ ছাড়া হিসাব ও বিরোধ নিষ্পত্তির জন্য সীমিত সময় থাকতে পারে।
        এছাড়া নিরাপত্তা ও অপব্যবহার প্রতিরোধের জন্য আইনি প্রয়োজনে যতটুকু রাখা বাধ্যতামূলক, শুধু ততটুকুই থাকে।
      </p>
    </section>

    <section style="margin-bottom: 28px;">
      <h2 style="font-size: 20px; margin-bottom: 10px;">কখন ডিলিট করা যাবে না</h2>
      <p>নিচের কোনো একটা থাকলে আগে সেটা শেষ বা ঠিক করতে হবে, তারপর ডিলিট করা যাবে:</p>
      <ul style="margin-top: 10px; padding-left: 20px;">
        <li>চলমান ডেলিভারি বা রাইড রিকোয়েস্ট আছে</li>
        <li>আপনি কোনো ক্লাব বা অনলাইন শপের ওউনার (আগে মালিকানা অন্য কাউকে দিতে হবে বা সেটা বন্ধ করতে হবে)</li>
        <li>রেফার পয়েন্ট উইথড্র রিকোয়েস্ট চলমান আছে</li>
      </ul>
    </section>

    <section>
      <h2 style="font-size: 20px; margin-bottom: 10px;">লগইন করতে পারছেন না?</h2>
      <p>
        অ্যাকাউন্টে ঢুকতে না পারলে আপনার নাম ও রেজিস্টার্ড ফোন নম্বর দিয়ে ইমেইল করুন:
        <a href="mailto:info@smartfeni.com?subject=অ্যাকাউন্ট ডিলিটের অনুরোধ" style="color: #FF6B35;">info@smartfeni.com</a>।
        পরিচয় যাচাইয়ের পর আমরা অনুরোধ প্রসেস করব।
      </p>
      <p style="margin-top: 12px;">বিস্তারিত জানতে <a href="/privacy-policy" style="color: #FF6B35;">প্রাইভেসি পলিসি</a> দেখুন।</p>
    </section>
  </main>
</Layout>
