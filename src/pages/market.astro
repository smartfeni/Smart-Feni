---
// path: src/pages/market.astro
// ============================================================
// কাস্টমারের নতুন মার্কেট হোম (/market) — মার্কেটপ্লেস ধাপ ২ (ব্রান্চ: marketplace)।
// শুধু দেখা: ক্যাটাগরি ট্যাব + সার্চ + ব্যানার + দোকানের তালিকা। কার্ট/অর্ডার পরের ধাপে।
// বিদ্যমান ডেলিভারি/কুরিয়ার ফ্লো ছোঁয়া হয়নি; লাইভের দিন লিংক এখানে ঘোরানো হবে।
// ডেটা: src/lib/marketApi.js (delivery_market_categories, delivery_shops; RLS সাপেক্ষে)।
// টেস্ট দোকান (is_test) শুধু delivery_shops.view পারমিশনওয়ালা স্টাফ দেখে (RLS)।
// সব টেক্সট textContent দিয়ে বসানো (ইউজার/অ্যাডমিনের লেখা এস্কেপ)।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import MarketLocationSheet from '../components/market/MarketLocationSheet.astro';
---

<BaseLayout title="কুইক ডেলিভারি | স্মার্ট ফেনী">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="mk-page">

    <header class="mk-top">
      <nav class="mk-nav" aria-label="কুইক ডেলিভারি মেনু">
        <a class="mk-nav-b" href="/my-orders" aria-label="আমার অর্ডার"><i class="fas fa-receipt" aria-hidden="true"></i></a>
        <a class="mk-nav-b" href="/market/checkout" aria-label="কার্ট"><i class="fas fa-bag-shopping" aria-hidden="true"></i><span class="mk-nav-n" id="mkCartN" hidden></span></a>
      </nav>
      <div class="mk-loc-lbl">ডেলিভারি ঠিকানা</div>
      <button type="button" class="mk-loc" id="mkLoc" aria-label="ডেলিভারি ঠিকানা বদলান">ফেনী</button>
    </header>

    <label class="mk-search">
      <i class="fas fa-search" aria-hidden="true"></i>
      <input id="mkQ" type="search" placeholder="দোকান খুঁজুন" autocomplete="off" aria-label="দোকান খুঁজুন" />
    </label>

    <div class="mk-tabs" id="mkTabs" role="tablist" aria-label="ক্যাটাগরি"></div>

    <section class="mk-banner" aria-label="স্মার্ট ফেনী">
      <div class="mk-banner-c1"></div>
      <div class="mk-banner-c2"></div>
      <div class="mk-banner-s">ফেনীর সব দোকান, এক অ্যাপে</div>
      <div class="mk-banner-t">প্রয়োজন আপনার, দায়িত্ব আমাদের</div>
    </section>

    <div id="mkBody"></div>
  </div>

  <MarketLocationSheet />

  <style is:global>
    .mk-page { font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; background: #FFF4EC; min-height: 70vh; padding: 14px 16px 110px; max-width: 560px; margin: 0 auto; overflow-x: hidden; }
    .mk-page * { box-sizing: border-box; }
    .mk-page button, .mk-page input { font-family: inherit; }
    .mk-top { position: relative; padding-right: 100px; }
    .mk-nav { position: absolute; right: 0; top: 0; display: flex; gap: 8px; }
    .mk-nav-b { position: relative; width: 42px; height: 42px; border-radius: 14px; background: #fff; color: #1B2A4A; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.1); text-decoration: none; }
    .mk-nav-b:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .mk-nav-n { position: absolute; top: -5px; right: -5px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 10px; background: #FF6B35; color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .mk-foods { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 10px; scrollbar-width: none; }
    .mk-food { flex: none; border: 1.5px solid #EADBCF; background: #fff; color: #1B2A4A; border-radius: 20px; padding: 7px 14px; font-size: 13.5px; font-weight: 700; cursor: pointer; }
    .mk-food.on { background: #FF6B35; border-color: #FF6B35; color: #fff; }
    .mk-loc-lbl { font-size: 11.5px; font-weight: 600; color: #5B6B86; }
    .mk-loc { display: block; max-width: 100%; border: 0; background: none; padding: 0; text-align: left; font-family: inherit; color: #1B2A4A; font-size: 17px; font-weight: 700; cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mk-loc::after { content: ' ▾'; color: #FF6B35; }
    .mk-loc:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; border-radius: 6px; }
    .mk-card { cursor: pointer; }
    .mk-card:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
    .mk-search { display: flex; align-items: center; gap: 10px; margin: 12px 0; height: 50px; padding: 0 16px; border-radius: 16px; background: #fff; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.08); color: #5B6B86; }
    .mk-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font-size: 15px; font-weight: 500; color: #1B2A4A; }
    .mk-search:focus-within { box-shadow: 0 0 0 2px #1B2A4A; }
    .mk-tabs { display: flex; gap: 10px; overflow-x: auto; padding: 4px 2px 8px; margin: 0 -16px; padding-left: 16px; padding-right: 16px; scrollbar-width: none; }
    .mk-tabs::-webkit-scrollbar { display: none; }
    .mk-tab { flex: none; min-width: 66px; border: 0; background: none; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: #1B2A4A; cursor: pointer; }
    .mk-tab[aria-selected='true'] { font-weight: 700; }
    .mk-tab-ic { width: 56px; height: 56px; border-radius: 18px; background: #fff; border: 1.5px solid #EADBCF; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #1B2A4A; }
    .mk-tab[aria-selected='true'] .mk-tab-ic { background: #1B2A4A; border-color: #1B2A4A; color: #fff; }
    .mk-tab-bar { width: 20px; height: 3px; border-radius: 2px; background: transparent; }
    .mk-tab[aria-selected='true'] .mk-tab-bar { background: #FF6B35; }
    .mk-tab:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; border-radius: 12px; }
    .mk-banner { position: relative; overflow: hidden; margin: 8px 0 16px; border-radius: 22px; background: #1B2A4A; color: #fff; padding: 20px; min-height: 130px; }
    .mk-banner-c1 { position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; border-radius: 50%; background: #FF6B35; }
    .mk-banner-c2 { position: absolute; right: 40px; bottom: -40px; width: 90px; height: 90px; border-radius: 50%; background: #FFDCC4; }
    .mk-banner-s { position: relative; font-size: 12px; font-weight: 600; color: #FFDCC4; max-width: 200px; }
    .mk-banner-t { position: relative; font-size: 21px; font-weight: 700; line-height: 1.3; margin-top: 6px; max-width: 210px; }
    .mk-sec { display: flex; justify-content: space-between; align-items: baseline; margin: 6px 2px 10px; }
    .mk-sec h2 { margin: 0; font-size: 18px; font-weight: 700; }
    .mk-card { display: flex; gap: 12px; background: #fff; border-radius: 18px; padding: 10px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.07); }
    .mk-card.closed { opacity: 0.7; }
    .mk-img { flex: none; width: 76px; height: 76px; border-radius: 14px; background: #FFDCC4; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 28px; font-weight: 700; color: #1B2A4A; }
    .mk-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .mk-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 3px; }
    .mk-name { font-size: 15.5px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mk-cats { font-size: 12.5px; color: #5B6B86; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mk-meta { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #5B6B86; flex-wrap: wrap; }
    .mk-badge { font-weight: 700; padding: 2px 8px; border-radius: 8px; background: #E3F3EA; color: #1F7A4D; }
    .mk-badge.off { background: #EEF0F4; color: #4A5568; }
    .mk-badge.test { background: #FFE9DA; color: #8A3B12; }
    .mk-empty { padding: 28px 8px; text-align: center; font-size: 14px; line-height: 1.6; color: #5B6B86; }
    .mk-empty a { color: #1B2A4A; font-weight: 700; }
    .mk-any { width: 100%; text-align: left; display: flex; align-items: center; gap: 14px; background: #fff; border: 0; border-radius: 20px; padding: 16px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(27, 42, 74, 0.07); cursor: pointer; color: #1B2A4A; }
    .mk-any-ic { flex: none; width: 64px; height: 64px; border-radius: 18px; background: #FFDCC4; display: flex; align-items: center; justify-content: center; font-size: 26px; }
    .mk-any-t { font-size: 17px; font-weight: 700; }
    .mk-any-d { font-size: 13px; line-height: 1.45; color: #5B6B86; margin-top: 2px; }
    .mk-any:focus-visible { outline: 3px solid #1B2A4A; outline-offset: 2px; }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { hideHeaderInApp } from '../lib/marketChrome.js';
    hideHeaderInApp();
    import { supabase } from '../lib/supabase.js';
    import { fetchMarketCategories, fetchMarketShops, fetchOnlineShopsForMarket, marketEnabledForMe, shopOpenState, bnNum } from '../lib/marketApi.js';
    import { getDrop, getCart, cartCount } from '../lib/marketCart.js';

    const $ = (id) => document.getElementById(id);
    const ANY = '__any__';
    const ICON_CLASS = {
      food: 'fa-utensils', grocery: 'fa-basket-shopping', pharmacy: 'fa-prescription-bottle-medical',
      flower: 'fa-seedling', beauty: 'fa-wand-magic-sparkles', gadget: 'fa-mobile-screen', other: 'fa-store',
    };
    const ANY_CARDS = [
      { k: 'anything', t: 'অর্ডার এনিথিং', d: 'যেকোনো দোকান থেকে যেকোনো জিনিস কিনে আনা', i: 'fa-box-open' },
      { k: 'send', t: 'পাঠান / এনে দাও', d: 'পার্সেল বা জিনিস এক জায়গা থেকে অন্য জায়গায়', i: 'fa-paper-plane' },
    ];

    let cats = [];
    let shops = [];
    let active = null;
    let q = '';
    let foodSel = null; // নির্বাচিত জনপ্রিয় খাবার (চিপ)
    const FOODS = [
      { n: 'পিজ্জা', k: ['পিজ্জা', 'পিৎজা', 'pizza'] },
      { n: 'বার্গার', k: ['বার্গার', 'burger'] },
      { n: 'বিরিয়ানি', k: ['বিরিয়ানি', 'বিরিয়ানী', 'biryani', 'biriyani'] },
      { n: 'চিকেন', k: ['চিকেন', 'মুরগি', 'chicken'] },
    ];
    const foodCache = {};
    async function shopIdsWithFood(f) {
      if (foodCache[f.n]) return foodCache[f.n];
      const ids = new Set();
      const orIt = (col) => f.k.map((w) => col + '.ilike.%' + w + '%').join(',');
      try {
        const [a, b] = await Promise.all([
          supabase.from('delivery_shop_items').select('shop_id').eq('is_available', true).or(orIt('name')).limit(500),
          supabase.from('listings').select('shop_id').eq('status', 'active').eq('is_disabled', false).not('shop_id', 'is', null).or(orIt('title')).limit(500),
        ]);
        ((a && a.data) || []).forEach((x) => ids.add(x.shop_id));
        ((b && b.data) || []).forEach((x) => ids.add(x.shop_id));
      } catch (e) {}
      foodCache[f.n] = ids;
      return ids;
    }

    function toast(msg, type) { if (window.showToast) window.showToast(msg, type); }
    function mk(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined && text !== null) e.textContent = text;
      return e;
    }

    // ---------- ঠিকানা লাইন (ধাপ ২-তে শুধু বর্তমান উপজেলা) ----------
    function showLoc() {
      const d = getDrop();
      let up = null;
      try { up = localStorage.getItem('smartfeni_upazila'); } catch (e) {}
      $('mkLoc').textContent = d ? d.address : (up || 'ঠিকানা সেট করুন');
    }

    function showCartN() {
      const n = cartCount(getCart());
      const b = $('mkCartN');
      b.hidden = n === 0;
      b.textContent = bnNum(n);
    }

    // ---------- ক্যাটাগরি ট্যাব ----------
    function renderTabs() {
      const box = $('mkTabs');
      box.textContent = '';
      const list = [{ id: ANY, name: 'যেকোনো কিছু', icon: 'any' }].concat(cats);
      list.forEach((c) => {
        const b = mk('button', 'mk-tab');
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', c.id === active ? 'true' : 'false');
        const ic = mk('span', 'mk-tab-ic');
        const i = document.createElement('i');
        i.className = 'fas ' + (c.id === ANY ? 'fa-box-open' : (ICON_CLASS[c.icon] || ICON_CLASS.other));
        i.setAttribute('aria-hidden', 'true');
        ic.appendChild(i);
        b.appendChild(ic);
        b.appendChild(mk('span', null, c.name));
        b.appendChild(mk('span', 'mk-tab-bar'));
        b.addEventListener('click', () => { active = c.id; renderTabs(); renderBody(); });
        box.appendChild(b);
      });
    }

    // ---------- মূল অংশ ----------
    function catNames(shop) {
      const ids = Array.isArray(shop.market_category_ids) ? shop.market_category_ids : [];
      return ids.map((id) => { const c = cats.find((x) => x.id === id); return c ? c.name : null; }).filter(Boolean).join(' · ');
    }

    function shopCard(s) {
      const st = shopOpenState(s);
      const card = mk('article', 'mk-card' + (st.open ? '' : ' closed'));
      const img = mk('div', 'mk-img');
      if (s.image_url) {
        const im = document.createElement('img');
        im.src = s.image_url;
        im.alt = s.name;
        im.loading = 'lazy';
        img.appendChild(im);
      } else {
        img.textContent = (s.name || '?').trim().charAt(0);
      }
      const info = mk('div', 'mk-info');
      info.appendChild(mk('div', 'mk-name', s.name));
      const cn = catNames(s);
      if (cn) info.appendChild(mk('div', 'mk-cats', cn));
      const meta = mk('div', 'mk-meta');
      meta.appendChild(mk('span', 'mk-badge' + (st.open ? '' : ' off'), st.label));
      if (s._days) meta.appendChild(mk('span', null, 'ডেলিভারি ১–৩ দিনে'));
      else if (st.open && s.prep_minutes) meta.appendChild(mk('span', null, 'প্রস্তুতি ~' + bnNum(s.prep_minutes) + ' মিনিট'));
      if (s.is_test) meta.appendChild(mk('span', 'mk-badge test', 'টেস্ট শপ'));
      info.appendChild(meta);
      card.appendChild(img);
      card.appendChild(info);
      card.tabIndex = 0;
      card.setAttribute('role', 'link');
      card.setAttribute('aria-label', s.name + ' দোকান খুলুন');
      const go = () => { location.href = '/market/shop?id=' + encodeURIComponent(s.id); };
      card.addEventListener('click', go);
      card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
      return card;
    }

    function renderBody() {
      const body = $('mkBody');
      body.textContent = '';
      delete body.dataset.food;
      if (active === ANY) {
        const h = mk('div', 'mk-sec');
        h.appendChild(mk('h2', null, 'যেকোনো কিছু আনান'));
        body.appendChild(h);
        ANY_CARDS.forEach((a) => {
          const b = mk('button', 'mk-any');
          b.type = 'button';
          const ic = mk('span', 'mk-any-ic');
          const i = document.createElement('i');
          i.className = 'fas ' + a.i;
          i.setAttribute('aria-hidden', 'true');
          ic.appendChild(i);
          const tx = mk('span');
          tx.appendChild(mk('div', 'mk-any-t', a.t));
          tx.appendChild(mk('div', 'mk-any-d', a.d));
          b.appendChild(ic);
          b.appendChild(tx);
          b.addEventListener('click', () => { location.href = '/market/anything?type=' + a.k; });
          body.appendChild(b);
        });
        return;
      }
      const term = q.trim().toLowerCase();
      let list = shops.filter((s) => Array.isArray(s.market_category_ids) && s.market_category_ids.indexOf(active) !== -1);
      const curCat = cats.find((c) => c.id === active);
      if (curCat && curCat.icon === 'food') {
        const fr = mk('div', 'mk-foods');
        FOODS.forEach((f) => {
          const b = mk('button', 'mk-food' + (foodSel === f.n ? ' on' : ''), f.n);
          b.type = 'button';
          b.setAttribute('aria-pressed', foodSel === f.n ? 'true' : 'false');
          b.addEventListener('click', () => { foodSel = foodSel === f.n ? null : f.n; renderBody(); });
          fr.appendChild(b);
        });
        body.appendChild(fr);
      }
      if (foodSel && curCat && curCat.icon === 'food') {
        const f = FOODS.find((x) => x.n === foodSel);
        if (f) {
          const mine = body.querySelector('.mk-foods');
          shopIdsWithFood(f).then((ids) => {
            if (foodSel !== f.n) return;
            const body2 = $('mkBody');
            if (body2.dataset.food === f.n + active + term) return;
            body2.dataset.food = f.n + active + term;
            let l2 = list.filter((s) => ids.has(s.id));
            if (term) l2 = l2.filter((s) => (s.name || '').toLowerCase().indexOf(term) !== -1);
            body2.querySelectorAll('.mk-card, .mk-empty, .mk-sec').forEach((n) => n.remove());
            const h2 = mk('div', 'mk-sec'); h2.appendChild(mk('h2', null, f.n + ' পাওয়া যায় যেসব দোকানে'));
            body2.appendChild(h2);
            if (!l2.length) body2.appendChild(mk('p', 'mk-empty', 'এই খাবারের কোনো দোকান এখন নেই।'));
            l2.forEach((s) => body2.appendChild(shopCard(s)));
          });
          if (mine) { const w = mk('p', 'mk-empty', 'খোঁজা হচ্ছে...'); body.appendChild(w); }
          return;
        }
      }
      if (term) list = list.filter((s) => (s.name || '').toLowerCase().indexOf(term) !== -1);
      const openOf = (x) => Number(shopOpenState(x).open);
      list.sort((a, b) => openOf(b) - openOf(a));
      const h = mk('div', 'mk-sec');
      const cat = cats.find((c) => c.id === active);
      h.appendChild(mk('h2', null, cat ? cat.name : 'দোকান'));
      body.appendChild(h);
      if (!list.length) {
        body.appendChild(mk('p', 'mk-empty', term ? 'এই নামে কোনো দোকান পাওয়া যায়নি।' : 'এই ক্যাটাগরিতে এখনো কোনো দোকান নেই।'));
        return;
      }
      list.forEach((s) => body.appendChild(shopCard(s)));
    }

    function showMsg(html) {
      const body = $('mkBody');
      body.textContent = '';
      const p = mk('p', 'mk-empty');
      p.appendChild(html);
      body.appendChild(p);
    }

    async function init() {
      showLoc();
      window.addEventListener('smartfeni:upazila-changed', showLoc);
      window.addEventListener('smartfeni:market-drop-changed', showLoc);
      showCartN();
      $('mkLoc').addEventListener('click', () => window.SFMarketLocation.open());
      $('mkQ').addEventListener('input', (e) => { q = e.target.value; if (active !== ANY) renderBody(); });
      showMsg(document.createTextNode('লোড হচ্ছে...'));

      if (!(await marketEnabledForMe())) {
        showMsg(document.createTextNode('কুইক ডেলিভারি শিগগিরই চালু হচ্ছে।'));
        return;
      }
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        const frag = document.createDocumentFragment();
        frag.appendChild(document.createTextNode('দোকান দেখতে '));
        const a = document.createElement('a');
        a.href = '/login';
        a.textContent = 'লগইন করুন';
        frag.appendChild(a);
        showMsg(frag);
        return;
      }
      try {
        const res = await Promise.all([
          fetchMarketCategories(),
          fetchMarketShops(),
          fetchOnlineShopsForMarket().catch(() => []), // অনলাইন শপ না এলেও দোকান দেখাবে
        ]);
        cats = res[0];
        const seen = new Set(res[1].map((x) => x.id));
        shops = res[1].concat(res[2].filter((x) => !seen.has(x.id)));
      } catch (err) {
        if (window.SFReportError) { try { window.SFReportError(err, 'market-load'); } catch (e) {} }
        showMsg(document.createTextNode('লোড করতে সমস্যা হয়েছে। একটু পরে আবার চেষ্টা করুন।'));
        return;
      }
      active = cats.length ? cats[0].id : ANY;
      renderTabs();
      renderBody();
    }

    init();
  </script>
</BaseLayout>
