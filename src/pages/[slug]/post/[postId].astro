---
// ============================================================
// পেজ: ক্লাব পোস্ট শেয়ার/ডিটেইল পেজ (/[slug]/post/[postId])
// ফাংশন: একটা নির্দিষ্ট ক্লাব পোস্ট (অর্জন/ইভেন্ট/ঘোষণা/গ্যালারি)
// শেয়ারেবল লিংক আকারে দেখায়, প্রপার OG মেটা ট্যাগ সহ — যাতে
// Facebook/WhatsApp এ শেয়ার করলে ছবি+টাইটেল সহ প্রিভিউ কার্ড আসে।
// আপডেট: টাইটেলের পাশে শেয়ার বাটন যোগ করা হয়েছে (পোস্টের ভেতর
// থেকেও শেয়ার করা যায়, শুধু তালিকা থেকে না)
// আপডেট (নতুন): গ্লোবাল ImageLightbox যোগ করা হলো — পোস্টের ছবিতে
// ক্লিক করলে এখন জুম করে দেখা আর ডাউনলোড করা যাবে (EventSection/
// GallerySection এ যে প্যাটার্ন আছে, একই রিইউজ করা হলো)
// ============================================================

export const prerender = false;

import BaseLayout from '../../../components/layout/BaseLayout.astro';
import ImageLightbox from '../../../components/ImageLightbox.astro';
import { supabase } from '../../../lib/supabase.js';

const { slug, postId } = Astro.params;

const { data: club, error: clubError } = await supabase
  .from('clubs')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .maybeSingle();

if (clubError) {
  console.error('club fetch error:', clubError.message);
}

let post = null;

if (club) {
  const { data: postData, error: postError } = await supabase
    .from('club_posts')
    .select('*')
    .eq('id', postId)
    .eq('club_id', club.id)
    .maybeSingle();

  if (postError) {
    console.error('post fetch error:', postError.message);
  }
  post = postData;
}

const TYPE_LABELS = {
  achievement: { label: 'অর্জন', icon: 'fa-trophy' },
  event: { label: 'ইভেন্ট / আয়োজন', icon: 'fa-calendar-days' },
  announcement: { label: 'ঘোষণা', icon: 'fa-bullhorn' },
  gallery: { label: 'গ্যালারি', icon: 'fa-images' },
};

function formatDate(dateStr) {
  if (!dateStr) return null;
  const d = new Date(dateStr);
  return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' });
}

const typeInfo = post ? TYPE_LABELS[post.type] || { label: 'পোস্ট', icon: 'fa-newspaper' } : null;

const pageTitle = post && club ? `${post.title} | ${club.name}` : 'পেজ পাওয়া যায়নি | স্মার্ট ফেনী';
const pageDescription = post
  ? post.description || `${club.name} এর ${typeInfo.label} — ${post.title}`
  : undefined;
const ogImage = post ? post.image || club.cover_image || club.logo_image : undefined;
const canonicalPath = post && club ? `/${club.slug}/post/${post.id}` : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
>
  {post && club ? (
    <div class="post-detail-page">
      <div class="container">

        <a href={`/${club.slug}`} class="club-back-link">
          {club.logo_image ? (
            <img src={club.logo_image} alt={club.name} class="back-logo" />
          ) : (
            <div class="back-logo-placeholder"><i class="fas fa-users"></i></div>
          )}
          <span>
            <i class="fas fa-arrow-left"></i> {club.name} এর প্রোফাইলে যান
          </span>
        </a>

        <div class="post-card">
          <span class="post-type-badge"><i class={`fas ${typeInfo.icon}`}></i> {typeInfo.label}</span>

          {post.image ? (
            <img src={post.image} alt={post.title} class="post-img zoomable-post-img" />
          ) : (
            <div class="post-img-placeholder"><i class={`fas ${typeInfo.icon}`}></i></div>
          )}

          <div class="post-body">
            <div class="post-title-row">
              <h1 class="post-title">{post.title}</h1>
              <button
                class="share-btn"
                data-share-url={`/${club.slug}/post/${post.id}`}
                data-share-title={post.title}
                aria-label="শেয়ার করুন"
              >
                <i class="fas fa-share-nodes"></i>
              </button>
            </div>
            {post.event_date && (
              <p class="post-date"><i class="fas fa-clock"></i> {formatDate(post.event_date)}</p>
            )}
            {post.description && <p class="post-desc">{post.description}</p>}

            {post.contact_phone && (
              <a href={`tel:${post.contact_phone}`} class="post-call-btn">
                <i class="fas fa-phone"></i> কল করুন
              </a>
            )}
          </div>
        </div>

      </div>
    </div>
  ) : (
    <section class="not-found">
      <div class="container">
        <i class="fas fa-face-frown"></i>
        <p>এই পোস্টটি খুঁজে পাওয়া যায়নি</p>
        <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> হোমপেজে ফিরে যান</a>
      </div>
    </section>
  )}

  <div id="postShareToast" class="share-toast">লিংক কপি হয়েছে ✓</div>

  <ImageLightbox />
</BaseLayout>

<style>
  .post-detail-page {
    min-height: 70vh;
    padding: 28px 0 80px;
    background: #F8FAFC;
  }

  .club-back-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #5A6E85;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 18px;
  }

  .back-logo,
  .back-logo-placeholder {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: #fff;
    border: 1px solid #E5EAF0;
  }

  .back-logo-placeholder {
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  .post-card {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    max-width: 620px;
    margin: 0 auto;
  }

  .post-type-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFF0EA;
    color: #FF6B35;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 40px;
    margin: 18px 0 0 18px;
  }

  .post-img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: contain;
    background: #F4F7FC;
    display: block;
    margin-top: 14px;
    cursor: zoom-in;
  }

  .post-img-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: #F4F7FC;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    margin-top: 14px;
  }

  .post-body {
    padding: 20px 22px 26px;
  }

  .post-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1B2A4A;
    line-height: 1.4;
  }

  .share-btn {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #F4F7FC;
    color: #5A6E85;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    cursor: pointer;
    margin-top: 2px;
  }

  .share-btn:active {
    background: #FFF0EA;
    color: #FF6B35;
  }

  .post-date {
    font-size: 0.82rem;
    color: #FF6B35;
    font-weight: 600;
    margin-top: 8px;
  }

  .post-desc {
    font-size: 0.92rem;
    color: #5A6E85;
    line-height: 1.75;
    margin-top: 12px;
    white-space: pre-line;
  }

  .post-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFF0EA;
    color: #FF6B35;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 40px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: 18px;
  }

  .not-found {
    padding: 120px 0;
    text-align: center;
    color: #B0BCCB;
  }
  .not-found i {
    font-size: 3rem;
    margin-bottom: 16px;
  }
  .not-found p {
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 16px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #FF6B35;
    text-decoration: none;
    font-weight: 700;
  }

  .share-toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%) translateY(20px);
    background: #1B2A4A;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 40px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 999;
  }

  .share-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  function showPostShareToast() {
    const toast = document.getElementById('postShareToast');
    if (!toast) return;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2000);
  }

  document.querySelectorAll('.share-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const path = btn.dataset.shareUrl;
      const title = btn.dataset.shareTitle;
      const fullUrl = `${window.location.origin}${path}`;

      if (navigator.share) {
        try {
          await navigator.share({ title, url: fullUrl });
        } catch (err) {
          // ইউজার শেয়ার শীট ক্যানসেল করলে কিছু করার দরকার নেই
        }
      } else {
        try {
          await navigator.clipboard.writeText(fullUrl);
          showPostShareToast();
        } catch (err) {
          console.error('কপি করা যায়নি:', err);
        }
      }
    });
  });

  // ছবিতে ক্লিক করলে গ্লোবাল ImageLightbox খুলবে (জুম + ডাউনলোড)
  document.querySelectorAll('.zoomable-post-img').forEach((img) => {
    img.addEventListener('click', () => {
      window.openImageLightbox?.(img.src);
    });
  });
</script>