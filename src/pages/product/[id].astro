---
// ============================================================
// পেজ: /product/[id] — প্রোডাক্ট প্রিভিউ পেজ (নতুন, ডেডিকেটেড)
// আগে মোডালে দেখানো হতো, এখন আলাদা পেজ — সরাসরি শেয়ারযোগ্য লিংক,
// একাধিক ছবি swipeable স্লাইডারে, বেস্ট সেলার ব্যাজ ছবির উপর
// (বক্সের ভিতরে, বাইরে না), শেয়ার + কার্ট বাটন এই পেজেই।
//
// cart/checkout/OrdersTab এর নতুন ডিজাইন ভাষা অনুসরণ করা হয়েছে:
// icon badge, dashed divider, sticky bottom bar।
//
// কার্ট মাল্টি-শপ — একাধিক শপের প্রোডাক্ট একই কার্টে থাকতে পারবে,
// checkout এ প্রতি শপের জন্য আলাদা order তৈরি হয়।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import { supabase } from '../../lib/supabase.js';

const { id } = Astro.params;

const { data: product, error: productError } = await supabase
  .from('listings')
  .select('*')
  .eq('id', id)
  .eq('category', 'online-shop')
  .maybeSingle();

if (productError) {
  console.error('product fetch error:', productError.message);
}

let shop = null;
if (product) {
  const { data: shopData } = await supabase
    .from('shops')
    .select('id, name, slug, logo_image, phone, is_active')
    .eq('owner_id', product.user_id)
    .maybeSingle();
  shop = shopData || null;
}

const notFound = !product || !shop;

const pageTitle = product ? `${product.title} | ${shop?.name || 'শপ'} | স্মার্ট ফেনী` : 'প্রোডাক্ট পাওয়া যায়নি | স্মার্ট ফেনী';
const ogImage = product?.images?.[0] || undefined;
---

<BaseLayout title={pageTitle} ogImage={ogImage}>
  {notFound ? (
    <div class="not-found-wrap">
      <div class="container">
        <div class="status-icon-badge"><i class="fas fa-box-open"></i></div>
        <h2>প্রোডাক্টটি খুঁজে পাওয়া যায়নি</h2>
        <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
      </div>
    </div>
  ) : (
    <div class="product-page">
      <div class="preview-topbar">
        <div class="container topbar-inner">
          <a href={`/${shop.slug}`} class="back-btn" aria-label="ফিরে যান">
            <i class="fas fa-arrow-left"></i>
          </a>
          <a href={`/${shop.slug}`} class="topbar-shop-link">
            {shop.logo_image ? (
              <img src={shop.logo_image} alt={shop.name} class="topbar-shop-logo" />
            ) : (
              <div class="topbar-shop-logo-placeholder"><i class="fas fa-store"></i></div>
            )}
            <span class="topbar-shop-name">{shop.name}</span>
          </a>
          <button class="icon-action-btn" id="shareProductBtn" aria-label="শেয়ার করুন">
            <i class="fas fa-share-nodes"></i>
          </button>
        </div>
      </div>

      <div class="container product-container">
        <div class="slider-wrap">
          {product.is_best_seller && (
            <span class="best-seller-overlay"><i class="fas fa-star"></i> বেস্ট সেলার</span>
          )}

          {product.images && product.images.length > 0 ? (
            <>
              <div class="slider-track" id="sliderTrack">
                {product.images.map((img) => (
                  <div class="slide">
                    <img src={img} alt={product.title} />
                  </div>
                ))}
              </div>
              {product.images.length > 1 && (
                <div class="slider-dots" id="sliderDots">
                  {product.images.map((_, i) => (
                    <span class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="slide-placeholder"><i class="fas fa-box"></i></div>
          )}
        </div>

        <div class="product-info-card">
          <h1 class="product-name">{product.title}</h1>
          {product.price && <p class="product-price-big">৳{product.price}</p>}

          {product.description && (
            <>
              <div class="info-divider"></div>
              <p class="product-description">{product.description}</p>
            </>
          )}
        </div>

        {shop.phone && (
          <div class="quick-contact-row">
            <a href={`tel:${shop.phone}`} class="contact-pill call-pill">
              <i class="fas fa-phone"></i> কল করুন
            </a>
            <a href={`https://wa.me/${shop.phone.replace(/\D/g, '')}`} target="_blank" rel="noopener" class="contact-pill wa-pill">
              <i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপ
            </a>
          </div>
        )}

        <div id="addToCartSpacer"></div>
      </div>

      <div class="preview-footer">
        <div class="container preview-footer-inner">
          <a href="/cart" class="mini-cart-btn" id="miniCartBtn" aria-label="কার্ট দেখুন">
            <i class="fas fa-cart-shopping"></i>
            <span class="cart-count" id="cartCountBadge" style="display:none;">0</span>
          </a>
          <button class="add-to-cart-big-btn" id="addToCartBtn" type="button">
            <i class="fas fa-cart-plus"></i> <span id="addToCartBtnText">কার্টে যোগ করুন</span>
          </button>
        </div>
      </div>

      <script type="application/json" id="productMeta" set:html={JSON.stringify({
        productId: product.id,
        shopId: shop.id,
        shopOwnerId: product.user_id,
        shopSlug: shop.slug,
        title: product.title,
      })} />
    </div>
  )}
</BaseLayout>

<style is:global>
  .not-found-wrap {
    padding: 100px 0;
    text-align: center;
  }

  .not-found-wrap .status-icon-badge {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #FFF0EA, #FFE3D5);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }

  .not-found-wrap .status-icon-badge i {
    font-size: 1.7rem;
    color: #FF6B35;
  }

  .not-found-wrap h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 18px;
  }

  .primary-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.88rem;
    box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
  }

  .product-page {
    background: #F8FAFC;
    min-height: 100vh;
  }

  .preview-topbar {
    background: #fff;
    border-bottom: 1px solid #EEF3F9;
    padding: 12px 0;
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .back-btn, .icon-action-btn {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: #F4F7FC;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .topbar-shop-link {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .topbar-shop-logo {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .topbar-shop-logo-placeholder {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .topbar-shop-name {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-container {
    padding-top: 18px;
    max-width: 560px;
  }

  .slider-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 16px;
  }

  .best-seller-overlay {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 5;
    background: #FFD700;
    color: #7A5C00;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 4px 10px rgba(255, 184, 0, 0.35);
  }

  .slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slider-track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 3;
    background: #F4F7FC;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .slide-placeholder {
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 12px 0;
  }

  .slider-dots .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #E5EAF0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .slider-dots .dot.active {
    background: #FF6B35;
    width: 18px;
    border-radius: 4px;
  }

  .product-info-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 16px;
  }

  .product-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 6px;
  }

  .product-price-big {
    font-size: 1.4rem;
    font-weight: 800;
    color: #FF6B35;
  }

  .info-divider {
    border-top: 1px dashed #E5EAF0;
    margin: 14px 0;
  }

  .product-description {
    font-size: 0.88rem;
    color: #3A4A60;
    line-height: 1.7;
  }

  .quick-contact-row {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .contact-pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 11px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .call-pill {
    background: #EAF2FF;
    color: #2563EB;
  }

  .call-pill:hover {
    background: #2563EB;
    color: #fff;
  }

  .wa-pill {
    background: #E9F9EF;
    color: #1EA952;
  }

  .wa-pill:hover {
    background: #1EA952;
    color: #fff;
  }

  #addToCartSpacer {
    height: 90px;
  }

  .preview-footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: #fff;
    box-shadow: 0 -6px 24px rgba(15, 23, 42, 0.08);
    padding: 12px 0;
    z-index: 40;
    border-top: 1px solid #F0F3F8;
  }

  .preview-footer-inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mini-cart-btn {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #F4F7FC;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .mini-cart-btn .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #FF6B35;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
  }

  .add-to-cart-big-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    border: none;
    padding: 15px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.94rem;
    cursor: pointer;
    box-shadow: 0 10px 22px rgba(255, 107, 53, 0.32);
    transition: all 0.2s ease;
  }

  .add-to-cart-big-btn:hover {
    background: #e85a28;
  }

  .add-to-cart-big-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .add-to-cart-big-btn.added {
    background: #1B7A3C;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const metaEl = document.getElementById('productMeta');
  const meta = metaEl ? JSON.parse(metaEl.textContent) : null;

  const shareBtn = document.getElementById('shareProductBtn');
  const addToCartBtn = document.getElementById('addToCartBtn');
  const addToCartBtnText = document.getElementById('addToCartBtnText');
  const cartCountBadge = document.getElementById('cartCountBadge');
  const sliderTrack = document.getElementById('sliderTrack');
  const dots = document.querySelectorAll('.slider-dots .dot');

  let currentUserId = null;

  sliderTrack?.addEventListener('scroll', () => {
    const index = Math.round(sliderTrack.scrollLeft / sliderTrack.clientWidth);
    dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const index = parseInt(dot.dataset.index);
      sliderTrack.scrollTo({ left: index * sliderTrack.clientWidth, behavior: 'smooth' });
    });
  });

  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const shareData = { title: meta.title, text: `${meta.title} — স্মার্ট ফেনী তে দেখুন`, url };

    if (navigator.share) {
      try { await navigator.share(shareData); } catch (err) {}
    } else {
      await navigator.clipboard.writeText(url);
      alert('লিংক কপি হয়েছে ✓');
    }
  });

  async function logView() {
    if (!currentUserId || !meta) return;
    await supabase.from('product_events').insert({
      event_type: 'view',
      shop_id: meta.shopId,
      listing_id: meta.productId,
      user_id: currentUserId,
    });
  }

  addToCartBtn?.addEventListener('click', async () => {
    if (!currentUserId) {
      window.openAuthModal?.('login');
      return;
    }

    addToCartBtn.disabled = true;
    addToCartBtnText.textContent = 'যোগ হচ্ছে...';

    const { data: existing } = await supabase
      .from('cart_items')
      .select('id, quantity')
      .eq('user_id', currentUserId)
      .eq('listing_id', meta.productId)
      .maybeSingle();

    if (existing) {
      await supabase.from('cart_items').update({ quantity: existing.quantity + 1 }).eq('id', existing.id);
    } else {
      await supabase.from('cart_items').insert({ user_id: currentUserId, listing_id: meta.productId, quantity: 1 });
    }

    await supabase.from('product_events').insert({
      event_type: 'cart_add',
      shop_id: meta.shopId,
      listing_id: meta.productId,
      user_id: currentUserId,
    });

    addToCartBtn.classList.add('added');
    addToCartBtnText.textContent = 'কার্টে যোগ হয়েছে ✓';
    addToCartBtn.disabled = false;

    setTimeout(() => {
      addToCartBtn.classList.remove('added');
      addToCartBtnText.textContent = 'কার্টে যোগ করুন';
    }, 1500);

    refreshCartCount();
  });

  async function refreshCartCount() {
    if (!currentUserId || !cartCountBadge) return;
    const { data } = await supabase.from('cart_items').select('quantity').eq('user_id', currentUserId);
    const total = (data || []).reduce((sum, row) => sum + row.quantity, 0);

    if (total > 0) {
      cartCountBadge.textContent = total;
      cartCountBadge.style.display = 'flex';
    } else {
      cartCountBadge.style.display = 'none';
    }
  }

  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;
    refreshCartCount();
    logView();
  })();
</script>