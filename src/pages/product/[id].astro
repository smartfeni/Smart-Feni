---
// ============================================================
// পেজ: /product/[id] — প্রোডাক্ট প্রিভিউ পেজ (নতুন, ডেডিকেটেড)
// আগে মোডালে দেখানো হতো, এখন আলাদা পেজ — সরাসরি শেয়ারযোগ্য লিংক,
// একাধিক ছবি swipeable স্লাইডারে, বেস্ট সেলার ব্যাজ ছবির উপর
// (বক্সের ভিতরে, বাইরে না), শেয়ার + কার্ট বাটন এই পেজেই।
//
// cart/checkout/OrdersTab এর নতুন ডিজাইন ভাষা অনুসরণ করা হয়েছে:
// icon badge, dashed divider, sticky bottom bar।
//
// কার্ট মাল্টি-শপ — একাধিক শপের প্রোডাক্ট একই কার্টে থাকতে পারবে,
// checkout এ প্রতি শপের জন্য আলাদা order তৈরি হয়।
//
// আপডেট: ছবিতে ট্যাপ করলে এখন ImageLightbox (রিইউজেবল কম্পোনেন্ট,
// আগে থেকেই ক্লাব পোস্টে ব্যবহৃত হতো) ওপেন হয় — জুম ইন/আউট,
// একাধিক ছবি হলে সোয়াইপ/prev-next নেভিগেশন, ডাউনলোড বাটন সবই
// বিল্ট-ইন। যে স্লাইড দেখাচ্ছিল ঠিক সেখান থেকেই লাইটবক্স শুরু হয়।
// আপডেট: is_sold_out=true হলে ছবির উপর "সোল্ড আউট" ব্যাজ + কার্ট/
// এখনই কিনুন বাটন দুটোই ডিজেবল হয়ে যাবে।
// আপডেট: প্রোডাক্ট ইনফোর নিচে "এই শপের আরও প্রোডাক্ট" — হরাইজন্টাল
// স্ক্রল সেকশন যোগ হলো (একই user_id, category='online-shop',
// status='active', বর্তমান প্রোডাক্ট বাদে, সর্বোচ্চ ১০টা, নতুন আগে)।
// আপডেট (UI পুনর্বিন্যাস): কল/হোয়াটসঅ্যাপ কন্টাক্ট পিল ও নিচের
// ফিক্সড ফুটার (মিনি-কার্ট আইকন + বড় "কার্টে যোগ করুন" বার) দুটোই
// রিমুভ করে তার বদলে প্রোডাক্ট ইনফো কার্ডের নিচে ইনলাইনে দুইটা বাটন
// বসানো হলো: "কার্টে যোগ করুন" + "এখনই কিনুন"। "এখনই কিনুন" ক্লিক
// করলে কার্ট স্পর্শ না করেই সরাসরি /checkout?buyNow={productId} এ
// যায় — checkout.astro সেখানে শুধু এই একটা প্রোডাক্টের অর্ডার সামারি
// দেখায়, ইউজারের আসল কার্ট অপরিবর্তিত থাকে।
// ============================================================

export const prerender = false;

import BaseLayout from '../../components/layout/BaseLayout.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import { supabase } from '../../lib/supabase.js';

const { id } = Astro.params;

const { data: product, error: productError } = await supabase
  .from('listings')
  .select('*')
  .eq('id', id)
  .eq('category', 'online-shop')
  .maybeSingle();

if (productError) {
  console.error('product fetch error:', productError.message);
}

let shop = null;
let relatedProducts = [];

if (product) {
  const { data: shopData } = await supabase
    .from('shops')
    .select('id, name, slug, logo_image, phone, is_active')
    .eq('owner_id', product.user_id)
    .maybeSingle();
  shop = shopData || null;

  const { data: relatedData, error: relatedError } = await supabase
    .from('listings')
    .select('id, title, price, images, is_sold_out')
    .eq('category', 'online-shop')
    .eq('user_id', product.user_id)
    .eq('status', 'active')
    .neq('id', product.id)
    .order('created_at', { ascending: false })
    .limit(10);

  if (relatedError) {
    console.error('related products fetch error:', relatedError.message);
  }

  relatedProducts = relatedData || [];
}

const notFound = !product || !shop;

const pageTitle = product ? `${product.title} | ${shop?.name || 'শপ'} | স্মার্ট ফেনী` : 'প্রোডাক্ট পাওয়া যায়নি | স্মার্ট ফেনী';
const ogImage = product?.images?.[0] || undefined;
---

<BaseLayout title={pageTitle} ogImage={ogImage}>
  {notFound ? (
    <div class="not-found-wrap">
      <div class="container">
        <div class="status-icon-badge"><i class="fas fa-box-open"></i></div>
        <h2>প্রোডাক্টটি খুঁজে পাওয়া যায়নি</h2>
        <a href="/shop" class="primary-link-btn">শপ দেখুন</a>
      </div>
    </div>
  ) : (
    <div class="product-page">
      <div class="preview-topbar">
        <div class="container topbar-inner">
          <a href={`/${shop.slug}`} class="back-btn" aria-label="ফিরে যান">
            <i class="fas fa-arrow-left"></i>
          </a>
          <a href={`/${shop.slug}`} class="topbar-shop-link">
            {shop.logo_image ? (
              <img src={shop.logo_image} alt={shop.name} class="topbar-shop-logo" />
            ) : (
              <div class="topbar-shop-logo-placeholder"><i class="fas fa-store"></i></div>
            )}
            <span class="topbar-shop-name">{shop.name}</span>
          </a>
          <button class="icon-action-btn" id="shareProductBtn" aria-label="শেয়ার করুন">
            <i class="fas fa-share-nodes"></i>
          </button>
        </div>
      </div>

      <div class="container product-container">
        <div class="slider-wrap">
          {product.is_best_seller && (
            <span class="best-seller-overlay"><i class="fas fa-star"></i> বেস্ট সেলার</span>
          )}

          {product.is_sold_out && (
            <span class="sold-out-overlay"><i class="fas fa-ban"></i> সোল্ড আউট</span>
          )}

          {product.images && product.images.length > 0 ? (
            <>
              <div class="slider-track" id="sliderTrack">
                {product.images.map((img, i) => (
                  <div class="slide" data-index={i}>
                    <img src={img} alt={product.title} />
                  </div>
                ))}
              </div>
              {product.images.length > 1 && (
                <div class="slider-dots" id="sliderDots">
                  {product.images.map((_, i) => (
                    <span class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="slide-placeholder"><i class="fas fa-box"></i></div>
          )}
        </div>

        <div class="product-info-card">
          <h1 class="product-name">{product.title}</h1>
          {product.price && <p class="product-price-big">৳{product.price}</p>}

          {product.description && (
            <>
              <div class="info-divider"></div>
              <p class="product-description">{product.description}</p>
            </>
          )}
        </div>

        <div class="product-action-row">
          <button class="action-pill cart-pill" id="addToCartBtn" type="button">
            <i class="fas fa-cart-plus"></i> <span id="addToCartBtnText">কার্টে যোগ করুন</span>
          </button>
          <button class="action-pill buy-pill" id="buyNowBtn" type="button">
            <i class="fas fa-bolt"></i> এখনই কিনুন
          </button>
        </div>

        {relatedProducts.length > 0 && (
          <div class="related-section">
            <h3 class="related-section-title">এই শপের আরও প্রোডাক্ট</h3>
            <div class="related-scroll" id="relatedScroll">
              {relatedProducts.map((p) => (
                <a href={`/product/${p.id}`} class="related-card">
                  <div class="related-img-wrap">
                    {p.is_sold_out && <span class="related-sold-badge">সোল্ড আউট</span>}
                    {p.images && p.images.length > 0 ? (
                      <img src={p.images[0]} alt={p.title} class="related-img" loading="lazy" />
                    ) : (
                      <div class="related-img-placeholder"><i class="fas fa-box"></i></div>
                    )}
                  </div>
                  <p class="related-title">{p.title}</p>
                  {p.price && <p class="related-price">৳{p.price}</p>}
                </a>
              ))}
            </div>
            <div class="related-loading-spinner" id="relatedLoadingSpinner" style="display:none;">
              <i class="fas fa-spinner fa-spin"></i>
            </div>
          </div>
        )}

      </div>

      <script type="application/json" id="productMeta" set:html={JSON.stringify({
        productId: product.id,
        shopId: shop.id,
        shopOwnerId: product.user_id,
        shopSlug: shop.slug,
        title: product.title,
        images: product.images || [],
        isSoldOut: !!product.is_sold_out,
        relatedOffset: relatedProducts.length,
        relatedHasMore: relatedProducts.length === 10,
      })} />

      <ImageLightbox />
    </div>
  )}
</BaseLayout>

<style is:global>
  .not-found-wrap {
    padding: 100px 0;
    text-align: center;
  }

  .not-found-wrap .status-icon-badge {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #FFF0EA, #FFE3D5);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }

  .not-found-wrap .status-icon-badge i {
    font-size: 1.7rem;
    color: #FF6B35;
  }

  .not-found-wrap h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 18px;
  }

  .primary-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FF6B35;
    color: #fff;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.88rem;
    box-shadow: 0 8px 18px rgba(255, 107, 53, 0.28);
  }

  .product-page {
    background: #F8FAFC;
    min-height: 100vh;
  }

  .preview-topbar {
    background: #fff;
    border-bottom: 1px solid #EEF3F9;
    padding: 12px 0;
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .back-btn, .icon-action-btn {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: #F4F7FC;
    color: #1B2A4A;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .topbar-shop-link {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .topbar-shop-logo {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .topbar-shop-logo-placeholder {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .topbar-shop-name {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1B2A4A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-container {
    padding-top: 18px;
    max-width: 560px;
  }

  .slider-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 16px;
  }

  .best-seller-overlay {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 5;
    background: #FFD700;
    color: #7A5C00;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 4px 10px rgba(255, 184, 0, 0.35);
  }

  .sold-out-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 5;
    background: rgba(15, 23, 42, 0.8);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slider-track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 3;
    background: #F4F7FC;
    cursor: zoom-in;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .slide-placeholder {
    aspect-ratio: 4 / 3;
    background: #FFF0EA;
    color: #FF6B35;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 12px 0;
  }

  .slider-dots .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #E5EAF0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .slider-dots .dot.active {
    background: #FF6B35;
    width: 18px;
    border-radius: 4px;
  }

  .product-info-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 16px;
  }

  .product-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 6px;
  }

  .product-price-big {
    font-size: 1.4rem;
    font-weight: 800;
    color: #FF6B35;
  }

  .info-divider {
    border-top: 1px dashed #E5EAF0;
    margin: 14px 0;
  }

  .product-description {
    font-size: 0.88rem;
    color: #3A4A60;
    line-height: 1.7;
  }

  .product-action-row {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .action-pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 13px;
    border-radius: 14px;
    border: none;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .cart-pill {
    background: #EAF2FF;
    color: #2563EB;
  }

  .cart-pill:hover {
    background: #2563EB;
    color: #fff;
  }

  .cart-pill.added {
    background: #1B7A3C;
    color: #fff;
  }

  .cart-pill:disabled,
  .buy-pill:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .buy-pill {
    background: #FF6B35;
    color: #fff;
    box-shadow: 0 10px 22px rgba(255, 107, 53, 0.28);
  }

  .buy-pill:hover {
    background: #e85a28;
  }

  .cart-pill.sold-out,
  .buy-pill.sold-out {
    background: #C7D0DD;
    color: #5A6E85;
    box-shadow: none;
  }

  /* ===== এই শপের আরও প্রোডাক্ট — হরাইজন্টাল স্ক্রল ===== */
  .related-section {
    margin-bottom: 20px;
  }

  .related-section-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1B2A4A;
    margin-bottom: 12px;
    padding: 0 2px;
  }

  .related-scroll {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .related-scroll::-webkit-scrollbar {
    display: none;
  }

  .related-card {
    flex: 0 0 132px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    text-decoration: none;
    overflow: hidden;
  }

  .related-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #F4F7FC;
  }

  .related-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .related-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FF6B35;
    font-size: 1.4rem;
  }

  .related-sold-badge {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 2;
    background: rgba(15, 23, 42, 0.8);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
  }

  .related-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: #1B2A4A;
    padding: 8px 10px 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-price {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FF6B35;
    padding: 0 10px 10px;
  }

  .related-loading-spinner {
    text-align: center;
    padding-top: 10px;
    color: #FF6B35;
    font-size: 1rem;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const metaEl = document.getElementById('productMeta');
  const meta = metaEl ? JSON.parse(metaEl.textContent) : null;

  const shareBtn = document.getElementById('shareProductBtn');
  const addToCartBtn = document.getElementById('addToCartBtn');
  const addToCartBtnText = document.getElementById('addToCartBtnText');
  const buyNowBtn = document.getElementById('buyNowBtn');
  const sliderTrack = document.getElementById('sliderTrack');
  const dots = document.querySelectorAll('.slider-dots .dot');
  const slides = document.querySelectorAll('.slide');
  const relatedScroll = document.getElementById('relatedScroll');
  const relatedLoadingSpinner = document.getElementById('relatedLoadingSpinner');

  let currentUserId = null;
  let relatedOffset = meta?.relatedOffset || 0;
  let relatedHasMore = meta?.relatedHasMore || false;
  let isLoadingMoreRelated = false;

  // ============================================================
  // "এই শপের আরও প্রোডাক্ট" — ইনফিনিটি স্ক্রল। ডানদিকের শেষের
  // ~২০০px এর মধ্যে স্ক্রল করলে পরের ১০টা প্রোডাক্ট লোড হয়ে
  // scroll row এ যোগ হয়ে যাবে (একই ফিল্টার, offset বাড়িয়ে)।
  // ============================================================
  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = String(str ?? '');
    return div.innerHTML;
  }

  function buildRelatedCardHTML(p) {
    const imgHtml = p.images && p.images.length > 0
      ? `<img src="${escapeHtml(p.images[0])}" alt="${escapeHtml(p.title)}" class="related-img" loading="lazy" />`
      : `<div class="related-img-placeholder"><i class="fas fa-box"></i></div>`;
    const soldBadge = p.is_sold_out ? `<span class="related-sold-badge">সোল্ড আউট</span>` : '';
    const priceHtml = p.price ? `<p class="related-price">৳${escapeHtml(p.price)}</p>` : '';

    return `<a href="/product/${p.id}" class="related-card">
      <div class="related-img-wrap">${soldBadge}${imgHtml}</div>
      <p class="related-title">${escapeHtml(p.title)}</p>
      ${priceHtml}
    </a>`;
  }

  async function loadMoreRelated() {
    if (isLoadingMoreRelated || !relatedHasMore || !meta) return;
    isLoadingMoreRelated = true;
    if (relatedLoadingSpinner) relatedLoadingSpinner.style.display = 'block';

    const { data, error } = await supabase
      .from('listings')
      .select('id, title, price, images, is_sold_out')
      .eq('category', 'online-shop')
      .eq('user_id', meta.shopOwnerId)
      .eq('status', 'active')
      .neq('id', meta.productId)
      .order('created_at', { ascending: false })
      .range(relatedOffset, relatedOffset + 9);

    if (relatedLoadingSpinner) relatedLoadingSpinner.style.display = 'none';
    isLoadingMoreRelated = false;

    if (error) {
      console.error('related products load-more error:', error.message);
      return;
    }

    (data || []).forEach((p) => {
      relatedScroll?.insertAdjacentHTML('beforeend', buildRelatedCardHTML(p));
    });

    relatedOffset += (data || []).length;
    relatedHasMore = (data || []).length === 10;
  }

  relatedScroll?.addEventListener('scroll', () => {
    if (isLoadingMoreRelated || !relatedHasMore) return;
    const { scrollLeft, scrollWidth, clientWidth } = relatedScroll;
    if (scrollWidth - (scrollLeft + clientWidth) < 200) {
      loadMoreRelated();
    }
  });

  // ছবিতে ট্যাপ করলে জুমেবল ফুলস্ক্রিন লাইটবক্স (ImageLightbox.astro)
  slides.forEach((slide) => {
    slide.addEventListener('click', () => {
      const startIndex = parseInt(slide.dataset.index || '0');
      window.openImageLightbox?.(meta?.images || [], startIndex);
    });
  });

  // প্রোডাক্ট সোল্ড আউট হলে কার্ট বাটন ডিজেবল করে "স্টক নেই" দেখানো
  if (meta?.isSoldOut && addToCartBtn) {
    addToCartBtn.disabled = true;
    addToCartBtn.classList.add('sold-out');
    addToCartBtnText.textContent = 'স্টক নেই';
  }
  if (meta?.isSoldOut && buyNowBtn) {
    buyNowBtn.disabled = true;
    buyNowBtn.classList.add('sold-out');
  }

  sliderTrack?.addEventListener('scroll', () => {
    const index = Math.round(sliderTrack.scrollLeft / sliderTrack.clientWidth);
    dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const index = parseInt(dot.dataset.index);
      sliderTrack.scrollTo({ left: index * sliderTrack.clientWidth, behavior: 'smooth' });
    });
  });

  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const shareData = { title: meta.title, text: `${meta.title} — স্মার্ট ফেনী তে দেখুন`, url };

    if (navigator.share) {
      try { await navigator.share(shareData); } catch (err) {}
    } else {
      await navigator.clipboard.writeText(url);
      alert('লিংক কপি হয়েছে ✓');
    }
  });

  async function logView() {
    if (!currentUserId || !meta) return;
    await supabase.from('product_events').insert({
      event_type: 'view',
      shop_id: meta.shopId,
      listing_id: meta.productId,
      user_id: currentUserId,
    });
  }

  addToCartBtn?.addEventListener('click', async () => {
    if (meta?.isSoldOut) return;

    if (!currentUserId) {
      window.openAuthModal?.('login');
      return;
    }

    addToCartBtn.disabled = true;
    addToCartBtnText.textContent = 'যোগ হচ্ছে...';

    const { data: existing } = await supabase
      .from('cart_items')
      .select('id, quantity')
      .eq('user_id', currentUserId)
      .eq('listing_id', meta.productId)
      .maybeSingle();

    if (existing) {
      await supabase.from('cart_items').update({ quantity: existing.quantity + 1 }).eq('id', existing.id);
    } else {
      await supabase.from('cart_items').insert({ user_id: currentUserId, listing_id: meta.productId, quantity: 1 });
    }

    await supabase.from('product_events').insert({
      event_type: 'cart_add',
      shop_id: meta.shopId,
      listing_id: meta.productId,
      user_id: currentUserId,
    });

    addToCartBtn.classList.add('added');
    addToCartBtnText.textContent = 'কার্টে যোগ হয়েছে ✓';
    addToCartBtn.disabled = false;

    setTimeout(() => {
      addToCartBtn.classList.remove('added');
      addToCartBtnText.textContent = 'কার্টে যোগ করুন';
    }, 1500);

    refreshCartCount();
  });

  buyNowBtn?.addEventListener('click', () => {
    if (meta?.isSoldOut) return;

    if (!currentUserId) {
      window.openAuthModal?.('login');
      return;
    }

    // কার্ট স্পর্শ না করেই সরাসরি চেকআউটে — checkout.astro?buyNow=প্রোডাক্ট
    // আইডি দেখে শুধু এই একটা প্রোডাক্টের অর্ডার সামারি বানাবে।
    window.location.href = `/checkout?buyNow=${meta.productId}`;
  });

  async function refreshCartCount() {
    if (!currentUserId) return;
    const { data } = await supabase.from('cart_items').select('quantity').eq('user_id', currentUserId);
    const total = (data || []).reduce((sum, row) => sum + row.quantity, 0);

    // হেডারের গ্লোবাল কার্ট আইকনকে সাথে সাথে আপডেট করার জন্য
    window.dispatchEvent(new CustomEvent('smartfeni:cart-updated', { detail: { total } }));
  }

  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;
    refreshCartCount();
    logView();
  })();
</script>
