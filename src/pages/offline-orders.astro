---
import BaseLayout from '../components/layout/BaseLayout.astro';
export const prerender = false;
---
<BaseLayout title="অফলাইন অর্ডার | স্মার্ট ফেনী">
  <main class="offline-orders">
    <header>
      <a href="/delivery-hero" class="back">← ডেলিভারি হিরো</a>
      <h1>অফলাইন অর্ডার</h1>
      <p>প্রকাশিত অর্ডার দেখুন, গ্রহণ করুন এবং ডেলিভারি আপডেট দিন।</p>
    </header>
    <div id="feedStatus" role="status" class="status">অর্ডার লোড হচ্ছে…</div>
    <section id="orders" class="orders" aria-live="polite"></section>
  </main>
  <style>
    .offline-orders{max-width:760px;margin:0 auto;padding:22px 16px 48px;font-family:'Hind Siliguri',sans-serif;color:#1B2A4A}
    .offline-orders header{margin-bottom:18px}.offline-orders h1{margin:12px 0 4px;font-size:27px}.offline-orders p{margin:0;color:#64748b}
    .back{display:inline-block;color:#1B2A4A;text-decoration:none;font-weight:700}
    .status{padding:13px 15px;background:#f1f5f9;border-radius:12px;margin:14px 0}
    .orders{display:grid;gap:13px}.order{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:16px;box-shadow:0 4px 15px #1b2a4a0d}
    .top{display:flex;justify-content:space-between;gap:10px;align-items:center}.order h2{font-size:18px;margin:0}.badge{font-size:12px;border-radius:20px;padding:5px 9px;background:#e8f7ee;color:#14693a;font-weight:700}
    .line{margin-top:8px;line-height:1.5;overflow-wrap:anywhere}.money{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.money span{background:#f1f5f9;border-radius:10px;padding:8px 10px;font-size:14px}
    .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.actions button{border:0;border-radius:10px;padding:11px 14px;font:inherit;font-weight:700;background:#1B2A4A;color:white;cursor:pointer}.actions .secondary{background:#e8f7ee;color:#14693a}.actions button:disabled{opacity:.55}
    .empty{padding:24px;text-align:center;background:#f8fafc;border-radius:14px;color:#64748b}
  </style>
  <script>
    import { supabase } from '../lib/supabase.js';
    const $ = id => document.getElementById(id);
    const bn = value => String(value ?? '').replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[d]);
    const money = value => '৳' + bn(Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }));
    const statusText = { new: 'নতুন অফার', rider_assigned: 'আপনার অর্ডার', picked_up: 'পিকআপ হয়েছে' };
    let busy = false;

    function node(tag, cls, text) {
      const el = document.createElement(tag);
      if (cls) el.className = cls;
      if (text !== undefined && text !== null) el.textContent = text;
      return el;
    }
    function fmtDate(value, asap) {
      if (asap) return 'যত দ্রুত সম্ভব';
      const d = new Date(value);
      return new Intl.DateTimeFormat('bn-BD', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Dhaka' }).format(d) + ' (বাংলাদেশ সময়)';
    }
    async function request(action, orderId, extra = {}) {
      if (busy) return;
      busy = true;
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) throw new Error('আগে লগইন করুন।');
        const res = await fetch('/api/manual-orders/workflow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.access_token },
          body: JSON.stringify({ action, orderId, ...extra })
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(result.error || 'অনুরোধ সম্পন্ন হয়নি');
        await load();
        $('feedStatus').textContent = 'আপডেট হয়েছে';
      } catch (e) {
        $('feedStatus').textContent = e.message || 'সমস্যা হয়েছে';
      } finally { busy = false; }
    }
    function renderOrder(o) {
      const own = !!o.delivery_rider_id && o.status !== 'new';
      const card = node('article', 'order');
      const top = node('div', 'top');
      top.append(node('h2', '', 'অর্ডার #' + o.order_no));
      top.append(node('span', 'badge', statusText[o.status] || o.status));
      card.append(top);
      card.append(node('div', 'line', 'ডেলিভারির সময়: ' + fmtDate(o.scheduled_at, o.is_asap)));
      if (o.pickup_name) card.append(node('div', 'line', 'পিকআপ: ' + o.pickup_name));
      card.append(node('div', 'line', 'অর্ডার: ' + o.details));
      if (true) {
        card.append(node('div', 'line', 'কাস্টমার: ' + (o.customer_name || '—')));
        if (o.customer_phone) {
          const line = node('div', 'line');
          line.append(document.createTextNode('ফোন: '));
          const tel = node('a', '', o.customer_phone);
          tel.href = 'tel:' + o.customer_phone.replace(/[^\d+]/g, '');
          line.append(tel); card.append(line);
        }
        if (o.drop_address) card.append(node('div', 'line', 'ড্রপ ঠিকানা: ' + o.drop_address));
        if (o.drop_map_link && /^https?:\/\//i.test(o.drop_map_link)) {
          const a = node('a', 'line', 'ড্রপ ম্যাপ খুলুন'); a.href = o.drop_map_link; a.target = '_blank'; a.rel = 'noopener'; card.append(a);
        }
        if (o.ready_at) card.append(node('div', 'line', '✅ অ্যাডমিন অর্ডার প্রস্তুত করেছেন'));
      } else {
        card.append(node('div', 'line', 'কাস্টমারের নাম, ফোন ও সঠিক ড্রপ ঠিকানা গ্রহণ করার পর দেখা যাবে।'));
      }
      const moneyRow = node('div', 'money');
      moneyRow.append(node('span', '', 'ডেলিভারি ফি: ' + money(o.delivery_fee)));
      moneyRow.append(node('span', '', 'আপনার পে: ' + money(o.rider_pay)));
      if (o.cod_amount != null) moneyRow.append(node('span', '', 'ক্যাশ নিতে হবে: ' + money(o.cod_amount)));
      card.append(moneyRow);
      const actions = node('div', 'actions');
      if (o.status === 'new') {
        const accept = node('button', '', 'অর্ডার গ্রহণ করুন');
        accept.addEventListener('click', () => {
          if (confirm('অর্ডারটি গ্রহণ করবেন? গ্রহণের পর কাস্টমারের তথ্য দেখা যাবে।')) request('accept', o.order_id);
        });
        actions.append(accept);
      } else if (o.status === 'rider_assigned') {
        const pickup = node('button', '', 'পিকআপ সম্পন্ন');
        pickup.addEventListener('click', () => {
          if (confirm('আপনি কি পণ্য/অর্ডার পিকআপ করেছেন?')) request('picked_up', o.order_id);
        });
        actions.append(pickup);
      } else if (o.status === 'picked_up') {
        const delivered = node('button', '', 'ডেলিভারড করুন');
        delivered.addEventListener('click', () => {
          const cash = prompt('⚠️ আপনি কত টাকা ক্যাশ রিসিভ করেছেন? ক্যাশ না নিলে ০ লিখুন।', String(o.cod_amount ?? 0));
          if (cash === null || cash.trim() === '' || !Number.isFinite(Number(cash)) || Number(cash) < 0) {
            alert('সঠিক ক্যাশের পরিমাণ লিখুন।'); return;
          }
          const note = prompt('ক্যাশ বা ডেলিভারি সম্পর্কে কোনো নোট থাকলে লিখুন (ঐচ্ছিক)।', '') || '';
          if (confirm('আপনি ' + money(cash) + ' ক্যাশ রিসিভ করেছেন বলে নিশ্চিত করছেন?')) request('delivered', o.order_id, { cashReceived: Number(cash), note });
        });
        actions.append(delivered);
      }
      card.append(actions);
      return card;
    }
    async function load() {
      $('feedStatus').textContent = 'অর্ডার লোড হচ্ছে…';
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { $('feedStatus').textContent = 'অর্ডার দেখতে আগে লগইন করুন।'; $('orders').replaceChildren(); return; }
      try {
        const res = await fetch('/api/manual-orders/workflow', { headers: { Authorization: 'Bearer ' + session.access_token } });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'অর্ডার লোড করা যায়নি');
        const orders = out.orders || [];
        $('orders').replaceChildren();
        if (!orders.length) $('orders').append(node('div', 'empty', 'এখন কোনো অফলাইন অর্ডার নেই। নতুন অর্ডার এলে এখানে দেখাবে।'));
        else orders.forEach(o => $('orders').append(renderOrder(o)));
        $('feedStatus').textContent = 'মোট ' + bn(orders.length) + 'টি অর্ডার';
      } catch (e) { $('feedStatus').textContent = e.message || 'অর্ডার লোড করা যায়নি'; }
    }
    load();
    setInterval(load, 20000);
  </script>
</BaseLayout>
