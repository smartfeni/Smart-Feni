---
// ============================================================
// পেজ: অনলাইন শপ (/online-shop) — ক্লাব পেজের মতো আলাদা দোকানের তালিকা (SF সিদ্ধান্ত, ২৬ নভে ২০২৬)
// কী দেখায়: কুইক ডেলিভারির সক্রিয় প্রি-অর্ডার দোকান (delivery_shops.delivery_kind = 'preorder', is_active)।
// ম্যাপ/ঠিকানা লাগে না। সার্চ (দোকানের নাম + পণ্য), ক্যাটাগরি চিপ (শুধু যেসব ক্যাটাগরিতে দোকান আছে),
// লিস্ট/গ্রিড ভিউ (ডিফল্ট গ্রিড, ফোনে মনে রাখে)। তালিকায় ফোন নম্বর নেই; নম্বর ও "কল করুন" দোকানের পেজে (SF সিদ্ধান্ত)।
// কার্ডে চাপলে দোকানের পেজ /market/shop?id=…&from=online-shop (পেছনের বাটন এই পেজে ফেরে)।
// কুইক ডেলিভারি সুইচ বন্ধ থাকলে (marketAccess) "শীঘ্রই আসছে"; হোমের কার্ডও তখন লুকানো।
// সব ইউজার/দোকানের লেখা textContent দিয়ে বসানো।
// ============================================================

export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Skeleton from '../components/ui/Skeleton.astro';
---

<BaseLayout title="অনলাইন শপ | স্মার্ট ফেনী" description="ফেনীর অনলাইন শপ: প্রি-অর্ডারে হোম মেড ও দোকানের পণ্য।">
  <div class="os-page">
    <div class="container">

      <div class="os-head">
        <h1><i class="fas fa-store"></i> ফেনীর অনলাইন শপ</h1>
        <p>প্রি-অর্ডারে হোম মেড ও দোকানের পণ্য</p>
      </div>

      <div class="os-search" id="osSearchBox">
        <i class="fas fa-search" aria-hidden="true"></i>
        <input type="text" id="osQ" placeholder="দোকানের নাম বা পণ্য লিখুন..." autocomplete="off" aria-label="দোকান খুঁজুন" />
      </div>

      <div class="os-cats" id="osCats" role="tablist" aria-label="ক্যাটাগরি"></div>

      <div class="os-toolbar">
        <span class="os-count" id="osCount"></span>
        <div class="os-view" id="osView" role="group" aria-label="ভিউ">
          <button type="button" data-view="list" aria-label="লিস্ট"><i class="fas fa-list"></i></button>
          <button type="button" data-view="grid" aria-label="গ্রিড"><i class="fas fa-table-cells-large"></i></button>
        </div>
      </div>

      <div id="osList" class="os-list">
        <Skeleton preset="listing" count={5} />
      </div>
    </div>
  </div>

  <style is:global>
    .os-page { background: #FFF4EC; min-height: 70vh; padding: 18px 0 90px; font-family: 'Hind Siliguri', system-ui, sans-serif; color: #1B2A4A; }
    .os-head h1 { margin: 0; font-size: 1.35rem; font-weight: 700; display: flex; align-items: center; gap: 10px; }
    .os-head h1 i { color: #FF6B35; }
    .os-head p { margin: 4px 0 14px; color: #5A6E85; font-size: .92rem; }
    .os-search { display: flex; align-items: center; gap: 10px; background: #fff; border: 1.5px solid #F1DCCD; border-radius: 16px; padding: 0 14px; min-height: 50px; box-shadow: 0 2px 10px rgba(27,42,74,.05); }
    .os-search i { color: #8FA0BC; }
    .os-search input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 16px; background: transparent; color: #1B2A4A; min-width: 0; }
    .os-search:focus-within { border-color: #FF6B35; }
    .os-cats { display: flex; gap: 8px; overflow-x: auto; margin: 12px -16px 0; padding: 0 16px 4px; scrollbar-width: none; }
    .os-cats::-webkit-scrollbar { display: none; }
    .os-cat { flex-shrink: 0; border: 1.5px solid #F1DCCD; background: #fff; color: #1B2A4A; border-radius: 999px; padding: 7px 14px; font: inherit; font-size: .86rem; font-weight: 600; cursor: pointer; }
    .os-cat[aria-selected="true"] { background: #FF6B35; border-color: #FF6B35; color: #fff; }
    .os-toolbar { display: flex; align-items: center; justify-content: space-between; margin: 14px 0 10px; }
    .os-count { font-size: .86rem; color: #5A6E85; font-weight: 600; }
    .os-view { display: flex; background: #fff; border-radius: 12px; padding: 3px; border: 1px solid #F1DCCD; }
    .os-view button { border: 0; background: transparent; width: 36px; height: 32px; border-radius: 9px; color: #8FA0BC; cursor: pointer; }
    .os-view button[aria-pressed="true"] { background: #1B2A4A; color: #fff; }

    .os-list { display: flex; flex-direction: column; gap: 12px; }
    .os-list.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    @media (min-width: 720px) { .os-list.grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

    .os-card { background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 3px 14px rgba(27,42,74,.07); display: flex; flex-direction: column; }
    .os-card-a { display: flex; gap: 12px; padding: 12px; text-decoration: none; color: inherit; align-items: center; }
    .os-cover { width: 76px; height: 76px; flex-shrink: 0; border-radius: 14px; background: #FFE9DC center/cover no-repeat; position: relative; display: flex; align-items: center; justify-content: center; color: #FF6B35; font-size: 1.6rem; }
    .os-cover img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; }
    .os-logo { position: absolute; right: -6px; bottom: -6px; width: 30px; height: 30px; border-radius: 50%; background: #fff; border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,.15); object-fit: cover; }
    .os-info { min-width: 0; flex: 1; }
    .os-name { margin: 0; font-size: 1rem; font-weight: 700; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .os-sub { margin: 3px 0 0; font-size: .8rem; color: #5A6E85; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .os-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .os-tag { font-size: .72rem; font-weight: 700; padding: 3px 8px; border-radius: 8px; background: #EDE7FF; color: #4C2FB0; }
    .os-tag.star { background: #FFF7E0; color: #975A16; }

    .os-list.grid .os-card-a { flex-direction: column; align-items: stretch; padding: 0; gap: 0; }
    .os-list.grid .os-cover { width: 100%; height: 110px; border-radius: 0; }
    .os-list.grid .os-cover img { border-radius: 0; }
    .os-list.grid .os-logo { right: 10px; bottom: -14px; width: 36px; height: 36px; }
    .os-list.grid .os-info { padding: 12px 12px 8px; }
    .os-list.grid .os-name { font-size: .92rem; }

    .os-empty { text-align: center; padding: 48px 16px; color: #5A6E85; font-weight: 600; background: #fff; border-radius: 18px; }
    .os-empty i { display: block; font-size: 2rem; color: #FFB48F; margin-bottom: 10px; }
  </style>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { proxyImg } from '../lib/imgProxy.js';
    import { fetchMarketCategories, fetchShopRatings, fetchMarketItemIndex, marketAccess, searchNeedles, bnNum } from '../lib/marketApi.js';

    const $ = (id) => document.getElementById(id);
    const VIEW_KEY = 'sf_online_shop_view';
    const UPAZILA_BN = { feni_sadar: 'ফেনী সদর', chhagalnaiya: 'ছাগলনাইয়া', daganbhuiyan: 'দাগনভূঞা', parshuram: 'পরশুরাম', fulgazi: 'ফুলগাজী', sonagazi: 'সোনাগাজী' };

    let shops = [];
    let cats = [];
    let ratings = {};
    let itemIdx = {};
    let active = 'all';
    let q = '';
    let needles = [];
    let view = 'grid'; // ডিফল্ট গ্রিড (SF সিদ্ধান্ত); ইউজার বদলালে ফোনে মনে রাখে

    function mk(tag, cls, text) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }

    function empty(msg) {
      const box = $('osList');
      box.className = 'os-list';
      box.textContent = '';
      const e = mk('div', 'os-empty');
      const i = mk('i', 'fas fa-store-slash'); i.setAttribute('aria-hidden', 'true');
      e.append(i, document.createTextNode(msg));
      box.appendChild(e);
    }

    function inCat(s) { return active === 'all' || (Array.isArray(s.market_category_ids) && s.market_category_ids.includes(active)); }
    function matchQ(s) {
      if (!q) return true;
      const hay = (String(s.name || '') + ' ' + (itemIdx[s.id] || '')).toLowerCase();
      return needles.some((n) => hay.includes(n));
    }

    function renderCats() {
      const box = $('osCats');
      box.textContent = '';
      const used = new Set();
      shops.forEach((s) => (s.market_category_ids || []).forEach((id) => used.add(id)));
      const list = [{ id: 'all', name: 'সব' }].concat(cats.filter((c) => used.has(c.id)));
      if (list.length <= 2) { box.hidden = true; return; }
      box.hidden = false;
      list.forEach((c) => {
        const b = mk('button', 'os-cat', c.name);
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', String(c.id === active));
        b.addEventListener('click', () => { active = c.id; renderCats(); render(); });
        box.appendChild(b);
      });
    }

    function card(s) {
      const c = mk('article', 'os-card');
      const a = mk('a', 'os-card-a');
      a.href = '/market/shop?id=' + encodeURIComponent(s.id) + '&from=online-shop';
      const cover = mk('div', 'os-cover');
      if (s.image_url) {
        const im = mk('img'); im.src = s.image_url; im.alt = ''; im.loading = 'lazy'; im.decoding = 'async';
        im.onerror = () => im.remove();
        cover.appendChild(im);
      } else {
        const i = mk('i', 'fas fa-store'); i.setAttribute('aria-hidden', 'true'); cover.appendChild(i);
      }
      if (s.logo_url) {
        const lg = mk('img', 'os-logo'); lg.src = s.logo_url; lg.alt = ''; lg.loading = 'lazy'; lg.decoding = 'async';
        lg.onerror = () => lg.remove();
        cover.appendChild(lg);
      }
      const info = mk('div', 'os-info');
      info.appendChild(mk('h2', 'os-name', s.name || 'দোকান'));
      const catNames = (s.market_category_ids || []).map((id) => (cats.find((x) => x.id === id) || {}).name).filter(Boolean).slice(0, 2).join(', ');
      const place = [s.union_name, UPAZILA_BN[s.upazila] || s.upazila].filter(Boolean).join(', ');
      const sub = [catNames, place].filter(Boolean).join(' · ');
      if (sub) info.appendChild(mk('p', 'os-sub', sub));
      const tags = mk('div', 'os-tags');
      tags.appendChild(mk('span', 'os-tag', '🗓️ প্রি-অর্ডার'));
      const r = ratings[s.id];
      if (r && r.count) tags.appendChild(mk('span', 'os-tag star', '★ ' + bnNum(r.avg.toFixed(1)) + ' (' + bnNum(r.count) + ')'));
      info.appendChild(tags);
      a.append(cover, info);
      c.appendChild(a);
      return c;
    }

    function render() {
      const list = shops.filter((s) => inCat(s) && matchQ(s));
      $('osCount').textContent = bnNum(list.length) + 'টি দোকান';
      if (!list.length) { empty('কোনো দোকান পাওয়া যায়নি।'); return; }
      const box = $('osList');
      box.className = 'os-list' + (view === 'grid' ? ' grid' : '');
      box.textContent = '';
      list.forEach((s) => box.appendChild(card(s)));
    }

    function paintView() {
      document.querySelectorAll('#osView button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    }

    async function init() {
      try { const v = localStorage.getItem(VIEW_KEY); if (v === 'grid' || v === 'list') view = v; } catch (_) {}
      paintView();
      document.querySelectorAll('#osView button').forEach((b) => b.addEventListener('click', () => {
        view = b.dataset.view;
        try { localStorage.setItem(VIEW_KEY, view); } catch (_) {}
        paintView(); render();
      }));
      let t = null;
      $('osQ').addEventListener('input', (e) => {
        clearTimeout(t);
        t = setTimeout(() => { q = e.target.value.trim(); needles = searchNeedles(q); render(); }, 180);
      });
      $('osQ').addEventListener('focus', () => {
        setTimeout(() => $('osSearchBox').scrollIntoView({ behavior: 'smooth', block: 'start' }), 250);
      });

      const access = await marketAccess().catch(() => ({ allowed: false }));
      if (!access || !access.allowed) { empty('অনলাইন শপ শীঘ্রই আসছে।'); $('osCount').textContent = ''; return; }

      try {
        const [shopRes, catRes, rat, idx] = await Promise.all([
          supabase.from('delivery_shops')
            .select('id, name, image_url, logo_url, upazila, union_name, market_category_ids, is_popular, sort_order')
            .eq('delivery_kind', 'preorder')
            .eq('is_active', true)
            .order('is_popular', { ascending: false })
            .order('sort_order', { ascending: true })
            .order('name', { ascending: true }),
          fetchMarketCategories().catch(() => []),
          fetchShopRatings().catch(() => ({})),
          fetchMarketItemIndex().catch(() => ({})),
        ]);
        if (shopRes.error) throw shopRes.error;
        shops = (shopRes.data || []).map((s) => ({ ...s, image_url: proxyImg(s.image_url), logo_url: proxyImg(s.logo_url) }));
        cats = catRes || [];
        ratings = rat || {};
        itemIdx = idx || {};
      } catch (err) {
        if (window.SFReportError) { try { window.SFReportError(err, 'online-shop-load'); } catch (_) {} }
        empty('দোকান লোড করা যায়নি। একটু পরে আবার চেষ্টা করুন।');
        return;
      }
      renderCats();
      render();
    }

    init();
  </script>
</BaseLayout>
