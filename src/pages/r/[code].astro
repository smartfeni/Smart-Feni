---
// ============================================================
// পেজ: রেফার লিংক ল্যান্ডিং — smartfeni.com/r/<কোড>
//
// ইউজারের ইউনিক রেফার লিংক। কেউ এই লিংকে ক্লিক করলে:
//   ✅ Android ব্রাউজার/ইন-অ্যাপ ব্রাউজার (Facebook ইত্যাদি) → সাথে সাথে Play Store,
//      লিংকে "&referrer=ref_<কোড>" যুক্ত থাকে। অ্যাপ ইনস্টল হয়ে প্রথমবার খুললে
//      Play Install Referrer API (InstallReferrerPlugin.java → native-bridge.js)
//      এই কোডটা পড়ে, সাইন আপের সময় রেফার কাউন্ট হয়।
//   ✅ অ্যাপের ভেতরে খুললে (অ্যাপ আগেই ইনস্টল করা) → সরাসরি হোমে
//   ✅ iPhone/ডেস্কটপ/প্রিভিউ বট (Facebook, WhatsApp ইত্যাদি) → এই পেজটাই দেখায়,
//      Play Store বাটন সহ। প্রিভিউ কার্ডের জন্য og ট্যাগ আছে।
//
// এই পেজ ইচ্ছাকৃতভাবে BaseLayout ব্যবহার করে না — তাহলে Android ব্রাউজারে
// "অ্যাপ ডাউনলোড গেট" (AppDownloadPrompt) আর বাকি ভারী কম্পোনেন্ট আসত, যার
// Play Store লিংকে রেফার কোড থাকে না। এটা হালকা, আলাদা পেজ।
//
// কোড যাচাই (ডাটাবেজে আছে কিনা) এখানে করা হয় না — যাতে কেউ কোড অনুমান করে
// খুঁজতে না পারে। আসল যাচাই সাইন আপের সময় সার্ভারে apply_referral() এ হয়।
// ============================================================
export const prerender = false;

const PLAY_STORE_BASE = 'https://play.google.com/store/apps/details?id=com.smartfeni.app';
const SITE_URL = 'https://smartfeni.com';

const rawCode = String(Astro.params.code || '').trim().toUpperCase();
const isValidCode = /^[A-Z0-9]{8}$/.test(rawCode);

const playStoreUrl = isValidCode
  ? `${PLAY_STORE_BASE}&referrer=${encodeURIComponent('ref_' + rawCode)}`
  : PLAY_STORE_BASE;

const pageTitle = 'স্মার্ট ফেনী — আপনাকে আমন্ত্রণ';
const pageDescription = 'ফেনীর সব সেবা এক অ্যাপে। স্মার্ট ফেনী অ্যাপ ইনস্টল করুন।';
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="স্মার্ট ফেনী" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${SITE_URL}/logo.png`} />
    <meta property="og:url" content={`${SITE_URL}/r/${isValidCode ? rawCode : ''}`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${SITE_URL}/logo.png`} />

    <style is:global>
      :root {
        --sf-orange: #ff6b35;
        --sf-navy: #1b2a4a;
        --sf-muted: #64748b;
        --sf-bg: #f8fafc;
        --sf-card: #ffffff;
        --sf-border: #e5eaf0;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --sf-navy: #f1f5f9;
          --sf-muted: #94a3b8;
          --sf-bg: #0f172a;
          --sf-card: #1e293b;
          --sf-border: #334155;
        }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Noto Sans Bengali', 'Hind Siliguri', sans-serif;
        background: var(--sf-bg);
        color: var(--sf-navy);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 24px 16px;
      }
      .sf-ref-card {
        width: 100%;
        max-width: 420px;
        background: var(--sf-card);
        border: 1px solid var(--sf-border);
        border-radius: 24px;
        padding: 32px 24px;
        text-align: center;
        box-shadow: 0 8px 30px rgba(27, 42, 74, 0.08);
      }
      .sf-ref-logo { width: 84px; height: 84px; border-radius: 20px; }
      .sf-ref-title { font-size: 1.35rem; font-weight: 800; margin: 16px 0 6px; }
      .sf-ref-sub { font-size: 0.95rem; color: var(--sf-muted); line-height: 1.6; margin: 0 0 22px; }
      .sf-ref-download {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: var(--sf-orange);
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        padding: 15px 18px;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(255, 107, 53, 0.35);
      }
      .sf-ref-download:active { transform: scale(0.98); }
      .sf-ref-steps {
        list-style: none;
        padding: 0;
        margin: 22px 0 0;
        text-align: left;
        font-size: 0.9rem;
        color: var(--sf-muted);
        line-height: 1.7;
      }
      .sf-ref-steps li { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 8px; }
      .sf-ref-num {
        flex: 0 0 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(255, 107, 53, 0.12);
        color: var(--sf-orange);
        font-weight: 800;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 2px;
      }
      .sf-ref-note { font-size: 0.8rem; color: var(--sf-muted); margin: 16px 0 0; line-height: 1.6; }
      .sf-ref-web {
        display: inline-block;
        margin-top: 14px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--sf-muted);
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <main class="sf-ref-card">
      <img src="/logo.png" alt="স্মার্ট ফেনী" class="sf-ref-logo" width="84" height="84" />

      <h1 class="sf-ref-title">স্মার্ট ফেনীতে আপনাকে স্বাগতম</h1>
      <p class="sf-ref-sub">ফেনীর সব সেবা, আপনার ফোনের হোম স্ক্রিনেই। এক বন্ধু আপনাকে আমন্ত্রণ জানিয়েছেন।</p>

      <a id="sfRefDownload" class="sf-ref-download" href={playStoreUrl} rel="noopener">
        <span aria-hidden="true">▶</span>
        <span>Google Play থেকে ডাউনলোড করুন</span>
      </a>

      <ul class="sf-ref-steps">
        <li><span class="sf-ref-num">১</span><span>অ্যাপটি ইনস্টল করুন</span></li>
        <li><span class="sf-ref-num">২</span><span>অ্যাপ খুলে সাইন আপ করুন</span></li>
      </ul>

      <p class="sf-ref-note">স্মার্ট ফেনী অ্যাপ এখন Android ফোনের জন্য পাওয়া যাচ্ছে।</p>

      <a class="sf-ref-web" href="/">ওয়েবসাইট ঘুরে দেখুন</a>
    </main>

    <!--
      Android হলে সাথে সাথে Play Store-এ, অ্যাপের ভেতরে খুললে হোমে।
      বট/প্রিভিউ ক্রলার এড়ানো হয় (AppDownloadPrompt.astro এর মতো একই তালিকা),
      যাতে শেয়ার কার্ডের প্রিভিউ ঠিক থাকে। JS বন্ধ থাকলেও বাটন কাজ করে।
    -->
    <script is:inline>
      (function () {
        try {
          var cap = window.Capacitor;
          var isNative =
            window.androidBridge ||
            window.CapacitorAndroid ||
            (cap && typeof cap.isNativePlatform === 'function' && cap.isNativePlatform());

          if (isNative) {
            location.replace('/');
            return;
          }

          var ua = navigator.userAgent || '';
          if (!/Android/i.test(ua)) return;
          if (/bot|crawl|spider|slurp|lighthouse|facebookexternalhit|whatsapp|telegram|preview/i.test(ua)) return;

          var btn = document.getElementById('sfRefDownload');
          if (btn && btn.href) location.replace(btn.href);
        } catch (e) {}
      })();
    </script>
  </body>
</html>